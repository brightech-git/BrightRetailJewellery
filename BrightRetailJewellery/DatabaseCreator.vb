        strSql += vbCrLf + "  			PRINT @QRY"
        strSql += vbCrLf + "  			EXEC (@QRY)"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	END     "
        strSql += vbCrLf + "  	/** GETTING NONTAG INFO **/       "
        strSql += vbCrLf + "  	IF @STOCKTYPE = 'N' OR @STOCKTYPE = 'B'     "
        strSql += vbCrLf + "  	BEGIN     "
        strSql += vbCrLf + "  		SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW(SEP,PCS,GRSWT,ITEMID,SUBITEMID,ICOUNTER)'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + ' SELECT ''OPE''SEP,SUM(CASE WHEN RECISS = ''R'' THEN PCS ELSE -1*PCS END)PCS,SUM(CASE WHEN RECISS = ''R'' THEN GRSWT ELSE -1*GRSWT END)GRSWT,ITEMID,SUBITEMID,ITEMCTRID'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + ' FROM TEMPTABLEDB..TEMPITEMNONTAG WHERE RECDATE < '''+@FROMDATE+''''"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + ' GROUP BY ITEMID,SUBITEMID,ITEMCTRID'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + ' SELECT CASE WHEN ISNULL(POSTED,'''')=''P'' THEN ''REC_PA'''"
