        strSql += vbCrLf + "  DROP TABLE TEMPACTYPE"
        strSql += vbCrLf + "  DROP TABLE TEMPCOSTCENTRE"
        strSql += vbCrLf + "  DROP TABLE TEMPRELIGION"
        strSql += vbCrLf + "  DROP TABLE TEMPAREA "
