        strSql += vbCrLf + "      SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' (PARTICULAR,GRSWT,NETWT,PUREWT,AMOUNT,ACCODE,TRESULT,REMARK)'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ''OPENING..'' PARTICULAR,SUM(GWEIGHT) AS GRSWT,SUM(GWEIGHT) AS NETWT,SUM(PWEIGHT) AS PUREWT,SUM(AMOUNT) AS AMOUNT'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,ACCODE,1 TRESULT,REMARK FROM ('"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ACCODE,0 GWEIGHT,0 NWEIGHT,0 PWEIGHT,CREDIT-DEBIT AMOUNT,'''' REMARK  FROM OPENTRAILBALANCE'"
