        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ @FILTER"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'UNION ALL'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'SELECT ''DISCOUNT'' AS PARTICULAR, SUM(CASE WHEN TRANMODE = ''D'' THEN A.AMOUNT ELSE A.AMOUNT*-1 END)AMOUNT '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ ', NULL AS TAX, '''' COLHEAD, 1 AS RESULT FROM OUTSTANDING O'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'INNER JOIN '+@DBNAME+'..ACCTRAN A ON O.BATCHNO = A.BATCHNO AND O.RECPAY = ''R'' AND A.PAYMODE IN (''DI'')'"
        strSql += vbCrLf + "			IF @ORDERNO <> ''"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ ' AND O.RUNNO = ''' +@ORDERNO + ''' '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ @FILTER"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'UNION ALL'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'SELECT ''TOTAL COLLECTION'' AS PARTICULAR, SUM(CASE WHEN TRANMODE = ''D'' THEN A.AMOUNT ELSE A.AMOUNT*-1 END)AMOUNT '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ ', NULL AS TAX, ''T'' COLHEAD, 1 AS RESULT FROM OUTSTANDING O'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'INNER JOIN '+@DBNAME+'..ACCTRAN A ON O.BATCHNO = A.BATCHNO AND O.RECPAY = ''R'' AND A.PAYMODE IN (''CA'',''CC'',''CH'',''PU'',''SR'',''RV'',''AA'',''SS'',''CB'',''CD'',''CG'',''CZ'',''DI'')'"
        strSql += vbCrLf + "			IF @ORDERNO <> ''"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ ' AND O.RUNNO = ''' +@ORDERNO + ''' '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ @FILTER"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'UNION ALL'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'SELECT ''CLOSED ADVANCE'' AS PARTICULAR, SUM(CASE WHEN TRANMODE = ''D'' THEN A.AMOUNT ELSE A.AMOUNT*-1 END)AMOUNT '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ ', NULL AS TAX, '''' COLHEAD, 1 AS RESULT FROM OUTSTANDING O'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'INNER JOIN '+@DBNAME+'..ACCTRAN A ON O.BATCHNO = A.BATCHNO AND O.RECPAY = ''P'' AND SUBSTRING(O.RUNNO,6,15) = A.REFNO AND A.PAYMODE IN (''AA'')'"
        strSql += vbCrLf + "			IF @ORDERNO <> ''"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ ' AND O.RUNNO = ''' +@ORDERNO + ''' '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ @FILTER"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'UNION ALL'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'SELECT ''ADVANCE CANCEL'' AS PARTICULAR, SUM(O.AMOUNT)AMOUNT '"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ ', NULL AS TAX, ''C'' COLHEAD, 1 AS RESULT FROM OUTSTANDING O'"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'WHERE ISNULL(O.CANCEL,'''') = ''Y'''"
        strSql += vbCrLf + "			IF @ASONDATE = 'Y'"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ 'AND O.TRANDATE <= '''+@FROMDATE+''''"
        strSql += vbCrLf + "			IF @ASONDATE <> 'Y'"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ 'AND O.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''		"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ 'AND O.TRANTYPE = '''+@ORTYPE+''' AND O.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANYID) '"
        strSql += vbCrLf + "			IF @COSTNAME <> '' AND @COSTNAME <> 'ALL'"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ 'AND O.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTID)'"
        strSql += vbCrLf + "			IF @ORDERNO <> '' "
        strSql += vbCrLf + "				SELECT @QRY = @QRY+CHAR(13)+ ' AND RUNNO = ''' +@ORDERNO + ''''"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+CHAR(13)+ ')X'"
        strSql += vbCrLf + "			PRINT(@QRY)"
        strSql += vbCrLf + "			EXEC(@QRY)"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_SALESABSTRACT_NEW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SALESABSTRACT_NEW')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SALESABSTRACT_NEW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_SALESABSTRACT_NEW"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "   @DBNAME AS  VARCHAR(10)"
        strSql += vbCrLf + "  ,@FROMDATE AS VARCHAR(12)"
        strSql += vbCrLf + "  ,@TODATE AS VARCHAR(12)"
        strSql += vbCrLf + "  ,@SYSTEMID AS VARCHAR(15)"
        strSql += vbCrLf + "  ,@COMPANYID AS VARCHAR(100)"
        strSql += vbCrLf + "  ,@COSTID AS VARCHAR(1000)"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  	SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')"
        strSql += vbCrLf + "  	SET @COSTID= REPLACE (@COSTID,',',''',''')"
        strSql += vbCrLf + "  	SELECT @QRY =' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'SABS'' AND XTYPE = ''U'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SABS'"
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  	SELECT @QRY =' SELECT I.TRANDATE,TRANNO,CA.CATNAME PARTICULAR,I.GRSWT,I.NETWT,CONVERT(NUMERIC(15,2),(NETWT*RATE)) AMOUNT'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,CONVERT(NUMERIC(15,2),(WASTAGE*RATE)+MCHARGE) VADDED,CONVERT(NUMERIC(15,2),((ISNULL(NETWT,0)+ISNULL(WASTAGE,0))*RATE)+MCHARGE) AS TOTAL'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,(ISNULL(DISCOUNT,0)+ISNULL(FIN_DISCOUNT,0)) AS DISCOUNT'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,TAX,CONVERT(NUMERIC(15,2),((ISNULL(NETWT,0)+ISNULL(WASTAGE,0))*RATE)+MCHARGE+ISNULL(TAX,0)+(ISNULL(DISCOUNT,0)+ISNULL(FIN_DISCOUNT,0))) TOTAMT' "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,P.PNAME AS NAME,CASE WHEN ISNULL(P.ADDRESS1,'''')<>'''' THEN P.ADDRESS1+'','' END'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' +CASE WHEN ISNULL(P.ADDRESS2,'''')<>'''' THEN P.ADDRESS2+'','' END'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' +CASE WHEN ISNULL(P.ADDRESS3,'''')<>'''' THEN P.ADDRESS3+'','' END'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' +CASE WHEN ISNULL(P.AREA,'''')<>'''' THEN P.AREA+'','' END'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' +CASE WHEN ISNULL(P.CITY,'''')<>'''' THEN P.CITY+'','' END'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' +CASE WHEN ISNULL(P.STATE,'''')<>'''' THEN P.STATE+'','' END ADDRESS'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,ISNULL(P.MOBILE,P.PHONERES)PHONENO,0 RESULT,'' '' COLHEAD INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SABS FROM '+@DBNAME+'..ISSUE I'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' LEFT JOIN CATEGORY CA ON I.CATCODE= CA.CATCODE'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' LEFT JOIN CUSTOMERINFO C ON I.BATCHNO =C.BATCHNO '"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' LEFT JOIN PERSONALINFO P ON C.PSNO=P.SNO '"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' WHERE I.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+@TODATE +''' AND I.TRANTYPE IN (''SA'',''OD'')'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' AND ISNULL(I.CANCEL,'''')='''''"
        strSql += vbCrLf + "  	IF @COMPANYID<>'ALL' AND @COMPANYID<>'' SELECT @QRY = @QRY+ ' AND I.COMPANYID IN('''+@COMPANYID+''')'"
        strSql += vbCrLf + "  	IF @COSTID<>'ALL' AND @COSTID <>'' SELECT @QRY = @QRY+ ' AND I.COSTID IN('''+@COSTID+''')'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ORDER BY I.TRANDATE,I.TRANNO'"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  	SELECT @QRY =' INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SABS (PARTICULAR,GRSWT,NETWT,AMOUNT'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,VADDED,TOTAL,DISCOUNT,TAX,TOTAMT,RESULT,COLHEAD)'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' SELECT ''TOTAL'' PARTICULAR,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),SUM(ISNULL(AMOUNT,0))'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,SUM(ISNULL(VADDED,0)),SUM(ISNULL(TOTAL,0)),SUM(ISNULL(DISCOUNT,0))'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,SUM(ISNULL(TAX,0)),SUM(ISNULL(TOTAMT,0))' "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY+ ' ,1 RESULT,''T'' COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SABS '"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  	SELECT @QRY =' SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SABS ORDER BY RESULT,TRANDATE,TRANNO' "
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_COSTCENTREWISESALES()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COSTCENTREWISESALES')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COSTCENTREWISESALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE SP_RPT_COSTCENTREWISESALES "
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @TRANDB VARCHAR(15),  "
        strSql += vbCrLf + " @ADMINDB VARCHAR(15),  "
        strSql += vbCrLf + " @FRMDATE VARCHAR(12),   "
        strSql += vbCrLf + " @TODATE VARCHAR(12),  "
        strSql += vbCrLf + " @COMPANYID VARCHAR(100),   "
        strSql += vbCrLf + " @COSTID VARCHAR(300)         "
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " 	DECLARE @QRY AS VARCHAR(8000), @QRY1 AS VARCHAR(8000)"
        strSql += vbCrLf + " 	DECLARE @CID AS VARCHAR(50), @CTYPE AS VARCHAR(50)"
        strSql += vbCrLf + " 	DECLARE @Col AS VARCHAR(200) ,@Col1 AS VARCHAR(200)"

        strSql += vbCrLf + " 	SET @COMPANYID=''''+REPLACE(@COMPANYID,',',''',''')+''''"
        strSql += vbCrLf + " 	SET @COSTID=''''+REPLACE(@COSTID,',',''',''')+''''"

        strSql += vbCrLf + " 	SELECT @QRY1= 'IF OBJECT_ID(''TEMPTABLEDB..TEMPCOSALESBR'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSALESBR'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'SELECT COSTID,COSTNAME INTO TEMPTABLEDB..TEMPCOSALESBR FROM '+@ADMINDB+'..COSTCENTRE'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'WHERE COMPANYID IN ('+@COMPANYID+')'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'AND COSTID IN ('+@COSTID+')'"
        strSql += vbCrLf + " 	EXEC (@QRY1) "

        strSql += vbCrLf + " 	SELECT @QRY1='IF OBJECT_ID(''TEMPTABLEDB..TEMPCOSALESCOLUMNS'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSALESCOLUMNS'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'CREATE TABLE TEMPTABLEDB..TEMPCOSALESCOLUMNS (CID INT IDENTITY(1,1),CNAME VARCHAR(150))'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'IF OBJECT_ID(''TEMPTABLEDB..TEMPCOSALES'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSALES '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'SELECT DISTINCT C.CATNAME,C.CATNAME AS TEMPCATNAME ,CONVERT(VARCHAR(50),NULL ) AS UNIT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'INTO TEMPTABLEDB..TEMPCOSALES'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'FROM '+@TRANDB+'..ISSUE AS I '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'LEFT JOIN '+@ADMINDB+'..CATEGORY AS C ON I.CATCODE=C.CATCODE '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'WHERE  1=1'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'AND I.TRANTYPE=''SA'' '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'AND COSTID IN ('+@COSTID+')'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'AND COMPANYID IN ('+@COMPANYID+')'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'AND ISNULL(CANCEL,'''')='''' '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + 'ORDER BY C.CATNAME'"
        strSql += vbCrLf + " 	EXEC (@QRY1) "

        strSql += vbCrLf + " 	/*OPENING*/"
        strSql += vbCrLf + " 	DECLARE CUR1 CURSOR FOR SELECT 'OP' AS TT UNION  ALL SELECT 'TR' UNION  ALL SELECT 'CL'"
        strSql += vbCrLf + " 	OPEN CUR1 WHILE (1 = 1) BEGIN FETCH NEXT FROM CUR1 INTO @CTYPE"
        strSql += vbCrLf + " 	IF @@FETCH_STATUS =-1 BREAK "
        strSql += vbCrLf + " 	SET @COL ='' SET @COL1 =''"

        strSql += vbCrLf + " 	DECLARE CUR CURSOR FOR SELECT DISTINCT COSTID FROM TEMPTABLEDB..TEMPCOSALESBR ORDER BY COSTID ASC"
        strSql += vbCrLf + " 	OPEN CUR WHILE (1 = 1) BEGIN FETCH NEXT FROM CUR INTO @CID  "
        strSql += vbCrLf + " 	IF @@FETCH_STATUS =-1 BREAK "
        strSql += vbCrLf + " 	SELECT @QRY = 'ALTER TABLE TEMPTABLEDB..TEMPCOSALES ADD ['+@CTYPE+'_' + @CID + '_WT] DECIMAL(15,3) '  "
        strSql += vbCrLf + " 	EXEC (@QRY) SET @COL=@COL+'~'+@CTYPE+'_' + @CID + '_WT'"
        strSql += vbCrLf + " 	END CLOSE CUR DEALLOCATE CUR"

        strSql += vbCrLf + " 	SELECT @QRY = 'ALTER TABLE TEMPTABLEDB..TEMPCOSALES ADD ['+@CTYPE+'_TOTAL_WT] DECIMAL(15,3) '  "
        strSql += vbCrLf + " 	EXEC (@QRY)     SET @COL=@COL+'~'+@CTYPE+'_TOTAL_WT'"

        strSql += vbCrLf + " 	DECLARE CUR CURSOR FOR SELECT DISTINCT COSTID FROM TEMPTABLEDB..TEMPCOSALESBR ORDER BY COSTID ASC"
        strSql += vbCrLf + " 	OPEN CUR WHILE (1 = 1) BEGIN FETCH NEXT FROM CUR INTO @CID  "
        strSql += vbCrLf + " 	IF @@FETCH_STATUS =-1 BREAK "
        strSql += vbCrLf + " 	SELECT @QRY = 'ALTER TABLE TEMPTABLEDB..TEMPCOSALES ADD ['+@CTYPE+'_' + @CID + '_RS] DECIMAL(15,2) '  "
        strSql += vbCrLf + " 	EXEC (@QRY) SET @COL1=@COL1+'~'+@CTYPE+'_' + @CID + '_RS'"
        strSql += vbCrLf + " 	END CLOSE CUR DEALLOCATE CUR"

        strSql += vbCrLf + " 	SELECT @QRY = 'ALTER TABLE TEMPTABLEDB..TEMPCOSALES ADD ['+@CTYPE+'_TOTAL_RS] DECIMAL(15,2) '  "
        strSql += vbCrLf + " 	EXEC (@QRY)  SET @COL1=@COL1+'~'+@CTYPE+'_TOTAL_RS'"

        strSql += vbCrLf + " 	SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPCOSALESCOLUMNS(CNAME)VALUES('''+@COL+''')'  "
        strSql += vbCrLf + " 	SELECT @QRY =@QRY+ 'INSERT INTO TEMPTABLEDB..TEMPCOSALESCOLUMNS(CNAME)VALUES('''+@COL1+''')'  "
        strSql += vbCrLf + " 	EXEC (@QRY)     "
        strSql += vbCrLf + " 	END CLOSE CUR1 DEALLOCATE CUR1"

        strSql += vbCrLf + " 	SELECT @QRY = 'ALTER TABLE TEMPTABLEDB..TEMPCOSALES ADD [RESULT] INTEGER '  "
        strSql += vbCrLf + " 	EXEC (@QRY)     "

        strSql += vbCrLf + " 	SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMPCOSALES SET [RESULT]=0 '  "
        strSql += vbCrLf + " 	SELECT @QRY =@QRY+ 'UPDATE TEMPTABLEDB..TEMPCOSALES SET [UNIT]=''GrsWt'' '  "
        strSql += vbCrLf + " 	EXEC (@QRY)     "

        strSql += vbCrLf + " 	DECLARE CUR CURSOR FOR SELECT DISTINCT COSTID FROM TEMPTABLEDB..TEMPCOSALESBR ORDER BY COSTID ASC"
        strSql += vbCrLf + " 	OPEN CUR WHILE (1 = 1) BEGIN FETCH NEXT FROM CUR INTO @CID  "
        strSql += vbCrLf + " 	IF @@FETCH_STATUS =-1 BREAK "
        strSql += vbCrLf + " 	SELECT @QRY1 = ' UPDATE T SET T.OP_'+@CID+'_WT=X.GRSWT,T.OP_'+@CID+'_RS=X.AMT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.OP_TOTAL_WT=ISNULL(T.OP_TOTAL_WT,0)+X.GRSWT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.OP_TOTAL_RS=ISNULL(T.OP_TOTAL_RS,0)+X.AMT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.CL_'+@CID+'_WT=ISNULL(T.CL_'+@CID+'_WT,0)+X.GRSWT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.CL_'+@CID+'_RS=ISNULL(T.CL_'+@CID+'_RS,0)+X.AMT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.CL_TOTAL_WT=ISNULL(T.OP_TOTAL_WT,0)+X.GRSWT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,T.CL_TOTAL_RS=ISNULL(T.OP_TOTAL_RS,0)+X.AMT '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' FROM ('"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' SELECT I.CATCODE,C.CATNAME,C.CATNAME AS TEMPCATNAME'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' ,SUM(I.GRSWT) AS GRSWT,SUM(I.AMOUNT) AS AMT'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' FROM '+@TRANDB+'..ISSUE AS I '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' LEFT JOIN '+@ADMINDB+'..CATEGORY AS C ON I.CATCODE=C.CATCODE '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' WHERE  TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@toDATE+''' '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' AND I.TRANTYPE=''SA'' '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' AND COSTID='''+ @CID  +'''  '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' AND ISNULL(CANCEL,'''')='''' '"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' GROUP BY I.COSTID,I.CATCODE,C.CATNAME'"
        strSql += vbCrLf + " 	SELECT @QRY1=@QRY1 +CHAR(13) + ' )X,TEMPTABLEDB..TEMPCOSALES AS T WHERE 1=1 AND  T.CATNAME=X.CATNAME '"
        strSql += vbCrLf + " 	PRINT @QRY1"
        strSql += vbCrLf + " 	EXEC (@QRY1)"
        strSql += vbCrLf + " 	END CLOSE CUR DEALLOCATE CUR"

        strSql += vbCrLf + " 	DECLARE CUR CURSOR FOR SELECT DISTINCT COSTID FROM TEMPTABLEDB..TEMPCOSALESBR ORDER BY COSTID ASC"
        strSql += vbCrLf + " 	OPEN CUR WHILE (1 = 1) BEGIN FETCH NEXT FROM CUR INTO @CID  "
        strSql += vbCrLf + " 	IF @@FETCH_STATUS =-1 BREAK "
        strSql += vbCrLf + " 	SELECT @QRY1 = ' UPDATE T SET T.TR_'+@CID+'_WT=X.GRSWT,T.TR_'+@CID+'_RS=X.AMT '"
