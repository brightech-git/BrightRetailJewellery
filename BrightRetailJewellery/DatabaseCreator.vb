        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY) "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES)>0    "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL7,COL8,COL9,COL10,COL9A,COL9B,COL9C,COL11,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT ''G TOTAL'' AS GTOTAL,SUM(ISNULL(AMOUNT,0)) AS AMOUNT,SUM(ISNULL(GRSWT,0)) AS GRSWT,SUM(ISNULL(NETWT,0)) AS NETWT  "
        strSql += vbCrLf + "  		, SUM(ISNULL(TAX,0))AS TAX   "
        strSql += vbCrLf + "  		, SUM(ISNULL(SGST,0))AS SGST   "
        strSql += vbCrLf + "  		, SUM(ISNULL(CGST,0))AS CGST   "
        strSql += vbCrLf + "  		, SUM(ISNULL(IGST,0))AS IGST   "
        strSql += vbCrLf + "  		,ROUND(SUM(ISNULL(RECEIPT,0)) - SUM(ISNULL(PAYMENT,0)),0) AS TOTAL,''G''      "
        strSql += vbCrLf + "  		FROM  "
        strSql += vbCrLf + "  		(  "
        strSql += vbCrLf + "  		SELECT AMOUNT,GRSWT,NETWT,TAX,SGST,CGST,IGST,RECEIPT,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  WHERE COLHEAD = ''S''   "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT AMOUNT,GRSWT,NETWT,TAX,NULL,NULL,NULL,RECEIPT,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET  WHERE COLHEAD = ''S''    "
        strSql += vbCrLf + "  		/*UNION ALL   "
        strSql += vbCrLf + "  		SELECT AMOUNT,GRSWT,NETWT,TAX,NULL,NULL,NULL,RECEIPT,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE  WHERE COLHEAD = ''S''      "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT AMOUNT,GRSWT,NETWT,RECEIPT,NULL,NULL,NULL,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVRECEIVED  WHERE COLHEAD = ''S''      "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT AMOUNT,GRSWT,NETWT,RECEIPT,NULL,NULL,NULL,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED  WHERE COLHEAD = ''S''        */    "
        strSql += vbCrLf + "  		)X  "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)      "
        strSql += vbCrLf + "  		/**************** OrderAdvance ************************ */     "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ORDADVANCE'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE     "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL) CUSNAME FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT+ISNULL(GSTVAL,0) AS AMOUNT, GRSWT,NETWT   "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''IG'' AND T.TRANTYPE =''OR'')AS IGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''CG'' AND T.TRANTYPE =''OR'')AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''SG'' AND T.TRANTYPE =''OR'')AS SGST  "
        strSql += vbCrLf + "  		,GSTVAL AS TAX  "
        strSql += vbCrLf + "  		, AMOUNT+ISNULL(GSTVAL,0) AS RECEIPT, 0 AS PAYMENT      "
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE   "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING AS O "
        strSql += vbCrLf + "  		WHERE TRANTYPE  = ''A'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  		AND PAYMODE = ''OR'' AND O.RECPAY = ''R'' AND (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'')  AND SUBSTRING(O.RUNNO,6,1) <> ''R''      "
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)    "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE)>0      "
        strSql += vbCrLf + "  		BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''ORDER ADVANCED'',''T''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE"
