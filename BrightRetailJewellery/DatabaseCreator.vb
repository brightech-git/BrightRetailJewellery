        strSql += vbCrLf + "			,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''D''AND T.TRANTYPE IN (''SA'',''OD'')"
        strSql += vbCrLf + "			AND A.PAYMODE NOT IN (''PU'',''PV'',''SR'',''RV'',''CB'')"
        strSql += vbCrLf + "			UNION ALL"
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''PU NO.''+CONVERT(VARCHAR,A.TRANNO)+'' DT:''+CONVERT(VARCHAR(100),A.TRANDATE,103)+ISNULL('' RS.''+CONVERT(VARCHAR,SUM(A.AMOUNT)),'''') CUSTOMER "
        strSql += vbCrLf + "			,''PURCHASE'' MODE "
        strSql += vbCrLf + "			,SUM(A.AMOUNT) AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''D''AND T.TRANTYPE IN (''SA'',''OD'')"
        strSql += vbCrLf + "			AND A.PAYMODE IN (''PU'',''PV'')"
        strSql += vbCrLf + "			GROUP BY A.TRANNO,A.TRANDATE,NSNO"
        strSql += vbCrLf + "			UNION ALL"
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''SR NO.''+CONVERT(VARCHAR,A.TRANNO)+'' DT:''+CONVERT(VARCHAR(100),A.TRANDATE,103)+ISNULL('' RS.''+CONVERT(VARCHAR,SUM(A.AMOUNT)),'''') CUSTOMER "
        strSql += vbCrLf + "			,''SALESRETURN'' MODE "
        strSql += vbCrLf + "			,SUM(A.AMOUNT) AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''D''AND T.TRANTYPE IN (''SA'',''OD'')"
        strSql += vbCrLf + "			AND A.PAYMODE IN (''SR'',''RV'')"
        strSql += vbCrLf + "			GROUP BY A.TRANNO,A.TRANDATE,NSNO"
        strSql += vbCrLf + "			UNION ALL"
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''CHIT''CUSTOMER "
        strSql += vbCrLf + "			,''CHIT DETUCTION'' MODE "
        strSql += vbCrLf + "			,SUM(A.AMOUNT*(-1)) AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''C''AND T.TRANTYPE IN (''SA'',''OD'')"
        strSql += vbCrLf + "			AND A.PAYMODE IN (''CD'')"
        strSql += vbCrLf + "			GROUP BY A.TRANNO,A.TRANDATE,NSNO'"
        strSql += vbCrLf + "			EXEC(@QRY) "
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		ELSE IF @RPTTYPE='PU' AND @PURTYPE = 'PU'"
        strSql += vbCrLf + "		BEGIN "
        strSql += vbCrLf + "			SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP(CUSTOMER,MODE,AMT,CREDIT,NSNO,NSNO1) "
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''SA NO.''+CONVERT(VARCHAR,A.TRANNO)+'' DT:''+CONVERT(VARCHAR(100),A.TRANDATE,103)+ISNULL('' RS.''+CONVERT(VARCHAR,SUM(A.AMOUNT)),'''') CUSTOMER "
        strSql += vbCrLf + "			,'''' MODE "
        strSql += vbCrLf + "			,0 AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''C''AND T.TRANTYPE IN (''PU'',''SR'')"
        strSql += vbCrLf + "			AND A.PAYMODE IN (''SA'',''SV'')"
        strSql += vbCrLf + "			GROUP BY A.TRANNO,A.TRANDATE,NSNO"
        strSql += vbCrLf + "			UNION ALL"
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''PURCHASE''CUSTOMER "
        strSql += vbCrLf + "			,''PURCHASE'' MODE "
        strSql += vbCrLf + "			,SUM(T.TOTAL) AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T "
        strSql += vbCrLf + "			WHERE T.TRANTYPE IN (''PU'')"
        strSql += vbCrLf + "			GROUP BY T.TRANNO,T.TRANDATE,NSNO'"
        strSql += vbCrLf + "			PRINT @QRY"
        strSql += vbCrLf + "			EXEC(@QRY) "
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		ELSE"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP(CUSTOMER,MODE,AMT,CREDIT,NSNO,NSNO1) "
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			CASE "
        strSql += vbCrLf + "			WHEN A.PAYMODE=''CA'' THEN ''CASH''"
        strSql += vbCrLf + "			WHEN A.PAYMODE IN (''CB'',''CG'',''CD'',''CZ'',''SS'') THEN '"
        strSql += vbCrLf + "			IF @CHITDBID<>''"
        strSql += vbCrLf + "			BEGIN"
        strSql += vbCrLf + "				SELECT @QRY = @QRY+	'ISNULL((SELECT TOP 1 PNAME FROM '+@CHITDBID+'SAVINGS..SCHEMEMAST S INNER JOIN '+@CHITDBID+'SAVINGS..PERSONALINFO P ON S.SNO = P.PERSONALID "
        strSql += vbCrLf + "				WHERE (S.GROUPCODE =CHQCARDREF AND CONVERT(VARCHAR,S.REGNO)=CHQCARDNO) OR (S.GROUPCODE =CHQCARDNO AND CONVERT(VARCHAR,S.REGNO)=CHQCARDREF ) ),'''')+'' '''"
        strSql += vbCrLf + "			END"
        strSql += vbCrLf + "			SELECT @QRY = @QRY+'''(''+ CHQCARDREF+'' ''+CHQCARDNO+'')''"
        strSql += vbCrLf + "			WHEN A.PAYMODE=''CH'' THEN ''CHQ NO.''+CHQCARDNO+'' DT:''+CONVERT(VARCHAR(100),A.TRANDATE,103) "
        strSql += vbCrLf + "			WHEN A.PAYMODE=''RO'' THEN ''ROUND OFF'' "
        strSql += vbCrLf + "			ELSE A.PAYMODE END CUSTOMER "
        strSql += vbCrLf + "			,CASE "
        strSql += vbCrLf + "			WHEN A.PAYMODE=''CA'' THEN ''CASH''"
        strSql += vbCrLf + "			WHEN A.PAYMODE IN (''CB'',''CG'',''CD'',''CZ'',''SS'') THEN ''CHIT''"
        strSql += vbCrLf + "			WHEN A.PAYMODE=''CH'' THEN ''CHEQUE''"
        strSql += vbCrLf + "			WHEN A.PAYMODE=''RO'' THEN ''ROUND OFF'' "
        strSql += vbCrLf + "			ELSE A.PAYMODE END MODE "
        strSql += vbCrLf + "			,CASE WHEN A.PAYMODE=''DU'' THEN 0 ELSE A.AMOUNT END AMOUNT"
        strSql += vbCrLf + "			,CASE WHEN A.PAYMODE=''DU'' THEN A.AMOUNT ELSE 0 END CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''C''AND T.TRANTYPE IN (''PU'',''SR'')"
        strSql += vbCrLf + "			AND A.PAYMODE NOT IN (''SA'',''SV'',''PV'')"
        strSql += vbCrLf + "			UNION ALL"
        strSql += vbCrLf + "			SELECT "
        strSql += vbCrLf + "			''SA NO.''+CONVERT(VARCHAR,A.TRANNO)+'' DT:''+CONVERT(VARCHAR(100),A.TRANDATE,103)+ISNULL('' RS.''+CONVERT(VARCHAR,SUM(A.AMOUNT)),'''') CUSTOMER "
        strSql += vbCrLf + "			,''SALES'' MODE "
        strSql += vbCrLf + "			,SUM(A.AMOUNT) AMOUNT"
        strSql += vbCrLf + "			,NULL CREDIT,NSNO,7"
        strSql += vbCrLf + "			FROM ACCTRAN A INNER JOIN TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP T ON A.BATCHNO=T.BATCHNO "
        strSql += vbCrLf + "			WHERE A.TRANMODE=''C''AND T.TRANTYPE IN (''PU'',''SR'')"
        strSql += vbCrLf + "			AND A.PAYMODE IN (''SA'',''SV'')"
        strSql += vbCrLf + "			GROUP BY A.TRANNO,A.TRANDATE,NSNO'"
        strSql += vbCrLf + "			EXEC(@QRY) "
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP SET AMT=(SELECT SUM(ISNULL(AMT,0)) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP) '  "
        strSql += vbCrLf + "		SELECT @QRY = @QRY + ' WHERE PARTICULAR=''GRAND TOTAL'' AND COLHEAD=''G'''  "
        strSql += vbCrLf + "		EXEC (@QRY)  	"
        strSql += vbCrLf + "		SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP SET CREDIT=(SELECT SUM(ISNULL(CREDIT,0)) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP) '  "
        strSql += vbCrLf + "		SELECT @QRY = @QRY + ' WHERE PARTICULAR=''GRAND TOTAL'' AND COLHEAD=''G'''  "
        strSql += vbCrLf + "		EXEC (@QRY) "
        strSql += vbCrLf + "		SELECT @QRY = 'SELECT *,IDENTITY(INT,1,1)SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP'  "
        strSql += vbCrLf + "		SELECT @QRY = @QRY + ' ORDER BY NSNO,NSNO1,TRANTYPE'  "
        strSql += vbCrLf + "		EXEC (@QRY)  "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "END /** PROC ENDS **/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub funcSP20_AbstractReport_ED_DETAIL()
        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ABSTRACT_SASRPU_ED_DETAIL')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_ABSTRACT_SASRPU_ED_DETAIL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_ABSTRACT_SASRPU_ED_DETAIL"
        strSql += vbCrLf + "( "
        strSql += vbCrLf + "@SUMMARYWISE VARCHAR(1)"
        strSql += vbCrLf + ",@MONTHWISE VARCHAR(1)"
        strSql += vbCrLf + ",@DATEWISE VARCHAR(1)      "
        strSql += vbCrLf + ",@TRANNOWISE VARCHAR(1)      "
        strSql += vbCrLf + ",@SYSTEMID VARCHAR(10)      "
        strSql += vbCrLf + ",@WITHSR VARCHAR(1)      "
        strSql += vbCrLf + ",@FRMDATE VARCHAR(12)      "
        strSql += vbCrLf + ",@TODATE VARCHAR(12)      "
        strSql += vbCrLf + ",@RPTTYPE VARCHAR(2)      "
        strSql += vbCrLf + ",@METALNAME VARCHAR(200)      "
        strSql += vbCrLf + ",@CATCODE VARCHAR(200)      "
        strSql += vbCrLf + ",@CATNAME VARCHAR(200)  "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(200)      "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)      "
        strSql += vbCrLf + ",@VA VARCHAR(1) = 'N'    "
        strSql += vbCrLf + ",@ED VARCHAR(1) = 'N'    "
        strSql += vbCrLf + ",@CHITDBID VARCHAR(3)=''    "
        strSql += vbCrLf + ",@WITHPR VARCHAR(1)  "
        strSql += vbCrLf + ",@WITHITEM VARCHAR(1)"
        strSql += vbCrLf + ",@STKTYPE VARCHAR(1)    "
        strSql += vbCrLf + ",@BILLPREFIX VARCHAR(1)    "
        strSql += vbCrLf + ")      "
        strSql += vbCrLf + "AS      "
        strSql += vbCrLf + "BEGIN /** PROC STARTS **/      "
        strSql += vbCrLf + "	SET NOCOUNT ON      "
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)    "
        strSql += vbCrLf + "	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA'      "
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)      "
        strSql += vbCrLf + "	EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME      "
        strSql += vbCrLf + "	EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL = 'TEMPCATEGORY',@INPUTVALUES = @CATCODE  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPDB..#ABSSUMMARY_SA') IS NOT NULL DROP TABLE #ABSSUMMARY_SA "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPDB..#METALMAST') IS NOT NULL DROP TABLE #METALMAST CREATE TABLE #METALMAST(METALID VARCHAR(10)) "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPDB..#CATEGORY') IS NOT NULL DROP TABLE #CATEGORY CREATE TABLE #CATEGORY(CATCODE VARCHAR(10)) "
        strSql += vbCrLf + "	SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '      "
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)      "
        strSql += vbCrLf + "	SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'"
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)      "
        strSql += vbCrLf + "	IF @METALNAME = '' OR @METALNAME = 'ALL'      "
        strSql += vbCrLf + "	INSERT INTO #METALMAST(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST      "
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	INSERT INTO #METALMAST(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME      "
        strSql += vbCrLf + "	IF @CATNAME = '' OR @CATNAME = 'ALL'      "
        strSql += vbCrLf + "	INSERT INTO #CATEGORY(CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY      "
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	INSERT INTO #CATEGORY(CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE CATNAME = @CATNAME      "
        strSql += vbCrLf + "	CREATE TABLE #ABSSUMMARY_SA      "
        strSql += vbCrLf + "	( "
        strSql += vbCrLf + "	PARTICULAR VARCHAR(350)"
        strSql += vbCrLf + "	,TRANNO VARCHAR(25) ,TRANDATE SMALLDATETIME,ITEMID INT ,ITEMNAME VARCHAR(50)    "
        strSql += vbCrLf + "	,PCS INT      "
        strSql += vbCrLf + "	,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),AMOUNT NUMERIC(15,2)    "
        strSql += vbCrLf + "	,ED NUMERIC(15,2),ECESS NUMERIC(15,2),HECESS NUMERIC(15,2),TOTALAMT NUMERIC(15,2)   "
        strSql += vbCrLf + "	,TOTAL NUMERIC(15,2)      "
        strSql += vbCrLf + "	,TAX NUMERIC(15,2),SC NUMERIC(15,2)    "
        strSql += vbCrLf + "	,STNCT NUMERIC(15,3),STNGT NUMERIC(15,3),DIAWT NUMERIC(15,4)  "
        strSql += vbCrLf + "	,MMONTHID INT ,MMONTHNAME VARCHAR(20),CATNAME VARCHAR(200),METALNAME VARCHAR(100)      "
        strSql += vbCrLf + "	,RESULT INT,COLHEAD VARCHAR(2),CUSTOMER VARCHAR(100),ADDRESS VARCHAR(500),PHONENO VARCHAR(30) "
        strSql += vbCrLf + "	,BILLNO VARCHAR(15),BILLDATE VARCHAR(15),ADDRESS1 VARCHAR(100),ADDRESS2 VARCHAR(100),ADDRESS3 VARCHAR(100),AREA VARCHAR(100),CITY VARCHAR(100)    "
        strSql += vbCrLf + "	,BATCHNO VARCHAR(20),TRANTYPE VARCHAR(5),ECS INT,MCHARGE NUMERIC(15,3),STOCKTYPE VARCHAR(25),ITEMTYPE VARCHAR(25),COSTNAME VARCHAR(50),COSTID VARCHAR(2)"
        strSql += vbCrLf + "	)      "
        strSql += vbCrLf + "	DECLARE @SEPDIA VARCHAR(1)      "
        strSql += vbCrLf + "	DECLARE @SEPSTONE VARCHAR(1)      "
        strSql += vbCrLf + "	DECLARE @SEPPRE VARCHAR(1)    "
        strSql += vbCrLf + "	DECLARE @SEPED VARCHAR(1)  "
        strSql += vbCrLf + "	SELECT @SEPED = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'RPT_SABS_STUDEDSEP'  "
        strSql += vbCrLf + "	SELECT @SEPDIA = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'SEPDIAPOST'      "
        strSql += vbCrLf + "	SELECT @SEPSTONE = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'SEPSTNPOST'      "
        strSql += vbCrLf + "	SELECT @SEPPRE = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'SEPPREPOST'   "
        strSql += vbCrLf + "	DECLARE @STNFILTER VARCHAR(15)"
        strSql += vbCrLf + "	SET @STNFILTER = ''"
        strSql += vbCrLf + "	IF @SEPSTONE='Y' SELECT @STNFILTER = @STNFILTER +',''S'''"
        strSql += vbCrLf + "	IF @SEPDIA='Y' SELECT @STNFILTER = @STNFILTER +',''D'''"
        strSql += vbCrLf + "	IF @SEPPRE='Y' SELECT @STNFILTER = @STNFILTER +',''P'''"
        strSql += vbCrLf + "	SET @STNFILTER = SUBSTRING(@STNFILTER,2,LEN(@STNFILTER))"
        strSql += vbCrLf + "	DECLARE @EDS VARCHAR(10)      "
        strSql += vbCrLf + "	DECLARE @ECESS VARCHAR(10)      "
        strSql += vbCrLf + "	DECLARE @HECESS VARCHAR(10) "
        strSql += vbCrLf + "	SELECT @EDS = '''ED='''     "
        strSql += vbCrLf + "	SELECT @ECESS = '''ECESS='''      "
        strSql += vbCrLf + "	SELECT @HECESS = '''HECESS='''  "
        strSql += vbCrLf + "	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'SAABSISSUEED'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SAABSISSUEED'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSUE'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSUE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSSTONE'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSSTONE'"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	SELECT @QRY =' SELECT *,CONVERT(NUMERIC(15,2),NULL)AS EDVAL INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSUE FROM ISSUE'"
        strSql += vbCrLf + "	SELECT @QRY =@QRY + CHAR(13)+' WHERE TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' '"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	SELECT @QRY =' UPDATE T SET EDVAL=TAXAMOUNT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSUE T ,TAXTRAN TT WHERE TT.ISSSNO=T.SNO AND TT.TAXID=''ED'''"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	SELECT @QRY =' SELECT *,CONVERT(NUMERIC(15,2),NULL)AS EDVAL INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSSTONE FROM ISSSTONE'"
        strSql += vbCrLf + "	SELECT @QRY =@QRY + CHAR(13)+' WHERE TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' '"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	IF @SEPED='Y'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	    SELECT @QRY =' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSSTONE SET EDVAL=CONVERT(NUMERIC(15,2),(STNAMT*1/101)) '"
        strSql += vbCrLf + "	    SELECT @QRY =@QRY + CHAR(13)+' WHERE ISSSNO IN(SELECT ISSSNO FROM TAXTRAN WHERE TRANTYPE =''SA'' AND TAXID=''ED'')'"
        strSql += vbCrLf + "	    EXEC (@QRY)"
        strSql += vbCrLf + "	    SELECT @QRY =' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ISSSTONE SET STNAMT=STNAMT-ISNULL(EDVAL,0)'"
        strSql += vbCrLf + "	    SELECT @QRY =@QRY + CHAR(13)+' WHERE ISSSNO IN(SELECT ISSSNO FROM TAXTRAN WHERE TRANTYPE =''SA'' AND TAXID=''ED'')'"
        strSql += vbCrLf + "	    EXEC (@QRY) "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @RPTTYPE = 'SA'      "
        strSql += vbCrLf + "	BEGIN /** RPTTYPE STARTS **/     "
        strSql += vbCrLf + "	IF @SEPDIA = 'Y'  OR @SEPSTONE='Y' OR @SEPPRE='Y'   "
        strSql += vbCrLf + "	BEGIN "
        strSql += vbCrLf + "		SELECT @QRY = ' SELECT I.CATCODE'"
        strSql += vbCrLf + "		SELECT @QRY = @QRY +CHAR(13) +' ,PCS,GRSWT,NETWT'"
