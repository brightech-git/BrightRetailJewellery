        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,REFDATE SMALLDATETIME,CHQCARDNO VARCHAR(30),CHQDATE SMALLDATETIME,ENTRYORDER INT,TMP NUMERIC(15,2)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' )'"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	/** OPENING CASH **/ "
        strSql += vbCrLf + " 	IF @OPENING = 'Y' "
