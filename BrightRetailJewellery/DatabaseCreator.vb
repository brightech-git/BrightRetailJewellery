        strSql += vbCrLf + "   ,RESULT,COLHEAD,ACNAME,ACGRPNAME,MAINGRPNAME,DISPORDER,SCHEDULECODE,TEMPACGRPNAME,COSTID,ACCODE"
        strSql += vbCrLf + "   INTO TEMPTABLEDB..TRAILBAL_B       "
