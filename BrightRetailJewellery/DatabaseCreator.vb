        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'TRANDATE,TRANTYPE,CATCODE,'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'0 RGRSWT,0 RNETWT,0 AMOUNT,STNWT IGRSWT,STNWT INETWT,STNAMT IAMOUNT '  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'FROM '+ @DBNAME +'..ISSSTONE '  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'WHERE BATCHNO IN (SELECT BATCHNO FROM '+ @DBNAME +'..ISSUE WHERE 1=1 '+ @BASEFILTER + @ODATEFILTER + '  '  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'AND BATCHNO NOT IN(SELECT BATCHNO FROM '+ @DBNAME +'..ISSMETAL WHERE 1=1 '+ @BASEFILTER  + @ODATEFILTER + '))'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'AND TRANTYPE IN(''SA'',''OD'',''RD'')'  "
