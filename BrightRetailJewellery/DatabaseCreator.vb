        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT CASE WHEN FROMFLAG = ''P'' THEN ''CONVERTION'' ELSE ''OTHER'' END ,''RATE CUT (''+CONVERT(VARCHAR(12),PUREWT)+''X''+CONVERT(VARCHAR(10),RATE)+'')'',TRANDATE,TRANNO,'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' 0,0,0,AMOUNT ,ACCODE,BATCHNO,10,REMARK1 AS  REMARK FROM ACCTRAN T'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND FROMFLAG =''W'' AND COMPANYID =  '''+@COMPANYID+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ISNULL(CANCEL,'''') = '''''      "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' UNION ALL' "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT CASE WHEN FROMFLAG = ''P'' THEN ''PAYMENT'' ELSE ''OTHER'' END,''RATE CUT (''+CONVERT(VARCHAR(12),PUREWT)+''X''+CONVERT(VARCHAR(10),RATE)+'')'',TRANDATE,TRANNO,'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' 0,0,0,CASE WHEN TRANMODE=''C'' THEN AMOUNT ELSE AMOUNT *(-1) END  AMOUNT,ACCODE,BATCHNO,11,REMARK1 AS  REMARK FROM ACCTRAN T'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+'''' "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND FROMFLAG = ''T'' AND ISNULL(CANCEL,'''') = ''''  AND COMPANYID =  '''+@COMPANYID+''''"
