        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADJUSTED ORDER BY RESULT      "

        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL4,COL5,COL6,COL7,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT ''CREDIT SALE TOTAL''CUSNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(MCHARGE),SUM(AMOUNT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),''S1''COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADJUSTED      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)   "
        strSql += vbCrLf + "  		PRINT'/*******************~ SCHEME ADJUSTED ***************~*/'"
