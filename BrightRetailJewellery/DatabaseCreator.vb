        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN ISNULL(CO.ITEMCTRNAME,'''')='''' THEN ''NO COUNTER'' ELSE CONVERT(VARCHAR(100),CO.ITEMCTRNAME) END AS COUNTER '"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(VARCHAR,(SELECT EMPNAME FROM  EMPMASTER WHERE EMPID = I.EMPID))AS EMPNAME'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' ,IM.ITEMNAME'"
