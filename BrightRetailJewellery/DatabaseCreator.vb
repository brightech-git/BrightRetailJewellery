        strSql += vbCrLf + " ,@GRPITEM VARCHAR(1)  "
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(500)"
        strSql += vbCrLf + " ,@ITEMID VARCHAR(500)"
        strSql += vbCrLf + " ,@CASHID VARCHAR(500)/*CASHID*/"
        strSql += vbCrLf + " ,@SYSTEM VARCHAR(500)/*SYSTEMID*/"
        strSql += vbCrLf + " ,@APPROVAL VARCHAR(1)/*SYSTEMID*/"
        strSql += vbCrLf + " ) "
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY  "
        strSql += vbCrLf + " 	CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))  "
        strSql += vbCrLf + " 	DECLARE @TCOMPANY VARCHAR(50)  "
        strSql += vbCrLf + " 	IF CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 		INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " 	WHILE CHARINDEX(',',@COMPANYID)>0  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 		SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)  "
        strSql += vbCrLf + " 		SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))  "
        strSql += vbCrLf + " 		IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + " 		BEGIN  "
        strSql += vbCrLf + " 			SET @COMPANYID= @COMPANYID + ','  "
        strSql += vbCrLf + " 		END  "
        strSql += vbCrLf + " 		INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY  "
        strSql += vbCrLf + " 	END     "
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE"
        strSql += vbCrLf + " 	CREATE TABLE #COSTCENTRE(COSTID VARCHAR(5))  "
        strSql += vbCrLf + " 	EXEC ..SP_SPLITVALUES_NEW @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '..TEMPCST',@INPUTVALUES =@COSTNAME,@DEF_VAL=',0'  "
        strSql += vbCrLf + " 	INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM TEMPCST  "
        strSql += vbCrLf + " 	DROP TABLE TEMPCST  "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..CASHID', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..CASHID "
        strSql += vbCrLf + "CREATE TABLE TEMPTABLEDB..CASHID(CASHID VARCHAR(500))  "
        strSql += vbCrLf + "EXEC ..SP_SPLITVALUES_NEW @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CASHCOUNTER',@CHK_FIELD = 'CASHNAME',@OUTPUT_FIELD='CASHID',@RESULT_TBL = 'TEMPTABLEDB..TEMPCST1',@INPUTVALUES =@CASHID,@DEF_VAL=',0'"
        strSql += vbCrLf + "INSERT INTO TEMPTABLEDB..CASHID(CASHID) SELECT CASHID FROM TEMPTABLEDB..TEMPCST1"
        strSql += vbCrLf + "DROP TABLE TEMPTABLEDB..TEMPCST1  "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..SYSTEM', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..[SYSTEM]"
        strSql += vbCrLf + "CREATE TABLE TEMPTABLEDB..[SYSTEM](SYSTEMID VARCHAR(500))  "
        strSql += vbCrLf + "EXEC ..SP_SPLITVALUES_NEW @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CASHCOUNTER',@CHK_FIELD = 'NODEID',@OUTPUT_FIELD='NODEID',@RESULT_TBL = 'TEMPTABLEDB..TEMPCST2',@INPUTVALUES =@SYSTEM,@DEF_VAL=',0'"
        strSql += vbCrLf + "INSERT INTO TEMPTABLEDB..[SYSTEM](SYSTEMID) SELECT NODEID FROM TEMPTABLEDB..TEMPCST2"
        strSql += vbCrLf + "DROP TABLE TEMPTABLEDB..TEMPCST2"
        strSql += vbCrLf + " 	DECLARE @STRQRY NVARCHAR(4000)  "
        strSql += vbCrLf + " 	DECLARE @ITEMFILTER NVARCHAR(1000)"
