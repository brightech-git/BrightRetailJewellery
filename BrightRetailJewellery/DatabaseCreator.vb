        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' ,CASE WHEN A.TRANMODE=''C'' AND A.PAYMODE=''CA'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CPAID'"
        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''AA'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS ADVANCE ,CASE WHEN A.PAYMODE=''DU''  THEN SUM(ISNULL(A.AMOUNT,0)) END AS CREDIT'"
