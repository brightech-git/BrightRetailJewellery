    Private Sub SP_RPT_SALRPTWASTMCPAYMODE()
        strSql = vbCrLf + "IF OBJECT_ID('SP_RPT_SALRPTWASTMCPAYMODE','P')IS NOT NULL "
        strSql += vbCrLf + " DROP PROC SP_RPT_SALRPTWASTMCPAYMODE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_SALRPTWASTMCPAYMODE"
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @DBNAME VARCHAR(15),"
        strSql += vbCrLf + " @BATCHNO VARCHAR(25),"
        strSql += vbCrLf + " @TBL VARCHAR(50)"
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @QRY AS VARCHAR(4000)"
        strSql += vbCrLf + "  	DECLARE @NAME VARCHAR(50)"
        strSql += vbCrLf + " 	DECLARE @VALUE VARCHAR(500)"
        strSql += vbCrLf + " 	DECLARE @TYPE VARCHAR(500)"
        strSql += vbCrLf + " 	DECLARE @VALUE1 VARCHAR(50)"
        strSql += vbCrLf + " 	SET @VALUE=''	"
        strSql += vbCrLf + " 	SET @TYPE=''"
        strSql += vbCrLf + " 	DECLARE  CUR CURSOR FOR"
        strSql += vbCrLf + " SELECT DISTINCT  PAYMODE FROM  " & tranDbName & "..ACCTRAN WHERE BATCHNO=@BATCHNO AND PAYMODE IN('SS','AA','CA','CC','CH','DR','DU','PU','DI','SR') AND TRANMODE='D'"
        strSql += vbCrLf + " OPEN CUR "
        strSql += vbCrLf + " FETCH NEXT FROM CUR INTO @NAME"
        strSql += vbCrLf + " WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	SELECT @TYPE = (SELECT PAYDESC  FROM TRANPAYMODE WHERE PAYMODE=''+@NAME +'')"
        strSql += vbCrLf + " 	SET @VALUE=@VALUE+ @TYPE + ','"
        strSql += vbCrLf + " 	FETCH NEXT FROM CUR INTO @NAME"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " CLOSE CUR"
        strSql += vbCrLf + " DEALLOCATE CUR"
        strSql += vbCrLf + " SELECT @QRY ='UPDATE '+ @TBL +' SET TYPE ='''+ LEFT(@VALUE, NULLIF(LEN(@VALUE)-1,-1)) +'''  WHERE BATCHNO='''+@BATCHNO+''''"
        strSql += vbCrLf + " PRINT @QRY"
        strSql += vbCrLf + " EXEC(@QRY)"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub RPT_ORDERSMITH()
        strSql = vbCrLf + "IF OBJECT_ID('RPT_ORDERSMITH','P')IS NOT NULL "
        strSql += vbCrLf + " DROP PROC RPT_ORDERSMITH"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE RPT_ORDERSMITH"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FROMDATE VARCHAR(12),"
        strSql += vbCrLf + " @TODATE VARCHAR(12),"
        strSql += vbCrLf + " @DBNAME VARCHAR(12),"
        strSql += vbCrLf + " @COMPANYID VARCHAR(120),"
        strSql += vbCrLf + " @COSTID VARCHAR(120),"
        strSql += vbCrLf + " @METALID VARCHAR(120),"
        strSql += vbCrLf + " @ORNO VARCHAR(120)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 	SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPORSNO'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPORSNO'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' IF OBJECT_ID(''TEMPTABLEDB..TEMPPAYABLERPT'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPAYABLERPT'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"

        strSql += vbCrLf + " 	SELECT @QRY = ' SELECT DISTINCT ORSNO INTO TEMPTABLEDB..TEMPORSNO FROM ORIRDETAIL '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' WHERE 1=1 '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' AND ISNULL(CANCEL,'''')='''' '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' AND TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''''"
        strSql += vbCrLf + " 	IF @COSTID <> ''"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' AND COSTID='''+ @COSTID +''''"
        strSql += vbCrLf + " 	IF @COMPANYID <> ''"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' AND COMPANYID='''+ @COMPANYID +''''"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"

        strSql += vbCrLf + " 	SELECT @QRY = ' SELECT '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' O.ORNO,O.ORDATE,O.PCS OPCS,O.GRSWT OGRSWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ORSTONE WHERE ORSNO=O.SNO))OSTNWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,O.NETWT ONETWT,R.PCS RPCS,R.GRSWT RGRSWT,R.NETWT RNETWT,R.METALID,R.WASTAGE RWASTAGE,R.PUREWT RPUREWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,R.MCGRM RMCGRM,CONVERT(NUMERIC(15,2),R.MCHARGE) RMCHARGE,R.TOUCH RTOUCH,G.BOARDRATE RATE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(15,2),ISNULL(R.WASTAGE,0)*ISNULL(G.BOARDRATE,0))WASTVAL'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(15,2),ISNULL(R.MCHARGE,0)-ISNULL(R.WASTAGE,0)*ISNULL(G.BOARDRATE,0))PAYABLE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' ,G.TAGNO,1 RESULT INTO TEMPTABLEDB..TEMPPAYABLERPT FROM ORIRDETAIL AS A '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' INNER JOIN TEMPTABLEDB..TEMPORSNO AS T ON A.ORSNO=T.ORSNO'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' INNER JOIN ORMAST AS O ON O.SNO=T.ORSNO'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' INNER JOIN '+ @DBNAME +'..RECEIPT AS R ON R.BATCHNO=A.BATCHNO'"
        strSql += vbCrLf + " 	IF @METALID <> ''"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' AND METALID='''+ @METALID +''''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' LEFT OUTER JOIN ITEMTAG AS G ON ORDREPNO=O.ORNO'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"

        strSql += vbCrLf + " 	SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPPAYABLERPT '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' (ORNO,OPCS,OGRSWT,OSTNWT,ONETWT,RPCS,RGRSWT,RNETWT,RWASTAGE,RPUREWT,RMCGRM,RMCHARGE,RTOUCH,RATE,WASTVAL,PAYABLE,RESULT)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' SELECT ''TOTAL'','"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' SUM(OPCS)OPCS,SUM(OGRSWT)OGRSWT,SUM(OSTNWT)OSTNWT,SUM(ONETWT)ONETWT,SUM(RPCS)RPCS,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' SUM(RGRSWT)RGRSWT,SUM(RNETWT)RNETWT,SUM(RWASTAGE)RWASTAGE,SUM(RPUREWT)RPUREWT,SUM(RMCGRM)RMCGRM,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' SUM(RMCHARGE)RMCHARGE,AVG(RTOUCH)RTOUCH,AVG(RATE)RATE,SUM(WASTVAL)WASTVAL,SUM(PAYABLE)PAYABLE,2'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) + ' FROM TEMPTABLEDB..TEMPPAYABLERPT '"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = ' SELECT * FROM TEMPTABLEDB..TEMPPAYABLERPT ORDER BY RESULT,ORDATE,ORNO'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub tageditemcostcenterwise()
