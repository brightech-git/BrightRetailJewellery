        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' ,PAN '  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' ,CONNECTIONPROPERTY(''local_net_address'') AS local_net_address'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' FROM'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ '('  "
        strSql += vbCrLf + " DECLARE @CURDBNAME AS VARCHAR(8000)  "
        strSql += vbCrLf + " DECLARE TASKOID_CURSOR CURSOR FOR   "
        strSql += vbCrLf + " SELECT DBNAME FROM DBMASTER WHERE ''+@PREVIOUSFROMDATE+''   "
        strSql += vbCrLf + " BETWEEN STARTDATE AND ENDDATE AND DBNAME IN (SELECT NAME FROM sys.databases)  "
        strSql += vbCrLf + " OPEN TASKOID_CURSOR  "
        strSql += vbCrLf + " FETCH NEXT FROM TASKOID_CURSOR INTO @CURDBNAME  "
        strSql += vbCrLf + " WHILE @@FETCH_STATUS = 0  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " PRINT @CURDBNAME  "
        strSql += vbCrLf + " 	SET @CQRY=''"
        strSql += vbCrLf + " 	IF @S1 > 0 SELECT @QRY= @QRY +CHAR(13)+ ' UNION ALL'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' SELECT '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ISNULL(SUM(ISNULL(AMOUNT,0)+ISNULL(TAX,0)),0) AMOUNT'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,ISNULL(A.ACNAME,'''') ACNAME'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,ISNULL(A.ACCODE,'''') ACCODE '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,ISNULL(A.GSTNO,'''') GSTNO '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,ISNULL(A.PAN,'''') PAN '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' FROM '+@CURDBNAME+'..RECEIPT M'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,'+@SALADMINDB+'..ACHEAD A'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' WHERE'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' M.ACCODE=A.ACCODE'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' AND ISNULL(M.CANCEL,'''')<>''Y'' '   "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' AND ISNULL(TRANTYPE,'''') = ''RPU'' '  "
        strSql += vbCrLf + " 	IF @ACCODE <> ''  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY +CHAR(13)+ ' AND A.ACCODE = '''+@ACCODE+''' '  "
