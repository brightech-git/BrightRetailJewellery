        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' BEGIN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPMONTHH (MONTHNAME,MM) SELECT DATENAME(MONTH,@DD),DATEPART(MONTH,@DD)'"
