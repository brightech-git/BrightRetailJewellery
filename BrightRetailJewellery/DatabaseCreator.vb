        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /*HEAD*/ "
        strSql += vbCrLf + "  IF PATINDEX('%R%',@ADDRESSMODE) <> 0"
        strSql += vbCrLf + "  BEGIN "
