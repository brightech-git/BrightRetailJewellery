        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN I.VOUCHERTYPE=''SALES'' THEN (SELECT SCHEMENAME FROM ' + @CHITDB + 'SAVINGS..SCHEME WHERE SCHEMEID ='"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 SCHEMEID FROM ' + @CHITDB + 'SAVINGS..SCHEMEMAST WHERE CONVERT(VARCHAR,GROUPCODE)+CONVERT(VARCHAR,REGNO) '"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' IN (SELECT TOP 1 ISNULL(CHQCARDREF,'''')+ISNULL(CHQCARDNO,'''') FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''SS'')))'"
