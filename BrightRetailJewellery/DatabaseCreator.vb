        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''PURCHASE '',SUM(PCS),SUM(GRSWT),SUM(NETWT),''1'' FROM '+@DBNAME+'..RECEIPT  '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' WHERE 1=1 AND CASHID='''+ @BILLCOUNTID +''''"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+  @COMFILTER"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' GROUP BY METALID'"
        strSql += vbCrLf + "  PRINT @QUERY "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY "

