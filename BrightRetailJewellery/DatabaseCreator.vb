        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+  @COMFILTER"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' GROUP BY METALID '"
        'strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''HOME SALES'',SUM(PCS),SUM(GRSWT),SUM(NETWT),''4'' FROM '+@DBNAME+'..ISSUE '"
        'strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' WHERE TAGNO<> '''' AND ITEMID IN ( SELECT ITEMID FROM ITEMMAST WHERE STOCKTYPE=''T'')'"
        'strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ 'AND CASHID='''+ @BILLCOUNTID +''''"
        'strSql += vbCrLf + "  SELECT @QUERY=@QUERY+  @COMFILTER"
        'strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' GROUP BY METALID'"
        strSql += vbCrLf + "  PRINT @QUERY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY "

        strSql += vbCrLf + "  SET @QUERY=' INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(METALID,PARTICULARS,R_PCS,R_GRSWT,R_NETWT,I_PCS,I_GRSWT,I_NETWT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''SUB TOTAL'',SUM(R_PCS),SUM(R_GRSWT),SUM(R_NETWT),SUM(I_PCS),SUM(I_GRSWT),SUM(I_NETWT),''T1'''"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' FROM TEMPTABLEDB..'+@TEMPTABLE+' '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' GROUP BY METALID'"
        strSql += vbCrLf + "  PRINT @QUERY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY "

        strSql += vbCrLf + "  SET @QUERY=' INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(METALID,PARTICULARS,I_PCS,I_GRSWT,I_NETWT,R_PCS,R_GRSWT,R_NETWT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''TOTAL:'',"
        strSql += vbCrLf + "  CASE WHEN SUM(I_PCS)-SUM(R_PCS)<0 THEN 0 ELSE SUM(I_PCS)-SUM(R_PCS) END I_PCS ,'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' CASE WHEN SUM(I_GRSWT)-SUM(R_GRSWT)<0 THEN 0 ELSE SUM(I_GRSWT)-SUM(R_GRSWT) END I_GRSWT'"
