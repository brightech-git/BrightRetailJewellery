    Private Sub Sp_RPT_TRIALBALANCE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TRIALBALANCE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TRIALBALANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_TRIALBALANCE    "
        'strSql += vbCrLf + "    (    "
        'strSql += vbCrLf + "    @FROMDATE SMALLDATETIME    "
        'strSql += vbCrLf + "    ,@TODATE SMALLDATETIME    "
        'strSql += vbCrLf + "    ,@COSTNAME VARCHAR(8000)    "
        'strSql += vbCrLf + "    ,@GROUPBY VARCHAR(1) /** (G)GROUP/(N)AME **/    "
        'strSql += vbCrLf + "    ,@RPT_TYPE VARCHAR(1) /**(D)ETAILD/(S)UMMARY**/    "
        'strSql += vbCrLf + "    ,@WITHOPENING VARCHAR(1) /** (Y)ES/(N)O **/    "
        'strSql += vbCrLf + "    ,@COMPANYID VARCHAR(3)    "
        'strSql += vbCrLf + "    ,@DISPCOL VARCHAR(3) /** (O)PENING(T)RANS**/"
        'strSql += vbCrLf + "    )    "
        'strSql += vbCrLf + "    AS    "
        'strSql += vbCrLf + "    SET NOCOUNT ON    "
        'strSql += vbCrLf + "    DECLARE @MAXLEN INT    "
        'strSql += vbCrLf + "    DECLARE @QRY VARCHAR(4000)    "
        'strSql += vbCrLf + "    IF @GROUPBY = 'N' SET @RPT_TYPE = 'D'    "
        'strSql += vbCrLf + "    SET @MAXLEN = 0    "
        'strSql += vbCrLf + "    EXEC " & TRANDBNAME & "..SP_SPLITVALUES @CHK_DB = '" & COMPID & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME    "
        'strSql += vbCrLf + "    SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '    "
        'strSql += vbCrLf + "    EXEC (@QRY)    "
        'strSql += vbCrLf + "    SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM " & COMPID & "ADMINDB..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'     "
        'strSql += vbCrLf + "    EXEC (@QRY)    "
        'strSql += vbCrLf + ""
        'strSql += vbCrLf + "    /** GETTING TRANSACTION **/    "
        'strSql += vbCrLf + "    IF OBJECT_ID('TEMPDB..#TRAILBAL_A') IS NOT NULL DROP TABLE #TRAILBAL_A    "
        'strSql += vbCrLf + "    SELECT     "
        'strSql += vbCrLf + "    X.SEP,X.ACCODE,X.AMOUNT    "
        'strSql += vbCrLf + "    ,H.ACNAME,CONVERT(VARCHAR(100),G.ACGRPNAME)ACGRPNAME,G.DISPORDER,CONVERT(VARCHAR(100),CASE WHEN G.SCHEDULECODE = '0' THEN '' ELSE ISNULL(G.SCHEDULECODE,'') END) AS SCHEDULECODE    "
        'strSql += vbCrLf + "    ,CONVERT(VARCHAR(100),G.ACGRPNAME) TEMPACGRPNAME    "
        'strSql += vbCrLf + "    INTO #TRAILBAL_A    "
        'strSql += vbCrLf + "    FROM    "
        'strSql += vbCrLf + "    (    "
        'strSql += vbCrLf + "    SELECT T.TRANMODE AS SEP,T.ACCODE,T.AMOUNT    "
        'strSql += vbCrLf + "    FROM " & TRANDBNAME & "..ACCTRAN AS T    "
        'strSql += vbCrLf + "    WHERE T.TRANDATE BETWEEN @FROMDATE AND @TODATE AND COMPANYID = @COMPANYID    "
        'strSql += vbCrLf + "    AND ISNULL(CANCEL,'') = ''   "
        'strSql += vbCrLf + "    AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        'strSql += vbCrLf + "    )X    "
        'strSql += vbCrLf + "    INNER JOIN " & COMPID & "ADMINDB..ACHEAD AS H ON H.ACCODE = X.ACCODE    "
        'strSql += vbCrLf + "    INNER JOIN " & COMPID & "ADMINDB..ACGROUP AS G ON G.ACGRPCODE = H.ACGRPCODE  "
        'strSql += vbCrLf + "  "
        'strSql += vbCrLf + "  "
        'strSql += vbCrLf + "    IF @WITHOPENING = 'Y'    "
        'strSql += vbCrLf + "    BEGIN    "
        'strSql += vbCrLf + "    /** GETTING OPENING **/    "
        'strSql += vbCrLf + "    INSERT INTO #TRAILBAL_A    "
        'strSql += vbCrLf + "    SELECT     "
        'strSql += vbCrLf + "    X.SEP,X.ACCODE,X.AMOUNT    "
        'strSql += vbCrLf + "    ,H.ACNAME,G.ACGRPNAME,G.DISPORDER,CONVERT(VARCHAR,CASE WHEN G.SCHEDULECODE = '0' THEN '' ELSE ISNULL(G.SCHEDULECODE,'') END) AS SCHEDULECODE,G.ACGRPNAME TEMPACGRPNAME    "
        'strSql += vbCrLf + "    FROM    "
        'strSql += vbCrLf + "    (    "
        'strSql += vbCrLf + "    SELECT 'O'SEP,ACCODE,CONVERT(NUMERIC(15,2),DEBIT-CREDIT) AS AMOUNT    "
        'strSql += vbCrLf + "    FROM " & tranDbName & "..OPENTRAILBALANCE    "
        'strSql += vbCrLf + "    WHERE COMPANYID = @COMPANYID   "
        'strSql += vbCrLf + "    AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        'strSql += vbCrLf + "    UNION ALL    "
        'strSql += vbCrLf + "    SELECT 'O'SEP,ACCODE,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT    "
        'strSql += vbCrLf + "    FROM " & tranDbName & "..ACCTRAN AS T    "
        'strSql += vbCrLf + "    WHERE T.TRANDATE < @FROMDATE AND COMPANYID = @COMPANYID    "
        'strSql += vbCrLf + "    AND ISNULL(CANCEL,'') = ''   "
        'strSql += vbCrLf + "    AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        'strSql += vbCrLf + "    )X    "
        'strSql += vbCrLf + "    INNER JOIN " & compId & "ADMINDB..ACHEAD AS H ON H.ACCODE = X.ACCODE    "
        'strSql += vbCrLf + "    INNER JOIN " & compId & "ADMINDB..ACGROUP AS G ON G.ACGRPCODE = H.ACGRPCODE    "
        'strSql += vbCrLf + "    END    "
        'strSql += vbCrLf + ""
        'strSql += vbCrLf + "     "
        'strSql += vbCrLf + "    IF (SELECT MAX(LEN(SCHEDULECODE)) FROM #TRAILBAL_A )>0    "
        'strSql += vbCrLf + "    BEGIN    "
        'strSql += vbCrLf + "    SET @MAXLEN = 4    "
        'strSql += vbCrLf + "    UPDATE #TRAILBAL_A SET SCHEDULECODE = '...' WHERE SCHEDULECODE = ''    "
        'strSql += vbCrLf + "    UPDATE #TRAILBAL_A SET ACGRPNAME = SCHEDULECODE + REPLICATE(' ',@MAXLEN-LEN(SCHEDULECODE)) + ACGRPNAME    "
        'strSql += vbCrLf + "    END    "
        'strSql += vbCrLf + "    IF @RPT_TYPE = 'S'    "
        'strSql += vbCrLf + "    UPDATE #TRAILBAL_A SET ACNAME = NULL    "
        'strSql += vbCrLf + ""
        'strSql += vbCrLf + "    IF OBJECT_ID('TEMPDB..#TRAILBAL_B') IS NOT NULL DROP TABLE #TRAILBAL_B    "
        'strSql += vbCrLf + "    SELECT @QRY='SELECT'     "
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+'PARTICULAR'    "
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN OPENING > 0 THEN OPENING ELSE 0 END AS ODEBIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN OPENING < 0 THEN -1*OPENING ELSE 0 END AS OCREDIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',DEBIT AS TDEBIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',CREDIT AS TCREDIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN CLOSING > 0 THEN CLOSING ELSE 0 END AS CDEBIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN CLOSING < 0 THEN -1*CLOSING ELSE 0 END AS CCREDIT    '"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+',RESULT,COLHEAD,ACNAME,ACGRPNAME,DISPORDER,SCHEDULECODE,TEMPACGRPNAME'    "
        'strSql += vbCrLf + "    IF @RPT_TYPE='D'"
        'strSql += vbCrLf + "        SELECT @QRY=@QRY+CHAR(13)+',ACCODE'"
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+'INTO #TRAILBAL_B'    "
        'strSql += vbCrLf + "    SELECT @QRY=@QRY+CHAR(13)+'FROM'    "
