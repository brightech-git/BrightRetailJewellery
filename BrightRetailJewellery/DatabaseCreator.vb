        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' (BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT,DIAWT'  "
        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD,SEP)'  "
