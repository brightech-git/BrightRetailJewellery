        strSql += vbCrLf + " 		SELECT @QRY='ALTER TABLE '+ @DBNAME +'..'+ @TABLENAME + ' ADD CONSTRAINT PK_'+ @TABLENAME + '_'+ REPLACE(@COLUMNNAME,',','_') +' PRIMARY KEY('+ @COLUMNNAME +')'"
        strSql += vbCrLf + " 		PRINT @QRY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	END TRY"
        strSql += vbCrLf + " 	BEGIN CATCH"
        strSql += vbCrLf + " 		INSERT INTO " & cnAdminDb & "..ERRORLOG VALUES(SUBSTRING(ERROR_MESSAGE(),1,100),@DBNAME,@TABLENAME,@COLUMNNAME,@QRY)"
        strSql += vbCrLf + " 	END CATCH"
        strSql += vbCrLf + " 	FETCH NEXT FROM CUR INTO @DBNAME,@TABLENAME,@COLUMNNAME"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " CLOSE CUR"
        strSql += vbCrLf + " DEALLOCATE CUR"
        strSql += vbCrLf + " END"
