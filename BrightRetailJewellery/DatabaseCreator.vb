        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' CASE WHEN FROMFLAG =''S'' AND PAYMODE = ''TR'' AND ISNULL(NETWT,0)<>0 then ''Dir Purch.''+ convert(varchar(10),netwt)+'' Avg @''+CONVERT(varchar(12),CONVERT(DECIMAL(12,2),(AMOUNT/netwt)))' "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' WHEN FROMFLAG =''S'' AND PAYMODE = ''TR'' AND ISNULL(NETWT,0)=0 then ''Dir Purch.''+ convert(varchar(10),netwt)+'' Avg @''+CONVERT(varchar(12),CONVERT(DECIMAL(12,2),(AMOUNT))) else '''' end' "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,TRANDATE,TRANNO,0,0,0,'"
