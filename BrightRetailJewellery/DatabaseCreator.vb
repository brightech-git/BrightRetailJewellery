    Private Sub AGRN_SP_TDSREPORT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='AGRN_SP_TDSREPORT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE AGRN_SP_TDSREPORT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()


        strSql = "CREATE PROCEDURE AGRN_SP_TDSREPORT"
        strSql += vbCrLf + " @COMPANYID VARCHAR(4)"
        strSql += vbCrLf + " ,@DBNAME VARCHAR(20)"
        strSql += vbCrLf + " ,@TEMPTABLE VARCHAR(20)"
        strSql += vbCrLf + " ,@FRMDATE VARCHAR(13)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(13)"
        strSql += vbCrLf + " ,@COSTIDS VARCHAR(500)"
        strSql += vbCrLf + " ,@ACCODE VARCHAR(500)"
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "DECLARE @QRY AS VARCHAR(4000)"
        strSql += vbCrLf + "DECLARE @ACFILTER AS VARCHAR(2000)"
        strSql += vbCrLf + "DECLARE @COSTFILTER AS VARCHAR(2000)"
        strSql += vbCrLf + "DECLARE @COMFILTER AS VARCHAR(2000)"
        strSql += vbCrLf + "SET @ACFILTER=''"
        strSql += vbCrLf + "SET @COSTFILTER=''"
        strSql += vbCrLf + "SET @COMFILTER=''"
        strSql += vbCrLf + "IF @ACCODE<>'ALL' SELECT @ACFILTER=' AND AC.ACCODE IN('+ @ACCODE +')'"
        strSql += vbCrLf + "IF @COSTIDS<>'ALL' SELECT @COSTFILTER=' AND AC.COSTID IN('+ @COSTIDS +')'"
        strSql += vbCrLf + "IF @COMPANYID<>'ALL' SELECT @COMFILTER=' AND AC.COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "SELECT @QRY='IF OBJECT_ID('''+ @TEMPTABLE +''')IS NOT NULL DROP TABLE '+@TEMPTABLE"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT CONVERT(VARCHAR(100),ACNAME)PARTICULAR,CODE,ACNAME,PANNO,TRANDATE,AMOUNT,TDSAMOUNT,TDSPER,REMARK1,REMARK2'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,(SELECT TDSCATNAME FROM TDSCATEGORY WHERE TDSCATID=X.TDSCATID)TDSNAME'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,2 RESULT,''DD'' COLHEAD INTO '+ @TEMPTABLE +' FROM ( '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT CONVERT(VARCHAR(15),CASE WHEN SUBSTRING(A.PAN,4,1)=''C'' THEN ''COMPANY'' ELSE ''INDIVIDUAL'' END) CODE'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,PAN PANNO,ACNAME,AC.TRANDATE'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,SUM(CASE WHEN TRANMODE=''C'' THEN AMOUNT ELSE AMOUNT *-1 END)AS AMOUNT'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,SUM(CASE WHEN TRANMODE=''C'' THEN TDSAMOUNT ELSE (TDSAMOUNT)*-1  END)AS TDSAMOUNT '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,AC.TDSPER,AC.TDSCATID'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,REMARK1,REMARK2'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' FROM ' + @DBNAME + '..ACCTRAN AC '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' LEFT JOIN ACHEAD AS A ON A.ACCODE=AC.ACCODE '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' WHERE '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' BATCHNO IN(SELECT BATCHNO FROM ' + @DBNAME + '..ACCTRAN WHERE '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +''' AND CANCEL<>''Y'''"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' AND ACCODE IN(SELECT ACCODE FROM ACHEAD WHERE ISNULL(TDSFLAG,'''')=''Y''))'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' AND ISNULL(TDSAMOUNT,0)<>0'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ @ACFILTER +' '+ @COSTFILTER + ' ' + @COMFILTER "
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' GROUP BY ACNAME,AC.TRANDATE,A.ACCODE,PAN,BATCHNO,REMARK1,REMARK2,AC.TDSPER,AC.TDSCATID'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' )X'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ORDER BY TRANDATE'"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY= ' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,TDSNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT DISTINCT TDSNAME,TDSNAME,0,''T'' FROM '+ @TEMPTABLE +' WHERE RESULT=2'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY) "
        strSql += vbCrLf + "SELECT @QRY= ' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,TDSNAME,CODE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT DISTINCT CODE,TDSNAME,CODE,0,''C'' FROM '+ @TEMPTABLE +' WHERE RESULT=2'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY= ' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,TDSNAME,CODE,AMOUNT,TDSAMOUNT,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT TDSNAME +''-SUBTOTAL'',TDSNAME,''ZZ'',SUM(ISNULL(AMOUNT,0))AMOUNT,SUM(ISNULL(TDSAMOUNT,0))TDSAMOUNT,3'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,''S'' FROM '+ @TEMPTABLE +' WHERE RESULT=2 GROUP BY TDSNAME'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY= ' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,TDSNAME,CODE,AMOUNT,TDSAMOUNT,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT CODE + ''-SUBTOTAL'',TDSNAME,CODE,SUM(ISNULL(AMOUNT,0))AMOUNT,SUM(ISNULL(TDSAMOUNT,0))TDSAMOUNT,4'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,''S1'' FROM '+ @TEMPTABLE +' WHERE RESULT=2 GROUP BY TDSNAME,CODE'"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY= ' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,TDSNAME,CODE,AMOUNT,TDSAMOUNT,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT ''GRANDTOTAL'',''ZZZZZZ'',99,SUM(ISNULL(AMOUNT,0))AMOUNT,SUM(ISNULL(TDSAMOUNT,0))TDSAMOUNT,5'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' ,''S'' FROM '+ @TEMPTABLE +' WHERE RESULT=2 '"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY='IF OBJECT_ID('''+ @TEMPTABLE +'_RES'')IS NOT NULL DROP TABLE '+@TEMPTABLE+'_RES'"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ ' SELECT IDENTITY(INT,1,1)SSNO,CONVERT(INT,NULL)SNO,* INTO '+ @TEMPTABLE +'_RES FROM '+ @TEMPTABLE +' ORDER BY TDSNAME,CODE,RESULT,TRANDATE'"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY=' UPDATE T SET T.SNO=(SELECT COUNT(SSNO) FROM '+ @TEMPTABLE +'_RES WHERE RESULT=2 AND CODE=T.CODE AND SSNO<=T.SSNO) '"
        strSql += vbCrLf + "SELECT @QRY= @QRY+ 'FROM '+ @TEMPTABLE +'_RES T WHERE RESULT=2'"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "SELECT @QRY= ' SELECT SNO,PARTICULAR,CODE,ACNAME,PANNO,CONVERT(VARCHAR(13),TRANDATE,103)TRANDATE,AMOUNT,TDSPER,TDSAMOUNT,REMARK1,REMARK2,TDSNAME,RESULT,COLHEAD  FROM '+ @TEMPTABLE +'_RES ORDER BY SSNO'"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY)"
        strSql += vbCrLf + "END"



        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_ITEMCOUNTER_STKREORDER()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ITEMCOUNTER_STKREORDER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ITEMCOUNTER_STKREORDER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_ITEMCOUNTER_STKREORDER"
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " 	 @COSTCENTRE VARCHAR(1000)    "
        strSql += vbCrLf + " 	,@ASONDATE SMALLDATETIME"
        strSql += vbCrLf + " 	,@ITEMCTRNAME VARCHAR(1000)    "
        strSql += vbCrLf + " 	,@COMPANY VARCHAR(1000)    "
        strSql += vbCrLf + " 	,@RTYPE VARCHAR(1) /** (B)OTH/(S)HORT/(E)XCESS **/    "
        strSql += vbCrLf + "    ,@WITHDIFFVALUE VARCHAR(1)"
        strSql += vbCrLf + " )    "
        strSql += vbCrLf + " AS    "
        strSql += vbCrLf + " SET NOCOUNT ON    "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMCOUNTER',@CHK_FEILD = 'ITEMCTRID', @RESULT_TBL = 'TEMPITEMCOUNTER',@INPUTVALUES = @ITEMCTRNAME"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTCENTRE"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANY"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#STKORDER') IS NOT NULL DROP TABLE #STKORDER  "
        strSql += vbCrLf + " SELECT  "
        strSql += vbCrLf + " 	 CONVERT(VARCHAR(600),'OTHERS') AS  PARTICULAR    "
        strSql += vbCrLf + " 	,CONVERT(INT,SUM(T.PCS)) STKPCS,CONVERT(NUMERIC(15,3),SUM(T.GRSWT))STKWT,NULL REPCS,NULL AS REWT  "
        strSql += vbCrLf + " 	,CONVERT(INT,ISNULL(SUM(T.PCS),0)) AS DIFFPCS    "
        strSql += vbCrLf + " 	,CONVERT(NUMERIC(15,3),ISNULL(SUM(T.GRSWT),0)) AS DIFFWT    	"
        strSql += vbCrLf + " 	,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + " INTO #NONSTKORDER  "
        strSql += vbCrLf + " FROM " & cnAdminDb & "..ITEMTAG AS T"
        strSql += vbCrLf + " WHERE "
        strSql += vbCrLf + " T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE) "
        strSql += vbCrLf + " AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)     "
        strSql += vbCrLf + " AND T.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)   "
        strSql += vbCrLf + "  AND T.ITEMCTRID NOT IN (SELECT ITEMCTRID FROM " & compId & "ADMINDB..ITEMCOUNTER)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#STKORDER') IS NOT NULL DROP TABLE #STKORDER  "
        strSql += vbCrLf + " SELECT  "
        strSql += vbCrLf + " 	 CONVERT(VARCHAR(600),ITEMCTRNAME) AS  PARTICULAR    "
        strSql += vbCrLf + " 	,CONVERT(INT,SUM(T.PCS)) STKPCS,CONVERT(NUMERIC(15,3),SUM(T.GRSWT))STKWT,RE.PCS REPCS,RE.WEIGHT AS REWT  "
        strSql += vbCrLf + " 	,CONVERT(INT,ISNULL(SUM(T.PCS),0)- ISNULL(RE.PCS,0)) AS DIFFPCS    "
        strSql += vbCrLf + " 	,CONVERT(NUMERIC(15,3),ISNULL(SUM(T.GRSWT),0) - ISNULL(RE.WEIGHT,0)) AS DIFFWT    	"
        strSql += vbCrLf + " 	,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + " INTO #STKORDER  "
        strSql += vbCrLf + " FROM " & compId & "ADMINDB..ITEMCOUNTER AS RE  "
        strSql += vbCrLf + " INNER JOIN " & cnAdminDb & "..ITEMTAG AS T ON RE.ITEMCTRID = T.ITEMCTRID"
        strSql += vbCrLf + " AND T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE) "
        strSql += vbCrLf + " WHERE RE.ITEMCTRID IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)    "
        strSql += vbCrLf + " AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)     "
        strSql += vbCrLf + " AND T.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)     "
        strSql += vbCrLf + " GROUP BY ITEMCTRNAME,RE.PCS,RE.WEIGHT"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO #STKORDER  "
        strSql += vbCrLf + " (PARTICULAR,STKPCS,STKWT,DIFFPCS,DIFFWT,RESULT)  "
        strSql += vbCrLf + " SELECT "
        strSql += vbCrLf + " 	PARTICULAR,SUM(T.STKPCS),SUM(T.STKWT),SUM(T.STKPCS),SUM(T.STKWT),RESULT  "
        strSql += vbCrLf + " FROM #NONSTKORDER AS T  "
        strSql += vbCrLf + " GROUP BY RESULT,PARTICULAR  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @RTYPE = 'S'  "
        strSql += vbCrLf + " 	DELETE FROM #STKORDER WHERE NOT (DIFFPCS < 0 OR DIFFWT < 0)  "
        strSql += vbCrLf + " IF @RTYPE = 'E'  "
        strSql += vbCrLf + " 	DELETE FROM #STKORDER WHERE NOT (DIFFPCS > 0 OR DIFFWT > 0)  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM #STKORDER)>0    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " INSERT INTO #STKORDER(PARTICULAR,RESULT,COLHEAD,STKPCS,STKWT,REPCS,REWT,DIFFPCS,DIFFWT)    "
        strSql += vbCrLf + "   SELECT 'GRAND TOTAL',3 RESULT,'G'COLHEAD,SUM(STKPCS),SUM(STKWT),SUM(REPCS),SUM(REWT),SUM(DIFFPCS),SUM(DIFFWT)    "
        strSql += vbCrLf + "   FROM #STKORDER WHERE RESULT IN (1,2)  "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPITEMCOUNTER') IS NOT NULL DROP TABLE TEMPITEMCOUNTER    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPCOSTCENTRE') IS NOT NULL DROP TABLE TEMPCOSTCENTRE    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPCOMPANY') IS NOT NULL DROP TABLE TEMPCOMPANY  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "   IF @WITHDIFFVALUE = 'Y'"
        strSql += vbCrLf + "  	 BEGIN"
        strSql += vbCrLf + "  	 SELECT * FROM #STKORDER  ORDER BY RESULT,PARTICULAR"
        strSql += vbCrLf + "  	 END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "  	 BEGIN"
        strSql += vbCrLf + "  	 SELECT * FROM #STKORDER  WHERE NOT (DIFFPCS = 0 AND DIFFWT = 0) ORDER BY RESULT,PARTICULAR"
        strSql += vbCrLf + "  	 END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_DAILYREPORT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAILYREPORT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_DAILYREPORT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  CREATE PROCEDURE [dbo].[SP_DAILYREPORT]    "
        strSql += vbCrLf + "     @FRMDATE SMALLDATETIME   "
        strSql += vbCrLf + "     ,@TODATE SMALLDATETIME --@TODATE    "
        strSql += vbCrLf + "     ,@COMPANYID VARCHAR(5000)  "
        strSql += vbCrLf + "     AS  "
        strSql += vbCrLf + "  SET NOCOUNT ON   "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY     "
        strSql += vbCrLf + "         CREATE TABLE #COMPANY (COMPANYID VARCHAR(9))"
        strSql += vbCrLf + "         DECLARE @TCOMPANY VARCHAR(9)     "
        strSql += vbCrLf + "         IF CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + "         IF @COMPANYID = 'ALL'   "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "      INSERT INTO #COMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY       "
        strSql += vbCrLf + "      END     "
        strSql += vbCrLf + "         ELSE  "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "          WHILE CHARINDEX(',',@COMPANYID)>0     "
        strSql += vbCrLf + "       BEGIN     "
        strSql += vbCrLf + "       SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)     "
        strSql += vbCrLf + "       SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))     "
        strSql += vbCrLf + "       IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0     "
        strSql += vbCrLf + "       SET @COMPANYID= @COMPANYID + ','     "
        strSql += vbCrLf + "       INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY     "
        strSql += vbCrLf + "       END    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "   IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPDAYREPORT1')>0 DROP TABLE MASTER..TEMPDAYREPORT1   "
        strSql += vbCrLf + "      CREATE TABLE MASTER..TEMPDAYREPORT1    "
        strSql += vbCrLf + "       (    "
        strSql += vbCrLf + "       COL1 VARCHAR(150)    "
        strSql += vbCrLf + "       ,COL2 VARCHAR(100)    "
        strSql += vbCrLf + "       ,COL3 VARCHAR(100)    "
        strSql += vbCrLf + "       ,COL4 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL5 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL6 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL7 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL8 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL9 VARCHAR(25)    "
        strSql += vbCrLf + "       ,COL10 VARCHAR(25)"
        strSql += vbCrLf + "       ,COL11 VARCHAR(25) "
        strSql += vbCrLf + "       ,COLHEAD VARCHAR(2) "
        strSql += vbCrLf + "       ,KEYNO INT IDENTITY(0,1)    "
        strSql += vbCrLf + "       )    "
        strSql += vbCrLf + "      --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SALES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSALES')>0 DROP TABLE MASTER..TEMPSALES  "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO   "
        strSql += vbCrLf + "      ,' ' + (SELECT (PNAME+' '+INITIAL) FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO     "
        strSql += vbCrLf + "       WHERE BATCHNO = I.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "       ,(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST AS IT WHERE IT.ITEMID = I.ITEMID) AS ITEMNAME    "
        strSql += vbCrLf + "       ,MCHARGE, RATE, AMOUNT, GRSWT,NETWT,TAX, AMOUNT + TAX AS  RECEIPT, 0 AS PAYMENT    "
        strSql += vbCrLf + "       ,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY AS M WHERE M.CATCODE = I.CATCODE) AS METALNAME "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPSALES   "
        strSql += vbCrLf + "       FROM  "
        strSql += vbCrLf + "       (  "
        strSql += vbCrLf + "       SELECT TRANNO,BATCHNO,ITEMID,MCHARGE,RATE,AMOUNT-ISNULL((SELECT SUM(STNAMT)FROM ISSSTONE WHERE ISSSNO = I.SNO),0) AS AMOUNT  "
        strSql += vbCrLf + "      ,GRSWT,NETWT,CASE WHEN AMOUNT <> 0 THEN TAX-ISNULL((SELECT SUM(TAX)FROM ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END TAX,CATCODE  "
        strSql += vbCrLf + "       FROM ISSUE AS I      "
        strSql += vbCrLf + "       WHERE TRANTYPE  IN ('SA','OD','RD') AND TRANDATE BETWEEN @FRMDATE AND @TODATE  AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + "       AND ISNULL(I.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)     "
        strSql += vbCrLf + "       UNION ALL  "
        strSql += vbCrLf + "       SELECT TRANNO,BATCHNO,STNITEMID,0 MCHARGE,STNRATE RATE,STNAMT AS AMOUNT  "
        strSql += vbCrLf + "      ,STNWT GRSWT,STNWT NETWT,CASE WHEN STNAMT <> 0 THEN TAX ELSE 0 END,CATCODE "
        strSql += vbCrLf + "       FROM ISSSTONE WHERE ISSSNO IN (SELECT SNO FROM ISSUE AS I  "
        strSql += vbCrLf + "       WHERE TRANTYPE  IN ('SA','OD','RD') AND TRANDATE BETWEEN @FRMDATE AND @TODATE  AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + "       AND ISNULL(I.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY))  "
        strSql += vbCrLf + "       )AS I  "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPSALES)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'SALES DETAIL','T'    "
        strSql += vbCrLf + "      INSERT INTO MASTER..TEMPSALES   "
        strSql += vbCrLf + "       (CUSNAME,METALNAME,COLHEAD,RESULT,PAYMENT)   "
        strSql += vbCrLf + "       SELECT DISTINCT METALNAME,METALNAME,'S'COLHEAD,0 RESULT,0 PAYMENT FROM MASTER..TEMPSALES WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSALES     "
        strSql += vbCrLf + "       (CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "        SELECT METALNAME + ' SUBTOTAL' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "        FROM MASTER..TEMPSALES WHERE RESULT = 1 GROUP BY METALNAME     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT 'CUSTOMER','BILLNO','ITEMNAME','MCHARGE','RATE','AMOUNT','GRSWT','NETWT','TAX','RECEIPT','PAYMENT','S2' "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPSALES ORDER BY METALNAME,RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SALES RETURN ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSALESRET')>0 DROP TABLE MASTER..TEMPSALESRET "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL) CUSNAME FROM  " & compId & "ADMINDB..PERSONALINFO WHERE SNO = (sELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO     "
        strSql += vbCrLf + "       WHERE BATCHNO = R.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "       ,(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST AS IT WHERE IT.ITEMID = R.ITEMID) AS ITEMNAME    "
        strSql += vbCrLf + "       ,MCHARGE, RATE, AMOUNT, GRSWT,NETWT ,TAX, 0 AS  RECEIPT, AMOUNT + TAX AS PAYMENT    "
        strSql += vbCrLf + "       ,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY AS M WHERE M.CATCODE = R.CATCODE) AS METALNAME  "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPSALESRET  FROM RECEIPT AS R      "
        strSql += vbCrLf + "       WHERE TRANTYPE  = 'SR' AND TRANDATE BETWEEN @FRMDATE AND @TODATE  AND ISNULL(CANCEL,'') = ''      "
        strSql += vbCrLf + "       AND ISNULL(R.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)  "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPSALESRET)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'SALES RETUREN DETAIL','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSALESRET   "
        strSql += vbCrLf + "       (CUSNAME,METALNAME,COLHEAD,RESULT,RECEIPT) "
        strSql += vbCrLf + "       SELECT DISTINCT METALNAME,METALNAME,'S'COLHEAD,0 RESULT, 0 RECEIPT FROM MASTER..TEMPSALESRET WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSALESRET     "
        strSql += vbCrLf + "       (CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "        SELECT METALNAME + ' SUBTOTAL' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "        FROM MASTER..TEMPSALESRET WHERE RESULT = 1 GROUP BY METALNAME      "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPSALESRET ORDER BY METALNAME,RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ PURCHASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPPURCHASE')>0 DROP TABLE MASTER..TEMPPURCHASE      "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL)  FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO = (sELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO     "
        strSql += vbCrLf + "       WHERE BATCHNO = R.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "       ,(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST AS IT WHERE IT.ITEMID = R.ITEMID) AS ITEMNAME    "
        strSql += vbCrLf + "     ,MCHARGE, RATE, AMOUNT, GRSWT,NETWT,TAX, 0 AS  RECEIPT, AMOUNT + TAX AS PAYMENT    "
        strSql += vbCrLf + "       ,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY AS M WHERE M.CATCODE = R.CATCODE) AS METALNAME    "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT INTO MASTER..TEMPPURCHASE  FROM RECEIPT AS R"
        strSql += vbCrLf + "       WHERE TRANTYPE  = 'PU' AND TRANDATE BETWEEN @FRMDATE AND @TODATE  AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + "       AND ISNULL(R.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)  "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPPURCHASE)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'PURCHASE DETAIL','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPURCHASE   "
        strSql += vbCrLf + "       (CUSNAME,METALNAME,COLHEAD,RESULT,RECEIPT) "
        strSql += vbCrLf + "       SELECT DISTINCT METALNAME,METALNAME,'S'COLHEAD,0 RESULT, 0 RECEIPT FROM MASTER..TEMPPURCHASE WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPURCHASE     "
        strSql += vbCrLf + "      (CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "        SELECT METALNAME+' SUBTOTAL' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT)    "
        strSql += vbCrLf + "       ,'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "        FROM MASTER..TEMPPURCHASE WHERE RESULT = 1 GROUP BY METALNAME      "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPPURCHASE ORDER BY METALNAME,RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "   /**  "
        strSql += vbCrLf + "   **/  "
        strSql += vbCrLf + "      --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ORDER ADJUSTED ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~`    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPORDADJUSTED')>0 DROP TABLE MASTER..TEMPORDADJUSTED      "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL) CUSNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO =     "
        strSql += vbCrLf + "       (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'') AS ITEMNAME    "
        strSql += vbCrLf + "       , 0 AS MCHARGE, RATE, AMOUNT, GRSWT,NETWT ,0 AS TAX, 0 AS RECEIPT, AMOUNT  AS PAYMENT   "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPORDADJUSTED FROM " & compId & "ADMINDB..OUTSTANDING AS O  WHERE TRANTYPE  = 'A' AND TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "       AND PAYMODE IN ('AA','AP') AND O.RECPAY = 'P' AND (SUBSTRING(O.RUNNO,6,10) LIKE 'O%' OR SUBSTRING(O.RUNNO,6,10) LIKE 'R%') AND SUBSTRING(O.RUNNO,6,1) <> 'R'    "
        strSql += vbCrLf + "       AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)  "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPORDADJUSTED)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'ORDER ADJUSTED','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPORDADJUSTED     "
        strSql += vbCrLf + "       (CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT 'SUBTOTAL' CUSNAME,'',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "       FROM MASTER..TEMPORDADJUSTED WHERE RESULT = 1   "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPORDADJUSTED ORDER BY RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      -- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ OrderAdvance ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPORDADVANCE')>0 DROP TABLE MASTER..TEMPORDADVANCE   "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL) CUSNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO =     "
        strSql += vbCrLf + "       (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'') AS ITEMNAME    "
        strSql += vbCrLf + "       , 0 AS MCHARGE, RATE, AMOUNT, GRSWT,NETWT ,0 AS TAX, AMOUNT AS RECEIPT, 0 AS PAYMENT    "
        strSql += vbCrLf + "      ,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPORDADVANCE FROM " & compId & "ADMINDB..OUTSTANDING AS O      "
        strSql += vbCrLf + "       WHERE TRANTYPE  = 'A' AND TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "       AND PAYMODE = 'OR' AND O.RECPAY = 'R' AND (SUBSTRING(O.RUNNO,6,10) LIKE 'O%' OR SUBSTRING(O.RUNNO,6,10) LIKE 'R%')  AND SUBSTRING(O.RUNNO,6,1) <> 'R'    "
        strSql += vbCrLf + "       AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)  "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPORDADVANCE)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'ORDER ADVANCED','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPORDADVANCE     "
        strSql += vbCrLf + "       (CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "        SELECT 'SUBTOTAL' CUSNAME,'',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "        FROM MASTER..TEMPORDADVANCE WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPORDADVANCE ORDER BY RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END     "
        strSql += vbCrLf + "       IF (SELECT COUNT(*) FROM MASTER..TEMPSALES)>0  "
        strSql += vbCrLf + "       BEGIN  "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL9,COL10,COLHEAD)    "
        strSql += vbCrLf + "       SELECT 'G TOTAL' AS GTOTAL, SUM(ISNULL(TAX,0))AS TAX ,ROUND(SUM(ISNULL(RECEIPT,0)) - SUM(ISNULL(PAYMENT,0)),0) AS TOTAL,'G'    "
        strSql += vbCrLf + "       FROM    "
        strSql += vbCrLf + "       (    "
        strSql += vbCrLf + "       SELECT TAX,RECEIPT,PAYMENT FROM MASTER..TEMPSALES  WHERE COLHEAD = 'S'   --AND RESULT !=0  "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT TAX,RECEIPT,PAYMENT FROM MASTER..TEMPSALESRET  WHERE COLHEAD = 'S'  "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT TAX,RECEIPT,PAYMENT FROM MASTER..TEMPPURCHASE  WHERE COLHEAD = 'S'    "
        strSql += vbCrLf + "       /*UNION ALL     "
        strSql += vbCrLf + "       SELECT RECEIPT,PAYMENT FROM MASTER..TEMPADVRECEIVED  WHERE COLHEAD = 'S'    "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT RECEIPT,PAYMENT FROM MASTER..TEMPADVADJUSTED  WHERE COLHEAD = 'S'        */  "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT TAX,RECEIPT,PAYMENT FROM MASTER..TEMPORDADJUSTED  WHERE COLHEAD = 'S'    "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT TAX,RECEIPT,PAYMENT FROM MASTER..TEMPORDADVANCE  WHERE COLHEAD = 'S'    "
        strSql += vbCrLf + "       )X    "
        strSql += vbCrLf + "       END   "
        strSql += vbCrLf + "      -- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASH COLLECTION DETAILS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCOLDET')>0 DROP TABLE MASTER..TEMPCOLDET  "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR(50),(CASE     "
        strSql += vbCrLf + "       WHEN PAYMODE='CA' THEN 'CASH' WHEN PAYMODE = 'CC' THEN 'CREDIT CARD' WHEN PAYMODE = 'CH' THEN 'CHEQUE'     "
        strSql += vbCrLf + "       WHEN PAYMODE = 'SS' THEN 'SCHEME' WHEN PAYMODE = 'ET' THEN 'ETRANSFER' WHEN PAYMODE = 'OT' THEN 'OTHERS'WHEN PAYMODE = 'SV' THEN 'TAX'  END)) AS CUSNAME,    "
        strSql += vbCrLf + "       (CASE WHEN SUM(AMOUNT)< 0 THEN  ABS(SUM(AMOUNT)) ELSE 0 END) AS RECEIPT ,    "
        strSql += vbCrLf + "       (CASE WHEN SUM(AMOUNT)> 0 THEN  SUM(AMOUNT) ELSE 0 END) AS PAYMENT"
        strSql += vbCrLf + "       INTO MASTER..TEMPCOLDET    "
        strSql += vbCrLf + "       FROM (    "
        strSql += vbCrLf + "       SELECT 'CA' PAYMODE,SUM((CASE WHEN A.TRANMODE = 'C' THEN AMOUNT ELSE -AMOUNT END)) AS AMOUNT    "
        strSql += vbCrLf + "       FROM " & tranDbName & "..ACCTRAN A  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  AND ISNULL(A.CANCEL,'') = ''    "
        strSql += vbCrLf + "       AND ISNULL(A.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)  "
        strSql += vbCrLf + "       AND PAYMODE IN ('CA') AND FROMFLAG NOT IN ('','S','O','A') "
        strSql += vbCrLf + "       )X     "
        strSql += vbCrLf + "       GROUP BY PAYMODE  HAVING(SUM(AMOUNT) <> 0)    "
        strSql += vbCrLf + "       IF (SELECT COUNT(*) FROM MASTER..TEMPCOLDET)>0 "
        strSql += vbCrLf + "       BEGIN  "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'COLLECTION DETAILS','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10,COL11)    "
        strSql += vbCrLf + "       SELECT * FROM MASTER..TEMPCOLDET    "
        strSql += vbCrLf + "       END  "
        strSql += vbCrLf + "      -- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ CARD AND CHEQ COLLECTION DETAILS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCARDCOLLECT')>0 DROP TABLE MASTER..TEMPCARDCOLLECT "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR(500),PARTICULAR)PARTICULAR,TRANDATE,TRANNO,SUM(AMOUNT)AMOUNT,CHQCARDNO,SYSTEMID,PAYMODE,CONVERT(VARCHAR(3),COLHEAD)COLHEAD,RESULT,CARDNAME "
        strSql += vbCrLf + "      INTO MASTER..TEMPCARDCOLLECT  "
        strSql += vbCrLf + "       FROM (    "
        strSql += vbCrLf + "       SELECT ' ' + CHQCARDREF AS PARTICULAR,TRANDATE,TRANNO "
        strSql += vbCrLf + "       ,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT,CASE WHEN PAYMODE IN ('SS','CB','CZ','CG','CD')   "
        strSql += vbCrLf + "       THEN CHQCARDREF + ':' + CHQCARDNO ELSE CHQCARDNO END CHQCARDNO,SYSTEMID,CASE PAYMODE WHEN 'CC' THEN 'CREDIT CARD' WHEN 'CH' THEN 'CHEQUE'"
        strSql += vbCrLf + "       ELSE 'SCHEME' END AS PAYMODE,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(INT,2) RESULT "
        strSql += vbCrLf + "       ,(SELECT TOP 1 NAME FROM " & compId & "ADMINDB..CREDITCARD WHERE CARDCODE = T.CARDID)AS CARDNAME      "
        strSql += vbCrLf + "       FROM " & tranDbName & "..ACCTRAN T   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE IN ('CC','CH') AND ISNULL(CANCEL,'') = ''     "
        strSql += vbCrLf + "       AND ISNULL(T.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)     "
        strSql += vbCrLf + "       )X "
        strSql += vbCrLf + "       GROUP BY PARTICULAR,TRANDATE,TRANNO,CHQCARDNO,SYSTEMID,PAYMODE,CARDNAME,RESULT,COLHEAD "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPCARDCOLLECT(PAYMODE,PARTICULAR,RESULT,COLHEAD) "
        strSql += vbCrLf + "       SELECT DISTINCT PAYMODE,PAYMODE,0 RESULT,'T' COLHEAD FROM MASTER..TEMPCARDCOLLECT WHERE RESULT = 2 "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPCARDCOLLECT(PAYMODE,PARTICULAR,AMOUNT,RESULT,COLHEAD,CARDNAME) "
        strSql += vbCrLf + "       SELECT DISTINCT PAYMODE,PAYMODE+' SUB TOTAL',SUM(AMOUNT),3 RESULT,'S','ZZZZ' COLHEAD FROM MASTER..TEMPCARDCOLLECT WHERE RESULT = 2 GROUP BY PAYMODE "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPCARDCOLLECT(PAYMODE,RESULT,COLHEAD,CARDNAME,PARTICULAR)"
        strSql += vbCrLf + "       SELECT DISTINCT PAYMODE,1 RESULT,'T1' COLHEAD,CARDNAME,CARDNAME + ' [' + ISNULL(CONVERT(VARCHAR,SUM(AMOUNT)),'') +']' FROM MASTER..TEMPCARDCOLLECT WHERE RESULT = 2 AND PAYMODE = 'CREDIT CARD'  GROUP BY PAYMODE,CARDNAME      "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT PARTICULAR,AMOUNT,'',COLHEAD FROM MASTER..TEMPCARDCOLLECT ORDER BY PAYMODE,CARDNAME,RESULT,PARTICULAR,TRANDATE,TRANNO    "
        strSql += vbCrLf + "       IF (SELECT COUNT(*) FROM MASTER..TEMPCOLDET)>0   "
        strSql += vbCrLf + "       BEGIN  "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10,COLHEAD)    "
        strSql += vbCrLf + "       SELECT 'G TOTAL' AS GTOTAL,ROUND(SUM(ISNULL(RECEIPT,0)) - SUM(ISNULL(PAYMENT,0)),0) AS TOTAL,'G'    "
        strSql += vbCrLf + "       FROM    "
        strSql += vbCrLf + "       (    "
        strSql += vbCrLf + "       SELECT RECEIPT,PAYMENT FROM MASTER..TEMPCOLDET      "
        strSql += vbCrLf + "       UNION ALL    "
        strSql += vbCrLf + "       SELECT AMOUNT,0 FROM MASTER..TEMPCARDCOLLECT  WHERE COLHEAD = 'S'    "
        strSql += vbCrLf + "       )X    "
        strSql += vbCrLf + "       END  "
        strSql += vbCrLf + "   DECLARE @CASHACC AS VARCHAR(7)  "
        strSql += vbCrLf + "   SELECT @CASHACC = CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE  CTLID='CASH'    "
        strSql += vbCrLf + "   INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10)  "
        strSql += vbCrLf + "   SELECT TOP 1 'CASH OPENING' ,ISNULL((SELECT SUM(DEBIT-CREDIT) FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE IN (@CASHACC) AND COMPANYID  IN (SELECT COMPANYID FROM #COMPANY)),0)  "
        strSql += vbCrLf + "    +ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE < @TODATE AND ACCODE IN (@CASHACC) AND ISNULL(CANCEL,'') = ''),0)   "
        strSql += vbCrLf + "    FROM " & tranDbName & "..ACCTRAN AS T WHERE TRANDATE < @TODATE"
        strSql += vbCrLf + "    AND ISNULL(CANCEL,'') = ''  AND ISNULL(T.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "  --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ credit sales ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~  "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCREDITSALES')>0 DROP TABLE MASTER..TEMPCREDITSALES      "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL)  FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO =     "
        strSql += vbCrLf + "       (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "       , CONVERT(VARCHAR(100),'') AS ITEMNAME    "
        strSql += vbCrLf + "       , 0 AS MCHARGE, RATE, AMOUNT, GRSWT ,NETWT,0 AS TAX,AMOUNT  AS RECEIPT, 0 AS PAYMENT     "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPCREDITSALES FROM " & compId & "ADMINDB..OUTSTANDING AS O  WHERE TRANTYPE  = 'D' AND TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "       AND PAYMODE = 'DU' AND O.RECPAY = 'P'  AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE 'O%' OR SUBSTRING(O.RUNNO,6,10) LIKE 'R%') AND CANCEL <>'Y'  "
        strSql += vbCrLf + "       AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPCREDITSALES)>0     "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'CREDIT SALE','S'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPCREDITSALES     "
        strSql += vbCrLf + "       (CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT 'CREDIT SALE SUBTOTAL' CUSNAME,'',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "       FROM MASTER..TEMPCREDITSALES WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPCREDITSALES ORDER BY RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "   --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ AdvanceReceived ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~     "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPADVRECEIVED')>0 DROP TABLE MASTER..TEMPADVRECEIVED      "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL)  FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO =     "
        strSql += vbCrLf + "       (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "   , CONVERT(VARCHAR(100),'') AS ITEMNAME    "
        strSql += vbCrLf + "       , 0 AS MCHARGE, RATE, AMOUNT, GRSWT ,NETWT,0 AS TAX,AMOUNT  AS RECEIPT, 0 AS PAYMENT     "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPADVRECEIVED FROM " & compId & "ADMINDB..OUTSTANDING AS O  WHERE TRANTYPE  = 'A' AND TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "       AND PAYMODE = 'AR' AND O.RECPAY = 'R'  AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE 'O%' OR SUBSTRING(O.RUNNO,6,10) LIKE 'R%')   AND CANCEL <>'Y'     "
        strSql += vbCrLf + "       AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPADVRECEIVED)>0     "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'ADVANCE RECEIVED','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPADVRECEIVED     "
        strSql += vbCrLf + "       (CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT 'SUBTOTAL' CUSNAME,'',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "       FROM MASTER..TEMPADVRECEIVED WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPADVRECEIVED ORDER BY RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      --~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Advance Adjusted ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~     "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPADVADJUSTED')>0 DROP TABLE MASTER..TEMPADVADJUSTED     "
        strSql += vbCrLf + "       SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "       ,' ' + (SELECT (PNAME+' '+INITIAL) CUSNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO =     "
        strSql += vbCrLf + "       (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'') AS ITEMNAME    "
        strSql += vbCrLf + "       , 0 AS MCHARGE, RATE, AMOUNT, GRSWT,NETWT ,0 AS TAX,0 AS RECEIPT, AMOUNT  AS PAYMENT     "
        strSql += vbCrLf + "       ,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT"
        strSql += vbCrLf + "       INTO MASTER..TEMPADVADJUSTED FROM " & compId & "ADMINDB..OUTSTANDING AS O  WHERE TRANTYPE  = 'A' AND TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "       AND  PAYMODE IN ('AA','AP') AND O.RECPAY = 'P' AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE 'O%' OR SUBSTRING(O.RUNNO,6,10) LIKE 'R%')    "
        strSql += vbCrLf + "       AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "      IF (SELECT COUNT(*) FROM MASTER..TEMPADVADJUSTED)>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COLHEAD)SELECT 'ADVANCE ADJUSTED','T'    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPADVADJUSTED     "
        strSql += vbCrLf + "       (CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT 'SUBTOTAL' CUSNAME,'',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),'S' COLHEAD,2 RESULT   "
        strSql += vbCrLf + "       FROM MASTER..TEMPADVADJUSTED WHERE RESULT = 1     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COLHEAD)    "
        strSql += vbCrLf + "       SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM MASTER..TEMPADVADJUSTED ORDER BY RESULT    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1)SELECT ''    "
        strSql += vbCrLf + "      END  "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10,COL11)    "
        strSql += vbCrLf + "       SELECT 'SALES BY CASH',COL10,COL11 FROM MASTER..TEMPDAYREPORT1 WHERE COL1='CASH'  "
        strSql += vbCrLf + "   INSERT INTO MASTER..TEMPDAYREPORT1(COL1,COL10)  "
        strSql += vbCrLf + "   SELECT TOP 1 'CASH IN HAND' ,ISNULL((SELECT SUM(DEBIT-CREDIT) FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE IN (@CASHACC) AND COMPANYID  IN (SELECT COMPANYID FROM #COMPANY)),0)  "
        strSql += vbCrLf + "    +ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE <= @TODATE AND ACCODE IN (@CASHACC) AND ISNULL(CANCEL,'') = ''),0)   "
        strSql += vbCrLf + "    FROM " & tranDbName & "..ACCTRAN AS T WHERE TRANDATE <= @TODATE"
        strSql += vbCrLf + "    AND ISNULL(CANCEL,'') = ''  AND ISNULL(T.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "      END  "
        cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_DAILYREPORTNEW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAILYREPORTNEW')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_DAILYREPORTNEW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_DAILYREPORTNEW "
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  @FRMDATE VARCHAR(15)  "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(15)  "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(5000)  "
        strSql += vbCrLf + "  ,@FORMAT VARCHAR(1)  "
        strSql += vbCrLf + "  ,@SYSTEMID VARCHAR(10) "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  	SET NOCOUNT ON  "
        strSql += vbCrLf + "  	DECLARE @QRY VARCHAR(8000)  "
        strSql += vbCrLf + "  	DECLARE  @CASHACC AS VARCHAR(7)    "
        strSql += vbCrLf + "  	SELECT @CASHACC = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE  CTLID='CASH'  "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY  "
        strSql += vbCrLf + "  	CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(9))  "
        strSql += vbCrLf + "  	DECLARE @TCOMPANY VARCHAR(9)  "
        strSql += vbCrLf + "  	IF @COMPANYID = 'ALL'  "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY  "
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	ELSE  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		IF @COMPANYID <> 'ALL' SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "  		SELECT @QRY= 'INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYID IN('''+ @COMPANYID + ''')'  "
        strSql += vbCrLf + "  		EXEC (@QRY)    "
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	IF @FORMAT<>'N'  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'DAYREPORT1'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1     "
        strSql += vbCrLf + "  		CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1  "
        strSql += vbCrLf + "  		(  "
        strSql += vbCrLf + "  		COL1 VARCHAR(150)  "
        strSql += vbCrLf + "  		,COL2 VARCHAR(100)  "
        strSql += vbCrLf + "  		,COL3 VARCHAR(100)  "
        strSql += vbCrLf + "  		,COL4 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL5 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL6 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL7 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL8 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9A VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9B VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9C VARCHAR(25)"
        strSql += vbCrLf + "  		,COL10 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL11 VARCHAR(25)   "
        strSql += vbCrLf + "  		,COL12 VARCHAR(25)   "
        strSql += vbCrLf + "  		,COLHEAD VARCHAR(2)   "
        strSql += vbCrLf + "  		,KEYNO INT IDENTITY(0,1)  "
        strSql += vbCrLf + "  		)'  "
        strSql += vbCrLf + "  		PRINT (@QRY)  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		/******************** SALES ********************~*/      "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'SALES'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO  "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL) FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO  "
        strSql += vbCrLf + "  		WHERE BATCHNO = I.BATCHNO)) AS CUSNAME  "
        strSql += vbCrLf + "  		,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = I.ITEMID) AS ITEMNAME  "
        strSql += vbCrLf + "  		,MCHARGE,VALUEADD, RATE, AMOUNT, GRSWT,NETWT,SGST,CGST,IGST,TAX, AMOUNT + TAX AS  RECEIPT, 0 AS PAYMENT  "
        strSql += vbCrLf + "  		,(SELECT CATNAME FROM " & cnAdminDb & "..CATEGORY AS M WHERE M.CATCODE = I.CATCODE) AS METALNAME  "
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		FROM  "
        strSql += vbCrLf + "  		(  "
        strSql += vbCrLf + "  		SELECT TRANNO,BATCHNO,ITEMID,MCHARGE,CONVERT(DECIMAL(15,2),ISNULL(WASTAGE,0)*RATE) VALUEADD, RATE,AMOUNT-ISNULL((SELECT CASE WHEN ISNULL(I.TRANTYPE,'''')=''OD'' THEN 0 ELSE SUM(STNAMT) END FROM ISSSTONE WHERE ISSSNO = I.SNO),0) AS AMOUNT  "
        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE GRSWT END)AS GRSWT  "
        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE NETWT END)AS NETWT  "
        strSql += vbCrLf + "  		,CASE WHEN AMOUNT <> 0 THEN TAX-ISNULL((SELECT SUM(TAX)FROM ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END TAX  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''SG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''CG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''IG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS IGST  "
        strSql += vbCrLf + "  		,CATCODE  "
        strSql += vbCrLf + "  		FROM ISSUE AS I  "
        strSql += vbCrLf + "  		WHERE TRANTYPE  IN (''SA'',''OD'',''RD'')   "
        strSql += vbCrLf + "  		AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''    "
        strSql += vbCrLf + "  		AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  		AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "  		AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT TRANNO,BATCHNO,STNITEMID,0 MCHARGE,0 VALUEADD,STNRATE RATE,STNAMT AS AMOUNT  "
        strSql += vbCrLf + "  		,STNWT GRSWT,STNWT NETWT  "
        strSql += vbCrLf + "  		,CASE WHEN STNAMT <> 0 THEN TAX ELSE 0 END  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS IGST  "
        strSql += vbCrLf + "  		,CATCODE  "
        strSql += vbCrLf + "  		FROM ISSSTONE SS WHERE ISSSNO IN (SELECT SNO FROM ISSUE AS I  "
        strSql += vbCrLf + "  		WHERE TRANTYPE  IN (''SA'',''OD'',''RD'') AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') <> ''Y''  "
