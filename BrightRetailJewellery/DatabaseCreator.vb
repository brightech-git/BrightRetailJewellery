        strSql += vbCrLf + " 		)X ON X.RUNNO = O.RUNNO AND X.COSTID = O.COSTID AND X.COMPANYID = O.COMPANYID)  "
        strSql += vbCrLf + " 		UPDATE TEMPTABLEDB..OUTSTDT SET PAYMODE='DP' WHERE RUNNO IN (  "
