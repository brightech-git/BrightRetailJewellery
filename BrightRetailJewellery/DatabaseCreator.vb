        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' GROUP BY X.INVDATE,X.TRANNO,X.BATCHNO,X.COSTID,X.HSNCODE, X.GSTNO,X.PNAME'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,X.DOORNO,X.ADDRESS1,X.ADDRESS2,X.ADDRESS3,X.AREA,X.CITY,X.STATE,X.COUNTRY,X.PINCODE,X.PHONE,X.MOBILE,X.EMAIL,X.BATCHNO'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,X.RESULT,X.COLHEAD,X.COSTID,X.REFNO,X.REFDATE'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ORDER BY X.INVDATE,X.TRANNO'						"
        strSql += vbCrLf + "  		PRINT(@QRY)"
        strSql += vbCrLf + "  		EXEC(@QRY)"
