    Private Sub SP_RPT_CREDITOUTSTANDING()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CREDITBALANCE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CREDITBALANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()


        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_CREDITBALANCE    "
        strSql += vbCrLf + "         (  "
        strSql += vbCrLf + "          @ACCODE VARCHAR(50)"
        strSql += vbCrLf + "         ,@COSTID VARCHAR(50)"
        strSql += vbCrLf + "         ,@FRMDATE VARCHAR(12)"
        strSql += vbCrLf + "         ,@ASONDATE VARCHAR(12)     "
        strSql += vbCrLf + "         ,@COMPANYID VARCHAR(3)  "
        strSql += vbCrLf + "         ,@CNADMINDB VARCHAR(50) "
        strSql += vbCrLf + "         ,@CNSTOCKDB VARCHAR(50)"
        strSql += vbCrLf + "         ,@CRDAYS VARCHAR(2)"
        strSql += vbCrLf + "         ,@ISSUMMARY VARCHAR(2)"
        strSql += vbCrLf + "         ,@ACTYPE VARCHAR(10)    "
        strSql += vbCrLf + "         ,@ACGROUP VARCHAR(10)   "
        strSql += vbCrLf + "         )  "
        strSql += vbCrLf + "         AS"
        strSql += vbCrLf + "         SET NOCOUNT ON  "
        strSql += vbCrLf + "          DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "             SELECT @QRY =' EXEC '+@CNSTOCKDB+'..SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''ACHEAD'',@CHK_FEILD = ''ACCODE'',@RESULT_TBL = ''TEMPACCODE'',@INPUTVALUES ='''+@ACCODE+''''  "
        strSql += vbCrLf + "               PRINT @QRY    "
        strSql += vbCrLf + "               EXEC (@QRY)"
        strSql += vbCrLf + "             SELECT @QRY =' EXEC '+@CNSTOCKDB+'..SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''COSTCENTRE'',@CHK_FEILD = ''COSTID'',@RESULT_TBL = ''TEMPCOSTCENTRE'',@INPUTVALUES ='''+@COSTID+''''  "
        strSql += vbCrLf + "      PRINT @QRY    "
        strSql += vbCrLf + "      EXEC (@QRY)     "
        strSql += vbCrLf + "      DECLARE @ACFILTER VARCHAR(200)"
        strSql += vbCrLf + "      SET @ACFILTER = ''"
        strSql += vbCrLf + "      IF @ACTYPE <> ''    SELECT @ACFILTER = ' AND T.ACCODE IN (SELECT ACCODE FROM '+@CNADMINDB+'..ACHEAD  WHERE ACTYPE IN ('''+@ACTYPE+'''))'"
        strSql += vbCrLf + "      IF @ACGROUP <> ''  SELECT @ACFILTER = @ACFILTER +' AND T.ACCODE IN (SELECT ACCODE FROM '+@CNADMINDB+'..ACHEAD  WHERE ACGRPCODE IN ('''+@ACGROUP+'''))'"
        strSql += vbCrLf + "      IF @ISSUMMARY='N'"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY =''"
        strSql += vbCrLf + "   SELECT @QRY =' IF (SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPCREDITSUMMARY'')>0 DROP TABLE TEMPTABLEDB..TEMPCREDITSUMMARY'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' SELECT *'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' INTO TEMPTABLEDB..TEMPCREDITSUMMARY'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' FROM'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' ('    "
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' SELECT CONVERT(VARCHAR(20),NULL)TRANNO,CONVERT(SMALLDATETIME,NULL) TRANDATE,ACNAME AS PARTY'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' ,CASE WHEN SUM(DEBIT) - SUM(CREDIT) > 0 THEN SUM(DEBIT) - SUM(CREDIT) ELSE 0 END AS DEBIT'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' ,CASE WHEN SUM(CREDIT)- SUM(DEBIT) > 0 THEN SUM(CREDIT)- SUM(DEBIT) ELSE 0 END AS CREDIT'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' ,ACCODE,CONVERT(VARCHAR(20),NULL)OVERDAYS,CONVERT(NUMERIC(18,2),0)CREDITDAYS'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' ,1 RESULT,CONVERT(SMALLDATETIME,NULL)BILLDATE'"
        strSql += vbCrLf + "   SELECT @QRY =@QRY +' FROM '"
