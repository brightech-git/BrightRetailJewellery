        strSql += vbCrLf + "  		UNION ALL      "
        strSql += vbCrLf + "  		SELECT TAX,RECEIPT,PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE  WHERE COLHEAD = ''S''      "
        strSql += vbCrLf + "  		)X      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT 3  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY) */    "
        strSql += vbCrLf + "  		PRINT'/**************** PARTLY SALES ***************~*/'"
        strSql += vbCrLf + "  		SELECT @QRY= '   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COLHEAD)SELECT ''PARTLY SALES'',''T''          '  "
        strSql += vbCrLf + "  		PRINT 4  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC(@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= '   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL4,COL5)      "
        strSql += vbCrLf + "  		SELECT (SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID)AS ITEMNAME,I.TRANNO  "
        strSql += vbCrLf + "  		,ISNULL(TAGPCS,0)-ISNULL(I.PCS,0) PCS,ISNULL(TAGGRSWT,0)-ISNULL(I.GRSWT,0) GRSWT  "
        strSql += vbCrLf + "  		FROM ISSUE I WHERE I.TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  "
        strSql += vbCrLf + "  		AND I.ITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE STOCKTYPE = ''T'') AND I.TAGNO <> ''''  "
        strSql += vbCrLf + "  		AND ISNULL(I.CANCEL,'''') = ''''  "
        strSql += vbCrLf + "  		AND ((TAGPCS)<>PCS OR (TAGGRSWT)<> GRSWT OR (TAGNETWT)<>NETWT) "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL4,COL5,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT ''PARTLY SALES TOTAL'' AS ITEMNAME  "
        strSql += vbCrLf + "  		,SUM(ISNULL(TAGPCS,0)-ISNULL(I.PCS,0) )PCS,SUM(ISNULL(TAGGRSWT,0)-ISNULL(I.GRSWT,0)) GRSWT  ,''S1''"
        strSql += vbCrLf + "  		FROM ISSUE I WHERE I.TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  "
        strSql += vbCrLf + "  		AND I.ITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE STOCKTYPE = ''T'') AND I.TAGNO <> ''''  "
        strSql += vbCrLf + "  		AND ISNULL(I.CANCEL,'''') = ''''  "
        strSql += vbCrLf + "  		AND ((TAGPCS)<>PCS OR (TAGGRSWT)<> GRSWT OR (TAGNETWT)<>NETWT) '  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC(@QRY)  "
        strSql += vbCrLf + "  		PRINT'/**************** CASH COLLECTION DETAILS *************************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'COLDET'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET    "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(50),(CASE  WHEN PAYMODE=''CA'' THEN ''CASH'' WHEN PAYMODE = ''CC''   "
        strSql += vbCrLf + "  		THEN ''CREDIT CARD'' WHEN PAYMODE = ''CH'' THEN ''CHEQUE''"
        strSql += vbCrLf + "  		WHEN PAYMODE = ''SS'' THEN ''SCHEME'' WHEN PAYMODE = ''ET'' THEN ''ETRANSFER'' WHEN PAYMODE = ''OT'' THEN ''OTHERS''WHEN PAYMODE = ''SV'' THEN ''TAX''  END)) AS CUSNAME,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)< 0 THEN  ABS(SUM(AMOUNT)) ELSE 0 END) AS RECEIPT ,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)> 0 THEN  SUM(AMOUNT) ELSE 0 END) AS PAYMENT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET      "
        strSql += vbCrLf + "  		FROM (      "
        strSql += vbCrLf + "  		SELECT ''CA'' PAYMODE,SUM(CASE WHEN A.TRANMODE = ''C'' THEN A.AMOUNT ELSE -A.AMOUNT END) AS AMOUNT      "
        strSql += vbCrLf + "  		FROM ACCTRAN A    "
        strSql += vbCrLf + "  		WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(A.CANCEL,'''') <> ''Y''"
        strSql += vbCrLf + "  		AND ISNULL(A.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)    "
        strSql += vbCrLf + "  		AND PAYMODE IN (''CA'') AND FROMFLAG NOT IN ('''',''S'',''O'',''A'') AND BATCHNO IN (SELECT BATCHNO FROM ISSUE)  "
        strSql += vbCrLf + "  		group by PAYMODE  "
        strSql += vbCrLf + "  		)X"
        strSql += vbCrLf + "  		GROUP BY PAYMODE  HAVING(SUM(AMOUNT) <> 0)' "
        strSql += vbCrLf + "  		PRINT @QRY    "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		PRINT'/**************** CARD AND CHEQ COLLECTION DETAILS *************************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CARDCOLLECT'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT   "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(500),PARTICULAR)PARTICULAR,TRANDATE,TRANNO,SUM(AMOUNT)AMOUNT,CHQCARDNO,SYSTEMID,PAYMODE,CONVERT(VARCHAR(3),COLHEAD)COLHEAD,RESULT,CARDNAME   "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT   "
        strSql += vbCrLf + "  		FROM (   "
        strSql += vbCrLf + "  		SELECT (CHQCARDREF+''  ''+CHQCARDNO) AS PARTICULAR,T.TRANDATE,T.TRANNO   "
        strSql += vbCrLf + "  		,SUM(CASE WHEN TRANMODE = ''D'' THEN T.AMOUNT ELSE -1*T.AMOUNT END) AS AMOUNT,CASE WHEN PAYMODE IN (''SS'',''CB'',''CZ'',''CG'',''CD'')  "
        strSql += vbCrLf + "  		THEN CHQCARDREF + '':'' + CHQCARDNO ELSE CHQCARDNO END CHQCARDNO,T.SYSTEMID,CASE PAYMODE WHEN ''CC'' THEN ''CREDIT CARD'' WHEN ''CH'' THEN ''CHEQUE''   "
        strSql += vbCrLf + "  		ELSE ''SCHEME'' END AS PAYMODE,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(INT,2) RESULT   "
        strSql += vbCrLf + "  		,(SELECT TOP 1 NAME FROM " & cnAdminDb & "..CREDITCARD WHERE CARDCODE = T.CARDID)AS CARDNAME   "
        strSql += vbCrLf + "  		FROM ACCTRAN T   "
        strSql += vbCrLf + "  		WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND PAYMODE IN (''CC'',''CH'') AND ISNULL(T.CANCEL,'''') <> ''Y''   "
        strSql += vbCrLf + "  		AND ISNULL(T.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(FROMFLAG,'''')<>''C''    "
        strSql += vbCrLf + "  		group by CHQCARDREF,T.TRANDATE,T.TRANNO,TRANMODE,T.AMOUNT,PAYMODE,CHQCARDNO,T.SYSTEMID,T.CARDID  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT (CHQCARDREF+''  ''+CHQCARDNO) AS PARTICULAR,T.TRANDATE,T.TRANNO    "
        strSql += vbCrLf + "  		,SUM(CASE WHEN TRANMODE = ''D'' THEN T.AMOUNT ELSE -1*T.AMOUNT END) AS AMOUNT,CASE WHEN PAYMODE IN (''SS'',''CB'',''CZ'',''CG'',''CD'')     "
        strSql += vbCrLf + "  		THEN CHQCARDREF + '':'' + CHQCARDNO ELSE CHQCARDNO END CHQCARDNO,T.SYSTEMID,CASE PAYMODE WHEN ''CC'' THEN ''CREDIT CARD'' WHEN ''CH'' THEN ''CHEQUE''   "
        strSql += vbCrLf + "  		ELSE ''SCHEME'' END AS PAYMODE,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(INT,2) RESULT   "
        strSql += vbCrLf + "  		,(SELECT TOP 1 NAME FROM " & cnAdminDb & "..CREDITCARD WHERE CARDCODE = T.CARDID)AS CARDNAME   "
        strSql += vbCrLf + "  		FROM ACCTRAN T     "
        strSql += vbCrLf + "  		WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND PAYMODE IN (''CC'',''CH'') AND ISNULL(T.CANCEL,'''') <> ''Y''   "
        strSql += vbCrLf + "  		AND ISNULL(T.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(FROMFLAG,'''')=''C''   "
        strSql += vbCrLf + "  		GROUP BY CHQCARDREF,T.TRANDATE,T.TRANNO,TRANMODE,PAYMODE,CHQCARDNO,T.SYSTEMID,T.CARDID   "
        strSql += vbCrLf + "  		)X   "
        strSql += vbCrLf + "  		GROUP BY PARTICULAR,TRANDATE,TRANNO,CHQCARDNO,SYSTEMID,PAYMODE,CARDNAME,RESULT,COLHEAD   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT(PAYMODE,PARTICULAR,AMOUNT,RESULT,COLHEAD)   "
        strSql += vbCrLf + "  		SELECT DISTINCT PAYMODE,PAYMODE,NULL,0 RESULT,''T'' COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT WHERE RESULT = 2   "
        strSql += vbCrLf + "  		UNION ALL"
        strSql += vbCrLf + "  		SELECT PAYMODE,PAYMODE+'' TOTAL''AS PARTICULAR,SUM(AMOUNT),4 RESULT,''S1''COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT"
        strSql += vbCrLf + "  		GROUP BY PAYMODE"
        strSql += vbCrLf + "  		/*INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT(PAYMODE,RESULT,COLHEAD,CARDNAME,PARTICULAR)  "
        strSql += vbCrLf + "  		SELECT DISTINCT PAYMODE,1 RESULT,''T1'' COLHEAD,CARDNAME,CARDNAME + '' ['' + ISNULL(CONVERT(VARCHAR,SUM(AMOUNT)),'''') +'']''   "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT WHERE RESULT = 2 AND PAYMODE = ''CREDIT CARD''    "
        strSql += vbCrLf + "  		GROUP BY PAYMODE,CARDNAME   */"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL12,COL13,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT PARTICULAR,TRANNO,AMOUNT,'''',COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT ORDER BY PAYMODE,RESULT,CARDNAME,PARTICULAR,TRANDATE,CONVERT(INT,TRANNO)'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		PRINT'/******************** credit sales ******************* */'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CREDITSALES'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,''   '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME"
        strSql += vbCrLf + "  		, CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT,0 AS PCS, GRSWT ,NETWT,0 AS TAX,0  AS RECEIPT, AMOUNT AS PAYMENT"
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES FROM " & cnAdminDb & "..OUTSTANDING AS O  WHERE TRANTYPE  = ''D'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''      "
        strSql += vbCrLf + "  		AND PAYMODE = ''DU'' AND O.RECPAY = ''P'' AND ISNULL(FROMFLAG,'''')<>''O'' AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'') AND ISNULL(CANCEL,'''') <>''Y''    "
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  '"
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= '    "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES)>0"
        strSql += vbCrLf + "  		BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COLHEAD)SELECT ''CREDIT SALE''+'' ''+''['' + convert(varchar(25),SUM(PAYMENT))+'']'',''S''  FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES    "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,0 RATE,AMOUNT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES ORDER BY RESULT,CONVERT(INT,TRANNO)  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL4,COL5,COL6,COL7,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT ''CREDIT SALE TOTAL''CUSNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(MCHARGE),SUM(AMOUNT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),''S1''COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		PRINT'/******************** ADVANCE ADJUSTED ********************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVADJUSTED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED     '"
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		SELECT @QRY= '"
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,''   '' + (SELECT (PNAME+'' ''+INITIAL) CUSNAME FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME "
        strSql += vbCrLf + "  		, CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT,0 AS PCS, GRSWT,NETWT "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=O.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')=''N'' AND TRANTYPE=''AA'')AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=O.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')=''N'' AND TRANTYPE=''AA'')AS CGST  "
