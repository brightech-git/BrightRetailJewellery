        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN             "
        strSql += vbCrLf + " 	/** GETTING WHEATHER BACK OFFICE ENTRY SHOULD AFFECT D REPORT OR NOT **/       "
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPMETAL') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMETAL"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPCOSTCENTRE') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSTCENTRE "
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPDESIGNER') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPDESIGNER "
