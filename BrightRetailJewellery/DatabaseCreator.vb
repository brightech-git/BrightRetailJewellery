        strSql += vbCrLf + "  		AND PAYMODE IN (''AA'',''AP'') AND O.RECPAY = ''P'' AND (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'') AND SUBSTRING(O.RUNNO,6,1) <> ''R''      "
