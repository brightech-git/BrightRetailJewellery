        strSql += vbCrLf + "DECLARE @TEMP VARCHAR(100),@ARRAYSTRING VARCHAR(250)"
        strSql += vbCrLf + "DECLARE @COUNT INT,@MOTCOUNT INT"
        strSql += vbCrLf + "DECLARE @STRLEN INT ,@ARRAYLENGTH INT"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @MOBILENOS=''"
        strSql += vbCrLf + "SELECT @COUNT = COUNT(*) FROM DELETED"
        strSql += vbCrLf + "SELECT @MOTCOUNT = COUNT(*) FROM INSERTED "
        strSql += vbCrLf + "IF @COUNT > 0 SELECT @MOTCOUNT = COUNT(*) FROM INSERTED WHERE CANCEL='Y'"
        strSql += vbCrLf + "IF @MOTCOUNT > 0"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @MESSAGE ='FYI - '"
        strSql += vbCrLf + "IF @COUNT > 0 SET @MESSAGE =@MESSAGE+'Cancelled '"
        strSql += vbCrLf + "IF @COUNT = 0 SET @MESSAGE =@MESSAGE+'Received '"
        strSql += vbCrLf + "DECLARE @CUR CURSOR"
        strSql += vbCrLf + "IF @COUNT > 0 	SET @CUR =  CURSOR FOR SELECT  B.GROUPMOBILES FROM " & compId & "ADMINDB..ALERTTRAN A LEFT JOIN " & compId & "ADMINDB..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'SCHEMETRAN' AND _EDIT ='Y' "
        strSql += vbCrLf + "IF @COUNT = 0 	SET @CUR = CURSOR FOR SELECT  B.GROUPMOBILES FROM " & compId & "ADMINDB..ALERTTRAN A LEFT JOIN " & compId & "ADMINDB..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'SCHEMETRAN' AND _ADD ='Y'"
        strSql += vbCrLf + "OPEN @CUR"
        strSql += vbCrLf + "While 1 = 1"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "FETCH NEXT FROM @CUR INTO @GROUPMOBILENOS"
        strSql += vbCrLf + "IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "SET NOCOUNT ON"
        strSql += vbCrLf + "IF @MOBILENOS <> '' SET @MOBILENOS= @MOBILENOS +','+ @GROUPMOBILENOS"
        strSql += vbCrLf + "IF @MOBILENOS = '' SET @MOBILENOS= @GROUPMOBILENOS"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "Close @CUR"
        strSql += vbCrLf + "DEALLOCATE @CUR"
        strSql += vbCrLf + "IF @MOBILENOS <> ''"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP=' Rs.'+(SELECT TOP 1 CONVERT(VARCHAR(10),ISNULL(AMOUNT,0)) FROM INSERTED)"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "SET @TEMP=' Receipt No.'+(SELECT TOP 1 CONVERT(VARCHAR(10),RECEIPTNO) FROM INSERTED)+' dt.'+(SELECT TOP 1 CONVERT(VARCHAR(11),RDATE,105) FROM INSERTED)"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "SET @TEMP=' by '+(SELECT CASE WHEN MODEPAY='C' THEN 'Cash' WHEN  MODEPAY='Q' THEN 'Chq' END PAYMODE FROM SCHEMECOLLECT WHERE ENTREFNO IN (SELECT TOP 1 ENTREFNO FROM INSERTED ))"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "SET @TEMP=' For '+(SELECT TOP 1 SCHEMENAME FROM " & ChitDbName & "..SCHEME WHERE SCHEMEID IN (SELECT TOP 1 SCHEMEID FROM SCHEMECOLLECT WHERE ENTREFNO IN (SELECT  TOP 1 SCHEMEID FROM INSERTED)))"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "SET @TEMP=''"
        strSql += vbCrLf + "SET @TEMP=' Group:'+(SELECT TOP 1 ISNULL(GROUPCODE,'')+' Regno:'+CONVERT(VARCHAR(10),ISNULL(REGNO,''))+' Ins.'+CONVERT(VARCHAR(5),INSTALLMENT) FROM INSERTED)"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "SET @STRLEN = 0"
        strSql += vbCrLf + "SET @ARRAYSTRING = @MOBILENOS"
        strSql += vbCrLf + "SET @ARRAYLENGTH = LEN(@ARRAYSTRING)"
        strSql += vbCrLf + "WHILE @STRLEN < @ARRAYLENGTH"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "IF CHARINDEX(',', @ARRAYSTRING,1) > 0 SET @MOBILENO= SUBSTRING(@ARRAYSTRING,1,CHARINDEX(',', @ARRAYSTRING,1)-1)"
        strSql += vbCrLf + "IF CHARINDEX(',', @ARRAYSTRING,1) = 0 SET @MOBILENO = SUBSTRING(@ARRAYSTRING,1,@ARRAYLENGTH)"
        strSql += vbCrLf + "SET @STRLEN = @STRLEN+LEN(@MOBILENO)+1"
        strSql += vbCrLf + "SET @ARRAYSTRING = SUBSTRING(@ARRAYSTRING,LEN(@MOBILENO)+2,@ARRAYLENGTH)"
        strSql += vbCrLf + "SET @QRY ='INSERT INTO BRIGHTECHSMSDB..SMSDATA(MOBILENO,MESSAGES,STATUS)'"
        strSql += vbCrLf + "SET @QRY = @QRY+' SELECT '''+@MOBILENO+''','''+@MESSAGE+''','''''"
        strSql += vbCrLf + "EXECUTE sp_executesql @QRY"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "End"
        cmd = New OleDbCommand(strSql, CnCon, CnTran)
        cmd.ExecuteNonQuery()
    End Sub
