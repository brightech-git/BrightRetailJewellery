        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+',CREDITCARD,CHIT,DISCOUNT,NETCASH,BILLUSER,COLHEAD,RESULT,BATCHNO,USERID,RECTOTAL)' "
        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+'SELECT A.TRANNO,A.TRANNO,A.TRANDATE '"
