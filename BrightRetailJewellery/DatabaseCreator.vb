        strSql += vbCrLf + "  		/*SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVDUE'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE  "
        strSql += vbCrLf + "  		SELECT ''OPE'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE  "
        strSql += vbCrLf + "  		,CASE WHEN TRANTYPE IN (''D'',''J'') THEN CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE -1*AMOUNT END ELSE CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE -1*AMOUNT END END AS AMOUNT ,BATCHNO  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE < ''' + @FRMDATE + '''  AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''')  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''',''S'',''O'',''A'') AND TRANTYPE <> ''T''  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT ''REC'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE,CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE 0 END AS AMOUNT,BATCHNO  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND RECPAY = ''R'' AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''')  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''',"
        strSql += vbCrLf + "  		''S'',''O'',''A'') AND TRANTYPE <> ''T''  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT ''PAY'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE,CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE 0 END AS AMOUNT,BATCHNO  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND RECPAY = ''P'' AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''','"
        strSql += vbCrLf + "  		'S'',''O'',''A'') AND TRANTYPE <> ''T''   "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE SET TRANTYPE = ''J'' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE AS O INNER JOIN " & cnAdminDb & "..ITEMDETAIL I ON I.BATCHNO = O.BATCHNO  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COLHEAD)SELECT ''DUE SUMMARY'',''T''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL2,COL4,COL5,COL12)SELECT ''OPENING'',''RECEIPT'',''PAYMENT'',''CLOSING''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL4,COL5,COL12)    "
        strSql += vbCrLf + "  		SELECT CASE TRANTYPE WHEN ''O'' THEN ''ORDER ADVANCE'' WHEN ''D'' THEN ''DUE'' WHEN ''T'' THEN ''OTHERS'' WHEN ''J'' THEN ''TOBE'' WHEN ''GV'' THEN ''GIFT VOUCHER'' ELSE ''ADVANCE'' END AS TRANTYPE  "
        strSql += vbCrLf + "  		,SUM(CASE WHEN SEP = ''OPE'' THEN AMOUNT ELSE 0 END) AS OPENING,SUM(CASE WHEN SEP = ''REC'' THEN AMOUNT ELSE 0 END)AS RECEIPT  "
        strSql += vbCrLf + "  		,SUM(CASE WHEN SEP = ''PAY'' THEN AMOUNT ELSE 0 END)AS PAYMENT,SUM(CASE WHEN SEP = ''REC'' THEN -1*AMOUNT ELSE AMOUNT END)AS CLOSING  "
        strSql += vbCrLf + "  		FROM (SELECT SEP,TRANTYPE,AMOUNT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE WHERE TRANTYPE IN (''D'',''J''))X  "
        strSql += vbCrLf + "  		GROUP BY TRANTYPE'  "
        strSql += vbCrLf + "  		EXEC (@QRY)*/  "
        strSql += vbCrLf + "  	END   "
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_DAILYREPORT_SUMMARY()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAILYREPORTNEW_SUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_DAILYREPORTNEW_SUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "CREATE PROCEDURE SP_DAILYREPORTNEW_SUMMARY"
        strSql += vbCrLf + "  ( "
        strSql += vbCrLf + "  @FRMDATE VARCHAR(15)"
        strSql += vbCrLf + "  ,@TODATE VARCHAR(15)"
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + "  ,@SYSTEMID VARCHAR(10)"
        strSql += vbCrLf + "  ,@VATSEP VARCHAR(1)"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  SET NOCOUNT ON"
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "  DECLARE  @CASHACC AS VARCHAR(7)"
        strSql += vbCrLf + "  SELECT @CASHACC = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE  CTLID='CASH'"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY','U')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY     "
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(9))"
        strSql += vbCrLf + "  DECLARE @TCOMPANY VARCHAR(9)"
        strSql += vbCrLf + "  IF @COMPANYID ='ALL'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID)SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY       "
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  ELSE"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  IF @COMPANYID <>'ALL'SET @COMPANYID =REPLACE(@COMPANYID,',',''',''')"
        strSql += vbCrLf + "  SELECT @QRY='INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'DAYREPORT1'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1   "
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1    "
        strSql += vbCrLf + "  (    "
        strSql += vbCrLf + "  COL1 VARCHAR(150)    "
        strSql += vbCrLf + "  ,COL2 VARCHAR(100)   "
        strSql += vbCrLf + "  ,COL3 VARCHAR(100)   "
        strSql += vbCrLf + "  ,COL4 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL5 VARCHAR(25)  "
        strSql += vbCrLf + "  ,COL6 VARCHAR(25)  "
        strSql += vbCrLf + "  ,COL7 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL8 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL9 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL10 VARCHAR(25)"
        strSql += vbCrLf + "  ,COL11 DECIMAL(15,2) "
        strSql += vbCrLf + "  ,COL12 DECIMAL(15,2) "
        strSql += vbCrLf + "  ,COL13 VARCHAR(25) "
        strSql += vbCrLf + "  ,COL14 VARCHAR(25) "
        strSql += vbCrLf + "  ,COLHEAD VARCHAR(2) "
        strSql += vbCrLf + "  ,KEYNO INT IDENTITY(0,1)    "
        strSql += vbCrLf + "  )'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'DAYREPORT2'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2"
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2"
        strSql += vbCrLf + "  (    "
        strSql += vbCrLf + "  COL1 VARCHAR(150)    "
        strSql += vbCrLf + "  ,COL2 VARCHAR(100)    "
        strSql += vbCrLf + "  ,COL3 VARCHAR(100)    "
        strSql += vbCrLf + "  ,COL4 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL5 VARCHAR(25)  "
        strSql += vbCrLf + "  ,COL6 VARCHAR(25)  "
        strSql += vbCrLf + "  ,COL7 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL8 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL9 VARCHAR(25)    "
        strSql += vbCrLf + "  ,COL10 VARCHAR(25)"
        strSql += vbCrLf + "  ,COL11 VARCHAR(25) "
        strSql += vbCrLf + "  ,COL12 VARCHAR(25) "
        strSql += vbCrLf + "  ,COL13 VARCHAR(25) "
        strSql += vbCrLf + "  ,COL14 VARCHAR(25) "
        strSql += vbCrLf + "  ,COLHEAD VARCHAR(2) "
        strSql += vbCrLf + "  ,KEYNO INT IDENTITY(0,1)    "
        strSql += vbCrLf + "  )'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SALES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/"
        strSql += vbCrLf + "  SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'SALES'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO   "
        strSql += vbCrLf + "  ,''   '' + (SELECT (PNAME+'' ''+INITIAL) FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO     "
        strSql += vbCrLf + "  WHERE BATCHNO = I.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "  ,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = I.ITEMID) AS ITEMNAME    "
        strSql += vbCrLf + "  ,MCHARGE, RATE, AMOUNT,PCS , GRSWT,NETWT,TAX, AMOUNT + TAX AS  RECEIPT, 0 AS PAYMENT  "
        strSql += vbCrLf + "  ,CASE WHEN TYPE = ''CGST''OR TYPE = ''SGST'' OR TYPE = ''IGST'' THEN TYPE ELSE"
        strSql += vbCrLf + "  (SELECT CATNAME FROM " & cnAdminDb & "..CATEGORY AS M WHERE M.CATCODE = I.CATCODE) + CASE WHEN TYPE=''CG'' THEN '' CGST''WHEN TYPE=''SG'' THEN '' SGST''WHEN TYPE=''IG'' THEN '' IGST'' ELSE '''' END "
        strSql += vbCrLf + "  END AS METALNAME   "
        strSql += vbCrLf + "  ,TAGNO,I.BATCHNO"
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT,CASE WHEN TYPE=''CG'' THEN 1 WHEN TYPE=''SG'' THEN 2 WHEN TYPE=''IG'' THEN 3 "
        strSql += vbCrLf + "  WHEN TYPE=''CGST'' THEN 5 WHEN TYPE=''SGST'' THEN 6 WHEN TYPE=''IGST'' THEN 7 ELSE 0 END RESULT1"
        strSql += vbCrLf + "  INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES   "
        strSql += vbCrLf + "  FROM  "
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "  	SELECT TRANNO,BATCHNO,ITEMID,MCHARGE,RATE,AMOUNT-ISNULL((SELECT CASE WHEN ISNULL(I.TRANTYPE,'''')=''OD'' THEN 0 ELSE SUM(STNAMT) END FROM ISSSTONE WHERE ISSSNO = I.SNO),0) AS AMOUNT"
        strSql += vbCrLf + "  	,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE PCS END)AS PCS,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' AND ISNULL(GRSWT,0)<0 THEN 0 ELSE GRSWT END)AS GRSWT,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' AND ISNULL(NETWT,0)<0 THEN 0 ELSE NETWT END)AS NETWT"
        strSql += vbCrLf + "  	,0 AS TAX"
        strSql += vbCrLf + "  	,CATCODE  "
        strSql += vbCrLf + "  	,TAGNO,'''' AS TYPE"
        strSql += vbCrLf + "  	FROM ISSUE AS I      "
        strSql += vbCrLf + "  	WHERE TRANTYPE  IN (''SA'',''RD'',''OD'') AND TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(GRSWT,0)>0      "
        strSql += vbCrLf + "  	AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0"
        strSql += vbCrLf + "  	UNION ALL"
        strSql += vbCrLf + "  	/*SELECT T.TRANNO,T.BATCHNO,0 ITEMID,0 MCHARGE,0 RATE"
        strSql += vbCrLf + "  	,TAXAMOUNT AS AMOUNT"
        strSql += vbCrLf + "  	,0 AS PCS,0 AS GRSWT,0 AS NETWT"
        strSql += vbCrLf + "  	,0 TAX"
        strSql += vbCrLf + "  	,I.CATCODE  "
        strSql += vbCrLf + "  	,I.TAGNO"
        strSql += vbCrLf + "  	,T.TAXID TYPE"
        strSql += vbCrLf + "  	FROM ISSUE AS I  INNER JOIN TAXTRAN AS T  ON T.BATCHNO = I.BATCHNO     AND I.SNO = T.ISSSNO "
        strSql += vbCrLf + "  	WHERE I.TRANTYPE  IN (''SA'',''RD'',''OD'') AND I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(GRSWT,0)>0      "
        strSql += vbCrLf + "  	AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND I.ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0"
        strSql += vbCrLf + "  	AND T.STUDDED = ''N''"
        strSql += vbCrLf + "  	UNION ALL"
        strSql += vbCrLf + "  	SELECT T.TRANNO,T.BATCHNO,0 ITEMID,0 MCHARGE,0 RATE"
        strSql += vbCrLf + "  	,-TAXAMOUNT AS AMOUNT"
        strSql += vbCrLf + "  	,0 AS PCS,0 AS GRSWT,0 AS NETWT"
        strSql += vbCrLf + "  	,0 TAX"
        strSql += vbCrLf + "  	,I.CATCODE  "
        strSql += vbCrLf + "  	,I.TAGNO"
        strSql += vbCrLf + "  	,T.TAXID TYPE"
        strSql += vbCrLf + "  	FROM ISSUE AS I  INNER JOIN ISSSTONE AS ISS ON ISS.BATCHNO = I.BATCHNO  AND I.SNO = ISS.ISSSNO "
        strSql += vbCrLf + "  	INNER JOIN TAXTRAN AS T ON T.BATCHNO = ISS.BATCHNO  AND ISS.SNO = T.ISSSNO "
        strSql += vbCrLf + "  	WHERE I.TRANTYPE  IN (''SA'',''RD'',''OD'') AND I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(GRSWT,0)>0      "
        strSql += vbCrLf + "  	AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND I.ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0"
        strSql += vbCrLf + "  	UNION ALL8*/"
        strSql += vbCrLf + "  	SELECT ''''TRANNO,''''BATCHNO,0 ITEMID,0 MCHARGE,0 RATE"
        strSql += vbCrLf + "  	,SUM(TAXAMOUNT) AS AMOUNT"
        strSql += vbCrLf + "  	,0 AS PCS,0 AS GRSWT,0 AS NETWT"
        strSql += vbCrLf + "  	,0 TAX"
        strSql += vbCrLf + "  	,I.CATCODE  "
        strSql += vbCrLf + "  	,''''TAGNO"
        strSql += vbCrLf + "  	,T.TAXID+''ST'' TYPE"
        strSql += vbCrLf + "  	FROM ISSUE AS I  INNER JOIN TAXTRAN AS T  ON T.BATCHNO = I.BATCHNO     AND I.SNO = T.ISSSNO "
        strSql += vbCrLf + "  	WHERE I.TRANTYPE  IN (''SA'',''RD'',''OD'') AND I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(GRSWT,0)>0      "
        strSql += vbCrLf + "  	AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND I.ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0"
        strSql += vbCrLf + "  	AND T.STUDDED = ''N'' GROUP BY I.CATCODE,TAXID"
        strSql += vbCrLf + "  	/*UNION ALL"
        strSql += vbCrLf + "  	SELECT ''''TRANNO,''''BATCHNO,0 ITEMID,0 MCHARGE,0 RATE"
        strSql += vbCrLf + "  	,SUM(-TAXAMOUNT) AS AMOUNT"
        strSql += vbCrLf + "  	,0 AS PCS,0 AS GRSWT,0 AS NETWT"
        strSql += vbCrLf + "  	,0 TAX"
        strSql += vbCrLf + "  	,I.CATCODE  "
        strSql += vbCrLf + "  	,''''TAGNO"
        strSql += vbCrLf + "  	,T.TAXID+''ST'' TYPE"
        strSql += vbCrLf + "  	FROM ISSUE AS I  INNER JOIN ISSSTONE AS ISS ON ISS.BATCHNO = I.BATCHNO  AND I.SNO = ISS.ISSSNO "
        strSql += vbCrLf + "  	INNER JOIN TAXTRAN AS T ON T.BATCHNO = ISS.BATCHNO  AND ISS.SNO = T.ISSSNO "
        strSql += vbCrLf + "  	WHERE I.TRANTYPE  IN (''SA'',''RD'',''OD'') AND I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(GRSWT,0)>0      "
        strSql += vbCrLf + "  	AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND I.ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0"
        strSql += vbCrLf + "  	GROUP BY I.CATCODE,TAXID*/"
        strSql += vbCrLf + "  	UNION ALL"
        strSql += vbCrLf + "  	SELECT TRANNO,BATCHNO,STNITEMID AS ITEMID,0 MCHARGE,STNRATE RATE,STNAMT AS AMOUNT"
        strSql += vbCrLf + "  	,0 PCS,STNWT GRSWT,STNWT NETWT"
        strSql += vbCrLf + "  	/*,CASE WHEN STNAMT <> 0 THEN TAX ELSE 0 END TAX*/"
        strSql += vbCrLf + "  	,0 TAX"
        strSql += vbCrLf + "  	,CATCODE,NULL TAGNO,'''' AS TYPE"
        strSql += vbCrLf + "  	FROM ISSSTONE WHERE ISSSNO IN (SELECT SNO FROM ISSUE AS I"
        strSql += vbCrLf + "  	WHERE TRANTYPE  IN (''SA'',''OD'',''RD'') AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') <> ''Y''"
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY))"
        strSql += vbCrLf + "  )AS I  ORDER BY RESULT,RESULT1,TRANNO'+ CHAR(13)+ CHAR(13)"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  SELECT @QRY = 'IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES)>0    "
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES"
        strSql += vbCrLf + "  	(CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT,RESULT1)"
        strSql += vbCrLf + "  	SELECT METALNAME + '' SUBTOTAL'' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT)"
        strSql += vbCrLf + "  	,''S'' COLHEAD,2 RESULT,RESULT1"
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES WHERE RESULT = 1 AND RESULT1 NOT IN(1,2,3) GROUP BY METALNAME,RESULT1"
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES   "
        strSql += vbCrLf + "  	(ITEMNAME,METALNAME,COLHEAD,RESULT,GRSWT,NETWT,AMOUNT,TAX,RECEIPT,PAYMENT,RESULT1)   "
        strSql += vbCrLf + "  	SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT,SUM(TAX)TAX"
        strSql += vbCrLf + "  	,SUM(RECEIPT) RECEIPT,SUM(PAYMENT) PAYMENT,RESULT1 FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES WHERE RESULT = 1 AND RESULT1 NOT IN(1,2,3)GROUP BY METALNAME,RESULT1"
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)    "
        strSql += vbCrLf + "  	SELECT METALNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES "
        strSql += vbCrLf + "  	WHERE COLHEAD=''S'' AND RESULT=0 ORDER BY RESULT,RESULT1,METALNAME,TRANNO "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)    "
        strSql += vbCrLf + "  	SELECT ''GST''METALNAME,0 TRANNO,''GST''ITEMNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(MCHARGE),SUM(RATE),SUM(AMOUNT),SUM(TAX),SUM(RECEIPT)"
        strSql += vbCrLf + "  	,0 PAYMENT,''Z'' COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  WHERE RESULT=2 AND RESULT1 IN(5,6,7,8)"
        strSql += vbCrLf + "  	END'+ CHAR(13)+ CHAR(13)"
        strSql += vbCrLf + "  	PRINT 1111111111"
