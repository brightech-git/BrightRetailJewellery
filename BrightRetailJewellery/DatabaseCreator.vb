        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT SCHEME AS PARTICULAR ,CONVERT(NVARCHAR(12),TRANDATE  ,103) AS TRANDATE ,''CHIT'' AS METALNAME, 0 PCS, 0 AS GRSWT ,0 AS NETWT,0 AS AMOUNT,0 AS TAX, 0 AS SC,'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' 0 AS TOTAL,0 AS STNWT,0 AS DIAWT,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,VALUEINWTRAMT, 1 AS  RESULT,''D'' AS COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' FROM  TEMPTABLEDB..TEMPCHTCOLL1 GROUP BY TRANDATE,SCHEME,VALUEINWTRAMT ORDER BY TRANDATE,SCHEME'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT SCHEME AS PARTICULAR ,CONVERT(NVARCHAR(12),TRANDATE  ,103) AS TRANDATE ,''CHIT'' AS METALNAME, 0 PCS, 0 AS GRSWT ,0 AS NETWT,0 AS AMOUNT,0 AS TAX, 0 AS SC,'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' 0 AS TOTAL,0 AS STNWT,0 AS DIAWT,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,VALUEINWTRAMT, 1 AS  RESULT,''D'' AS COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' FROM  TEMPTABLEDB..TEMPCHTCOLL2 GROUP BY TRANDATE,SCHEME,VALUEINWTRAMT ORDER BY TRANDATE,SCHEME'  "
        strSql += vbCrLf + "    /* PRINT @QRY*/  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    /* CHIT COLLECTION*/  "
        strSql += vbCrLf + "    SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,METALNAME,POINTS,BPOINTVALUES,AMOUNT,RESULT,COLHEAD)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT ''OPENING'',''OPENING'',ISNULL(PREVILEGEPOINTS,0),ISNULL(PREVILEGEVALUE,0),AMOUNT,1 RESULT,''D'' AS COLHEAD FROM OPENPREVILEGE WHERE PREVILEGEID='''+@PREVILEGEID+''''  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,METALNAME,RESULT,COLHEAD)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT DISTINCT METALNAME,METALNAME,0 RESULT,''T''COLHEAD FROM TEMPTABLEDB..TEMPPRIVREP1 AS T '  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,POINTS,BPOINTVALUES,RESULT,METALNAME,COLHEAD)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT METALNAME + '' SUB TOTAL''AS PARTICULAR'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SUM(ISNULL(PCS,0))PCS,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(AMOUNT,0))AMOUNT'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SUM(ISNULL(TAX,0))TAX,SUM(ISNULL(SC,0))SC,SUM(ISNULL(TOTAL,0))TOTAL,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(DIAWT,0))DIAWT'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SUM(ISNULL(POINTS,0)) POINTS, SUM(ISNULL(BPOINTVALUES,0)) BPOINTVALUES,2 RESULT,METALNAME,''S''COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' FROM TEMPTABLEDB..TEMPPRIVREP1 AS T WHERE RESULT =1 GROUP BY METALNAME'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,POINTS,BPOINTVALUES,RESULT,METALNAME,COLHEAD)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT ''GRAND TOTAL''AS PARTICULAR,SUM(ISNULL(PCS,0))PCS,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(AMOUNT,0))AMOUNT '  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SUM(ISNULL(TAX,0))TAX,SUM(ISNULL(SC,0))SC,SUM(ISNULL(TOTAL,0))TOTAL,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(DIAWT,0))DIAWT'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SUM(ISNULL(POINTS,0)) POINTS, SUM(ISNULL(BPOINTVALUES,0)) BPOINTVALUES,3 RESULT,''ZZZZZ''METALNAME,''G''COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' FROM TEMPTABLEDB..TEMPPRIVREP1 WHERE RESULT =1'  "
        strSql += vbCrLf + "    /* PRINT @QRY*/  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    SELECT @QRY =  ' UPDATE TEMPTABLEDB..TEMPPRIVREP1 SET VALUEINWTRAMT=''A'' WHERE RESULT=1 and VALUEINWTRAMT is null'"
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMPPRIVREP1 SET METALNAME =''ZREDEEM'' WHERE METALNAME=''REDEEM'''  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' UPDATE TEMPTABLEDB..TEMPPRIVREP1 SET METALNAME =''AOP'' WHERE METALNAME=''OPENING'''  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    SELECT @QRY = 'SELECT *,IDENTITY(INT,1,1) AS SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN' + ' FROM TEMPTABLEDB..TEMPPRIVREP1 ORDER BY METALNAME,RESULT,TRANDATE,PARTICULAR'  "
        strSql += vbCrLf + "    /* PRINT @QRY*/  "
        strSql += vbCrLf + "    EXEC(@QRY)"
        strSql += vbCrLf + "   SELECT @QRY = ' ALTER TABLE  TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN ALTER COLUMN TOTAL NUMERIC(20,2)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + CHAR(13) + ' ALTER TABLE  TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN ALTER COLUMN BPOINTVALUES NUMERIC(20,2)'"
        strSql += vbCrLf + "   EXEC(@QRY)"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub
    Private Sub SP_EXPENSEANALYSIS()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_EXPENSEANALYSIS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_EXPENSEANALYSIS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_EXPENSEANALYSIS"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + "  @FROMDATE SMALLDATETIME  "
        strSql += vbCrLf + "  ,@TODATE SMALLDATETIME  "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(50)  "
        strSql += vbCrLf + "  ,@COSTNAME VARCHAR(500)  "
        strSql += vbCrLf + "  ,@GROUPNAME VARCHAR(500)  "
        strSql += vbCrLf + " )as "
        strSql += vbCrLf + " set nocount on"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'Company',@CHK_FEILD = 'companyname',@RESULT_TBL = '_COMPANY',@INPUTVALUES = @COMPANYID"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = '_COSTCENTRE',@INPUTVALUES = @COSTNAME"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ACGROUP',@CHK_FEILD = 'ACGRPNAME',@RESULT_TBL = '_Achead',@INPUTVALUES = @GROUPNAME"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('#TmpRes1', 'U') IS NOT NULL DROP TABLE #TmpRes1  "
        strSql += vbCrLf + " IF OBJECT_ID('#TmpRes2', 'U') IS NOT NULL DROP TABLE #TmpRes2  "
        strSql += vbCrLf + " IF OBJECT_ID('#TmpRes3', 'U') IS NOT NULL DROP TABLE #TmpRes3  "
        strSql += vbCrLf + " IF OBJECT_ID('#TmpRes4', 'U') IS NOT NULL DROP TABLE #TmpRes4  "
        strSql += vbCrLf + " IF OBJECT_ID('_eaRes', 'U') IS NOT NULL DROP TABLE _eaRes  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " select accode,(select top 1 Acname  from " & compId & "ADMINDB..achead where accode=ac.accode )  as AcName,"
        strSql += vbCrLf + " (select  sum(sc1.amount)  from " & tranDbName & "..acctran sc1 where sc1.accode=ac.accode and trandate < @FROMDATE )  as Opeaning, "
        strSql += vbCrLf + " SUM(CASE WHEN AC.TRANMODE ='C' THEN AC.AMOUNT ELSE AC.AMOUNT*(-1) END)  as Balance, "
        strSql += vbCrLf + " left(datename(month,ac.trandate),3) + '_' + convert(nvarchar,year(ac.trandate)) as Mname,    "
        strSql += vbCrLf + " cast(year(ac.trandate) as nvarchar) + cast(month(ac.trandate) as Nvarchar) as Ordid     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " into #TmpRes1 from " & tranDbName & "..acctran Ac"
        strSql += vbCrLf + " where "
        strSql += vbCrLf + " ac.trandate BETWEEN @FROMDATE AND @TODATE  "
        strSql += vbCrLf + " and isnull(cancel,'') <>'Y'"
        strSql += vbCrLf + " AND ac.COMPANYID in (select companyid from " & compId & "ADMINDB..Company where companyname IN (SELECT COMPANYID FROM _COMPANY) ) "
        strSql += vbCrLf + " AND ISNULL(ac.COSTID,'')  in (select costid from " & compId & "ADMINDB..COSTCENTRE where COSTNAME IN (SELECT companyid FROM _COSTCENTRE) ) "
        strSql += vbCrLf + " AND ISNULL(ac.Accode,'')  in (select Accode from " & compId & "ADMINDB..achead where acgrpcode in (SELECT acgrpcode FROM " & compId & "ADMINDB..ACGROUP  where acgrpname IN (SELECT companyid FROM _Achead)  ))"
        strSql += vbCrLf + " group by accode,ac.trandate,ac.COSTID,ac.COMPANYID  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " select accode,sum(isnull(opeaning,0)) as Opeaning,sum(balance) as Amount,mname, 0 as Totval     "
        strSql += vbCrLf + " into #TmpRes2 from #TmpRes1 group by accode,mname    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " select accode,acname,sum(isnull(opeaning,0)) as Opeaning into  #TmpRes3 from #TmpRes1    "
        strSql += vbCrLf + " group by accode,acname    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " declare @mname as nvarchar(15)     "
        strSql += vbCrLf + " declare @Balance as decimal (15,2)    "
        strSql += vbCrLf + " declare @sqlstr as nvarchar(500)     "
        strSql += vbCrLf + " declare @sqlstr1 as nvarchar(500)     "
        strSql += vbCrLf + " declare @Nbal as decimal(15,3)    "
        strSql += vbCrLf + " select @Nbal = sum(Balance)  from #TmpRes1 "
        strSql += vbCrLf + " declare Rescur cursor for select mname,sum(Balance) as Balance from #TmpRes1   group by mname,Ordid order by cast(isnull(Ordid,0)  as Numeric )  "
        strSql += vbCrLf + " open Rescur    "
        strSql += vbCrLf + " fetch next from Rescur into @mname,@Balance    "
        strSql += vbCrLf + " while @@fetch_status=0    "
        strSql += vbCrLf + " begin    "
        strSql += vbCrLf + " select @sqlstr='alter table #TmpRes3 add [' + @mname + '-Value] decimal(15,2),[' + @mname + '-%] decimal(15,2)'    "
        strSql += vbCrLf + " exec (@sqlstr)    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " select @sqlstr1='update #TmpRes3 set #TmpRes3.[' + @mname + '-Value]=#TmpRes2.[amount] , #TmpRes3.[' + @mname + '-%] = ((#TmpRes2.[amount]/ '+ convert(nvarchar,@Nbal )+' ) * 100) from #TmpRes3 ,#TmpRes2  where  #TmpRes3.accode= #TmpRes2.accode and  #TmpRes2.mname='''+ @mname +''''    "
        strSql += vbCrLf + " exec(@sqlstr1)    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  fetch next from Rescur into @mname,@Balance     "
        strSql += vbCrLf + " end    "
        strSql += vbCrLf + " close Rescur    "
        strSql += vbCrLf + " deallocate Rescur    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " -- Average    "
        strSql += vbCrLf + " select @sqlstr1=' alter table #TmpRes3 add [AVG-Value] decimal(15,2),[AVG-%] decimal(15,2),[Total-Value] decimal(15,2),[Total-%] decimal(15,2)'    "
        strSql += vbCrLf + " exec(@sqlstr1)    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " select  accode,sum((opeaning+amount)) /count(accode) as AvgAmt,sum((opeaning+amount)) as TotAmt into #TmpRes4 from #TmpRes2 group by accode    "
        strSql += vbCrLf + " declare @Nbal1 as decimal(15,3)    "
        strSql += vbCrLf + " select @Nbal1 = sum(Totamt)  from #TmpRes4 "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " update #TmpRes3 set  #TmpRes3.[AVG-Value]= #TmpRes4.avgamt,#TmpRes3.[Total-Value]= #TmpRes4.Totamt     "
        strSql += vbCrLf + " from #TmpRes3,#TmpRes4 where #TmpRes3.accode= #TmpRes4.accode     "
        strSql += vbCrLf + "   print @Nbal1  "
        strSql += vbCrLf + " update #TmpRes3 set  [AVG-%]= ([AVG-Value]/@Nbal1) * 100    "
        strSql += vbCrLf + " update #TmpRes3 set  [total-%]= ([total-Value]/@Nbal1) * 100    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('_COMPANY', 'U') IS NOT NULL DROP TABLE _COMPANY"
        strSql += vbCrLf + " IF OBJECT_ID('_COSTCENTRE', 'U') IS NOT NULL DROP TABLE _COSTCENTRE"
        strSql += vbCrLf + " IF OBJECT_ID('_Achead', 'U') IS NOT NULL DROP TABLE _Achead"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " select * into _eaRes from #TmpRes3  "
        strSql += vbCrLf + " select *  from _eaRes "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_EXPENSEANALYSISMULTICO()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='AGRN_SP_EXPENSEANALYSIS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE AGRN_SP_EXPENSEANALYSIS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE AGRN_SP_EXPENSEANALYSIS"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   @FROMDATE SMALLDATETIME"
        strSql += vbCrLf + "   ,@TODATE SMALLDATETIME"
        strSql += vbCrLf + "   ,@COMPANYID VARCHAR(50)"
        strSql += vbCrLf + "   ,@COSTIDS VARCHAR(500)"
        strSql += vbCrLf + "   ,@ACGRP VARCHAR(500)"
        strSql += vbCrLf + "   )as"
        strSql += vbCrLf + "   set nocount on"
        strSql += vbCrLf + "   DECLARE @QRY AS VARCHAR(1000)"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..COMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..COMPANY  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..COSTCENTRE  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..Achead', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..Achead   "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TmpRes1', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TmpRes1   "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TmpRes2', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TmpRes2   "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TmpRes3', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TmpRes3   "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TmpRes4', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TmpRes4   "
        strSql += vbCrLf + "   IF OBJECT_ID('_eaRes', 'U') IS NOT NULL DROP TABLE _eaRes    "
        strSql += vbCrLf + "   EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'Company',@CHK_FEILD = 'companyname',@RESULT_TBL = 'TEMPTABLEDB..COMPANY',@INPUTVALUES = @COMPANYID "
        strSql += vbCrLf + "   /* GET COSTID*/    "
        strSql += vbCrLf + "   SELECT @QRY='SELECT COSTID INTO TEMPTABLEDB..COSTCENTRE FROM COSTCENTRE where 1=1'    "
        strSql += vbCrLf + "   IF @COSTIDS<>'ALL' SELECT @QRY =@QRY+'AND COSTID IN('+ @COSTIDS +')'    "
        strSql += vbCrLf + "   EXEC(@QRY)    "
        strSql += vbCrLf + "   /*GET AGGROUPID*/    "
        strSql += vbCrLf + "   SELECT @QRY='SELECT ACCODE INTO TEMPTABLEDB..ACHEAD FROM ACHEAD where 1=1'    "
        strSql += vbCrLf + "   IF @ACGRP<>'ALL' SELECT @QRY = @QRY + 'AND ACGRPCODE IN('+ @ACGRP +')'    "
        strSql += vbCrLf + "   PRINT @QRY    "
        strSql += vbCrLf + "   EXEC(@QRY)    "
        strSql += vbCrLf + "   select accode,(select top 1 Acname  from " & compId & "ADMINDB..achead where accode=ac.accode )  as AcName, "
        strSql += vbCrLf + "   (select  sum(sc1.amount)  from " & tranDbName & "..acctran sc1 where sc1.accode=ac.accode and trandate < @FROMDATE )  as Opeaning,  "
        strSql += vbCrLf + "   SUM(CASE WHEN AC.TRANMODE ='C' THEN AC.AMOUNT ELSE AC.AMOUNT*(-1) END)  as Balance,  "
        strSql += vbCrLf + "   left(datename(month,ac.trandate),3) + '_' + convert(nvarchar,year(ac.trandate)) as Mname,      "
        strSql += vbCrLf + "   cast(year(ac.trandate) as nvarchar) + cast(month(ac.trandate) as Nvarchar) as Ordid,ac.costid"
        strSql += vbCrLf + "   into TEMPTABLEDB..TmpRes1 from " & tranDbName & "..acctran Ac "
        strSql += vbCrLf + "   where  "
        strSql += vbCrLf + "   ac.trandate BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "   and isnull(cancel,'') <>'Y' "
        strSql += vbCrLf + "   AND ac.COMPANYID in (select companyid from " & compId & "ADMINDB..Company where companyname IN (SELECT COMPANYID FROM TEMPTABLEDB..COMPANY) )  "
        strSql += vbCrLf + "   AND ISNULL(ac.COSTID,'')  IN (SELECT COSTID FROM TEMPTABLEDB..COSTCENTRE)     "
        strSql += vbCrLf + "   AND ISNULL(ac.Accode,'')  in (select Accode from TEMPTABLEDB..ACHEAD) "
        strSql += vbCrLf + "   group by accode,ac.trandate,ac.COSTID"
        strSql += vbCrLf + "   ,ac.COMPANYID"
        strSql += vbCrLf + "   select accode,sum(isnull(opeaning,0)) as Opeaning,sum(balance) as Amount,mname, 0 as Totval,costid"
        strSql += vbCrLf + "   into TEMPTABLEDB..TmpRes2 from TEMPTABLEDB..TmpRes1 group by accode,mname,costid"
        strSql += vbCrLf + "   SELECT ACNAME PARTICULAR,ACCODE,ACNAME,SUM(ISNULL(OPEANING,0)) AS OPEANING,'D'COLHEAD,2 RESULT INTO  TEMPTABLEDB..TMPRES3 FROM TEMPTABLEDB..TMPRES1 GROUP BY ACCODE,ACNAME"
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TMPRES3(PARTICULAR,ACNAME,OPEANING,COLHEAD,RESULT)    "
        strSql += vbCrLf + "   SELECT 'TOTAL' PARTICULAR,'ZZZZZ'ACNAME,SUM(ISNULL(OPEANING,0)) AS OPEANING,'G'COLHEAD,4 RESULT FROM TEMPTABLEDB..TMPRES1     "
        strSql += vbCrLf + "   declare @mname as nvarchar(15)"
        strSql += vbCrLf + "   declare @costid as nvarchar(15)"
        strSql += vbCrLf + "   declare @Balance as decimal (15,2)      "
        strSql += vbCrLf + "   declare @sqlstr as nvarchar(500)"
        strSql += vbCrLf + "   declare @sqlstr1 as nvarchar(500)"
        strSql += vbCrLf + "   declare @Nbal as decimal(25,3)      "
        strSql += vbCrLf + "   declare cur cursor for select distinct costid from TEMPTABLEDB..TmpRes1  order by costid "
        strSql += vbCrLf + "   open cur "
        strSql += vbCrLf + "   fetch next from cur into @costid"
        strSql += vbCrLf + "    while @@fetch_status=0      "
        strSql += vbCrLf + "   begin      "
        strSql += vbCrLf + "   select @Nbal = sum(Balance)  from TEMPTABLEDB..TmpRes1 where COSTID=@costid"
        strSql += vbCrLf + "   declare Rescur cursor for select mname,sum(Balance) as Balance from TEMPTABLEDB..TmpRes1  where COSTID=@costid group by mname,Ordid order by cast(isnull(Ordid,0)  as Numeric )    "
        strSql += vbCrLf + "   open Rescur      "
        strSql += vbCrLf + "   fetch next from Rescur into @mname,@Balance      "
        strSql += vbCrLf + "   while @@fetch_status=0      "
        strSql += vbCrLf + "   begin      "
        strSql += vbCrLf + "   select @sqlstr='ALTER table TEMPTABLEDB..TmpRes3 add [' + @costid +'-'+ @mname + '-Value] decimal(15,2),[' + @costid +'-'+ @mname + '-%] decimal(15,2)'      "
        strSql += vbCrLf + "   exec (@sqlstr)      "
        strSql += vbCrLf + "   select @sqlstr1='UPDATE TT3 set TT3.[' + @costid +'-'+ @mname + '-Value]'"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+'=TT2.[amount] , TT3.[' + @costid +'-'+ @mname + '-%] '"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+'= ((TT2.[amount]/ '+ convert(nvarchar,@Nbal )+' ) * 100) from '"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+'TEMPTABLEDB..TmpRes3 TT3 ,TEMPTABLEDB..TmpRes2 TT2 where  TT3.accode=TT2.accode'"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+' and TT2.mname='''+ @mname +''' and TT2.costid='''+ @costid +''''      "
        strSql += vbCrLf + "   print @sqlstr1"
        strSql += vbCrLf + "   exec(@sqlstr1)      "
        strSql += vbCrLf + "   select @sqlstr1='UPDATE TT3 set TT3.[' + @costid +'-'+ @mname + '-Value]=(SELECT SUM(ISNULL([' + @costid +'-'+ @mname + '-Value],0)) FROM TEMPTABLEDB..TmpRes3 WHERE RESULT=2) '"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+', TT3.[' + @costid +'-'+ @mname + '-%] = (SELECT SUM(ISNULL([' + @costid +'-'+ @mname + '-%],0)) FROM TEMPTABLEDB..TmpRes3 WHERE RESULT=2) from '"
        strSql += vbCrLf + "   select @sqlstr1 = @sqlstr1+'TEMPTABLEDB..TmpRes3 TT3   where  RESULT=4'"
        strSql += vbCrLf + "   print @sqlstr1"
        strSql += vbCrLf + "   exec(@sqlstr1)      "
        strSql += vbCrLf + "   fetch next from Rescur into @mname,@Balance"
        strSql += vbCrLf + "   end      "
        strSql += vbCrLf + "   close Rescur      "
        strSql += vbCrLf + "   deallocate Rescur      "
        strSql += vbCrLf + "   fetch next from cur into @costid"
        strSql += vbCrLf + "   end      "
        strSql += vbCrLf + "   close cur      "
        strSql += vbCrLf + "   deallocate cur      "
        strSql += vbCrLf + "   select @sqlstr1=' alter table TEMPTABLEDB..TmpRes3 add [AVG-Value] decimal(15,2),[AVG-%] decimal(15,2),[Total-Value] decimal(15,2),[Total-%] decimal(15,2)'      "
        strSql += vbCrLf + "   exec(@sqlstr1)      "
        strSql += vbCrLf + "   select  accode,sum((opeaning+amount)) /count(distinct accode) as AvgAmt,sum((opeaning+amount)) as TotAmt "
        strSql += vbCrLf + "   into TEMPTABLEDB..TmpRes4 from TEMPTABLEDB..TmpRes2 group by accode"
        strSql += vbCrLf + "   declare @Nbal1 as decimal(15,3)      "
        strSql += vbCrLf + "   select @Nbal1 = sum(Totamt)  from TEMPTABLEDB..TmpRes4  "
        strSql += vbCrLf + "   UPDATE TT3 SET  TT3.[AVG-VALUE]= TT4.AVGAMT,TT3.[TOTAL-VALUE]= TT4.TOTAMT"
        strSql += vbCrLf + "   FROM TEMPTABLEDB..TMPRES3 TT3,TEMPTABLEDB..TMPRES4 TT4 WHERE TT3.ACCODE= TT4.ACCODE "
        strSql += vbCrLf + "   UPDATE TEMPTABLEDB..TMPRES3 SET  [AVG-%]= ([AVG-VALUE]/@NBAL1) * 100      "
        strSql += vbCrLf + "   UPDATE TEMPTABLEDB..TMPRES3 SET  [TOTAL-%]= ([TOTAL-VALUE]/@NBAL1) * 100   "
        strSql += vbCrLf + "   UPDATE TT3 SET  TT3.[AVG-VALUE]= (SELECT SUM(ISNULL([AVG-VALUE],0))FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=2) FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=4    "
        strSql += vbCrLf + "   UPDATE TT3 SET  TT3.[TOTAL-VALUE]= (SELECT SUM(ISNULL([TOTAL-VALUE],0))FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=2)FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=4    "
        strSql += vbCrLf + "   UPDATE TT3 SET  TT3.[AVG-%]= (SELECT SUM(ISNULL([AVG-%],0))/COUNT(DISTINCT ACCODE) FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=2) FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=4    "
        strSql += vbCrLf + "   UPDATE TT3 SET  TT3.[TOTAL-%]= (SELECT SUM(ISNULL([TOTAL-%],0))/COUNT(DISTINCT ACCODE)FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=2)FROM TEMPTABLEDB..TMPRES3 TT3 WHERE RESULT=4    "
        strSql += vbCrLf + "   select * from TEMPTABLEDB..TmpRes3  ORDER BY ACNAME,RESULT  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_CTRANSFER()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CTRANSFER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CTRANSFER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_CTRANSFER"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @TAGSNO VARCHAR(15)"
        strSql += vbCrLf + " ,@NEWCOSTID VARCHAR(2)"
        strSql += vbCrLf + " ,@ISSDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@ISSTIME SMALLDATETIME"
        strSql += vbCrLf + " ,@VERSION VARCHAR(12)"
        strSql += vbCrLf + " ,@USERID INT"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " DECLARE @BSNO VARCHAR(15)"
        strSql += vbCrLf + " DECLARE @OLDCOSTID VARCHAR(2)"
        strSql += vbCrLf + " DECLARE @OLDCOMPANYID VARCHAR(3)"
        strSql += vbCrLf + " SELECT @OLDCOSTID = COSTID,@OLDCOMPANYID = COMPANYID FROM " & cnAdminDb & "..ITEMTAG WHERE SNO = @TAGSNO"
        strSql += vbCrLf + " IF ISNULL(@OLDCOMPANYID,'') <> ''"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & tranDbName & "..CTRANSFER WHERE TAGSNO = @TAGSNO)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	UPDATE " & tranDbName & "..CTRANSFER SET ISSDATE = @ISSDATE"
        strSql += vbCrLf + " 	WHERE TAGSNO = @TAGSNO"
        strSql += vbCrLf + " 	AND ISSDATE IS NULL"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " ELSE"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	EXEC " & tranDbName & "..GET_ADMINSNO_TRAN"
        strSql += vbCrLf + " 	@COSTID = @OLDCOSTID"
        strSql += vbCrLf + " 	,@CTLID = 'CTRANSFERCODE'"
        strSql += vbCrLf + " 	,@CHECKTABLENAME = 'CTRANSFER'"
        strSql += vbCrLf + " 	,@COMPANYID = @OLDCOMPANYID"
        strSql += vbCrLf + " 	,@RETVALUE = @BSNO OUTPUT"
        strSql += vbCrLf + " 	INSERT INTO " & tranDbName & "..CTRANSFER"
        strSql += vbCrLf + " 	(SNO,TAGSNO,ITEMID,TAGNO,COSTID,RECDATE,ISSDATE,TAGVAL,USERID"
        strSql += vbCrLf + " 	,UPDATED,UPTIME,APPVER,ENTORDER,ITEMCTRID)"
        strSql += vbCrLf + " 	SELECT @BSNO AS SNO,SNO TAGSNO"
        strSql += vbCrLf + " 	,ITEMID,TAGNO,COSTID,RECDATE,@ISSDATE  AS ISSDATE"
        strSql += vbCrLf + " 	,TAGVAL,@USERID USERID,@ISSDATE UPDATED,@ISSTIME  UPTIME,@VERSION APPVER,1,ITEMCTRID"
        strSql += vbCrLf + " 	FROM " & cnAdminDb & "..ITEMTAG WHERE SNO = @TAGSNO "
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " EXEC " & tranDbName & "..GET_ADMINSNO_TRAN"
        strSql += vbCrLf + " @COSTID = @OLDCOSTID"
        strSql += vbCrLf + " ,@CTLID = 'CTRANSFERCODE'"
        strSql += vbCrLf + " ,@CHECKTABLENAME = 'CTRANSFER'"
        strSql += vbCrLf + " ,@COMPANYID = @OLDCOMPANYID"
        strSql += vbCrLf + " ,@RETVALUE = @BSNO OUTPUT"
        strSql += vbCrLf + " DECLARE @ENTORDER INT"
        strSql += vbCrLf + " SELECT @ENTORDER = ISNULL(MAX(ENTORDER),0)+1 FROM " & tranDbName & "..CTRANSFER WHERE TAGSNO = @TAGSNO"
        strSql += vbCrLf + " INSERT INTO " & tranDbName & "..CTRANSFER"
        strSql += vbCrLf + " (SNO,TAGSNO,ITEMID,TAGNO,COSTID,RECDATE,TAGVAL,USERID"
        strSql += vbCrLf + " ,UPDATED,UPTIME,APPVER,ENTORDER,ITEMCTRID)"
        strSql += vbCrLf + " SELECT @BSNO AS SNO,SNO TAGSNO"
        strSql += vbCrLf + " ,ITEMID,TAGNO,@NEWCOSTID,@ISSDATE  AS RECDATE"
        strSql += vbCrLf + " ,TAGVAL,@USERID USERID,@ISSDATE UPDATED,@ISSTIME UPTIME,@VERSION APPVER,@ENTORDER,ITEMCTRID"
        strSql += vbCrLf + " FROM " & cnAdminDb & "..ITEMTAG "
        strSql += vbCrLf + " WHERE SNO = @TAGSNO"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_CCTRANSFER()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CCTRANSFER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CCTRANSFER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_CCTRANSFER"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @TAGSNO VARCHAR(15)"
        strSql += vbCrLf + " ,@COSTID VARCHAR(2)"
        strSql += vbCrLf + " ,@ISSDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@ISSTIME SMALLDATETIME"
        strSql += vbCrLf + " ,@VERSION VARCHAR(12)"
        strSql += vbCrLf + " ,@USERID INT"
        strSql += vbCrLf + " ,@TRFNO VARCHAR(15)=''"
        strSql += vbCrLf + " ,@FLAG VARCHAR(12)=''"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " DECLARE @BSNO VARCHAR(15)"
        strSql += vbCrLf + " DECLARE @OLDCOMPANYID VARCHAR(3)"
        strSql += vbCrLf + " DECLARE @ORGCOSTID VARCHAR(2)"
        strSql += vbCrLf + " SELECT @ORGCOSTID = COSTID, @OLDCOMPANYID = COMPANYID FROM " & cnAdminDb & "..ITEMTAG WHERE SNO = @TAGSNO"
        strSql += vbCrLf + " IF ISNULL(@OLDCOMPANYID,'') <> ''"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & cnAdminDb & "..CTRANSFER WHERE TAGSNO = @TAGSNO AND ISSDATE IS NULL)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	UPDATE " & cnAdminDb & "..CTRANSFER SET ISSDATE = @ISSDATE"
        strSql += vbCrLf + " 	WHERE TAGSNO = @TAGSNO"
        strSql += vbCrLf + " 	AND ISSDATE IS NULL"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " ELSE"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + "    DECLARE @ENTORDER INT"
        strSql += vbCrLf + "    SELECT @ENTORDER = ISNULL(MAX(ENTORDER),0)+1 FROM " & cnAdminDb & "..CTRANSFER WHERE TAGSNO = @TAGSNO"
        strSql += vbCrLf + " 	EXEC " & tranDbName & "..GET_ADMINSNO_TRAN"
        strSql += vbCrLf + " 	@COSTID = @ORGCOSTID"
        strSql += vbCrLf + " 	,@CTLID = 'CTRANSFERCODE'"
        strSql += vbCrLf + " 	,@CHECKTABLENAME = 'CTRANSFER'"
        strSql += vbCrLf + " 	,@COMPANYID = @OLDCOMPANYID"
        strSql += vbCrLf + " 	,@RETVALUE = @BSNO OUTPUT"
        strSql += vbCrLf + " 	INSERT INTO " & cnAdminDb & "..CTRANSFER"
        strSql += vbCrLf + " 	(SNO,TAGSNO,ITEMID,TAGNO,COSTID,RECDATE,ISSDATE,TAGVAL,USERID"
        strSql += vbCrLf + " 	,UPDATED,UPTIME,APPVER,ENTORDER,ITEMCTRID,TRFNO,FLAG)"
        strSql += vbCrLf + " 	SELECT @BSNO AS SNO,SNO TAGSNO"
        strSql += vbCrLf + " 	,ITEMID,TAGNO,@COSTID,RECDATE,@ISSDATE  AS ISSDATE"
        strSql += vbCrLf + " 	,TAGVAL,@USERID USERID,@ISSDATE UPDATED,@ISSTIME  UPTIME,@VERSION APPVER,@ENTORDER,ITEMCTRID,@TRFNO,@FLAG"
        strSql += vbCrLf + " 	FROM " & cnAdminDb & "..ITEMTAG WHERE SNO = @TAGSNO "
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " END  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_RPT_CUSTOMER_CREDIT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CUSTOMER_CREDIT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CUSTOMER_CREDIT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "    CREATE PROCEDURE [dbo].[SP_RPT_CUSTOMER_CREDIT]    "
        strSql += vbCrLf + "  (   "
        strSql += vbCrLf + "  @DBNAME VARCHAR(20)  "
        strSql += vbCrLf + "  ,@FROMDATE VARCHAR(13)    "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(13)    "
        strSql += vbCrLf + "  ,@DISPLAY VARCHAR(1)    "
        strSql += vbCrLf + "  ,@ORDERBY VARCHAR(1)    "
        strSql += vbCrLf + "  ,@FILTERBY VARCHAR(50)    "
        strSql += vbCrLf + "  ,@FILTERCAPTION VARCHAR(50)    "
        strSql += vbCrLf + "  ,@COSTID VARCHAR(50)    "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(50)    "
        strSql += vbCrLf + "  ,@TYPEID VARCHAR(50)    "
        strSql += vbCrLf + "  ,@GRPAREA VARCHAR(1)"
        strSql += vbCrLf + "  ,@TOBE VARCHAR(1)"
        strSql += vbCrLf + "  ,@FORMAT1 VARCHAR(1)"
        strSql += vbCrLf + "  ,@CPUR VARCHAR(1)"
        strSql += vbCrLf + "  ,@ACCODE VARCHAR(25)"
        strSql += vbCrLf + "  ,@GROUPBY VARCHAR(1)='Y'"
        strSql += vbCrLf + "  )    "
        strSql += vbCrLf + "  AS    "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	DECLARE @QRY AS VARCHAR(8000)"
        strSql += vbCrLf + "  	DECLARE @SPACE VARCHAR(10)"
        strSql += vbCrLf + "  	set @ACCODE= REPLACE(@ACCODE,',',''',''')"
        strSql += vbCrLf + "  	IF @TYPEID = 'DP' SET  @TYPEID =REPLACE(@TYPEID,'DP','D')"
        strSql += vbCrLf + "  	IF @FILTERBY <> 'NONE' AND @FILTERBY <> ''AND @FILTERBY<>'TRANNO' SELECT @FILTERBY=' P.'+@FILTERBY "
        strSql += vbCrLf + "  	IF @FILTERBY='TRANNO' SELECT @FILTERBY=' O.'+@FILTERBY "
        strSql += vbCrLf + "  	SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')"
        strSql += vbCrLf + "  	SET @TYPEID = REPLACE(@TYPEID,',',''',''')"
        strSql += vbCrLf + "  	IF (SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME='TEMP_OUTSTANDING') > 0    "
        strSql += vbCrLf + "  	DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING  "
        strSql += vbCrLf + "  	IF @FORMAT1='N'"
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		SELECT @QRY=' SELECT CONVERT(VARCHAR(100),NULL) PARTICULAR,TRANDATE,RUNNO,C.CATNAME AS CATNAME,SUM(CASE WHEN RECPAY = ''P'' THEN TRANNO END)TRANNO'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,CONVERT(VARCHAR(10),NULL)TRANNO1,CONVERT(VARCHAR(10),NULL)RECBILLNO,TRANDATE RECBILLDATE,DUEDATE'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,SUM(CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE 0 END) AS DEBIT ,CONVERT(DECIMAL(12,2),0) AS CREDIT   '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,SUM(CASE WHEN O.RECPAY = ''P'' THEN O.AMOUNT ELSE (-1)*O.AMOUNT END) AS BALANCE    '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,BATCHNO,O.COSTID,O.COMPANYID  '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD,CONVERT(VARCHAR,NULL)GRTOTAL,O.RECPAY'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' INTO TEMPTABLEDB..TEMP_OUTSTANDING'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' FROM  OUTSTANDING AS O  '  "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' LEFT JOIN  CATEGORY C ON ISNULL(O.CATCODE,'''')=ISNULL(C.CATCODE,'''')'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' WHERE O.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE +''' '"
        strSql += vbCrLf + "  		IF @CPUR = 'N'  SELECT @QRY=@QRY+' AND O.PAYMODE<>''DP'' '"
        strSql += vbCrLf + "  		IF @CPUR = 'Y'  SELECT @QRY=@QRY+' AND O.PAYMODE=''DP'' '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' AND ISNULL(O.CANCEL,'''') = ''''  AND RECPAY = ''P'' '"
        strSql += vbCrLf + "  		IF @COSTID <> '' SELECT @QRY=@QRY+' AND ISNULL(O.COSTID,'''') IN ('''+@COSTID+''') '"
        strSql += vbCrLf + "  		IF @COMPANYID <> '' SELECT @QRY=@QRY+' AND ISNULL(O.COMPANYID,'''') IN ('''+@COMPANYID+''') AND O.TRANTYPE IN('''+ @TYPEID +''')  '"
        strSql += vbCrLf + "  		IF @TOBE='N' SELECT @QRY=@QRY+' AND BATCHNO NOT IN (SELECT BATCHNO FROM  ITEMDETAIL)'"
        strSql += vbCrLf + "  		IF @TOBE='Y' SELECT @QRY=@QRY+' AND BATCHNO IN (SELECT BATCHNO FROM  ITEMDETAIL )'"
        strSql += vbCrLf + "  		IF @ACCODE <> '' SELECT @QRY=@QRY+' AND ISNULL(O.ACCODE,'''') IN ('''+@ACCODE+''') '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' GROUP BY O.RUNNO,O.TRANNO,BATCHNO,TRANDATE,DUEDATE,O.COSTID,O.COMPANYID,O.RECPAY,C.CATNAME'"
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY='INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING (PARTICULAR,RUNNO,CATNAME,TRANNO,TRANNO1,RECBILLNO,RECBILLDATE,BATCHNO,TRANDATE,DUEDATE'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+',DEBIT,CREDIT,BALANCE'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+',RESULT,COLHEAD,GRTOTAL,COSTID,COMPANYID,RECPAY)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,O.RUNNO,C.CATNAME AS CATNAME,SUM(CASE WHEN O.RECPAY = ''P'' THEN O.TRANNO END)TRANNO'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,CONVERT(VARCHAR(10),NULL)TRANNO1,SUM(CASE WHEN O.RECPAY = ''R'' THEN O.TRANNO END)RECBILLNO,O.TRANDATE RECBILLDATE,O.BATCHNO,O.TRANDATE,O.DUEDATE,0 AS DEBIT '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,SUM(CASE WHEN O.RECPAY = ''R'' THEN O.AMOUNT ELSE 0 END) AS CREDIT'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,SUM(CASE WHEN O.RECPAY = ''P'' THEN O.AMOUNT ELSE (-1)*O.AMOUNT END) AS BALANCE    '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD,CONVERT(VARCHAR,NULL)GRTOTAL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' ,O.COSTID,O.COMPANYID ,O.RECPAY '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' FROM  OUTSTANDING AS O  '  "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' LEFT JOIN  CATEGORY C ON ISNULL(O.CATCODE,'''')=ISNULL(C.CATCODE,'''')'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' INNER JOIN TEMPTABLEDB..TEMP_OUTSTANDING AS OU ON O.RUNNO=OU.RUNNO'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' WHERE O.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE +''' AND O.PAYMODE<>''DP'' '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' AND ISNULL(O.CANCEL,'''') = ''''  AND O.RECPAY = ''R'' '"
        strSql += vbCrLf + "  		IF @COSTID <> '' SELECT @QRY=@QRY+' AND ISNULL(O.COSTID,'''') IN ('''+@COSTID+''') '"
        strSql += vbCrLf + "  		IF @COMPANYID <> '' SELECT @QRY=@QRY+' AND ISNULL(O.COMPANYID,'''') IN ('''+@COMPANYID+''')  '"
        strSql += vbCrLf + "  		IF @ACCODE <> '' SELECT @QRY = @QRY + ' AND O.ACCODE IN('''+@ACCODE+''')'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+' GROUP BY O.RUNNO,O.TRANNO,O.COSTID,O.COMPANYID,O.TRANDATE,O.DUEDATE,O.BATCHNO ,O.RECPAY,C.CATNAME       ' "
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY=' UPDATE T1 SET TRANNO=(SELECT TOP 1 TRANNO FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=T1.RUNNO AND TRANNO IS NOT NULL AND COMPANYID IN ('''+ @COMPANYID +''')) FROM TEMPTABLEDB..TEMP_OUTSTANDING T1'"
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY='IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME=''TEMPOUTSTANDINGOUT'')DROP TABLE TEMPTABLEDB..TEMPOUTSTANDINGOUT'"
        strSql += vbCrLf + "  		EXEC(@QRY)"
