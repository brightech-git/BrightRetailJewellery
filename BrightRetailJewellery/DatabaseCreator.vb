    Private Sub funcAlterColumnWidth(ByVal Dbname As String, ByVal TblName As String, ByVal ColName As String, ByVal Type As String, ByVal Length As Integer, ByVal Position As Integer, ByVal Cons As String)
        strSql = " SELECT LENGTH  FROM  " & Dbname & "..SYSCOLUMNS WHERE NAME = '" & ColName & "' AND ID=(SELECT ID FROM " & Dbname & "..SYSOBJECTS WHERE XTYPE='U' AND NAME='" & TblName & "')"
        If GetSqlValue(strSql, Length) < Length Then
            If Type.ToUpper = "VARCHAR" Then
                strSql = "ALTER TABLE " & Dbname & " .." & TblName & " ALTER COLUMN " & ColName & " VARCHAR(" & Length & ") " & Cons & ""
            ElseIf Type.ToUpper = "NVARCHAR" Then
                strSql = "ALTER TABLE " & Dbname & " .." & TblName & " ALTER COLUMN " & ColName & " NVARCHAR(" & Length & ") " & Cons & ""
            ElseIf Type.ToUpper = "INT" Then
                strSql = "ALTER TABLE " & Dbname & " .." & TblName & " ALTER COLUMN " & ColName & " INT " & Cons & ""
            ElseIf Type.ToUpper = "BIGINT" Then
                strSql = "ALTER TABLE " & Dbname & " .." & TblName & " ALTER COLUMN " & ColName & " BIGINT "
            ElseIf Type.ToUpper = "NUMERIC" Then
                strSql = "ALTER TABLE " & Dbname & " .." & TblName & " ALTER COLUMN " & ColName & " numeric (" & Length & "," & Position & ") " & Cons & ""
            End If
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
        End If
    End Sub

