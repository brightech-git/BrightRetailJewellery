        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'0 RGRSWT,0 RNETWT,0 AMOUNT'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN I.ITEMID = 0 OR (I.SUBITEMID = 0 AND IM.BOOKSTOCK IN (''W'',''B'')) OR (I.SUBITEMID <> 0 AND SM.BOOKSTOCK IN (''W'',''B'')) THEN -1*I.GRSWT ELSE 0 END AS IGRSWT'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN I.ITEMID = 0 OR (I.SUBITEMID = 0 AND IM.BOOKSTOCK IN (''W'',''B'')) OR (I.SUBITEMID <> 0 AND SM.BOOKSTOCK IN (''W'',''B'')) THEN -1*I.NETWT ELSE 0 END AS INETWT'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',-1* AMOUNT+ISNULL((SELECT SUM(STNAMT) FROM '+ @DBNAME +'..RECEIPTSTONE WHERE ISSSNO = I.SNO),0)  IAMOUNT '  "
