        strSql += vbCrLf + " 	SELECT @QRY = ' SELECT SCHEMEID,JOINDATE AS TRANDATE,((SELECT SCHEMENAME FROM " & cnChitCompanyid & "SAVINGS..SCHEME WHERE SCHEMEID = SM.SCHEMEID)  + '' ( '' +' "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' CONVERT(NVARCHAR,(SELECT AMOUNT FROM " & cnChitCompanyid & "SAVINGS..INSAMOUNT WHERE SCHEMEID = SM.SCHEMEID AND GROUPCODE =SM.GROUPCODE  ))) + '' - '' + SM.GROUPCODE + '' - '' +  CONVERT(NVARCHAR,SM.REGNO)  + '' )''  AS SCHEME,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' (SELECT AMOUNT FROM " & cnChitCompanyid & "SAVINGS..INSAMOUNT WHERE SCHEMEID = SM.SCHEMEID AND GROUPCODE =SM.GROUPCODE  ) AS SAMOUNT,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' CONVERT(NUMERIC(15,2),0) AS POINTS  ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES,CONVERT(VARCHAR(1),NULL) AS VALUEINWTRAMT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INTO TEMPTABLEDB..TEMPCHTCOLL1 FROM " & cnChitCompanyid & "SAVINGS..SCHEMEMAST SM'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' WHERE INTRO IN (SELECT INTCODE  FROM " & cnChitCompanyid & "SAVINGS..INTRODUCER  WHERE  PREVILEGEID ='''+@PREVILEGEID+''')'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' AND JOINDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMPCHTCOLL1 SET POINTS = ISNULL(PV.POINTS,0),BPOINTVALUES = ISNULL(PV.VALUE,0),VALUEINWTRAMT=ISNULL(PV.VALUEINWTRAMT,''A'')'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPCHTCOLL1 TR LEFT JOIN " & compId & "ADMINDB..PRIVILIGE PV ON TR.SCHEMEID=PV.SCHEMEID'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' WHERE SAMOUNT BETWEEN PV.FROMRANGE AND PV.TORANGE AND CUSTOMERTYPE =''I'''"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	/* Emp*/"
        strSql += vbCrLf + " 	SELECT @QRY = ' SELECT SCHEMEID,JOINDATE AS TRANDATE,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ((SELECT SCHEMENAME FROM " & cnChitCompanyid & "SAVINGS..SCHEME WHERE SCHEMEID = SM.SCHEMEID)  + '' ( '' + CONVERT(NVARCHAR,(SELECT AMOUNT FROM " & cnChitCompanyid & "SAVINGS..INSAMOUNT WHERE SCHEMEID = SM.SCHEMEID AND GROUPCODE =SM.GROUPCODE  ))) + '' - '' + SM.GROUPCODE + '' - '' +'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' CONVERT(NVARCHAR,SM.REGNO)  + '' )''  AS SCHEME,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' (SELECT AMOUNT FROM " & cnChitCompanyid & "SAVINGS..INSAMOUNT WHERE SCHEMEID = SM.SCHEMEID AND GROUPCODE =SM.GROUPCODE  ) AS SAMOUNT,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' CONVERT(NUMERIC(15,2),0) AS POINTS  ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES,CONVERT(VARCHAR(1),NULL) AS VALUEINWTRAMT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INTO TEMPTABLEDB..TEMPCHTCOLL2 FROM " & cnChitCompanyid & "SAVINGS..SCHEMEMAST SM'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' WHERE IEMP IN (SELECT EMPID   FROM " & cnChitCompanyid & "SAVINGS..EMPMASTER WHERE PREVILEGEID ='''+@PREVILEGEID+''')'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' AND JOINDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMPCHTCOLL2 SET POINTS = ISNULL(PV.POINTS,0),BPOINTVALUES = ISNULL(PV.VALUE,0),VALUEINWTRAMT=ISNULL(PV.VALUEINWTRAMT,''A'')'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPCHTCOLL2 TR LEFT JOIN " & compId & "ADMINDB..PRIVILIGE  PV ON TR.SCHEMEID=PV.SCHEMEID'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' WHERE SAMOUNT BETWEEN PV.FROMRANGE AND PV.TORANGE AND CUSTOMERTYPE =''E'''"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT SCHEME AS PARTICULAR ,CONVERT(NVARCHAR(12),TRANDATE ,103) AS TRANDATE ,''CHIT'' AS METALNAME, 0 PCS, 0 AS GRSWT ,0 AS NETWT,0 AS AMOUNT,0 AS TAX, 0 AS SC,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' 0 AS TOTAL,0 AS STNWT,0 AS DIAWT,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,VALUEINWTRAMT, 1 AS  RESULT,''D'' AS COLHEAD'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPCHTCOLL GROUP BY TRANDATE,SCHEME,VALUEINWTRAMT ORDER BY TRANDATE,SCHEME'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT SCHEME AS PARTICULAR ,CONVERT(NVARCHAR(12),TRANDATE  ,103) AS TRANDATE ,''CHIT'' AS METALNAME, 0 PCS, 0 AS GRSWT ,0 AS NETWT,0 AS AMOUNT,0 AS TAX, 0 AS SC,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' 0 AS TOTAL,0 AS STNWT,0 AS DIAWT,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,VALUEINWTRAMT, 1 AS  RESULT,''D'' AS COLHEAD'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM  TEMPTABLEDB..TEMPCHTCOLL1 GROUP BY TRANDATE,SCHEME,VALUEINWTRAMT ORDER BY TRANDATE,SCHEME'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT SCHEME AS PARTICULAR ,CONVERT(NVARCHAR(12),TRANDATE  ,103) AS TRANDATE ,''CHIT'' AS METALNAME, 0 PCS, 0 AS GRSWT ,0 AS NETWT,0 AS AMOUNT,0 AS TAX, 0 AS SC,'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' 0 AS TOTAL,0 AS STNWT,0 AS DIAWT,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,VALUEINWTRAMT, 1 AS  RESULT,''D'' AS COLHEAD'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM  TEMPTABLEDB..TEMPCHTCOLL2 GROUP BY TRANDATE,SCHEME,VALUEINWTRAMT ORDER BY TRANDATE,SCHEME'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	/* CHIT COLLECTION*/"
        strSql += vbCrLf + " 	SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,METALNAME,POINTS,BPOINTVALUES,AMOUNT,RESULT,COLHEAD)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT ''OPENING'',''OPENING'',ISNULL(PREVILEGEPOINTS,0),ISNULL(PREVILEGEVALUE,0),AMOUNT,1 RESULT,''D'' AS COLHEAD FROM OPENPREVILEGE WHERE PREVILEGEID='''+@PREVILEGEID+''''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,METALNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT DISTINCT METALNAME,METALNAME,0 RESULT,''T''COLHEAD FROM TEMPTABLEDB..TEMPPRIVREP1 AS T '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,POINTS,BPOINTVALUES,RESULT,METALNAME,COLHEAD)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT METALNAME + '' SUB TOTAL''AS PARTICULAR'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SUM(ISNULL(PCS,0))PCS,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(AMOUNT,0))AMOUNT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SUM(ISNULL(TAX,0))TAX,SUM(ISNULL(SC,0))SC,SUM(ISNULL(TOTAL,0))TOTAL,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(DIAWT,0))DIAWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SUM(ISNULL(POINTS,0)) POINTS, SUM(ISNULL(BPOINTVALUES,0)) BPOINTVALUES,2 RESULT,METALNAME,''S''COLHEAD'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPPRIVREP1 AS T WHERE RESULT =1 GROUP BY METALNAME'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPRIVREP1(PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,POINTS,BPOINTVALUES,RESULT,METALNAME,COLHEAD)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' SELECT ''GRAND TOTAL''AS PARTICULAR,SUM(ISNULL(PCS,0))PCS,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(AMOUNT,0))AMOUNT '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SUM(ISNULL(TAX,0))TAX,SUM(ISNULL(SC,0))SC,SUM(ISNULL(TOTAL,0))TOTAL,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(DIAWT,0))DIAWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SUM(ISNULL(POINTS,0)) POINTS, SUM(ISNULL(BPOINTVALUES,0)) BPOINTVALUES,3 RESULT,''ZZZZZ''METALNAME,''G''COLHEAD'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPPRIVREP1 WHERE RESULT =1'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMPPRIVREP1 SET METALNAME =''ZREDEEM'' WHERE METALNAME=''REDEEM'''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' UPDATE TEMPTABLEDB..TEMPPRIVREP1 SET METALNAME =''AOP'' WHERE METALNAME=''OPENING'''"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SELECT @QRY = 'SELECT *,IDENTITY(INT,1,1) AS SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN' + ' FROM TEMPTABLEDB..TEMPPRIVREP1 ORDER BY METALNAME,RESULT,TRANDATE,PARTICULAR'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC(@QRY)"
        strSql += vbCrLf + " END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_PREVILEGETRAN1()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PREVILEGETRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PREVILEGETRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        Dim dtDupCheck As New DataTable
        strSql = " SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dtDupCheck)

        If dtDupCheck.Rows.Count > 0 Then
            cnChitCompanyid = dtDupCheck.Rows(0).Item(0).ToString()
        Else
            cnChitCompanyid = compId
        End If

        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_PREVILEGETRAN  "
        strSql += vbCrLf + "    (  "
        strSql += vbCrLf + "    @SYSTEMID VARCHAR(10)  "
        strSql += vbCrLf + "    ,@FRMDATE VARCHAR(20)  "
        strSql += vbCrLf + "    ,@TODATE VARCHAR(20)  "
        strSql += vbCrLf + "    ,@PREVILEGEID VARCHAR(200)  "
        strSql += vbCrLf + "    ,@METALNAME VARCHAR(200)  "
        strSql += vbCrLf + "    ,@COSTNAME VARCHAR(200)  "
        strSql += vbCrLf + "    ,@COMPANYID VARCHAR(3)  "
        strSql += vbCrLf + "    ,@WITHCHITPOINTS VARCHAR(1)  "
        strSql += vbCrLf + "    )  "
        strSql += vbCrLf + "    AS  "
        strSql += vbCrLf + "    SET NOCOUNT ON  "
        If SqlVersion > 8 Then
            strSql += vbCrLf + "    DECLARE @QRY VARCHAR(MAX)  "
        Else
            strSql += vbCrLf + "    DECLARE @QRY VARCHAR(8000)  "
        End If
        strSql += vbCrLf + "    DECLARE @DBARRAY VARCHAR(1000),@COLNAME AS VARCHAR(50)  "
        strSql += vbCrLf + "    DECLARE @DBARRAYLENGTH AS INT,@STRLEN AS INT,@COLLEN AS INT  "
        strSql += vbCrLf + "    SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN'  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    EXEC ..SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPMETALMAST') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMETALMAST CREATE TABLE TEMPTABLEDB..TEMPMETALMAST(METALID VARCHAR(10))  "
        strSql += vbCrLf + "    SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2)'  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    IF @METALNAME = '' OR @METALNAME = 'ALL'  "
        strSql += vbCrLf + "    INSERT INTO TEMPTABLEDB..TEMPMETALMAST(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST  "
        strSql += vbCrLf + "    ELSE  "
        strSql += vbCrLf + "    INSERT INTO TEMPTABLEDB..TEMPMETALMAST(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPPRIVREP') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPRIVREP  "
        strSql += vbCrLf + "    SELECT @QRY = 'CREATE TABLE TEMPTABLEDB..TEMPPRIVREP'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' (CATCODE VARCHAR(10),PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),AMOUNT NUMERIC(15,2),TAX NUMERIC(15,2),SC  NUMERIC(15,2),TOTAL  NUMERIC(15,3)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,STNWT  NUMERIC(15,3),DIAWT  NUMERIC(15,3),CUSTOMER VARCHAR(55),ADDRESS VARCHAR(200),PHONENO VARCHAR(20)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,TRANDATE SMALLDATETIME,TRANNO INT,SNO VARCHAR(20),METALNAME VARCHAR(20),STUDDED VARCHAR(10),CATNAME VARCHAR(250)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,SEP VARCHAR(10),BILLNO VARCHAR(20),BILLDATE VARCHAR(20),COMPANYID VARCHAR(3),COSTID VARCHAR(2),METALID VARCHAR(2)'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,ITEMID INT,PVGBASED VARCHAR(20),BPOINTS NUMERIC(15,2),POINTS NUMERIC(6,2),FIXEDRANGE VARCHAR(20),BPOINTVALUES NUMERIC(15,3),VALUEINWTRAMT VARCHAR(1))'  "
        strSql += vbCrLf + "    /* PRINT @QRY*/  "
        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    /*ISSUE PART*/  "
        strSql += vbCrLf + "    SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPPRIVREP '  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' (CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,CUSTOMER,ADDRESS,PHONENO,TRANDATE,TRANNO,SNO,METALNAME'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,STUDDED,CATNAME,SEP,BILLNO,BILLDATE,COMPANYID,COSTID,METALID,ITEMID,PVGBASED,BPOINTS,POINTS,FIXEDRANGE,BPOINTVALUES)'  "
        strSql += vbCrLf + "    SET @DBARRAYLENGTH=0  "
        strSql += vbCrLf + "    SET @DBARRAY=''  "
        strSql += vbCrLf + "    SELECT @DBARRAY =  @DBARRAY  +',' + DBNAME FROM " & cnAdminDb & "..DBMASTER  "
        strSql += vbCrLf + "    SELECT @DBARRAY = SUBSTRING(@DBARRAY,2,LEN(@DBARRAY))  "
        strSql += vbCrLf + "    SET @DBARRAYLENGTH = LEN(@DBARRAY)  "
        strSql += vbCrLf + "    SET @STRLEN = 0  "
        strSql += vbCrLf + "    WHILE @STRLEN < @DBARRAYLENGTH  "
        strSql += vbCrLf + "    BEGIN  "
        strSql += vbCrLf + "    IF CHARINDEX(',', @DBARRAY,1) > 0 SET @COLNAME = SUBSTRING(@DBARRAY,1,CHARINDEX(',', @DBARRAY,1)-1)  "
        strSql += vbCrLf + "    IF CHARINDEX(',', @DBARRAY,1) = 0 SET @COLNAME = SUBSTRING(@DBARRAY,1,@DBARRAYLENGTH)  "
        strSql += vbCrLf + "    SET @COLLEN = LEN(@COLNAME)+1  "
        strSql += vbCrLf + "    SET @STRLEN = @STRLEN+@COLLEN  "
        strSql += vbCrLf + "    IF (SELECT COUNT(*) FROM MASTER..SYSDATABASES WHERE  NAME=@COLNAME)>0   "
        strSql += vbCrLf + "    BEGIN  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' SELECT CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,AMOUNT+TAX+SC AS TOTAL'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM '+ @COLNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''S'')))STNWT'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM '+ @COLNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')))DIAWT'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,PNAME CUSTOMER,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') + ISNULL(ADDRESS2,'''') ADDRESS,MOBILE PHONENO,I.TRANDATE'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,TRANNO,I.SNO,(SELECT METALNAME FROM " & cnAdminDb & "..METALMAST WHERE METALID = (SELECT METALID FROM " & cnAdminDb & "..CATEGORY WHERE CATCODE = I.CATCODE))AS METALNAME'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,''N''STUDDED,CONVERT(VARCHAR(250),NULL)CATNAME,''I'' SEP,CONVERT(VARCHAR(20),REFNO) BILLNO,CONVERT(VARCHAR(20),REFDATE,103) BILLDATE'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,I.COMPANYID,I.COSTID,METALID,ITEMID,'' '' AS PVGBASED,CONVERT(NUMERIC(6,2),0) AS BPOINTS ,CONVERT(NUMERIC(6,2),0) AS POINTS,'' ''FIXEDRANGE'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,CONVERT(NUMERIC(6,2),0) AS BPOINTVALUES'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' FROM '+ @COLNAME +'..ISSUE AS I LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' LEFT OUTER JOIN " & cnAdminDb & "..PERSONALINFO AS P ON C.PSNO = P.SNO WHERE I.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND TRANTYPE IN (''SA'')'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' AND CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETALMAST))'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE) AND ISNULL(I.COMPANYID,'''') = '''+@COMPANYID+''' AND ISNULL(I.CANCEL,'''') = '''''  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' AND P.PREVILEGEID ='''+@PREVILEGEID+''''  "
        strSql += vbCrLf + "    IF @STRLEN <> (@DBARRAYLENGTH+1) SELECT @QRY = @QRY + CHAR(13) + ' UNION ALL'  "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    SET @DBARRAY = SUBSTRING(@DBARRAY,@COLLEN+1,@DBARRAYLENGTH)  "
        strSql += vbCrLf + "    END  "

        strSql += vbCrLf + "    EXEC (@QRY)  "
        strSql += vbCrLf + "    /*ISSSTONE PART*/  "
        strSql += vbCrLf + "    SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPPRIVREP '  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' (CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,CUSTOMER,ADDRESS,PHONENO,TRANDATE,TRANNO,SNO,METALNAME'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) + ' ,STUDDED,CATNAME,SEP,BILLNO,BILLDATE,COMPANYID,COSTID,METALID,ITEMID,PVGBASED,BPOINTS,POINTS,FIXEDRANGE,BPOINTVALUES)'  "
        strSql += vbCrLf + "    SET @DBARRAYLENGTH=0  "
        strSql += vbCrLf + "    SET @DBARRAY=''  "
