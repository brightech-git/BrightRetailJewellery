    Private Sub SP_SPLITVALUES_NEW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_SPLITVALUES_NEW')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_SPLITVALUES_NEW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_SPLITVALUES_NEW    "
        strSql += vbCrLf + "  (    "
        strSql += vbCrLf + "  @CHK_DB  VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@CHK_TBL VARCHAR(8000)=''  "
        strSql += vbCrLf + "  ,@CHK_FIELD VARCHAR(8000)=''"
        strSql += vbCrLf + "  ,@OUTPUT_FIELD VARCHAR(8000)"
        strSql += vbCrLf + "  ,@INPUTVALUES VARCHAR(8000)='ALL'  "
        strSql += vbCrLf + "  ,@RESULT_TBL VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@DEF_VAL VARCHAR(8000)=''"
        strSql += vbCrLf + "  )  "
        strSql += vbCrLf + "  AS   "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  SET @CHK_DB = @CHK_DB + '..'    "
        strSql += vbCrLf + "  DECLARE @SRCTABLENAME VARCHAR(8000)  "
        strSql += vbCrLf + "  SELECT @SRCTABLENAME = @RESULT_TBL  "
        strSql += vbCrLf + "  DECLARE @QURY VARCHAR(8000) "
        strSql += vbCrLf + "   SELECT @QURY = ' IF OBJECT_ID('''+@SRCTABLENAME+''') IS NOT NULL DROP TABLE '+@SRCTABLENAME"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  CREATE TABLE '+@SRCTABLENAME+'('+@OUTPUT_FIELD+' VARCHAR(500))'"
        strSql += vbCrLf + "  EXEC(@QURY)  "
        strSql += vbCrLf + "  SET @QURY = ''    "
        strSql += vbCrLf + "  SELECT @QURY = @QURY + ' DECLARE @TEMP VARCHAR(500)'"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + ' DECLARE @COMPANYID VARCHAR(500)'"
        strSql += vbCrLf + "  IF LEN(@CHK_TBL)>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + ' SELECT  @COMPANYID='''+@INPUTVALUES+''''"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + ' IF @COMPANYID = ''ALL''   '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  INSERT INTO '+@SRCTABLENAME+' ('+@OUTPUT_FIELD+') SELECT '+@OUTPUT_FIELD+' FROM '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + @CHK_DB+@CHK_TBL +' ELSE  '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + ' IF CHARINDEX('','',@COMPANYID)=0  '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  BEGIN  '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  INSERT INTO '+@SRCTABLENAME+' ('+@OUTPUT_FIELD+') SELECT '+@OUTPUT_FIELD+' FROM '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + @CHK_DB+@CHK_TBL +' WHERE '+@CHK_FIELD+'=@COMPANYID  END ELSE BEGIN  '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  WHILE CHARINDEX('','',@COMPANYID)>0      '"
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  BEGIN      ' "
        strSql += vbCrLf + "  SELECT @QURY = @QURY + '  SET @TEMP=LEFT(@COMPANYID,CHARINDEX('','',@COMPANYID)-1)      '"
