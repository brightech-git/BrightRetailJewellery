            strSql += vbCrLf + "          	IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPCASHABS)>0 OR (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPCASHCOLLECTION)>0     "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          	INSERT INTO  TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)SELECT 4 DISPORDER,'CASH ABSTRACT','T'COLHEAD     "
            strSql += vbCrLf + "          	End"
            strSql += vbCrLf + "          	IF (SELECT"
            strSql += vbCrLf + "          	COUNT(*) FROM  TEMPTABLEDB..TEMPCASHABS)>0     "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          	INSERT INTO  TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 4,PARTICULAR,AMOUNT,RESULT FROM  TEMPTABLEDB..TEMPCASHABS     "
            strSql += vbCrLf + "          	INSERT INTO  TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)SELECT 4,'TOTAL SA-SR+REC-PAY-PU+PV-DI+HC-RO',SUM(CASE WHEN RECPAY = 'R' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT,17 RESULT,'G'COLHEAD FROM  TEMPTABLEDB..TEMPCASHABS   "
            strSql += vbCrLf + "          	End"
            strSql += vbCrLf + "          	IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPCASHCOLLECTION)>0     "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          	INSERT INTO  TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 5,PARTICULAR,SUM(AMOUNT),0 RESULT FROM  TEMPTABLEDB..TEMPCASHCOLLECTION GROUP BY PARTICULAR     "
            strSql += vbCrLf + "          	INSERT INTO  TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)"
            strSql += vbCrLf + " 			SELECT 5,'TOTAL',SUM(CASE WHEN PARTICULAR<>'CHEQUE PAYMENT' THEN AMOUNT ELSE -1*AMOUNT END),1 RESULT,'G'COLHEAD FROM  TEMPTABLEDB..TEMPCASHCOLLECTION     "
            strSql += vbCrLf + "          	End"
            strSql += vbCrLf + "          	INSERT INTO TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD) "
            strSql += vbCrLf + "          	SELECT 16,'DISCOUNT = ' +CONVERT(VARCHAR(200),ISNULL(SUM(ISNULL(DISC,0)),0)),'C' FROM"
            strSql += vbCrLf + "          	("
            strSql += vbCrLf + "          	SELECT CASE WHEN TRANMODE ='D' THEN ISNULL(A.AMOUNT,0) ELSE ISNULL(A.AMOUNT,0)*(-1) END DISC"
            strSql += vbCrLf + "          	FROM  ACCTRAN A "
            strSql += vbCrLf + "          	WHERE ISNULL(A.CANCEL,'')='' AND A.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "          	AND A.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND A.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(A.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)  AND A.PAYMODE='DI' AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
            strSql += vbCrLf + "          	)Z  "
            strSql += vbCrLf + "          	INSERT INTO TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD) "
            strSql += vbCrLf + "          	SELECT 16,'FINAL DISCOUNT FOR '+ METALNAME +' = ' +CONVERT(VARCHAR(200),ISNULL(SUM(ISNULL(DISC,0)),0)),'C' FROM"
            strSql += vbCrLf + "          	("
            strSql += vbCrLf + "          	SELECT M.METALNAME ,SUM(ISNULL(FIN_DISCOUNT,0)) DISC "
            strSql += vbCrLf + "          	FROM  ISSUE AS I LEFT JOIN  " & cnAdminDb & "..METALMAST AS M ON M.METALID=I.METALID "
            strSql += vbCrLf + "          	WHERE ISNULL(I.CANCEL,'')='' AND I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) "
            strSql += vbCrLf + "          	AND I.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "          	AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
            strSql += vbCrLf + "          	GROUP BY I.METALID ,M.METALNAME  "
            strSql += vbCrLf + "          	)Z GROUP BY METALNAME  "
            strSql += vbCrLf + "          	INSERT INTO TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD) "
            strSql += vbCrLf + "          	SELECT 16,'OFFER DISCOUNT FOR '+ METALNAME +' = ' +CONVERT(VARCHAR(200),ISNULL(SUM(ISNULL(DISC,0)),0)),'C' FROM"
            strSql += vbCrLf + "          	("
            strSql += vbCrLf + "          	SELECT M.METALNAME ,SUM(ISNULL(DISCOUNT,0)) DISC "
            strSql += vbCrLf + "          	FROM  ISSUE AS I LEFT JOIN  " & cnAdminDb & "..METALMAST AS M ON M.METALID=I.METALID "
            strSql += vbCrLf + "          	WHERE ISNULL(I.CANCEL,'')='' AND I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) "
            strSql += vbCrLf + "          	AND I.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "          	AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
            strSql += vbCrLf + "          	GROUP BY I.METALID ,M.METALNAME  "
            strSql += vbCrLf + "          	)Z GROUP BY METALNAME  "
            strSql += vbCrLf + "             INSERT INTO TEMPTABLEDB..TEMPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)"
            strSql += vbCrLf + "             /*SELECT 16,CASE P.TRANTYPE WHEN 'I' THEN 'PRIVILEGE ISSUE = ' WHEN 'R' THEN 'PRIVILEGE RECIEPT = ' END + CONVERT(VARCHAR,SUM(P.PVALUE)),'C'"
            strSql += vbCrLf + "             FROM  ISSUE AS I INNER JOIN  " & cnAdminDb & "..PRIVILEGETRAN AS P ON P.BATCHNO=I.BATCHNO "
            strSql += vbCrLf + "             WHERE ISNULL(I.CANCEL,'')='' AND I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) "
            strSql += vbCrLf + "             AND I.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "             And I.SYSTEMID In (SELECT SYSTEMID FROM #SYSTEMID) And I.COMPANYID In (Select COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) And ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) "
            strSql += vbCrLf + "             GROUP BY P.TRANTYPE*/"
            strSql += vbCrLf + "             SELECT 16,CASE P.TRANTYPE WHEN 'I' THEN 'PRIVILEGE ISSUE = ' WHEN 'R' THEN 'PRIVILEGE RECIEPT = ' END + CONVERT(VARCHAR,SUM(P.PVALUE)),'C'"
            strSql += vbCrLf + "             FROM  " & cnAdminDb & "..PRIVILEGETRAN AS P  "
            strSql += vbCrLf + "             WHERE ISNULL(P.CANCEL,'')='' AND BATCHNO IN (SELECT DISTINCT BATCHNO FROM ISSUE I WHERE  I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) "
            strSql += vbCrLf + "             AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(I.CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
            strSql += vbCrLf + "             AND I.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "             UNION ALL"
            strSql += vbCrLf + "             SELECT DISTINCT BATCHNO FROM RECEIPT  I WHERE  I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) "
            strSql += vbCrLf + "             AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(I.CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
            strSql += vbCrLf + "             AND I.TRANDATE BETWEEN @FRMDATE AND @TODATE)"
            strSql += vbCrLf + "             AND P.TRANDATE BETWEEN @FRMDATE AND @TODATE "
            strSql += vbCrLf + "             GROUP BY P.TRANTYPE"
            strSql += vbCrLf + "          	DECLARE @QRY VARCHAR(1000)   "
            strSql += vbCrLf + "          	SELECT @QRY = ' IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CASHSUMMARY'')>0 DROP TABLE  TEMPTABLEDB..TEMP'+@SYSTEMID+'CASHSUMMARY'   "
            strSql += vbCrLf + "          	SELECT @QRY = @QRY + ' SELECT * INTO  TEMPTABLEDB..TEMP'+@SYSTEMID+'CASHSUMMARY FROM  TEMPTABLEDB..TEMPCASHSUM_M '"
            strSql += vbCrLf + "          	IF @GROUPBYCOUNTER='N' SELECT @QRY = @QRY + 'ORDER BY DISPORDER,CATNAME,ITEM,RESULT,STUDDED,SUBITEM'   "
            strSql += vbCrLf + "          	IF @GROUPBYCOUNTER='Y' SELECT @QRY = @QRY + 'ORDER BY DISPORDER,COUNTERNAME,ITEM,RESULT,STUDDED,SUBITEM'   "
            strSql += vbCrLf + "          	PRINT @QRY"
            strSql += vbCrLf + "          	EXEC (@QRY)    "
            strSql += vbCrLf + "          	IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPCHITCOLLECTIONWT)>0      "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          	 SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'CASHSUMMARY  SET GRSWT=(SELECT SUM(GRSWT) FROM TEMPTABLEDB..TEMPCHITCOLLECTIONWT) '"
            strSql += vbCrLf + "          	SELECT @QRY = @QRY + ',NETWT=(SELECT SUM(NETWT) FROM TEMPTABLEDB..TEMPCHITCOLLECTIONWT) WHERE  PARTICULAR=''[REC] SCHEME COLLECTION WT'''"
            strSql += vbCrLf + "          	PRINT @QRY"
            strSql += vbCrLf + "          	EXEC (@QRY)    "
            strSql += vbCrLf + "          	SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'CASHSUMMARY SET AMOUNT=NULL WHERE  PARTICULAR=''[REC] SCHEME COLLECTION WT'''   "
            strSql += vbCrLf + "          	PRINT @QRY"
            strSql += vbCrLf + "          	EXEC (@QRY) "
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "        		SELECT @QUERY= 'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPCOMPANY'') DROP TABLE TEMPTABLEDB..TEMPCOMPANY               '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_SA'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_SA               '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_PU'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_PU               '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_RE'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_RE               '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_SR'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_SR               '"
            strSql += vbCrLf + "        		/** 2201 **/"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_MI'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_MI               '"
            strSql += vbCrLf + "        		/** 2201 **/"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPCASHSUM_M'') DROP TABLE TEMPTABLEDB..TEMPCASHSUM_M               '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPRATEPER_M'') DROP TABLE TEMPTABLEDB..TEMPRATEPER_M           '"
            strSql += vbCrLf + "        		SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPACCTRAN'') DROP TABLE TEMPTABLEDB..TEMPACCTRAN                      '"
            strSql += vbCrLf + "       	    PRINT @QUERY"
            strSql += vbCrLf + "       	    EXEC (@QUERY)"
            strSql += vbCrLf + "       	    SELECT @QUERY= ' SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CASHSUMMARY  ORDER BY DISPORDER,CATNAME,ITEM,RESULT,STUDDED '"
            strSql += vbCrLf + "       	    PRINT @QUERY"
            strSql += vbCrLf + "       	    EXEC (@QUERY)"
            strSql += vbCrLf + "       END	       "
QRYEXEC:
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            Exit Sub
        Catch ex As Exception
            If Err.Description.Contains("There is already an object named 'SP_CASHABSTRACT_CUSTOM' in the database.") = True Then strSql = Replace(strSql, "CREATE PROCEDURE", "ALTER PROCEDURE") : GoTo QRYEXEC
        End Try
    End Sub


    Private Sub funcSP_CashAbstract_New()
        Try
            strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CASHABSTRACT_NEW')>0"
            strSql += vbCrLf + " DROP PROCEDURE SP_CASHABSTRACT_NEW"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            strSql = vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPCOMPANY')>0 DROP TABLE  TEMPTABLEDB..TEMPCOMPANY           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_SA')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_SA           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_PU')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_PU           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_RE')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_RE           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_SR')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_SR           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_MI')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_MI           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPCASHSUM_M')>0 DROP TABLE  TEMPTABLEDB..TEMPCASHSUM_M     "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPRATEPER_M')>0 DROP TABLE  TEMPTABLEDB..TEMPRATEPER_M     "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPACCTRAN')>0 DROP TABLE  TEMPTABLEDB..TEMPACCTRAN     "
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + " CREATE PROCEDURE  SP_CASHABSTRACT_NEW"
            strSql += vbCrLf + " ("
            strSql += vbCrLf + " @FRMDATE VARCHAR(15)"
            strSql += vbCrLf + " ,@TODATE VARCHAR(15)"
            strSql += vbCrLf + " ,@COSTNAME VARCHAR(1500)"
            strSql += vbCrLf + " ,@SYSTEMID VARCHAR(10)"
            strSql += vbCrLf + " ,@NODEID VARCHAR(3)"
            strSql += vbCrLf + " ,@COMPANYID VARCHAR(500)"
            strSql += vbCrLf + " ,@CASHOPENING VARCHAR(1)    "
            strSql += vbCrLf + " ,@CHITDBEXSISTS VARCHAR(1)  "
            strSql += vbCrLf + " ,@SUBITEM VARCHAR(1)     "
            strSql += vbCrLf + " ,@GROUPBY VARCHAR(100)     "
            strSql += vbCrLf + " ,@MISCISSUE VARCHAR(1)     "
            strSql += vbCrLf + " ,@MISCVALUE VARCHAR(1)     "
            strSql += vbCrLf + " ,@BANKDET VARCHAR(1)     "
            strSql += vbCrLf + " ,@PARTLY VARCHAR(1)   "
            strSql += vbCrLf + " ,@GRSNET VARCHAR(1)"
            strSql += vbCrLf + " ,@WITHOUTDISC VARCHAR(1)"
            strSql += vbCrLf + " ,@WITHGROUPBYCATEGORY VARCHAR(1)"
            strSql += vbCrLf + " ,@BANKOPENING VARCHAR(1)"
            strSql += vbCrLf + " ,@CASHNAME VARCHAR(500)"
            strSql += vbCrLf + " )"
            strSql += vbCrLf + " AS"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + "      SET NOCOUNT ON"
            strSql += vbCrLf + "      DECLARE @GROUPBYCOUNTER VARCHAR(1) "
            strSql += vbCrLf + "      DECLARE @GROUPBYCATEGORY VARCHAR(1) "
            strSql += vbCrLf + "      DECLARE @GROUPBYTRANO VARCHAR(1) "
            strSql += vbCrLf + " 	 DECLARE @TBLNAME AS VARCHAR(100)"
            strSql += vbCrLf + " 	 DECLARE @MYCOUNT TABLE(MYROWCOUNT INT)"
            strSql += vbCrLf + " 	 DECLARE @MYCOUNT1 TABLE(MYROWCOUNT INT)"
            strSql += vbCrLf + "      SET @GROUPBYCOUNTER = 'N'"
            strSql += vbCrLf + "      SET @GROUPBYCATEGORY = 'N'"
            strSql += vbCrLf + "      SET @GROUPBYTRANO  = 'N'"
            strSql += vbCrLf + "      IF @GROUPBY = 'COUNTER' SET @GROUPBYCOUNTER = 'Y'"
            strSql += vbCrLf + "      IF @GROUPBY = 'CATEGORY' SET @GROUPBYCATEGORY = 'Y'"
            strSql += vbCrLf + "      IF @GROUPBY = 'TRANNO' SET @GROUPBYTRANO  = 'Y'"
            strSql += vbCrLf + "      DECLARE @QUERY  VARCHAR(8000)"
            strSql += vbCrLf + "      SELECT @QUERY= 'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'COMPANY'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'COMPANY               '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'BILLSUM_SA'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'BILLSUM_SA               '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'BILLSUM_PU'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'BILLSUM_PU               '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'BILLSUM_RE'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'BILLSUM_RE               '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'BILLSUM_SR'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'BILLSUM_SR               '"
            strSql += vbCrLf + "      /** 2201 **/ "
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'BILLSUM_MI'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'BILLSUM_MI               '"
            strSql += vbCrLf + "      /** 2201 **/ "
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'CASHSUM_M'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'CASHSUM_M               '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'RATEPER_M'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'RATEPER_M           '"
            strSql += vbCrLf + "      SELECT @QUERY= @QUERY + CHAR(13) +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+ @SYSTEMID +'ACCTRAN'') DROP TABLE TEMPTABLEDB..TEMP'+ @SYSTEMID +'ACCTRAN                      '"
            strSql += vbCrLf + "      PRINT @QUERY"
            strSql += vbCrLf + "      EXEC (@QUERY)"
            strSql += vbCrLf + "      DECLARE @CHKFROMFLAG VARCHAR(1) "
            strSql += vbCrLf + "      SELECT @CHKFROMFLAG =CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_CASHABS_CASH' "
            strSql += vbCrLf + "  	 DECLARE @PURATE VARCHAR(1) "
            strSql += vbCrLf + "  	 SELECT @PURATE =CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_CASHABS_RATE'"
            strSql += vbCrLf + "      SELECT @QUERY= 'CREATE TABLE  TEMPTABLEDB..TEMP'+ @SYSTEMID +'COMPANY (COMPANYID VARCHAR(3))   '"
            strSql += vbCrLf + " 	 PRINT @QUERY"
            strSql += vbCrLf + "      EXEC (@QUERY)"
            strSql += vbCrLf + "      DECLARE @TCOMPANY VARCHAR(50) "
            strSql += vbCrLf + "      IF CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "      BEGIN"
            strSql += vbCrLf + "      	SELECT @QUERY= 'INSERT INTO  TEMPTABLEDB..TEMP'+ @SYSTEMID +'COMPANY (COMPANYID) SELECT '''+@COMPANYID +''''"
            strSql += vbCrLf + " 		PRINT @QUERY"
            strSql += vbCrLf + " 		EXEC (@QUERY)"
            strSql += vbCrLf + "      END"
            strSql += vbCrLf + "      WHILE CHARINDEX(',',@COMPANYID)>0   "
            strSql += vbCrLf + "      BEGIN"
            strSql += vbCrLf + "      	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)   "
            strSql += vbCrLf + "      	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))   "
            strSql += vbCrLf + "      	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "      	BEGIN"
            strSql += vbCrLf + "      		SET @COMPANYID= @COMPANYID + ','   "
            strSql += vbCrLf + "      	END"
            strSql += vbCrLf + "      	SELECT @QUERY= 'INSERT INTO  TEMPTABLEDB..TEMP'+ @SYSTEMID +'COMPANY (COMPANYID) SELECT '''+@TCOMPANY +''''"
            strSql += vbCrLf + " 		PRINT @QUERY"
            strSql += vbCrLf + " 		EXEC (@QUERY)  "
            strSql += vbCrLf + "      END"
