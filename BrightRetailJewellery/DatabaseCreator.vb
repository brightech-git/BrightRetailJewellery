        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.TRANMODE=''D'' AND A.PAYMODE=''CA'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CRECEIVED'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.TRANMODE=''C'' AND A.PAYMODE=''CA'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CPAID'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''AA'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS ADVANCE ,CASE WHEN A.PAYMODE=''DU''   THEN SUM(ISNULL(A.AMOUNT,0)) END AS CREDIT'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''CH'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CHEQUE,CASE WHEN A.PAYMODE=''CC'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CREDITCARD'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''SS'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CHIT,CASE WHEN A.PAYMODE=''DI'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS DISCOUNT'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''CA'' THEN SUM(CASE WHEN A.TRANMODE=''D'' THEN ISNULL(A.AMOUNT,0) WHEN A.TRANMODE=''C'' THEN (-1)*ISNULL(A.AMOUNT,0) END) END AS NETCASH'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,U.USERNAME ,''P'' COLHEAD ,''4'' RESULT,A.BATCHNO,A.USERID,SUM(A.AMOUNT)  FROM '+@DBNAME+'..ACCTRAN A '"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' LEFT JOIN USERMASTER AS U ON A.USERID=U.USERID'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' WHERE A.PAYMODE IN(''SA'',''PU'',''AA'',''CH'',''SS'',''CA'',''CC'',''DI'',''DU'',''SR'') '"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' AND BATCHNO IN (SELECT DISTINCT BATCHNO FROM '+@DBNAME+'..ISSUE WHERE TRANDATE BETWEEN '''+ @FROMDATE+''' AND '''+ @TODATE +''''"
