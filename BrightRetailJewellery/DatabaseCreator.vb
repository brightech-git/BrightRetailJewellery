        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) < 0 THEN SUM(OCREDIT)-SUM(ODEBIT) ELSE 0 END AS OCREDIT    '"
        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) > 0 THEN SUM(TDEBIT)-SUM(TCREDIT) ELSE 0 END AS TDEBIT    '"
        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) < 0 THEN SUM(TCREDIT)-SUM(TDEBIT) ELSE 0 END AS TCREDIT    '"
        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) > 0 THEN SUM(CDEBIT)-SUM(CCREDIT) ELSE 0 END AS CDEBIT    '"
        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) < 0 THEN SUM(CCREDIT)-SUM(CDEBIT) ELSE 0 END AS CCREDIT   ' "
        strSql += vbCrLf & " 			SELECT @QRY=@QRY+CHAR(13)+'FROM TEMPTABLEDB..TRAILBAL_B'+@SYSID+' WHERE RESULT = 1 GROUP BY ACGRPNAME ,DISPORDER,TEMPACGRPNAME    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'END    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'/** INSERT INTO GRANDTOTTAL_1 **/    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'INSERT INTO TEMPTABLEDB..TRAILBAL_B'+@SYSID+'(PARTICULAR,ACGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'SELECT ''GRAND TOTAL'',''ZZZZZ'',4 RESULT,9999 DISPORDER,''G'' COLHEAD,SUM(ODEBIT),SUM(OCREDIT),SUM(TDEBIT)'"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',SUM(TCREDIT),SUM(CDEBIT),SUM(CCREDIT) FROM TEMPTABLEDB..TRAILBAL_B'+@SYSID+' WHERE RESULT = 1    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'/** INSERT INTO GRANDTOTAL_2 **/    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'INSERT INTO TEMPTABLEDB..TRAILBAL_B'+@SYSID+'(PARTICULAR,ACGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'SELECT ''GRAND DIFF'',''ZZZZZZZ'',5 RESULT,99999 DISPORDER,''G'' COLHEAD    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) > 0 THEN SUM(ODEBIT)-SUM(OCREDIT) ELSE 0 END AS ODEBIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) < 0 THEN SUM(OCREDIT)-SUM(ODEBIT) ELSE 0 END AS OCREDIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) > 0 THEN SUM(TDEBIT)-SUM(TCREDIT) ELSE 0 END AS TDEBIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) < 0 THEN SUM(TCREDIT)-SUM(TDEBIT) ELSE 0 END AS TCREDIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) > 0 THEN SUM(CDEBIT)-SUM(CCREDIT) ELSE 0 END AS CDEBIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) < 0 THEN SUM(CCREDIT)-SUM(CDEBIT) ELSE 0 END AS CCREDIT    '"
        strSql += vbCrLf & " 		SELECT @QRY=@QRY+CHAR(13)+'FROM TEMPTABLEDB..TRAILBAL_B'+@SYSID+' WHERE RESULT = 1     '"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+'END    '"
        strSql += vbCrLf & " 	PRINT(@QRY)"
        strSql += vbCrLf & " 	EXEC (@QRY)"
        strSql += vbCrLf & " 	SET @QRY = ' UPDATE TEMPTABLEDB..TRAILBAL_B'+@SYSID+' SET    '"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+'ODEBIT = CASE WHEN ODEBIT = 0 THEN NULL ELSE ODEBIT END'"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+',OCREDIT = CASE WHEN OCREDIT = 0 THEN NULL ELSE OCREDIT END'"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+',TDEBIT = CASE WHEN TDEBIT = 0 THEN NULL ELSE TDEBIT END'"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+',TCREDIT = CASE WHEN TCREDIT = 0 THEN NULL ELSE TCREDIT END'"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+',CDEBIT = CASE WHEN CDEBIT = 0 THEN NULL ELSE CDEBIT END'"
        strSql += vbCrLf & " 	SELECT @QRY=@QRY+CHAR(13)+',CCREDIT = CASE WHEN CCREDIT = 0 THEN NULL ELSE CCREDIT END'"
        strSql += vbCrLf & " 	EXEC(@QRY)"
        strSql += vbCrLf & " 	SET @QRY = ' SELECT * FROM TEMPTABLEDB..TRAILBAL_B'+@SYSID+' WHERE 1=1  '"
        strSql += vbCrLf & " 	IF @DISPCOL <> 'Z' "
        strSql += vbCrLf & " 	BEGIN"
        strSql += vbCrLf & " 		SET @QRY = @QRY + '  AND NOT('"
        strSql += vbCrLf & " 		IF CHARINDEX('O',@DISPCOL) <> 0"
        strSql += vbCrLf & " 		BEGIN"
        strSql += vbCrLf & " 		SET @QRY = @QRY + ' ISNULL(ODEBIT,0) = 0 AND ISNULL(OCREDIT,0) = 0 AND'"
        strSql += vbCrLf & " 		END"
        strSql += vbCrLf & " 		IF CHARINDEX('T',@DISPCOL) <> 0"
        strSql += vbCrLf & " 		BEGIN"
        strSql += vbCrLf & " 			SET @QRY = @QRY + ' ISNULL(TDEBIT,0) = 0 AND ISNULL(TCREDIT,0) = 0 AND'"
        strSql += vbCrLf & " 		END"
        strSql += vbCrLf & " 		SET @QRY = @QRY + ' ISNULL(CDEBIT,0) = 0 AND ISNULL(CCREDIT,0) = 0 AND ISNULL(COLHEAD,'''') = '''''"
        strSql += vbCrLf & " 		SET @QRY = @QRY + ')  	'"
        strSql += vbCrLf & " 	END"
        strSql += vbCrLf & " 	SET @QRY = @QRY + 'ORDER BY DISPORDER,ACGRPNAME,RESULT,PARTICULAR'"
        strSql += vbCrLf & " 	EXEC(@QRY)"
        strSql += vbCrLf & " END"
        cmd = New OleDbCommand(strSql, cn, tran)
