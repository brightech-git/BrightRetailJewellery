    Private Sub SP_RPT_ACCSUBDYLEDG()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ACCSUBDYLEDG')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ACCSUBDYLEDG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_ACCSUBDYLEDG"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(15) "
        strSql += vbCrLf + ",@TEMPTAB VARCHAR(50)"
        strSql += vbCrLf + ",@FROMDATE VARCHAR(12)"
        strSql += vbCrLf + ",@TODATE VARCHAR(12)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(50)    "
        strSql += vbCrLf + ",@COSTID VARCHAR(50)"
        strSql += vbCrLf + ",@SUBDYLEDG VARCHAR(50)"
        strSql += vbCrLf + ",@ACCODE VARCHAR(100)"
        strSql += vbCrLf + ",@WITHCANCEL VARCHAR(1) "
        strSql += vbCrLf + ")  "
        strSql += vbCrLf + "AS   "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @TTEMPTAB VARCHAR(50)  "
        strSql += vbCrLf + "	DECLARE @TTMPTAB VARCHAR(50)  "
        strSql += vbCrLf + "	SET @ACCODE = REPLACE(@ACCODE,',',''',''') "
        strSql += vbCrLf + "	SET @TTEMPTAB = @TEMPTAB+'0'  "
        strSql += vbCrLf + "	SET @TTMPTAB = @TEMPTAB+'1'  "
        strSql += vbCrLf + "	SET @TEMPTAB = 'TEMPTABLEDB..'+@TTEMPTAB  "
        strSql += vbCrLf + "	DECLARE @TMPTAB VARCHAR(50)  "
        strSql += vbCrLf + "	SET @TMPTAB = 'TEMPTABLEDB..'+@TTMPTAB  "
        strSql += vbCrLf + "	DECLARE @QRY NVARCHAR(4000)   "
        strSql += vbCrLf + "	SET @QRY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '+''''+@TTEMPTAB+''''+' ) DROP TABLE ' + @TEMPTAB    "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY   "
        strSql += vbCrLf + "	SET @QRY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '+''''+@TTMPTAB+''''+' ) DROP TABLE ' + @TMPTAB    "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY   "
        strSql += vbCrLf + "	SET @QRY = ''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT TRANDATE,TRANNO,'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' (SELECT CONVERT(VARCHAR(110),ACNAME) FROM ACHEAD WHERE ACCODE = A.ACCODE) AS ACNAME,'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' CASE WHEN TRANMODE = ''D'' THEN AMOUNT END DEBIT,'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' CASE WHEN TRANMODE = ''C'' THEN AMOUNT END CREDIT,'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' REMARK1,REMARK2,''1'' AS RESULT,TRANDATE AS TTRANDATE,TRANNO AS TTRANNO'"
        strSql += vbCrLf + "	SET @QRY = @QRY +' ,CONVERT(VARCHAR(1),CANCEL)CANCEL '"
        strSql += vbCrLf + "	SET @QRY = @QRY +' INTO '+@TEMPTAB+' '"
        strSql += vbCrLf + "	SET @QRY = @QRY +' FROM '+@DBNAME+'..ACCTRAN A WHERE 1=1'  "
        strSql += vbCrLf + "	IF @SUBDYLEDG<>'ALL'"
        strSql += vbCrLf + "		SET @QRY = @QRY +' AND PAYMODE = '''+@SUBDYLEDG+'''' "
        strSql += vbCrLf + "	IF @WITHCANCEL<>'Y'"
        strSql += vbCrLf + "		SET @QRY = @QRY +' AND ISNULL(CANCEL,'''') <> ''Y'''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' AND FROMFLAG=''A'' '"
        strSql += vbCrLf + "	SET @QRY = @QRY +' AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' AND COMPANYID IN ('''+@COMPANYID+''')'  "
        strSql += vbCrLf + "	IF @COSTID <> '' "
        strSql += vbCrLf + "		SET @QRY = @QRY +' AND A.COSTID IN ('''+@COSTID+''')'  "
        strSql += vbCrLf + "	IF @ACCODE <>'' "
        strSql += vbCrLf + "		SET  @QRY=@QRY+' AND A.ACCODE IN ('''+@ACCODE+''') '  "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY  "
        strSql += vbCrLf + "	SET @QRY = 'INSERT INTO '+@TEMPTAB+' (TRANDATE,TRANNO,ACNAME,RESULT,TTRANDATE,TTRANNO)'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +'SELECT DISTINCT NULL TRANDATE,NULL TRANNO,''  ''+ACNAME,RESULT,TTRANDATE,TTRANNO'"
        strSql += vbCrLf + "	SET @QRY = @QRY +' FROM ('  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT TRANDATE,TRANNO,REMARK1 AS ACNAME,''1'' RESULT,TRANDATE TTRANDATE,TRANNO TTRANNO FROM '+@TEMPTAB+' WHERE ISNULL(REMARK1,'''') <> '''''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' UNION ALL'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT TRANDATE,TRANNO,REMARK2 AS ACNAME,''1'' RESULT,TRANDATE TTRANDATE,TRANNO TTRANNO FROM '+@TEMPTAB+' WHERE ISNULL(REMARK2,'''') <> '''''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' UNION ALL'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT TRANDATE,TRANNO,'''' AS ACNAME,''1'' RESULT,TRANDATE TTRANDATE,TRANNO TTRANNO FROM '+@TEMPTAB+''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +') A'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT TRANDATE,TRANNO,ACNAME,DEBIT,CREDIT,RESULT,TTRANDATE,TTRANNO,ISNULL(CANCEL,'''')CANCEL INTO '+@TMPTAB+' FROM '+@TEMPTAB  "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY  "
        strSql += vbCrLf + "	SET @QRY = ''  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' INSERT INTO '+@TMPTAB+' (TRANDATE,TRANNO,ACNAME,DEBIT,CREDIT,RESULT,TTRANDATE,TTRANNO,CANCEL)'  "
        strSql += vbCrLf + "	SET @QRY = @QRY +' SELECT NULL TRANDATE,NULL TRANNO,''TOTAL ...'' AS ACNAME,ISNULL(SUM(DEBIT),0)'"
        strSql += vbCrLf + "	SET @QRY = @QRY +' ,ISNULL(SUM(CREDIT),0),''2'',NULL TTRANDATE,NULL TTRANNO,'''' '"
        strSql += vbCrLf + "	SET @QRY = @QRY +' FROM '+@TEMPTAB +' WHERE ISNULL(CANCEL,'''')<>''Y'''  "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY  "
        strSql += vbCrLf + "	SET @QRY = 'DROP TABLE '+@TEMPTAB  "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY  "
        strSql += vbCrLf + "	SET @QRY = 'SELECT CONVERT(VARCHAR(12),TRANDATE,103) AS [VOU DATE],TRANNO AS [VOU NO],ACNAME AS PARTICULAR'"
        strSql += vbCrLf + "	SET @QRY = @QRY +' ,DEBIT,CREDIT,CANCEL '"
        strSql += vbCrLf + "	SET @QRY = @QRY +' FROM '+@TMPTAB+' ORDER BY RESULT,TTRANDATE,TTRANNO,DEBIT DESC,CREDIT DESC'  "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
