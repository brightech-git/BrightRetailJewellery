        strSql += vbCrLf + "  	    BEGIN  "
        strSql += vbCrLf + "  	    SET NOCOUNT ON  "
        strSql += vbCrLf + "  	    DECLARE @QRY VARCHAR(8000) -- 	 PROVIDE FOR THE WHOLE QUERY,YOU MAY INCREASE THE SIZE      "
        strSql += vbCrLf + "  	    DECLARE @STRING VARCHAR(8000) --  	FOR STORING THE FIRST HALF OF INSERT STATEMENT     "
        strSql += vbCrLf + "  	    DECLARE @STRINGDATA VARCHAR(8000) --  	FOR STORING THE DATA (VALUES) RELATED STATEMENT      "
        strSql += vbCrLf + "  	    DECLARE @DATATYPE VARCHAR(1000) -- 	DATA TYPES RETURNED FOR RESPECTIVE COLUMNS    "
        strSql += vbCrLf + "  	    DECLARE @COLNAME VARCHAR(50) "
        strSql += vbCrLf + "  	    IF @MASK_TABLENAME = '' SELECT @MASK_TABLENAME = @TABLENAME  "
        strSql += vbCrLf + "  	    DECLARE CURSCOL CURSOR FAST_FORWARD FOR      "
        strSql += vbCrLf + "  	    SELECT B.NAME, C.NAME  "
        strSql += vbCrLf + "  	    FROM SYSOBJECTS A, SYSCOLUMNS B, SYSTYPES C      "
        strSql += vbCrLf + "  	    WHERE A.ID = B.ID AND B.XTYPE = C.XTYPE AND C.NAME NOT IN('SYSNAME') AND     "
        strSql += vbCrLf + "  	    A.NAME = @TABLENAME      "
        strSql += vbCrLf + "  	    OPEN CURSCOL      "
        strSql += vbCrLf + "  	    SELECT @STRING = ''  "
        strSql += vbCrLf + "  	    SELECT @STRINGDATA = ''  "
        strSql += vbCrLf + "  	    SELECT @DATATYPE = ''  "
        strSql += vbCrLf + "  	    SET @STRING='INSERT INTO '+@DBNAME + '..'+@MASK_TABLENAME+'('      "
        strSql += vbCrLf + "  	    SET @STRINGDATA=''      "
        strSql += vbCrLf + "  	    SELECT @COLNAME = ''  "

        strSql += vbCrLf + "  	    FETCH NEXT FROM CURSCOL INTO @COLNAME,@DATATYPE  "
        strSql += vbCrLf + "  	    IF @@FETCH_STATUS<>0      "
        strSql += vbCrLf + "  	        BEGIN      "
        strSql += vbCrLf + "  	        DECLARE @ERRMSG VARCHAR(100)  "
        strSql += vbCrLf + "  	        SET @ERRMSG = 'Table '+@tableName+' not found, processing skipped.'  "
        strSql += vbCrLf + "  	    -- RAISERROR (@ERRMSG, 16, 1)  "
        strSql += vbCrLf + "  	        CLOSE CURSCOL      "
        strSql += vbCrLf + "  	        DEALLOCATE CURSCOL      "
        strSql += vbCrLf + "  	        RETURN @errmsg    "
        strSql += vbCrLf + "  	    END      "
        strSql += vbCrLf + "  	    WHILE @@FETCH_STATUS=0      "
        strSql += vbCrLf + "  	     BEGIN      "
        strSql += vbCrLf + "  	     IF @DATATYPE IN ('VARCHAR','CHAR','NCHAR','NVARCHAR')      "
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''''''''+ ISNULL('+@COLNAME+','''')+'''''',''+'      "
        strSql += vbCrLf + "  	     ELSE IF @DATATYPE IN ('TEXT','NTEXT') --	IF THE DATATYPE   	IS TEXT OR SOMETHING ELSE"
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''''''''+ ISNULL(CAST('+@COLNAME+' AS VARCHAR(2000)),'''')+'''''',''+'      "
        strSql += vbCrLf + "  	     ELSE IF @DATATYPE = 'MONEY' --  	BECAUSE MONEY DOESN'T GET CONVERTED  -- 	FROM VARCHAR IMPLICITLY      "
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''CONVERT(MONEY,''''''+ ISNULL(CAST('+@COLNAME+' AS VARCHAR(200)),''0.0000'')+''''''),''+'      "
        strSql += vbCrLf + "  	     ELSE IF @DATATYPE='DATETIME'      "
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''CONVERT(DATETIME,''''''+ ISNULL(CAST('+@COLNAME+' AS VARCHAR(200)),''NULL'')+''''''),''+'      "
        strSql += vbCrLf + "  	     ELSE IF @DATATYPE='SMALLDATETIME'      "
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''CONVERT(SMALLDATETIME,''''''+ ISNULL(CAST('+@COLNAME+' AS VARCHAR(200)),''NULL'')+''''''),''+'      "
        strSql += vbCrLf + "  	     ELSE IF @DATATYPE='IMAGE'"
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''''''''+ ISNULL(CAST(CONVERT(VARBINARY,'+@COLNAME+') AS VARCHAR(6)),''0'')+'''''',''+'      "
        strSql += vbCrLf + "  	     ELSE --	PRESUMING THE DATA TYPE IS INT,BIT,NUMERIC,DECIMAL"
        strSql += vbCrLf + "  	     SET @STRINGDATA=@STRINGDATA+'''''''''+ ISNULL(CAST('+@COLNAME+' AS VARCHAR(200)),''0'')+'''''',''+'      "
        strSql += vbCrLf + "  	     SET @STRING=@STRING+@COLNAME+','  "
        strSql += vbCrLf + "  	     FETCH NEXT FROM CURSCOL INTO @COLNAME,@DATATYPE      "
        strSql += vbCrLf + "  	     END    "
        strSql += vbCrLf + "  	      DECLARE @query  NVARCHAR(4000)"
        strSql += vbCrLf + "  	      SET @query = ' IF  EXISTS (SELECT * FROM sysobjects WHERE xtype = ''U'' AND NAME = '"
        strSql += vbCrLf + "  	      +''''+@TEMPTABLE+''''+' ) DROP TABLE ' + @TEMPTABLE "
        strSql += vbCrLf + "  	      EXECUTE sp_executesql @query"
        strSql += vbCrLf + "  	    SET @query = 'CREATE TABLE ' + @TEMPTABLE+  '(SQLTEXT VARCHAR(8000)'"
        strSql += vbCrLf + "  	     select @query = @query + ') ON [PRIMARY]'"
        strSql += vbCrLf + "  	    EXECUTE sp_executesql @query"


        strSql += vbCrLf + "  	    SET @QRY ='INSERT INTO '+@TEMPTABLE+'(SQLTEXT) SELECT REPLACE('''+SUBSTRING(@STRING,0,LEN(@STRING)) + ')"
        strSql += vbCrLf + "  	        VALUES(''+ ' + substring(@stringData,0,len(@stringData)-2) +'''+'')'',''NULL'',''NULL'') AS SQLTEXT  "
        strSql += vbCrLf + "  	        FROM '+@TABLENAME      "
        strSql += vbCrLf + "  	     EXEC(@QRY)  "

        strSql += vbCrLf + "  	    CLOSE CURSCOL      "
        strSql += vbCrLf + "  	    DEALLOCATE CURSCOL "

        strSql += vbCrLf + "  	    SET @QRY ='UPDATE '+@TEMPTABLE+' SET SQLTEXT = REPLACE(SQLTEXT,''''''NULL'''''',''NULL'') '"
        strSql += vbCrLf + "  	    EXEC(@QRY)  "
        strSql += vbCrLf + "  	  END   "

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()


    End Sub
    Private Sub funcSp32GET_SNO_SOFTCONTROLTRAN()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='GET_SNO_SOFTCONTROLTRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE GET_SNO_SOFTCONTROLTRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE GET_SNO_SOFTCONTROLTRAN"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  @COSTID VARCHAR(2)"
        strSql += vbCrLf + "  ,@CTLID VARCHAR(150)"
        strSql += vbCrLf + "  ,@CHECKTABLENAME VARCHAR(200)"
        strSql += vbCrLf + "  ,@RETVALUE VARCHAR(50) OUTPUT"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET NOCOUNT ON"
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "  DECLARE @SNO VARCHAR(15)"
        strSql += vbCrLf + "  DECLARE @TSNO INT"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#CHECKSNO', 'U') IS NOT NULL DROP TABLE #CHECKSNO"
        strSql += vbCrLf + "  CREATE TABLE #CHECKSNO (SNO VARCHAR(15))"
        strSql += vbCrLf + "  WHILE 1=1"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  	WHILE 1=1"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		SELECT @TSNO = ISNULL(CONVERT(INT,CTLTEXT),0) FROM " & tranDbName & "..SOFTCONTROLTRAN WHERE CTLID = @CTLID"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..SOFTCONTROLTRAN SET CTLTEXT = @TSNO+1 WHERE CTLID = @CTLID AND CTLTEXT = @TSNO"
        strSql += vbCrLf + "  		IF (SELECT @@ROWCOUNT) > 0 BREAK"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	SELECT @SNO = @COSTID + CONVERT(VARCHAR,@TSNO+1)"
        strSql += vbCrLf + "  	SELECT @QRY = ' INSERT INTO #CHECKSNO(SNO) SELECT SNO FROM " & tranDbName & "..'+@CHECKTABLENAME+ ' WHERE SNO = '''+ @SNO + ''''"
        strSql += vbCrLf + "  	EXEC (@QRY)"
        strSql += vbCrLf + "  	IF NOT (SELECT COUNT(*) FROM #CHECKSNO)>0 BREAK"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  SELECT @RETVALUE = CONVERT(VARCHAR(50),@SNO)"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_TAGWISEPROFIT_VALADDED()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFIT_VALADDED')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGWISEPROFIT_VALADDED"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_TAGWISEPROFIT_VALADDED"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME "
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME "
        strSql += vbCrLf + " ,@TRANNO INT = 0 "
        strSql += vbCrLf + " ,@PURRATE VARCHAR(1)"
        strSql += vbCrLf + " ,@METALID VARCHAR(100)     "
        strSql += vbCrLf + " ,@CATCODE VARCHAR(1000) "
        strSql += vbCrLf + " ,@ITEMIDS VARCHAR(500)"
        strSql += vbCrLf + " ,@DESIGNERIDS VARCHAR(200)"
        strSql += vbCrLf + " ) "
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " BEGIN "
        strSql += vbCrLf + " SET NOCOUNT ON "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMPVIEWPROFIT') IS NOT NULL  DROP TABLE MASTER..TEMPVIEWPROFIT "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(8000) "
        strSql += vbCrLf + " DECLARE @QRY1 VARCHAR(8000) "
        strSql += vbCrLf + " DECLARE @ITEMFILTER VARCHAR(1000)"
        strSql += vbCrLf + " DECLARE @DESFILTER VARCHAR(1000)"
        strSql += vbCrLf + " SET @DESIGNERIDS = REPLACE(@DESIGNERIDS,',',''',''')     "
        strSql += vbCrLf + " SET @METALID = REPLACE(@METALID,',',''',''')    "
        strSql += vbCrLf + " SET @CATCODE = REPLACE(@CATCODE,',',''',''')  "

        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ITEMIDS') IS NOT NULL DROP TABLE #ITEMIDS   "
        strSql += vbCrLf + " CREATE TABLE #ITEMIDS(ITEMID INT) "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#DESIGNERS') IS NOT NULL DROP TABLE #DESIGNERS  "
        strSql += vbCrLf + " CREATE TABLE #DESIGNERS(DESIGNERID INT)    "
        strSql += vbCrLf + " SET @ITEMFILTER='' /** ITEM FILTER**/   "
        strSql += vbCrLf + " SET @ITEMFILTER= @ITEMFILTER +' I.ITEMID IN(SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE ISNULL(STOCKREPORT,'''')<>''N'' )'  "
        strSql += vbCrLf + " IF @METALID <> '' SET @ITEMFILTER= @ITEMFILTER +' AND I.ITEMID IN(SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE METALID IN('''+@METALID+'''))'  "
        strSql += vbCrLf + " IF @CATCODE <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND I.ITEMID IN(SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE CATCODE IN('''+@CATCODE +'''))'  "
        strSql += vbCrLf + " IF @ITEMIDS <> '' SET @ITEMFILTER= @ITEMFILTER + ' AND I.ITEMID IN('+@ITEMIDS+')'  "
        strSql += vbCrLf + " SET @QRY = ''    "
        strSql += vbCrLf + " SELECT @QRY=' INSERT INTO #ITEMIDS(ITEMID) SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST I WHERE '+@ITEMFILTER"
        strSql += vbCrLf + " IF @DESIGNERIDS <> 'ALL' SELECT @QRY =@QRY+' INSERT INTO #DESIGNERS(DESIGNERID) SELECT DESIGNERID FROM " & cnAdminDb & "..DESIGNER WHERE  DESIGNERID IN ('''+@DESIGNERIDS+''')' "
        strSql += vbCrLf + " PRINT @QRY  "
        strSql += vbCrLf + " EXEC(@QRY) "

        strSql += vbCrLf + " SET @ITEMFILTER='' /** DESIGNER FILTER**/   "
        strSql += vbCrLf + " SET @ITEMFILTER=  ' AND T.ITEMID IN(SELECT ITEMID FROM #ITEMIDS) '  "

        strSql += vbCrLf + " SET @DESFILTER='' /** DESIGNER FILTER**/   "
        strSql += vbCrLf + " IF @DESIGNERIDS <> '' SET @DESFILTER= @DESFILTER + ' AND T.DESIGNERID IN(SELECT DESIGNERID FROM #DESIGNERS)'  "

        strSql += vbCrLf + " SET @QRY = ' SELECT "
        strSql += vbCrLf + " IM.ITEMNAME,SM.SUBITEMNAME,I.TRANNO,I.TRANDATE,I.ITEMID,I.SUBITEMID,I.GRSNET,I.TAGNO,I.PCS,I.GRSWT,I.NETWT "
        strSql += vbCrLf + " ,(SELECT SUM(STNPCS) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAPCS "
        strSql += vbCrLf + " ,(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAWT "
        strSql += vbCrLf + " ,(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAAMT "
        strSql += vbCrLf + " ,(SELECT DESIGNERNAME FROM " & cnAdminDb & "..DESIGNER WHERE DESIGNERID = I.TAGDESIGNER) AS DESIGNER "
        strSql += vbCrLf + " ,I.TOUCH,I.WASTAGE,I.MCHARGE,I.AMOUNT,I.TAGDESIGNER,I.ITEMTYPEID,I.TABLECODE "
        strSql += vbCrLf + " ,IM.VALUEADDEDTYPE AS VALADDTYPE "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL) WMAXWASTPER_PUR ,CONVERT(NUMERIC(15,2),NULL) WMAXMCGRM_PUR "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),NULL) WMAXWAST_PUR,CONVERT(NUMERIC(15,2),NULL) WMAXMC_PUR,CONVERT(NUMERIC(15,2),NULL) WTOUCH_PUR "
        strSql += vbCrLf + " ,I.COSTID,I.COMPANYID "
        strSql += vbCrLf + " ,CASE WHEN I.SUBITEMID > 0 THEN SM.CALTYPE ELSE IM.CALTYPE END CALTYPE "
        strSql += vbCrLf + " ,I.RATE,I.BATCHNO "
        strSql += vbCrLf + " ,CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END GRSNETWT "
        strSql += vbCrLf + " ,PT.PURRATE,PT.PURMC,(SELECT SUM(STNAMT) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = T.SNO) PURSTNAMT "
        strSql += vbCrLf + " ,CONVERT(INT,1) SEP,PT.PURWASTAGE"
        strSql += vbCrLf + " INTO MASTER..TEMPVIEWPROFIT "
        strSql += vbCrLf + " FROM ISSUE AS I "
        strSql += vbCrLf + " INNER JOIN " & cnAdminDb & "..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..SUBITEMMAST AS SM ON SM.ITEMID = I.ITEMID AND SM.SUBITEMID = I.SUBITEMID "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..ITEMTAG AS T ON T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO AND T.BATCHNO = I.BATCHNO "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..PURITEMTAG AS PT ON PT.TAGSNO = T.SNO "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN '''+CONVERT(VARCHAR,@FROMDATE,101)+''' AND '''+CONVERT(VARCHAR,@TODATE,101)+''' AND ISNULL(I.CANCEL,'''') = ''''"
        strSql += vbCrLf + " AND ISNULL(I.TRANTYPE,'''') IN (''SA'',''OD'') ' "
        strSql += vbCrLf + " + @ITEMFILTER  "
        strSql += vbCrLf + " + @DESFILTER  "
        strSql += vbCrLf + " IF @TRANNO <> 0 "
        strSql += vbCrLf + " SET @QRY = @QRY + ' AND I.TRANNO = ' + CONVERT(vARCHAR,@TRANNO) "
        strSql += vbCrLf + " SET @QRY = @QRY + '  UNION ALL	"
        strSql += vbCrLf + " SELECT "
        strSql += vbCrLf + " IM.ITEMNAME,SM.SUBITEMNAME,I.TRANNO,I.TRANDATE,I.ITEMID,I.SUBITEMID,I.GRSNET,I.TAGNO,I.PCS,I.GRSWT,I.NETWT "
        strSql += vbCrLf + " ,(SELECT SUM(STNPCS) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAPCS "
        strSql += vbCrLf + " ,(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAWT "
        strSql += vbCrLf + " ,(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAAMT "
        strSql += vbCrLf + " ,(SELECT DESIGNERNAME FROM " & cnAdminDb & "..DESIGNER WHERE DESIGNERID = I.TAGDESIGNER) AS DESIGNER   "
        strSql += vbCrLf + " ,I.TOUCH,I.WASTAGE,i.MCHARGE,I.AMOUNT,I.TAGDESIGNER,I.ITEMTYPEID,I.TABLECODE    "
        strSql += vbCrLf + " ,IM.VALUEADDEDTYPE AS VALADDTYPE "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL) WMAXWASTPER_PUR ,CONVERT(NUMERIC(15,2),NULL) WMAXMCGRM_PUR "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),NULL) WMAXWAST_PUR,CONVERT(NUMERIC(15,2),NULL) WMAXMC_PUR,CONVERT(NUMERIC(15,2),NULL) WTOUCH_PUR "
        strSql += vbCrLf + " ,I.COSTID,I.COMPANYID "
        strSql += vbCrLf + " ,CASE WHEN I.SUBITEMID > 0 THEN SM.CALTYPE ELSE IM.CALTYPE END CALTYPE "
        strSql += vbCrLf + " ,I.RATE,I.BATCHNO "
        strSql += vbCrLf + " ,CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END GRSNETWT    "
        strSql += vbCrLf + " ,PT.PURRATE,PT.PURMC,(SELECT SUM(STNAMT) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = T.SNO) PURSTNAMT "
        strSql += vbCrLf + " ,CONVERT(INT,2) SEP,PT.PURWASTAGE"
        strSql += vbCrLf + " FROM RECEIPT AS I "
        strSql += vbCrLf + " INNER JOIN " & cnAdminDb & "..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..SUBITEMMAST AS SM ON SM.ITEMID = I.ITEMID AND SM.SUBITEMID = I.SUBITEMID "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..ITEMTAG AS T ON T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO AND T.BATCHNO = I.BATCHNO "
        strSql += vbCrLf + " LEFT JOIN " & cnAdminDb & "..PURITEMTAG AS PT ON PT.TAGSNO = T.SNO "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN '''+CONVERT(VARCHAR,@FROMDATE,101)+''' AND '''+CONVERT(VARCHAR,@TODATE,101)+''' AND ISNULL(I.CANCEL,'''') = '''' "
        strSql += vbCrLf + " AND ISNULL(I.TRANTYPE,'''') IN (''SR'') ' "
        strSql += vbCrLf + " + @ITEMFILTER  "
        strSql += vbCrLf + " + @DESFILTER  "
        strSql += vbCrLf + " IF @TRANNO <> 0 "
        strSql += vbCrLf + " SET @QRY = @QRY + ' AND I.TRANNO = ' + CONVERT(vARCHAR,@TRANNO) "
        strSql += vbCrLf + " SET @QRY1 = '"
        strSql += vbCrLf + " /* TABLE CODE */"
        strSql += vbCrLf + " UPDATE MASTER..TEMPVIEWPROFIT SET WMAXWASTPER_PUR = MAXWASTPER_PUR,WMAXMCGRM_PUR = MAXMCGRM_PUR,WMAXWAST_PUR = MAXWAST_PUR "
        strSql += vbCrLf + " ,WMAXMC_PUR = MAXMC_PUR,WTOUCH_PUR = TOUCH_PUR "
        strSql += vbCrLf + " FROM MASTER..TEMPVIEWPROFIT AS T INNER JOIN " & cnAdminDb & "..WMCTABLE AS W "
        strSql += vbCrLf + " ON ISNULL(T.TABLECODE,'''') = ISNULL(W.TABLECODE,'''') "
        strSql += vbCrLf + " AND CASE WHEN GRSNET = ''G'' THEN GRSWT ELSE NETWT END BETWEEN W.FROMWEIGHT AND W.TOWEIGHT "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'''') = ISNULL(W.COSTID,'''') "
        strSql += vbCrLf + " WHERE ISNULL(W.ACCODE,'''') = '''' AND T.VALADDTYPE = ''T''"
        strSql += vbCrLf + " /* ITEM */ "
        strSql += vbCrLf + " UPDATE MASTER..TEMPVIEWPROFIT SET WMAXWASTPER_PUR = MAXWASTPER_PUR,WMAXMCGRM_PUR = MAXMCGRM_PUR,WMAXWAST_PUR = MAXWAST_PUR "
        strSql += vbCrLf + " ,WMAXMC_PUR = MAXMC_PUR,WTOUCH_PUR = TOUCH_PUR "
        strSql += vbCrLf + " FROM MASTER..TEMPVIEWPROFIT AS T INNER JOIN " & cnAdminDb & "..WMCTABLE AS W "
        strSql += vbCrLf + " ON ISNULL(T.ITEMID,'''') = ISNULL(W.ITEMID,'''') AND ISNULL(T.SUBITEMID,'''') = ISNULL(W.SUBITEMID,'''') "
        strSql += vbCrLf + " AND CASE WHEN GRSNET = ''G'' THEN GRSWT ELSE NETWT END BETWEEN W.FROMWEIGHT AND W.TOWEIGHT "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'''') = ISNULL(W.COSTID,'''') "
        strSql += vbCrLf + " WHERE ISNULL(W.ACCODE,'''') = '''' AND ISNULL(W.TABLECODE,'''') = '''' AND T.VALADDTYPE = ''I'' "
        strSql += vbCrLf + " /* DESIGNER */ "
        strSql += vbCrLf + " UPDATE MASTER..TEMPVIEWPROFIT SET WMAXWASTPER_PUR = MAXWASTPER_PUR,WMAXMCGRM_PUR = MAXMCGRM_PUR,WMAXWAST_PUR = MAXWAST_PUR "
        strSql += vbCrLf + " ,WMAXMC_PUR = MAXMC_PUR,WTOUCH_PUR = TOUCH_PUR "
        strSql += vbCrLf + " FROM MASTER..TEMPVIEWPROFIT AS T INNER JOIN " & cnAdminDb & "..WMCTABLE AS W "
