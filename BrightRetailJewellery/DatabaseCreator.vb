        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' WHERE I.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' AND I.TRANTYPE IN (''SR'',''PU'')  '  "
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' AND I.CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM #METALMAST))            '    "
