        strSql += vbCrLf + " 	AND SUBITEMID=@SUBITEMID"
        strSql += vbCrLf + " 	AND ACCODE=@ACCODE"
        strSql += vbCrLf + " 	SELECT @CNTAK= COUNT(*) FROM SYS.DATABASES WHERE NAME ='BRIGHTECHSMSDB'"
        strSql += vbCrLf + " 	IF @CNTAK > 0"
        strSql += vbCrLf + " 	BEGIN"
