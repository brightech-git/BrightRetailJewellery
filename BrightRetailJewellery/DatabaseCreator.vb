        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD''THEN 0 ELSE I.PCS END)AS PCS,I.GRSWT GRSWT,I.NETWT AS NETWT,CASE WHEN I.AMOUNT <> 0 THEN I.TAX-Case When Isnull(I.Trantype,'''')=''SA''Then ISNULL((SELECT SUM(TAX) FROM ..ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END ELSE 0 END TAX,CATCODE,TAGNO   "
        strSql += vbCrLf + "  		FROM ..ISSUE AS I  "
