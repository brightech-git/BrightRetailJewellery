        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' SELECT PARTICULAR,ADDRESS,DESCRIPT'"
        strSql += vbCrLf + "	IF @BILLPREFIX='Y'"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(COSTID,'''')<>'''' THEN COSTID + ''-'' + CAST(TRANNO AS VARCHAR) END AS TRANNO'"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + ' ,TRANNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,REFNO,REFDATE,TRANDATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,TIN AS TINNO ,CENTRALTAXNO,PCS,GRSWT,NETWT,AMOUNT,TAX,CTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,TOTAL,ACNAME,MMONTHNAME,MMONTHID,COSTID,CATNAME,COLHEAD,RESULT,GROUP1,GROUP2'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMPPURVATRESULT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ORDER BY GROUP1,RESULT,MMONTHID,TRANDATE,TRANNO'"
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_PURCHASEVATPER()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PURCHASEVATPER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PURCHASEVATPER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_PURCHASEVATPER "
        strSql += vbCrLf + " ("
        strSql += vbCrLf + "  @FROMDATE VARCHAR(20)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(20)"
        strSql += vbCrLf + " ,@RPTTYPE VARCHAR(1)"
        strSql += vbCrLf + " ,@COMPANYNAME VARCHAR(8000)"
        strSql += vbCrLf + " ,@METALNAME VARCHAR(8000)"
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(8000)"
        strSql += vbCrLf + " ,@CATNAME VARCHAR(8000)"
        strSql += vbCrLf + " ,@MONTHNAME VARCHAR(20)"
        strSql += vbCrLf + " ,@ACTYPE VARCHAR(50)"
        strSql += vbCrLf + " ,@LOCOUT VARCHAR(10)"
        strSql += vbCrLf + " ,@TRANTYPE VARCHAR(8000)"
        strSql += vbCrLf + " ,@INVAT VARCHAR(10)"
        strSql += vbCrLf + " ,@GRADNTOT VARCHAR(1)"
        strSql += vbCrLf + " ,@DBNAME VARCHAR(20)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + "   AS"
        strSql += vbCrLf + "   SET NOCOUNT ON"
        strSql += vbCrLf + "   DECLARE @TEMP VARCHAR(200)"
        strSql += vbCrLf + "   DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "   /** MONTH SEPERATION **/"
        strSql += vbCrLf + "   SELECT @QRY =' IF OBJECT_ID(''TEMPTABLEDB..TEMPMONTHH'', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMONTHH'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' CREATE TABLE TEMPTABLEDB..TEMPMONTHH (MONTHNAME VARCHAR(20),MM INT)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' DECLARE @DD SMALLDATETIME'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT @DD = ''2010-01-01'''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' WHILE 1=1'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' BEGIN'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPMONTHH (MONTHNAME,MM) SELECT DATENAME(MONTH,@DD),DATEPART(MONTH,@DD)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' IF DATEPART(MONTH,@DD) = 12'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' BREAK'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SET @DD = DATEADD(MONTH,1,@DD)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' END'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' IF '''+@MONTHNAME+''' <> ''ALL'''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' DELETE FROM TEMPTABLEDB..TEMPMONTHH WHERE MONTHNAME <> '''+@MONTHNAME+''''"
        strSql += vbCrLf + "   PRINT @QRY"
        strSql += vbCrLf + "   EXEC (@QRY)"
        strSql += vbCrLf + "   /** ACTYPE SEPERATION **/  "
        strSql += vbCrLf + "  /** ACTYPE SEPERATION **/  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPACHEAD', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD      "
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPACHEAD (ACCODE VARCHAR(7))      "
        strSql += vbCrLf + "   IF @ACTYPE = 'ALL'   "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD UNION ALL SELECT ''  "
        strSql += vbCrLf + "   ELSE  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@ACTYPE)=0  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACTYPE = @ACTYPE  "
        strSql += vbCrLf + "   IF @ACTYPE = 'C'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ''  "
        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@ACTYPE)>0      "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP=LEFT(@ACTYPE,CHARINDEX(',',@ACTYPE)-1)      "
        strSql += vbCrLf + "   SET @ACTYPE=RIGHT(@ACTYPE,LEN(@ACTYPE)-CHARINDEX(',',@ACTYPE))      "
        strSql += vbCrLf + "   IF @ACTYPE <>'' AND CHARINDEX(',',@ACTYPE)=0      "
        strSql += vbCrLf + "   SET @ACTYPE= @ACTYPE + ','      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACTYPE = @TEMP  "
        strSql += vbCrLf + "   IF @TEMP = 'C'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ''  "
        strSql += vbCrLf + "   END "
        strSql += vbCrLf + "   DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE LOCALOUTST = '')"
        strSql += vbCrLf + "   IF CHARINDEX('L',@LOCOUT) = 0"
        strSql += vbCrLf + "   DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE LOCALOUTST = 'L')"
        strSql += vbCrLf + "   IF CHARINDEX('O',@LOCOUT) = 0"
        strSql += vbCrLf + "   DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE LOCALOUTST = 'O')"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPTRANTYPE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPTRANTYPE"
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPTRANTYPE (TRANTYPE VARCHAR(3))      "
        strSql += vbCrLf + "   IF @TRANTYPE = '' OR @TRANTYPE = 'ALL'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)"
        strSql += vbCrLf + "   SELECT 'RPU' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "   SELECT 'RAP' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "   SELECT 'ROT' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "   SELECT 'RRE' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "   SELECT 'RIN' AS TRANTYPE"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   IF CHARINDEX(',PURCHASE',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RPU' AS TRANTYPE "
        strSql += vbCrLf + "   IF CHARINDEX(',RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RRE' AS TRANTYPE "
        strSql += vbCrLf + "   IF CHARINDEX(',APPROVAL RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RAP' AS TRANTYPE "
        strSql += vbCrLf + "   IF CHARINDEX(',OTHER RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'ROT' AS TRANTYPE "
        strSql += vbCrLf + "   IF CHARINDEX(',INTERNAL TRANSFER',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RIN' AS TRANTYPE "
        strSql += vbCrLf + "   /** COMPANY SEPERATION **/  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY      "
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(3))      "
        strSql += vbCrLf + "   IF @COMPANYNAME = 'ALL'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY UNION SELECT ''  "
        strSql += vbCrLf + "   ELSE  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@COMPANYNAME)=0  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY WHERE COMPANYNAME = @COMPANYNAME  "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@COMPANYNAME)>0      "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP=LEFT(@COMPANYNAME,CHARINDEX(',',@COMPANYNAME)-1)      "
        strSql += vbCrLf + "   SET @COMPANYNAME=RIGHT(@COMPANYNAME,LEN(@COMPANYNAME)-CHARINDEX(',',@COMPANYNAME))      "
        strSql += vbCrLf + "   IF @COMPANYNAME <>'' AND CHARINDEX(',',@COMPANYNAME)=0      "
        strSql += vbCrLf + "   SET @COMPANYNAME= @COMPANYNAME + ','      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY WHERE COMPANYNAME = @TEMP  "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "   /** COSTNAME SEPERATION **/  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPCOSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSTCENTRE      "
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPCOSTCENTRE(COSTID VARCHAR(2))      "
        strSql += vbCrLf + "   IF @COSTNAME = 'ALL'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE UNION SELECT ''  "
        strSql += vbCrLf + "   ELSE  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@COSTNAME)=0  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME    "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@COSTNAME)>0      "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)      "
        strSql += vbCrLf + "   SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))      "
        strSql += vbCrLf + "   IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0      "
        strSql += vbCrLf + "   SET @COSTNAME= @COSTNAME + ','      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMP  "
        strSql += vbCrLf + "   END     "
        strSql += vbCrLf + "   /** METALNAME SEPERATION **/  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPMETAL', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMETAL  "
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPMETAL (METALID VARCHAR(1))      "
        strSql += vbCrLf + "   IF @METALNAME = 'ALL'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST UNION SELECT ''  "
        strSql += vbCrLf + "   ELSE  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@METALNAME)=0  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METALNAME  "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@METALNAME)>0      "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP=LEFT(@METALNAME,CHARINDEX(',',@METALNAME)-1)      "
        strSql += vbCrLf + "   SET @METALNAME=RIGHT(@METALNAME,LEN(@METALNAME)-CHARINDEX(',',@METALNAME))      "
        strSql += vbCrLf + "   IF @METALNAME <>'' AND CHARINDEX(',',@METALNAME)=0      "
        strSql += vbCrLf + "   SET @METALNAME= @METALNAME + ','      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @TEMP  "
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   /** CATNAME SEPERATION **/  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPCATEGORY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCATEGORY  "
        strSql += vbCrLf + "   CREATE TABLE TEMPTABLEDB..TEMPCATEGORY (CATCODE VARCHAR(7))      "
        strSql += vbCrLf + "   IF @CATNAME = 'ALL'  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY UNION SELECT ''  "
        strSql += vbCrLf + "   ELSE  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@CATNAME)=0  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME = @CATNAME  "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@CATNAME)>0      "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP=LEFT(@CATNAME,CHARINDEX(',',@CATNAME)-1)      "
        strSql += vbCrLf + "   SET @CATNAME=RIGHT(@CATNAME,LEN(@CATNAME)-CHARINDEX(',',@CATNAME))      "
        strSql += vbCrLf + "   IF @CATNAME <>'' AND CHARINDEX(',',@CATNAME)=0      "
        strSql += vbCrLf + "   SET @CATNAME= @CATNAME + ','      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME = @TEMP  "
        strSql += vbCrLf + "   END   "
        strSql += vbCrLf + "   /** GETTTING VALUES FROM ORIGINAL TABLE **/  "
        strSql += vbCrLf + "   SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPPURVATRPT'',''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPURVATRPT'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT TRANNO,TRANDATE,REFNO,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT,TAX,CTAX,CONVERT(DECIMAL(6,2),(COALESCE(AMOUNT / NULLIF((CASE WHEN ISNULL(CTAX,0)<>0 THEN CTAX ELSE TAX END)*100,0), 0)))AS TAX_PERCENTAGE,AMOUNT+TAX+CTAX AS TOTAL,MMONTHNAME,MMONTHID,CATNAME,ACNAME,CENTRALTAXNO,CONVERT(VARCHAR(15),SNO)SNO,COSTID,GROUP1,GROUP2,ACCODE,CANCEL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' INTO TEMPTABLEDB..TEMPPURVATRPT '"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' FROM(SELECT DISTINCT R.TRANNO,R.TRANDATE,R.REFNO,R.REFDATE,R.REMARK1 DESCRIPT,R.PCS,R.GRSWT,R.NETWT,'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' /** Includes Amount + Tax as Amount for outstation Customers**/'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' CASE WHEN '''+@INVAT+'''=''I'' THEN CASE WHEN ISNULL(H.LOCALOUTST,'''')=''O'' THEN'   "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' (R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) +'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0))'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ELSE R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)'     "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' END ELSE'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)'   "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' END  AMOUNT,'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' CASE WHEN ISNULL(H.LOCALOUTST,'''')=''O'' THEN 0 ELSE'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END TAX'   "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(H.LOCALOUTST,'''')=''O'' THEN CASE WHEN '''+@INVAT+'''=''I'' THEN 0' "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ELSE R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ELSE 0 END CTAX'   "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE(''0'',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'''') <> '''' THEN H.ACNAME ELSE P.PNAME END AS ACNAME'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,H.CENTRALTAXNO,R.SNO,R.COSTID,R.ACCODE,R.CANCEL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR(300),NULL)GROUP1'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR(300),NULL)GROUP2'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' FROM RECEIPT R'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' INNER JOIN '+@DBNAME+'..CATEGORY AS C ON C.CATCODE = R.CATCODE'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..ACHEAD AS H ON H.ACCODE = R.ACCODE'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..CUSTOMERINFO AS CU ON CU.BATCHNO = R.BATCHNO'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' LEFT JOIN '+@DBNAME+'..PERSONALINFO AS P ON P.SNO = CU.PSNO'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' WHERE R.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND ISNULL(R.CANCEL,'''') = '''''  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.CATCODE IN (SELECT CATCODE FROM '+@DBNAME+'..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND DATENAME(MONTH,R.TRANDATE) IN (SELECT MONTHNAME FROM TEMPTABLEDB..TEMPMONTHH)'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.TRANTYPE IN (SELECT TRANTYPE FROM TEMPTABLEDB..TEMPTRANTYPE)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND R.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' )X'    "
        strSql += vbCrLf + "   PRINT (@QRY)"
        strSql += vbCrLf + "   EXEC (@QRY)"
        strSql += vbCrLf + "   SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TT'') IS NOT NULL DROP TABLE TEMPTABLEDB..TT'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT * INTO TEMPTABLEDB..TT FROM TEMPTABLEDB..TEMPPURVATRPT'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..TEMPPURVATRPT'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' (TRANNO,TRANDATE,REFNO,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT,TAX,TAX_PERCENTAGE,TOTAL,MMONTHNAME,MMONTHID,CATNAME,ACNAME,CENTRALTAXNO,SNO,COSTID,GROUP1,GROUP2)'    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' DISTINCT R.TRANNO,R.TRANDATE,R.REFNO,R.REFDATE,R.REMARK1,S.STNPCS,S.STNWT,S.STNWT,S.STNAMT,S.TAX,(COALESCE(S.STNAMT / NULLIF(S.TAX*100,0), 0))AS TAX_PERCENTAGE,S.STNAMT + ISNULL(S.TAX,0) AS TOTAL'  "
