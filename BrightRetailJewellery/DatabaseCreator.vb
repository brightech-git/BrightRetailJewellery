        strSql += vbCrLf + "  	IF @COSTID<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.COSTID='''+@COSTID+''' '"
        strSql += vbCrLf + "  	IF @ITEMID<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND IT.ITEMID='''+@ITEMID+''' '"
        strSql += vbCrLf + "  	IF @SUBITEMID<>''AND @SUBITEMID<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND SI.SUBITEMID='''+@SUBITEMID+''' '"
        strSql += vbCrLf + "  	IF @SHAPE<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.SHAPEID='''+@SHAPE+''' '"
        strSql += vbCrLf + "  	IF @COLOR<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.COLORID='''+@COLOR+''' '"
        strSql += vbCrLf + "  	IF @CUT<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.CUTID='''+@CUT+''' '"
        strSql += vbCrLf + "  	IF @CLARITY<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.CLARITYID='''+@CLARITY+''' '"
        strSql += vbCrLf + "  	IF @CARATFROM<>'0' AND @CARATTO <>'0'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.GRSWT BETWEEN '''+@CARATFROM+''' AND '''+@CARATTO+''' '"
        strSql += vbCrLf + "  	IF @PRICEFROM<>'0' AND @PRICETO <>'0'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND TG.SALVALUE BETWEEN '''+@PRICEFROM+''' AND '''+@PRICETO+''' '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' UNION ALL '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' SELECT TG.ITEMID AS TGITEMID,TG.SUBITEMID AS TGSUBITEMID,ST.STNITEMID AS STNITEMID ,ST.STNSUBITEMID AS STNSUBITEMID,ST.STNRATE AS STNRATE,ST.STNAMT AS STNAMT,ST.STNWT AS STNWT,SH.SHAPENAME AS SHAPE, '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' SC.COLORNAME AS COLOR,CL.CLARITYNAME AS CLARITY,CT.CUTNAME AS CUT,'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' TG.CERTIFICATENO,TG.TAGNO,TG.PCTFILE,2 AS RESULT FROM ITEMTAG AS TG  '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' INNER JOIN ITEMTAGSTONE ST ON ST.TAGSNO =TG.SNO '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' INNER JOIN ITEMMAST AS IT  ON IT.ITEMID=ST.STNITEMID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNSHAPE AS SH ON SH.SHAPEID=ST.SHAPEID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCOLOR AS SC ON SC.COLORID=ST.COLORID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCLARITY AS CL ON CL.CLARITYID=ST.CLARITYID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCUT AS CT ON CT.CUTID=ST.CUTID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' WHERE '  "
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +'  IT.METALID=''D'' ' "
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' AND IT.STUDDED =''S'' '"
        strSql += vbCrLf + "  	IF @RPTTYPE='STOCK' "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ISNULL(TG.ISSDATE ,'''')=''''   ' "
        strSql += vbCrLf + "  	IF @RPTTYPE='SALES' "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ISNULL(TG.ISSDATE ,'''')<>'''' AND TG.TOFLAG=''SA''   ' "
        strSql += vbCrLf + "  	IF @COSTID<>'ALL'"
        strSql += vbCrLf + "  	    SELECT @QRY=@QRY+CHAR(13) +' AND TG.COSTID='''+@COSTID+''' '"
        strSql += vbCrLf + "  	IF @ITEMID<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.STNITEMID='''+@ITEMID+''' '"
        strSql += vbCrLf + "  	IF @SUBITEMID<>'' AND @SUBITEMID<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.STNSUBITEMID='''+@SUBITEMID+''' '"
        strSql += vbCrLf + "  	IF @SHAPE<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.SHAPEID='''+@SHAPE+''' '"
        strSql += vbCrLf + "  	IF @COLOR<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.COLORID='''+@COLOR+''' '"
        strSql += vbCrLf + "  	IF @CUT<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.CUTID='''+@CUT+''' '"
        strSql += vbCrLf + "  	IF @CLARITY<>'ALL'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.CLARITYID='''+@CLARITY+''' '"
        strSql += vbCrLf + "  	IF @CARATFROM<>'0' AND @CARATTO <>'0'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.STNWT BETWEEN '''+@CARATFROM+''' AND '''+@CARATTO+''' '"
        strSql += vbCrLf + "  	IF @PRICEFROM<>'0' AND @PRICETO <>'0'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13) +' AND ST.STNAMT BETWEEN '''+@PRICEFROM+''' AND '''+@PRICETO+''' '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' ) X ORDER BY ITEM,SUBITEM,STNAMT ASC '"
        strSql += vbCrLf + "  	PRINT(@QRY)"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY=' ALTER TABLE TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE ADD PARTICULAR VARCHAR(100)'"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY='INSERT INTO TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE(PARTICULAR,ITEM,RESULT)'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13) +'SELECT DISTINCT ITEM,ITEM,''0'' FROM TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE WHERE RESULT=''2'''"
        strSql += vbCrLf + "     PRINT @QRY"
        strSql += vbCrLf + "     EXEC(@QRY)"
        strSql += vbCrLf + "     SELECT @QRY='INSERT INTO TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE(ITEM,PARTICULAR,STNAMT,STNWT,RESULT)'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13) +'SELECT DISTINCT ITEM,''SUB TOTAL'' PARTICULAR,SUM(STNAMT),SUM(STNWT),''3'' FROM TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE WHERE RESULT=''2'' GROUP BY ITEM'"
        strSql += vbCrLf + "     PRINT @QRY"
        strSql += vbCrLf + "     EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE(PARTICULAR,ITEM,STNAMT,STNWT,RESULT) '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' SELECT ''GRAND TOTAL''AS PARTICULAR,''ZZZZZZ'' AS ITEM,SUM(STNAMT)STNAMT,SUM(STNWT)STNWT,4 AS RESULT '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' FROM TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE  WHERE RESULT=''2'''"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY='UPDATE TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE  SET STNRATE=NULL WHERE STNRATE=''0.00'''"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' UPDATE TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE  SET STNAMT=NULL WHERE STNAMT=''0.00'''"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' UPDATE TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE  SET STNWT=NULL WHERE STNWT=''0.00'''"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY=' SELECT * FROM TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE ORDER BY RESULT DESC '"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub
    Private Sub funcSp_ProcDiamondSales()
        strSql = vbCrLf + "IF OBJECT_ID('PROC_DIAMONDSALES','P')IS NOT NULL "
        strSql += vbCrLf + " DROP PROC PROC_DIAMONDSALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE PROC_DIAMONDSALES"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @COMPANYNAME VARCHAR(5000),"
        strSql += vbCrLf + " @COSTNAME VARCHAR(5000),"
        strSql += vbCrLf + " @DBNAME VARCHAR(8),"
        strSql += vbCrLf + " @FROMDATE VARCHAR(15),"
        strSql += vbCrLf + " @TODATE VARCHAR(15),"
        strSql += vbCrLf + " @ITEMNAME VARCHAR(2000),"
        strSql += vbCrLf + " @SUBITEMNAME VARCHAR(2000),"
        strSql += vbCrLf + " @SYSID VARCHAR(3)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 	SELECT @QRY = ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPDIASALES'+@SYSID+''')> 0 DROP TABLE TEMPTABLEDB..TEMPDIASALES'+@SYSID+' '     "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + "   	EXEC(@QRY)"
        strSql += vbCrLf + "   	SELECT @QRY = ' SELECT TRANNO,TRANDATE,ITEMNAME,PCS,GRSWT,NETWT,LESSWT,DIAPCS,DIAWT,DIAAMT,PRODUCTVALUE,TAX AS VAT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,AMOUNT AS TOTAL,RESULT  INTO TEMPTABLEDB..TEMPDIASALES'+@SYSID+' FROM ( SELECT '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' TRANNO,TRANDATE,ITEMNAME,PCS,GRSWT,NETWT,LESSWT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(NUMERIC(15,2),PRVALUE)PRODUCTVALUE,TAX,AMOUNT,CONVERT(NUMERIC(15,2),RATE)RATE,'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' SUM(DIAPCS)DIAPCS,SUM(DIAWT)DIAWT,SUM(DIAAMT)DIAAMT,0 AS RESULT FROM ('"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' SELECT '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' I.TRANNO,I.TRANDATE,M.ITEMNAME,0 PCS,0.000 GRSWT,0.00 NETWT,0.000 LESSWT,0 PRVALUE'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,0 TAX,0 AMOUNT,I.RATE,I.PCS DIAPCS,I.GRSWT DIAWT,I.AMOUNT DIAAMT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' FROM '+@DBNAME +'..ISSUE AS I'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' INNER JOIN ITEMMAST AS M ON M.ITEMID=I.ITEMID AND M.METALID=''D'''"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''' '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.CANCEL,'''')='''' '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.TRANTYPE=''SA'' '"
        strSql += vbCrLf + "   	IF @ITEMNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.ITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE ITEMNAME IN('''+ @ITEMNAME + '''))'"
        strSql += vbCrLf + "   	IF @SUBITEMNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.SUBITEMID IN (SELECT SUBITEMID FROM SUBITEMMAST WHERE SUBITEMNAME IN('''+ @SUBITEMNAME + '''))'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	IF @COSTNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.COSTID IN (SELECT COSTID FROM COSTCENTRE WHERE COSTNAME IN('''+ @COSTNAME + '''))'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' UNION ALL'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' SELECT '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' I.TRANNO,I.TRANDATE,M.ITEMNAME,S.PCS,S.GRSWT,S.NETWT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,S.LESSWT,(S.AMOUNT) PRVALUE,(S.TAX)VAT,(S.AMOUNT+S.TAX)AMOUNT,S.RATE,I.STNPCS AS DIAPCS'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,(CASE WHEN I.STONEUNIT=''C'' THEN I.STNWT ELSE I.STNWT*5 END) AS DIAWT,I.STNAMT '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' FROM '+@DBNAME +'..ISSSTONE AS I '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' INNER JOIN '+@DBNAME +'..ISSUE AS S ON S.SNO =I.ISSSNO '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' INNER JOIN ITEMMAST AS M ON M.ITEMID=I.STNITEMID AND M.METALID=''D'''"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' WHERE I.ISSSNO IN(SELECT SNO FROM '+@DBNAME +'..ISSUE AS I'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''' AND ISNULL(I.CANCEL,'''')='''' '"
        strSql += vbCrLf + "   	IF @ITEMNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.ITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE ITEMNAME IN('''+ @ITEMNAME + '''))'"
        strSql += vbCrLf + "   	IF @SUBITEMNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.SUBITEMID IN (SELECT SUBITEMID FROM SUBITEMMAST WHERE SUBITEMNAME IN('''+ @SUBITEMNAME + '''))'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	IF @COSTNAME <> 'ALL'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.COSTID IN (SELECT COSTID FROM COSTCENTRE WHERE COSTNAME IN('''+ @COSTNAME + '''))'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.TRANTYPE=''SA''))X'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' GROUP BY TRANNO,TRANDATE,ITEMNAME,PCS,GRSWT,NETWT,LESSWT,RATE,PRVALUE,TAX,AMOUNT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' )X ORDER BY TRANDATE,TRANNO'"
        strSql += vbCrLf + "   	PRINT @QRY"
        strSql += vbCrLf + "   	EXEC (@QRY)"
        strSql += vbCrLf + "   	SELECT @QRY = CHAR(13) +' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPDIASALES'+@SYSID+')>0'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' BEGIN'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPDIASALES'+@SYSID+' (ITEMNAME,PCS,GRSWT,NETWT,LESSWT,DIAPCS,DIAWT,DIAAMT,PRODUCTVALUE,VAT,TOTAL,RESULT)'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' SELECT ''TOTAL''ITEMNAME,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(LESSWT)LESSWT,'"
