        TrigDisable = funcCheckTriggerStatus("SUBITEMMAST_CHANGE_SMS_TRG")
        SUBITEMMAST_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("SUBITEMMAST", "SUBITEMMAST_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("ACHEAD_CHANGE_SMS_TRG")
        ACHEAD_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("ACHEAD", "ACHEAD_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("ACGROUP_CHANGE_SMS_TRG")
        ACGROUP_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("ACGROUP", "ACGROUP_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("CATEGORY_CHANGE_SMS_TRG")
        CATEGORY_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("CATEGORY", "CATEGORY_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("CASHCOUNTER_CHANGE_SMS_TRG")
        CASHCOUNTER_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("CASHCOUNTER", "CASHCOUNTER_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("CASHTRAN_CHANGE_SMS_TRG")
        CASHTRAN_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("CASHTRAN", "CASHTRAN_CHANGE_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("CREDITCARD_CHANGE_SMS_TRG")
        CREDITCARD_SMS_TRG()
