        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET     "
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,COLHEAD,RESULT,RECEIPT)   "
        strSql += vbCrLf + "  		SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT, 0 RECEIPT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET WHERE RESULT = 1"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET"
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT METALNAME + '' SUBTOTAL'' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),''S'' COLHEAD,2 RESULT     "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET WHERE RESULT = 1 GROUP BY METALNAME "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,VALUEADD,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET "
        strSql += vbCrLf + "		ORDER BY METALNAME,RESULT ,CONVERT(INT,TRANNO)     "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
