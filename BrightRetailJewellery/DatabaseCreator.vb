            'strSql += vbCrLf + "  WHERE NAME NOT IN (SELECT TABLENAME FROM " & compId & suffix & "..SYNCMAST)"
            'strSql += vbCrLf + "  ORDER BY NAME"
            'cmd = New OleDbCommand(strSql, cn, tran)
            'cmd.ExecuteNonQuery()
            strSql = "UPDATE " & cnAdminDb & "..ACCTYPE SET TYPENAME='INTERNAL' WHERE TYPEID='I' AND  TYPENAME='INTERAL'"
            cmd = New OleDbCommand(strSql, cn, tran)
