        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' GROUP BY COLHEAD,H.ACNAME,H.ACTYPE,H.ACCODE '"
        strSql += vbCrLf + " 	PRINT @QUERY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "	IF @GROUPBY = 'Y'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QUERY=' INSERT INTO '+@TEMPTABLE +'1 (COLHEAD,TYPENAME,ACNAME,RESULT)'"
