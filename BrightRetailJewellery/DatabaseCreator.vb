        strSql += vbCrLf + "  		SELECT METALNAME+'' TOTAL '' COL1,NULL,NULL,SUM(CONVERT(NUMERIC(10,3),PCS))PCS,SUM(CONVERT(NUMERIC(10,3),GRSWT))GRSWT,SUM(CONVERT(NUMERIC(10,3),NETWT))NETWT"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),MCHARGE))MCHARGE,SUM(CONVERT(NUMERIC(10,3),RATE))RATE,SUM(CONVERT(NUMERIC(10,3),AMOUNT)),SUM(CONVERT(NUMERIC(10,3),TAX))TAX"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),RECEIPT)),SUM(CONVERT(NUMERIC(10,3),PAYMENT)),NULL,''''BATCHNO,''S1''COLHEAD,2 RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE WHERE RESULT = 1  GROUP BY METALNAME,RESULT"
        strSql += vbCrLf + "  		UNION ALL"
        strSql += vbCrLf + "  		SELECT ''PURCHASE DETAIL TOTAL '' COL1,NULL,NULL,SUM(CONVERT(NUMERIC(10,3),PCS))PCS,SUM(CONVERT(NUMERIC(10,3),GRSWT))GRSWT,SUM(CONVERT(NUMERIC(10,3),NETWT))NETWT"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),MCHARGE))MCHARGE,SUM(CONVERT(NUMERIC(10,3),RATE))RATE,SUM(CONVERT(NUMERIC(10,3),AMOUNT)),SUM(CONVERT(NUMERIC(10,3),TAX))TAX"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),RECEIPT)),SUM(CONVERT(NUMERIC(10,3),PAYMENT)),NULL,''''BATCHNO,''T1''COLHEAD,3 RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE WHERE RESULT = 1  "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT 2  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY) "
        strSql += vbCrLf + "  		 /*"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES)>0    "
        strSql += vbCrLf + "  		BEGIN    "
