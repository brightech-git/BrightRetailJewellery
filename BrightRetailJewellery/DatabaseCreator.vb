        strSql += vbCrLf + "   SET @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPCSTKVALUE0'+ @SYSTEMID+''',''U'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCSTKVALUE0'+ @SYSTEMID"
