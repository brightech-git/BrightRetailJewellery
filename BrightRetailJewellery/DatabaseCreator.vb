        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE WHERE RESULT = 1"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL6,COL7,COL8,COL9,COL10,COL9A,COL9B,COL9C,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,SGST,CGST,IGST,RECEIPT,NULL PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE ORDER BY RESULT,CONVERT(INT,TRANNO)      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
        strSql += vbCrLf + "  		END '   "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)    "
        strSql += vbCrLf + "  		/******************** AdvanceReceived ******************/"
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVRECEIVED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVRECEIVED "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,O.TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
