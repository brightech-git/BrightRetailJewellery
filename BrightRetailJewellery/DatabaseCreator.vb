        strSql += vbCrLf + " 	IF @TRANFILTER <> '' SET @TTRANFILTER = @TRANFILTER"
        strSql += vbCrLf + " 	IF @TRANFILTER <> '' SET @TRANFILTER = ' AND TRANTYPE IN ('''+REPLACE(@TRANFILTER,',',''',''') +''')'"
        strSql += vbCrLf + "  	IF @COSTIDS<>'ALL'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SET @COSTFILTER='  AND COSTID IN('''+REPLACE(@COSTIDS,',',''',''')+''')'"
