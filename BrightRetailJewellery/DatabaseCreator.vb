        strSql += vbCrLf + "  		PRINT'/******************** SALES RETURN *********************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'SALESRET'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET   "
