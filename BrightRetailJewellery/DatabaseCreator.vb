        strSql += vbCrLf + "  		SELECT ADDRESS2,NSNO,2 FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP WHERE ISNULL(ADDRESS2,'''')<>''''"
