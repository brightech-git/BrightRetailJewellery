        strSql = " CREATE PROCEDURE SP_INSERT_ACCTRAN"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@TABLENAME VARCHAR(20),"
        strSql += vbCrLf + "@FROMID VARCHAR(5),"
        strSql += vbCrLf + "@TRANDBNAME VARCHAR(10),    "
        strSql += vbCrLf + "@SNO VARCHAR(15),    "
        strSql += vbCrLf + "@TRANNO VARCHAR(15),    "
