        strSql += vbCrLf + " 		SET @ITEMID = REPLACE(@ITEMID,',',''',''')"
        strSql += vbCrLf + " 		SELECT @ITEMFILTER=' AND I.ITEMID IN ('''+ @ITEMID +''')' "
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	/*  ====================================================================== */  "
        strSql += vbCrLf + " 	/*  TAKE THE DATAS FROM ISSUE TABLE WITH CONDITIONS INTO TEMPORARY TABLE */  "
        strSql += vbCrLf + " 	/*  ====================================================================== */  "
        strSql += vbCrLf + " 	SELECT @STRQRY=''  "
