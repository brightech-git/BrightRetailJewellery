                    STATUS = "Transfering Tag Tables"
                    funcProgressStep(0)
                    funcTransferTrandb_Admindb()
                    funcProgressStep(1)

                    If GetSqlValue("SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='TRANDB_ADMINDB'", "N", tran) = "N" Then
                        strSql = "UPDATE " & compId & "ADMINDB..SOFTCONTROL SET CTLTEXT='Y' WHERE CTLID='TRANDB_ADMINDB'"
                        cmd = New OleDbCommand(strSql, cn, tran)
                        cmd.ExecuteNonQuery()
                    End If

                End If
            End If
            ''Newly Added for transfering Order from trandb to Admindb
            strSql = " SELECT NAME FROM " & tranDbName & "..SYSOBJECTS WHERE ID = OBJECT_ID('" & tranDbName & "..ORMAST','U')"
            If GetSqlValue(strSql, "", tran) <> "" Then
                strSql = " SELECT NAME FROM " & tranDbName & "..SYSOBJECTS WHERE ID = OBJECT_ID('" & tranDbName & "..ORIRDETAIL','U')"
