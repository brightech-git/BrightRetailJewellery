        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,ISNULL(CONVERT(VARCHAR,I.TRANDATE,103),'''')  BILLDATE,IT.ITEMNAME,SIT.SUBITEMNAME'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,I.TAGNO,I.PCS AS PCS,I.GRSWT AS GRSWT,I.LESSWT AS LESSWT,I.NETWT AS NETWT' "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,(SELECT SUM(STNWT) FROM '+@CNSTOCKDB+'..ISSSTONE WHERE ISSSNO = I.SNO '"
