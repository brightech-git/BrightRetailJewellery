        strSql += vbCrLf + "          SELECT @STRQRY=@STRQRY + CHAR(13) + ',TAX SGST,TAX CGST,TAX IGST,TAX GST'"
        strSql += vbCrLf + "          SELECT @STRQRY=@STRQRY + CHAR(13) + ',AMOUNT IAMOUNT'"
