        strSql += vbCrLf + "  	SELECT @QRY = @QRY +' GROUP BY CATNAME,TRANDATE,TRANNO,CUSTOMER,ADDRESS,PHONENO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,BATCHNO,TRANTYPE,EMPNAME'"
        strSql += vbCrLf + "  	EXEC (@QRY)  "
        strSql += vbCrLf + "  	SELECT @QRY = 'SELECT *,IDENTITY(INT,1,1)SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA FROM #ABSSUMMARY_SA'  "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY + ' ORDER BY CATNAME,RESULT,TRANDATE,TRANNO'  "
        strSql += vbCrLf + "  	EXEC (@QRY)  "
        strSql += vbCrLf + "  	IF @TRANNOWISE = 'Y' AND @VA = 'Y'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP'  "
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY = 'SELECT * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SATEMP FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA '  "
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY = 'DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ABSSUMMARY_SA'  "
        strSql += vbCrLf + "  		PRINT @QRY"
