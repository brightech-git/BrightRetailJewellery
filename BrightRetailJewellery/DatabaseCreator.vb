        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET INETWT=NULL WHERE INETWT=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET ISTNPCS=NULL WHERE ISTNPCS=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET ISTNWT=NULL WHERE ISTNWT=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET IDIAPCS=NULL WHERE IDIAPCS=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET IDIAWT=NULL WHERE IDIAWT=0 '  "
        strSql += vbCrLf + "	IF @FORMAT='N'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET IMC=NULL WHERE IMC=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET IWAST=NULL WHERE IWAST=0 '  "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET LPCS=NULL WHERE LPCS=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET LGRSWT=NULL WHERE LGRSWT=0 '  "
        strSql += vbCrLf + "	SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET LNETWT=NULL WHERE LNETWT=0 '  "
        strSql += vbCrLf + "	IF @FORMAT='Y'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CPCS=NULL WHERE CPCS=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CGRSWT=NULL WHERE CGRSWT=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CNETWT=NULL WHERE CNETWT=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CSTNPCS=NULL WHERE CSTNPCS=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CSTNWT=NULL WHERE CSTNWT=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CDIAPCS=NULL WHERE CDIAPCS=0 '  "
        strSql += vbCrLf + "		SELECT @QUERY = @QUERY + CHAR(13) +' UPDATE TEMPTABLEDB..' + @TEMPTABLE +'1 SET CDIAWT=NULL WHERE CDIAWT=0 '  "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	PRINT @QUERY  "
