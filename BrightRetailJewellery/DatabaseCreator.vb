        strSql += vbCrLf + " 	SELECT @ACC=ACNAME FROM ACHEAD WHERE ACCODE=@ACCODE"
        strSql += vbCrLf + " 	SELECT @ITM=ITEMNAME FROM ITEMMAST WHERE ITEMID=@ITEMID"
        strSql += vbCrLf + " 	SELECT @SUB=SUBITEMNAME FROM SUBITEMMAST WHERE ITEMID=@ITEMID AND SUBITEMID=@SUBITEMID"
