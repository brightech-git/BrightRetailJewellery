    Private Sub SP_RPT_CRADV()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CRADV')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CRADV"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_CRADV "
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@TEMPTABLE VARCHAR(20)"
        strSql += vbCrLf + ",@FROMDATE VARCHAR(12)"
        strSql += vbCrLf + ",@TODATE VARCHAR(12)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(20)"
        strSql += vbCrLf + ",@COSTID VARCHAR(300)"
        strSql += vbCrLf + ",@DETAILED VARCHAR(1)"
        strSql += vbCrLf + ",@ADVCR VARCHAR(100)"
        strSql += vbCrLf + ",@ACCODE VARCHAR(2000)"
        strSql += vbCrLf + ",@ACTYPE VARCHAR(10)    "
        strSql += vbCrLf + ",@ACGROUP VARCHAR(10)"
        strSql += vbCrLf + ") "
        strSql += vbCrLf + "AS  "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QUERY NVARCHAR(4000)  "
        strSql += vbCrLf + "	DECLARE @CRADVFILTER VARCHAR(1000)"
        strSql += vbCrLf + "	DECLARE @ACFILTER VARCHAR(1000)"
        strSql += vbCrLf + "	SET @ACFILTER=''"
        strSql += vbCrLf + "	SET @CRADVFILTER=''"
        strSql += vbCrLf + "	set @ADVCR = replace(@ADVCR,',',''',''')"
        strSql += vbCrLf + "	set @COMPANYID = replace(@COMPANYID,',',''',''')"
        strSql += vbCrLf + "	SET @CRADVFILTER='AND TRANTYPE IN('''+ @ADVCR +''')'"
        strSql += vbCrLf + "	PRINT @CRADVFILTER"
        strSql += vbCrLf + "	IF @ACCODE <>''"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SET @ACCODE = REPLACE(@ACCODE,',',''',''')"
        strSql += vbCrLf + "		SET @ACFILTER=' AND B.ACCODE IN('''+ @ACCODE +''')'"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	SET @ACGROUP = REPLACE(@ACGROUP,',',''',''')"
        strSql += vbCrLf + "	IF @ACTYPE <> ''   SELECT @ACFILTER = @ACFILTER +' AND B.ACCODE IN (SELECT ACCODE FROM ACHEAD  WHERE ACTYPE IN ('''+@ACTYPE+'''))'"
        strSql += vbCrLf + "	IF @ACGROUP <> ''  SELECT @ACFILTER = @ACFILTER +' AND B.ACCODE IN (SELECT ACCODE FROM ACHEAD  WHERE ACGRPCODE IN ('''+@ACGROUP+'''))'"
        strSql += vbCrLf + "	SET @QUERY = ' IF  EXISTS (SELECT * FROM sysobjects WHERE xtype = ''U'' AND NAME = '+''''+@TEMPTABLE+''''+' )'"
        strSql += vbCrLf + "	SELECT @QUERY =@QUERY+'DROP TABLE ' + @TEMPTABLE "
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "	SET @QUERY = 'CREATE TABLE '+@TEMPTABLE+' ('"
        strSql += vbCrLf + "	SELECT  @QUERY = @QUERY + '[COMPANYID] [VARCHAR](5),[COSTID] [VARCHAR](5),TRANMODE VARCHAR(2),TRANDATE DATETIME,TRANNO VARCHAR(20),[PARTICULARS] [VARCHAR](500),[OPENING] DECIMAL(12,2) DEFAULT 0,[ACCODE] VARCHAR(10),'"
        strSql += vbCrLf + "	SELECT  @QUERY = @QUERY + '[RUNNO] VARCHAR(20),[BATCHNO] VARCHAR(20),[DEBIT] DECIMAL(12,2) DEFAULT 0,[CREDIT] DECIMAL(12,2) DEFAULT 0,[BALANCE] DECIMAL(12,2) DEFAULT 0,[COLHEAD] VARCHAR(2),[PAYMODE] VARCHAR(20),[REMARK] VARCHAR(150),LASTTRANDATE VARCHAR(13)'"
        strSql += vbCrLf + "	select @query = @query + ') ON [PRIMARY]'"
        strSql += vbCrLf + "	EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "	IF @DETAILED = 'Y'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QUERY ='INSERT INTO '+@TEMPTABLE+'(COMPANYID ,COSTID ,TRANDATE,PAYMODE,TRANMODE,PARTICULARS,DEBIT,CREDIT,BALANCE,COLHEAD)'"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+' SELECT '''','''','''' ,'''', ''01'',''OPENING'' AS PARTICULARS, '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+' SUM(CASE WHEN RECPAY = ''P'' THEN ISNULL(AMOUNT,0) END)DEBIT , SUM(CASE WHEN RECPAY = ''R'' THEN ISNULL(AMOUNT,0) END)CREDIT,0,''TS'''   	"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+ ' FROM  OUTSTANDING WHERE TRANDATE < '''+@FROMDATE+''' AND  ISNULL(CANCEL,'''') <> ''Y'''    "
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+ @CRADVFILTER"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+ REPLACE(@ACFILTER,'B.','')"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY+' AND COMPANYID IN ('''+@COMPANYID+''') '     "
        strSql += vbCrLf + "		PRINT @QUERY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "		SELECT @QUERY =' UPDATE '+@TEMPTABLE+' SET DEBIT =(SELECT ISNULL(DEBIT,0)-ISNULL(CREDIT,0)FROM '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +@TEMPTABLE+' WHERE COLHEAD = ''TS'' AND ISNULL(DEBIT,0) > ISNULL(CREDIT,0)),CREDIT=0 WHERE COLHEAD=''TS''  AND ISNULL(DEBIT,0) > ISNULL(CREDIT,0)'"
        strSql += vbCrLf + "		PRINT @QUERY"
