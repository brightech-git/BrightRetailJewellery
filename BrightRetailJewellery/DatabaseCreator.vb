        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP_OUT_COSTCENTRE SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = @COSTNAME     "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMP_OUT_COMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUT_COMPANY       "
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..TEMP_OUT_COMPANY (COMPANYID VARCHAR(3))       "
