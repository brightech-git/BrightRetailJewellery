    Private Sub PROC_GSTRECONCILE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_GSTRECONCILE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_GSTRECONCILE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE PROC_GSTRECONCILE"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@FROMDATE VARCHAR(15)"
        strSql += vbCrLf + ",@TODATE VARCHAR(15)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(200)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(200)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	DECLARE @COSTCENTRE VARCHAR(1)"
        strSql += vbCrLf + "	SELECT @COSTCENTRE =CTLTEXT FROM SOFTCONTROL WHERE CTLID='COSTCENTRE'"
        strSql += vbCrLf + "	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME  "
        strSql += vbCrLf + "	SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2)'  "
        strSql += vbCrLf + "	EXEC (@QRY)  "
        strSql += vbCrLf + "	SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'  "
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..METALMAST') IS NOT NULL DROP TABLE TEMPTABLEDB..METALMAST CREATE TABLE TEMPTABLEDB..METALMAST(METALID VARCHAR(10))  "
        strSql += vbCrLf + "	IF @METALNAME = '' OR @METALNAME = 'ALL'  "
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..METALMAST(METALID) SELECT METALID FROM METALMAST  "
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..METALMAST(METALID) SELECT METALID FROM METALMAST WHERE METALNAME = @METALNAME "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT "
        strSql += vbCrLf + "	SELECT @QRY='SELECT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' (SELECT TOP 1 STATE FROM PERSONALINFO WHERE SNO=(SELECT TOP 1 PSNO FROM CUSTOMERINFO WHERE BATCHNO=I.BATCHNO)) AS STATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(VARCHAR(25),TRANNO) AS PARTICULAR ,I.TRANDATE AS INVDATE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,SUM(AMOUNT) AS AMOUNT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,SUM(TAX) AS GST'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXPER) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS IRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS ITAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXPER) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS CRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS CTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXPER) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS SRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'' AND TRANTYPE =''SA'' AND ISSSNO=I.SNO)AS STAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(VARCHAR(2),NULL)AS BILLTYPE'"
        strSql += vbCrLf + "	IF @COSTCENTRE='Y'"
        strSql += vbCrLf + "	    SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT STATENAME FROM STATEMAST WHERE STATEID=(SELECT STATEID FROM COSTCENTRE WHERE COSTID=I.COSTID)) AS COMPANYSTATE'"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	    SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT STATENAME FROM STATEMAST WHERE STATEID=(SELECT STATEID FROM COMPANY WHERE COMPANYID=I.COMPANYID)) AS COMPANYSTATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(15,2),NULL)AS DIFF'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,I.BATCHNO,2 AS RESULT,TRANNO,'' '' AS COLHEAD,I.SNO,I.COSTID'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' INTO TEMPTABLEDB..TEMPGSTRPT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' FROM '+@DBNAME+'..ISSUE I'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)'  "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(I.COMPANYID,'''') = '''+@COMPANYID+''' AND ISNULL(I.CANCEL,'''') = '''' '  "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND I.CATCODE IN (SELECT CATCODE FROM CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..METALMAST))'  "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND TRANTYPE IN(''OD'',''RD'',''SA'') '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND NOT EXISTS (SELECT 1 FROM '+@DBNAME+'..ACCTRAN WHERE BATCHNO =I.BATCHNO AND PAYMODE=''CN'')'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' GROUP BY I.TRANDATE,TRANNO,BATCHNO,I.SNO,I.COSTID,I.COMPANYID'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ORDER BY I.TRANDATE,TRANNO'"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY='INSERT INTO TEMPTABLEDB..TEMPGSTRPT(PARTICULAR,AMOUNT,GST,ITAX,CTAX,STAX,RESULT,COLHEAD,SNO,COSTID) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' SELECT ''TOTAL'' ,SUM(AMOUNT),SUM(GST),SUM(ITAX),SUM(CTAX),SUM(STAX),3,''G'','''','''' FROM TEMPTABLEDB..TEMPGSTRPT'"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY='UPDATE TEMPTABLEDB..TEMPGSTRPT SET DIFF=ISNULL(GST,0)-(ISNULL(ITAX,0)+ISNULL(CTAX,0)+ISNULL(STAX,0))'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY='UPDATE TEMPTABLEDB..TEMPGSTRPT SET BILLTYPE=''SG'' WHERE STATE=COMPANYSTATE'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' UPDATE TEMPTABLEDB..TEMPGSTRPT SET BILLTYPE=''IG'' WHERE STATE<>COMPANYSTATE'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY='SELECT * FROM TEMPTABLEDB..TEMPGSTRPT ORDER BY RESULT,INVDATE,TRANNO'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub PROC_GSTR1A()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_GSTR1A')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_GSTR1A"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE PROC_GSTR1A"
        strSql += vbCrLf + " (      "
        strSql += vbCrLf + "  @DBNAME VARCHAR(20)      "
        strSql += vbCrLf + "  ,@MONTH INT      "
        strSql += vbCrLf + "  ,@YEAR INT      "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(3)      "
        strSql += vbCrLf + "  ,@COSTNAME VARCHAR(200)      "
        strSql += vbCrLf + "  ,@OPTION VARCHAR(15)      "
        strSql += vbCrLf + "  ,@STATEID VARCHAR(50)      "
        strSql += vbCrLf + "  ,@ADVGST VARCHAR(1)      "
        strSql += vbCrLf + "  ,@WITHSR VARCHAR(1)      "
        strSql += vbCrLf + "  ,@GSTDATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@BILLPREFIXDB VARCHAR(1)      "
        strSql += vbCrLf + "  ,@METALID VARCHAR(1)"
        strSql += vbCrLf + "  ,@GROUPBYCOSTCENTRE VARCHAR(1) "
        strSql += vbCrLf + "  ,@RDSEPBILLCHECK VARCHAR(1) "
        strSql += vbCrLf + "  ,@DATECHECK VARCHAR(1) "
        strSql += vbCrLf + "  ,@DATEFROM  VARCHAR(12) "
        strSql += vbCrLf + "  ,@DATETO VARCHAR(12) "
        strSql += vbCrLf + "  ,@B2BPRJB VARCHAR(1) "
        strSql += vbCrLf + "  ,@HSNDISC VARCHAR(1) "
        strSql += vbCrLf + "  )      "
        strSql += vbCrLf + "  AS      "
        strSql += vbCrLf + "  BEGIN      "
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(MAX) "
        strSql += vbCrLf + "  EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME        "
        strSql += vbCrLf + "  SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2)'        "
        strSql += vbCrLf + "  EXEC (@QRY)        "
        strSql += vbCrLf + "  SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'        "
        strSql += vbCrLf + "  EXEC (@QRY)       "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPTCOST') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPTCOST"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT_SR') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT_SR"
        strSql += vbCrLf + "  DECLARE @CHITDB VARCHAR(15)"
        strSql += vbCrLf + "  SELECT @CHITDB=CTLTEXT FROM SOFTCONTROL WHERE CTLID='CHITDBPREFIX'"
        strSql += vbCrLf + "  DECLARE @BILLPREFIX AS VARCHAR(10)"
        strSql += vbCrLf + "  DECLARE @TRANYEAR AS VARCHAR(10)"
        strSql += vbCrLf + "  SELECT @TRANYEAR = SUBSTRING(DBNAME,5,4)  FROM DBMASTER WHERE CONVERT(VARCHAR,@YEAR)+'-'+CONVERT(VARCHAR,@MONTH)+'-01' BETWEEN STARTDATE AND ENDDATE"
        strSql += vbCrLf + "  SELECT @BILLPREFIX = CTLTEXT FROM SOFTCONTROL WHERE  CTLID='GSTR1_BILLPREFIX' "
        strSql += vbCrLf + "  SET NOCOUNT ON   "
        strSql += vbCrLf + "   IF @OPTION='B2B'  "
        strSql += vbCrLf + "  BEGIN      "
        strSql += vbCrLf + "  	SELECT @QRY =''"
        strSql += vbCrLf + "  	SELECT @QRY = CHAR(13)+' SELECT * '      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' INTO TEMPTABLEDB..TEMPGSTRPTCOST '      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' FROM ('         "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' SELECT GSTNO, TRANNO,PNAME AS PARTYNAME,TRANDATE,CAST(CONVERT(NUMERIC(15,2),SUM(AMOUNT)) AS VARCHAR)AMOUNT,STATE,RCM,INVTYPE,ECOMGSTNO,RATE'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CAST(CONVERT(NUMERIC(15,2),SUM(SGST)) AS VARCHAR)AS SGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CAST(CONVERT(NUMERIC(15,2),SUM(CGST)) AS VARCHAR)AS CGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CAST(CONVERT(NUMERIC(15,2),SUM(IGST)) AS VARCHAR)AS IGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CAST(CONVERT(NUMERIC(15,2),SUM(TAX)) AS VARCHAR)AS TAX'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CESS,COLHEAD,RESULT,BATCHNO,IRN,ACKNO,COSTNAME FROM ('  "
        strSql += vbCrLf + "  	IF @BILLPREFIXDB='Y'"
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' SELECT P.GSTNO,(CASE WHEN ISNULL(BILLPREFIX,'''') <> '''' THEN  BILLPREFIX + ''/'' ELSE '''' END + CAST(TRANNO AS VARCHAR))TRANNO,P.PNAME,CAST(REPLACE(REPLACE(CONVERT(VARCHAR,I.TRANDATE,106), '' '',''-''), '','','''') AS VARCHAR)AS TRANDATE'      "
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' SELECT P.GSTNO, CAST(TRANNO AS VARCHAR)TRANNO,P.PNAME,CAST(REPLACE(REPLACE(CONVERT(VARCHAR,I.TRANDATE,106), '' '',''-''), '','','''') AS VARCHAR)AS TRANDATE'      "
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(15,2),SUM(AMOUNT)+ISNULL(SUM(TAX),0)) AMOUNT'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 CAST(STATECODE AS VARCHAR)+''-''+CAST(STATENAME AS VARCHAR) FROM STATEMAST WHERE STATEID=P.STATEID) AS STATE'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,''N'' AS RCM,CASE WHEN ISNULL((SELECT TOP 1 EINVOICETYPE FROM CUSTOMERINFO WHERE BATCHNO=I.BATCHNO),'''') <>'''' THEN '      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' (SELECT TOP 1 EINVOICETYPE FROM CUSTOMERINFO WHERE BATCHNO=I.BATCHNO) ELSE ''Regular'' END AS INVTYPE '      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS ECOMGSTNO'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 CAST(ISNULL(S_SGSTTAX,0)+ISNULL(S_CGSTTAX,0) AS VARCHAR)FROM CATEGORY WHERE CATCODE=I.CATCODE)AS RATE'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TRANTYPE=I.TRANTYPE AND TAXID=''SG'' AND ISNULL(STUDDED,'''')<>''Y'' ) AS SGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TRANTYPE=I.TRANTYPE AND TAXID=''CG'' AND ISNULL(STUDDED,'''')<>''Y'' ) AS CGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TRANTYPE=I.TRANTYPE AND TAXID=''IG'' AND ISNULL(STUDDED,'''')<>''Y'' ) AS IGST'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(15,2),SUM(AMOUNT)) AS TAX'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS CESS'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,'' '' AS COLHEAD,5 AS RESULT' "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,I.BATCHNO,(SELECT TOP 1 IRN FROM '+@DBNAME+'..EINVTRAN WHERE BATCHNO=I.BATCHNO)IRN'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 ACKNO FROM '+@DBNAME+'..EINVTRAN WHERE BATCHNO=I.BATCHNO)ACKNO,CO.COSTNAME'     "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' FROM '+@DBNAME+'..ISSUE I'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' LEFT JOIN CUSTOMERINFO C ON C.BATCHNO=I.BATCHNO'      "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' LEFT JOIN PERSONALINFO P ON P.SNO=C.PSNO'    "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+' LEFT JOIN COSTCENTRE CO ON CO.COSTID=I.COSTID' "
        strSql += vbCrLf + "  	IF @DATECHECK = 'Y'"
        strSql += vbCrLf + "  	BEGIN    "
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +CHAR(13)+'  WHERE I.TRANDATE BETWEEN ''' +@DATEFROM+''' AND '''+@DATETO+''' ' "
        strSql += vbCrLf + "  	END"
