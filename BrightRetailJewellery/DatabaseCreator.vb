        strSql += vbCrLf + "  		PRINT'/**************** SCHEME INFORMATION *************************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' SELECT ''' + @CASHACC + ''' = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE  CTLID=''CASH''"
        strSql += vbCrLf + "  		IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'COLSC'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'COLSC   "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(50),''SCHEME INFO'') AS CUSNAME,TRANNO,0 AS TAX,  "
