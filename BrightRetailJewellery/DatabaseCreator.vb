        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''ORDER ADVANCED''+'' ''+''['' + convert(varchar(25),SUM(PAYMENT))+'']'',''T''    FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADVANCE  "
