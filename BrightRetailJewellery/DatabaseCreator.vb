        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,SUM(MI_GRSWT)AS MI_GRSWT,SUM(MI_NETWT)MI_NETWT,SUM(MI_PUREWT)MI_PUREWT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,NULL MI_TOUCH,NULL MI_PURITY'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS MR_TRANNO,NULL AS MR_TRANDATE,SUM(MR_RECDWT) AS MR_RECDWT,SUM(MR_MELTLOSS)AS MR_MELTLOSS'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS  MR_TOUCH,SUM(MR_SAMPLEWT)AS MR_SAMPLEWT,SUM(MR_SCRAPWT)AS MR_SCRAPWT ,SUM(MR_NETWT)AS MR_NETWT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' , SUM(MR_PUREWT)AS MR_PUREWT,SUM(MR_RATE)AS MR_RATE,NULL MR_PURITY'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,SUM(MR_CHARGE)AS MR_CHARGE,NULL AS PI_ACNAME, NULL AS PI_TRANNO,NULL AS PI_TRANDATE,SUM(PI_GRSWT)AS PI_GRSWT,SUM(PI_PUREWT)PI_PUREWT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS PR_TRANNO,NULL AS PR_TRANDATE,SUM(PR_GRSWT)AS PR_GRSWT,SUM(PR_PUREWT)AS PR_PUREWT,NULL AS PR_PURITY'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,''5'' AS RESULT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'MELTINGDETAIL '"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' WHERE RESULT=''1'''"
        strSql += vbCrLf + " 	PRINT (@QRY)"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	IF @GROUPBY ='Y'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY='SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'MELTINGDETAIL ORDER BY CATNAME,RESULT,DORDER'		"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	IF @GROUPBY <>'Y'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY='SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'MELTINGDETAIL ORDER BY RESULT'"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_EXEMPTIONREPORT()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_EXEMPTION')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_EXEMPTION"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_EXEMPTION"
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @FROMDATE VARCHAR(50)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(50)"
        strSql += vbCrLf + " ,@OPTIONID VARCHAR(50)"
        strSql += vbCrLf + " ,@COSTID VARCHAR(500)  "
        strSql += vbCrLf + " ,@FORMAT INT"
        strSql += vbCrLf + " ,@DBNAME VARCHAR(20)"
        strSql += vbCrLf + " ,@WITHDISC VARCHAR(1)"
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000) "
        strSql += vbCrLf + " 	SELECT @COSTID =REPLACE(@COSTID,',',''',''')    "
        strSql += vbCrLf + " 	IF @FORMAT=1"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY= 'IF OBJECT_ID(''TEMPTABLEDB..EXEMPTION'') IS NOT NULL DROP TABLE TEMPTABLEDB..EXEMPTION'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'CREATE TABLE TEMPTABLEDB..EXEMPTION(PARTICULAR VARCHAR(500)'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + ',COSTNAME VARCHAR(500),OPTIONNAME VARCHAR(100),USERNAME VARCHAR(50),DESCRIPTION VARCHAR(1000)'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + ',EXEMPDATE SMALLDATETIME,EXEMPTIME SMALLDATETIME,RESULT INT,)'"
        strSql += vbCrLf + " 		PRINT @QRY "
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY='INSERT INTO TEMPTABLEDB..EXEMPTION(COSTNAME,OPTIONNAME,USERNAME,'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'DESCRIPTION,EXEMPDATE,EXEMPTIME,RESULT)'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' SELECT DISTINCT CONVERT (VARCHAR(50),CO.COSTNAME) AS COSTNAME,OPT.OPTIONNAME AS OPTIONNAME,UM.USERNAME AS USERNAME'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +',EXE.DESCRIPTION AS DESCRIPTION ,EXE.EXEMPDATE AS EXEMPDATE,EXE.EXEMPTIME AS EXEMPTIME,2 RESULT' "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' FROM EXEMPTION AS EXE'  "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' LEFT JOIN COSTCENTRE AS CO ON EXE.COSTID = CO.COSTID'  "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' LEFT JOIN USERMASTER AS UM ON UM.USERID = EXE.EXEMPUSER'   "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' LEFT JOIN PRJPWDOPTION AS OPT ON OPT.OPTIONID = EXE.OPTIONID'  "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) +' WHERE EXE.EXEMPDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + " 		IF @OPTIONID<>'' AND @OPTIONID<>'ALL' SELECT @QRY= @QRY + CHAR(13) + ' AND EXE.OPTIONID = '''+@OPTIONID+'''' "
        strSql += vbCrLf + " 		IF @COSTID<>'ALL' AND @COSTID<>'' SELECT @QRY= @QRY + CHAR(13) +' AND EXE.COSTID IN('''+ @COSTID +''')'"
        strSql += vbCrLf + " 		PRINT @QRY "
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'INSERT INTO TEMPTABLEDB..EXEMPTION(PARTICULAR,COSTNAME,RESULT)'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'SELECT DISTINCT COSTNAME,COSTNAME,1 RESULT FROM TEMPTABLEDB..EXEMPTION'"
        strSql += vbCrLf + " 		PRINT @QRY "
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'SELECT DISTINCT * FROM TEMPTABLEDB..EXEMPTION ORDER BY COSTNAME,RESULT'"
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY='IF OBJECT_ID(''TEMPTABLEDB..PWDREPORT'') IS NOT NULL DROP TABLE TEMPTABLEDB..PWDREPORT'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'CREATE TABLE TEMPTABLEDB..PWDREPORT (BILLNO INT,DATE SMALLDATETIME,TIME SMALLDATETIME,ID VARCHAR(25),USERNAME VARCHAR(40),TYPEOFOTP VARCHAR(50),'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'DISCALLOWAMT NUMERIC(20,2),DISCOUNT NUMERIC(20,2),TOCOSTID VARCHAR(2),BUSERNAME VARCHAR(50),REMARKS VARCHAR(250),CLOSEOTPDATEANDTIME SMALLDATETIME,STATUS VARCHAR(20))'"
        strSql += vbCrLf + " 		PRINT @QRY "
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY=  'INSERT INTO TEMPTABLEDB..PWDREPORT (BILLNO,DATE,TIME,ID,USERNAME,TYPEOFOTP,DISCALLOWAMT,DISCOUNT,TOCOSTID,BUSERNAME,REMARKS,CLOSEOTPDATEANDTIME,STATUS)'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'SELECT DISTINCT A.TRANNO,A.TRANDATE AS DATE,P.PWDTIME AS TIME,P.PWDID AS ID,U.USERNAME AS USERNAME'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + ',CASE WHEN OPT.OPTIONNAME IS NULL THEN ''GENERAL DISCOUNT'' ELSE OPT.OPTIONNAME END AS TYPEOFOTP'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + ',D.DISCLIMITAMT,D.DISCALLOWAMT,P.COSTID AS TOCOSTID,'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'UM.USERNAME AS BUSERNAME,P.REMARKS AS REMARKS,CASE WHEN P.PWDCLSDATE=''01-01-1900'' THEN NULL '"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'ELSE P.PWDCLSDATE END  AS CLOSEOTPDATEANDTIME,'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'CASE WHEN P.PWDSTATUS = ''N'' '"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'AND P.PWDDATE=SUBSTRING(CONVERT (VARCHAR,GETDATE() ,121),1,10) THEN ''PENDING'' '"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'WHEN P.PWDSTATUS = ''C'' THEN ''CLOSED'' ELSE ''EXPIRED'' END  AS STATUS '"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'FROM '+@DBNAME+'..DISCHISTORY AS D'"
        strSql += vbCrLf + " 		IF @WITHDISC='Y'"
        strSql += vbCrLf + " 		    SELECT @QRY= @QRY + CHAR(13) + 'LEFT JOIN PWDMASTER AS P ON D.PWDID=P.PWDID'"
        strSql += vbCrLf + " 		ELSE"
        strSql += vbCrLf + " 		    SELECT @QRY= @QRY + CHAR(13) + 'INNER JOIN PWDMASTER AS P ON D.PWDID=P.PWDID'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'LEFT JOIN PRJPWDOPTION AS OPT  ON P.PWDOPTIONID=OPT.OPTIONID'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'LEFT JOIN '+@DBNAME+'..ACCTRAN AS A ON A.BATCHNO=D.BATCHNO'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'LEFT JOIN USERMASTER AS U ON P.CRUSERID=U.USERID'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'LEFT JOIN USERMASTER AS UM ON P.PWDUSERID=UM.USERID'"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY + CHAR(13) + 'WHERE A.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + " 		IF @OPTIONID<>'' AND @OPTIONID<>'ALL' SELECT @QRY= @QRY + CHAR(13) + ' AND P.PWDOPTIONID = '''+@OPTIONID+'''' "
        strSql += vbCrLf + " 		IF @COSTID<>'ALL' AND @COSTID<>'' SELECT @QRY= @QRY + CHAR(13) +' AND P.COSTID IN('''+ @COSTID +''')'"
        strSql += vbCrLf + " 		PRINT @QRY "
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY= CHAR(13) + 'SELECT*FROM TEMPTABLEDB..PWDREPORT ORDER BY ID DESC '"
        strSql += vbCrLf + " 		EXEC (@QRY)"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

