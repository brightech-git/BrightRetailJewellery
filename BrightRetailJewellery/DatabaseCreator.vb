        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' T.TRANDATE,CASE WHEN '''+@ORDERBY+'''=''G'' AND PAYMODE IN(''SA'',''PU'',''SR'',''SV'',''PV'',''RV'',''RO'') THEN NULL ELSE TRANNO END TRANNO'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,CASE WHEN '''+@OPENING+''' = ''Y'' THEN '''' ELSE '''' END'"
