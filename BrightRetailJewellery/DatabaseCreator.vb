        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' I.BATCHNO,I.TRANTYPE,I.REMARK1  REMARKS,I.GRSWT,I.NETWT   '  "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' FROM  ISSUE AS I '  "
