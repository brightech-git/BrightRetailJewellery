        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND COMPANYID =  '''+@COMPANYID+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' UNION ALL'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ACCODE,(-1)*GRSWT AS GWEIGHT,(-1)*NETWT AS NWEIGHT,(-1)*PUREWT AS PWEIGHT,0 AMOUNT ,REMARK1 AS  REMARK FROM ISSUE I'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' WHERE TRANDATE < '''+@FROMDATE+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ISNULL(CANCEL,'''') = '''' AND (TRANTYPE NOT IN (''AI'')  OR (TRANTYPE=''SA'' AND TRANFLAG =''W''))  AND COMPANYID =  '''+@COMPANYID+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + @APPTYPE "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' UNION ALL'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ACCODE, GRSWT AS GWEIGHT, NETWT AS NWEIGHT, PUREWT AS PWEIGHT, 0 AMOUNT ,REMARK1 AS  REMARK FROM RECEIPT I'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' WHERE TRANDATE < '''+@FROMDATE+''' AND ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ISNULL(CANCEL,'''') = '''' AND (TRANTYPE NOT IN (''RPU'',''PU'')  OR (TRANTYPE=''PU'' AND TRANFLAG =''W''))  AND COMPANYID =  '''+@COMPANYID+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + @APPTYPE "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' UNION ALL'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ACCODE,0 AS GWEIGHT,0 AS NWEIGHT,0 AS PWEIGHT,CASE WHEN TRANMODE = ''C'' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT ,REMARK1'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' FROM ACCTRAN WHERE TRANDATE < '''+@FROMDATE+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ISNULL(CANCEL,'''') = '''' AND COMPANYID =  '''+@COMPANYID+''''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' )X GROUP BY ACCODE,REMARK'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      SELECT @QRY= ' UPDATE TEMPTABLEDB..TEMPCUSTLEDGER SET TRESULT = 2 WHERE TRESULT IS NULL '"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      /** INSERT INTO TITLE **/      "
        strSql += vbCrLf + "      SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,TRESULT,COLHEAD)'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT DISTINCT (SELECT ACNAME FROM " & cnAdminDb & "..ACHEAD WHERE ACCODE = T.ACCODE)AS ACNAME,ACCODE,0 TRESULT,''T'''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      /** INSERT INTO SUBTOTAL **/      "
        strSql += vbCrLf + "      SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,LESSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ''SUBTOTAL'',ACCODE,SUM(GRSWT),SUM(LESSWT),SUM(NETWT),SUM(PUREWT),SUM(AMOUNT),3 TRESULT,''S'''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T GROUP BY ACCODE'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      SELECT @QRY= ' IF '''+@CUMULATIVE+'''=''Y'''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' BEGIN'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' DELETE FROM TEMPTABLEDB..TEMPCUSTLEDGER WHERE ISNULL(COLHEAD,'''') <> ''G'''"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' UPDATE  TEMPTABLEDB..TEMPCUSTLEDGER'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SET PARTICULAR = IsNull((SELECT ACNAME FROM " & cnAdminDb & "..ACHEAD where accode=T.accode),''NoAcName'') ,'      "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' COLHEAD=NULL from  TEMPTABLEDB..TEMPCUSTLEDGER as T'      "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' INSERT INTO  TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,GRSWT,LESSWT,NETWT,PUREWT,AMOUNT,TResult,AcCode,ColHead)'      "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ''Total'',SUM(GRSWT),SUM(LESSWT),SUM(NETWT),SUM(PUREWT),SUM(AMOUNT),3,''zzzz'',''G''   FROM  TEMPTABLEDB..TEMPCUSTLEDGER'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ''BALANCE'',''zzzz'',SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),SUM(ISNULL(PUREWT,0))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,CASE WHEN SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) > 0 THEN SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) ELSE SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) END AS AMOUNT'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,4 TRESULT,''S1''COLHEAD FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T WHERE TRESULT IN (1,2) GROUP BY ACCODE'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' END'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ELSE'  "
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' BEGIN'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' /** INSERT INTO BALANCE **/'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' SELECT ''BALANCE'',ACCODE,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),SUM(ISNULL(PUREWT,0))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,SUM(ISNULL(AMOUNT,0)) AMOUNT,4 TRESULT,''S1''COLHEAD'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T WHERE TRESULT IN (1,2) GROUP BY ACCODE'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' END'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      SELECT @QRY= ' UPDATE TEMPTABLEDB..TEMPCUSTLEDGER SET AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END'"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "      SELECT @QRY= ' SELECT * FROM TEMPTABLEDB..TEMPCUSTLEDGER ORDER BY ACCODE,TRESULT,TRANDATE,BATCHNO,TRANNO,RESULT,TRANTYPE DESC'"
        strSql += vbCrLf + "      EXEC (@QRY)"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Private Function Sp_RPT_WS_Dealer_SmithLedgerReport() As Integer


        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE UPPER(NAME)='SP_RPT_W_LEDGERREPORT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_W_LEDGERREPORT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE  procedure [dbo].[SP_RPT_W_LEDGERREPORT]"
        strSql += vbCrLf + " @COMPANYID VARCHAR(5),@FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@CUMULATIVE VARCHAR(1),      "
        strSql += vbCrLf + " @CUSTNAME VARCHAR(8000)"
        strSql += vbCrLf + " as      "
        strSql += vbCrLf + " set nocount on"
        strSql += vbCrLf + " DECLARE @TEMP_ACNAME VARCHAR(250)      "
        strSql += vbCrLf + " IF OBJECT_ID('TEMP..TEMP_ACHEAD', 'U') IS NOT NULL DROP TABLE #TEMP_ACHEAD        "
        strSql += vbCrLf + " CREATE TABLE #TEMP_ACHEAD (ACNAME VARCHAR(250))     "
        strSql += vbCrLf + " IF CHARINDEX(',',@CUSTNAME)=0     "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @CUSTNAME     "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@CUSTNAME)>0     "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @TEMP_ACNAME=LEFT(@CUSTNAME,CHARINDEX(',',@CUSTNAME)-1)  "
        strSql += vbCrLf + " SET @CUSTNAME=RIGHT(@CUSTNAME,LEN(@CUSTNAME)-CHARINDEX(',',@CUSTNAME))"
        strSql += vbCrLf + " IF @CUSTNAME <>'' AND CHARINDEX(',',@CUSTNAME)=0     "
        strSql += vbCrLf + " SET @CUSTNAME= @CUSTNAME + ','   "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @TEMP_ACNAME"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF OBJECT_ID('TEMPTABLEDB..TEMPCUSTLEDGER') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCUSTLEDGER      "
        strSql += vbCrLf + " SELECT  I.TRANDATE, I.TRANNO, 'RECEIPT' TRANTYPE"
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),CASE WHEN I.ITEMID <> 0 THEN (SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID)      "
        strSql += vbCrLf + " ELSE CASE WHEN I.TRANTYPE = 'RRC' THEN 'RATE CUT @'+CONVERT(VARCHAR(10),RATE) ELSE CASE WHEN FLAG ='M' THEN 'METAL' WHEN FLAG ='O' THEN 'ORNAMENT' ELSE 'OTHER'  END END  END) AS PARTICULAR      "
        strSql += vbCrLf + " ,I.GRSWT,I.LESSWT,I. NETWT,I.TOUCH,I.PUREWT      "
        strSql += vbCrLf + "  ,0 AS AMOUNT"
        strSql += vbCrLf + " ,BATCHNO,I.ACCODE,CONVERT(INT,1)RESULT      "
        strSql += vbCrLf + " ,CONVERT(INT,2)TRESULT      "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(3),NULL) COLHEAD      "
        strSql += vbCrLf + " INTO TEMPTABLEDB..TEMPCUSTLEDGER      "
        strSql += vbCrLf + " FROM " & tranDbName & "..W_RECEIPT AS I      "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND COMPANYID =  @COMPANYID"
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'') = ''  AND (TRANTYPE NOT IN ('PU','RPU') or (trantype='PU' and TRANFLAG ='W')) "
        strSql += vbCrLf + " AND I.ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " UNION ALL "
        strSql += vbCrLf + " SELECT I.TRANDATE, I.TRANNO"
        strSql += vbCrLf + " ,CONVERT(vARCHAR(30),CASE WHEN TRANTYPE = 'SA' THEN 'SALES' ELSE 'ISSUE' END) TRANTYPE      "
        strSql += vbCrLf + " ,CASE WHEN I.ITEMID <> 0 THEN (SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID)      "
        strSql += vbCrLf + " ELSE CASE WHEN I.TRANTYPE = 'IRC' THEN 'RATE CUT @'+CONVERT(VARCHAR(10),RATE) ELSE CASE WHEN FLAG ='M' THEN 'METAL' WHEN FLAG ='O' THEN 'ORNAMENT' ELSE 'OTHER'  END END END AS PARTICULAR      "
        strSql += vbCrLf + " ,I.GRSWT*(-1) GRSWT,I.LESSWT*(-1) LESSWT,I.NETWT*(-1) NETWT,I.TOUCH,I.PUREWT*(-1) PUREWT      "
        strSql += vbCrLf + " , CONVERT(NUMERIC(15,2),NULL)RECAMT"
        strSql += vbCrLf + " ,BATCHNO,I.ACCODE ,CONVERT(INT,1)RESULT      "
        strSql += vbCrLf + " ,CONVERT(INT,2)TRESULT      "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(3),NULL) COLHEAD      "
        strSql += vbCrLf + " FROM " & tranDbName & "..W_ISSUE AS I      "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND (I.TRANTYPE NOT IN('SA') or (I.trantype='SA' and I.TRANFLAG ='W') ) AND COMPANYID =  @COMPANYID      "
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'') = ''  "
        strSql += vbCrLf + " AND I.ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + "   /** INSERTING CONVERTION DETAILS **/      "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER      "
        strSql += vbCrLf + " (TRANTYPE,PARTICULAR,TRANDATE,TRANNO,GRSWT,NETWT,PUREWT,AMOUNT,ACCODE,BATCHNO,RESULT)      "
        strSql += vbCrLf + " SELECT CASE WHEN FROMFLAG = 'P' THEN 'CONVERTION' ELSE 'OTHER' END ,'RATE CUT ('+CONVERT(VARCHAR(12),PUREWT)+'X'+CONVERT(VARCHAR(10),RATE)+')',TRANDATE,TRANNO,"
        strSql += vbCrLf + " 0,0,0,"
        strSql += vbCrLf + " --(CASE WHEN GRSWT =0 THEN PUREWT ELSE GRSWT END)*(-1),(CASE WHEN NETWT =0 THEN PUREWT ELSE NETWT END)*(-1),PUREWT*(-1)PUREWT,"
        strSql += vbCrLf + " AMOUNT ,ACCODE,BATCHNO,10 FROM " & tranDbName & "..W_ACCTRAN T      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND FROMFLAG ='W' AND COMPANYID =  @COMPANYID"
        strSql += vbCrLf + " --AND NOT EXISTS (SELECT 1 FROM TEMPTABLEDB..TEMPCUSTLEDGER WHERE BATCHNO = T.BATCHNO) "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = ''      "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " UNION ALL "
        strSql += vbCrLf + " SELECT CASE WHEN FROMFLAG = 'P' THEN 'PAYMENT' ELSE 'OTHER' END,'RATE CUT ('+CONVERT(VARCHAR(12),PUREWT)+'X'+CONVERT(VARCHAR(10),RATE)+')',TRANDATE,TRANNO,"
        strSql += vbCrLf + " 0,0,0,"
        strSql += vbCrLf + " --ISNULL(GRSWT,PUREWT),ISNULL(NETWT,PUREWT),0 PUREWT,"
        strSql += vbCrLf + " CASE WHEN TRANMODE='C' THEN AMOUNT ELSE AMOUNT *(-1) END  AMOUNT,ACCODE,BATCHNO,11 FROM " & tranDbName & "..W_ACCTRAN T      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + " AND FROMFLAG = 'T' --AMOUNT TO WEIGHT      "
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = ''  AND COMPANYID =  @COMPANYID    "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT CASE WHEN PAYMODE = 'CP' THEN 'CASH PAYMENT' WHEN PAYMODE = 'CR' THEN  'CASH RECEIPT' ELSE 'OTHER'  END, "
        strSql += vbCrLf + " CASE WHEN FROMFLAG ='S' AND PAYMODE = 'TR' AND ISNULL(NETWT,0)<>0 then 'Dir Purch.'+ convert(varchar(10),netwt)+' Avg @'+CONVERT(varchar(12),CONVERT(DECIMAL(12,2),(AMOUNT/netwt))) "
        strSql += vbCrLf + " WHEN FROMFLAG ='S' AND PAYMODE = 'TR' AND ISNULL(NETWT,0)=0 then 'Dir Purch.'+ convert(varchar(10),netwt)+' Avg @'+CONVERT(varchar(12),CONVERT(DECIMAL(12,2),(AMOUNT))) else '' end "
        strSql += vbCrLf + " ,TRANDATE,TRANNO,"
        strSql += vbCrLf + " 0,0,0,"
        strSql += vbCrLf + " CASE WHEN  TRANMODE = 'D' THEN AMOUNT *(-1) ELSE AMOUNT END AMOUNT,ACCODE,BATCHNO,11 FROM " & tranDbName & "..W_ACCTRAN T      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND  FROMFLAG NOT IN ('T','W')"
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = '' AND COMPANYID =  @COMPANYID     "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER      "
        strSql += vbCrLf + " (PARTICULAR,GRSWT,NETWT,PUREWT,AMOUNT,ACCODE,TRESULT)      "
        strSql += vbCrLf + " SELECT"
        strSql += vbCrLf + " 'OPENING..' PARTICULAR      "
        strSql += vbCrLf + " ,SUM(GWEIGHT) AS GRSWT"
        strSql += vbCrLf + " ,SUM(GWEIGHT) AS NETWT"
        strSql += vbCrLf + " ,SUM(PWEIGHT) AS PUREWT"
        strSql += vbCrLf + " ,SUM(AMOUNT) AS AMOUNT"
        strSql += vbCrLf + " ,ACCODE,1 TRESULT      "
        strSql += vbCrLf + " FROM (      "
        strSql += vbCrLf + " select ACCODE,0 GWEIGHT,0 NWEIGHT,0 PWEIGHT,DEBIT-CREDIT AMOUNT  from " & tranDbName & "..W_opentrailbalance"
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND COMPANYID =  @COMPANYID"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT ACCODE,"
        strSql += vbCrLf + " CASE WHEN TRANTYPE = 'I' THEN (-1)*GRSWT ELSE GRSWT END AS GWEIGHT,      "
        strSql += vbCrLf + " CASE WHEN TRANTYPE = 'I' THEN (-1)*NETWT ELSE NETWT END AS NWEIGHT,      "
        strSql += vbCrLf + " CASE WHEN TRANTYPE = 'I' THEN (-1)*PUREWT ELSE PUREWT END AS PWEIGHT,      "
        strSql += vbCrLf + " 0      RECAMT"
        strSql += vbCrLf + " FROM " & tranDbName & "..W_OPENWEIGHT"
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND COMPANYID =  @COMPANYID"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT ACCODE,"
        strSql += vbCrLf + " (-1)*GRSWT AS GWEIGHT,      "
        strSql += vbCrLf + " (-1)*NETWT AS NWEIGHT,      "
        strSql += vbCrLf + " (-1)*PUREWT AS PWEIGHT,      "
        strSql += vbCrLf + " 0      AMOUNT"
        strSql += vbCrLf + " FROM " & tranDbName & "..W_ISSUE"
        strSql += vbCrLf + " WHERE TRANDATE < @FROMDATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND (TRANTYPE NOT IN ('AI','IAP')  or (trantype='SA' and TRANFLAG ='W'))  AND COMPANYID =  @COMPANYID     "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT ACCODE, GRSWT AS GWEIGHT, NETWT AS NWEIGHT, PUREWT AS PWEIGHT,      "
        strSql += vbCrLf + " 0   AMOUNT"
        strSql += vbCrLf + " FROM " & tranDbName & "..W_RECEIPT"
        strSql += vbCrLf + " WHERE TRANDATE < @FROMDATE      "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND (TRANTYPE NOT IN ('RPU','PU')  or (trantype='PU' and TRANFLAG ='W'))  AND COMPANYID =  @COMPANYID     "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT ACCODE,0 AS GWEIGHT,0 AS NWEIGHT,0 AS PWEIGHT,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT      "
        strSql += vbCrLf + " FROM " & tranDbName & "..W_ACCTRAN"
        strSql += vbCrLf + " WHERE TRANDATE < @FROMDATE "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND COMPANYID =  @COMPANYID"
        strSql += vbCrLf + " )X GROUP BY ACCODE      "
        strSql += vbCrLf + " UPDATE TEMPTABLEDB..TEMPCUSTLEDGER SET TRESULT = 2 WHERE TRESULT IS NULL      "
        strSql += vbCrLf + " /** INSERT INTO TITLE **/      "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,TRESULT,COLHEAD)      "
        strSql += vbCrLf + " SELECT DISTINCT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE)AS ACNAME,ACCODE,0 TRESULT,'T'      "
        strSql += vbCrLf + " FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T      "
        strSql += vbCrLf + " /** INSERT INTO SUBTOTAL **/      "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,LESSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)      "
        strSql += vbCrLf + " SELECT 'SUBTOTAL',ACCODE,sum(GRSWT),sum(LESSWT),sum(NETWT),sum(PUREWT),SUM(AMOUNT),3 TRESULT,'S'      "
        strSql += vbCrLf + " FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T GROUP BY ACCODE"
        strSql += vbCrLf + " IF @CUMULATIVE='Y'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " delete from TEMPTABLEDB..TEMPCUSTLEDGER where IsNull(COLHEAD,'') <> 'G'      "
        strSql += vbCrLf + " update  TEMPTABLEDB..TEMPCUSTLEDGER "
        strSql += vbCrLf + " set PARTICULAR = IsNull((SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD where accode=T.accode),'NoAcName') ,      "
        strSql += vbCrLf + " COLHEAD=null from  TEMPTABLEDB..TEMPCUSTLEDGER as T      "
        strSql += vbCrLf + " INSERT INTO  TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,GRSWT,LESSWT,NETWT,PUREWT,AMOUNT,TResult,AcCode,ColHead)      "
        strSql += vbCrLf + " SELECT 'Total',sum(GRSWT),sum(LESSWT),sum(NETWT),sum(PUREWT),Sum(AMOUNT),3,'zzzz','G'   from  TEMPTABLEDB..TEMPCUSTLEDGER  "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)      "
        strSql += vbCrLf + " SELECT 'BALANCE','zzzz'  "
        strSql += vbCrLf + " ,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),SUM(ISNULL(PUREWT,0))     "
        strSql += vbCrLf + " ,CASE WHEN SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) > 0 THEN SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) ELSE SUM(ISNULL(AMOUNT,0))-SUM(ISNULL(AMOUNT,0)) END AS AMOUNT    "
        strSql += vbCrLf + " ,4 TRESULT,'S1'COLHEAD      "
        strSql += vbCrLf + " FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T WHERE TRESULT IN (1,2) GROUP BY ACCODE"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " else  "
        strSql += vbCrLf + " begin"
        strSql += vbCrLf + " /** INSERT INTO BALANCE **/     "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..TEMPCUSTLEDGER(PARTICULAR,ACCODE,GRSWT,NETWT,PUREWT,AMOUNT,TRESULT,COLHEAD)      "
        strSql += vbCrLf + " SELECT 'BALANCE',ACCODE      "
        strSql += vbCrLf + " ,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),SUM(ISNULL(PUREWT,0))     "
        strSql += vbCrLf + " ,SUM(ISNULL(AMOUNT,0)) AMOUNT,4 TRESULT,'S1'COLHEAD      "
        strSql += vbCrLf + " FROM TEMPTABLEDB..TEMPCUSTLEDGER AS T WHERE TRESULT IN (1,2) GROUP BY ACCODE"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " UPDATE TEMPTABLEDB..TEMPCUSTLEDGER SET AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END      "
        strSql += vbCrLf + " SELECT * FROM TEMPTABLEDB..TEMPCUSTLEDGER ORDER BY ACCODE,TRESULT,TRANDATE,BATCHNO,TRANNO,RESULT,TRANTYPE DESC   "
        '        printline(strSql)


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Private Function SP_RPT_PURCHASEVAT_ED() As Integer
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE UPPER(NAME)='SP_RPT_PURCHASEVAT_ED')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PURCHASEVAT_ED"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_PURCHASEVAT_ED"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@FROMDATE SMALLDATETIME"
        strSql += vbCrLf + ",@TODATE SMALLDATETIME"
        strSql += vbCrLf + ",@RPTTYPE VARCHAR(1)"
        strSql += vbCrLf + ",@COMPANYNAME VARCHAR(8000)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(8000)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(8000)"
        strSql += vbCrLf + ",@CATNAME VARCHAR(8000)"
        strSql += vbCrLf + ",@MONTHNAME VARCHAR(20)"
        strSql += vbCrLf + ",@ACTYPE VARCHAR(50)"
        strSql += vbCrLf + ",@LOCOUT VARCHAR(10)"
        strSql += vbCrLf + ",@TRANTYPE VARCHAR(8000)"
        strSql += vbCrLf + ",@INVAT VARCHAR(10)"
        strSql += vbCrLf + ",@GRADNTOT VARCHAR(1)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	SET NOCOUNT ON"
        strSql += vbCrLf + "	DECLARE @TEMP VARCHAR(200)"

        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPRECEIPT') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPRECEIPT"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPRECEIPTSTONE') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPRECEIPTSTONE    "

        strSql += vbCrLf + "	SELECT *,CONVERT(NUMERIC(15,2),NULL)AS EDVAL INTO TEMPTABLEDB..TEMPRECEIPT FROM RECEIPT"
        strSql += vbCrLf + "	WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE "

        strSql += vbCrLf + "	UPDATE T SET EDVAL=TAXAMOUNT FROM TEMPTABLEDB..TEMPRECEIPT T ,TAXTRAN TT WHERE TT.ISSSNO=T.SNO"

        strSql += vbCrLf + "	SELECT *,CONVERT(NUMERIC(15,2),NULL)AS EDVAL INTO TEMPTABLEDB..TEMPRECEIPTSTONE FROM RECEIPTSTONE"
        strSql += vbCrLf + "	WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE "

        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPRECEIPTSTONE SET EDVAL=CONVERT(NUMERIC(15,2),(STNAMT*1/101)) "
        strSql += vbCrLf + "	WHERE ISSSNO IN(SELECT ISSSNO FROM TAXTRAN WHERE TRANTYPE ='RPU' AND TAXID='ED')"

        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPRECEIPTSTONE SET STNAMT=STNAMT-ISNULL(EDVAL,0)"
        strSql += vbCrLf + "	WHERE ISSSNO IN(SELECT ISSSNO FROM TAXTRAN WHERE TRANTYPE ='RPU' AND TAXID='ED')"

        strSql += vbCrLf + "	/** MONTH SEPERATION **/"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPMONTHH', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMONTHH"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPMONTHH (MONTHNAME VARCHAR(20),MM INT)"
        strSql += vbCrLf + "	DECLARE @DD SMALLDATETIME"
        strSql += vbCrLf + "	SELECT @DD = '2010-01-01'"
        strSql += vbCrLf + "	While 1 = 1"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPMONTHH (MONTHNAME,MM) SELECT DATENAME(MONTH,@DD),DATEPART(MONTH,@DD)"
        strSql += vbCrLf + "	IF DATEPART(MONTH,@DD) = 12"
        strSql += vbCrLf + "	BREAK"
        strSql += vbCrLf + "	SET @DD = DATEADD(MONTH,1,@DD)"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @MONTHNAME <> 'ALL'"
        strSql += vbCrLf + "	DELETE FROM TEMPTABLEDB..TEMPMONTHH WHERE MONTHNAME <> @MONTHNAME"
        strSql += vbCrLf + "	/** ACTYPE SEPERATION **/"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPACHEAD', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPACHEAD (ACCODE VARCHAR(7))"
        strSql += vbCrLf + "	IF @ACTYPE = 'ALL'"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD UNION ALL SELECT ''"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	IF CHARINDEX(',',@ACTYPE)=0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACTYPE = @ACTYPE"
        strSql += vbCrLf + "	IF @ACTYPE = 'C'"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ''"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@ACTYPE)>0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SET @TEMP=LEFT(@ACTYPE,CHARINDEX(',',@ACTYPE)-1)"
        strSql += vbCrLf + "	SET @ACTYPE=RIGHT(@ACTYPE,LEN(@ACTYPE)-CHARINDEX(',',@ACTYPE))"
        strSql += vbCrLf + "	IF @ACTYPE <>'' AND CHARINDEX(',',@ACTYPE)=0"
        strSql += vbCrLf + "	SET @ACTYPE= @ACTYPE + ','"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACTYPE = @TEMP"
        strSql += vbCrLf + "	IF @TEMP = 'C'"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ''"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE LOCALOUTST = '')"
        strSql += vbCrLf + "	IF CHARINDEX('L',@LOCOUT) = 0"
        strSql += vbCrLf + "	DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE LOCALOUTST = 'L')"
        strSql += vbCrLf + "	IF CHARINDEX('O',@LOCOUT) = 0"
        strSql += vbCrLf + "	DELETE FROM TEMPTABLEDB..TEMPACHEAD WHERE ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE LOCALOUTST = 'O')"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPTRANTYPE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPTRANTYPE"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPTRANTYPE (TRANTYPE VARCHAR(3))"
        strSql += vbCrLf + "	IF @TRANTYPE = '' OR @TRANTYPE = 'ALL'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)"
        strSql += vbCrLf + "	SELECT 'RPU' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "	SELECT 'RAP' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "	SELECT 'ROT' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "	SELECT 'RRE' AS TRANTYPE UNION ALL"
        strSql += vbCrLf + "	SELECT 'RIN' AS TRANTYPE "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF CHARINDEX(',PURCHASE',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RPU' AS TRANTYPE"
        strSql += vbCrLf + "	IF CHARINDEX(',RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RRE' AS TRANTYPE"
        strSql += vbCrLf + "	IF CHARINDEX(',APPROVAL RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RAP' AS TRANTYPE"
        strSql += vbCrLf + "	IF CHARINDEX(',OTHER RECEIPT',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'ROT' AS TRANTYPE"
        strSql += vbCrLf + "	IF CHARINDEX(',INTERNAL TRANSFER',','+@TRANTYPE) <> 0 INSERT INTO TEMPTABLEDB..TEMPTRANTYPE(TRANTYPE)SELECT 'RIN' AS TRANTYPE"
        strSql += vbCrLf + "	/** COMPANY SEPERATION **/"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(3))"
        strSql += vbCrLf + "	IF @COMPANYNAME = 'ALL'"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY UNION SELECT ''"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	IF CHARINDEX(',',@COMPANYNAME)=0"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYNAME = @COMPANYNAME"
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@COMPANYNAME)>0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SET @TEMP=LEFT(@COMPANYNAME,CHARINDEX(',',@COMPANYNAME)-1)"
        strSql += vbCrLf + "	SET @COMPANYNAME=RIGHT(@COMPANYNAME,LEN(@COMPANYNAME)-CHARINDEX(',',@COMPANYNAME))"
        strSql += vbCrLf + "	IF @COMPANYNAME <>'' AND CHARINDEX(',',@COMPANYNAME)=0"
        strSql += vbCrLf + "	SET @COMPANYNAME= @COMPANYNAME + ','"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYNAME = @TEMP"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	/** COSTNAME SEPERATION **/  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPCOSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSTCENTRE      "
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPCOSTCENTRE(COSTID VARCHAR(2))      "
        strSql += vbCrLf + "	IF @COSTNAME = 'ALL'  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE UNION SELECT ''  "
        strSql += vbCrLf + "	Else"
        strSql += vbCrLf + "	IF CHARINDEX(',',@COSTNAME)=0  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME    "
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@COSTNAME)>0      "
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SET @TEMP=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)      "
        strSql += vbCrLf + "	SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))      "
        strSql += vbCrLf + "	IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0      "
        strSql += vbCrLf + "	SET @COSTNAME= @COSTNAME + ','      "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMP  "
        strSql += vbCrLf + "	End"
        strSql += vbCrLf + "	/** METALNAME SEPERATION **/  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPMETAL', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMETAL  "
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPMETAL (METALID VARCHAR(1))      "
        strSql += vbCrLf + "	IF @METALNAME = 'ALL'  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST UNION SELECT ''  "
        strSql += vbCrLf + "	Else"
        strSql += vbCrLf + "	IF CHARINDEX(',',@METALNAME)=0  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME  "
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@METALNAME)>0      "
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SET @TEMP=LEFT(@METALNAME,CHARINDEX(',',@METALNAME)-1)      "
        strSql += vbCrLf + "	SET @METALNAME=RIGHT(@METALNAME,LEN(@METALNAME)-CHARINDEX(',',@METALNAME))      "
        strSql += vbCrLf + "	IF @METALNAME <>'' AND CHARINDEX(',',@METALNAME)=0      "
        strSql += vbCrLf + "	SET @METALNAME= @METALNAME + ','      "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPMETAL (METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @TEMP  "
        strSql += vbCrLf + "	End"
        strSql += vbCrLf + "	/** CATNAME SEPERATION **/  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPCATEGORY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCATEGORY  "
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TEMPCATEGORY (CATCODE VARCHAR(7))      "
        strSql += vbCrLf + "	IF @CATNAME = 'ALL'  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY UNION SELECT ''  "
        strSql += vbCrLf + "	Else"
        strSql += vbCrLf + "	IF CHARINDEX(',',@CATNAME)=0  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE CATNAME = @CATNAME  "
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@CATNAME)>0      "
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SET @TEMP=LEFT(@CATNAME,CHARINDEX(',',@CATNAME)-1)      "
        strSql += vbCrLf + "	SET @CATNAME=RIGHT(@CATNAME,LEN(@CATNAME)-CHARINDEX(',',@CATNAME))      "
        strSql += vbCrLf + "	IF @CATNAME <>'' AND CHARINDEX(',',@CATNAME)=0      "
        strSql += vbCrLf + "	SET @CATNAME= @CATNAME + ','      "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE CATNAME = @TEMP  "
        strSql += vbCrLf + "	End"
        strSql += vbCrLf + "	/** GETTTING VALUES FROM ORIGINAL TABLE **/  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPPURVATRPT','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPURVATRPT  "
        strSql += vbCrLf + "	SELECT TRANNO,REFNO ,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT"
        strSql += vbCrLf + "	,CONVERT(NUMERIC(15,2),ED) as ED"
        strSql += vbCrLf + "	,CONVERT(NUMERIC(15,2),ECESS)as ECESS"
        strSql += vbCrLf + "	,CONVERT(NUMERIC(15,2),HECESS)as HECESS"
        strSql += vbCrLf + "	,TAX,CTAX,(AMOUNT+TAX+CTAX+ED+ECESS+HECESS) AS TOTAL,TRANDATE,MMONTHNAME,MMONTHID,CATNAME,ACNAME,CENTRALTAXNO,CONVERT(VARCHAR(15),SNO)SNO,COSTID,GROUP1,GROUP2,ACCODE,CANCEL,ADDRESS,TYPE"
        strSql += vbCrLf + "	INTO TEMPTABLEDB..TEMPPURVATRPT  "
        strSql += vbCrLf + "	FROM"
        strSql += vbCrLf + "	(    "
        strSql += vbCrLf + "	SELECT DISTINCT R.TRANNO,R.REFNO,R.REFDATE,R.REMARK1 DESCRIPT,R.PCS,R.GRSWT,R.NETWT,  "
        strSql += vbCrLf + "	/** Includes Amount + Tax as Amount for outstation Customers**/  "
        strSql += vbCrLf + "	CASE WHEN @INVAT='I' THEN CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN   "
        strSql += vbCrLf + "	(R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0) +  "
        strSql += vbCrLf + "	R.TAX-ISNULL((SELECT SUM(TAX) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0))  "
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "	R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0)     "
        strSql += vbCrLf + "	End"
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "	R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0)   "
        strSql += vbCrLf + "	END  AMOUNT"
        strSql += vbCrLf + "	,ISNULL(EDVAL,0)-ISNULL((SELECT SUM(ISNULL(EDVAL,0)) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0)  as ED"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = R.SNO AND TRANTYPE=R.TRANTYPE AND TAXID='EC')as ECESS"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = R.SNO AND TRANTYPE=R.TRANTYPE AND TAXID='HE')as HECESS "
        strSql += vbCrLf + "	, CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN 0 ELSE  "
        strSql += vbCrLf + "	R.TAX-ISNULL((SELECT SUM(TAX) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0) END   "
        strSql += vbCrLf + "	TAX   "
        strSql += vbCrLf + "	,CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN CASE WHEN @INVAT='I' THEN 0 "
        strSql += vbCrLf + "	ELSE R.TAX-ISNULL((SELECT SUM(TAX) FROM TEMPTABLEDB..TEMPRECEIPTSTONE WHERE ISSSNO = R.SNO),0) END"
        strSql += vbCrLf + "	ELSE 0 END AS CTAX  "
        strSql += vbCrLf + "	,R.TRANDATE,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME    "
        strSql += vbCrLf + "	,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE('0',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID    "
        strSql += vbCrLf + "	,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'') <> '' THEN H.ACNAME ELSE P.PNAME END AS ACNAME  "
        strSql += vbCrLf + "	,H.CENTRALTAXNO,R.SNO,R.COSTID,R.ACCODE,R.CANCEL  "
        strSql += vbCrLf + "	,CONVERT(VARCHAR(300),NULL)GROUP1  "
        strSql += vbCrLf + "	,CONVERT(VARCHAR(300),NULL)GROUP2"
        strSql += vbCrLf + "	,(CASE WHEN ISNULL(H.ADDRESS1,'')<>'' THEN H.ADDRESS1 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS2,'')<>'' THEN  CHAR(13)+ H.ADDRESS2 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS3,'')<>'' THEN  CHAR(13)+ H.ADDRESS3 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.AREA,'')<>'' THEN  CHAR(13)+ H.AREA +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.CITY,'')<>'' THEN  CHAR(13)+ H.CITY  ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.PINCODE,'')<>'' THEN  '-'+ H.PINCODE  ELSE '' END) ADDRESS,'' TYPE"
        strSql += vbCrLf + "	FROM TEMPTABLEDB..TEMPRECEIPT R  "
        strSql += vbCrLf + "	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = R.CATCODE  "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..ACHEAD AS H ON H.ACCODE = R.ACCODE  "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS CU ON CU.BATCHNO = R.BATCHNO  "
        strSql += vbCrLf + "	LEFT JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = CU.PSNO  "
        strSql += vbCrLf + "	WHERE R.TRANDATE BETWEEN @FROMDATE AND @TODATE    "
        strSql += vbCrLf + "	AND ISNULL(R.CANCEL,'') = ''  "
        strSql += vbCrLf + "	AND R.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)  "
        strSql += vbCrLf + "	AND R.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "	AND R.CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))  "
        strSql += vbCrLf + "	AND DATENAME(MONTH,R.TRANDATE) IN (SELECT MONTHNAME FROM TEMPTABLEDB..TEMPMONTHH)  "
        strSql += vbCrLf + "	AND R.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)  "
        strSql += vbCrLf + "	AND R.TRANTYPE IN (SELECT TRANTYPE FROM TEMPTABLEDB..TEMPTRANTYPE)"
        strSql += vbCrLf + "	AND R.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)    "
        strSql += vbCrLf + "	UNION ALL"
        strSql += vbCrLf + "	SELECT DISTINCT R.TRANNO,R.REFNO,R.REFDATE,R.REMARK1 DESCRIPT,R.PCS*(-1) PCS,R.GRSWT*(-1) GRSWT,R.NETWT*(-1) NETWT,"
        strSql += vbCrLf + "	/** Includes Amount + Tax as Amount for outstation Customers**/  "
        strSql += vbCrLf + "	(CASE WHEN @INVAT='I' THEN  CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN   "
        strSql += vbCrLf + "	(R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) +  "
        strSql += vbCrLf + "	R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0))  "
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "	R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)     "
        strSql += vbCrLf + "	End"
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "	R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)   "
        strSql += vbCrLf + "	END)*(-1) AMOUNT"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = R.SNO AND TRANTYPE=R.TRANTYPE AND TAXID='ED')*(-1) as ED"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = R.SNO AND TRANTYPE=R.TRANTYPE AND TAXID='EC')*(-1) as ECESS"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = R.SNO AND TRANTYPE=R.TRANTYPE AND TAXID='HE')*(-1) as HECESS "
        strSql += vbCrLf + "	, (CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN 0 ELSE  "
        strSql += vbCrLf + "	R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END)*(-1) TAX   "
        strSql += vbCrLf + "	,(CASE WHEN ISNULL(H.LOCALOUTST,'')='O' THEN CASE WHEN @INVAT='I' THEN 0 "
        strSql += vbCrLf + "	ELSE R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END"
        strSql += vbCrLf + "	ELSE 0 END)*(-1) AS CTAX  "
        strSql += vbCrLf + "	,R.TRANDATE,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME    "
        strSql += vbCrLf + "	,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE('0',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID    "
        strSql += vbCrLf + "	,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'') <> '' THEN H.ACNAME ELSE P.PNAME END AS ACNAME  "
        strSql += vbCrLf + "	,H.CENTRALTAXNO,R.SNO,R.COSTID,R.ACCODE,R.CANCEL  "
        strSql += vbCrLf + "	,CONVERT(VARCHAR(300),NULL)GROUP1  "
        strSql += vbCrLf + "	,CONVERT(VARCHAR(300),NULL)GROUP2"
        strSql += vbCrLf + "	,(CASE WHEN ISNULL(H.ADDRESS1,'')<>'' THEN H.ADDRESS1 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS2,'')<>'' THEN  CHAR(13)+ H.ADDRESS2 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS3,'')<>'' THEN  CHAR(13)+ H.ADDRESS3 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.AREA,'')<>'' THEN  CHAR(13)+ H.AREA +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.CITY,'')<>'' THEN  CHAR(13)+ H.CITY  ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.PINCODE,'')<>'' THEN  '-'+ H.PINCODE  ELSE '' END) ADDRESS,' (PURCHASE RETURN)' TYPE"
        strSql += vbCrLf + "	FROM ISSUE R  "
        strSql += vbCrLf + "	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = R.CATCODE  "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..ACHEAD AS H ON H.ACCODE = R.ACCODE  "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS CU ON CU.BATCHNO = R.BATCHNO  "
        strSql += vbCrLf + "	LEFT JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = CU.PSNO  "
        strSql += vbCrLf + "	WHERE R.TRANDATE BETWEEN @FROMDATE AND @TODATE    "
        strSql += vbCrLf + "	AND ISNULL(R.CANCEL,'') = ''  "
        strSql += vbCrLf + "	AND R.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)  "
        strSql += vbCrLf + "	AND R.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "	AND R.CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))  "
        strSql += vbCrLf + "	AND DATENAME(MONTH,R.TRANDATE) IN (SELECT MONTHNAME FROM TEMPTABLEDB..TEMPMONTHH)  "
        strSql += vbCrLf + "	AND R.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)  "
        strSql += vbCrLf + "	AND R.TRANTYPE IN ('IPU')"
        strSql += vbCrLf + "	AND R.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)    "
        strSql += vbCrLf + "	)X    "
        strSql += vbCrLf + "	IF OBJECT_ID('MASTER..TT') IS NOT NULL DROP TABLE MASTER..TT    "
        strSql += vbCrLf + "	SELECT * INTO MASTER..TT FROM TEMPTABLEDB..TEMPPURVATRPT    "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPPURVATRPT    "
        strSql += vbCrLf + "	(TRANNO,REFNO ,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT,ED,ECESS,HECESS,TAX,TOTAL,TRANDATE,MMONTHNAME,MMONTHID,CATNAME,ACNAME,CENTRALTAXNO,SNO,COSTID,GROUP1,GROUP2,CANCEL,ACCODE,ADDRESS,TYPE)"
        strSql += vbCrLf + "	SELECT  "
        strSql += vbCrLf + "	DISTINCT R.TRANNO,R.REFNO ,R.REFDATE, R.REMARK1, S.STNPCS, S.STNWT, S.STNWT, S.STNAMT"
        strSql += vbCrLf + "	,ISNULL(EDVAL,0)"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = S.ISSSNO AND TRANTYPE=S.TRANTYPE AND TAXID='EC')as ECESS"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = S.ISSSNO AND TRANTYPE=S.TRANTYPE AND TAXID='HE')as HECESS "
        strSql += vbCrLf + "	,S.TAX"
        strSql += vbCrLf + "	,(S.STNAMT +ISNULL(S.TAX,0)+ISNULL(EDVAL,0)) AS TOTAL  "
        strSql += vbCrLf + "	,R.TRANDATE,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME    "
        strSql += vbCrLf + "	,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE('0',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID    "
        strSql += vbCrLf + "	,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'') <> '' THEN H.ACNAME ELSE P.PNAME END AS ACNAME"
        strSql += vbCrLf + "	,H.CENTRALTAXNO,R.SNO,R.COSTID,CONVERT(VARCHAR(300),NULL)GROUP1,CONVERT(VARCHAR(300),NULL)GROUP2"
        strSql += vbCrLf + "	,R.CANCEL,R.ACCODE,(CASE WHEN ISNULL(H.ADDRESS1,'')<>'' THEN H.ADDRESS1 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS2,'')<>'' THEN  CHAR(13)+ H.ADDRESS2 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS3,'')<>'' THEN  CHAR(13)+ H.ADDRESS3 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.AREA,'')<>'' THEN  CHAR(13)+ H.AREA +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.CITY,'')<>'' THEN  CHAR(13)+ H.CITY  ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.PINCODE,'')<>'' THEN  '-'+ H.PINCODE  ELSE '' END) ADDRESS,'' TYPE"
        strSql += vbCrLf + "	FROM TEMPTABLEDB..TEMPRECEIPTSTONE AS S    "
        strSql += vbCrLf + "	INNER JOIN RECEIPT R ON R.SNO = S.ISSSNO    "
        strSql += vbCrLf + "	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = S.CATCODE  "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..ACHEAD AS H ON H.ACCODE = R.ACCODE"
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS CU ON CU.BATCHNO = S.BATCHNO "
        strSql += vbCrLf + "	LEFT JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = CU.PSNO"
        strSql += vbCrLf + "	WHERE S.TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + "	AND ISNULL(R.CANCEL,'') = ''"
        strSql += vbCrLf + "	AND S.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)"
        strSql += vbCrLf + "	AND S.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)"
        strSql += vbCrLf + "	AND S.CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))  "
        strSql += vbCrLf + "	AND DATENAME(MONTH,S.TRANDATE) IN (SELECT MONTHNAME FROM TEMPTABLEDB..TEMPMONTHH)"
        strSql += vbCrLf + "	AND R.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)"
        strSql += vbCrLf + "	AND S.TRANTYPE IN (SELECT TRANTYPE FROM TEMPTABLEDB..TEMPTRANTYPE)"
        strSql += vbCrLf + "	AND S.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPPURVATRPT"
        strSql += vbCrLf + "	(TRANNO,REFNO ,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT,ED,ECESS,HECESS,TAX,TOTAL,TRANDATE,MMONTHNAME,MMONTHID,CATNAME,ACNAME,CENTRALTAXNO,SNO,COSTID,GROUP1,GROUP2,CANCEL,ACCODE,ADDRESS,TYPE)"
        strSql += vbCrLf + "	SELECT "
        strSql += vbCrLf + "	DISTINCT R.TRANNO,R.REFNO ,R.REFDATE, R.REMARK1, S.STNPCS*(-1), S.STNWT*(-1), S.STNWT*(-1), S.STNAMT*(-1)"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = S.ISSSNO AND TRANTYPE=S.TRANTYPE AND TAXID='ED')*(-1)as ED"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = S.ISSSNO AND TRANTYPE=S.TRANTYPE AND TAXID='EC')*(-1)as ECESS"
        strSql += vbCrLf + "	,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO = S.ISSSNO AND TRANTYPE=S.TRANTYPE AND TAXID='HE')*(-1)as HECESS "
        strSql += vbCrLf + "	,S.TAX*(-1),(S.STNAMT +ISNULL(S.TAX,0)+(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=S.ISSSNO))*(-1) AS TOTAL"
        strSql += vbCrLf + "	,R.TRANDATE,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME"
        strSql += vbCrLf + "	,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE('0',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID"
        strSql += vbCrLf + "	,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'') <> '' THEN H.ACNAME ELSE P.PNAME END AS ACNAME"
        strSql += vbCrLf + "	,H.CENTRALTAXNO,R.SNO,R.COSTID,CONVERT(VARCHAR(300),NULL)GROUP1,CONVERT(VARCHAR(300),NULL)GROUP2"
        strSql += vbCrLf + "	,R.CANCEL,R.ACCODE,(CASE WHEN ISNULL(H.ADDRESS1,'')<>'' THEN H.ADDRESS1 +',' ELSE '' END "
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS2,'')<>'' THEN  CHAR(13)+ H.ADDRESS2 +',' ELSE '' END"
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.ADDRESS3,'')<>'' THEN  CHAR(13)+ H.ADDRESS3 +',' ELSE '' END"
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.AREA,'')<>'' THEN  CHAR(13)+ H.AREA +',' ELSE '' END"
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.CITY,'')<>'' THEN  CHAR(13)+ H.CITY  ELSE '' END"
        strSql += vbCrLf + "	+ CASE WHEN ISNULL(H.PINCODE,'')<>'' THEN  '-'+ H.PINCODE  ELSE '' END) ADDRESS,' (PURCHASE RETURN)' TYPE"
        strSql += vbCrLf + "	FROM ISSSTONE AS S"
        strSql += vbCrLf + "	INNER JOIN ISSUE R ON R.SNO = S.ISSSNO"
        strSql += vbCrLf + "	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = S.CATCODE"
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..ACHEAD AS H ON H.ACCODE = R.ACCODE"
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS CU ON CU.BATCHNO = S.BATCHNO"
        strSql += vbCrLf + "	LEFT JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = CU.PSNO"
        strSql += vbCrLf + "	WHERE S.TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + "	AND ISNULL(R.CANCEL,'') = ''"
        strSql += vbCrLf + "	AND S.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)"
        strSql += vbCrLf + "	AND S.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)"
        strSql += vbCrLf + "	AND S.CATCODE IN (SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))"
        strSql += vbCrLf + "	AND DATENAME(MONTH,S.TRANDATE) IN (SELECT MONTHNAME FROM TEMPTABLEDB..TEMPMONTHH)"
        strSql += vbCrLf + "	AND R.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)"
        strSql += vbCrLf + "	AND S.TRANTYPE IN ('IPU')"
        strSql += vbCrLf + "	AND S.COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)"
        strSql += vbCrLf + "	/** UPDATE TABLE BASED ON REPORT TYPE **/"
        strSql += vbCrLf + "	IF @RPTTYPE = 'C' /**CATEGORY WISE **/"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPPURVATRPT SET ACCODE = NULL,SNO = NULL,COSTID = NULL,DESCRIPT = NULL,MMONTHNAME = NULL,MMONTHID = NULL,REFNO=NULL,REFDATE=NULL,TRANDATE = NULL,TRANNO = NULL,GROUP1 = CATNAME+TYPE,GROUP2 = ACNAME"
        strSql += vbCrLf + "	IF @RPTTYPE = 'M' /**MONTH WISE **/"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPPURVATRPT SET ACCODE = NULL,ADDRESS=NULL,SNO = NULL,COSTID = NULL,DESCRIPT = NULL,TRANDATE = NULL,TRANNO = NULL,REFNO=NULL,REFDATE=NULL,CENTRALTAXNO=NULL,ACNAME=NULL,GROUP1 = CATNAME+TYPE,GROUP2 = MMONTHNAME"
        strSql += vbCrLf + "	IF @RPTTYPE = 'D' /**DATE WISE **/"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPPURVATRPT SET ACCODE = NULL,ADDRESS=NULL,SNO = NULL,COSTID = NULL,DESCRIPT = NULL,TRANNO = NULL,REFNO=NULL,REFDATE=NULL,CENTRALTAXNO=NULL,ACNAME=NULL,GROUP1 = CATNAME+TYPE,GROUP2 = CONVERT(VARCHAR,TRANDATE,103)"
        strSql += vbCrLf + "	IF @RPTTYPE = 'T' /**TRANNO WISE **/"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPPURVATRPT SET ACCODE = NULL,SNO = NULL,GROUP1 = CATNAME+TYPE,GROUP2 = ACNAME"
        strSql += vbCrLf + "	IF @RPTTYPE = 'A' /**ACNAME WISE **/"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TEMPPURVATRPT SET ACCODE = NULL,SNO = NULL,COSTID = NULL,DESCRIPT = NULL,MMONTHNAME = NULL,MMONTHID = NULL,TRANDATE = NULL,REFNO=NULL,REFDATE=NULL,TRANNO = NULL,CATNAME=NULL,GROUP1 = NULL,GROUP2 = ACNAME+TYPE"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPPURVATRESULT','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPURVATRESULT"
        strSql += vbCrLf + "	SELECT"
        strSql += vbCrLf + "	GROUP2 AS PARTICULAR,ADDRESS,DESCRIPT,TRANNO,REFNO ,REFDATE,TRANDATE,CENTRALTAXNO"
        strSql += vbCrLf + "	,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT"
        strSql += vbCrLf + "	,SUM(ED)ED,SUM(ECESS)ECESS,SUM(HECESS)HECESS"
        strSql += vbCrLf + "	,SUM(TAX)TAX,SUM(CTAX)CTAX"
        strSql += vbCrLf + "	,SUM(ISNULL(AMOUNT,0)+ISNULL(TAX,0)+ISNULL(CTAX,0)+isnull(ED,0)+ISNULL(ECESS,0)+ISNULL(HECESS,0)) AS TOTAL"
        strSql += vbCrLf + "	,ACNAME"
        strSql += vbCrLf + "	,MMONTHNAME,MMONTHID,COSTID,CATNAME,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) AS RESULT,GROUP1,GROUP2"
        strSql += vbCrLf + "	INTO TEMPTABLEDB..TEMPPURVATRESULT"
        strSql += vbCrLf + "	FROM"
        strSql += vbCrLf + "	("
        strSql += vbCrLf + "	SELECT * FROM TEMPTABLEDB..TEMPPURVATRPT"
        strSql += vbCrLf + "	)X"
        strSql += vbCrLf + "	GROUP BY CATNAME,MMONTHNAME,MMONTHID,TRANNO,REFNO ,REFDATE,TRANDATE,GROUP1,CENTRALTAXNO,ACNAME,GROUP2,DESCRIPT,COSTID,ADDRESS"
        strSql += vbCrLf + "	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPPURVATRESULT)>0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..TEMPPURVATRESULT(PARTICULAR,GROUP1,COLHEAD,RESULT)"
        strSql += vbCrLf + "		SELECT DISTINCT GROUP1,GROUP1,'T',0 FROM TEMPTABLEDB..TEMPPURVATRESULT"
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..TEMPPURVATRESULT(PARTICULAR,GROUP1,COLHEAD,RESULT,PCS,GRSWT,NETWT,AMOUNT,ED,ECESS,HECESS,TAX,CTAX,TOTAL)"
        strSql += vbCrLf + "		SELECT 'SUB TOTAL',GROUP1,'S',2 RESULT"
        strSql += vbCrLf + "		,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT,SUM(ED)ED,SUM(ECESS)ECESS,SUM(HECESS)HECESS,SUM(TAX)TAX,SUM(CTAX)CTAX,SUM(TOTAL)TOTAL"
        strSql += vbCrLf + "		FROM TEMPTABLEDB..TEMPPURVATRESULT WHERE RESULT = 1 GROUP BY GROUP1"
        strSql += vbCrLf + "		IF @GRADNTOT='Y'"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			INSERT INTO TEMPTABLEDB..TEMPPURVATRESULT(PARTICULAR,GROUP1,COLHEAD,RESULT,PCS,GRSWT,NETWT,AMOUNT,ED,ECESS,HECESS,TAX,CTAX,TOTAL)"
        strSql += vbCrLf + "			SELECT 'GRAND TOTAL','ZZZZZ'GROUP1,'G',3 RESULT"
        strSql += vbCrLf + "			,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT,SUM(ED)ED,SUM(ECESS)ECESS,SUM(HECESS)HECESS,SUM(TAX)TAX,SUM(CTAX)CTAX,SUM(TOTAL)TOTAL"
        strSql += vbCrLf + "			FROM TEMPTABLEDB..TEMPPURVATRESULT WHERE RESULT = 1"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TEMPPURVATRESULT SET PARTICULAR = ' ' + PARTICULAR WHERE RESULT = 1"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	SELECT * FROM TEMPTABLEDB..TEMPPURVATRESULT ORDER BY GROUP1,RESULT,MMONTHID,TRANDATE,TRANNO"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Private Function SP_RPT_GETSNOADMIN()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE UPPER(NAME)='GET_SNO_ADMIN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE GET_SNO_ADMIN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "   CREATE PROCEDURE GET_SNO_ADMIN"
        strSql += vbCrLf + "   (  "
        strSql += vbCrLf + "   @COSTID VARCHAR(2)  "
        strSql += vbCrLf + "   ,@CTLID VARCHAR(150)  "
        strSql += vbCrLf + "   ,@CHECKTABLENAME VARCHAR(200)  "
        strSql += vbCrLf + "   ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + "   ,@RETVALUE VARCHAR(50) OUTPUT"
        strSql += vbCrLf + "   )  "
        strSql += vbCrLf + "   AS  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   SET NOCOUNT ON  "
        strSql += vbCrLf + "   DECLARE @QRY VARCHAR(4000)  "
        strSql += vbCrLf + "   DECLARE @SNO VARCHAR(15)  "
        strSql += vbCrLf + "   DECLARE @TSNO INT  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPDB..#CHECKSNO', 'U') IS NOT NULL DROP TABLE #CHECKSNO  "
        strSql += vbCrLf + "   CREATE TABLE #CHECKSNO (SNO VARCHAR(15))  "
        strSql += vbCrLf + "   WHILE 1=1  "
        strSql += vbCrLf + "   	BEGIN  "
        strSql += vbCrLf + "   	WHILE 1=1  "
        strSql += vbCrLf + "   		BEGIN  "
        strSql += vbCrLf + "   		SELECT @TSNO = ISNULL(CONVERT(INT,CTLVALUE),0) FROM " & compId & "ADMINDB..SNOCREATOR WHERE CTLID = @CTLID AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + "   		UPDATE " & compId & "ADMINDB..SNOCREATOR SET CTLVALUE = @TSNO+1 WHERE CTLID = @CTLID AND ISNULL(CONVERT(INT,CTLVALUE),0) = @TSNO AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + "   		IF (SELECT @@ROWCOUNT) > 0 BREAK  "
        strSql += vbCrLf + "   		END  "
        strSql += vbCrLf + "   	SELECT @SNO = REPLICATE('0',2-LEN(@COSTID))+ @COSTID + REPLICATE('0',3-LEN(@COMPANYID))+ @COMPANYID + '13' + CONVERT(VARCHAR,@TSNO+1)  "
        strSql += vbCrLf + "   	SELECT @QRY = ' INSERT INTO #CHECKSNO(SNO) SELECT SNO FROM " & compId & "ADMINDB..'+@CHECKTABLENAME+ ' WHERE SNO = '''+ @SNO + ''''  "
        strSql += vbCrLf + "   	EXEC (@QRY)  "
        strSql += vbCrLf + "   	IF NOT (SELECT COUNT(*) FROM #CHECKSNO)>0 BREAK  "
        strSql += vbCrLf + "   DELETE FROM #CHECKSNO"
        strSql += vbCrLf + "   	END  "
        strSql += vbCrLf + "   SELECT @RETVALUE = CONVERT(VARCHAR(50),@SNO)  "
        strSql += vbCrLf + "   END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

