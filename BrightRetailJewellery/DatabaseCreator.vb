        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' GROUP BY A.ACNAME,A.ACCODE,ISNULL(A.GSTNO,''''),ISNULL(A.PAN,'''')'  "
        strSql += vbCrLf + " 	SET @S1 = @S1 +1  "
        strSql += vbCrLf + " 	SET @CQRY =@QRY"
        strSql += vbCrLf + " FETCH NEXT FROM TASKOID_CURSOR INTO @CURDBNAME  "
        strSql += vbCrLf + " END  "
        strSql += vbCrLf + " CLOSE TASKOID_CURSOR  "
        strSql += vbCrLf + " DEALLOCATE TASKOID_CURSOR  "
        strSql += vbCrLf + " IF @CQRY = ''"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' SELECT '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' 0 AMOUNT'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,'''' ACNAME'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,'''' ACCODE '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,'''' GSTNO '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY +CHAR(13)+ ' ,'''' PAN '  "
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ')X '  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' GROUP BY ACCODE,GSTNO,PAN,ACNAME'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' HAVING SUM(AMOUNT) > '+@AMOUNT+' '  "
        strSql += vbCrLf + " PRINT @QRY  "
        strSql += vbCrLf + " EXEC(@QRY)  "
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

