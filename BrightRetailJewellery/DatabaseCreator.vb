    Private Sub SP_RPT_BILLWISERECEIPTANDPAYMENT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_BILLWISERECEIPTANDPAYMENT')>0"
