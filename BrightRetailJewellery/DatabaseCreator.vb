        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'OTHERCASPAY ORDER BY RESULT      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
