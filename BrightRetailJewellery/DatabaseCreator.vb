        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,STNPCS,STNAMT,STNWT,DIAPCS,DIAAMT,DIAWT,PCTFILE,PICNAME,COSTID,DESIGNERNAME,STATUS,TOUCH,CATCODE' "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,SALVALUE,SIZE,ITEMTYPE,COSTNAME,TOFLAG'"
        strSql += vbCrLf + "  --SELECT @STRSQL=@STRSQL+CHAR(13)+' INTO TEMPTAGINFO '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' FROM ( '"
