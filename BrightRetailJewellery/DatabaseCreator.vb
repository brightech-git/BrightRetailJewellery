        strSql += vbCrLf + "      BEGIN            "
        strSql += vbCrLf + "       FETCH NEXT FROM CUR INTO @RUNNO,@TRANNO,@TRANDATE,@DUEDATE,@TRANTYPE,@AMOUNT,@NAME,@MOBILE           "
        strSql += vbCrLf + "       IF @@FETCH_STATUS =-1 BREAK           "
        strSql += vbCrLf + "       SELECT @CRUNNO =(SELECT TOP 1 RUNNO FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=''+@RUNNO +'' AND NAME=''+@NAME+'' AND CTRANNO IS NULL AND AMOUNT IS NULL ORDER BY CTRANNO,CTRANDATE)           "
        strSql += vbCrLf + "       SELECT @CTRANNO =(SELECT TOP 1 TRANNO FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=''+@RUNNO +'' AND NAME=''+@NAME+'' AND CTRANNO IS NULL AND AMOUNT IS NULL ORDER BY CTRANNO,CTRANDATE)           "
        strSql += vbCrLf + "       SELECT @CTRANDATE =(SELECT TOP 1 TRANDATE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=''+@RUNNO +'' AND NAME=''+@NAME+'' AND CTRANNO IS NULL AND AMOUNT IS NULL ORDER BY CTRANNO,CTRANDATE)  "
        strSql += vbCrLf + "       IF @SUMMARY='N'    "
        strSql += vbCrLf + "       BEGIN    "
        strSql += vbCrLf + "        IF @CRUNNO <> ''/*IF @CTRANNO <>0  AND @CTRANNO<>''                    */  "
