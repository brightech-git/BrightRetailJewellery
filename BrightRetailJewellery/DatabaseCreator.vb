        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [' + @COSTID1 + '-CCREDIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
