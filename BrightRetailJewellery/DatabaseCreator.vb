        strSql += vbCrLf + "  		AND ISNULL(A.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)    "
        strSql += vbCrLf + "  		AND PAYMODE IN (''DI'') AND FROMFLAG NOT IN ('''',''S'',''O'',''A'') AND BATCHNO IN (SELECT BATCHNO FROM ISSUE)  "
