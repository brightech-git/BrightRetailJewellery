        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' UPDATE TEMPTABLEDB..DESIGNSTKORDER1 SET SDIFFWT=(SDIFFWT*(-1)) WHERE SDIFFWT < 0 '"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' INSERT INTO TEMPTABLEDB..DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' SELECT DISTINCT DESIGNER,ITEM,DESIGNER,0 RESULT,''T''COLHEAD FROM TEMPTABLEDB..DESIGNSTKORDER1'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' INSERT INTO TEMPTABLEDB..DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' SELECT DISTINCT DESIGNER,ITEM,ITEM,1 RESULT,''N''COLHEAD FROM TEMPTABLEDB..DESIGNSTKORDER1'"
        strSql += vbCrLf + "				/*INSERT INTO DESIGNSTKORDER1 (DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD)"
        strSql += vbCrLf + "				SELECT DISTINCT DESIGNER,ITEM,SUBITEMNAME,4 RESULT,'E'COLHEAD FROM DESIGNSTKORDER1*/"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' INSERT INTO TEMPTABLEDB..DESIGNSTKORDER1 (DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDWT,STKPCS,STKWT,SDIFFPCS,SDIFFWT,EDIFFPCS,EDIFFWT,SUBITEM)'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' SELECT DISTINCT DESIGNER,ITEM,''SUB TOTAL'',3 RESULT,''S''COLHEAD,'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' SUM(REORDPCS),SUM(REORDWT),SUM(STKPCS),SUM(STKWT),SUM(SDIFFPCS),SUM(SDIFFWT),SUM(EDIFFPCS),SUM(EDIFFWT),''ZZ.SUB TOTAL'''"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' FROM TEMPTABLEDB..DESIGNSTKORDER1 GROUP BY DESIGNER,ITEM'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' INSERT INTO TEMPTABLEDB..DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDWT,STKPCS,STKWT,SDIFFPCS,SDIFFWT,EDIFFPCS,EDIFFWT,SUBITEM)  '"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' SELECT DISTINCT ''ZZZZZZZ'',''ZZZZZZZZZZZZ'',''GRAND TOTAL'',5 RESULT,''G'' COLHEAD'"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' ,SUM(REORDPCS),SUM(REORDWT),SUM(STKPCS),SUM(STKWT),SUM(SDIFFPCS),SUM(SDIFFWT),SUM(EDIFFPCS),SUM(EDIFFWT),''GRAND TOTAL'''"
        strSql += vbCrLf + "				SELECT @STRQRY= @STRQRY+ CHAR(13) + ' FROM TEMPTABLEDB..DESIGNSTKORDER1 WHERE RESULT IN (2) '"
        strSql += vbCrLf + "				PRINT @STRQRY"
        strSql += vbCrLf + "				EXEC (@STRQRY)"
        strSql += vbCrLf + "				/*UPDATE DESIGNSTKORDER1 SET SUBITEM = SUBITEMNAME WHERE COLHEAD = 'E'*/"
        strSql += vbCrLf + "			END"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		IF @SIZE='Y'"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			/*SELECT CASE WHEN COLHEAD = 'E' THEN '' ELSE SUBITEMNAME END SUBITEMNAME,*/"
        strSql += vbCrLf + "			SELECT @STRQRY =  ' SELECT SUBITEMNAME,[RANGE],[RANGECAPTION] CAPTION ,REORDPCS,REORDWT,STKPCS,STKWT,SDIFFPCS,SDIFFWT,EDIFFPCS,EDIFFWT,DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD,SIZENAME '"
        strSql += vbCrLf + "			SELECT @STRQRY= @STRQRY+ CHAR(13) + ' FROM TEMPTABLEDB..DESIGNSTKORDER T ORDER BY DESIGNER,ITEM,SUBITEM,RESULT,SIZENAME,FROMWEIGHT,TOWEIGHT,[RANGE],COLHEAD'"
        strSql += vbCrLf + "			PRINT @STRQRY"
        strSql += vbCrLf + "			EXEC (@STRQRY)"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		IF @SIZE='N'"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			/*SELECT CASE WHEN COLHEAD = 'E' THEN '' ELSE SUBITEMNAME END SUBITEMNAME,*/"
        strSql += vbCrLf + "			SELECT @STRQRY =  ' SELECT SUBITEMNAME,[RANGE],[RANGECAPTION] CAPTION ,REORDPCS,REORDWT,STKPCS,STKWT,SDIFFPCS,SDIFFWT,EDIFFPCS,EDIFFWT,DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD '"
        strSql += vbCrLf + "			SELECT @STRQRY= @STRQRY+ CHAR(13) + ' FROM TEMPTABLEDB..DESIGNSTKORDER1 T ORDER BY DESIGNER,ITEM,SUBITEM,RESULT,[RANGE],FROMWEIGHT,TOWEIGHT'"
        strSql += vbCrLf + "			PRINT @STRQRY"
        strSql += vbCrLf + "			EXEC (@STRQRY)"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPITEMSIZE') IS NOT NULL DROP TABLE TEMPITEMSIZE"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPCOUNTER') IS NOT NULL DROP TABLE TEMPCOUNTER"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPSUBITEMMAST') IS NOT NULL DROP TABLE TEMPSUBITEMMAST"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPCOSTCENTRE') IS NOT NULL DROP TABLE TEMPCOSTCENTRE"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Private Function SP_RPT_STOCKREORDERTYPE() As Integer
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_STOCKREORDERTYPE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_STOCKREORDERTYPE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_STOCKREORDERTYPE"
        strSql += vbCrLf + "   (  "
        strSql += vbCrLf + "    @METALID VARCHAR(1000)  "
        strSql += vbCrLf + "   ,@ITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "   ,@SUBITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "   ,@COSTID VARCHAR(8000)  "
        strSql += vbCrLf + "   ,@COUNTER VARCHAR(8000) "
        strSql += vbCrLf + "   ,@SIZEID VARCHAR(8000)  "
        strSql += vbCrLf + "   ,@ASONDATE SMALLDATETIME  "
        strSql += vbCrLf + "   ,@RTYPE VARCHAR(1) "
        strSql += vbCrLf + "   ,@RMODE VARCHAR(1)"
        strSql += vbCrLf + "   ,@SIZE VARCHAR(1)"
        strSql += vbCrLf + "   ,@DESIGNREORDER VARCHAR(1)"
        strSql += vbCrLf + "   ,@COMPANYID VARCHAR(50)"
        strSql += vbCrLf + "   )  "
        strSql += vbCrLf + "   AS  "
        strSql += vbCrLf + "   SET NOCOUNT ON  "
        strSql += vbCrLf + "   DECLARE @QRY AS NVARCHAR(4000) "
        strSql += vbCrLf + "   /*EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEMMAST',@INPUTVALUES = @ITEMID*/ "
        strSql += vbCrLf + "   EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'SUBITEMMAST',@CHK_FEILD = 'SUBITEMID',@RESULT_TBL = 'TEMPSUBITEMMAST',@INPUTVALUES = @SUBITEMID  "
        strSql += vbCrLf + "   EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMSIZE',@CHK_FEILD = 'SIZEID',@RESULT_TBL = 'TEMPITEMSIZE',@INPUTVALUES = @SIZEID  "
        strSql += vbCrLf + "   /*EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID*/"
        strSql += vbCrLf + "   EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANYID"
        strSql += vbCrLf + "   IF @COSTID <> 'ALL' OR @COSTID <> '' SET @COSTID = REPLACE(@COSTID,',',''',''') SET @COSTID = ''''+ @COSTID +''''"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPCOSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSTCENTRE    "
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SELECT @QRY = 'CREATE TABLE TEMPTABLEDB..TEMPCOSTCENTRE(COSTID VARCHAR(3))'  "
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  IF @COSTID = '''ALL''' OR @COSTID = ''  "
        strSql += vbCrLf + "  SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE SELECT COSTID FROM COSTCENTRE'  "
        strSql += vbCrLf + "  ELSE  "
        strSql += vbCrLf + "  SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE SELECT COSTID FROM COSTCENTRE WHERE COSTID IN('+ @COSTID +')'"
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "   /*ITEM FILTER AND METAL FILTER*/"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TEMPITEMMAST') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMMAST"
        strSql += vbCrLf + "   IF @ITEMID<>'ALL'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SELECT @QRY = 'SELECT ITEMID AS ITEMIDS INTO TEMPTABLEDB..TEMPITEMMAST FROM ITEMMAST WHERE ISNULL(ACTIVE,'''')<>''N'''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND ISNULL(STOCKREPORT,'''')<>''N'' AND ITEMID IN('+ @ITEMID +')'"
        strSql += vbCrLf + "   IF @METALID<>'ALL' SELECT @QRY = @QRY + ' AND METALID='''+ @METALID +''''"
        strSql += vbCrLf + "   EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "   BEGIN "
        strSql += vbCrLf + "   SELECT @QRY = 'SELECT ITEMID AS ITEMIDS INTO TEMPTABLEDB..TEMPITEMMAST FROM ITEMMAST WHERE ISNULL(ACTIVE,'''')<>''N'''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' AND ISNULL(STOCKREPORT,'''')<>''N'''"
        strSql += vbCrLf + "   IF @METALID<>'ALL' SELECT @QRY = @QRY + ' AND METALID='''+ @METALID +''''"
        strSql += vbCrLf + "   EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   IF @DESIGNREORDER='N'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPDB..#NONSTKORDER') IS NOT NULL DROP TABLE #NONSTKORDER"
        strSql += vbCrLf + "   SELECT SM.SUBITEMNAME,RE.PIECE AS REORDPCS,RE.WEIGHT AS REORDRT "
        strSql += vbCrLf + "   ,T.PCS,T.GRSWT,IM.ITEMNAME AS ITEM,SM.SUBITEMNAME AS SUBITEM/*,SI.SIZENAME*/"
        strSql += vbCrLf + "   ,2 RESULT"
        strSql += vbCrLf + "   INTO #NONSTKORDER"
        strSql += vbCrLf + "   FROM ITEMTAG AS T"
        strSql += vbCrLf + "   INNER JOIN ITEMMAST AS IM ON IM.ITEMID = T.ITEMID"
        strSql += vbCrLf + "   LEFT OUTER JOIN SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID"
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMSIZE AS SI ON SI.SIZEID = T.SIZEID"
        strSql += vbCrLf + "   LEFT OUTER JOIN STKREORDER AS RE ON RE.ITEMID=T.ITEMID"
        strSql += vbCrLf + "   WHERE T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE)  "
        strSql += vbCrLf + "   AND NOT EXISTS (SELECT 1 FROM STKREORDER RE WHERE T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID AND T.GRSWT BETWEEN RE.FROMWEIGHT AND RE.TOWEIGHT )"
        strSql += vbCrLf + "   /*AND T.SIZEID = RE.SIZEID)*/"
        strSql += vbCrLf + "   AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)   "
        strSql += vbCrLf + "   AND T.ITEMID IN (SELECT ITEMIDS FROM TEMPTABLEDB..TEMPITEMMAST)  "
        strSql += vbCrLf + "   AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  "
        strSql += vbCrLf + "   AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)  "
        strSql += vbCrLf + "   AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)  "
        strSql += vbCrLf + "   AND ISNULL(T.COSTID,0) IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)"
        strSql += vbCrLf + "   ORDER BY ITEM"
        strSql += vbCrLf + "   IF @RMODE = 'A'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   UPDATE #NONSTKORDER SET SUBITEM = 'OTHERS'"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   IF @SIZE ='Y'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPDB..#STKORDER') IS NOT NULL DROP TABLE #STKORDER  "
        strSql += vbCrLf + "   SELECT SUBITEMNAME,CONVERT(VARCHAR(200),RANGE)RANGE,SUM(REPCS)REORDPCS,SUM(RERT)REORDRT,SUM(STKPCS)STKPCS,SUM(STKRT)STKRT"
        strSql += vbCrLf + "   ,CONVERT(NUMERIC(15,3),0)DIFFPCS,CONVERT(NUMERIC(15,3),0)DIFFRT,ITEM,SUBITEM,SIZENAME,"
        strSql += vbCrLf + "   FROMWEIGHT, TOWEIGHT, RESULT, COLHEAD"
        strSql += vbCrLf + "   INTO #STKORDER  "
        strSql += vbCrLf + "   FROM"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   SELECT  "
        strSql += vbCrLf + "   SM.SUBITEMNAME"
        strSql += vbCrLf + "   ,(CONVERT(VARCHAR(100),FROMWEIGHT) + ' TO ' + CONVERT(VARCHAR(100),TOWEIGHT) + ' [' + CONVERT(VARCHAR(100),(CONVERT(DECIMAL (15,3),(CONVERT(VARCHAR(100),((FROMWEIGHT+TOWEIGHT)/2)))))) + ']')AS RANGE,CONVERT(INT,SUM(T.PCS))STKPCS,CONVERT(NUMERIC(15,3),SUM(T.GRSWT))STKRT"
        strSql += vbCrLf + "   ,(RE.PIECE) AS REPCS,(RE.WEIGHT) AS RERT"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),SI.SIZENAME)SIZENAME  "
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),IM.ITEMNAME) AS ITEM,CONVERT(VARCHAR(100),SM.SUBITEMNAME)AS SUBITEM "
        strSql += vbCrLf + "   ,RE.FROMWEIGHT,RE.TOWEIGHT    "
        strSql += vbCrLf + "   ,CONVERT(INT,1) AS RESULT    "
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(3),NULL)COLHEAD     "
        strSql += vbCrLf + "   FROM STKREORDER AS RE  "
        strSql += vbCrLf + "   INNER JOIN ITEMMAST IM ON IM.ITEMID = RE.ITEMID  "
        strSql += vbCrLf + "   LEFT OUTER JOIN SUBITEMMAST SM ON SM.ITEMID = RE.ITEMID AND SM.SUBITEMID = RE.SUBITEMID  "
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMTAG AS T ON T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE )  "
        strSql += vbCrLf + "   AND T.ITEMID = RE.ITEMID "
        strSql += vbCrLf + "   AND T.SUBITEMID = RE.SUBITEMID "
        strSql += vbCrLf + "   AND T.GRSWT BETWEEN FROMWEIGHT AND TOWEIGHT"
        strSql += vbCrLf + "   AND T.COMPANYID = @COMPANYID AND T.COSTID = RE.COSTID   "
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMSIZE AS SI ON SI.SIZEID = RE.SIZEID  "
        strSql += vbCrLf + "   WHERE RE.ITEMID IN (SELECT ITEMIDS FROM TEMPTABLEDB..TEMPITEMMAST)    "
        strSql += vbCrLf + "   AND RE.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)    "
        strSql += vbCrLf + "   AND ISNULL(RE.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)    "
        strSql += vbCrLf + "   AND ISNULL(RE.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "   and RE.RANGEMODE ='R'"
        strSql += vbCrLf + "   GROUP BY ITEMNAME,SM.SUBITEMNAME,RE.FROMWEIGHT,RE.TOWEIGHT,SI.SIZENAME,RE.PIECE,RE.WEIGHT"
        strSql += vbCrLf + "   UNION ALL"
        strSql += vbCrLf + "   SELECT DISTINCT SM.SUBITEMNAME,'OTHER RANGE' RANGE,SUM(T.PCS)STKPCS ,SUM(T.GRSWT)STKRT,0 PIECE,0 RATE"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),SI.SIZENAME)SIZENAME"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),IM.ITEMNAME) AS ITEM,CONVERT(VARCHAR(100),SM.SUBITEMNAME)AS SUBITEM "
        strSql += vbCrLf + "   ,0 FROMWEIGHT,0 TOWEIGHT    "
        strSql += vbCrLf + "   ,CONVERT(INT,1) AS RESULT    "
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(3),NULL)COLHEAD   "
        strSql += vbCrLf + "   FROM ITEMTAG AS T    "
        strSql += vbCrLf + "   LEFT outer jOIN SUBITEMMAST SM ON SM.ITEMID=T.ITEMID AND SM.SUBITEMID=T.SUBITEMID"
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMMAST IM ON IM.ITEMID=T.ITEMID "
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMSIZE AS SI ON SI.SIZEID=T.SIZEID"
        strSql += vbCrLf + "   WHERE NOT EXISTS (Select 1 from STKREORDER RE WHERE T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID AND ISNULL(T.COSTID,'')=ISNULL(RE.COSTID,'') and  T.GRSWT between RE.FROMWEIGHT and RE.TOWEIGHT)"
        strSql += vbCrLf + "   AND T.RECDATE <= @ASONDATE  AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE )  "
        strSql += vbCrLf + "   AND T.ITEMID IN (SELECT ITEMIDS FROM TEMPTABLEDB..TEMPITEMMAST)    "
        strSql += vbCrLf + "   AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)    "
        strSql += vbCrLf + "   AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)    "
        strSql += vbCrLf + "   AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE) "
        strSql += vbCrLf + "   AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)  "
        strSql += vbCrLf + "   GROUP BY ITEMNAME,SM.SUBITEMNAME,SI.SIZENAME"
        strSql += vbCrLf + "   )X GROUP BY RANGE,SUBITEMNAME,FROMWEIGHT,TOWEIGHT,ITEM,SUBITEM,SIZENAME,"
        strSql += vbCrLf + "   RESULT, COLHEAD"
        strSql += vbCrLf + "   UPDATE #STKORDER SET DIFFPCS =STKPCS-REORDPCS,DIFFRT = STKRT-REORDRT"
        strSql += vbCrLf + "   DECLARE @LEN AS INT"
        strSql += vbCrLf + "   DECLARE @LEN_FWT AS INT"
        strSql += vbCrLf + "   DECLARE @LEN_TWT AS INT"
        strSql += vbCrLf + "   SELECT @LEN = MAX(LEN(SUBITEMNAME))+1 FROM #STKORDER WHERE RESULT = 1"
        strSql += vbCrLf + "   SELECT @LEN_FWT = MAX(LEN(FROMWEIGHT)) FROM #STKORDER"
        strSql += vbCrLf + "   SELECT @LEN_TWT = MAX(LEN(TOWEIGHT)) FROM #STKORDER"
        strSql += vbCrLf + "   IF @RTYPE = 'S'"
        strSql += vbCrLf + "   DELETE FROM #STKORDER WHERE NOT (DIFFPCS < 0 OR DIFFRT < 0)"
        strSql += vbCrLf + "   IF @RTYPE = 'E'"
        strSql += vbCrLf + "   DELETE FROM #STKORDER WHERE NOT (DIFFPCS > 0 OR DIFFRT > 0)"
        strSql += vbCrLf + "   IF (SELECT COUNT(*) FROM #STKORDER)>0  "
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   INSERT INTO #STKORDER(ITEM,SUBITEMNAME,RESULT,COLHEAD)"
        strSql += vbCrLf + "   SELECT DISTINCT ITEM,ITEM,0 RESULT,'T'COLHEAD FROM #STKORDER"
        strSql += vbCrLf + "   INSERT INTO #STKORDER (ITEM,SUBITEMNAME,RESULT,COLHEAD)"
        strSql += vbCrLf + "   SELECT DISTINCT ITEM,SUBITEMNAME,3 RESULT,'E'COLHEAD FROM #STKORDER"
        strSql += vbCrLf + "   INSERT INTO #STKORDER (ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,SUBITEM)"
        strSql += vbCrLf + "   SELECT DISTINCT ITEM,'SUB TOTAL',2 RESULT,'S'COLHEAD,"
        strSql += vbCrLf + "   SUM(REORDPCS),SUM(REORDRT),SUM(STKPCS),SUM(STKRT),SUM(DIFFPCS),SUM(DIFFRT),'ZZ.SUB TOTAL'"
        strSql += vbCrLf + "   FROM #STKORDER GROUP BY ITEM"
        strSql += vbCrLf + "   INSERT INTO #STKORDER(ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,SUBITEM)  "
        strSql += vbCrLf + "   Select DISTINCT 'ZZZZ','GRAND TOTAL',4 RESULT,'G' COLHEAD"
        strSql += vbCrLf + "   ,SUM(REORDPCS),SUM(REORDRT),SUM(STKPCS),SUM(STKRT),SUM(DIFFPCS),SUM(DIFFRT),'GRAND TOTAL'	 "
        strSql += vbCrLf + "   FROM #STKORDER WHERE RESULT IN (1)"
        strSql += vbCrLf + "   UPDATE #STKORDER SET SUBITEM = SUBITEMNAME WHERE COLHEAD = 'E'"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   IF @SIZE='N'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPDB..#STKORDER1') IS NOT NULL DROP TABLE #STKORDER1 "
        strSql += vbCrLf + "   SELECT SUBITEMNAME,CONVERT(VARCHAR(200),RANGE)RANGE,SUM(REPCS)REORDPCS,SUM(RERT)REORDRT,SUM(STKPCS)STKPCS,SUM(STKRT)STKRT"
        strSql += vbCrLf + "   ,CONVERT(NUMERIC(15,3),0)DIFFPCS,CONVERT(NUMERIC(15,3),0)DIFFRT,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD"
        strSql += vbCrLf + "   INTO #STKORDER1  "
        strSql += vbCrLf + "   FROM"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   SELECT  "
        strSql += vbCrLf + "   SM.SUBITEMNAME"
