        strSql += vbCrLf + " 	SELECT @STRQRY='IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COUNTERREPORT)>0'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' BEGIN'  "
