    Function AdmindbInsertValuesToMiscCharges(ByVal rootdb As String, ByVal MiscId As String, ByVal MISCName As String) As Integer
        Dim dt As New DataTable
        dt.Clear()
        strSql = " select 1 from " & rootdb & "..MiscCharges where MiscId = '" & MiscId & "'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
        If dt.Rows.Count > 0 Then
            Return 0
        End If
        strSql = " INSERT INTO " & rootdb & "..MISCCHARGES"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  MISCID,MISCNAME,METALID,CATCODE,ACCTID,DEFAULTVALUE,ACTIVE,USERID,UPDATED,UPTIME"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  VALUES"
        strSql += vbCrLf + "  (" & Val(MiscId) & ",'" & MISCName & "','','','MIS" & Val(MiscId).ToString & "',0,'Y',0,GETDATE(),GETDATE())"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

