        strSql += vbCrLf + "  			SELECT @QRY= @QRY + ' SELECT ''ISS_TR'' SEP,SUM(C.PCS)PCS,SUM(C.GRSWT)GRSWT,C.ITEMID,C.SUBITEMID,C.ITEMCTRID'"
        strSql += vbCrLf + "  			SELECT @QRY= @QRY + ' FROM " & compId & "ADMINDB..ITEMTAG AS C '"
