        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD,SEP)'  "
        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' (SELECT '' '' AS BILLNO,'' ''BILLDATE,ITEMNAME,'' '' AS SUBITEMNAME'  "
