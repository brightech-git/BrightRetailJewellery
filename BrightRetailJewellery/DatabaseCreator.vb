        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    declare @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "    declare @TEMPTBL2 VARCHAR(25)"
        strSql += vbCrLf + "    DECLARE @TEMPTBL3 VARCHAR(25)"
        strSql += vbCrLf + "    SET NOCOUNT ON  "
