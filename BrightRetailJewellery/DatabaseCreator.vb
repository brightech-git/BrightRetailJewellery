        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+ 'AND ISNULL(R.COMPANYID,'''') =  '''+@COMPANYID+''' AND R.AMOUNT > 0 AND ISNULL(R.CANCEL,'''') = '''''  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+ 'GROUP BY R.TRANDATE, R.TRANNO, R.REMARK1'  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+ ',C.SALESTAX, PNAME'  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+ ',R.METALID, R.BATCHNO,R.SNO,R.TRANTYPE'  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+ ')Z '  "
        strSql += vbCrLf + "     PRINT @QRY     "
        strSql += vbCrLf + "     EXEC (@QRY)             "
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "     SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'       "
        strSql += vbCrLf + "     PRINT (@QRY) "
        strSql += vbCrLf + "     EXEC (@QRY)            "
        strSql += vbCrLf + "     SELECT @QRY='SELECT *'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT CASE WHEN TRANMODE = ''D'' THEN SUM(AMOUNT) ELSE -1*SUM(AMOUNT) END FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''CA'' GROUP BY TRANMODE) AS CASH'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''CC'') AS CARD'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''CH'') AS CHEQUE'"
        strSql += vbCrLf + "     IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''AA'')) AS ADVADJ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''SS'')) AS SCHEME' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''CB'')) AS BONUS' "
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     ELSE "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''AA'',''CB'',''SS'')) AS ADVADJ' "
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''DI'') AS DISCOUNT'"
        strSql += vbCrLf + "     IF @INCSR <>'Y'"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''DU'',''PU'')) AS CREDIT'"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "     IF @INCSR ='Y'"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL((SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''DU'',''PU'')),0) '"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' + ISNULL(CASE WHEN I.VOUCHERTYPE=''SALES'' THEN ((SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE IN (''SR'')) +'"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ISNULL((SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND TRANTYPE IN (''SR'') AND ISNULL(STUDDED,'''')<>''Y''),0))'"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ELSE 0 END,0) AS CREDIT'"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "     IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' AND @CHITDB <>''"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN I.VOUCHERTYPE=''SALES'' THEN (SELECT SCHEMENAME FROM ' + @CHITDB + 'SAVINGS..SCHEME WHERE SCHEMEID ='"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 SCHEMEID FROM ' + @CHITDB + 'SAVINGS..SCHEMEMAST WHERE CONVERT(VARCHAR,GROUPCODE)+CONVERT(VARCHAR,REGNO) '"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' IN (SELECT TOP 1 ISNULL(CHQCARDREF,'''')+ISNULL(CHQCARDNO,'''') FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''SS'')))'"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ELSE NULL END  AS SCHEMENAME '"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  ,IDENTITY(INT,1,1)SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS I '    "
        strSql += vbCrLf + "     /*SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,VOUCHERTYPE DESC'*/"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,CASE WHEN VOUCHERTYPE=''SALES RETURN'' THEN ''RETURN'' ELSE VOUCHERTYPE END DESC,INVOICENO,REMARKS'"
        strSql += vbCrLf + "     PRINT (@QRY) "
        strSql += vbCrLf + "     EXEC (@QRY) "
        strSql += vbCrLf + "     SELECT @QRY=CHAR(13)+' DECLARE @BATCHNO VARCHAR(15)'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' DECLARE @SNO INT'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' DECLARE @PBATCHNO VARCHAR(15)'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' DECLARE @QRY1 VARCHAR(500)'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SET @PBATCHNO='''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' DECLARE CUR CURSOR FOR'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT BATCHNO,SNO FROM  TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL ORDER BY BATCHNO,SNO,REMARKS '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' OPEN CUR'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FETCH NEXT FROM CUR INTO @BATCHNO,@SNO'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' WHILE @@FETCH_STATUS<>-1'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' BEGIN'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  IF @PBATCHNO<>@BATCHNO '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SET @PBATCHNO=@BATCHNO   '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  ELSE'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  BEGIN'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=CHAR(13)+'' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=@QRY1+CHAR(13)+'' SET CASH=NULL'''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=@QRY1+CHAR(13)+'' ,CARD=NULL,CREDIT=NULL'''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=@QRY1+CHAR(13)+'' ,CHEQUE=NULL,ADVADJ=NULL,DISCOUNT=NULL'''    "
        strSql += vbCrLf + "     IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=@QRY1+CHAR(13)+'' ,SCHEME=NULL,BONUS=NULL'''  "
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   SELECT @QRY1=@QRY1+CHAR(13)+'' WHERE SNO=''+CAST(@SNO AS VARCHAR)+'''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   PRINT (@QRY1)  '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'   EXEC (@QRY1)  '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  END'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+'  FETCH NEXT FROM CUR INTO @BATCHNO,@SNO'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' END'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' CLOSE CUR'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' DEALLOCATE CUR'"
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + "     SELECT @QRY=CHAR(13)+' UPDATE TT SET METALTYPE=''DIAMOND'''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL TT,ISSSTONE ISS WHERE ISS.BATCHNO=TT.BATCHNO  AND ISS.SNO=TT.TSNO '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' AND ISS.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' AND ISS.STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'')'    "
        strSql += vbCrLf + " 	 PRINT @QRY"
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + "     IF @BILLSUM = 'N'    "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     SELECT @QRY=' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL SET PRODUCTNAME=''ORDER ITEM'' WHERE ISNULL(PRODUCTNAME,'''')='''' '    "
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "     SELECT @QRY=' UPDATE A SET CREDIT=CONVERT(NUMERIC(15,2),ISNULL(CREDIT,0)+ISNULL((SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=A.BATCHNO AND PAYMODE IN (''PU'')),0))'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL AS A WHERE VOUCHERTYPE=''PURCHASE'' AND BATCHNO IN ('"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT BATCHNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL AS I WHERE VOUCHERTYPE IN (''SALES'',''PURCHASE'') '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' GROUP BY BATCHNO HAVING COUNT(VOUCHERTYPE)>1)'"
        strSql += vbCrLf + "     IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY='SELECT INVOICEDATE,INVOICENO ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,VOUCHERTYPE,PNAME'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(STNAMT,0))STNAMT ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(DIAWT,0))DIAWT,SUM(ISNULL(DIAAMT,0))DIAAMT,METALTYPE,SUM(ISNULL(VALUE,0))VALUE,SUM(ISNULL(GST,0))GST ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(IGSTRATE,0))IGSTRATE,SUM(ISNULL(IGSTTAX,0))IGSTTAX,SUM(ISNULL(CGSTRATE,0))CGSTRATE,SUM(ISNULL(CGSTTAX,0))CGSTTAX ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(SGSTRATE,0))SGSTRATE,SUM(ISNULL(SGSTTAX,0))SGSTTAX ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 REMARK1 FROM  TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL WHERE BATCHNO=T.BATCHNO AND METALTYPE=T.METALTYPE AND ISNULL(REMARK1,'''') <> '''') REMARK1' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(TOTAL,0))TOTAL,BATCHNO' "
        strSql += vbCrLf + "  	IF @BILLREFNO = 'Y'"
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' ,REFNO'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(CASH,0)) CASH,SUM(ISNULL(CARD,0)) CARD,SUM(ISNULL(CHEQUE,0)) CHEQUE,SUM(ISNULL(ADVADJ,0)) ADVADJ ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(SCHEME,0)) SCHEME,SUM(ISNULL(BONUS,0)) BONUS ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(DISCOUNT,0)) DISCOUNT,SUM(ISNULL(CREDIT,0)) CREDIT,ROW_NUMBER() OVER (ORDER BY INVOICEDATE,VOUCHERTYPE DESC) SNO ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(CASH,0)+ISNULL(CARD,0)+ISNULL(CHEQUE,0)+ISNULL(ADVADJ,0)+ISNULL(CREDIT,0)) AS BAL_AMT ' "
        strSql += vbCrLf + "     IF @CHITDB <>''    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' ,SCHEMENAME ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL T WHERE 1=1'    "
        strSql += vbCrLf + "     IF @METALNAME<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND METALTYPE='''+@METALNAME+''''    "
        strSql += vbCrLf + "     IF @TYPE<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND VOUCHERTYPE='''+@TYPE+''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' GROUP BY INVOICEDATE,INVOICENO,VOUCHERTYPE,PNAME,METALTYPE,BATCHNO ' "
        strSql += vbCrLf + "    	IF @BILLREFNO = 'Y'"
        strSql += vbCrLf + "    	SELECT @QRY=@QRY+CHAR(13)+' ,REFNO'"
        strSql += vbCrLf + "    	IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' AND @CHITDB <>''"
        strSql += vbCrLf + "    	SELECT @QRY=@QRY+CHAR(13)+' ,SCHEMENAME'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,CASE WHEN VOUCHERTYPE=''SALES RETURN'' THEN ''RETURN'' ELSE VOUCHERTYPE END DESC,INVOICENO,REMARKS '"
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     ELSE "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY='SELECT * '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL(CASH,0)+ISNULL(CARD,0)+ISNULL(CHEQUE,0)+ISNULL(ADVADJ,0)+ISNULL(CREDIT,0) AS BAL_AMT'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL WHERE 1=1'    "
        strSql += vbCrLf + "     IF @METALNAME<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND METALTYPE='''+@METALNAME+''''    "
        strSql += vbCrLf + "     IF @TYPE<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND VOUCHERTYPE='''+@TYPE+''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,CASE WHEN VOUCHERTYPE=''SALES RETURN'' THEN ''RETURN'' ELSE VOUCHERTYPE END DESC,INVOICENO,REMARKS'"
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     PRINT @QRY  "
        strSql += vbCrLf + "     EXEC (@QRY)   "
        strSql += vbCrLf + " END     "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSp_SalesAbstractNew()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_RPT_ABSTRACT_NEW_FORMAT1')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_RPT_ABSTRACT_NEW_FORMAT1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE PROC_RPT_ABSTRACT_NEW_FORMAT1"
        strSql += vbCrLf + "( "
        strSql += vbCrLf + "@DBNAME VARCHAR(15)"
        strSql += vbCrLf + ",@SYSTEMID VARCHAR(10)"
        strSql += vbCrLf + ",@FRMDATE VARCHAR(12)"
        strSql += vbCrLf + ",@TODATE VARCHAR(12)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(200)"
        strSql += vbCrLf + ",@CATCODE VARCHAR(200)     "
        strSql += vbCrLf + ",@CATNAME VARCHAR(200) "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(200)     "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)     "
        strSql += vbCrLf + ",@TYPE VARCHAR(10)"
        strSql += vbCrLf + ",@SEPDIA VARCHAR(1)"
        strSql += vbCrLf + ",@BILLSUM VARCHAR(1) "
        strSql += vbCrLf + ")     "
        strSql += vbCrLf + "AS     "
        strSql += vbCrLf + "BEGIN /** PROC STARTS **/     "
        strSql += vbCrLf + "	SET NOCOUNT ON     "
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)    "
        strSql += vbCrLf + "	DECLARE @QRY1 VARCHAR(8000)    "
        strSql += vbCrLf + "	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'     "
        strSql += vbCrLf + "	EXEC (@QRY)   "
        strSql += vbCrLf + "	EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME     "
        strSql += vbCrLf + "	EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL = 'TEMPCATEGORY',@INPUTVALUES = @CATCODE "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPDB..#METALMAST') IS NOT NULL DROP TABLE #METALMAST CREATE TABLE #METALMAST(METALID VARCHAR(10))       "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPDB..#CATEGORY') IS NOT NULL DROP TABLE #CATEGORY CREATE TABLE #CATEGORY(CATCODE VARCHAR(10))       "
        strSql += vbCrLf + "	SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '     "
        strSql += vbCrLf + "	EXEC (@QRY)     "
        strSql += vbCrLf + "	SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM ' + @DBNAME + '..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'      "
        strSql += vbCrLf + "	EXEC (@QRY)  "
        strSql += vbCrLf + "	DECLARE  @SUBITEMID VARCHAR(50)"
        strSql += vbCrLf + "	SELECT @SUBITEMID=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='EXCLUDESUBITEM'"
        strSql += vbCrLf + "	IF @SUBITEMID='' SELECT @SUBITEMID='999999'"
        strSql += vbCrLf + "	IF @BILLSUM = 'N'  "
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		IF @SEPDIA = 'N'"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			SELECT @QRY='SELECT  * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS  FROM ('    "
        strSql += vbCrLf + "			SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT I.TRANDATE INVOICEDATE,TRANNO AS INVOICENO,'    "
        strSql += vbCrLf + "			SELECT @QRY=@QRY+CHAR(13)+' (SELECT METALNAME FROM ' + @DBNAME + '..METALMAST WHERE METALID=I.METALID) AS METALTYPE,'"
        strSql += vbCrLf + "			SELECT @QRY=@QRY+CHAR(13)+' ''SALES'' AS VOUCHERTYPE,PNAME PARTYNAME'    "
        strSql += vbCrLf + "			SELECT @QRY=@QRY+CHAR(13)+' , (CASE WHEN I.SUBITEMID=0 THEN IM.ITEMNAME ELSE SI.SUBITEMNAME END) AS PRODUCTNAME '  "
        strSql += vbCrLf + "			SELECT @QRY=@QRY+CHAR(13)+' ,I.GRSWT+CONVERT(NUMERIC(15,2) ,ISNULL((SELECT SUM(GRSWT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)) GRSWT '  "
