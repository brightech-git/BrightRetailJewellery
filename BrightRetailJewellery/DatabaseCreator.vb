        strSql += vbCrLf + "   SELECT @QUERY=@QUERY+'SELECT ACCODE,CATCODE,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)), SUM(ISNULL(PUREWT,0)) FROM '+@DBNAME+'..RECEIPT '"
