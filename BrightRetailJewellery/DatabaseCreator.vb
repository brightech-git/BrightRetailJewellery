        strSql += vbCrLf + "       EXEC(@QRY)       "
        strSql += vbCrLf + "      END     "
        strSql += vbCrLf + "      SELECT RUNNO,O.TRANNO,O.TRANDATE,O.DUEDATE,O.TRANTYPE,SUM(ISNULL(O.AMOUNT,0))+SUM(ISNULL(O.GSTVAL,0)) AMOUNT ,(P.INITIAL+' '+P.PNAME) NAME,P.MOBILE "
        strSql += vbCrLf + "      INTO TEMPTABLEDB..TEMP_CROUTSTANDING FROM OUTSTANDING AS O "
        strSql += vbCrLf + "      INNER JOIN CUSTOMERINFO AS CU ON CU.BATCHNO = (SELECT TOP 1 BATCHNO FROM  OUTSTANDING WHERE RUNNO = O.RUNNO AND COSTID = O.COSTID AND COMPANYID = O.COMPANYID ORDER BY TRANDATE DESC)       "
        strSql += vbCrLf + "      INNER JOIN  PERSONALINFO AS P ON P.SNO = CU.PSNO       "
        strSql += vbCrLf + "      WHERE O.TRANDATE BETWEEN @FROMDATE AND @TODATE      "
        strSql += vbCrLf + "      AND RUNNO IN (SELECT RUNNO FROM TEMPTABLEDB..TEMP_OUTSTANDING)     "
        strSql += vbCrLf + "      AND ISNULL(O.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMP_OUT_COSTCENTRE)       "
        strSql += vbCrLf + "      AND ISNULL(O.CANCEL,'') = ''       "
        strSql += vbCrLf + "      AND ISNULL(O.COMPANYID,'') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMP_OUT_COMPANY) "
        strSql += vbCrLf + "      AND ((TRANTYPE ='A' AND RECPAY='P') OR (TRANTYPE='D' AND RECPAY='R') OR "
        strSql += vbCrLf + "      (TRANTYPE='T' AND RECPAY='R')OR( TRANTYPE='O' AND RECPAY='P') OR (TRANTYPE='J' AND RECPAY='R')) AND AMOUNT<>0 "
        strSql += vbCrLf + "      AND TRANTYPE IN (SELECT TYPEID FROM TEMPTABLEDB..TEMP_OUT_TYPE)       "
        strSql += vbCrLf + "      GROUP BY O.TRANTYPE,O.RUNNO,O.TRANNO,O.TRANDATE,P.PNAME,P.INITIAL,P.MOBILE,O.DUEDATE    "
        strSql += vbCrLf + "      DECLARE @RUNNO VARCHAR(50)  "
        strSql += vbCrLf + "      DECLARE @CRUNNO VARCHAR(50)         "
        strSql += vbCrLf + "      DECLARE @TRANNO INT            "
        strSql += vbCrLf + "      DECLARE @TRANDATE SMALLDATETIME    "
