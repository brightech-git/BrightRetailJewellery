        strSql += vbCrLf + " ,MCHARGE = CASE WHEN MCHARGE = 0 THEN NULL ELSE MCHARGE END  "
        strSql += vbCrLf + " ,AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END  "
        strSql += vbCrLf + " ,PURVALUE_CALC = CASE WHEN PURVALUE_CALC = 0 THEN NULL ELSE PURVALUE_CALC END  "
