        strSql += vbCrLf + " SET @R_SUM= (SELECT SUM(RCLSWT) FROM MASTER..TEMP_RESULT_BOTTOM WHERE ISNULL(RCOLHEAD,'') = 'G')    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SET @BALANCE=0    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF @L_SUM < @R_SUM    "
        strSql += vbCrLf + " BEGIN    "
