        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS HSN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS AMOUNT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL IGSTRATE,NULL IGSTTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL CGSTRATE,NULL CGSTTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL SGSTRATE,NULL SGSTTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' INTO TEMPTABLEDB..TEMPGSTRPT2_12'"
        strSql += vbCrLf + "	EXEC(@QRY)"

        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT2_13') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT2_13"
        strSql += vbCrLf + "	SELECT @QRY = CHAR(13)+' SELECT TRANNO,SUBSTRING(RUNNO,6,20)AS RUNNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXPER FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''IG'')IGRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXAMOUNT FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''IG'')IGTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXPER FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''CG'')CGRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXAMOUNT FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''CG'')CGTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXPER FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''SG'')SGRATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TAXAMOUNT FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE=''AD'' AND TAXID=''SG'')SGTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' INTO TEMPTABLEDB..TEMPGSTRPT2_13'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' FROM OUTSTANDING O'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)'  "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(COMPANYID,'''') = '''+@COMPANYID+''' '  "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND SUBSTRING(RUNNO,6,1)=''A'''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "	EXEC(@QRY)"

        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT2_14') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT2_14"

        strSql += vbCrLf + "	SELECT @QRY = CHAR(13)+' SELECT NULL AS NO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS DESCRYPT'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL ITCIGST,NULL ITCCGST,NULL ITCSGST'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' INTO TEMPTABLEDB..TEMPGSTRPT2_14'"
