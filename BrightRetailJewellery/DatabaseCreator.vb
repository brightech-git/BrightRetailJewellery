        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' ,CASE WHEN SUM(I_PCS)-SUM(R_PCS)>0 THEN 0 ELSE SUM(R_PCS)-SUM(I_PCS) END R_PCS ,'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' CASE WHEN SUM(I_GRSWT)-SUM(R_GRSWT)>0 THEN 0 ELSE SUM(R_GRSWT)-SUM(I_GRSWT) END R_GRSWT'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' , CASE WHEN SUM(I_NETWT)-SUM(R_NETWT)>0 THEN 0 ELSE SUM(R_NETWT)-SUM(I_NETWT) END R_NETWT'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+',''T2'' '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' FROM TEMPTABLEDB..'+@TEMPTABLE+' WHERE COLHEAD=''T1'' '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' GROUP BY METALID'"
        strSql += vbCrLf + "  PRINT @QUERY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY"

        strSql += vbCrLf + "  SET @QUERY=' INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(METALID,PARTICULARS,I_PCS,I_GRSWT,I_NETWT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT ''Z'',''TOTAL STOCK:'',SUM(I_PCS),SUM(I_GRSWT),SUM(I_NETWT),''T3'''"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+' FROM TEMPTABLEDB..'+@TEMPTABLE+' WHERE COLHEAD=''T2'' '"
        strSql += vbCrLf + "  PRINT @QUERY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "  SELECT @QUERY= ' SELECT * FROM TEMPTABLEDB..'+@TEMPTABLE +' ORDER BY METALID,COLHEAD'"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

