        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ,CASE WHEN A.PAYMODE=''CH'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CHEQUE,CASE WHEN A.PAYMODE=''CC'' THEN SUM(ISNULL(A.AMOUNT,0)) END AS CREDITCARD'"
