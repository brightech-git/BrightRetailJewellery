        strSql += vbCrLf + "   SELECT @QRY= @QRY+' AND ISNULL(T.COSTID,'''') IN (select costid from TEMPTABLEDB..TRAILCOSTCENTRE)'  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' UNION ALL '     "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' SELECT ''O''SEP,ACCODE,CASE WHEN TRANMODE = ''D'' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT,T.COSTID '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' FROM '+ @DBNAME +'..ACCTRAN AS T '      "
