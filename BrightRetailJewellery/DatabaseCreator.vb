    Private Sub Func_Sp_Alter_Column_Length()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_ADDLENGTH')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_ADDLENGTH"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_ADDLENGTH"
        strSql += vbCrLf + "	 @DBNAME VARCHAR(15)"
        strSql += vbCrLf + "	,@COLUMNNAME VARCHAR(100)"
        strSql += vbCrLf + "	,@LENGTH varchar(20)"
        strSql += vbCrLf + "AS "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @TABLENAME VARCHAR(100)"
        strSql += vbCrLf + "	DECLARE @CONSTRAINTNAME VARCHAR(100)	"
        strSql += vbCrLf + "	DECLARE @DATATYPE VARCHAR(100)	"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	DECLARE @KEYTYPE VARCHAR(50)"
        strSql += vbCrLf + "	DECLARE @REFTABLE VARCHAR(100)"
        strSql += vbCrLf + "	DECLARE @REFCOLUMN VARCHAR(100)"
        strSql += vbCrLf + "	DECLARE @NUMERICSCALE VARCHAR(1)"
        strSql += vbCrLf + "	IF (SELECT COUNT(*) FROM SYSOBJECTS WHERE name = 'TEMPTABLENAME' ) > 0 DROP TABLE TEMPTABLENAME"
        strSql += vbCrLf + "	IF (SELECT COUNT(*)CNT FROM INFORMATION_SCHEMA.COLUMNS  WHERE COLUMN_NAME = ''+@COLUMNNAME+'') > 0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		DECLARE CUR CURSOR FOR "
        strSql += vbCrLf + "		SELECT TABLE_NAME,COLUMN_NAME,DATA_TYPE,NUMERIC_SCALE FROM INFORMATION_SCHEMA.COLUMNS  WHERE COLUMN_NAME = ''+@COLUMNNAME+'' AND TABLE_NAME IN (SELECT NAME FROM SYSOBJECTS WHERE XTYPE='U')"
        strSql += vbCrLf + "		OPEN CUR "
        strSql += vbCrLf + "		FETCH NEXT FROM CUR INTO @TABLENAME,@COLUMNNAME,@DATATYPE,@NUMERICSCALE"
        strSql += vbCrLf + "			WHILE @@FETCH_STATUS  = 0"
        strSql += vbCrLf + "			BEGIN"
        strSql += vbCrLf + "				IF (SELECT COUNT(*) FROM INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE WHERE TABLE_NAME = ''+@TABLENAME+'' AND COLUMN_NAME = ''+@COLUMNNAME+'' ) >0"
        strSql += vbCrLf + "				BEGIN"
        strSql += vbCrLf + "					SELECT @CONSTRAINTNAME =  CONSTRAINT_NAME  FROM INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE WHERE TABLE_NAME = ''+@TABLENAME+'' AND COLUMN_NAME = ''+@COLUMNNAME+''"
        strSql += vbCrLf + "					SELECT @KEYTYPE =  CONSTRAINT_TYPE FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS T WHERE T.CONSTRAINT_NAME = @CONSTRAINTNAME  "
        strSql += vbCrLf + "					SELECT @REFTABLE =  OBJECT_NAME(REFERENCED_OBJECT_ID),@REFCOLUMN = COL_NAME(REFERENCED_OBJECT_ID,REFERENCED_COLUMN_ID )  FROM SYS.FOREIGN_KEY_COLUMNS WHERE OBJECT_NAME (CONSTRAINT_OBJECT_ID ) = @CONSTRAINTNAME"
        strSql += vbCrLf + "					SELECT @KEYTYPE =  CONSTRAINT_TYPE FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS T WHERE T.CONSTRAINT_NAME = @CONSTRAINTNAME  "
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' DROP CONSTRAINT '+@CONSTRAINTNAME+''"
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "					IF @DATATYPE = 'INT'"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+' NOT NULL'"
        strSql += vbCrLf + "					IF @DATATYPE  <> 'INT'"
        strSql += vbCrLf + "						IF ISNULL(@NUMERICSCALE,'0') <>  '0'"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+'('+@LENGTH+','+@NUMERICSCALE+')  NOT NULL'"
        strSql += vbCrLf + "						ELSE"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+'('+@LENGTH+')  NOT NULL'"
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "					PRINT @KEYTYPE"
        strSql += vbCrLf + "					IF @KEYTYPE = 'PRIMARY KEY'"
        strSql += vbCrLf + "					BEGIN"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ADD CONSTRAINT '+@CONSTRAINTNAME+' PRIMARY KEY('+@COLUMNNAME+')'"
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "					END"
        strSql += vbCrLf + "					IF @KEYTYPE = 'FOREIGN KEY'"
        strSql += vbCrLf + "					BEGIN		"
        strSql += vbCrLf + "						IF @DATATYPE = 'INT'"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+' NOT NULL'"
        strSql += vbCrLf + "						IF @DATATYPE  <> 'INT'"
        strSql += vbCrLf + "						IF ISNULL(@NUMERICSCALE,'0') <>  '0'"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@REFTABLE +' ALTER COLUMN '+@REFCOLUMN +' ' +@DATATYPE+'('+@LENGTH+','+@NUMERICSCALE+')  NOT NULL'"
        strSql += vbCrLf + "						ELSE"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@REFTABLE +' ALTER COLUMN '+@REFCOLUMN+' ' +@DATATYPE+'('+@LENGTH+')  NOT NULL'"
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY	"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ADD CONSTRAINT '+@CONSTRAINTNAME+' FOREIGN KEY('+@COLUMNNAME+')  REFERENCES [dbo].['+@REFTABLE+'] (['+@REFCOLUMN+'])'						 "
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "					END"
        strSql += vbCrLf + "					IF @KEYTYPE = 'UNIQUE KEY'"
        strSql += vbCrLf + "					BEGIN"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ADD CONSTRAINT '+@CONSTRAINTNAME+' UNIQUE('+@COLUMNNAME+')  REFERENCES [dbo].['+@REFTABLE+'] (['+@REFCOLUMN+'])'						 "
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "					END"
        strSql += vbCrLf + "				END"
        strSql += vbCrLf + "				ELSE"
        strSql += vbCrLf + "				BEGIN"
        strSql += vbCrLf + "					IF @DATATYPE = 'INT'"
        strSql += vbCrLf + "						SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+''"
        strSql += vbCrLf + "					IF @DATATYPE  <> 'INT'"
        strSql += vbCrLf + "						IF ISNULL(@NUMERICSCALE,'0') <>  '0'"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+'('+@LENGTH+','+@NUMERICSCALE+')'"
        strSql += vbCrLf + "						ELSE"
        strSql += vbCrLf + "							SELECT @QRY = 'ALTER TABLE '+@TABLENAME+' ALTER COLUMN '+@COLUMNNAME+' ' +@DATATYPE+'('+@LENGTH+')'"
        strSql += vbCrLf + "						EXEC (@QRY)"
        strSql += vbCrLf + "						PRINT @QRY"
        strSql += vbCrLf + "				END"
        strSql += vbCrLf + "				FETCH NEXT FROM CUR INTO @TABLENAME, @COLUMNNAME,@DATATYPE,@NUMERICSCALE"
        strSql += vbCrLf + "			END	"
        strSql += vbCrLf + "		CLOSE CUR"
        strSql += vbCrLf + "		DEALLOCATE CUR	"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub funspAlterBatchno_Width(ByVal Trandb As String)
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_ALTER_BATCHNO_WIDTH')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_ALTER_BATCHNO_WIDTH"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_ALTER_BATCHNO_WIDTH"
        strSql += vbCrLf + "  (@TRANDB VARCHAR(15))"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  DECLARE @TNAME VARCHAR(30)"
        strSql += vbCrLf + "  DECLARE @BATCHNO VARCHAR(30)"
        strSql += vbCrLf + "  DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  DECLARE CUR CURSOR"
        strSql += vbCrLf + " FOR "
        strSql += vbCrLf + " SELECT T.NAME NAME,C.NAME AS BATCHNO FROM  " & Trandb & "..SYSCOLUMNS AS C INNER JOIN "
        strSql += vbCrLf + " " & Trandb & "..SYSOBJECTS AS T ON C.ID = T.ID AND T.NAME NOT LIKE 'CUSTOMER%'"
        strSql += vbCrLf + " WHERE C.NAME LIKE '%BATCHNO' AND T.TYPE='U'"
        strSql += vbCrLf + " OPEN CUR"
        strSql += vbCrLf + " WHILE 1 = 1"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	FETCH NEXT FROM CUR INTO @TNAME,@BATCHNO"
        strSql += vbCrLf + " 	SET NOCOUNT ON"
        strSql += vbCrLf + " 	IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "     SELECT @QRY = ' ALTER TABLE '+@TRANDB+'..'+ @TNAME + ' ALTER COLUMN '+@BATCHNO+' VARCHAR(15)'"
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " CLOSE CUR"
        strSql += vbCrLf + " DEALLOCATE CUR"
        strSql += vbCrLf + "  DECLARE @TBLNAME VARCHAR(30)"
        strSql += vbCrLf + "  DECLARE @CONSTNAME VARCHAR(30)"
        strSql += vbCrLf + "  DECLARE RUNCUR CURSOR FOR "
        strSql += vbCrLf + "  SELECT TC.CONSTRAINT_NAME,TC.TABLE_NAME FROM "
        strSql += vbCrLf + "  INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc"
        strSql += vbCrLf + "  JOIN INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE ccu ON tc.CONSTRAINT_NAME = ccu.Constraint_name"
        strSql += vbCrLf + "  WHERE tc.CONSTRAINT_TYPE = 'Primary Key'"
        strSql += vbCrLf + "  AND CCU.COLUMN_NAME ='BATCHNO'"
        strSql += vbCrLf + "  OPEN RUNCUR"
        strSql += vbCrLf + "  FETCH NEXT FROM RUNCUR INTO @CONSTNAME,@TBLNAME"
        strSql += vbCrLf + "  WHILE @@FETCH_STATUS<>-1"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @QRY='ALTER TABLE '+ @TBLNAME +' DROP CONSTRAINT '+@CONSTNAME "
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY='ALTER TABLE '+ @TBLNAME +' ALTER COLUMN BATCHNO VARCHAR(15) NOT NULL'"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY='ALTER TABLE '+ @TBLNAME +' ADD CONSTRAINT '+@CONSTNAME +' PRIMARY KEY(BATCHNO)'"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	FETCH NEXT FROM RUNCUR INTO @CONSTNAME,@TBLNAME"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  CLOSE RUNCUR"
        strSql += vbCrLf + "  DEALLOCATE RUNCUR"

        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "EXEC " & Trandb & "..SP_ALTER_BATCHNO_WIDTH @TRANDB='" & Trandb & "'"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funspAlterTagno_Width(ByVal Trandb As String)
