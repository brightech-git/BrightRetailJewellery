        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' ,(SELECT TOP 1 TRANDATE FROM  OUTSTANDING WHERE RUNNO = X.RUNNO AND COSTID = X.COSTID AND COMPANYID = X.COMPANYID ORDER BY TRANDATE )AS TRANDATE'   "
