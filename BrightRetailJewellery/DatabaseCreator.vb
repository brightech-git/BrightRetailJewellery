        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' AND ISNULL(I.CANCEL,'''') = ''''  AND (TRANTYPE NOT IN (''PU'',''RPU'') OR (TRANTYPE=''PU'' AND TRANFLAG =''W''))'"
        strSql += vbCrLf + "      SELECT @QRY= @QRY + @APPTYPE "
