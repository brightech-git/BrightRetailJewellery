        'strSql += vbCrLf + "  	,TMP NUMERIC(15,2) "
        'strSql += vbCrLf + "  	) "
        'strSql += vbCrLf + "  	DECLARE @QRY VARCHAR(8000)"
        'strSql += vbCrLf + "  	/** OPENING CASH **/     "
        'strSql += vbCrLf + "  	IF @OPENING = 'Y' "
        'strSql += vbCrLf + "  	BEGIN"
        'strSql += vbCrLf + "  		SELECT @QRY=CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,ACCODE,COLHEAD,RESULT)   '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' SELECT TRANDATE,CONVERT(VARCHAR,'''')TRANNO,''CASH OPENING''ACNAME              '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN SUM(CREDIT)- SUM(DEBIT) > 0 THEN SUM(CREDIT)- SUM(DEBIT) ELSE 0 END AS DEBIT'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN SUM(DEBIT) - SUM(CREDIT) > 0 THEN SUM(DEBIT) - SUM(CREDIT) ELSE 0 END AS CREDIT '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(VARCHAR(8),NULL) ACCODE,''T'',1  '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' FROM'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ('"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT T.TRANDATE,CONVERT(VARCHAR,'''')TRANNO'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL((SELECT SUM(DEBIT) FROM OPENTRAILBALANCE '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) '"
        'strSql += vbCrLf + "  		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID = '''+@COMPANYID+''' '*/"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"



        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) '"
        'strSql += vbCrLf + "  		IF @USER<>'ALL'"
        'strSql += vbCrLf + "  			SELECT @QRY=@QRY+CHAR(13)+' AND USERID IN (SELECT USERID FROM #USERNAME)'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ),0) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' + ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE 0 END) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' FROM ACCTRAN  WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC)'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(CANCEL,'''') = '''' '"
        'strSql += vbCrLf + "  		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN ('''+@COMPANYID+''')  '*/"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '"
        'strSql += vbCrLf + "  		IF @USER<>'ALL'"
        'strSql += vbCrLf + "  			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(USERID,'''') IN (SELECT USERID FROM #USERNAME) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ),0) AS DEBIT'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL((SELECT SUM(CREDIT) FROM OPENTRAILBALANCE '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) '"
        'strSql += vbCrLf + "  		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID = '''+@COMPANYID+''' '*/"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) '"
        'strSql += vbCrLf + "  		IF @USER<>'ALL'"
        'strSql += vbCrLf + "  			SELECT @QRY=@QRY+CHAR(13)+' AND USERID IN (SELECT USERID FROM #USERNAME) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ),0) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' + ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''C'' THEN ISNULL(AMOUNT,0) ELSE 0 END) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' FROM ACCTRAN  WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(CANCEL,'''') = '''' '"
        'strSql += vbCrLf + "  		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN ('''+@COMPANYID+''')  '*/"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '"
        'strSql += vbCrLf + "  		IF @USER<>'ALL'"
        'strSql += vbCrLf + "  			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(USERID,'''') IN (SELECT USERID FROM #USERNAME) '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ),0) AS CREDIT'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' FROM ACCTRAN AS T'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' WHERE T.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.CANCEL,'''') = '''' '"
