        strSql += vbCrLf + " IF NOT EXISTS (SELECT 1 FROM SYS.INDEXES I WHERE I.NAME = 'WEBCATALOGRATEMAST' AND I.OBJECT_ID = OBJECT_ID('DBO.RATEMAST'))     "
        strSql += vbCrLf + " BEGIN     "
