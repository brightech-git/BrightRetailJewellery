        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' LEFT JOIN USERMASTER AS U ON A.USERID=U.USERID'"
        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' WHERE A.PAYMODE IN(''SA'',''PU'',''AA'',''CH'',''SS'',''CA'',''CC'',''DI'',''DU'',''SR'') '"
        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' AND BATCHNO IN (SELECT DISTINCT BATCHNO FROM '+@DBNAME+'..ISSUE WHERE TRANDATE BETWEEN '''+ @FROMDATE+''' AND '''+ @TODATE +''''"
