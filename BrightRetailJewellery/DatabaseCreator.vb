        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''PARTLY SALES'',SUM(TAGPCS)-SUM(PCS),SUM(TAGGRSWT)-SUM(GRSWT),SUM(TAGNETWT)-SUM(NETWT),''2'' FROM '+@DBNAME+'..ISSUE  AS I '"
