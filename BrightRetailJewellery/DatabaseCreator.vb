        strSql += vbCrLf + "   REFRED TABLES    :  & trandbname & ..ISSUE, & trandbname & ..ISSSTONE"
        strSql += vbCrLf + " 		      & trandbname & ..ITEMTAG, & trandbname & ..ITEMTAGSTONE"
        strSql += vbCrLf + " 		      & COMPID + SUFFIX & ..COSTCENTRE, & COMPID + SUFFIX & ..ITEMMAST, & COMPID + SUFFIX & ..METALMAST"
        strSql += vbCrLf + "   REFRED FORMS/DLL : MDIREPORT=>FRMPARTLEYSALESREPORT"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "    CREATED/MODIFIED            MODIFIED                 DESCRIPTION"
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " ****************************************************************************************** */"
        strSql += vbCrLf + " /* -- ================================================="
        strSql += vbCrLf + " -- ALREADY EXISTS THIS PROCEDURE DROP THIS PROCEDURE"
        strSql += vbCrLf + " -- ================================================= */"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PARTLYSALES')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_PARTLYSALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()


        strSql = "  /* ** ======================= */"
        strSql += vbCrLf + "  /* ** CREATE STORE PROCEDURE */"
        strSql += vbCrLf + "  /* ** ======================= */"
        strSql += vbCrLf + "  CREATE PROCEDURE SP_RPT_PARTLYSALES"
        strSql += vbCrLf + "  /* ** ================== */    "
        strSql += vbCrLf + "  /* ** DECLARE VARIABLES */    "
        strSql += vbCrLf + "  /* ** ================== */    "
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "     @DATEFROM  VARCHAR(12)/* ** FROMDATE */    "
        strSql += vbCrLf + "    ,@DATETO VARCHAR(12)/* ** ENDDATE */    "
        strSql += vbCrLf + "    ,@METALNAME NVARCHAR(75)/* ** METAL NAME FROM PERSONALINFO TABLE */    "
        strSql += vbCrLf + "    ,@ITEMNAME NVARCHAR(75)/* ** ITEM NAME FROM PERSONALINFO TABLE */    "
        strSql += vbCrLf + "    ,@COSTNAME NVARCHAR(150)/* ** COST NAME FROM PERSONALINFO TABLE */    "
        strSql += vbCrLf + "    ,@NODEID NVARCHAR(150)/* ** NODEID FROM RECEIPT */    "
        strSql += vbCrLf + "    ,@SYSTEMID NVARCHAR(20)/* ** GIVE THE SYSTEMID FOR TEMPORARY TABLES */    "
        strSql += vbCrLf + "    ,@CNADMINDB NVARCHAR(50)/* ** GIVE THE DATABASE NAME FOR ADMINDB  */    "
        strSql += vbCrLf + "    ,@CNSTOCKDB NVARCHAR(50)/* ** GIVE THE DATABASE NAME FOR STOCKDB */    "
        strSql += vbCrLf + "    ,@COMPANYID NVARCHAR(500)/* ** GIVE THE COMPANYID*/    "
        strSql += vbCrLf + "    ,@CASHID NVARCHAR(2000)/* ** GIVE THE CASHCOUNTER*/    "
        strSql += vbCrLf + "  )AS     "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY    "
        strSql += vbCrLf + "  CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))    "
        strSql += vbCrLf + "  DECLARE @TCOMPANY VARCHAR(50)    "
        strSql += vbCrLf + "  IF CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "   BEGIN    "
        strSql += vbCrLf + "   INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID    "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "  WHILE CHARINDEX(',',@COMPANYID)>0    "
        strSql += vbCrLf + "   BEGIN    "
        strSql += vbCrLf + "   SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)    "
        strSql += vbCrLf + "   SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))    "
        strSql += vbCrLf + "   IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "    BEGIN    "
        strSql += vbCrLf + "    SET @COMPANYID= @COMPANYID + ','    "
        strSql += vbCrLf + "    END    "
        strSql += vbCrLf + "   INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY    "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)    "
        strSql += vbCrLf + "  /* ** ================================================== */    "
        strSql += vbCrLf + "  /* ** TAKE COMMON DATAS BETWEEN ITEMTAG AND ISSUE TABLES */    "
        strSql += vbCrLf + "  /* ** ================================================== */    "
        strSql += vbCrLf + "  SELECT @STRQRY =''    "
        strSql += vbCrLf + "  SELECT @STRQRY ='IF (SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SystemId+'PARTLYREPORT'') > 0'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' DROP TABLE TEMPTABLEDB..TEMP'+@SystemId+'PARTLYREPORT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' SELECT I.TRANDATE,I.TRANTYPE,I.SNO AS ISSSNO,I.TRANNO,I.ITEMID'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT ITEMNAME FROM '+@CNADMINDB+'..ITEMMAST AS IM WHERE I.ITEMID=IM.ITEMID) AS ITEMNAME'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,I.TAGNO AS TAGNO'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,I.TAGPCS AS ACTUALPCS,I.TAGGRSWT AS ACTUALGRSWT,I.TAGNETWT AS ACTUALNETWT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,I.PCS AS SALESPCS,I.GRSWT AS SALESGRSWT,I.NETWT AS SALESNETWT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(I.TAGPCS-I.PCS) AS PCS,(I.TAGGRSWT-I.GRSWT) AS GRSWT,(I.TAGNETWT-I.NETWT) AS NETWT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT SUM(TAGSTNWT-STNWT) FROM '+@CNSTOCKDB+'..ISSSTONE WHERE ISSSNO=I.SNO HAVING SUM(TAGSTNWT-STNWT) <> 0) AS STNWT'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT DESIGNERNAME FROM '+@CNADMINDB+'..DESIGNER WHERE CONVERT(VARCHAR(100),DESIGNERID) = I.TAGDESIGNER)AS DESIGNER'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT EMPNAME FROM '+@CNADMINDB+'..EMPMASTER WHERE EMPID = I.EMPID)AS EMPNAME'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,TABLECODE'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,I.BATCHNO AS BATCHNO,1 RESULT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' INTO TEMPTABLEDB..TEMP'+@SystemId+'PARTLYREPORT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' FROM '+@CNSTOCKDB+'..ISSUE AS I'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' WHERE I.TRANDATE BETWEEN '''+@DATEFROM+''' AND '''+@DATETO+''''    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND I.TAGNO<>'''''    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND ((I.TAGGRSWT-I.GRSWT)<>0 OR (I.TAGNETWT-I.NETWT)<>0 OR (I.TAGPCS-I.PCS)<>0)'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND I.ITEMID IN (SELECT ITEMID FROM '+@CNADMINDB+'..ITEMMAST WHERE ISNULL(STOCKTYPE,'''')<>''P'')'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND ISNULL(I.CANCEL,'''') = '''' AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'     "
        strSql += vbCrLf + "  IF @NODEID <>''     "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.SYSTEMID IN ('+@NODEID+') '     "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @COSTNAME <>''    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.COSTID IN  (SELECT COSTID FROM '+@CNADMINDB+'..COSTCENTRE WHERE COSTNAME IN ('+@COSTNAME+'))'     "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @METALNAME <>'ALL' AND @METALNAME <> ''     "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.METALID=(SELECT METALID FROM '+@CNADMINDB+'..METALMAST WHERE METALNAME='''+@METALNAME+''')'    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @ITEMNAME<>'ALL' AND @ITEMNAME<>''    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.ITEMID =(SELECT ITEMID FROM '+@CNADMINDB+'..ITEMMAST WHERE ITEMNAME='''+@ITEMNAME+''')'    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @CASHID <>'ALL' AND @CASHID<>'' "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.CASHID IN (SELECT CASHID FROM '+@CNADMINDB+'..CASHCOUNTER WHERE CASHNAME IN ('+@CASHID+'))'  "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' UNION ALL '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' SELECT ISS.TRANDATE,ISS.TRANTYPE,ISS.ISSSNO AS ISSSNO,ISS.TRANNO,ISS.STNITEMID '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT ITEMNAME FROM '+@CNADMINDB+'..ITEMMAST AS IM WHERE ISS.STNITEMID=IM.ITEMID) AS ITEMNAME,'''' AS TAGNO ,'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ISS.TAGSTNPCS AS ACTUALPCS,ISS.TAGSTNWT AS ACTUALGRSWT,0 AS ACTUALNETWT ,ISS.STNPCS AS SALESPCS,ISS.STNWT AS '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' SALESGRSWT,0 AS SALESNETWT ,(ISS.TAGSTNPCS-ISS.STNPCS) AS PCS,(ISS.TAGSTNWT-ISS.STNWT) AS GRSWT,0'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AS NETWT ,(ISS.TAGSTNWT-ISS.STNWT) AS STNWT,'''' AS DESIGNER ,'''' AS EMPNAME ,'''' TABLECODE ,ISS.BATCHNO AS BATCHNO,2 RESULT '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' FROM '+@CNSTOCKDB+'..ISSSTONE AS ISS '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' LEFT OUTER JOIN '+@CNSTOCKDB+'..ISSUE I ON I.SNO=ISS.ISSSNO'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' WHERE  ISS.TRANDATE BETWEEN '''+@DATEFROM+''' AND '''+@DATETO+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND I.TAGNO<>'''''    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND I.ITEMID IN (SELECT ITEMID FROM '+@CNADMINDB+'..ITEMMAST WHERE ISNULL(STOCKTYPE,'''')<>''P'')'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND ((ISS.TAGSTNWT-ISS.STNWT)<>0 OR (ISS.TAGSTNPCS-ISS.STNPCS)<>0)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND ISNULL(I.CANCEL,'''') = '''' AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'     "
        strSql += vbCrLf + "  IF @NODEID <>''     "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.SYSTEMID IN ('+@NODEID+') '     "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @COSTNAME <>''    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.COSTID IN  (SELECT COSTID FROM '+@CNADMINDB+'..COSTCENTRE WHERE COSTNAME IN ('+@COSTNAME+'))'     "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @METALNAME <>'ALL' AND @METALNAME <> ''     "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.METALID=(SELECT METALID FROM '+@CNADMINDB+'..METALMAST WHERE METALNAME='''+@METALNAME+''')'    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @ITEMNAME<>'ALL' AND @ITEMNAME<>''    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.ITEMID =(SELECT ITEMID FROM '+@CNADMINDB+'..ITEMMAST WHERE ITEMNAME='''+@ITEMNAME+''')'    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @CASHID <>'ALL' AND @CASHID<>'' "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @STRQRY =@STRQRY + ' AND I.CASHID IN (SELECT CASHID FROM '+@CNADMINDB+'..CASHCOUNTER WHERE CASHNAME IN ('+@CASHID+'))'  "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** EXECUTE QUERY */    "
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** PRINT @STRQRY */    "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY    "
        strSql += vbCrLf + " /* ** ==================== */    "
        strSql += vbCrLf + "  /* ** STONE TABLE QUERY */    "
        strSql += vbCrLf + "  /* ** ==================== */    "
        strSql += vbCrLf + "  /* ** ==================== */    "
        strSql += vbCrLf + "  /* ** ITEM TAGSTONE QUERY */    "
        strSql += vbCrLf + "  /* ** ==================== */    "
        strSql += vbCrLf + "SELECT @STRQRY =' IF (SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS  WHERE NAME =''TEMP'+@SystemId+'TAGSTONE'') > 0'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' DROP TABLE TEMPTABLEDB..TEMP'+@SystemId+'TAGSTONE'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' SELECT T.TRANDATE,T.TRANTYPE,T.ITEMID AS ITEMID,T.TAGNO AS TAGNO,T.ISSSNO'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' ,CASE (SELECT DIASTONE FROM '+@CNADMINDB+'..ITEMMAST WHERE ITEMID = T.ITEMID)'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' WHEN ''P'' THEN ''     PRECIOUS'' WHEN ''D'' THEN ''     DIAMOND'' ELSE ''     STONE'' END AS ITEMNAME'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' ,T.ACTUALPCS AS ACTUALSTNPCS,T.ACTUALGRSWT AS ACTUALGRSWT,T.ACTUALNETWT AS ACTUALNTWT,T.BATCHNO AS BATCHNO'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' INTO TEMPTABLEDB..TEMP'+@SystemId+'TAGSTONE FROM TEMPTABLEDB..TEMP'+@SystemId+'PARTLYREPORT AS T'    "
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** EXECUTE QUERY */    "
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** PRINT @STRQRY */    "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY    "
        strSql += vbCrLf + "  /* ** ==================== */    "
        strSql += vbCrLf + "  /* ** ISSUE STONE QUERY */    "
        strSql += vbCrLf + "  /* ** ==================== */    "
        strSql += vbCrLf + "SELECT @STRQRY =' IF (SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME =''TEMP'+@SystemId+'ISSSTONE'') > 0'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' DROP TABLE TEMPTABLEDB..TEMP'+@SystemId+'ISSSTONE'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' SELECT I.TRANDATE,I.TRANTYPE,I.ITEMID,I.TAGNO,I.ISSSNO'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' ,CASE (SELECT DIASTONE FROM '+@CNADMINDB+'..ITEMMAST WHERE ITEMID = I.ITEMID)'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' WHEN ''P'' THEN ''     PRECIOUS'' WHEN ''D'' THEN ''     DIAMOND'' ELSE ''     STONE'' END AS ITEMNAME'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' ,I.PCS AS SALESSTNPCS,I.GRSWT AS SALESGRSWT,I.GRSWT AS SALESNTWT,I.BATCHNO AS BATCHNO'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' INTO TEMPTABLEDB..TEMP'+@SystemId+'ISSSTONE'    "
        strSql += vbCrLf + "SELECT @STRQRY =@STRQRY + ' FROM TEMPTABLEDB..TEMP'+@SystemId+'PARTLYREPORT AS I'"
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** EXECUTE QUERY */    "
        strSql += vbCrLf + "  /* ** ============== */    "
        strSql += vbCrLf + "  /* ** PRINT @STRQRY */    "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY    "
        strSql += vbCrLf + "  /* ** ================================================ */    "
        strSql += vbCrLf + "  /* ** TAKE COMMON DATAS BETWEEN TEMPORARY STONE TABLES */    "
        strSql += vbCrLf + "  /* ** ================================================ */    "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function



    Function funcSP10_Miscellaneous() As Integer
        strSql = " /* -- ========================================= */"
        strSql += vbCrLf + " /* -- Store procedure for MISCELLANEOUS Report */"
        strSql += vbCrLf + " /* -- ========================================= */"
        strSql += vbCrLf + " /* *************************************************************************************** */"
        strSql += vbCrLf + " /*  Intitial Authors :        */"
        strSql += vbCrLf + " /*  Create   Date    : 09/09/2008      */"
        strSql += vbCrLf + " /*  Purpose          : For MISCELLANEOUS REPORT      */"
        strSql += vbCrLf + " /*  Refred Tables    :  & trandbname & ..ISSUE, & trandbname & ..ISSSTONE */"
        strSql += vbCrLf + " /*		      & COMPID + SUFFIX & ..ITEMMAST, & COMPID + SUFFIX & ..SUBITEMMAST, & COMPID + SUFFIX & ..CATEGORY */"
