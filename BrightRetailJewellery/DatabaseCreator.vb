        strSql += vbCrLf + "	IF @COSTNAME <> '' AND @COSTNAME <> 'ALL' SELECT @QRY = @QRY +CHAR(13)+ ', A.COSTID'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'FROM '+@DBNAME+'..ACCTRAN AS A'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ ','+@ADMINDB+'..TRANPAYMODE AS B'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'WHERE A.PAYMODE = B.PAYMODE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'AND TRANDATE BETWEEN '''+@FDATE+''' AND '''+@TDATE+''' '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'AND ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'AND A.PAYMODE IN (''AR'',''SA'',''PU'',''SR'',''OD'',''RD'',''OR'')'"
        strSql += vbCrLf + "	IF @COSTNAME <> '' AND @COSTNAME <> 'ALL' SELECT @QRY = @QRY +CHAR(13)+ 'AND A.COSTID IN (SELECT COSTID FROM '+@ADMINDB+'..COSTCENTRE WHERE COSTNAME IN ('''+@COSTNAME+'''))'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+ 'GROUP BY B.PAYDESC,A.PAYMODE'"
        strSql += vbCrLf + "	IF @COSTNAME <> '' AND @COSTNAME <> 'ALL' SELECT @QRY = @QRY +CHAR(13)+ ' ,A.COSTID'"
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

