        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,SUM(CASE WHEN TRANMODE = ''D'' THEN AMOUNT ELSE 0 END) AS DEBIT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,SUM(CASE WHEN TRANMODE = ''C'' THEN AMOUNT ELSE 0 END) AS CREDIT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,CASE WHEN PAYMODE IN(''SA'',''PU'',''SR'') THEN SUM(ISNULL(GRSWT,0)) END GRSWT,T.CONTRA ACCODE,PAYMODE,2 RESULT,T.BATCHNO,WT_ENTORDER AS ENTRYORDER'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,REFNO,REFDATE,CHQCARDNO,CHQDATE'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' FROM '+@DBNAME+'..ACCTRAN AS T'"
