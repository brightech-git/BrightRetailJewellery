        strSql += vbCrLf + "      			IF CHARINDEX(',',@CASHNAME)=0 "
        strSql += vbCrLf + "      			INSERT INTO TEMPTABLEDB.DBO.TEMPCASH (CASHID) SELECT ISNULL(CASHID,0) FROM " & compId & "ADMINDB..CASHCOUNTER WHERE CASHNAME = @CASHNAME "
