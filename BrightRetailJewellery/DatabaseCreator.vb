        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERWISEDETAIL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "CREATE PROCEDURE SP_RPT_COUNTERWISEDETAIL"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(30) "
        strSql += vbCrLf + ",@FRMDATE VARCHAR(12)     "
        strSql += vbCrLf + ",@ASONDATE  VARCHAR(15)             "
        strSql += vbCrLf + ",@METALID VARCHAR(100)             "
        strSql += vbCrLf + ",@CATCODE VARCHAR(100)             "
        strSql += vbCrLf + ",@ITEMIDS VARCHAR(100)             "
        strSql += vbCrLf + ",@DESIGNERID VARCHAR(100)             "
        strSql += vbCrLf + ",@COUNTERID VARCHAR(5000)             "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(5000)             "
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS            "
        strSql += vbCrLf + "SET NOCOUNT ON   "
        strSql += vbCrLf + "DECLARE @QRY VARCHAR(8000) "
        strSql += vbCrLf + "SELECT @QRY='IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPITEMCTRSTOCK'') DROP TABLE TEMPTABLEDB..TEMPITEMCTRSTOCK               '"
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC(@QRY) "
        strSql += vbCrLf + "DECLARE @ITEMFILTER VARCHAR(4000)"
        strSql += vbCrLf + "DECLARE @COUNTERFILTER VARCHAR(4000)"
        strSql += vbCrLf + "PRINT @METALID"
        strSql += vbCrLf + "SET @ITEMFILTER=' ' /** ITEM FILTER**/ "
        strSql += vbCrLf + "SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  ITEMMAST WHERE ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y'')'"
        strSql += vbCrLf + "IF @METALID <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  ITEMMAST WHERE METALID IN('''+@METALID+'''))'"
        strSql += vbCrLf + "IF @ITEMIDS <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND T.ITEMID IN('+@ITEMIDS+')' "
        strSql += vbCrLf + "IF @DESIGNERID <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND ISNULL(T.DESIGNERID,0) IN('''+ @DESIGNERID +''')'"
        strSql += vbCrLf + "IF @CATCODE <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  ITEMMAST WHERE CATCODE IN('''+@CATCODE+'''))'"
        strSql += vbCrLf + "SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "IF @COMPANYID <> 'ALL' OR @COMPANYID <> ''      SET @ITEMFILTER = @ITEMFILTER+ ' AND T.COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "SET @COUNTERFILTER='' /** COUNTER FILTER**/ "
        strSql += vbCrLf + "SET @COUNTERID = REPLACE(@COUNTERID,',',''',''')  "
        strSql += vbCrLf + "IF @COUNTERID <> 'ALL' OR @COUNTERID <> ''  SET @COUNTERFILTER= @COUNTERFILTER + ' AND ISNULL(T.ITEMCTRID,0) IN ('''+ @COUNTERID +''')'"



        strSql += vbCrLf + "SELECT @QRY=' IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPITEMCTRTAG'') DROP TABLE TEMPTABLEDB..TEMPITEMCTRTAG               '"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' IF OBJECT_ID(''TEMPTABLEDB..TEMPITEMCTRSTOCK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT CONVERT (VARCHAR(50),SEP)SEP,CONVERT(VARCHAR(50),'''')TAGNO,ITEMCTRID,COUNTERNAME,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,CONVERT (INT ,0)ITEMID,CCOUNTER,COLHEAD'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' INTO TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' FROM ('"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''[A]OPENING'' SEP,T.ITEMCTRID,''OPENING'' COUNTERNAME,0 PCS,0 GRSWT,0 NETWT,'''' AS CCOUNTER,''T'' COLHEAD FROM ITEMTAG T'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' UNION ALL'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''[A]OPENING'' SEP,T.ITEMCTRID,ITEMCTRNAME AS COUNTERNAME,T.PCS,GRSWT,NETWT,ITEMCTRNAME AS CCOUNTER,''C'' COLHEAD FROM ITEMTAG T'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' LEFT OUTER JOIN  ITEMCOUNTER IT ON IT.ITEMCTRID=T.ITEMCTRID'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE RECDATE < '''+@FRMDATE+''' '"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' AND (ISSDATE >='''+@FRMDATE+'''  OR ISSDATE IS NULL) '"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @ITEMFILTER"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @COUNTERFILTER   "
        strSql += vbCrLf + "SELECT @QRY=@QRY+' )X'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' GROUP BY ITEMCTRID,SEP,COUNTERNAME,CCOUNTER,COLHEAD'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,COUNTERNAME,CCOUNTER,ITEMCTRID,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' SELECT DISTINCT ''[F]FILLED ITEMS'','''','''',ITEMCTRID,''O'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,COUNTERNAME,CCOUNTER,ITEMCTRID,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' SELECT DISTINCT ''[F]FILLED ITEMS'',''FILLED ITEMS'','''',ITEMCTRID,''T'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY +' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,TAGNO,ITEMID,COUNTERNAME,PCS,GRSWT,NETWT,ITEMCTRID,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''[F]FILLED ITEMS'' SEP,TAGNO,T.ITEMID,ITEMNAME,SUM(T.PCS)PCS,SUM(T.GRSWT)GRSWT,SUM(NETWT)NETWT,T.ITEMCTRID,ITEMNAME,''C'' COLHEAD FROM ITEMTAG T'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' LEFT OUTER JOIN  ITEMMAST IT ON IT.ITEMID=T.ITEMID'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE RECDATE  BETWEEN '''+@FRMDATE+''' AND  '''+@ASONDATE+''''"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @ITEMFILTER"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @COUNTERFILTER   "
        strSql += vbCrLf + "SELECT @QRY = @QRY + 'GROUP BY T.ITEMID,T.ITEMCTRID,ITEMNAME,TAGNO'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,COUNTERNAME,CCOUNTER,ITEMCTRID,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' SELECT DISTINCT ''[S]SOLD ITEMS'','''','''',ITEMCTRID,''O'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,COUNTERNAME,CCOUNTER,ITEMCTRID,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' SELECT DISTINCT ''[S]SOLD ITEMS'',''SOLD ITEMS'','''',ITEMCTRID,''T'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY =@QRY +' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,TAGNO,ITEMID,COUNTERNAME,PCS,GRSWT,NETWT,ITEMCTRID,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''[S]SOLD ITEMS''SEP,TAGNO,T.ITEMID,ITEMNAME,SUM(PCS)PCS,SUM(T.GRSWT)GRSWT,SUM(NETWT)NETWT,ITEMCTRID,ITEMNAME,''C'' COLHEAD FROM ITEMTAG T'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' LEFT OUTER JOIN  ITEMMAST IT ON IT.ITEMID=T.ITEMID '"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE '"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' ISSDATE BETWEEN '''+@FRMDATE+''' AND  '''+@ASONDATE+''''"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @ITEMFILTER"
        strSql += vbCrLf + "SELECT @QRY = @QRY + @COUNTERFILTER   "
        strSql += vbCrLf + "SELECT @QRY=@QRY+' GROUP BY T.ITEMID,ITEMCTRID,ITEMNAME,TAGNO'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPITEMCTRSTOCK)>0'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' BEGIN'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK (ITEMCTRID,COUNTERNAME,PCS,GRSWT,NETWT,SEP,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT DISTINCT ITEMCTRID,''TOTAL'''"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' ,SUM(PCS),SUM(GRSWT),SUM(NETWT),SEP,''ZZZZZ.TOTAL'',''S'' COLHEAD'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' FROM TEMPTABLEDB..TEMPITEMCTRSTOCK  WHERE ISNULL(ITEMCTRID,0) IN ('''+ @COUNTERID +''') GROUP BY ITEMCTRID,SEP'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' END'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,ITEMCTRID,COUNTERNAME,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT DISTINCT ''CLOSING'' SEP,ITEMCTRID,'''' COUNTERNAME,''''CCOUNTER,''T'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,ITEMCTRID,COUNTERNAME,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT DISTINCT ''CLOSING'' SEP,ITEMCTRID,''CLOSING'' COUNTERNAME,''''CCOUNTER,''T'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' INSERT INTO TEMPTABLEDB..TEMPITEMCTRSTOCK(SEP,ITEMCTRID,COUNTERNAME,PCS,GRSWT,NETWT,CCOUNTER,COLHEAD)'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT DISTINCT ''CLOSING'' SEP,ITEMCTRID,COUNTERNAME,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,CCOUNTER,COLHEAD'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' FROM('"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''CLOSING'' AS SEP,ITEMCTRID,(SELECT ITEMCTRNAME FROM  ITEMCOUNTER WHERE ITEMCTRID=T.ITEMCTRID AND ISNULL(T.ITEMCTRID,0) IN ('''+ @COUNTERID +''')) AS COUNTERNAME,PCS AS PCS,GRSWT AS GRSWT,NETWT AS NETWT,CCOUNTER,''C'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK T'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE SEP IN (''[A]OPENING'',''[F]FILLED ITEMS'') AND COUNTERNAME=''TOTAL'''"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' UNION ALL'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' SELECT ''CLOSING'' AS SEP,ITEMCTRID,(SELECT ITEMCTRNAME FROM  ITEMCOUNTER WHERE ITEMCTRID=T.ITEMCTRID AND ISNULL(T.ITEMCTRID,0) IN ('''+ @COUNTERID +''')) AS COUNTERNAME,-1*PCS AS PCS,-1*GRSWT AS GRSWT,-1*NETWT AS NETWT,CCOUNTER,''C'' COLHEAD FROM TEMPTABLEDB..TEMPITEMCTRSTOCK T' "
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE SEP =''[S]SOLD ITEMS'' AND COUNTERNAME=''TOTAL'''"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' )X'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' GROUP BY ITEMCTRID,COUNTERNAME,CCOUNTER,COLHEAD'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY= ' UPDATE TEMPTABLEDB..TEMPITEMCTRSTOCK SET PCS=NULL,GRSWT=NULL,NETWT=NULL WHERE PCS=0 AND GRSWT=0.000 AND NETWT=0.000'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        strSql += vbCrLf + "SELECT @QRY=' SELECT * FROM TEMPTABLEDB..TEMPITEMCTRSTOCK'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' WHERE ISNULL(ITEMCTRID,0) IN ('''+ @COUNTERID +''')'"
        strSql += vbCrLf + "SELECT @QRY=@QRY+' ORDER BY ITEMCTRID,SEP,CCOUNTER,ITEMID,COLHEAD'"
        strSql += vbCrLf + "PRINT @QRY "
        strSql += vbCrLf + "EXEC(@QRY)"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Private Sub funcTransferCitemtag()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CITEMTAG_TRANSFER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CITEMTAG_TRANSFER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "CREATE PROCEDURE SP_CITEMTAG_TRANSFER(@TRANDBNAME VARCHAR(10))"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @DBNAME VARCHAR(10)"
        strSql += vbCrLf + "	DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "	DECLARE @CNAMES VARCHAR(8000)"
        strSql += vbCrLf + "	DECLARE @VSQL NVARCHAR(4000)"
        strSql += vbCrLf + "	DECLARE @CNAME VARCHAR(50)"
        strSql += vbCrLf + "	SELECT @CNAMES = ''"
        strSql += vbCrLf + "	DECLARE @CNAMES1 VARCHAR(8000)"
        strSql += vbCrLf + "	DECLARE @CNAME1 VARCHAR(50)"
        strSql += vbCrLf + "	SELECT @CNAMES1 = ''"
        strSql += vbCrLf + "	DECLARE CUR CURSOR FOR SELECT DBNAME FROM " & compId & "ADMINDB..DBMASTER WHERE DBNAME<>@TRANDBNAME"
        strSql += vbCrLf + "	OPEN CUR"
        strSql += vbCrLf + "	FETCH NEXT FROM CUR INTO @DBNAME"
        strSql += vbCrLf + "	WHILE @@FETCH_STATUS<>-1"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	IF (SELECT TOP 1 1 FROM MASTER..SYSDATABASES WHERE NAME= @DBNAME)=1"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SELECT @CNAMES = ''"
        strSql += vbCrLf + "		DECLARE @COLCUR CURSOR"
        strSql += vbCrLf + "		SELECT @QRY='SELECT NAME FROM '+ @DBNAME +'..SYSCOLUMNS WHERE ID = (SELECT ID FROM '+ @DBNAME +'..SYSOBJECTS WHERE NAME = ''CITEMTAG'')'"
        strSql += vbCrLf + "		SET @VSQL = 'SET @CURSOR = CURSOR FORWARD_ONLY STATIC FOR ' + @QRY + ' OPEN @CURSOR;'"
        strSql += vbCrLf + "		EXEC SP_EXECUTESQL"
        strSql += vbCrLf + "		@VSQL"
        strSql += vbCrLf + "		,N'@CURSOR CURSOR OUTPUT'"
        strSql += vbCrLf + "		,@COLCUR OUTPUT"
        strSql += vbCrLf + "		WHILE 1 = 1"
        strSql += vbCrLf + "			BEGIN"
        strSql += vbCrLf + "			FETCH NEXT FROM @COLCUR INTO @CNAME"
        strSql += vbCrLf + "			IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "			SELECT @CNAMES = @CNAMES + @CNAME + ','"
        strSql += vbCrLf + "			END"
        strSql += vbCrLf + "		SELECT @CNAMES =  SUBSTRING(@CNAMES,1,LEN(@CNAMES)-1)"
        strSql += vbCrLf + "		CLOSE @COLCUR"
        strSql += vbCrLf + "		DEALLOCATE @COLCUR"
        strSql += vbCrLf + "	    SELECT @CNAMES1 = ''"
        strSql += vbCrLf + "		DECLARE @COLCURTAG CURSOR"
        strSql += vbCrLf + "		SELECT @QRY='SELECT NAME FROM '+ @DBNAME +'..SYSCOLUMNS WHERE ID = (SELECT ID FROM '+ @DBNAME +'..SYSOBJECTS WHERE NAME = ''CITEMTAGSTONE'')'"
        strSql += vbCrLf + "		SET @VSQL = 'SET @CURSOR = CURSOR FORWARD_ONLY STATIC FOR ' + @QRY + ' OPEN @CURSOR;'"
        strSql += vbCrLf + "		EXEC SP_EXECUTESQL"
        strSql += vbCrLf + "		@VSQL"
        strSql += vbCrLf + "		,N'@CURSOR CURSOR OUTPUT'"
        strSql += vbCrLf + "		,@COLCURTAG OUTPUT"
        strSql += vbCrLf + "		WHILE 1 = 1"
        strSql += vbCrLf + "			BEGIN"
        strSql += vbCrLf + "			FETCH NEXT FROM @COLCURTAG INTO @CNAME1"
        strSql += vbCrLf + "			IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "			SELECT @CNAMES1 = @CNAMES1 + @CNAME1 + ','"
        strSql += vbCrLf + "			END"
        strSql += vbCrLf + "		SELECT @CNAMES1 =  SUBSTRING(@CNAMES1,1,LEN(@CNAMES1)-1)"
        strSql += vbCrLf + "		CLOSE @COLCURTAG"
        strSql += vbCrLf + "		DEALLOCATE @COLCURTAG"
        strSql += vbCrLf + "		SELECT @QRY='IF(SELECT 1 FROM MASTER..SYSDATABASES WHERE NAME='''+ @DBNAME +''')>0'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+' BEGIN'"
        strSql += vbCrLf + "		SELECT @QRY =@QRY+' INSERT INTO " & compId & "ADMINDB..CITEMTAG (' + @CNAMES + ') SELECT ' + @CNAMES + ' FROM ' + @DBNAME + '..ITEMTAG WHERE ISNULL(ISSDATE,'''')<>'''' '"
        strSql += vbCrLf + "		SELECT @QRY =@QRY+' INSERT INTO " & compId & "ADMINDB..CITEMTAGSTONE (' + @CNAMES1 + ') SELECT ' + @CNAMES1 + ' FROM ' + @DBNAME + '..ITEMTAGSTONE WHERE TAGSNO IN(SELECT SNO FROM ' + @DBNAME + '..ITEMTAG WHERE ISNULL(ISSDATE,'''')<>'''')'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+' END'"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "		FETCH NEXT FROM CUR INTO @DBNAME"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	CLOSE CUR"
        strSql += vbCrLf + "	DEALLOCATE CUR"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
