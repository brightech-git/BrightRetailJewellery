        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' GROUP BY METALID'"
        strSql += vbCrLf + "  PRINT @QUERY"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY "

        strSql += vbCrLf + "  SET @QUERY=' INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(METALID,PARTICULARS,R_PCS,R_GRSWT,R_NETWT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT METALID,''ISSUE SALES'',SUM(PCS),SUM(GRSWT),SUM(NETWT),''3'' FROM '+@DBNAME+'..ISSUE  '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+ ' WHERE TRANTYPE=''MI'' AND  BATCHNO NOT IN ('+@HOMEFILTER+') AND CASHID='''+ @BILLCOUNTID +''''"
