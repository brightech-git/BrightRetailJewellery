        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' FROM '+@ADMINDB+'..ACHEAD WHERE 1<>1 '"
        strSql += vbCrLf + "  IF @DATEFILTER = 'S'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) + ' AND CRDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
