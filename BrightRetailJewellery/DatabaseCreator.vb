        strSql += vbCrLf + "  		END'   "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)    "
        strSql += vbCrLf + "  		PRINT'/******************** AdvanceReceived ******************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVRECEIVED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVRECEIVED "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,O.TRANNO) AS TRANNO      "
