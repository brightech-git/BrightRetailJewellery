        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' ,SUM(CASE WHEN RECPAY = ''P'' THEN (ISNULL(AMOUNT,0)+ISNULL(GSTVAL,0)) ELSE -1*(ISNULL(AMOUNT,0)+ISNULL(GSTVAL,0)) END) AS BALANCE'  "
        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' ,(P.INITIAL+'' ''+P.PNAME) NAME,P.MOBILE,CONVERT(NUMERIC,NULL) AMOUNT'  "
