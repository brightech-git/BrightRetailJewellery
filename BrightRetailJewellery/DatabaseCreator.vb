        strSql += vbCrLf + " ) AS X     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SELECT LPARTICULAR,LCLSWT,LCOLHEAD,LRESULT,RPARTICULAR,RCLSWT,RCOLHEAD,RRESULT  FROM MASTER..TEMP_RESULT_SHOW    "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_RPT_DISCOUNT()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_DISCOUNT')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_DISCOUNT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'PROC_DISCOUNT')>0"
        strSql += vbCrLf + "  DROP PROCEDURE PROC_DISCOUNT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE PROC_DISCOUNT"
        strSql += vbCrLf + "  	  		   ("
        strSql += vbCrLf + "  	  		    @ADMINDB VARCHAR(15),"
        strSql += vbCrLf + "  	  		    @DBNAME VARCHAR(15),"
        strSql += vbCrLf + "  	  		    @FROMDATE VARCHAR(30),"
