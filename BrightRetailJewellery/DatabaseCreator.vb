        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,''S'',5,CATNAME FROM TEMPTABLEDB..TEMPSASRPU WHERE ISNULL(COLHEAD,'''')='''' GROUP BY CATNAME'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     INSERT INTO TEMPTABLEDB..TEMPSASRPU(TRANDATE,G_GRSWT,G_LESSWT,G_NETWT,S_GRSWT,S_LESSWT,S_NETWT,P_GRSWT,P_LESSWT,P_NETWT,STNAMT,SALESAMOUNT,SALESNETAMT'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,DISCOUNT,IGST,CGST,SGST,VAT,OGWT,OGLESSWT,OGNETWT,OGAMT,OGDISC,SRWT,SRLESSWT,SRNETWT,SRAMT,SRIGST,SRCGST,SRSGST'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SRVAT,SRDISC,SRNETAMT,ADVANCE,ADVANCEADJ,NETAMT,CASH,CARD,CHEQUE,BALANCE,COLHEAD,RESULT,CATNAME)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     SELECT ''GRAND TOTAL'',SUM(G_GRSWT),SUM(G_LESSWT),SUM(G_NETWT),SUM(S_GRSWT),SUM(S_LESSWT),SUM(S_NETWT)'	"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(P_GRSWT),SUM(P_LESSWT),SUM(P_NETWT)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(STNAMT),SUM(SALESAMOUNT),SUM(SALESNETAMT)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(DISCOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(VAT),SUM(OGWT),SUM(OGLESSWT),SUM(OGNETWT),SUM(OGAMT),SUM(OGDISC)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(SRWT),SUM(SRLESSWT),SUM(SRNETWT),SUM(SRAMT),SUM(SRIGST),SUM(SRCGST),SUM(SRSGST),SUM(SRVAT)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(SRDISC),SUM(SRNETAMT),SUM(ADVANCE),SUM(ADVANCEADJ),SUM(NETAMT)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,SUM(CASH),SUM(CARD),SUM(CHEQUE),SUM(BALANCE)'"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'     ,''G'',6,''ZZZZZZZZZ'' FROM TEMPTABLEDB..TEMPSASRPU WHERE ISNULL(COLHEAD,'''')=''''  '"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+'END'"
        strSql += vbCrLf + "  		PRINT(@QRY)"
        strSql += vbCrLf + "  		EXEC(@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY=CHAR(13)+'SELECT *,IDENTITY(INT,0,1)KEYNO INTO TEMPTABLEDB..TEMPSASRPU1 FROM TEMPTABLEDB..TEMPSASRPU ORDER BY  CATNAME,RESULT,TRANNO'"
        strSql += vbCrLf + "  		EXEC(@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY=CHAR(13)+'ALTER TABLE TEMPTABLEDB..TEMPSASRPU1 DROP COLUMN KEYNO'"
        strSql += vbCrLf + "  		EXEC(@QRY)"
        strSql += vbCrLf + "  	END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub RPT_ITEMWISE_EXCISE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ITEMWISESALES_EXCISE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ITEMWISESALES_EXCISE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_ITEMWISESALES_EXCISE"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FROMDATE VARCHAR(20)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(20)"
        strSql += vbCrLf + " ,@RECDATE VARCHAR(20)"
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + " ,@COSTID VARCHAR(5000)"
        strSql += vbCrLf + " ,@METALID VARCHAR(5000)"
        strSql += vbCrLf + " ,@ITEMID VARCHAR(8000)"
        strSql += vbCrLf + " ,@SUBITEMID VARCHAR(8000)"
        strSql += vbCrLf + " ,@COUNTERID VARCHAR(8000)"
        strSql += vbCrLf + " ,@GROUPBY VARCHAR(5)"
        strSql += vbCrLf + " ,@ORDERBYNAME VARCHAR(1) /** Y OR N **/"
        strSql += vbCrLf + " ,@RPTTYPE VARCHAR(1) /** (D)etailed/(S)ummary **/ "
        strSql += vbCrLf + " ,@TRANTYPE VARCHAR(50) /** SA,MI **/"
        strSql += vbCrLf + " ,@EXCISETYPE VARCHAR(50) /** T,M,A **/"
        strSql += vbCrLf + " ,@WITHPURDET VARCHAR(1) /** Y OR N **/"
        strSql += vbCrLf + " ,@DESIGNER VARCHAR(100) /** DESIGNERNAME **/ "
        strSql += vbCrLf + " ,@SYSTEMID VARCHAR(1000)"
        strSql += vbCrLf + " ,@DBNAME VARCHAR(20) "
        strSql += vbCrLf + " ,@SYSID VARCHAR(3)"
        strSql += vbCrLf + " ,@GRAND VARCHAR(1)"
        strSql += vbCrLf + " ,@BILLFROM VARCHAR(10)"
        strSql += vbCrLf + " ,@BILLTO VARCHAR(10) "
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	SET NOCOUNT ON"
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 	DECLARE @QRY2 VARCHAR(8000)"
        strSql += vbCrLf + " 	DECLARE @COSTFILTER VARCHAR(4000)"
        strSql += vbCrLf + " 	SET @COSTFILTER=''"
        strSql += vbCrLf + " 	IF @COSTID<>'ALL' SELECT @COSTFILTER=' AND I.COSTID IN('+ @COSTID +')'"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANYID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'METALMAST',@CHK_FEILD = 'METALID',@RESULT_TBL = 'TEMPMETAL',@INPUTVALUES = @METALID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEM',@INPUTVALUES = @ITEMID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'SUBITEMMAST',@CHK_FEILD = 'SUBITEMID',@RESULT_TBL = 'TEMPSUBITEM',@INPUTVALUES = @SUBITEMID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMCOUNTER',@CHK_FEILD = 'ITEMCTRID',@RESULT_TBL = 'TEMPCOUNTER',@INPUTVALUES = @COUNTERID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPTRANTYPE',@INPUTVALUES = @TRANTYPE"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES  @CHK_DB = '" & cnAdminDb & "', @CHK_TBL = 'DESIGNER', @CHK_FEILD = 'DESIGNERID',@RESULT_TBL = 'TEMPDESIGNER',@INPUTVALUES = @DESIGNER"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#SYSTEM', 'U') IS NOT NULL DROP TABLE #SYSTEM   	"
        strSql += vbCrLf + " 	CREATE TABLE #SYSTEM (SYSTEMID VARCHAR(5))"
        strSql += vbCrLf + " 	DECLARE @TSYSTEMID VARCHAR(5)"
        strSql += vbCrLf + " 	IF CHARINDEX(',',@SYSTEMID)=0"
        strSql += vbCrLf + " 	BEGIN    "
        strSql += vbCrLf + "  		IF @SYSTEMID = 'EMPTY'    "
        strSql += vbCrLf + "  		SET @SYSTEMID = ''      "
        strSql += vbCrLf + "  		INSERT INTO #SYSTEM (SYSTEMID) SELECT @SYSTEMID     "
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	WHILE CHARINDEX(',',@SYSTEMID)>0 "
        strSql += vbCrLf + " 	BEGIN "
        strSql += vbCrLf + "  		SET @TSYSTEMID=LEFT(@SYSTEMID,CHARINDEX(',',@SYSTEMID)-1)     "
        strSql += vbCrLf + "  		SET @SYSTEMID=RIGHT(@SYSTEMID,LEN(@SYSTEMID)-CHARINDEX(',',@SYSTEMID)) "
        strSql += vbCrLf + "  		IF @SYSTEMID <>'' AND CHARINDEX(',',@SYSTEMID)=0 "
        strSql += vbCrLf + "  		SET @SYSTEMID= @SYSTEMID + ',' "
        strSql += vbCrLf + "  		IF @TSYSTEMID = 'EMPTY'    "
        strSql += vbCrLf + "  		SET @TSYSTEMID = ''    "
        strSql += vbCrLf + "  		INSERT INTO #SYSTEM (SYSTEMID) SELECT @TSYSTEMID "
        strSql += vbCrLf + " 	END   "
        strSql += vbCrLf + " 	SELECT @QRY= '  IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPTALLY'+@SYSID+''') DROP TABLE TEMPTABLEDB..TEMPTALLY'+@SYSID+''  "
        strSql += vbCrLf + " 	EXEC(@QRY)  "
        strSql += vbCrLf + " 	SELECT @QRY= '  IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPITEMSALES1'') DROP TABLE TEMPTABLEDB..TEMPITEMSALES1'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  SELECT * INTO TEMPTABLEDB..TEMPITEMSALES1 FROM ( '    "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  SELECT '                      	"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  CONVERT(VARCHAR(400),CASE WHEN SM.SUBITEMNAME IS NOT NULL THEN SM.SUBITEMNAME ELSE IM.ITEMNAME END) AS PARTICULAR '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,I.TRANNO,I.TRANDATE,I.TAGNO,T.RECDATE' 	"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,I.PCS,I.GRSWT,I.LESSWT '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,(SELECT SUM(STNWT) FROM '+ @DBNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (sELECT ITEMID FROM  ITEMMAST WHERE DIASTONE = ''D'')) AS DIAWT '        "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,(SELECT SUM(STNWT) FROM '+ @DBNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (sELECT ITEMID FROM  ITEMMAST WHERE DIASTONE = ''S'') AND STONEUNIT=''G'') AS STN_GRM '        "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,(SELECT SUM(STNWT) FROM '+ @DBNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (sELECT ITEMID FROM  ITEMMAST WHERE DIASTONE = ''S'') AND STONEUNIT=''C'') AS STN_CARAT ' "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,(SELECT SUM(STNWT) FROM '+ @DBNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (sELECT ITEMID FROM  ITEMMAST WHERE DIASTONE = ''D'') AND STONEUNIT=''G'') AS DIA_GRM ' "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,(SELECT SUM(STNWT) FROM '+ @DBNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (sELECT ITEMID FROM  ITEMMAST WHERE DIASTONE = ''D'') AND STONEUNIT=''C'') AS DIA_CARAT ' "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,I.NETWT,I.TAGGRSWT,CASE WHEN IM.STOCKTYPE = ''T'' AND T.TAGNO <> '''' THEN I.TAGGRSWT-I.GRSWT ELSE 0 END AS DIFFWT '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,I.RATE,I.WASTAGE'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN I.TRANTYPE=''MI'' THEN 0 ELSE I.MCHARGE END MCHARGE'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN I.TRANTYPE=''MI'' THEN 0 ELSE I.STNAMT END STNAMT'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN I.TRANTYPE=''MI'' THEN 0 ELSE I.AMOUNT END AMOUNT'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN I.FLAG = ''B'' THEN ''BACK OFF'' WHEN I.FLAG = ''C'' THEN ''COUNTER'' END AS SALETYPE'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN I.SYSTEMID='''' THEN ''NO NODE-ID'' ELSE I.SYSTEMID END SYSTEMID '      "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,I.TRANTYPE TYPE ,CONVERT(VARCHAR(100),ISNULL(IT.NAME,'''')) AS ITEMTYPE,CONVERT(VARCHAR(100),IM.ITEMNAME)AS ITEMNAME '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN ISNULL(CO.ITEMCTRNAME,'''')='''' THEN ''NO COUNTER'' ELSE CONVERT(vARCHAR(100),CO.ITEMCTRNAME) END AS COUNTER '"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN ISNULL(DE.DESIGNERNAME,'''')='''' THEN ''NO DESIGNER'' ELSE CONVERT(VARCHAR(100),DE.DESIGNERNAME) END AS DESIGNER '   	"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CONVERT(VARCHAR(200),NULL)GROUP1 ,CONVERT(VARCHAR(200),NULL)GROUP2 '      "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,SM.SUBITEMNAME ,CASE WHEN IM.STOCKTYPE = ''T'' THEN (SELECT TOP 1 PURVALUE FROM PURITEMTAG WHERE TAGNO = I.TAGNO '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND ITEMID = I.ITEMID AND TAGSNO = T.SNO ORDER BY RECDATE DESC) WHEN IM.STOCKTYPE = ''P'' THEN (SELECT TOP 1 PURRATE FROM ITEMNONTAG WHERE PACKETNO = I.TAGNO '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND RECISS = ''R'' AND PURRATE <> 0) * CASE WHEN IM.CALTYPE = ''R'' THEN I.PCS ELSE 1 END ELSE 0 END AS PURVALUE '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CASE WHEN IM.STOCKTYPE = ''T'' THEN T.STYLENO ELSE NULL END AS STYLENO '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  ,CONVERT(VARCHAR,(SELECT EMPNAME FROM  EMPMASTER WHERE EMPID = I.EMPID))AS EMPNAME,SUBSTRING(CONVERT(VARCHAR(25),I.UPTIME),13,7)TIME    '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  FROM '+ @DBNAME +'..ISSUE AS I '  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  INNER JOIN  ITEMMAST IM ON IM.ITEMID = I.ITEMID '                   	"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  ITEMGROUPMAST AS IG ON IG.GROUPID = IM.ITEMGROUP'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  SUBITEMMAST AS SM ON SM.ITEMID = I.ITEMID AND SM.SUBITEMID = I.SUBITEMID '      "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  ITEMCOUNTER AS CO ON CO.ITEMCTRID = I.ITEMCTRID '      "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  DESIGNER AS DE ON DE.DESIGNERID = I.TAGDESIGNER '     "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  ITEMTAG AS T ON T.TAGNO = I.TAGNO AND T.ITEMID = I.ITEMID AND T.BATCHNO = I.BATCHNO '    "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  ITEMTYPE AS IT ON ISNULL(IT.ITEMTYPEID,0)=ISNULL(I.ITEMTYPEID,0)'   "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  LEFT OUTER JOIN  ITEMGROUPMAST AS CG ON CG.GROUPID = CO.CTRGROUP'"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  WHERE I.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''' '"
        strSql += vbCrLf + " 	IF @EXCISETYPE='T' "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY+CHAR(13)+'  AND I.TAGNO IN(SELECT TAGNO FROM  ITEMTAG WHERE ISNULL(STKTYPE,'''')<>''M'' AND TAGNO=I.TAGNO AND ITEMID=I.ITEMID AND BATCHNO=I.BATCHNO AND RECDATE >= '''+ @RECDATE  +''' ) '"
        strSql += vbCrLf + " 	IF @EXCISETYPE='M' "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY+CHAR(13)+'  AND I.TAGNO IN(SELECT TAGNO FROM  ITEMTAG WHERE ISNULL(STKTYPE,'''')=''M'' AND TAGNO=I.TAGNO AND ITEMID=I.ITEMID AND BATCHNO=I.BATCHNO AND RECDATE >= '''+ @RECDATE  +''' ) '"
        strSql += vbCrLf + " 	IF @EXCISETYPE='A' "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY+CHAR(13)+'  AND I.TAGNO IN(SELECT TAGNO FROM  ITEMTAG WHERE TAGNO=I.TAGNO AND ITEMID=I.ITEMID AND BATCHNO=I.BATCHNO AND RECDATE >= '''+ @RECDATE  +''' ) '"
        strSql += vbCrLf + " 	IF @BILLFROM<>'0' AND @BILLTO<>'0'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  AND TRANNO BETWEEN '+@BILLFROM+' AND '+@BILLTO+''"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND I.TRANTYPE IN (SELECT COMPANYID FROM TEMPTRANTYPE)'+ @COSTFILTER"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPCOMPANY) AND I.ITEMID IN (SELECT COMPANYID FROM TEMPITEM)'       "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND I.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEM) '"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND I.CATCODE IN (SELECT CATCODE FROM  CATEGORY WHERE METALID IN (SELECT COMPANYID FROM TEMPMETAL))'       "
        strSql += vbCrLf + " 	IF @COUNTERID<>'0'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  AND ISNULL(I.ITEMCTRID,0) IN (SELECT COMPANYID FROM TEMPCOUNTER) '"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND ISNULL(I.CANCEL,'''') = '''' ' "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  AND ISNULL(I.TAGDESIGNER,0) IN (SELECT COMPANYID FROM TEMPDESIGNER) AND ISNULL(I.SYSTEMID,'''') IN (SELECT SYSTEMID FROM #SYSTEM) '"
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  )X '"
        strSql += vbCrLf + " 	PRINT @QRY  "

        strSql += vbCrLf + " 	EXEC(@QRY )"

        strSql += vbCrLf + " 	IF @GROUPBY = 'I' or   @GROUPBY = 'ITS'/** ITEMWISE GROUP**/      "
        strSql += vbCrLf + " 	BEGIN       "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPITEMSALES1 SET GROUP1 = ITEMNAME      "
        strSql += vbCrLf + "  		IF @RPTTYPE = 'S' "
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			UPDATE TEMPTABLEDB..TEMPITEMSALES1 SET PARTICULAR = GROUP1,TRANNO = NULL,TRANDATE = NULL,TAGNO = NULL,SYSTEMID=NULL      "
        strSql += vbCrLf + "  			,RATE = NULL,SALETYPE = NULL,COUNTER = NULL,DESIGNER = NULL,PURVALUE = NULL,STYLENO = NULL,TYPE = NULL  ,EMPNAME = NULL,TIME = NULL"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + " 	END   "

        strSql += vbCrLf + " 	ELSE IF @GROUPBY = 'DI'/** DESIGNER WISE GROUP **/      "
        strSql += vbCrLf + " 	BEGIN       "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPITEMSALES1 SET GROUP1 = DESIGNER,GROUP2 = ITEMNAME    "
        strSql += vbCrLf + "  		IF @RPTTYPE = 'S' UPDATE TEMPTABLEDB..TEMPITEMSALES1 SET PARTICULAR = GROUP1,TRANNO = NULL,TRANDATE = NULL,TAGNO = NULL,RATE = NULL,SALETYPE = NULL,COUNTER = NULL,SUBITEMNAME = NULL,PURVALUE = NULL,STYLENO = NULL,TYPE = NULL  ,EMPNAME = NULL,TIME = NULL"
        strSql += vbCrLf + " 	END   "

        strSql += vbCrLf + " 	IF @GROUPBY = 'DI' AND @RPTTYPE = 'D'    "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPITEMSALES1 SET PARTICULAR = CASE WHEN ISNULL(SUBITEMNAME,'') <> '' THEN SUBITEMNAME ELSE ITEMNAME END,GROUP2 = ITEMNAME                     	"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..ITEMSALESRES') IS NOT NULL DROP TABLE TEMPTABLEDB..ITEMSALESRES"
        strSql += vbCrLf + "  		PRINT 4"
        strSql += vbCrLf + "  		SELECT @QRY='  SELECT PARTICULAR,TRANNO,TRANDATE,SUBITEMNAME,DESIGNER,TAGNO,RECDATE '   "
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(LESSWT)LESSWT,SUM(DIAWT)DIAWT,SUM(STN_GRM)STN_GRM,SUM(STN_CARAT)STN_CARAT,SUM(DIA_GRM)DIA_GRM,SUM(DIA_CARAT)DIA_CARAT,SUM(NETWT)NETWT,SUM(TAGGRSWT)TAGGRSWT,SUM(DIFFWT)DIFFWT'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,(SUM(ISNULL(WASTAGE,0))/CASE WHEN SUM(NETWT)=0 THEN 1 ELSE SUM(NETWT) END)*100 WASTPER'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,SUM(ISNULL(WASTAGE,0))WASTAGE'"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,SUM(MCHARGE)MCHARGE,SUM(STNAMT)STNAMT,SUM(AMOUNT)AMOUNT '  "
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,PURVALUE,STYLENO,EMPNAME,RATE,SALETYPE,SYSTEMID,TYPE,ITEMTYPE,ITEMNAME,COUNTER,GROUP1,GROUP2 '  "
        strSql += vbCrLf + "  		SELECT @QRY= @QRY+CHAR(13)+'  ,CONVERT(INT,1)ORDG1,CONVERT(INT,1)ORDG2,CONVERT(VARCHAR(3),NULL)COLHEAD,TIME '  "
