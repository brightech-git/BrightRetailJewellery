        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SET @COSTFILTER=''"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	IF @ACCODE='ALL'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SET @ACCODEFILTER=' AND ACCODE IN(SELECT ACCODE FROM ACHEAD WHERE ISNULL(LEDPRINT,'''') <> ''N'' AND ISNULL(ACTIVE,''Y'') <> ''H'' AND ACTYPE IN (''G'',''D'',''I''))'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN"
