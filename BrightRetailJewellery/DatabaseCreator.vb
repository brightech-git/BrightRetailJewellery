    Private Sub funcSp33GetEstBAtchno()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='GET_ESTBATCHNO')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE GET_ESTBATCHNO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE GET_ESTBATCHNO"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  @COSTID VARCHAR(2)"
        strSql += vbCrLf + "  ,@BILLDATE SMALLDATETIME"
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + "  ,@RETVALUE VARCHAR(50) OUTPUT"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN /**PROC **/"
        strSql += vbCrLf + "  DECLARE @BATCHNO AS VARCHAR(15)"
        strSql += vbCrLf + "  SET NOCOUNT ON"
        strSql += vbCrLf + "  select @BATCHNO = ' '"
        strSql += vbCrLf + "  DECLARE @TBATCHNO AS INT"
        strSql += vbCrLf + "  WHILE 1=1"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  	WHILE 1=1"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		SELECT @TBATCHNO = ISNULL(CONVERT(INT,CTLVALUE),0) FROM " & compId & "ADMINDB..SNOCREATOR WHERE CTLID = 'BATCHNO' AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + "  		UPDATE " & compId & "ADMINDB..SNOCREATOR SET CTLVALUE = @TBATCHNO+1 WHERE CTLID = 'BATCHNO' AND CTLVALUE = @TBATCHNO AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + "  		IF (SELECT @@ROWCOUNT) > 0 BREAK"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	SET @BATCHNO = REPLICATE('0',2-LEN(@COSTID))+ @COSTID + REPLICATE('0',3-LEN(@COMPANYID))+ @COMPANYID + '" & Mid(tranDbName, 7, 2) & "' + CONVERT(VARCHAR,(@TBATCHNO+1))"
        strSql += vbCrLf + "  	DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  	DECLARE @TNAME VARCHAR(100)"
        strSql += vbCrLf + "  	DECLARE @TRANDB VARCHAR(10)"
        strSql += vbCrLf + "  	SELECT @TRANDB = '" & tranDbName & "'"
        strSql += vbCrLf + "  	SELECT @QRY = ''"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPDB..#CHECKBATCH', 'U') IS NOT NULL DROP TABLE #CHECKBATCH"
        strSql += vbCrLf + "  	CREATE TABLE #CHECKBATCH(BATCHNO VARCHAR(15))"
        strSql += vbCrLf + "  	DECLARE CUR CURSOR"
        strSql += vbCrLf + "  	FOR SELECT T.NAME NAME FROM  " & tranDbName & "..SYSCOLUMNS AS C INNER JOIN "
        strSql += vbCrLf + "  	" & tranDbName & "..SYSOBJECTS AS T ON C.ID = T.ID"
        strSql += vbCrLf + "  	WHERE C.NAME = 'ESTBATCHNO' AND T.NAME LIKE 'EST%' "
        strSql += vbCrLf + "  	OPEN CUR"
        strSql += vbCrLf + "  	WHILE 1 = 1"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		FETCH NEXT FROM CUR INTO @TNAME"
        strSql += vbCrLf + "  		SET NOCOUNT ON"
        strSql += vbCrLf + "  		IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "  	 	SELECT @QRY = ' INSERT INTO #CHECKBATCH(BATCHNO) SELECT DISTINCT ESTBATCHNO FROM '+@TRANDB+'..'+ @TNAME + ' WHERE CONVERT(VARCHAR,ESTBATCHNO) = ''' + @BATCHNO + ''' /**/'"
        strSql += vbCrLf + "  		EXEC SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	CLOSE CUR"
        strSql += vbCrLf + "  	DEALLOCATE CUR"

        strSql += vbCrLf + "  	IF NOT (SELECT COUNT(*) FROM #CHECKBATCH)>0 BREAK"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  SELECT @RETVALUE = @BATCHNO"
        strSql += vbCrLf + "  END/** PROC **/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub



