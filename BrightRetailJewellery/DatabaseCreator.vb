    Function funcCreateTransactionDb() As Integer
        If DbChecker(tranDbName) = 0 Then
            ''Create db
            STATUS = "Create Database " + tranDbName
            funcProgressStep()
            CreateDb(tranDbName)
            funcProgressStep(1)
        Else
            ''Create Dup db
            STATUS = "Create Database " + tranDbName
            funcProgressStep()
            CreateDuplicateDb(tranDbName)
            funcProgressStep(1)
        End If
    End Function

    Function funcCreateTransactionDbTables(Optional ByVal udbname As String = Nothing) As Integer
        Dim dtDupCheck As New DataTable
        If udbname Is Nothing Then
            STATUS = " Creating " & tranDbName & " Tables"
            funcProgressStep()
            strSql = " SELECT 1 FROM " & tranDbName & "..SYSOBJECTS WHERE NAME = 'ISSUE'"
            cmd = New OleDbCommand(strSql, cn, tran)
            da = New OleDbDataAdapter(cmd)
            da.Fill(dtDupCheck)
            If Not dtDupCheck.Rows.Count > 0 Then
                ''Create db
                TrandbCreateTable(tranDbName)
                'TranDbInsertValues(tranDbName)
            Else
                ''Create Dup db
                TrandbCreateTable("Duplicate" + tranDbName)
                TraceDb(tranDbName, "Duplicate" + tranDbName)
                'TranDbInsertValues("Duplicate" + tranDbName)
            End If
        Else
            STATUS = " Creating " & udbname & " Tables"
            funcProgressStep()
            strSql = " SELECT 1 FROM " & udbname & "..SYSOBJECTS WHERE NAME = 'ISSUE'"
            cmd = New OleDbCommand(strSql, cn, tran)
            da = New OleDbDataAdapter(cmd)
            da.Fill(dtDupCheck)
            If Not dtDupCheck.Rows.Count > 0 Then
                TrandbCreateTable(udbname)
            Else
                TrandbCreateTable("Duplicate" + udbname)
                TraceDb(udbname, "Duplicate" + udbname)
            End If
        End If

    End Function

