        strSql += vbCrLf + " 	DECLARE @ITM AS VARCHAR(50)=''"
        strSql += vbCrLf + " 	DECLARE @SUB AS VARCHAR(50)=''"
        strSql += vbCrLf + " 	DECLARE @ACC AS VARCHAR(50)=''"
        strSql += vbCrLf + " 	DECLARE @CNTAK AS INT=0"

        strSql += vbCrLf + " 	DECLARE @CNG_MC VARCHAR(50)='SAME'"
        strSql += vbCrLf + " 	DECLARE @CNG_WS VARCHAR(50)='SAME'"
        strSql += vbCrLf + " 	DECLARE @CNG_PU VARCHAR(50)='SAME'"
