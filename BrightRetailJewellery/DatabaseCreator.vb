        'strSql += vbCrLf + " 		SELECT TRANDATE,'S'COLHEAD,22 RESULT,'CHR(12)' FROM TEMPTABLEDB..TEMPDAYBOOK GROUP BY TRANDATE "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	IF @OPENING = 'Y' UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103) WHERE RESULT = 1 "
        'strSql += vbCrLf + " 	ELSE UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103) "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK T WHERE RESULT = 1 "
        'strSql += vbCrLf + " 	/*AND SNO IN (SELECT TOP 1 SNO FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = T.TRANDATE AND RESULT = 2 ORDER BY PARTICULAR)*/"
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET DEBIT = NULL WHERE ISNULL(DEBIT,0) = 0 "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET CREDIT = NULL WHERE ISNULL(CREDIT,0) = 0 "
        'strSql += vbCrLf + " 	/** UPDATING WEIGHT INFORMATION **/ "
        'strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPWEIGHTINFO')>0 DROP TABLE TEMPTABLEDB..TEMPWEIGHTINFO "
        'strSql += vbCrLf + " 	SELECT "
        'strSql += vbCrLf + " 	'PCS=' + CONVERT(VARCHAR,PCS)+' GRSWT=' + CONVERT(VARCHAR,GRSWT)+' NETWT=' + CONVERT(VARCHAR,NETWT)AS WEIGHTINFO "
        'strSql += vbCrLf + " 	,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER "
        'strSql += vbCrLf + " 	INTO TEMPTABLEDB..TEMPWEIGHTINFO FROM ISSUE I "
        'strSql += vbCrLf + " 	WHERE EXISTS (SELECT 1 FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER)"
        'strSql += vbCrLf + " 	UNION ALL "
        'strSql += vbCrLf + " 	SELECT 'PCS=' + CONVERT(VARCHAR,PCS)+' GRSWT=' + CONVERT(VARCHAR,GRSWT)+' NETWT=' + CONVERT(VARCHAR,NETWT) AS WEIGHTINFO "
        'strSql += vbCrLf + " 	,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER FROM RECEIPT I "
        'strSql += vbCrLf + " 	WHERE EXISTS (SELECT 1 FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER) "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET PARTICULAR = PARTICULAR + CHAR(13) + W.WEIGHTINFO "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK AS B,TEMPTABLEDB..TEMPWEIGHTINFO AS W "
        'strSql += vbCrLf + " 	WHERE B.TRANDATE = W.TRANDATE AND B.BATCHNO = W.BATCHNO AND B.ENTRYORDER = W.ENTRYORDER "
        'strSql += vbCrLf + " 	/*ALTER TABLE TEMPTABLEDB..TEMPDAYBOOK ADD TEMP NUMERIC(15,2)"
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TMP = CREDIT "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET CREDIT = DEBIT "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET DEBIT = TMP*/"
        'strSql += vbCrLf + " 	IF @SUMMARY='Y'"
        'strSql += vbCrLf + " 	BEGIN"
        'strSql += vbCrLf + " 		IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK1')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK1 "
        'strSql += vbCrLf + " 		SELECT * INTO TEMPTABLEDB..TEMPDAYBOOK1 FROM TEMPTABLEDB..TEMPDAYBOOK"
        'strSql += vbCrLf + " 		DELETE FROM TEMPTABLEDB..TEMPDAYBOOK WHERE RESULT=2"
        'strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPDAYBOOK (TRANNO,PAYMODE,PARTICULAR,DEBIT,CREDIT,TRANDATE,RESULT )"
        'strSql += vbCrLf + " 		SELECT TRANNO,PAYMODE,PARTICULAR"
        'strSql += vbCrLf + " 		,CASE WHEN SUM(ISNULL(DEBIT,0))=0 THEN NULL ELSE SUM(ISNULL(DEBIT,0)) END"
        'strSql += vbCrLf + " 		,CASE WHEN SUM(ISNULL(CREDIT,0))=0 THEN NULL ELSE SUM(ISNULL(CREDIT,0)) END"
        'strSql += vbCrLf + " 		,TRANDATE,RESULT FROM TEMPTABLEDB..TEMPDAYBOOK1 WHERE RESULT=2 "
        'strSql += vbCrLf + " 		GROUP BY TRANNO,PAYMODE,PARTICULAR,TRANDATE,RESULT"
        'strSql += vbCrLf + " 	END  "
        'strSql += vbCrLf + " 	IF @ORDERBY='G'"
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + "		UPDATE A SET A.CREDIT=CASE WHEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0))>0 THEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0)) ELSE null END "
        'strSql += vbCrLf + "		,A.DEBIT=CASE WHEN (ISNULL(A.DEBIT,0)-ISNULL(CREDIT,0))>0 THEN (ISNULL(A.DEBIT,0)-ISNULL(A.CREDIT,0))  ELSE null END "
        'strSql += vbCrLf + "		FROM TEMPTABLEDB..TEMPDAYBOOK  A WHERE A.PAYMODE IN('JE','CP','CR') AND ISNULL(A.COLHEAD,'') NOT IN('T','S') "
        'strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TEMPDAYBOOK SET RESULT=(CASE WHEN PAYMODE='SA' THEN 2 WHEN PAYMODE='SV' THEN 3  "
        'strSql += vbCrLf + "		WHEN PAYMODE='PU' THEN 4 WHEN PAYMODE='PV' THEN 5  WHEN PAYMODE='SR' THEN 6 WHEN PAYMODE='RV' THEN 7 "
        'strSql += vbCrLf + "		WHEN PAYMODE IN('AA','AR','AP') THEN 8 WHEN PAYMODE in('SS','CB','CD') THEN 9 WHEN PAYMODE in('CC') THEN 10 WHEN PAYMODE in('CH') THEN 11 "
        'strSql += vbCrLf + "		ELSE 12 END) WHERE RESULT=2 AND ISNULL(COLHEAD,'')=''"
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMPDAYBOOK ORDER BY TRANDATE,TDATE DESC ,RESULT,TRANNO,PARTICULAR"
        'strSql += vbCrLf + " END "
        'cmd = New OleDbCommand(strSql, cn, tran)
        'cmd.ExecuteNonQuery()

        'strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAYBOOK')>0"
        'strsql += vbcrlf + " DROP PROCEDURE SP_DAYBOOK"
        'cmd = New OleDbCommand(strSql, cn, tran)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + " CREATE PROCEDURE [dbo].[SP_DAYBOOK]"
        'strSql += vbCrLf + " (  "
        'strSql += vbCrLf + " @FRMDATE VARCHAR(12) "
        'strSql += vbCrLf + " ,@TODATE VARCHAR(12) "
        'strSql += vbCrLf + " ,@OPENING VARCHAR(1) "
        'strSql += vbCrLf + " ,@PAGEBREAK VARCHAR(1) "
        'strSql += vbCrLf + " ,@COMPANYID VARCHAR(3) "
        'strSql += vbCrLf + " ,@COSTID VARCHAR(300)           "
        'strSql += vbCrLf + " ,@DETAILED VARCHAR(1)"
        'strSql += vbCrLf + " ,@SUMMARY VARCHAR(1) "
        'strSql += vbCrLf + " ,@ORDERBY VARCHAR(1)    "
        'strSql += vbCrLf + " ,@USERID VARCHAR(800) "
        'strSql += vbCrLf + " ) "
        'strSql += vbCrLf + " AS  "
        'strSql += vbCrLf + " BEGIN /* sp_daybook begin starts */ "
        'strSql += vbCrLf + " 	/*  Intitial Authors : Ramesh      */ "
        'strSql += vbCrLf + " 	/*  Create   Date    : 12/Mar/2010      */ "
        'strSql += vbCrLf + " 	/*  Purpose          : For DayBook      */ "
        'strSql += vbCrLf + " 	/*  Refred Tables    : */ "
        'strSql += vbCrLf + " 	/*  Refred Forms/Dll : */ "
        'strSql += vbCrLf + " 	/*   Created/Modified            Modified                 Description       */ "
        'strSql += vbCrLf + " 	/* ****************************************************************************************** */ "
        'strSql += vbCrLf + " 	/** "
        'strSql += vbCrLf + " 	RESULT = 1 OPENING CASH "
        'strSql += vbCrLf + " 	RESULT = 2 TRANSATION "
        'strSql += vbCrLf + " 	RESULT = 3 TOTAL "
        'strSql += vbCrLf + " 	RESULT = 4 CLOSING "
        'strSql += vbCrLf + " 	RESULT = 5 PAGEBREAK "
        'strSql += vbCrLf + " 	**/ "
        'strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE           "
        'strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#NONPOSBATCHNO', 'U') IS NOT NULL DROP TABLE #NONPOSBATCHNO "
        'strSql += vbCrLf + " 	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3)) "
        'strSql += vbCrLf + " 	DECLARE @TEMPID VARCHAR(5) "
        'strSql += vbCrLf + " 	IF CHARINDEX(',',@COSTID)=0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	INSERT INTO #COSTCENTRE (COSTID) SELECT @COSTID "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	WHILE CHARINDEX(',',@COSTID)>0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	SET @TEMPID=LEFT(@COSTID,CHARINDEX(',',@COSTID)-1) "
        'strSql += vbCrLf + " 	SET @COSTID=RIGHT(@COSTID,LEN(@COSTID)-CHARINDEX(',',@COSTID)) "
        'strSql += vbCrLf + " 	IF @COSTID <>'' AND CHARINDEX(',',@COSTID)=0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	SET @COSTID= @COSTID + ',' "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	INSERT INTO #COSTCENTRE (COSTID) SELECT @TEMPID "
        'strSql += vbCrLf + " 	END"
        'strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#USERNAME', 'U') IS NOT NULL DROP TABLE #USERNAME"
        'strSql += vbCrLf + " 	CREATE TABLE #USERNAME (USERID VARCHAR(6)) "
        'strSql += vbCrLf + " 	DECLARE @TEMPUSERID VARCHAR(5) "
        'strSql += vbCrLf + " 	IF CHARINDEX(',',@USERID)=0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	INSERT INTO #USERNAME (USERID) SELECT @USERID "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	WHILE CHARINDEX(',',@USERID)>0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	SET @TEMPUSERID=LEFT(@USERID,CHARINDEX(',',@USERID)-1) "
        'strSql += vbCrLf + " 	SET @USERID=RIGHT(@USERID,LEN(@USERID)-CHARINDEX(',',@USERID)) "
        'strSql += vbCrLf + " 	IF @USERID <>'' AND CHARINDEX(',',@USERID)=0 "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	SET @USERID= @USERID + ',' "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	INSERT INTO #USERNAME (USERID) SELECT @TEMPUSERID "
        'strSql += vbCrLf + " 	END"
        'strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#CASHACC', 'U') IS NOT NULL DROP TABLE #CASHACC     "
        'strSql += vbCrLf + " 	CREATE TABLE #CASHACC(ACCODE VARCHAR(7))    "
        'strSql += vbCrLf + " 	INSERT INTO #CASHACC(ACCODE) SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACTYPE = 'H' AND ACCODE IN (SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CASH')"
        'strSql += vbCrLf + " 	SET NOCOUNT ON "
        'strSql += vbCrLf + " 	SELECT * INTO #NONPOSBATCHNO "
        'strSql += vbCrLf + " 	FROM "
        'strSql += vbCrLf + " 	( "
        'strSql += vbCrLf + " 	SELECT DISTINCT BATCHNO FROM ACCTRAN      "
        'strSql += vbCrLf + " 	WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''  "
        'strSql += vbCrLf + " 	AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(FROMFLAG,'') = 'A'      "
        'strSql += vbCrLf + " 	)X      "
        'strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK "
        'strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPDAYBOOK "
        'strSql += vbCrLf + " 	( "
        'strSql += vbCrLf + " 	TDATE VARCHAR(12) "
        'strSql += vbCrLf + " 	,TRANNO INT "
        'strSql += vbCrLf + " 	,PARTICULAR VARCHAR(1000) "
        'strSql += vbCrLf + " 	,DEBIT NUMERIC(15,2) "
        'strSql += vbCrLf + " 	,CREDIT NUMERIC(15,2) "
        'strSql += vbCrLf + " 	,GRSWT NUMERIC(15,3) "
        'strSql += vbCrLf + " 	,COLHEAD VARCHAR(1) "
        'strSql += vbCrLf + " 	,RESULT INT "
        'strSql += vbCrLf + " 	,ACCODE VARCHAR(50)     "
        'strSql += vbCrLf + " 	,PAYMODE VARCHAR(50) "
        'strSql += vbCrLf + " 	,PAGEBREAK VARCHAR(10) "
        'strSql += vbCrLf + " 	,TRANDATE SMALLDATETIME      "
        'strSql += vbCrLf + " 	,SNO INT IDENTITY(1,1)      "
        'strSql += vbCrLf + " 	,BATCHNO VARCHAR(15)      "
        'strSql += vbCrLf + " 	,REFNO VARCHAR(25)  "
        'strSql += vbCrLf + " 	,REFDATE SMALLDATETIME  "
        'strSql += vbCrLf + " 	,CHQCARDNO VARCHAR(30)  "
        'strSql += vbCrLf + " 	,CHQDATE SMALLDATETIME  "
        'strSql += vbCrLf + " 	,ENTRYORDER INT     "
        'strSql += vbCrLf + " 	,TMP NUMERIC(15,2) "
        'strSql += vbCrLf + " 	) "
        'strSql += vbCrLf + " 	/** OPENING CASH **/ "
        'strSql += vbCrLf + " 	IF @OPENING = 'Y' "
        'strSql += vbCrLf + " 	BEGIN"
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,ACCODE,COLHEAD,RESULT)   "
        'strSql += vbCrLf + " 	SELECT TRANDATE,CONVERT(VARCHAR,'')TRANNO,'CASH OPENING'ACNAME "
        'strSql += vbCrLf + " 	,CASE WHEN SUM(CREDIT)- SUM(DEBIT) > 0 THEN SUM(CREDIT)- SUM(DEBIT) ELSE 0 END AS DEBIT"
        'strSql += vbCrLf + " 	,CASE WHEN SUM(DEBIT) - SUM(CREDIT) > 0 THEN SUM(DEBIT) - SUM(CREDIT) ELSE 0 END AS CREDIT "
        'strSql += vbCrLf + " 	,CONVERT(VARCHAR(8),NULL) ACCODE,'T',1  "
        'strSql += vbCrLf + " 	FROM"
        'strSql += vbCrLf + " 	("
        'strSql += vbCrLf + " 	SELECT DISTINCT T.TRANDATE,CONVERT(VARCHAR,'')TRANNO"
        'strSql += vbCrLf + " 	,ISNULL((SELECT SUM(DEBIT) FROM OPENTRAILBALANCE WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND USERID IN (SELECT USERID FROM #USERNAME)),0) "
        'strSql += vbCrLf + " 	+ ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE 0 END) "
        'strSql += vbCrLf + " 	FROM ACCTRAN  WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC)"
        'strSql += vbCrLf + " 	AND ISNULL(CANCEL,'') = '' AND COMPANYID IN (@COMPANYID)  AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(USERID,'') IN (SELECT USERID FROM #USERNAME) ),0) AS DEBIT"
        'strSql += vbCrLf + " 	,ISNULL((SELECT SUM(CREDIT) FROM OPENTRAILBALANCE WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND USERID IN (SELECT USERID FROM #USERNAME) ),0) "
        'strSql += vbCrLf + " 	+ ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'C' THEN ISNULL(AMOUNT,0) ELSE 0 END) "
        'strSql += vbCrLf + " 	FROM ACCTRAN  WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC) "
        'strSql += vbCrLf + " 	AND ISNULL(CANCEL,'') = '' AND COMPANYID IN (@COMPANYID)  AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(USERID,'') IN (SELECT USERID FROM #USERNAME) ),0) AS CREDIT"
        'strSql += vbCrLf + " 	FROM ACCTRAN AS T"
        'strSql += vbCrLf + " 	WHERE T.TRANDATE BETWEEN @FRMDATE AND @TODATE "
        'strSql += vbCrLf + " 	AND ISNULL(T.CANCEL,'') = '' AND T.COMPANYID = @COMPANYID AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(USERID,'') IN (SELECT USERID FROM #USERNAME)"
        'strSql += vbCrLf + " 	GROUP BY T.TRANDATE,T.ACCODE"
        'strSql += vbCrLf + " 	)X GROUP BY TRANDATE ORDER BY TRANDATE "
        'strSql += vbCrLf + " 	END"
        'strSql += vbCrLf + " 	ELSE "
        'strSql += vbCrLf + " 	BEGIN"
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,COLHEAD,RESULT)   "
        'strSql += vbCrLf + " 	SELECT TRANDATE,'T',1 FROM"
        'strSql += vbCrLf + " 	("
        'strSql += vbCrLf + " 	SELECT DISTINCT T.TRANDATE FROM ACCTRAN AS T, " & compId & "ADMINDB..ACHEAD AS A"
        'strSql += vbCrLf + " 	WHERE T.TRANDATE BETWEEN @FRMDATE AND @TODATE "
        'strSql += vbCrLf + " 	AND ISNULL(T.CANCEL,'') = '' AND T.COMPANYID = @COMPANYID AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(T.USERID,'') IN (SELECT USERID FROM #USERNAME)"
        'strSql += vbCrLf + " 	)X ORDER BY TRANDATE "
        'strSql += vbCrLf + " 	END"
        'strSql += vbCrLf + " 	/** Getting Pos Tran **/    "
        'strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#POSDETAIL', 'U') IS NOT NULL DROP TABLE #POSDETAIL    "
        'strSql += vbCrLf + " 	SELECT  "
        'strSql += vbCrLf + " 	TRANDATE,CASE WHEN @DETAILED = 'Y' OR @ORDERBY='G' THEN TRANNO ELSE NULL END AS TRANNO"
        'strSql += vbCrLf + " 	,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END AS DEBIT "
        'strSql += vbCrLf + " 	,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END AS CREDIT "
        'strSql += vbCrLf + " 	,CASE WHEN PAYMODE IN('SA','PU','SR') THEN GRSWT END GRSWT ,CONVERT(VARCHAR(50),ACCODE)ACCODE,PAYMODE,BATCHNO    "
        'strSql += vbCrLf + " 	,REFNO,REFDATE,CHQCARDNO,CHQDATE,REMARK1,REMARK2   "
        'strSql += vbCrLf + " 	INTO #POSDETAIL    "
        'strSql += vbCrLf + " 	FROM ACCTRAN AS T "
        'strSql += vbCrLf + " 	WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND NOT EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        'strSql += vbCrLf + " 	AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND USERID IN (SELECT USERID FROM #USERNAME) "
        'strSql += vbCrLf + " 	IF @DETAILED = 'Y'    "
        'strSql += vbCrLf + " 	BEGIN /** GROUPING SA,SR,PU TRANSACTION **/    "
        'strSql += vbCrLf + " 	UPDATE #POSDETAIL SET PAYMODE = CASE PAYMODE WHEN 'PV' THEN 'PU' WHEN 'RV' THEN 'SR' ELSE 'SA' END    "
        'strSql += vbCrLf + " 	WHERE PAYMODE IN ('SV','RV','PV')    "
        'strSql += vbCrLf + " 	UPDATE #POSDETAIL SET ACCODE = CASE PAYMODE WHEN 'PU' THEN 'PURCHASE' WHEN 'SR' THEN 'SALES RETURN' ELSE 'SALES' END    "
        'strSql += vbCrLf + " 	WHERE PAYMODE IN ('SA','SR','PU','SV','RV','PV')    "
        'strSql += vbCrLf + " 	END    "
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,GRSWT,ACCODE,PAYMODE,RESULT,BATCHNO,ENTRYORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE) "
        'strSql += vbCrLf + " 	/** POS TRANS **/ "
        'strSql += vbCrLf + " 	SELECT   "
        'strSql += vbCrLf + " 	TRANDATE,CONVERT(INT,TRANNO)AS TRANNO      "
        'strSql += vbCrLf + " 	,ACNAME,SUM(DEBIT)DEBIT,SUM(CREDIT)CREDIT,SUM(GRSWT) GRSWT "
        'strSql += vbCrLf + " 	,ACCODE,PAYMODE,2 RESULT,CONVERT(VARCHAR(15),NULL)BATCHNO,CONVERT(INT,NULL)ENTRYORDER "
        'strSql += vbCrLf + " 	,REFNO,REFDATE,CHQCARDNO,CHQDATE  "
        'strSql += vbCrLf + " 	FROM      "
        'strSql += vbCrLf + " 	(      "
        'strSql += vbCrLf + " 	SELECT     "
        'strSql += vbCrLf + " 	T.TRANDATE,CASE WHEN @ORDERBY='G' AND PAYMODE IN('SA','PU','SR','SV','PV','RV','RO') THEN NULL ELSE TRANNO END TRANNO "
        'strSql += vbCrLf + " 	,CASE WHEN ISNULL(@OPENING,'') = 'Y' THEN '' ELSE '' END "
        'strSql += vbCrLf + " 	+ISNULL((SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE),T.ACCODE) "
        'strSql += vbCrLf + " 	+ CASE WHEN @ORDERBY='G' AND T.ACCODE ='ADVANCE' THEN CHAR(13) + '('+ (SELECT  PNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO IN(SELECT PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO=T.BATCHNO)) +')' ELSE '' END"
        'strSql += vbCrLf + " 	+ ISNULL(CASE WHEN @ORDERBY ='G' AND PAYMODE IN('SA','PU','SR','SV','PV','RV') THEN CHAR(13) + ' (BILL NO FROM ' + CONVERT (VARCHAR(20), (SELECT MIN(TRANNO) FROM #POSDETAIL WHERE PAYMODE=T.PAYMODE AND ACCODE=T.ACCODE  AND TRANDATE=T.TRANDATE )) END ,'')"
        'strSql += vbCrLf + " 	+ ISNULL(CASE WHEN @ORDERBY ='G' AND PAYMODE IN('SA','PU','SR','SV','PV','RV') THEN ' TO ' + CONVERT (VARCHAR(20),(SELECT MAX(TRANNO) FROM #POSDETAIL WHERE PAYMODE=T.PAYMODE AND ACCODE=T.ACCODE  AND TRANDATE=T.TRANDATE ) ) +' )' END,'') "
        'strSql += vbCrLf + " 	+ CASE WHEN @ORDERBY='G' AND PAYMODE in('MR','AR','DR','OR','MP','AP','DP','AA') AND T.REMARK1 <>'' THEN CHAR(13) + '('+ T.REMARK1 +')' ELSE '' END"
        'strSql += vbCrLf + " 	+ CASE WHEN @ORDERBY='G' AND PAYMODE in('MR','AR','DR','OR','MP','AP','DP','AA') AND T.REMARK2 <>'' THEN ' ' + '('+ T.REMARK2 +')' ELSE '' END"
        'strSql += vbCrLf + " 	AS ACNAME "
        'strSql += vbCrLf + " 	,DEBIT,CREDIT,GRSWT,T.ACCODE,PAYMODE,REFNO,REFDATE,CHQCARDNO,CHQDATE FROM #POSDETAIL AS T     "
        'strSql += vbCrLf + " 	/*LEFT JOIN CUSTOMERINFO C ON C.BATCHNO=T.BATCHNO */"
        'strSql += vbCrLf + " 	/*LEFT JOIN " & compId & "ADMINDB..PERSONALINFO P ON P.SNO =C.PSNO */"
        'strSql += vbCrLf + " 	)X      "
        'strSql += vbCrLf + " 	GROUP BY TRANDATE,ACCODE,PAYMODE,TRANNO,ACNAME,REFNO,REFDATE,CHQCARDNO,CHQDATE      "
        'strSql += vbCrLf + " 	UNION ALL "
        'strSql += vbCrLf + " 	/** OTHER THAN POS TRAN (Account Entry)**/ "
        'strSql += vbCrLf + " 	SELECT  "
        'strSql += vbCrLf + " 	T.TRANDATE,TRANNO "
        'strSql += vbCrLf + " 	,CASE WHEN ISNULL(@OPENING,'') = 'Y' THEN '' ELSE '' END "
        'strSql += vbCrLf + " 	+(SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE) "
        'strSql += vbCrLf + " 	+ CASE WHEN @ORDERBY='G' AND T.ACCODE ='ADVANCE' THEN CHAR(13) +'('+ P.PNAME +')' ELSE '' END"
        'strSql += vbCrLf + " 	+ CASE WHEN T.REMARK1 <> '' THEN CHAR(13) + T.REMARK1 ELSE '' END "
        'strSql += vbCrLf + " 	+ CASE WHEN REMARK2 <> '' THEN ' ' + REMARK2 ELSE '' END  AS ACNAME "
        'strSql += vbCrLf + " 	,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END) AS DEBIT "
        'strSql += vbCrLf + " 	,SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END) AS CREDIT "
        'strSql += vbCrLf + " 	,CASE WHEN PAYMODE IN('SA','PU','SR') THEN SUM(ISNULL(GRSWT,0)) END GRSWT,T.ACCODE,PAYMODE,2 RESULT,T.BATCHNO,WT_ENTORDER AS ENTRYORDER  "
        'strSql += vbCrLf + " 	,REFNO,REFDATE,CHQCARDNO,CHQDATE      "
        'strSql += vbCrLf + " 	FROM ACCTRAN AS T "
        'strSql += vbCrLf + " 	LEFT JOIN " & compId & "ADMINDB..CUSTOMERINFO C ON C.BATCHNO=T.BATCHNO "
        'strSql += vbCrLf + " 	LEFT JOIN " & compId & "ADMINDB..PERSONALINFO P ON P.SNO =C.PSNO "
        'strSql += vbCrLf + " 	WHERE T.TRANDATE BETWEEN @FRMDATE AND @TODATE AND EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        'strSql += vbCrLf + " 	AND T.ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(T.CANCEL,'') = ''  AND T.COMPANYID = @COMPANYID AND T.COSTID IN (SELECT COSTID FROM #COSTCENTRE)  "
        'strSql += vbCrLf + " 	AND T.USERID IN (SELECT USERID FROM #USERNAME)  "
        'strSql += vbCrLf + " 	GROUP BY T.TRANDATE,T.ACCODE,T.REMARK1,REMARK2,TRANNO,T.BATCHNO,WT_ENTORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE,PAYMODE,P.PNAME"
        'strSql += vbCrLf + " 	/** TOTAL BALANCE **/"
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,PARTICULAR,DEBIT,CREDIT,COLHEAD,RESULT)"
        'strSql += vbCrLf + " 	SELECT TRANDATE,'TOTAL' AS PARTICULAR,SUM(DEBIT)DEBIT,SUM(CREDIT),'S'COLHEAD,20 RESULT "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK WHERE RESULT IN (2) GROUP BY TRANDATE "
        'strSql += vbCrLf + " 	UNION ALL "
        'strSql += vbCrLf + " 	SELECT TRANDATE,'CLOSING' AS PARTICULAR "
        'strSql += vbCrLf + " 	,CASE WHEN SUM(DEBIT)-SUM(CREDIT)>0 THEN SUM(DEBIT)-SUM(CREDIT) ELSE 0 END AS DEBIT  "
        'strSql += vbCrLf + " 	,CASE WHEN SUM(CREDIT)-SUM(DEBIT)>0 THEN SUM(CREDIT)-SUM(DEBIT) ELSE 0 END AS CREDIT "
        'strSql += vbCrLf + " 	,'S'COLHEAD,21 RESULT "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK WHERE RESULT IN (1,2) GROUP BY TRANDATE    "
        'strSql += vbCrLf + " 	IF @PAGEBREAK = 'Y' "
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,COLHEAD,RESULT,PAGEBREAK) "
        'strSql += vbCrLf + " 	SELECT TRANDATE,'S'COLHEAD,22 RESULT,'CHR(12)' FROM TEMPTABLEDB..TEMPDAYBOOK GROUP BY TRANDATE "
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	IF @OPENING = 'Y' UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103) WHERE RESULT = 1 "
        'strSql += vbCrLf + " 	ELSE UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103) "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK T WHERE RESULT = 1 "
        'strSql += vbCrLf + " 	/*AND SNO IN (SELECT TOP 1 SNO FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = T.TRANDATE AND RESULT = 2 ORDER BY PARTICULAR)*/"
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET DEBIT = NULL WHERE ISNULL(DEBIT,0) = 0 "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET CREDIT = NULL WHERE ISNULL(CREDIT,0) = 0 "
        'strSql += vbCrLf + " 	/** UPDATING WEIGHT INFORMATION **/ "
        'strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPWEIGHTINFO')>0 DROP TABLE TEMPTABLEDB..TEMPWEIGHTINFO "
        'strSql += vbCrLf + " 	SELECT "
        'strSql += vbCrLf + " 	'PCS=' + CONVERT(VARCHAR,PCS)+' GRSWT=' + CONVERT(VARCHAR,GRSWT)+' NETWT=' + CONVERT(VARCHAR,NETWT)AS WEIGHTINFO "
        'strSql += vbCrLf + " 	,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER "
        'strSql += vbCrLf + " 	INTO TEMPTABLEDB..TEMPWEIGHTINFO FROM ISSUE I "
        'strSql += vbCrLf + " 	WHERE EXISTS (SELECT 1 FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER)"
        'strSql += vbCrLf + " 	UNION ALL "
        'strSql += vbCrLf + " 	SELECT 'PCS=' + CONVERT(VARCHAR,PCS)+' GRSWT=' + CONVERT(VARCHAR,GRSWT)+' NETWT=' + CONVERT(VARCHAR,NETWT) AS WEIGHTINFO "
        'strSql += vbCrLf + " 	,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER FROM RECEIPT I "
        'strSql += vbCrLf + " 	WHERE EXISTS (SELECT 1 FROM TEMPTABLEDB..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER) "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET PARTICULAR = PARTICULAR + CHAR(13) + W.WEIGHTINFO "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK AS B,TEMPTABLEDB..TEMPWEIGHTINFO AS W "
        'strSql += vbCrLf + " 	WHERE B.TRANDATE = W.TRANDATE AND B.BATCHNO = W.BATCHNO AND B.ENTRYORDER = W.ENTRYORDER "
        'strSql += vbCrLf + " 	/*ALTER TABLE TEMPTABLEDB..TEMPDAYBOOK ADD TEMP NUMERIC(15,2)"
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET TMP = CREDIT "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET CREDIT = DEBIT "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET DEBIT = TMP*/"
        'strSql += vbCrLf + " 	IF @SUMMARY='Y'"
        'strSql += vbCrLf + " 	BEGIN"
        'strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK1')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK1 "
        'strSql += vbCrLf + " 	SELECT * INTO TEMPTABLEDB..TEMPDAYBOOK1 FROM TEMPTABLEDB..TEMPDAYBOOK"
        'strSql += vbCrLf + " 	DELETE FROM TEMPTABLEDB..TEMPDAYBOOK WHERE RESULT=2"
        'strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPDAYBOOK (TRANNO,PAYMODE,PARTICULAR,DEBIT,CREDIT,TRANDATE,RESULT )"
        'strSql += vbCrLf + " 	SELECT TRANNO,PAYMODE,PARTICULAR"
        'strSql += vbCrLf + " 	,CASE WHEN SUM(ISNULL(DEBIT,0))=0 THEN NULL ELSE SUM(ISNULL(DEBIT,0)) END"
        'strSql += vbCrLf + " 	,CASE WHEN SUM(ISNULL(CREDIT,0))=0 THEN NULL ELSE SUM(ISNULL(CREDIT,0)) END"
        'strSql += vbCrLf + " 	,TRANDATE,RESULT FROM TEMPTABLEDB..TEMPDAYBOOK1 WHERE RESULT=2 "
        'strSql += vbCrLf + " 	GROUP BY TRANNO,PAYMODE,PARTICULAR,TRANDATE,RESULT"
        'strSql += vbCrLf + " 	END  "
        'strSql += vbCrLf + " 	IF @ORDERBY='G'"
        'strSql += vbCrLf + " 	BEGIN "
        'strSql += vbCrLf + " 	UPDATE A SET A.CREDIT=CASE WHEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0))>0 THEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0)) ELSE null END "
        'strSql += vbCrLf + " 	,A.DEBIT=CASE WHEN (ISNULL(A.DEBIT,0)-ISNULL(CREDIT,0))>0 THEN (ISNULL(A.DEBIT,0)-ISNULL(A.CREDIT,0))  ELSE null END "
        'strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPDAYBOOK  A WHERE A.PAYMODE IN('JE','CP','CR') AND ISNULL(A.COLHEAD,'') NOT IN('T','S') "
        'strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPDAYBOOK SET RESULT=(CASE WHEN PAYMODE='SA' THEN 2 WHEN PAYMODE='SV' THEN 3  "
        'strSql += vbCrLf + " 	WHEN PAYMODE='PU' THEN 4 WHEN PAYMODE='PV' THEN 5  WHEN PAYMODE='SR' THEN 6 WHEN PAYMODE='RV' THEN 7 "
        'strSql += vbCrLf + " 	WHEN PAYMODE in('AA','AR','AP') THEN 8 WHEN PAYMODE in('SS','CB','CD') THEN 9 WHEN PAYMODE in('CC') THEN 10 WHEN PAYMODE in('CH') THEN 11 "
        'strSql += vbCrLf + " 	ELSE 12 END) WHERE RESULT=2 AND ISNULL(COLHEAD,'')=''"
        'strSql += vbCrLf + " 	END "
        'strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMPDAYBOOK ORDER BY TRANDATE,TDATE DESC ,RESULT,TRANNO,PARTICULAR"
        'strSql += vbCrLf + " END /* sp_daybook end */ "
    End Sub


    Private Sub Funcsp_GetAddress()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_GETADDRESS')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_GETADDRESS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  CREATE PROCEDURE [dbo].[SP_GETADDRESS] (@DBNAME VARCHAR(25),@MERGE VARCHAR(1),@EMPTYROW VARCHAR(1) )"
        strSql += vbCrLf + "AS "
        strSql += vbCrLf + "DECLARE @SQLQRY NVARCHAR(1000)"
        strSql += vbCrLf + "declare @actype varchar(20)"
        strSql += vbCrLf + "SET @actype = ''"
        strSql += vbCrLf + "select @actype = CTLTEXT FROM SOFTCONTROL WHERE CTLID = 'POS-ACTYPECHK'"
        strSql += vbCrLf + "IF @actype <> ''  SET @actype= REPLACE(@actype,',',''',''')"
        strSql += vbCrLf + "SET @SQLQRY = ''"
        strSql += vbCrLf + "IF @MERGE = 'N'"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+'SELECT ACCODE,PREVILEGEID,TITLE,INITIAL,ACNAME as PNAME,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3'"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+',AREA,CITY,STATE,COUNTRY,PINCODE,PHONENO PHONERES,MOBILE,EMAILID,''0'' AS SNO FROM '+ @DBNAME +'..ACHEAD WHERE ISNULL(ACTIVE,'''') <> ''N'' '"
        strSql += vbCrLf + "IF @actype <> '' SELECT @SQLQRY = @SQLQRY+' AND ACTYPE IN ('''+@actype +''')'"
        strSql += vbCrLf + "IF @EMPTYROW = 'Y'"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+' UNION ALL SELECT  ACCODE,PREVILEGEID,TITLE,INITIAL,PNAME,DOORNO '"
        'SVJ COMMENTS GIVEN BY MAGESH
        'strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+',ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,STATE,COUNTRY,PINCODE,PHONERES,MOBILE,EMAIL,SNO FROM '+ @DBNAME + '..PERSONALINFO WHERE ISNULL(AREA,'''') <> '''' AND ACCODE NOT IN(SELECT ACCODE FROM ACHEAD)'"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+',ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,STATE,COUNTRY,PINCODE,PHONERES,MOBILE,EMAIL,SNO FROM '+ @DBNAME + '..PERSONALINFO WHERE ACCODE NOT IN(SELECT ACCODE FROM ACHEAD)'"
        strSql += vbCrLf + "END"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "IF @MERGE = 'Y'"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+'SELECT SNO,ACCODE,PNAME,DOORNO+ADDRESS1+ADDRESS2+AREA,ADDRESS3,CITY,PINCODE,STATE,COUNTRY, '"
        strSql += vbCrLf + "SELECT @SQLQRY = @SQLQRY+' PHONERES,MOBILE,EMAIL,FAX  FROM '+@DBNAME +'..PERSONALINFO'"
        strSql += vbCrLf + "IF @EMPTYROW ='Y' SELECT @SQLQRY = @SQLQRY+' WHERE 1<>1'"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "EXECUTE SP_EXECUTESQL @SQLQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub


    Private Sub Funcsp_GetAchead()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_GETACHEAD')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_GETACHEAD"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "   CREATE PROCEDURE [dbo].[SP_GETACHEAD] (@DBNAME VARCHAR(25),@ACTYPE VARCHAR(1),@ACCODE VARCHAR(7),@ACNAME VARCHAR(45))"
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " DECLARE @SQLQRY NVARCHAR(1000)"
        strSql += vbCrLf + " SET @SQLQRY = ''"
        strSql += vbCrLf + " SELECT @SQLQRY = @SQLQRY+'SELECT ACNAME,ACCODE,PREVILEGEID,TITLE,INITIAL,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3'"
        strSql += vbCrLf + " SELECT @SQLQRY = @SQLQRY+',AREA,CITY,STATE,COUNTRY,PINCODE,PHONENO PHONERES,MOBILE,EMAILID,''0'' AS SNO FROM '+ @DBNAME +'..ACHEAD WHERE ACTIVE=''Y'''"
        strSql += vbCrLf + " IF @ACTYPE <>'' SELECT @SQLQRY = @SQLQRY+' AND ACTYPE IN ('+@ACTYPE+')'"
        strSql += vbCrLf + " IF @ACCODE <>'' SELECT @SQLQRY = @SQLQRY+' AND ACCODE IN ('+@ACCODE+')'"
        strSql += vbCrLf + " IF @ACNAME <>'' SELECT @SQLQRY = @SQLQRY+' AND ACNAME IN ('+@ACNAME+')'"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @SQLQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub funcSP19_DayBookWithJournal()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAYBOOKWITHJOURNAL')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_DAYBOOKWITHJOURNAL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  CREATE PROCEDURE SP_DAYBOOKWITHJOURNAL"
        strSql += vbCrLf + "  ( "
        strSql += vbCrLf + "   @FRMDATE VARCHAR(12) "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(12) "
        strSql += vbCrLf + "  ,@OPENING VARCHAR(1) "
        strSql += vbCrLf + "  ,@PAGEBREAK VARCHAR(1) "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(3) "
        strSql += vbCrLf + "  ,@COSTID VARCHAR(300) "
        strSql += vbCrLf + "  ,@DETAILED VARCHAR(1)   "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  BEGIN /* sp_daybook begin starts */ "
        strSql += vbCrLf + "  /*  Intitial Authors : Ramesh      */ "
        strSql += vbCrLf + "  /*  Create   Date    : 12/Mar/2010      */ "
        strSql += vbCrLf + "  /*  Purpose          : For DayBook      */ "
        strSql += vbCrLf + "  /*  Refred Tables    : */ "
        strSql += vbCrLf + "  /*  Refred Forms/Dll : */ "
        strSql += vbCrLf + "  /*   Created/Modified            Modified                 Description       */ "
        strSql += vbCrLf + "  /* ****************************************************************************************** */ "
        strSql += vbCrLf + "  /** "
        strSql += vbCrLf + "  RESULT = 1 OPENING CASH "
        strSql += vbCrLf + "  RESULT = 2 TRANSATION "
        strSql += vbCrLf + "  RESULT = 3 TOTAL "
        strSql += vbCrLf + "  RESULT = 4 CLOSING "
        strSql += vbCrLf + "  RESULT = 5 PAGEBREAK "
        strSql += vbCrLf + "  **/ "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#NONPOSBATCHNO', 'U') IS NOT NULL DROP TABLE #NONPOSBATCHNO "
        strSql += vbCrLf + "  CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3)) "
        strSql += vbCrLf + "  DECLARE @TEMPID VARCHAR(5) "
        strSql += vbCrLf + "  IF CHARINDEX(',',@COSTID)=0 "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  INSERT INTO #COSTCENTRE (COSTID) SELECT @COSTID "
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + "  WHILE CHARINDEX(',',@COSTID)>0 "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  SET @TEMPID=LEFT(@COSTID,CHARINDEX(',',@COSTID)-1) "
        strSql += vbCrLf + "  SET @COSTID=RIGHT(@COSTID,LEN(@COSTID)-CHARINDEX(',',@COSTID)) "
        strSql += vbCrLf + "  IF @COSTID <>'' AND CHARINDEX(',',@COSTID)=0 "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  SET @COSTID= @COSTID + ',' "
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + "  INSERT INTO #COSTCENTRE (COSTID) SELECT @TEMPID "
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#CASHACC', 'U') IS NOT NULL DROP TABLE #CASHACC     "
        strSql += vbCrLf + "  CREATE TABLE #CASHACC(ACCODE VARCHAR(7))    "
        strSql += vbCrLf + "  INSERT INTO #CASHACC(ACCODE) SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE = '1'    "
        strSql += vbCrLf + "  SET NOCOUNT ON "
        strSql += vbCrLf + "  SELECT * INTO #NONPOSBATCHNO "
        strSql += vbCrLf + "  FROM "
        strSql += vbCrLf + "  ( "
        strSql += vbCrLf + "  SELECT DISTINCT BATCHNO FROM " & tranDbName & "..ACCTRAN      "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + "  AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(FROMFLAG,'') = 'A'      "
        strSql += vbCrLf + "  )X      "
        strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK')>0 DROP TABLE MASTER..TEMPDAYBOOK "
        strSql += vbCrLf + "  CREATE TABLE MASTER..TEMPDAYBOOK "
        strSql += vbCrLf + "  ( "
        strSql += vbCrLf + "  TDATE VARCHAR(12) "
        strSql += vbCrLf + "  ,TRANNO INT "
        strSql += vbCrLf + "  ,PARTICULAR VARCHAR(1000) "
        strSql += vbCrLf + "  ,DEBIT NUMERIC(15,2) "
        strSql += vbCrLf + "  ,CREDIT NUMERIC(15,2) "
        strSql += vbCrLf + "  ,JDEBIT NUMERIC(15,2) "
        strSql += vbCrLf + "  ,JCREDIT NUMERIC(15,2) "
        strSql += vbCrLf + "  ,COLHEAD VARCHAR(1) "
        strSql += vbCrLf + "  ,RESULT INT "
        strSql += vbCrLf + "  ,ACCODE VARCHAR(50) "
        strSql += vbCrLf + "  ,PAGEBREAK VARCHAR(10) "
        strSql += vbCrLf + "  ,TRANDATE SMALLDATETIME      "
        strSql += vbCrLf + "  ,SNO INT IDENTITY(1,1)      "
        strSql += vbCrLf + "  ,BATCHNO VARCHAR(15)      "
        strSql += vbCrLf + "  ,REFNO VARCHAR(25)  "
        strSql += vbCrLf + "  ,REFDATE SMALLDATETIME  "
        strSql += vbCrLf + "  ,CHQCARDNO VARCHAR(30)  "
        strSql += vbCrLf + "  ,CHQDATE SMALLDATETIME  "
        strSql += vbCrLf + "  ,ENTRYORDER INT     "
        strSql += vbCrLf + "  ,TMP NUMERIC(15,2) "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  /** OPENING CASH **/ "
        strSql += vbCrLf + "  IF @OPENING = 'Y' "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,ACCODE,COLHEAD,RESULT) "
        strSql += vbCrLf + "  SELECT TRANDATE,TRANNO,ACNAME "
        strSql += vbCrLf + "  ,CASE WHEN AMOUNT < 0 THEN -1*AMOUNT ELSE 0 END DEBIT "
        strSql += vbCrLf + "  ,CASE WHEN AMOUNT > 0 THEN AMOUNT ELSE 0 END AS CREDIT "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(8),NULL) ACCODE,'T',1 "
        strSql += vbCrLf + "  FROM "
        strSql += vbCrLf + "  ( "
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  TRANDATE,CONVERT(INT,NULL)TRANNO "
        strSql += vbCrLf + "  ,'CASH OPENING' AS ACNAME "
        strSql += vbCrLf + "  ,ISNULL((SELECT SUM(DEBIT-CREDIT) FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)),0)"
        strSql += vbCrLf + "  +ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC) AND ISNULL(CANCEL,'') = ''    "
        strSql += vbCrLf + "  AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)),0) AS AMOUNT   "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN AS T "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) "
        strSql += vbCrLf + "  GROUP BY TRANDATE "
        strSql += vbCrLf + "  )X   "
        strSql += vbCrLf + "  END    "

        strSql += vbCrLf + "  /** Getting Pos Tran **/    "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#POSDETAIL', 'U') IS NOT NULL DROP TABLE #POSDETAIL    "
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  TRANDATE,CASE WHEN @DETAILED = 'Y' THEN TRANNO ELSE NULL END AS TRANNO"
        strSql += vbCrLf + "  ,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END AS DEBIT "
        strSql += vbCrLf + "  ,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END AS CREDIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS JDEBIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS JCREDIT "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(50),ACCODE)ACCODE,PAYMODE,BATCHNO    "
        strSql += vbCrLf + "  ,REFNO,REFDATE,CHQCARDNO,CHQDATE  "
        strSql += vbCrLf + "  INTO #POSDETAIL    "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN AS T "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND NOT EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        strSql += vbCrLf + "  AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) "
        strSql += vbCrLf + "  AND CONTRA IN (SELECT ACCODE FROM #CASHACC)  "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  TRANDATE,CASE WHEN @DETAILED = 'Y' THEN TRANNO ELSE NULL END AS TRANNO"
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS DEBIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS CREDIT "
        strSql += vbCrLf + "  ,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END AS JDEBIT "
        strSql += vbCrLf + "  ,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END AS JCREDIT "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(50),ACCODE)ACCODE,PAYMODE,BATCHNO    "
        strSql += vbCrLf + "  ,REFNO,REFDATE,CHQCARDNO,CHQDATE  "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN AS T "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND NOT EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        strSql += vbCrLf + "  AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) "
        strSql += vbCrLf + "  AND CONTRA NOT IN (SELECT ACCODE FROM #CASHACC)  "
        strSql += vbCrLf + "  IF @DETAILED = 'Y'    "
        strSql += vbCrLf + "  BEGIN /** GROUPING SA,SR,PU TRANSACTION **/    "
        strSql += vbCrLf + "  UPDATE #POSDETAIL SET PAYMODE = CASE PAYMODE WHEN 'PV' THEN 'PU' WHEN 'RV' THEN 'SR' ELSE 'SA' END    "
        strSql += vbCrLf + "  WHERE PAYMODE IN ('SV','RV','PV')    "
        strSql += vbCrLf + "  UPDATE #POSDETAIL SET ACCODE = CASE PAYMODE WHEN 'PU' THEN 'PURCHASE' WHEN 'SR' THEN 'SALES RETURN' ELSE 'SALES' END    "
        strSql += vbCrLf + "  WHERE PAYMODE IN ('SA','SR','PU','SV','RV','PV')    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,JDEBIT,JCREDIT,ACCODE,RESULT,BATCHNO,ENTRYORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE) "
        strSql += vbCrLf + "  /** POS TRANS **/ "
        strSql += vbCrLf + "  SELECT   "
        strSql += vbCrLf + "  TRANDATE,CONVERT(INT,TRANNO)AS TRANNO      "
        strSql += vbCrLf + "  ,ACNAME,SUM(DEBIT)DEBIT,SUM(CREDIT)CREDIT,SUM(JDEBIT)JDEBIT,SUM(JCREDIT)JCREDIT           "
        strSql += vbCrLf + "  ,ACCODE,2 RESULT,CONVERT(VARCHAR(15),NULL)BATCHNO,CONVERT(INT,NULL)ENTRYORDER "
        strSql += vbCrLf + "  ,REFNO,REFDATE,CHQCARDNO,CHQDATE  "
        strSql += vbCrLf + "  FROM      "
        strSql += vbCrLf + "  (      "
        strSql += vbCrLf + "  SELECT     "
        strSql += vbCrLf + "  TRANDATE,TRANNO"
        strSql += vbCrLf + "  ,CASE WHEN ISNULL(@OPENING,'') = 'Y' THEN '' ELSE '' END "
        strSql += vbCrLf + "  +ISNULL((SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE),ACCODE) AS ACNAME "
        strSql += vbCrLf + "  ,DEBIT,CREDIT,JDEBIT,JCREDIT,ACCODE,PAYMODE,REFNO,REFDATE,CHQCARDNO,CHQDATE FROM #POSDETAIL AS T     "
        strSql += vbCrLf + "  )X      "
        strSql += vbCrLf + "  GROUP BY TRANDATE,ACCODE,TRANNO,ACNAME,REFNO,REFDATE,CHQCARDNO,CHQDATE      "
        strSql += vbCrLf + "  UNION ALL "
        strSql += vbCrLf + "  /** OTHER THAN POS TRAN (Account Entry)**/ "
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  TRANDATE,TRANNO "
        strSql += vbCrLf + "  ,CASE WHEN ISNULL(@OPENING,'') = 'Y' THEN '' ELSE '' END "
        strSql += vbCrLf + "  +(SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE) "
        strSql += vbCrLf + "  + CASE WHEN REMARK1 <> '' THEN CHAR(13) + REMARK1 ELSE '' END "
        strSql += vbCrLf + "  + CASE WHEN REMARK2 <> '' THEN CHAR(13) + REMARK2 ELSE '' END  AS ACNAME "
        strSql += vbCrLf + "  ,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END) AS DEBIT "
        strSql += vbCrLf + "  ,SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END) AS CREDIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS JDEBIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS JCREDIT "
        strSql += vbCrLf + "  ,ACCODE,2 RESULT,BATCHNO,WT_ENTORDER AS ENTRYORDER  "
        strSql += vbCrLf + "  ,REFNO,REFDATE,CHQCARDNO,CHQDATE      "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN AS T "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        strSql += vbCrLf + "  AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)  "
        strSql += vbCrLf + "  AND CONTRA IN (SELECT ACCODE FROM #CASHACC)  "
        strSql += vbCrLf + "  GROUP BY TRANDATE,ACCODE,REMARK1,REMARK2,TRANNO,BATCHNO,WT_ENTORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE     "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  TRANDATE,TRANNO "
        strSql += vbCrLf + "  ,CASE WHEN ISNULL(@OPENING,'') = 'Y' THEN '' ELSE '' END "
        strSql += vbCrLf + "  +(SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE) "
        strSql += vbCrLf + "  + CASE WHEN REMARK1 <> '' THEN CHAR(13) + REMARK1 ELSE '' END "
        strSql += vbCrLf + "  + CASE WHEN REMARK2 <> '' THEN CHAR(13) + REMARK2 ELSE '' END  AS ACNAME "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS DEBIT "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),0) AS CREDIT "
        strSql += vbCrLf + "  ,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END) AS JDEBIT "
        strSql += vbCrLf + "  ,SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END) AS JCREDIT "
        strSql += vbCrLf + "  ,ACCODE,2 RESULT,BATCHNO,WT_ENTORDER AS ENTRYORDER  "
        strSql += vbCrLf + "  ,REFNO,REFDATE,CHQCARDNO,CHQDATE      "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN AS T "
        strSql += vbCrLf + "  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND EXISTS (SELECT 1 FROM #NONPOSBATCHNO WHERE BATCHNO = T.BATCHNO) "
        strSql += vbCrLf + "  AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  AND COMPANYID = @COMPANYID AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)  "
        strSql += vbCrLf + "  AND CONTRA NOT IN (SELECT ACCODE FROM #CASHACC)  "
        strSql += vbCrLf + "  GROUP BY TRANDATE,ACCODE,REMARK1,REMARK2,TRANNO,BATCHNO,WT_ENTORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE     "

        strSql += vbCrLf + "  /** TOTAL BALANCE **/ "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMPDAYBOOK(TRANDATE,PARTICULAR,DEBIT,CREDIT,JDEBIT,JCREDIT,COLHEAD,RESULT) "
        strSql += vbCrLf + "  SELECT TRANDATE,'TOTAL' AS PARTICULAR,SUM(DEBIT)DEBIT,SUM(CREDIT),SUM(JDEBIT)JDEBIT,SUM(JCREDIT),'S'COLHEAD,3 RESULT "
        strSql += vbCrLf + "  FROM MASTER..TEMPDAYBOOK WHERE RESULT IN (1,2) GROUP BY TRANDATE "
        strSql += vbCrLf + "  UNION ALL "
        strSql += vbCrLf + "  SELECT TRANDATE,'CLOSING' AS PARTICULAR "
        strSql += vbCrLf + "  ,CASE WHEN SUM(DEBIT)-SUM(CREDIT)>0 THEN SUM(DEBIT)-SUM(CREDIT) ELSE 0 END AS DEBIT "
        strSql += vbCrLf + "  ,CASE WHEN SUM(CREDIT)-SUM(DEBIT)>0 THEN SUM(CREDIT)-SUM(DEBIT) ELSE 0 END AS CREDIT "
        strSql += vbCrLf + "  ,CASE WHEN SUM(JDEBIT)-SUM(JCREDIT)>0 THEN SUM(JDEBIT)-SUM(JCREDIT) ELSE 0 END AS JDEBIT "
        strSql += vbCrLf + "  ,CASE WHEN SUM(JCREDIT)-SUM(JDEBIT)>0 THEN SUM(JCREDIT)-SUM(JDEBIT) ELSE 0 END AS JCREDIT "
        strSql += vbCrLf + "  ,'S'COLHEAD,4 RESULT "
        strSql += vbCrLf + "  FROM MASTER..TEMPDAYBOOK WHERE RESULT IN (1,2) GROUP BY TRANDATE"
        strSql += vbCrLf + "  IF @PAGEBREAK = 'Y' "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMPDAYBOOK(TRANDATE,COLHEAD,RESULT,PAGEBREAK) "
        strSql += vbCrLf + "  SELECT TRANDATE,'S'COLHEAD,5 RESULT,'CHR(12)' FROM MASTER..TEMPDAYBOOK GROUP BY TRANDATE "
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + "  IF @OPENING = 'Y' UPDATE MASTER..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103) WHERE RESULT = 1 "
        strSql += vbCrLf + "  ELSE UPDATE MASTER..TEMPDAYBOOK SET TDATE = CONVERT(VARCHAR(12),TRANDATE,103)  "
        strSql += vbCrLf + "  FROM MASTER..TEMPDAYBOOK T WHERE RESULT = 2 "
        strSql += vbCrLf + "  AND SNO IN (SELECT TOP 1 SNO FROM MASTER..TEMPDAYBOOK WHERE TRANDATE = T.TRANDATE AND RESULT = 2 ORDER BY PARTICULAR) "
        strSql += vbCrLf + "  UPDATE MASTER..TEMPDAYBOOK SET DEBIT = NULL WHERE ISNULL(DEBIT,0) = 0 "
        strSql += vbCrLf + "  UPDATE MASTER..TEMPDAYBOOK SET CREDIT = NULL WHERE ISNULL(CREDIT,0) = 0 "
        strSql += vbCrLf + "  UPDATE MASTER..TEMPDAYBOOK SET JDEBIT = NULL WHERE ISNULL(JDEBIT,0) = 0 "
        strSql += vbCrLf + "  UPDATE MASTER..TEMPDAYBOOK SET JCREDIT = NULL WHERE ISNULL(JCREDIT,0) = 0 "
        strSql += vbCrLf + "  /** UPDATING WEIGHT INFORMATION **/      "
        strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPWEIGHTINFO')>0 DROP TABLE MASTER..TEMPWEIGHTINFO      "
        strSql += vbCrLf + "  SELECT"
        strSql += vbCrLf + "  'PCS=' + CONVERT(VARCHAR,PCS)      "
        strSql += vbCrLf + "  +' GRSWT=' + CONVERT(VARCHAR,GRSWT)      "
        strSql += vbCrLf + "  +' NETWT=' + CONVERT(VARCHAR,NETWT)      "
        strSql += vbCrLf + "  AS WEIGHTINFO      "
        strSql += vbCrLf + "  ,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER"
        strSql += vbCrLf + "  INTO MASTER..TEMPWEIGHTINFO      "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ISSUE I"
        strSql += vbCrLf + "  WHERE EXISTS (SELECT 1 FROM MASTER..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER)      "
        strSql += vbCrLf + "  UNION ALL      "
        strSql += vbCrLf + "  SELECT"
        strSql += vbCrLf + "  'PCS=' + CONVERT(VARCHAR,PCS)      "
        strSql += vbCrLf + "  +' GRSWT=' + CONVERT(VARCHAR,GRSWT)      "
        strSql += vbCrLf + "  +' NETWT=' + CONVERT(VARCHAR,NETWT)      "
        strSql += vbCrLf + "  AS WEIGHTINFO      "
        strSql += vbCrLf + "  ,TRANDATE,BATCHNO,WT_ENTORDER AS ENTRYORDER FROM " & tranDbName & "..RECEIPT I"
        strSql += vbCrLf + "  WHERE EXISTS (SELECT 1 FROM MASTER..TEMPDAYBOOK WHERE TRANDATE = I.TRANDATE AND BATCHNO = I.BATCHNO AND ENTRYORDER = I.WT_ENTORDER)      "
        strSql += vbCrLf + "  UPDATE MASTER..TEMPDAYBOOK SET PARTICULAR = PARTICULAR + CHAR(13) + W.WEIGHTINFO      "
        strSql += vbCrLf + "  FROM MASTER..TEMPDAYBOOK AS B,MASTER..TEMPWEIGHTINFO AS W      "
        strSql += vbCrLf + "  WHERE B.TRANDATE = W.TRANDATE AND B.BATCHNO = W.BATCHNO AND B.ENTRYORDER = W.ENTRYORDER      "

        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET TMP = CREDIT     "
        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET CREDIT = DEBIT    "
        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET DEBIT = TMP    "

        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET TMP = JCREDIT     "
        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET JCREDIT = JDEBIT    "
        strSql += vbCrLf + "  --UPDATE MASTER..TEMPDAYBOOK SET JDEBIT = TMP "
        strSql += vbCrLf + "  SELECT * FROM MASTER..TEMPDAYBOOK ORDER BY TRANDATE,TDATE DESC ,RESULT,TRANNO,PARTICULAR    "
        strSql += vbCrLf + "  END /* sp_daybook end */ "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP22_ReceiptPayment()
        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_REPPAYSUMMARY')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_REPPAYSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE [SP_RPT_REPPAYSUMMARY]    "
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @DATEFROM  VARCHAR(12)"
        strSql += vbCrLf + " ,@DATETO  VARCHAR(12)"
        strSql += vbCrLf + " ,@TYPEID NVARCHAR(1000) /** OTHER RECEIPT,OTHER PAYMENT*/  "
        strSql += vbCrLf + " ,@COSTNAME NVARCHAR(500)/**CHENNAI,AVINASHI**/"
        strSql += vbCrLf + " ,@NODEID NVARCHAR(100)/**001**/"
        strSql += vbCrLf + " ,@SYSTEMID NVARCHAR(20)/* --GIVE THE SYSTEMID FOR TEMPORARY TABLES */    "
        strSql += vbCrLf + " ,@COMPANYID NVARCHAR(500)/* GIVE THE COMPANYID*/    "
        strSql += vbCrLf + " ) AS    "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY"
        strSql += vbCrLf + " CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))"
        strSql += vbCrLf + " DECLARE @TCOMPANY VARCHAR(50)"
        strSql += vbCrLf + " IF CHARINDEX(',',@COMPANYID)=0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + "    WHILE CHARINDEX(',',@COMPANYID)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)"
        strSql += vbCrLf + " 	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))"
        strSql += vbCrLf + " 	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 		SET @COMPANYID= @COMPANYID + ','"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY"
        strSql += vbCrLf + " 	END"

        strSql += vbCrLf + "  /* COST NAME FILTTER */  "
        strSql += vbCrLf + "  SET NOCOUNT ON  "
        strSql += vbCrLf + "  CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))  "
        strSql += vbCrLf + " IF (SELECT COUNT(COSTID) FROM " & compId & "ADMINDB..COSTCENTRE) > 0   "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 	DECLARE @TEMPID VARCHAR(15)  "
        strSql += vbCrLf + " 	IF CHARINDEX(',',@COSTNAME)=0  		"
        strSql += vbCrLf + " 		INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME   "
        strSql += vbCrLf + " 	    WHILE CHARINDEX(',',@COSTNAME)>0  "
        strSql += vbCrLf + " 		BEGIN  "
        strSql += vbCrLf + " 		SET @TEMPID=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)  "
        strSql += vbCrLf + " 		SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))  "
        strSql += vbCrLf + " 		IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0  "
        strSql += vbCrLf + " 			SET @COSTNAME= @COSTNAME + ','  "
        strSql += vbCrLf + " 		INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMPID  "
        strSql += vbCrLf + " 		END  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 	INSERT INTO #COSTCENTRE (COSTID) SELECT ''  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "  /* COST PAYMENT AND RECEIPT TYPE FILTTER */  "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "   CREATE TABLE #TYPE (TYPEID VARCHAR(100))"
        strSql += vbCrLf + "   DECLARE @TEMPID1 VARCHAR(1000)"
        strSql += vbCrLf + "   IF CHARINDEX(',',@TYPEID)=0"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   INSERT INTO #TYPE (TYPEID) SELECT @TYPEID"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@TYPEID)>0"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SET @TEMPID1=LEFT(@TYPEID,CHARINDEX(',',@TYPEID)-1)"
        strSql += vbCrLf + "   SET @TYPEID=RIGHT(@TYPEID,LEN(@TYPEID)-CHARINDEX(',',@TYPEID))"
        strSql += vbCrLf + "   IF @TYPEID <>'' AND CHARINDEX(',',@TYPEID)=0"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SET @TYPEID= @TYPEID + ','"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   INSERT INTO #TYPE (TYPEID) SELECT @TEMPID1     "
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "  /* SYSTEMID FILTTER */  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " CREATE TABLE #NODENAME (NODEID VARCHAR(10))  "
        strSql += vbCrLf + " IF @NODEID = ''  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + "  INSERT INTO #NODENAME (NODEID) SELECT DISTINCT SYSTEMID FROM " & compId & "ADMINDB..OUTSTANDING  "
        strSql += vbCrLf + " END  "
        strSql += vbCrLf + " ELSE  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + "  DECLARE @TEMPID2 VARCHAR(10)  "
        strSql += vbCrLf + "  IF CHARINDEX(',',@NODEID)=0  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  INSERT INTO #NODENAME (NODEID) SELECT @NODEID  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  WHILE CHARINDEX(',',@NODEID)>0  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  SET @TEMPID2=LEFT(@NODEID,CHARINDEX(',',@NODEID)-1)  "
        strSql += vbCrLf + "  SET @NODEID=RIGHT(@NODEID,LEN(@NODEID)-CHARINDEX(',',@NODEID))  "
        strSql += vbCrLf + "  IF @NODEID <>'' AND CHARINDEX(',',@NODEID)=0  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  SET @NODEID= @NODEID + ','  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  INSERT INTO #NODENAME (NODEID) SELECT @TEMPID2  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @RPTSEP VARCHAR(10) "
        strSql += vbCrLf + " SET @RPTSEP='' "
        strSql += vbCrLf + " SELECT @RPTSEP= ISNULL(CTLTEXT,'') FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='RPT_REPPAYSUMMARY_RUNNOSEP' "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "  SELECT XD.*,PNAME AS CUSTNAME,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,STATE,COUNTRY,PHONERES AS PHONE,MOBILE INTO #RECPAY FROM   "
        strSql += vbCrLf + "  (SELECT TITLE,CONVERT(VARCHAR(35),SUBSTRING(RUNNO,6,3)+ @RPTSEP + SUBSTRING(RUNNO,9,20))RUNNO,TRANNO,TRANDATE,SUM(AMOUNT)AMOUNT,SUM(GRSWT)WEIGHT,  "
        strSql += vbCrLf + "  SUM(CASH)CASH,SUM(CCARD)CCARD,SUM(CHEQUE)CHEQUE,SUM(PURCHASE)PURCHASE,SUM(SRETURN)SRETURN,SUM(ADVADJ)ADVADJ,SUM(SCHEME)SCHEME,  "
        strSql += vbCrLf + "  SUM(DISCOUNT)DISCOUNT,BATCHNO,PSNO,  "
        strSql += vbCrLf + "  EMPNAME,SYSTEMID,COSTID,COSTNAME,RESULT,COLHEAD,REMARK,DUEDAYS   "
        strSql += vbCrLf + "  FROM  "
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + " 	 SELECT   "
        strSql += vbCrLf + " 	 CASE WHEN RECPAY = 'R' THEN  "
        strSql += vbCrLf + " 	  CASE WHEN TRANTYPE = 'D' THEN 'CREDIT ADJ'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'T' THEN 'OTHER RECEIPTS'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'O' AND ISNULL(FLAG,'') = 'F' THEN 'FURTHER ADVANCE'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'O' AND ISNULL(FLAG,'') = '' THEN 'ORDER ADVANCE'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'R' AND ISNULL(FLAG,'') = '' THEN 'REPAIR ADVANCE'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' THEN 'CUSTOMER ADVANCE' WHEN TRANTYPE = 'GV' THEN 'GIFT VOUCHER RECEIPT'  ELSE TRANTYPE END   "
        strSql += vbCrLf + " 	 WHEN RECPAY = 'P' THEN  "
        strSql += vbCrLf + " 	  CASE WHEN TRANTYPE = 'D' THEN 'CREDIT SALES'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'T' THEN 'OTHER PAYMENT'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'O' AND ISNULL(FLAG,'') = '' THEN 'ORDER DELIVERY'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'R' AND ISNULL(FLAG,'') = '' THEN 'REPAIR DELIVERY'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' AND SUBSTRING(RUNNO,6,1) = 'O' AND ISNULL(FLAG,'') = 'F' THEN 'ORDER REPAY'  "
        strSql += vbCrLf + " 	    WHEN TRANTYPE = 'A' THEN 'ADVANCE REPAY' WHEN TRANTYPE = 'GV' THEN 'GIFT VOUCHER PAYMENT' ELSE TRANTYPE END   "
        strSql += vbCrLf + " 	 ELSE RECPAY END AS TITLE  "
        strSql += vbCrLf + " 	,CONVERT (VARCHAR(35),RUNNO)RUNNO,TRANNO,O.TRANDATE,AMOUNT"
        strSql += vbCrLf + " 	/*,GRSWT*/"
        strSql += vbCrLf + " 	,(SELECT SUM(T.GRSWT) AS GWT FROM  " & cnAdminDb & "..ITEMTAG T WHERE T.BATCHNO= O.BATCHNO AND O.TRANTYPE IN('A','C') AND ISNULL(O.CANCEL,'')<>'Y'  AND "
        strSql += vbCrLf + " 	ISNULL(O.TRANDATE,'1900-01-01')  BETWEEN @DATEFROM AND @DATETO AND T.APPROVAL ='R' AND ISNULL(T.ISSDATE,'') = '') GRSWT"
        strSql += vbCrLf + " 	,BATCHNO,TRANTYPE,RECPAY,FLAG  "
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT  FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE='CA') END AS CASH"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT  FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE='CH') END AS CCARD"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT  FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE='CC') END AS CHEQUE"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT  FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE='PU') END AS PURCHASE"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE in ('SR','RV')) END AS SRETURN"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE in ('AA')) END AS ADVADJ"
        strSql += vbCrLf + "    ,CASE WHEN RECPAY='R' THEN (SELECT ISNULL(SUM(AMOUNT),0)AMOUNT FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE in ('CB','CZ','CG','CD','SS')) END AS SCHEME"
        strSql += vbCrLf + "    ,(SELECT TOP 1 AMOUNT FROM " & cnStockDb & "..ACCTRAN WHERE BATCHNO = O.BATCHNO And PAYMODE='DI') AS DISCOUNT"
        strSql += vbCrLf + " 	,(SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO) AS PSNO,  "
        strSql += vbCrLf + " 	 CONVERT(VARCHAR(200),ISNULL((SELECT EMPNAME FROM " & compId & "ADMINDB..EMPMASTER WHERE EMPID = O.EMPID  "
        strSql += vbCrLf + " 	 AND O.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)),'')+ ' ('+ CONVERT(VARCHAR(10),EMPID)+')') EMPNAME,O.SYSTEMID,O.COSTID,  "
        strSql += vbCrLf + " 	 (SELECT COSTNAME FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTID = O.COSTID) AS COSTNAME,  "
        strSql += vbCrLf + " 	 1 RESULT,CONVERT (VARCHAR(1),NULL)COLHEAD,CONVERT(VARCHAR(200),ISNULL(REMARK1,'') + ' ' + ISNULL(REMARK2,'')) AS REMARK"
        strSql += vbCrLf + " 	 ,DATEDIFF(DAY,O.TRANDATE,O.DUEDATE) AS DUEDAYS   "
        strSql += vbCrLf + " 	 FROM " & compId & "ADMINDB..OUTSTANDING AS O WHERE TRANDATE BETWEEN @DATEFROM And @DATETO   "
        strSql += vbCrLf + " 	 And COMPANYID IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + " 	 And COSTID IN (SELECT COSTID FROM #COSTCENTRE)  And ISNULL(CANCEL,'') = '' AND ISNULL(FROMFLAG,'') NOT IN ('S','A')  "
        strSql += vbCrLf + " 	 )X "
        strSql += vbCrLf + " 	 GROUP BY RUNNO,TRANNO,TRANDATE,BATCHNO,PSNO,TITLE,EMPNAME,SYSTEMID,COSTID,COSTNAME,RESULT,COLHEAD,REMARK,DUEDAYS"
        strSql += vbCrLf + "  ) XD  "
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO P ON P.SNO = PSNO WHERE  "
        strSql += vbCrLf + " XD.TITLE IN (SELECT TYPEID FROM #TYPE) AND XD.SYSTEMID IN (SELECT NODEID FROM #NODENAME)  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM #RECPAY)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	INSERT INTO #RECPAY(TITLE,RUNNO,  "
        strSql += vbCrLf + " 	RESULT,COLHEAD,EMPNAME)  "
        strSql += vbCrLf + " 	SELECT DISTINCT TITLE,TITLE,0 RESULT,'T','' FROM #RECPAY     "
        strSql += vbCrLf + " 	"
        strSql += vbCrLf + " 	INSERT INTO #RECPAY(TITLE,RUNNO,AMOUNT,WEIGHT,DISCOUNT,  "
        strSql += vbCrLf + " 	CASH,CCARD,CHEQUE,PURCHASE,SRETURN,ADVADJ,SCHEME,  "
        strSql += vbCrLf + " 	RESULT,COLHEAD,EMPNAME)  "
        strSql += vbCrLf + " 	SELECT TITLE,'SUB TOTAL' AS RUNNO,  "
        strSql += vbCrLf + " 	SUM(ISNULL(AMOUNT,0))AMOUNT,SUM(ISNULL(WEIGHT,0))WEIGHT,  "
        strSql += vbCrLf + " 	SUM(ISNULL(DISCOUNT,0))DISCOUNT,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CASH,0)),0)CASH,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CCARD,0)),0)CCARD,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CHEQUE,0)),0)CHEQUE,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(PURCHASE,0)),0)PURCHASE,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(SRETURN,0)),0)SRETURN,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(ADVADJ,0)),0)ADVADJ,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(SCHEME,0)),0)SCHEME,  "
        strSql += vbCrLf + " 	2 RESULT,'S','' FROM #RECPAY GROUP BY TITLE   "
        strSql += vbCrLf + " 	"
        strSql += vbCrLf + " 	INSERT INTO #RECPAY(TITLE,RUNNO,AMOUNT,WEIGHT,DISCOUNT,"
        strSql += vbCrLf + " 	CASH,CCARD,CHEQUE,PURCHASE,SRETURN,ADVADJ,SCHEME,  "
        strSql += vbCrLf + " 	RESULT,COLHEAD,EMPNAME)  "
        strSql += vbCrLf + " 	SELECT 'ZZZZ','GRAND TOTAL'AS RUNNO,   "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(AMOUNT,0)),0)AMOUNT,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(WEIGHT,0)),0)WEIGHT,ISNULL(SUM(ISNULL(DISCOUNT,0)),0)DISCOUNT,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CASH,0)),0)CASH,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CCARD,0)),0)CCARD,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(CHEQUE,0)),0)CHEQUE,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(PURCHASE,0)),0)PURCHASE,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(SRETURN,0)),0)SRETURN,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(ADVADJ,0)),0)ADVADJ,  "
        strSql += vbCrLf + " 	ISNULL(SUM(ISNULL(SCHEME,0)),0)SCHEME,  "
        strSql += vbCrLf + " 	3 RESULT,'G',''  "
        strSql += vbCrLf + " 	FROM #RECPAY WHERE RESULT = 1  "
        strSql += vbCrLf + " 	"
        strSql += vbCrLf + " 	UPDATE #RECPAY SET AMOUNT = NULL WHERE ISNULL(AMOUNT,0) = 0  "
        strSql += vbCrLf + " 	UPDATE #RECPAY SET WEIGHT = NULL WHERE ISNULL(WEIGHT,0) = 0  "
        strSql += vbCrLf + "    UPDATE #RECPAY SET DISCOUNT = NULL WHERE ISNULL(DISCOUNT,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET CASH = NULL WHERE ISNULL(CASH,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET CCARD = NULL WHERE ISNULL(CCARD,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET CHEQUE = NULL WHERE ISNULL(CHEQUE,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET PURCHASE = NULL WHERE ISNULL(PURCHASE,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET SRETURN = NULL WHERE ISNULL(SRETURN,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET ADVADJ = NULL WHERE ISNULL(ADVADJ,0) = 0 "
        strSql += vbCrLf + "    UPDATE #RECPAY SET SCHEME = NULL WHERE ISNULL(SCHEME,0) = 0 "
        strSql += vbCrLf + " 	END    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)    "
        strSql += vbCrLf + "  SELECT @STRQRY=''"
        strSql += vbCrLf + "  SELECT @STRQRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'FINAL'') > 0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'FINAL'  "
        strSql += vbCrLf + "  SELECT @STRQRY= @STRQRY + ' SELECT * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'FINAL FROM #RECPAY'  "
        strSql += vbCrLf + "  EXEC (@STRQRY)   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   SELECT @STRQRY='UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'FINAL  SET  EMPNAME=NULL WHERE  RESULT=''1'' AND EMPNAME ='' (0)'' '"
        strSql += vbCrLf + "  EXEC (@STRQRY)  "
        strSql += vbCrLf + " END  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP21_CashAbstract()

        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CASHABSTRACT')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_CASHABSTRACT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_CASHABSTRACT  "
        strSql += vbCrLf + " (     "
        strSql += vbCrLf + " @FRMDATE SMALLDATETIME     "
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME     "
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(1500)     "
        strSql += vbCrLf + " ,@SYSTEMID VARCHAR(3)     "
        strSql += vbCrLf + " ,@NODEID VARCHAR(3)     "
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(500)     "
        strSql += vbCrLf + " ,@CASHOPENING VARCHAR(1)    "
        strSql += vbCrLf + " ,@CHITDBEXSISTS VARCHAR(1)      "
        strSql += vbCrLf + " )     "
        strSql += vbCrLf + " AS     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " SET NOCOUNT ON   "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY   "
        strSql += vbCrLf + " CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))   "
        strSql += vbCrLf + " DECLARE @TCOMPANY VARCHAR(50)   "
        strSql += vbCrLf + " IF CHARINDEX(',',@COMPANYID)=0   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID   "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COMPANYID)>0   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)   "
        strSql += vbCrLf + " SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))   "
        strSql += vbCrLf + " IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " SET @COMPANYID= @COMPANYID + ','   "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY   "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " CREATE TABLE #SYSTEMID (SYSTEMID VARCHAR(3))   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))   "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..COSTCENTRE)>0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " DECLARE @TEMPNAME VARCHAR(20)     "
        strSql += vbCrLf + " IF CHARINDEX(',',@COSTNAME)=0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME   "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COSTNAME)>0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)     "
        strSql += vbCrLf + " SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))     "
        strSql += vbCrLf + " IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " SET @COSTNAME= @COSTNAME + ','     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMPNAME     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " ELSE     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..COSTCENTRE) = (SELECT COUNT(*) FROM #COSTCENTRE)      "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @NODEID <> ''   "
        strSql += vbCrLf + " INSERT INTO #SYSTEMID(SYSTEMID) SELECT @NODEID   "
        strSql += vbCrLf + " ELSE   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " INSERT INTO #SYSTEMID(SYSTEMID)   "
        strSql += vbCrLf + " SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..ISSUE     "
        strSql += vbCrLf + " UNION   "
        strSql += vbCrLf + " SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..RECEIPT     "
        strSql += vbCrLf + " UNION   "
        strSql += vbCrLf + " SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..ACCTRAN     "
        strSql += vbCrLf + " UNION   "
        strSql += vbCrLf + " SELECT DISTINCT SYSTEMID FROM " & compId & "ADMINDB..OUTSTANDING     "
        strSql += vbCrLf + " UNION"
        strSql += vbCrLf + " SELECT ''      "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ACCTRAN') IS NOT NULL DROP TABLE #ACCTRAN    "
        strSql += vbCrLf + " SELECT * INTO #ACCTRAN FROM ACCTRAN    "
        strSql += vbCrLf + " WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)       "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + " AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
        strSql += vbCrLf + " AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEMID)    "
        strSql += vbCrLf + " AND FROMFLAG NOT IN ('','S','O','A')    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#OUTSTANDING') IS NOT NULL DROP TABLE #OUTSTANDING  "
        strSql += vbCrLf + " SELECT * INTO #OUTSTANDING FROM OUTSTANDING  "
        strSql += vbCrLf + " WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)       "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + " AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
        strSql += vbCrLf + " AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEMID)    "
        strSql += vbCrLf + " AND FROMFLAG NOT IN ('','S','O','A')    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @CHITDBEXSISTS = 'N'      "
        strSql += vbCrLf + " DELETE FROM #ACCTRAN WHERE FROMFLAG = 'C'    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPBILLSUM_RE')>0 DROP TABLE MASTER..TEMPBILLSUM_RE     "
        strSql += vbCrLf + " SELECT     "
        strSql += vbCrLf + " (SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS CATNAME     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID))AS PARTICULAR     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID))AS ITEM     "
        strSql += vbCrLf + " ,PCS,GRSWT,NETWT,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')),0)AS AMOUNT     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)DIFFRATE     "
        strSql += vbCrLf + " ,TAX     "
        strSql += vbCrLf + " ,ITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(15),SNO)SNO     "
        strSql += vbCrLf + " INTO MASTER..TEMPBILLSUM_RE     "
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS I      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE IN ('RD') AND ISNULL(CANCEL,'') = '' AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)     "
        strSql += vbCrLf + " AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPBILLSUM_SA')>0 DROP TABLE MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " SELECT     "
        strSql += vbCrLf + " (SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS CATNAME     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID))AS PARTICULAR     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID))AS ITEM     "
        strSql += vbCrLf + " ,PCS,GRSWT,NETWT,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')),0)AS AMOUNT     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)DIFFRATE     "
        strSql += vbCrLf + " ,TAX     "
        strSql += vbCrLf + " ,ITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED     "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(15),SNO)SNO     "
        strSql += vbCrLf + " INTO MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS I      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE IN ('SA','OD') AND ISNULL(CANCEL,'') = '' AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)     "
        strSql += vbCrLf + " AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPBILLSUM_SA(CATNAME,ITEM,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,STUDDED)     "
        strSql += vbCrLf + " SELECT I.CATNAME     "
        strSql += vbCrLf + " ,I.ITEM      "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),' ' + (SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = T.STNITEMID))AS PARTICULAR     "
        strSql += vbCrLf + " ,SUM(STNPCS),SUM(STNWT),SUM(STNWT),SUM(STNAMT),1 RESULT,'Y'STUDDED     "
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSSTONE AS T,MASTER..TEMPBILLSUM_SA AS I WHERE I.SNO = T.ISSSNO        AND T.STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')     "
        strSql += vbCrLf + " GROUP BY CATNAME,STNITEMID,ITEM     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMPBILLSUM_SA SET AVGRATE = (SELECT AVG(BOARDRATE) FROM MASTER..TEMPBILLSUM_SA WHERE CATNAME = T.CATNAME)     "
        strSql += vbCrLf + " FROM MASTER..TEMPBILLSUM_SA T   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPBILLSUM_PU')>0 DROP TABLE MASTER..TEMPBILLSUM_PU     "
        strSql += vbCrLf + " SELECT     "
        strSql += vbCrLf + " (SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS CATNAME     "
        strSql += vbCrLf + " ,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS PARTICULAR     "
        strSql += vbCrLf + " ,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
        strSql += vbCrLf + " ,SUM(TAX) TAX      "
        strSql += vbCrLf + " INTO MASTER..TEMPBILLSUM_PU     "
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS I      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = ('PU') AND ISNULL(CANCEL,'') = ''     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " GROUP BY CATCODE HAVING SUM(GRSWT) <> 0 AND SUM(AMOUNT)<>0     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPBILLSUM_SR')>0 DROP TABLE MASTER..TEMPBILLSUM_SR     "
        strSql += vbCrLf + " SELECT     "
        strSql += vbCrLf + " (SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS CATNAME     "
        strSql += vbCrLf + " ,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE) AS PARTICULAR     "
        strSql += vbCrLf + " ,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
        strSql += vbCrLf + " ,SUM(TAX) TAX      "
        strSql += vbCrLf + " INTO MASTER..TEMPBILLSUM_SR     "
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS I      "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = 'SR' AND ISNULL(CANCEL,'') = ''     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " GROUP BY CATCODE HAVING SUM(GRSWT) <> 0 AND SUM(AMOUNT)<>0     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /** TRANSACTION DESCRIPTION **/     "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCASHSUM_M')>0 DROP TABLE MASTER..TEMPCASHSUM_M     "
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMPCASHSUM     "
        strSql += vbCrLf + " (     "
        strSql += vbCrLf + " PARTICULAR VARCHAR(250),PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3)     "
        strSql += vbCrLf + " ,AMOUNT NUMERIC(15,2),SALRATE NUMERIC(15,2),DIFFRATE NUMERIC(15,2),AVGRATE NUMERIC(15,2),RESULT INT,STUDDED VARCHAR(1)     "
        strSql += vbCrLf + " ,CATNAME VARCHAR(250),ITEM VARCHAR(100),DISPORDER NUMERIC(15,2),COLHEAD VARCHAR(1)     "
        strSql += vbCrLf + " )     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SA)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " /** CATEGORY TITLE **/     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(PARTICULAR,COLHEAD)SELECT 'SALES','T'     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,SALRATE,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT DISTINCT CATNAME,CATNAME,AVGRATE,0 RESULT,'T' FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " /** CATEGORY,ITEM WISE TRANSACTION **/     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,SALRATE,AVGRATE,DIFFRATE,STUDDED,RESULT)     "
        strSql += vbCrLf + " SELECT CATNAME,PARTICULAR,ITEM,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT)     "
        strSql += vbCrLf + " ,CASE WHEN SUM(GRSWT) <> 0 THEN SUM(AMOUNT)/SUM(GRSWT) ELSE 0 END AS SALRATE     "
        strSql += vbCrLf + " ,AVGRATE     "
        strSql += vbCrLf + " ,CASE WHEN SUM(GRSWT) <> 0 THEN (SUM(AMOUNT)/SUM(GRSWT))-AVGRATE ELSE 0 END     "
        strSql += vbCrLf + " ,STUDDED,RESULT FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " GROUP BY CATNAME,ITEM,AVGRATE,STUDDED,PARTICULAR,RESULT     "
        strSql += vbCrLf + " /** SUBTOTAL **/     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)  "
        strSql += vbCrLf + " SELECT CATNAME,'SUB TOTAL','ZZZ',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2 RESULT,'S'COLHEAD FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " WHERE ISNULL(STUDDED,'') = '' GROUP BY CATNAME      "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT CATNAME,'DIAMOND','ZZZ',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),3 RESULT,'S'COLHEAD FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " WHERE ISNULL(STUDDED,'') = 'Y' GROUP BY CATNAME      "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT CATNAME,'TOTAL TAX','ZZZZ',SUM(TAX),4 RESULT,'S'COLHEAD FROM MASTER..TEMPBILLSUM_SA GROUP BY CATNAME     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(CATNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT CATNAME,'TOTAL ','ZZZZZ',SUM(AMOUNT+ISNULL(TAX,0)),5 RESULT,'S'COLHEAD FROM MASTER..TEMPBILLSUM_SA GROUP BY CATNAME     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_RE)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,COLHEAD)SELECT 1.1 DISPORDER,'REPAIR DEL','T'COLHEAD "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
        strSql += vbCrLf + " SELECT 1.1 DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,1 FROM MASTER..TEMPBILLSUM_RE  "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT 1.1 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM MASTER..TEMPBILLSUM_RE  "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_PU)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,COLHEAD)SELECT 2 DISPORDER,'PURCHASE','T'COLHEAD "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
        strSql += vbCrLf + " SELECT 2 DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,1 FROM MASTER..TEMPBILLSUM_PU     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT 2 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM MASTER..TEMPBILLSUM_PU     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SR)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,COLHEAD)SELECT 3 DISPORDER,'RETURN','T'COLHEAD     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
        strSql += vbCrLf + " SELECT 3 DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,1 FROM MASTER..TEMPBILLSUM_SR     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,CATNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
        strSql += vbCrLf + " SELECT 3 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM MASTER..TEMPBILLSUM_SR     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /**PARTLY SALES **/      "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPPARTLYSALES')>0 DROP TABLE MASTER..TEMPPARTLYSALES      "
        strSql += vbCrLf + " SELECT CA.CATNAME,SUM(ISNULL(TAGPCS,0) - ISNULL(I.PCS,0))PCS,SUM(ISNULL(TAGGRSWT,0) - ISNULL(I.GRSWT,0))GRSWT,SUM(ISNULL(TAGNETWT,0) - ISNULL(I.NETWT,0)) NETWT      "
        strSql += vbCrLf + " INTO MASTER..TEMPPARTLYSALES      "
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS I"
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..CATEGORY AS CA ON CA.CATCODE = I.CATCODE      "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(I.CANCEL,'') = ''"
        strSql += vbCrLf + " AND I.TAGNO <> '' AND I.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE STOCKTYPE = 'T')    "
        strSql += vbCrLf + " AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " GROUP BY CA.CATNAME"
        strSql += vbCrLf + " HAVING SUM(ISNULL(TAGPCS,0) - ISNULL(I.PCS,0))<> 0 OR SUM(ISNULL(TAGGRSWT,0) - ISNULL(I.GRSWT,0))<> 0"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPPARTLYSALES)>0      "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " UPDATE MASTER..TEMPPARTLYSALES SET PCS = CASE WHEN PCS = 0 THEN NULL ELSE PCS END      "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,COLHEAD)      "
        strSql += vbCrLf + " SELECT 3.1 DISPORDER,'PARTLY SALES','T'COLHEAD"
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,PCS,GRSWT,NETWT)      "
        strSql += vbCrLf + " SELECT 3.2 DISPORDER,CATNAME,PCS,GRSWT,NETWT      "
        strSql += vbCrLf + " FROM MASTER..TEMPPARTLYSALES      "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /** CHIT COLLECTION **/      "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#CHITCOLLECTION') IS NOT NULL DROP TABLE #CHITCOLLECTION   "
        strSql += vbCrLf + " CREATE TABLE #CHITCOLLECTION(AMOUNT NUMERIC(15,2))      "
        strSql += vbCrLf + " IF @CHITDBEXSISTS = 'Y'"
        strSql += vbCrLf + " BEGIN      "
        strSql += vbCrLf + " DECLARE @CHITDB VARCHAR(10)      "
        strSql += vbCrLf + " DECLARE @CHITMAINDB VARCHAR(15)      "
        strSql += vbCrLf + " SELECT @CHITDB = ISNULL(CTLTEXT,'') + 'SH0708',@CHITMAINDB = ISNULL(CTLTEXT,'') + 'SAVINGS' FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'      "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..SYSDATABASES WHERE NAME = @CHITDB)>0      "
        strSql += vbCrLf + " BEGIN      "
        strSql += vbCrLf + " DECLARE @STR VARCHAR(8000)      "
        strSql += vbCrLf + " SELECT @STR = ''      "
        strSql += vbCrLf + " SET @STR = @STR + ' INSERT INTO #CHITCOLLECTION(AMOUNT)'      "
        strSql += vbCrLf + " SET @STR = @STR + ' SELECT SUM(AMOUNT)AMOUNT FROM '+@CHITDB+'..SCHEMECOLLECT T'      "
        strSql += vbCrLf + " SET @STR = @STR + ' WHERE RDATE BETWEEN '''+CONVERT(VARCHAR,@FRMDATE)+''' AND '''+CONVERT(vARCHAR,@TODATE)+''' '      "
        strSql += vbCrLf + " SET @STR = @STR + ' AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'      "
        strSql += vbCrLf + " SET @STR = @STR + ' AND EXISTS (SELECT 1 FROM '+@CHITDB+'..SCHEMECOLLECT AS SC WHERE EXISTS (SELECT 1 FROM '+@CHITMAINDB+'..SCHEMEMAST WHERE GROUPCODE = SC.GROUPCODE AND REGNO = SC.REGNO AND COMPANYID IN (SELECT COMPANYID FROM '+@CHITMAINDB+'..COMPANY  "
        strSql += vbCrLf + " WHERE JCOMPID IN (SELECT COMPANYID FROM #COMPANY)))AND T.GROUPCODE = SC.GROUPCODE AND T.REGNO = SC.REGNO)'      "
        strSql += vbCrLf + " EXEC (@STR)      "
        strSql += vbCrLf + " END      "
        strSql += vbCrLf + " END      "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /** CASH ABSTRACT **/       "
        strSql += vbCrLf + " IF @CASHOPENING = 'Y'   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " /** Cash Opening **/   "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCASHOPEN')>0 DROP TABLE MASTER..TEMPCASHOPEN       "
        strSql += vbCrLf + " DECLARE @CASHID VARCHAR(7)   "
        strSql += vbCrLf + " SELECT @CASHID = CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CASH'   "
        strSql += vbCrLf + " SELECT 'CASH OPENING..'AS PARTICULAR,SUM(AMOUNT)AMOUNT,0 RESULT,'R'RECPAY   "
        strSql += vbCrLf + " INTO MASTER..TEMPCASHOPEN   "
        strSql += vbCrLf + " FROM   "
        strSql += vbCrLf + " (   "
        strSql += vbCrLf + " SELECT DEBIT-CREDIT AMOUNT FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE = @CASHID   "
        strSql += vbCrLf + " AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)       "
        strSql += vbCrLf + " AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
        strSql += vbCrLf + " UNION ALL   "
        strSql += vbCrLf + " SELECT SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AS AMOUNT   "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE < @FRMDATE AND ACCODE = @CASHID   "
        strSql += vbCrLf + " )X /** Cash Opening **/   "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCASHABS')>0 DROP TABLE MASTER..TEMPCASHABS     "
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMPCASHABS(PARTICULAR VARCHAR(100),AMOUNT NUMERIC(15,2),RESULT INT,RECPAY VARCHAR(1))     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SA)>0        "
        strSql += vbCrLf + " IF @CASHOPENING = 'Y'   "
        strSql += vbCrLf + " BEGIN   "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)    "
        strSql += vbCrLf + " SELECT PARTICULAR,AMOUNT,RESULT,RECPAY FROM MASTER..TEMPCASHOPEN      "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SA)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ SA] SALES',SUM(AMOUNT),1 RESULT,'R' FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ SA] SALES TAX',SUM(TAX),2 RESULT,'R' FROM MASTER..TEMPBILLSUM_SA     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SA)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ RE] REPAIR',SUM(AMOUNT),2.1 RESULT,'R' FROM MASTER..TEMPBILLSUM_RE "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_SR)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ SR] RETURN',SUM(AMOUNT),3 RESULT,'P' FROM MASTER..TEMPBILLSUM_SR     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ SR] RETURN TAX',SUM(TAX),4 RESULT,'P' FROM MASTER..TEMPBILLSUM_SR HAVING SUM(TAX) <> 0     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPBILLSUM_PU)>0      "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ PU] PURCHASE',SUM(AMOUNT),5 RESULT,'P' FROM MASTER..TEMPBILLSUM_PU     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[ PV] PURCHASE TAX',SUM(TAX),6 RESULT,'R' FROM MASTER..TEMPBILLSUM_PU HAVING SUM(TAX) <> 0     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
        strSql += vbCrLf + " SELECT '[REC] ADVANCE RECEIPT'PARTICULAR,SUM(AMOUNT) AMOUNT,7 RESULT,'R'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
        strSql += vbCrLf + " AND TRANTYPE = 'A' AND RECPAY = 'R' AND ISNULL(FROMFLAG,'') NOT IN ('A','O') "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0      "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[PAY] ADVANCE PAYMENT',SUM(AMOUNT) AMOUNT,8,'P'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
        strSql += vbCrLf + " AND TRANTYPE = 'A' AND RECPAY = 'P' AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[REC] CREDIT RECEIPT',SUM(AMOUNT) AMOUNT,9,'R'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
        strSql += vbCrLf + " AND TRANTYPE = 'D' AND RECPAY = 'R'  "
        strSql += vbCrLf + " AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[PAY] CREDIT PAYMENT',SUM(AMOUNT) AMOUNT,10,'P'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
        strSql += vbCrLf + " AND TRANTYPE = 'D' AND RECPAY = 'P'  AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[PAY] SCHEME PAYMENT',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,11,'P'RECPAY     "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE IN ('HP','HG','HZ','HB','HD') "
        strSql += vbCrLf + " AND ISNULL(FROMFLAG,'') NOT IN ('A','O')     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[REC] OTHER RECEIPT',SUM(AMOUNT) AMOUNT,12,'R'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE   "
        strSql += vbCrLf + " AND TRANTYPE = 'T' AND RECPAY = 'R'  AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[PAY] OTHER PAYMENT',SUM(AMOUNT)AMOUNT,13,'P'RECPAY     "
        strSql += vbCrLf + " FROM #OUTSTANDING WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = 'T' AND RECPAY = 'P'     "
        strSql += vbCrLf + " AND ISNULL(FROMFLAG,'') NOT IN ('A','O')     "
        strSql += vbCrLf + " HAVING SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT '[REC] SCHEME COLLECTION',SUM(AMOUNT),14,'R' RECPAY      "
        strSql += vbCrLf + " FROM #CHITCOLLECTION HAVING SUM(AMOUNT) <> 0      "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT '[ HC] HANDLING CHARGES',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT,14,'R' RECPAY     "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'HC'     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " HAVING SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT '[ DI] DISCOUNT',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,14,'-' RECPAY     "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'DI'     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT '[ RO] ROUNDOFF',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,14,'-' RECPAY     "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'RO'     "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + " HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCASHCOLL')>0 DROP TABLE MASTER..TEMPCASHCOLL       "
        strSql += vbCrLf + " SELECT        "
        strSql += vbCrLf + " SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT       "
        strSql += vbCrLf + " INTO MASTER..TEMPCASHCOLL   "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + " AND PAYMODE IN ('CA')   "
        strSql += vbCrLf + " AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
        strSql += vbCrLf + " GROUP BY PAYMODE    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @CASHOPENING = 'Y' INSERT INTO MASTER..TEMPCASHCOLL(AMOUNT) SELECT AMOUNT FROM MASTER..TEMPCASHOPEN   "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPCASHCOLLECTION')>0 DROP TABLE MASTER..TEMPCASHCOLLECTION     "
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMPCASHCOLLECTION(PARTICULAR VARCHAR(100),AMOUNT NUMERIC(15,2),TRANMODE VARCHAR(1),PAYMODE VARCHAR(3))     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHCOLLECTION(PARTICULAR,AMOUNT) SELECT 'CASH',SUM(ISNULL(AMOUNT,0)) FROM MASTER..TEMPCASHCOLL      "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHCOLLECTION(PARTICULAR,AMOUNT)     "
        strSql += vbCrLf + " SELECT      "
        strSql += vbCrLf + " CASE PAYMODE "
        strSql += vbCrLf + " WHEN 'CC' THEN 'CREDITCARD'     "
        strSql += vbCrLf + " WHEN 'CH' THEN 'CHEQUE'     "
        strSql += vbCrLf + " WHEN 'GV' THEN 'GIFTVOUCHER'     "
        strSql += vbCrLf + " ELSE 'SCHEME' END AS PARTICULAR     "
        strSql += vbCrLf + " ,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT     "
        strSql += vbCrLf + " FROM #ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE     "
        strSql += vbCrLf + " AND PAYMODE IN ('CC','CH','SS','CG','CB','CZ','CD','GV')--'AA','DR','AR','MR','DP','AP','MP','OR'     "
        strSql += vbCrLf + " GROUP BY PAYMODE     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPCASHABS)>0 OR (SELECT COUNT(*) FROM MASTER..TEMPCASHCOLLECTION)>0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,COLHEAD)SELECT 4 DISPORDER,'CASH ABSTRACT','T'COLHEAD     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPCASHABS)>0     "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 4,PARTICULAR,AMOUNT,RESULT FROM MASTER..TEMPCASHABS     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)SELECT 4,'TOTAL SA-SR+REC-PAY-PU+PV-DI+HC-RO',SUM(CASE WHEN RECPAY = 'R' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT,15 RESULT,'G'COLHEAD FROM MASTER..TEMPCASHABS   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPCASHCOLLECTION)>0     "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 5,PARTICULAR,SUM(AMOUNT),0 RESULT FROM MASTER..TEMPCASHCOLLECTION GROUP BY PARTICULAR     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPCASHSUM(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)SELECT 5,'TOTAL',SUM(AMOUNT),1 RESULT,'G'COLHEAD FROM MASTER..TEMPCASHCOLLECTION     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(1000)   "
        strSql += vbCrLf + " SELECT @QRY = ' IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CASHSUMMARY'')>0 DROP TABLE MASTER..TEMP'+@SYSTEMID+'CASHSUMMARY'   "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' SELECT * INTO MASTER..TEMP'+@SYSTEMID+'CASHSUMMARY FROM MASTER..TEMPCASHSUM ORDER BY DISPORDER,CATNAME,ITEM,RESULT,STUDDED'   "
        strSql += vbCrLf + " EXEC (@QRY)   "
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP_CashAbstractGroup_new()
        Try
            strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CASHABSTRACTGROUP_NEW')>0"
            strSql += vbCrLf + " DROP PROCEDURE SP_CASHABSTRACTGROUP_NEW"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + "   IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPCOMPANY')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCOMPANY           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_SA')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SA           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_PU')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_PU           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_RE')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_RE           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_SR')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SR           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHSUM_M')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHSUM_M     "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPRATEPER_M')>0 DROP TABLE  TEMPTABLEDB..TEMPRATEPER_M"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = " CREATE PROCEDURE SP_CASHABSTRACTGROUP_NEW"
            strSql += vbCrLf + " ("
            strSql += vbCrLf + " @FRMDATE VARCHAR(15)"
            strSql += vbCrLf + " ,@TODATE VARCHAR(15)"
            strSql += vbCrLf + " ,@COSTNAME VARCHAR(1500)"
            strSql += vbCrLf + " ,@SYSTEMID VARCHAR(3)"
            strSql += vbCrLf + " ,@NODEID VARCHAR(3)"
            strSql += vbCrLf + " ,@COMPANYID VARCHAR(500)"
            strSql += vbCrLf + " ,@CASHOPENING VARCHAR(1)"
            strSql += vbCrLf + " ,@CHITDBEXSISTS VARCHAR(1)"
            strSql += vbCrLf + " ,@SUBITEM VARCHAR(1)"
            strSql += vbCrLf + " ,@PARTLY VARCHAR(1)   "
            strSql += vbCrLf + " )"
            strSql += vbCrLf + " AS"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + " 	SET NOCOUNT ON"
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPCOMPANY' AND XTYPE ='U' ) DROP TABLE  TEMPTABLEDB..TEMPGRPCOMPANY           "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_SA' AND xtype = 'U') DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SA           "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_PU' AND XTYPE = 'U') DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_PU           "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_RE'  AND XTYPE ='U') DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_RE           "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPBILLSUM_SR' AND XTYPE ='U') DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SR           "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHSUM_M' AND XTYPE ='U') DROP TABLE  TEMPTABLEDB..TEMPGRPCASHSUM_M     "
            strSql += vbCrLf + "     IF EXISTS(SELECT * FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPRATEPER_M' AND XTYPE ='U') DROP TABLE  TEMPTABLEDB..TEMPRATEPER_M     "
            strSql += vbCrLf + "     CREATE TABLE  TEMPTABLEDB..TEMPGRPCOMPANY (COMPANYID VARCHAR(3))   "
            strSql += vbCrLf + "     DECLARE @TCOMPANY VARCHAR(50)   "
            strSql += vbCrLf + "     DECLARE @QUERY  VARCHAR(1000) "
            strSql += vbCrLf + "     IF CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCOMPANY (COMPANYID) SELECT @COMPANYID   "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     WHILE CHARINDEX(',',@COMPANYID)>0   "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)   "
            strSql += vbCrLf + "     SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))   "
            strSql += vbCrLf + "     IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SET @COMPANYID= @COMPANYID + ','   "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCOMPANY (COMPANYID) SELECT @TCOMPANY   "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     CREATE TABLE #SYSTEMID (SYSTEMID VARCHAR(3))   "
            strSql += vbCrLf + "     CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))   "
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  " & cnAdminDb & "..COSTCENTRE)>0     "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     DECLARE @TEMPNAME VARCHAR(20)     "
            strSql += vbCrLf + "     IF CHARINDEX(',',@COSTNAME)=0     "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM  " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME   "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     WHILE CHARINDEX(',',@COSTNAME)>0     "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)     "
            strSql += vbCrLf + "     SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))     "
            strSql += vbCrLf + "     IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0     "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SET @COSTNAME= @COSTNAME + ','     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     Else"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  " & cnAdminDb & "..COSTCENTRE) = (SELECT COUNT(*) FROM #COSTCENTRE)      "
            strSql += vbCrLf + "     INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
            strSql += vbCrLf + "     IF @NODEID <> ''   "
            strSql += vbCrLf + "     INSERT INTO #SYSTEMID(SYSTEMID) SELECT @NODEID   "
            strSql += vbCrLf + "     Else"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO #SYSTEMID(SYSTEMID)   "
            strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM ISSUE     "
            strSql += vbCrLf + "     UNION"
            strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM RECEIPT     "
            strSql += vbCrLf + "     UNION"
            strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM ACCTRAN     "
            strSql += vbCrLf + "     UNION"
            strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM " & cnAdminDb & "..OUTSTANDING     "
            strSql += vbCrLf + "     UNION"
            strSql += vbCrLf + "     SELECT ''      "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPACCTRAN ')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPACCTRAN    "
            strSql += vbCrLf + "     SELECT * INTO  TEMPTABLEDB..TEMPGRPACCTRAN   FROM ACCTRAN    "
            strSql += vbCrLf + "     WHERE COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)       "
            strSql += vbCrLf + "     AND ISNULL(CANCEL,'') = ''   "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
            strSql += vbCrLf + "     AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEMID)    "
            strSql += vbCrLf + "     AND FROMFLAG NOT IN ('','S','O','A')    "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPGRPOUTSTANDING')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPOUTSTANDING "
            strSql += vbCrLf + "     SELECT * INTO  TEMPTABLEDB..TEMPGRPOUTSTANDING  FROM " & cnAdminDb & "..OUTSTANDING  "
            strSql += vbCrLf + "     WHERE COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)       "
            strSql += vbCrLf + "     AND ISNULL(CANCEL,'') = ''   "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
            strSql += vbCrLf + "     AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEMID)    "
            strSql += vbCrLf + "     AND FROMFLAG NOT IN ('','S','O','A')    "
            strSql += vbCrLf + "     IF @CHITDBEXSISTS = 'N'      "
            strSql += vbCrLf + "     DELETE FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE FROMFLAG = 'C'    "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPBILLSUM_RE')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_RE     "
            strSql += vbCrLf + "     SELECT     "
            strSql += vbCrLf + "     IG.GROUPNAME "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM  " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID))AS PARTICULAR     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),IM.ITEMNAME)AS ITEM     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT SUBITEMNAME FROM  " & cnAdminDb & "..SUBITEMMAST WHERE ITEMID = I.ITEMID AND SUBITEMID = I.SUBITEMID))AS SUBITEM     "
            strSql += vbCrLf + "     ,PCS,I.GRSWT,NETWT,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM ..ISSSTONE WHERE ISSSNO = I.SNO /*AND STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')*/),0)AS AMOUNT     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)DIFFRATE  "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)RATEPER "
            strSql += vbCrLf + "     ,TAX     "
            strSql += vbCrLf + "     ,I.ITEMID,SUBITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(15),SNO)SNO     "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPBILLSUM_RE     "
            strSql += vbCrLf + "     FROM ISSUE AS I   "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMMAST IM ON IM.ITEMID =I.ITEMID     "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMGROUPMAST IG ON IG.GROUPID =IM.ITEMGROUP      "
            strSql += vbCrLf + "     WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE IN ('RD') AND ISNULL(CANCEL,'') = '' AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)     "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPBILLSUM_SA')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     IF @SUBITEM='N'"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SELECT  IG.GROUPNAME   "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT  ITEMNAME FROM  " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID))AS PARTICULAR     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),IM.ITEMNAME)AS ITEM "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT SUBITEMNAME FROM  " & cnAdminDb & "..SUBITEMMAST WHERE ITEMID = I.ITEMID  AND SUBITEMID = I.SUBITEMID))AS SUBITEM    "
            strSql += vbCrLf + "     ,PCS,I.GRSWT,NETWT,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM ..ISSSTONE WHERE ISSSNO = I.SNO /*AND STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')*/),0)AS AMOUNT"
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)DIFFRATE "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)DIFFNETWT"
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)RATEPER"
            strSql += vbCrLf + "     ,TAX     "
            strSql += vbCrLf + "     ,I.ITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(15),SNO)SNO     "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     FROM ISSUE AS I  "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMMAST IM ON IM.ITEMID =I.ITEMID     "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMGROUPMAST IG ON IG.GROUPID =IM.ITEMGROUP "
            strSql += vbCrLf + "     WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE IN ('SA','OD') AND ISNULL(CANCEL,'') = '' AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)     "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) "
            strSql += vbCrLf + "      END"
            strSql += vbCrLf + "     ELSE IF @SUBITEM='Y'"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     SELECT     "
            strSql += vbCrLf + "     IG.GROUPNAME  "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT SUBITEMNAME FROM  " & cnAdminDb & "..SUBITEMMAST WHERE ITEMID = I.ITEMID  AND SUBITEMID = I.SUBITEMID))AS PARTICULAR     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),IM.ITEMNAME)AS ITEM "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),(SELECT SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE ITEMID = I.ITEMID  AND SUBITEMID = I.SUBITEMID))AS SUBITEM    "
            strSql += vbCrLf + "     ,PCS,I.GRSWT,NETWT,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO /*AND STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')*/),0)AS AMOUNT"
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)DIFFRATE  "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)DIFFNETWT "
            strSql += vbCrLf + "     ,CONVERT(NUMERIC(15,2),NULL)RATEPER    "
            strSql += vbCrLf + "     ,TAX     "
            strSql += vbCrLf + "     ,I.ITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(15),SNO)SNO     "
            strSql += vbCrLf + "     INTO TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     FROM ISSUE AS I   "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMMAST IM ON IM.ITEMID =I.ITEMID     "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMGROUPMAST IG ON IG.GROUPID =IM.ITEMGROUP"
            strSql += vbCrLf + "     WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE IN ('SA','OD') AND ISNULL(CANCEL,'') = '' AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)     "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) "
            strSql += vbCrLf + "     END     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPBILLSUM_SA(GROUPNAME,ITEM,SUBITEM,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,STUDDED)     "
            strSql += vbCrLf + "     SELECT I.GROUPNAME"
            strSql += vbCrLf + "     ,I.ITEM,I.SUBITEM     "
            strSql += vbCrLf + "     ,CONVERT(VARCHAR(200),' ' + (SELECT ITEMNAME FROM  " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.STNITEMID))AS PARTICULAR     "
            strSql += vbCrLf + "     ,SUM(STNPCS),SUM(STNWT),SUM(STNWT),SUM(STNAMT),1 RESULT,'Y'STUDDED     "
            strSql += vbCrLf + "     FROM ISSSTONE AS T, TEMPTABLEDB..TEMPGRPBILLSUM_SA AS I WHERE I.SNO = T.ISSSNO        /*AND T.STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')*/     "
            strSql += vbCrLf + "     GROUP BY GROUPNAME,STNITEMID,ITEM,SUBITEM   "

            strSql += vbCrLf + "     /*UPDATE  TEMPTABLEDB..TEMPGRPBILLSUM_SA SET AVGRATE = (SELECT AVG(BOARDRATE) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA WHERE GROUPNAME = T.GROUPNAME)     */"
            strSql += vbCrLf + "     UPDATE  TEMPTABLEDB..TEMPGRPBILLSUM_SA SET AVGRATE = (SELECT AVG(BOARDRATE) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA )     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA T   "
            strSql += vbCrLf + "     SELECT * FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA"

            strSql += vbCrLf + "      IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPBILLSUM_PU')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_PU     "
            strSql += vbCrLf + "     SELECT     "
            strSql += vbCrLf + "     IG.GROUPNAME AS GROUPNAME     "
            strSql += vbCrLf + "     ,IG.GROUPNAME AS PARTICULAR     "
            strSql += vbCrLf + "     ,SUM(PCS)PCS,SUM(I.GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
            strSql += vbCrLf + "     ,SUM(TAX) TAX      "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPBILLSUM_PU     "
            strSql += vbCrLf + "     FROM RECEIPT AS I  "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMMAST IM ON IM.ITEMID =I.ITEMID     "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMGROUPMAST IG ON IG.GROUPID =IM.ITEMGROUP   "
            strSql += vbCrLf + "     WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = ('PU') AND ISNULL(CANCEL,'') = ''     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     GROUP BY I.ITEMID,IG.GROUPNAME HAVING SUM(I.GRSWT) <> 0 AND SUM(AMOUNT)<>0     "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPBILLSUM_SR')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPBILLSUM_SR    "
            strSql += vbCrLf + "     SELECT     "
            strSql += vbCrLf + "     IG.GROUPNAME"
            strSql += vbCrLf + "     ,IG.GROUPNAME AS PARTICULAR     "
            strSql += vbCrLf + "     ,SUM(PCS)PCS,SUM(I.GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
            strSql += vbCrLf + "     ,SUM(TAX) TAX      "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPBILLSUM_SR    "
            strSql += vbCrLf + "     FROM RECEIPT AS I  "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMMAST IM ON IM.ITEMID =I.ITEMID     "
            strSql += vbCrLf + "     LEFT JOIN " & cnAdminDb & "..ITEMGROUPMAST IG ON IG.GROUPID =IM.ITEMGROUP   "
            strSql += vbCrLf + "     WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = 'SR' AND ISNULL(CANCEL,'') = ''     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     GROUP BY I.ITEMID,IG.GROUPNAME HAVING SUM(I.GRSWT) <> 0 AND SUM(AMOUNT)<>0     "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHSUM_M')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHSUM_M     "
            strSql += vbCrLf + "     CREATE TABLE  TEMPTABLEDB..TEMPGRPCASHSUM_M     "
            strSql += vbCrLf + "     (     "
            strSql += vbCrLf + "     PARTICULAR VARCHAR(250),ITEM VARCHAR(100),SUBITEM VARCHAR(100),PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3)     "
            strSql += vbCrLf + "     ,AMOUNT NUMERIC(15,2),SALRATE NUMERIC(15,2),DIFFRATE NUMERIC(15,2),AVGRATE NUMERIC(15,2),RESULT INT,STUDDED VARCHAR(1)     "
            strSql += vbCrLf + "     ,GROUPNAME VARCHAR(250),DISPORDER NUMERIC(15,2),COLHEAD VARCHAR(1),DIFFNETWT NUMERIC(15,2),RATEPER NUMERIC(15,2) "
            strSql += vbCrLf + "     )  "
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     /** CATEGORY TITLE **/     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(PARTICULAR,COLHEAD)SELECT 'SALES','T'     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,SALRATE,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT DISTINCT GROUPNAME,GROUPNAME,AVGRATE,0 RESULT,'C' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     /** CATEGORY,ITEM WISE TRANSACTION **/     "
            strSql += vbCrLf + "     IF @SUBITEM='N'"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "      IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPRATEPER_M')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPRATEPER_M    "
            strSql += vbCrLf + "     SELECT @QUERY= ' SELECT GROUPNAME,PARTICULAR,ITEM,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
            strSql += vbCrLf + "     ,CASE WHEN SUM(GRSWT) <> 0 THEN SUM(AMOUNT)/CASE WHEN SUM(GRSWT)=0 THEN 1 ELSE SUM(GRSWT) END ELSE 0 END AS SALRATE     "
            strSql += vbCrLf + "     ,AVGRATE     "
            strSql += vbCrLf + "     ,CASE WHEN SUM(GRSWT) <> 0 THEN (SUM(AMOUNT)/CASE WHEN SUM(GRSWT)=0 THEN 1 ELSE SUM(GRSWT) END)-ISNULL(AVGRATE,0) ELSE 0 END as DIFFRATE  "
            strSql += vbCrLf + "     ,CASE WHEN SUM(NETWT) <> 0 THEN (SUM(AMOUNT)/CASE WHEN SUM(GRSWT)=0 THEN 1 ELSE SUM(GRSWT) END)-ISNULL(AVGRATE,0) ELSE 0 END as DIFFNETWT"
            strSql += vbCrLf + "     ,CONVERT (NUMERIC(15,2),NULL)AS RATEPER"
            strSql += vbCrLf + "     ,STUDDED,RESULT "
            strSql += vbCrLf + "     INTO TEMPTABLEDB..TEMPGRPRATEPER_M"
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     GROUP BY GROUPNAME,ITEM,AVGRATE,DIFFRATE,DIFFNETWT,SALRATE,STUDDED,PARTICULAR,RESULT'"
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)"
            strSql += vbCrLf + "     SELECT @QUERY= 'INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,SALRATE,AVGRATE,DIFFRATE,DIFFNETWT,RATEPER,STUDDED,RESULT)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,PARTICULAR,ITEM,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT"
            strSql += vbCrLf + "     ,SALRATE      "
            strSql += vbCrLf + "     ,AVGRATE     "
            strSql += vbCrLf + "     ,DIFFRATE"
            strSql += vbCrLf + "     ,DIFFNETWT"
            strSql += vbCrLf + "     ,CASE WHEN AVGRATE<>0 THEN (ISNULL(DIFFRATE,0)/ISNULL(AVGRATE,0))*100 END AS RATEPER"
            strSql += vbCrLf + "     ,STUDDED,RESULT "
            strSql += vbCrLf + "     FROM TEMPTABLEDB..TEMPGRPRATEPER_M"
            strSql += vbCrLf + "     GROUP BY GROUPNAME,ITEM,AVGRATE,DIFFRATE,DIFFNETWT,SALRATE,STUDDED,PARTICULAR,RESULT'"
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)"
            strSql += vbCrLf + "     /** SUBTOTAL **/     "
            strSql += vbCrLf + "     SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)  "
            strSql += vbCrLf + "     SELECT GROUPNAME,''SUB TOTAL'',''ZZZ'',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     WHERE ISNULL(STUDDED,'''') = '''' GROUP BY GROUPNAME'      "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)"
            strSql += vbCrLf + "     SELECT @QUERY= 'INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''DIAMOND'',''ZZZ'',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),3 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     WHERE ISNULL(STUDDED,'''') = ''Y'' GROUP BY GROUPNAME'"
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)"
            strSql += vbCrLf + "     SELECT @QUERY= 'INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''TOTAL TAX'',''ZZZZ'',SUM(TAX),4 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA GROUP BY GROUPNAME'     "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)"
            strSql += vbCrLf + "     SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''TOTAL '',''ZZZZZ'',SUM(AMOUNT+ISNULL(TAX,0)),5 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA GROUP BY GROUPNAME '"
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "     END"
            strSql += vbCrLf + "     ELSE IF @SUBITEM='Y'"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "      IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPRATEPER_M')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPRATEPER_M    "
            strSql += vbCrLf + "     SELECT @QUERY= ' SELECT GROUPNAME,PARTICULAR,ITEM,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT     "
            strSql += vbCrLf + "     ,CASE WHEN SUM(GRSWT) <> 0 THEN SUM(AMOUNT)/SUM(GRSWT) ELSE 0 END AS SALRATE     "
            strSql += vbCrLf + "     ,AVGRATE     "
            strSql += vbCrLf + "     ,CASE WHEN SUM(GRSWT) <> 0 THEN (SUM(AMOUNT)/SUM(GRSWT))-ISNULL(AVGRATE,0) ELSE 0 END as DIFFRATE "
            strSql += vbCrLf + "     ,CASE WHEN SUM(GRSWT) <> 0 THEN (SUM(AMOUNT)/SUM(NETWT))-ISNULL(AVGRATE,0) ELSE 0 END as DIFFNETWT  "
            strSql += vbCrLf + "     ,CONVERT (NUMERIC(15,2),NULL)AS RATEPER"
            strSql += vbCrLf + "     ,STUDDED,RESULT ,CONVERT(VARCHAR(100),SUBITEM)SUBITEM"
            strSql += vbCrLf + "     INTO TEMPTABLEDB..TEMPGRPRATEPER_M"
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     GROUP BY GROUPNAME,ITEM,AVGRATE,DIFFRATE,DIFFNETWT,SALRATE,STUDDED,PARTICULAR,RESULT,SUBITEM'"
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(PARTICULAR,ITEM,GROUPNAME,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT DISTINCT ITEM,ITEM,GROUPNAME,0 RESULT,''I'' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA ' "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,SUBITEM,PCS,GRSWT,NETWT,AMOUNT,SALRATE,AVGRATE,DIFFRATE,DIFFNETWT,RATEPER,STUDDED,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,PARTICULAR,ITEM,SUBITEM,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT)"
            strSql += vbCrLf + "     ,SALRATE     "
            strSql += vbCrLf + "     ,AVGRATE     "
            strSql += vbCrLf + "     ,DIFFRATE"
            strSql += vbCrLf + "     ,DIFFNETWT"
            strSql += vbCrLf + "     ,CASE WHEN AVGRATE<>0 THEN (ISNULL(DIFFRATE,0)/ISNULL(AVGRATE,0))*100 END AS RATEPER"
            strSql += vbCrLf + "     ,STUDDED,RESULT,''E'' FROM  TEMPTABLEDB..TEMPGRPRATEPER_M  GROUP BY  GROUPNAME,ITEM,AVGRATE,DIFFRATE,DIFFNETWT,SALRATE,STUDDED,PARTICULAR,RESULT,SUBITEM'  "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)  "
            strSql += vbCrLf + "     SELECT GROUPNAME,''SUB TOTAL'',''ZZZ'',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     WHERE ISNULL(STUDDED,'''') = '''' GROUP BY GROUPNAME'      "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''DIAMOND'',''ZZZ'',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),4 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     WHERE ISNULL(STUDDED,'''') = ''Y'' GROUP BY GROUPNAME'      "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''TOTAL TAX'',''ZZZZ'',SUM(TAX),5 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA GROUP BY GROUPNAME'     "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "      SELECT @QUERY= ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(GROUPNAME,PARTICULAR,ITEM,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT GROUPNAME,''TOTAL '',''ZZZZZ'',SUM(AMOUNT+ISNULL(TAX,0)),6 RESULT,''S''COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA GROUP BY GROUPNAME'     "
            strSql += vbCrLf + "     PRINT @QUERY"
            strSql += vbCrLf + "     EXEC (@QUERY)    "
            strSql += vbCrLf + "     END"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_RE)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)SELECT 1.1 DISPORDER,'REPAIR DEL','T'COLHEAD "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
            strSql += vbCrLf + "     SELECT 1.1 DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,1 FROM  TEMPTABLEDB..TEMPGRPBILLSUM_RE  "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT 1.1 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_RE  "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)SELECT 2 DISPORDER,'PURCHASE','T'COLHEAD "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
            strSql += vbCrLf + "     SELECT 2 DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,1 FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT 2 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)SELECT 3 DISPORDER,'RETURN','T'COLHEAD     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT)     "
            strSql += vbCrLf + "     SELECT 3 DISPORDER,GROUPNAME,PARTICULAR,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),1 FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR GROUP BY GROUPNAME,PARTICULAR    "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,GROUPNAME,PARTICULAR,PCS,GRSWT,NETWT,AMOUNT,RESULT,COLHEAD)     "
            strSql += vbCrLf + "     SELECT 3 DISPORDER,'ZZZZZ','SUBTOTAL',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(AMOUNT),2,'S'COLHEAD FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR    "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     /**PARTLY SALES **/      "
            strSql += vbCrLf + "     SELECT @QUERY= ' IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPGRPPARTLYSALES'')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPPARTLYSALES'"
            strSql += vbCrLf + "       EXEC (@QUERY)"
            strSql += vbCrLf + "       SELECT @QUERY= ' SELECT '"
            strSql += vbCrLf + "       IF @PARTLY='Y'"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' CA.ITEMNAME+''-''+I.TAGNO+''(''+CAST(I.TAGGRSWT AS VARCHAR)+'')'' AS CATNAME'"
            strSql += vbCrLf + " 	  ELSE"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' CA.CATNAME'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' ,SUM(ISNULL(TAGPCS,0) - ISNULL(I.PCS,0))PCS,SUM(ISNULL(TAGGRSWT,0) - ISNULL(I.GRSWT,0))GRSWT,SUM(ISNULL(TAGNETWT,0) - ISNULL(I.NETWT,0)) NETWT'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' INTO  TEMPTABLEDB..TEMPGRPPARTLYSALES'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' FROM ..ISSUE AS I      '"
            strSql += vbCrLf + "       IF @PARTLY='Y'"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' INNER JOIN  " & cnAdminDb & "..ITEMMAST AS CA ON CA.ITEMID = I.ITEMID'"
            strSql += vbCrLf + " 	  ELSE"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' INNER JOIN  " & cnAdminDb & "..CATEGORY AS CA ON CA.CATCODE = I.CATCODE'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' WHERE I.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND ISNULL(I.CANCEL,'''') = ''''      '"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' AND I.TAGNO <> '''' AND I.ITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE STOCKTYPE = ''T'')'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'"
            strSql += vbCrLf + "       IF @PARTLY='Y'"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' GROUP BY CA.ITEMNAME,I.TAGNO,I.TAGGRSWT'"
            strSql += vbCrLf + "       ELSE"
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ ' GROUP BY CA.CATNAME'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' HAVING(SUM(ISNULL(TAGPCS, 0) - ISNULL(I.PCS, 0)) <> 0 Or SUM(ISNULL(TAGGRSWT, 0) - ISNULL(I.GRSWT, 0)) <> 0)'"
            strSql += vbCrLf + "       PRINT (@QUERY)"
            strSql += vbCrLf + "       EXEC (@QUERY)"
            strSql += vbCrLf + "       SELECT @QUERY=' IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPPARTLYSALES)>0'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' BEGIN'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' UPDATE  TEMPTABLEDB..TEMPGRPPARTLYSALES SET PCS = CASE WHEN PCS = 0 THEN NULL ELSE PCS END'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' SELECT 3.1 DISPORDER,''PARTLY SALES'',''T''COLHEAD      '"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,PCS,GRSWT,NETWT)'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' SELECT 3.2 DISPORDER,CATNAME,PCS,GRSWT,NETWT'   "
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' FROM  TEMPTABLEDB..TEMPGRPPARTLYSALES'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' END'"
            strSql += vbCrLf + "       PRINT (@QUERY)"
            strSql += vbCrLf + "       EXEC (@QUERY)"
            strSql += vbCrLf + "       SELECT @QUERY=' IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPCASHSUM_M WHERE DISPORDER=3.2)>0'"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' BEGIN'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,PCS,GRSWT,NETWT,COLHEAD)'"
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' SELECT 3.3 DISPORDER,''SUB TOTAL'',SUM(PCS),SUM(GRSWT),SUM(NETWT),''S''' "
            strSql += vbCrLf + " 	  SELECT @QUERY=@QUERY+ ' FROM  TEMPTABLEDB..TEMPGRPPARTLYSALES '"
            strSql += vbCrLf + " 	  IF @PARTLY='N'  "
            strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+ 'GROUP BY CATNAME HAVING COUNT(CATNAME)>1'	"
            strSql += vbCrLf + "       SELECT @QUERY=@QUERY+ ' END'"
            strSql += vbCrLf + "       PRINT (@QUERY)"
            strSql += vbCrLf + "       EXEC (@QUERY)"
            strSql += vbCrLf + "     /** CHIT COLLECTION **/      "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCHITCOLLECTION')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCHITCOLLECTION     "
            strSql += vbCrLf + "     CREATE TABLE  TEMPTABLEDB..TEMPGRPCHITCOLLECTION(AMOUNT NUMERIC(15,2))      "
            strSql += vbCrLf + "     IF @CHITDBEXSISTS = 'Y'"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     DECLARE @CHITDB VARCHAR(10)      "
            strSql += vbCrLf + "     DECLARE @CHITMAINDB VARCHAR(15)      "
            strSql += vbCrLf + "     SELECT @CHITDB = ISNULL(CTLTEXT,'') + 'SH0708',@CHITMAINDB = ISNULL(CTLTEXT,'') + 'SAVINGS' FROM  " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'      "
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM MASTER..SYSDATABASES WHERE NAME = @CHITDB)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     DECLARE @STR VARCHAR(8000)      "
            strSql += vbCrLf + "     SELECT @STR = ''      "
            strSql += vbCrLf + "     SET @STR = @STR + ' INSERT INTO  TEMPTABLEDB..TEMPGRPCHITCOLLECTION(AMOUNT)'      "
            strSql += vbCrLf + "     SET @STR = @STR + ' SELECT SUM(ISNULL(T.AMOUNT,0)+ISNULL(RP.AMOUNT,0))AMOUNT FROM '+@CHITDB+'..SCHEMECOLLECT T'      "
            strSql += vbCrLf + "     SET @STR = @STR + ' LEFT JOIN '+@CHITMAINDB+'..RECPAY RP ON T.ENTREFNO=RP.ENTREFNO'"
            strSql += vbCrLf + "     SET @STR = @STR + ' WHERE RDATE BETWEEN '''+CONVERT(VARCHAR,@FRMDATE)+''' AND '''+CONVERT(vARCHAR,@TODATE)+''' '      "
            strSql += vbCrLf + "     SET @STR = @STR + ' AND ISNULL(T.CANCEL,'''') = '''' AND ISNULL(T.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'      "
            strSql += vbCrLf + "     SET @STR = @STR + ' AND EXISTS (SELECT 1 FROM '+@CHITDB+'..SCHEMECOLLECT AS SC WHERE EXISTS (SELECT 1 FROM '+@CHITMAINDB+'..SCHEMEMAST WHERE GROUPCODE = SC.GROUPCODE AND REGNO = SC.REGNO AND COMPANYID IN (SELECT COMPANYID FROM '+@CHITMAINDB+'..COMPANY  '"
            strSql += vbCrLf + "     SET @STR = @STR +' WHERE JCOMPID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)))AND T.GROUPCODE = SC.GROUPCODE AND T.REGNO = SC.REGNO)'      "
            strSql += vbCrLf + "     EXEC (@STR)     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     /** CASH ABSTRACT **/       "
            strSql += vbCrLf + "     IF @CASHOPENING = 'Y'   "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     /** Cash Opening **/   "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHOPEN')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHOPEN       "
            strSql += vbCrLf + "     DECLARE @CASHID VARCHAR(7)   "
            strSql += vbCrLf + "     SELECT @CASHID = CTLTEXT FROM  " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CASH'   "
            strSql += vbCrLf + "     SELECT 'CASH OPENING..'AS PARTICULAR,SUM(AMOUNT)AMOUNT,0 RESULT,'R'RECPAY   "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPCASHOPEN   "
            strSql += vbCrLf + "     FROM"
            strSql += vbCrLf + "     (   "
            strSql += vbCrLf + "     SELECT DEBIT-CREDIT AMOUNT FROM ..OPENTRAILBALANCE WHERE ACCODE = @CASHID   "
            strSql += vbCrLf + "     AND COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY)       "
            strSql += vbCrLf + "     AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AS AMOUNT   "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE < @FRMDATE AND ACCODE = @CASHID   "
            strSql += vbCrLf + "     )X /** Cash Opening **/   "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHABS')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHABS     "
            strSql += vbCrLf + "     CREATE TABLE  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR VARCHAR(100),AMOUNT NUMERIC(15,2),RESULT INT,RECPAY VARCHAR(1))     "
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA)>0        "
            strSql += vbCrLf + "      IF @CASHOPENING = 'Y'   "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)    "
            strSql += vbCrLf + "     SELECT PARTICULAR,AMOUNT,RESULT,RECPAY FROM  TEMPTABLEDB..TEMPGRPCASHOPEN      "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ SA] SALES',SUM(AMOUNT),1 RESULT,'R' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ SA] SALES TAX',SUM(TAX),2 RESULT,'R' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SA)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ RE] REPAIR',SUM(AMOUNT),2.1 RESULT,'R' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_RE "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ SR] RETURN',SUM(AMOUNT),3 RESULT,'P' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR    "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ SR] RETURN TAX',SUM(TAX),4 RESULT,'P' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_SR HAVING SUM(TAX) <> 0     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU)>0      "
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ PU] PURCHASE',SUM(AMOUNT),5 RESULT,'P' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[ PV] PURCHASE TAX',SUM(TAX),6 RESULT,'R' FROM  TEMPTABLEDB..TEMPGRPBILLSUM_PU HAVING SUM(TAX) <> 0     "
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHABS(PARTICULAR,AMOUNT,RESULT,RECPAY)     "
            strSql += vbCrLf + "     SELECT '[REC] ADVANCE RECEIPT'PARTICULAR,SUM(AMOUNT) AMOUNT,7 RESULT,'R'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'A' AND RECPAY = 'R' AND ISNULL(FROMFLAG,'') NOT IN ('A','O') "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[PAY] ADVANCE PAYMENT',SUM(AMOUNT) AMOUNT,8,'P'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'A' AND RECPAY = 'P' AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL "
            strSql += vbCrLf + "     SELECT '[REC] CREDIT RECEIPT',SUM(AMOUNT) AMOUNT,9,'R'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'D' AND RECPAY = 'R'  "
            strSql += vbCrLf + "     AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[PAY] CREDIT PAYMENT',SUM(AMOUNT) AMOUNT,10,'P'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'D' AND RECPAY = 'P'  AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[PAY] SCHEME PAYMENT',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,11,'P'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE IN ('HP','HG','HZ','HB','HD') "
            strSql += vbCrLf + "     AND ISNULL(FROMFLAG,'') NOT IN ('A','O')     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[REC] OTHER RECEIPT',SUM(AMOUNT) AMOUNT,12,'R'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE   "
            strSql += vbCrLf + "     AND TRANTYPE = 'T' AND RECPAY = 'R'  AND ISNULL(FROMFLAG,'') NOT IN ('A','O')      "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[PAY] OTHER PAYMENT',SUM(AMOUNT)AMOUNT,13,'P'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND TRANTYPE = 'T' AND RECPAY = 'P'     "
            strSql += vbCrLf + "     AND ISNULL(FROMFLAG,'') NOT IN ('A','O')     "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[REC] SCHEME COLLECTION',SUM(AMOUNT),14,'R' RECPAY      "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPCHITCOLLECTION HAVING SUM(AMOUNT) <> 0      "
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[ HC] HANDLING CHARGES',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT,14,'R' RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'HC'     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     HAVING SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[ DI] DISCOUNT',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,14,'-' RECPAY     "
            strSql += vbCrLf + "     FROM TEMPTABLEDB..TEMPGRPACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'DI'     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[ GV] GIFT VOUCHER RECEIPT'PARTICULAR,SUM(AMOUNT) AMOUNT,15 RESULT,'R'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'GV' AND RECPAY IN('R') AND ISNULL(FROMFLAG,'') NOT IN ('A','O') "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[ GV] GIFT VOUCHER PAYMENT'PARTICULAR,SUM(AMOUNT) AMOUNT,15 RESULT,'P'RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPOUTSTANDING  WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE  "
            strSql += vbCrLf + "     AND TRANTYPE = 'GV' AND RECPAY IN('P') AND ISNULL(FROMFLAG,'') NOT IN ('A','O') "
            strSql += vbCrLf + "     HAVING(SUM(AMOUNT) <> 0)"
            strSql += vbCrLf + "     UNION ALL"
            strSql += vbCrLf + "     SELECT '[ RO] ROUNDOFF',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,16,'-' RECPAY     "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE = 'RO'     "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
            strSql += vbCrLf + "     HAVING SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) <> 0     "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHCOLL')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHCOLL       "
            strSql += vbCrLf + "     SELECT        "
            strSql += vbCrLf + "     SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT       "
            strSql += vbCrLf + "     INTO  TEMPTABLEDB..TEMPGRPCASHCOLL   "
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
            strSql += vbCrLf + "     AND PAYMODE IN ('CA')   "
            strSql += vbCrLf + "     AND SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
            strSql += vbCrLf + "     GROUP BY PAYMODE    "
            strSql += vbCrLf + "     IF @CASHOPENING = 'Y' INSERT INTO  TEMPTABLEDB..TEMPGRPCASHCOLL(AMOUNT) SELECT AMOUNT FROM  TEMPTABLEDB..TEMPGRPCASHOPEN   "
            strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPGRPCASHCOLLECTION')>0 DROP TABLE  TEMPTABLEDB..TEMPGRPCASHCOLLECTION     "
            strSql += vbCrLf + "     CREATE TABLE  TEMPTABLEDB..TEMPGRPCASHCOLLECTION(PARTICULAR VARCHAR(100),AMOUNT NUMERIC(15,2),TRANMODE VARCHAR(1),PAYMODE VARCHAR(3))     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHCOLLECTION(PARTICULAR,AMOUNT) SELECT 'CASH',SUM(ISNULL(AMOUNT,0)) FROM  TEMPTABLEDB..TEMPGRPCASHCOLL      "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHCOLLECTION(PARTICULAR,AMOUNT)"
            strSql += vbCrLf + "     SELECT "
            strSql += vbCrLf + "     Case PAYMODE"
            strSql += vbCrLf + "     WHEN 'CC' THEN 'CREDITCARD'"
            strSql += vbCrLf + "     WHEN 'CH' THEN 'CHEQUE'"
            strSql += vbCrLf + "     WHEN 'GV' THEN 'GIFTVOUCHER'"
            strSql += vbCrLf + "     ELSE 'SCHEME' END AS PARTICULAR"
            strSql += vbCrLf + "     ,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT"
            strSql += vbCrLf + "     FROM  TEMPTABLEDB..TEMPGRPACCTRAN   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE"
            strSql += vbCrLf + "     AND PAYMODE IN ('CC','CH','SS','CG','CB','CZ','CD','GV')"
            strSql += vbCrLf + "     GROUP BY PAYMODE     "
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPCASHABS)>0 OR (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPCASHCOLLECTION)>0"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD)SELECT 4 DISPORDER,'CASH ABSTRACT','T'COLHEAD"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT"
            strSql += vbCrLf + "     COUNT(*) FROM  TEMPTABLEDB..TEMPGRPCASHABS)>0"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 4,PARTICULAR,AMOUNT,RESULT FROM  TEMPTABLEDB..TEMPGRPCASHABS     "
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)SELECT 4,'TOTAL SA-SR+REC-PAY-PU+PV-DI+HC-RO',SUM(CASE WHEN RECPAY = 'R' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT,15 RESULT,'G'COLHEAD FROM  TEMPTABLEDB..TEMPGRPCASHABS"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM  TEMPTABLEDB..TEMPGRPCASHCOLLECTION)>0"
            strSql += vbCrLf + "     BEGIN"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT)SELECT 5,PARTICULAR,SUM(AMOUNT),0 RESULT FROM  TEMPTABLEDB..TEMPGRPCASHCOLLECTION GROUP BY PARTICULAR"
            strSql += vbCrLf + "     INSERT INTO  TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,AMOUNT,RESULT,COLHEAD)SELECT 5,'TOTAL',SUM(AMOUNT),1 RESULT,'G'COLHEAD FROM  TEMPTABLEDB..TEMPGRPCASHCOLLECTION"
            strSql += vbCrLf + "     End"
            strSql += vbCrLf + "     INSERT INTO TEMPTABLEDB..TEMPGRPCASHSUM_M(DISPORDER,PARTICULAR,COLHEAD) "
            strSql += vbCrLf + "     SELECT 16,'DISCOUNT FOR '+ M.METALNAME +' = ' +CONVERT(VARCHAR(200),ISNULL(SUM(ISNULL(DISCOUNT,0)+ISNULL(FIN_DISCOUNT,0)),0)),'C'"
            strSql += vbCrLf + "     FROM  ISSUE AS I LEFT JOIN  " & cnAdminDb & "..METALMAST AS M ON M.METALID=I.METALID "
            strSql += vbCrLf + "     LEFT JOIN ACCTRAN A ON A.BATCHNO=I.BATCHNO AND A.PAYMODE='DI'"
            strSql += vbCrLf + "     WHERE I.METALID IN(SELECT METALID FROM  " & cnAdminDb & "..METALMAST) AND  I.TRANDATE BETWEEN @FRMDATE AND @TODATE"
            strSql += vbCrLf + "     And ISNULL(I.CANCEL,'')<>'Y' "
            strSql += vbCrLf + "     AND I.SYSTEMID IN (SELECT SYSTEMID FROM #SYSTEMID) AND I.COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPGRPCOMPANY) AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) GROUP BY I.METALID ,M.METALNAME "
            strSql += vbCrLf + "     DECLARE @QRY VARCHAR(1000)     "
            strSql += vbCrLf + "     SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMPGRPCASHSUM_M SET PARTICULAR=''No Item Group'' WHERE PARTICULAR IS NULL AND RESULT=0 AND COLHEAD=''C'' '"
            strSql += vbCrLf + "     EXEC (@QRY)   "
            strSql += vbCrLf + "     SELECT @QRY = ' IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPGRP'+@SYSTEMID+'CASHSUMMARY'')>0 DROP TABLE  TEMPTABLEDB..TEMPGRP'+@SYSTEMID+'CASHSUMMARY'"
            strSql += vbCrLf + "     SELECT @QRY = @QRY + ' SELECT * INTO  TEMPTABLEDB..TEMPGRP'+@SYSTEMID+'CASHSUMMARY FROM  TEMPTABLEDB..TEMPGRPCASHSUM_M ORDER BY GROUPNAME,DISPORDER,ITEM,RESULT,STUDDED,SUBITEM'"
            strSql += vbCrLf + "     PRINT @QRY"
            strSql += vbCrLf + "     EXEC (@QRY)   "
            strSql += vbCrLf + " END"
QRYEXEC:
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            Exit Sub
        Catch ex As Exception
            If Err.Description.Contains("There is already an object named 'SP_CASHABSTRACTGROUP_NEW' in the database.") = True Then strSql = Replace(strSql, "CREATE PROCEDURE", "ALTER PROCEDURE") : GoTo QRYEXEC
        End Try
    End Sub


    Private Sub SP_CASHABSTRACT_CUSTOM()
        Try

            strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CASHABSTRACT_CUSTOM')>0"
            strSql += vbCrLf + " DROP PROCEDURE SP_CASHABSTRACT_CUSTOM"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            strSql = vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPCOMPANY')>0 DROP TABLE  TEMPTABLEDB..TEMPCOMPANY           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_SA')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_SA           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_PU')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_PU           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_RE')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_RE           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_SR')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_SR           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPBILLSUM_MI')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_MI           "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPCASHSUM_M')>0 DROP TABLE  TEMPTABLEDB..TEMPCASHSUM_M     "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPRATEPER_M')>0 DROP TABLE  TEMPTABLEDB..TEMPRATEPER_M     "
            strSql += vbCrLf + "  IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPACCTRAN')>0 DROP TABLE  TEMPTABLEDB..TEMPACCTRAN     "
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + " CREATE PROCEDURE  SP_CASHABSTRACT_CUSTOM"
            strSql += vbCrLf + "       ("
            strSql += vbCrLf + "          @FRMDATE VARCHAR(15)"
            strSql += vbCrLf + "          ,@TODATE VARCHAR(15)"
            strSql += vbCrLf + "          ,@COSTNAME VARCHAR(1500)"
            strSql += vbCrLf + "          ,@SYSTEMID VARCHAR(3)"
            strSql += vbCrLf + "          ,@NODEID VARCHAR(3)"
            strSql += vbCrLf + "          ,@COMPANYID VARCHAR(500)"
            strSql += vbCrLf + "          ,@CASHOPENING VARCHAR(1)    "
            strSql += vbCrLf + "          ,@CHITDBEXSISTS VARCHAR(1)  "
            strSql += vbCrLf + "          ,@SUBITEM VARCHAR(1)     "
            strSql += vbCrLf + "          ,@GROUPBY VARCHAR(100)     "
            strSql += vbCrLf + "          ,@MISCISSUE VARCHAR(1)     "
            strSql += vbCrLf + "          ,@MISCVALUE VARCHAR(1)     "
            strSql += vbCrLf + "          ,@BANKDET VARCHAR(1)     "
            strSql += vbCrLf + "          ,@PARTLY VARCHAR(1)   "
            strSql += vbCrLf + "          ,@GRSNET VARCHAR(1)"
            strSql += vbCrLf + "          ,@WITHOUTDISC VARCHAR(1)"
            strSql += vbCrLf + "          ,@WITHGROUPBYCATEGORY VARCHAR(1)"
            strSql += vbCrLf + "          ,@BANKOPENING VARCHAR(1)"
            strSql += vbCrLf + "          ,@CASHNAME VARCHAR(500)"
            strSql += vbCrLf + "          )"
            strSql += vbCrLf + "          AS"
            strSql += vbCrLf + "          BEGIN"
            strSql += vbCrLf + "          	SET NOCOUNT ON"
            strSql += vbCrLf + "          	DECLARE @GROUPBYCOUNTER VARCHAR(1) "
            strSql += vbCrLf + "          	DECLARE @GROUPBYCATEGORY VARCHAR(1) "
            strSql += vbCrLf + "          	DECLARE @GROUPBYTRANO VARCHAR(1) "
            strSql += vbCrLf + "          	SET @GROUPBYCOUNTER = 'N'"
            strSql += vbCrLf + "          	SET @GROUPBYCATEGORY = 'N'"
            strSql += vbCrLf + "          	SET @GROUPBYTRANO  = 'N'"
            strSql += vbCrLf + "          	IF @GROUPBY = 'COUNTER' SET @GROUPBYCOUNTER = 'Y'"
            strSql += vbCrLf + "          	IF @GROUPBY = 'CATEGORY' SET @GROUPBYCATEGORY = 'Y'"
            strSql += vbCrLf + "          	IF @GROUPBY = 'TRANNO' SET @GROUPBYTRANO  = 'Y'"
            strSql += vbCrLf + "          	DECLARE @QUERY  VARCHAR(4000)"
            strSql += vbCrLf + "          	SELECT @QUERY= 'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPCOMPANY'') DROP TABLE TEMPTABLEDB..TEMPCOMPANY               '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_SA'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_SA               '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_PU'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_PU               '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_RE'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_RE               '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_SR'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_SR               '"
            strSql += vbCrLf + "          	/** 2201 **/ "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPBILLSUM_MI'') DROP TABLE TEMPTABLEDB..TEMPBILLSUM_MI               '"
            strSql += vbCrLf + "          	/** 2201 **/ "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPCASHSUM_M'') DROP TABLE TEMPTABLEDB..TEMPCASHSUM_M               '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPRATEPER_M'') DROP TABLE TEMPTABLEDB..TEMPRATEPER_M           '"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +'IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPACCTRAN'') DROP TABLE TEMPTABLEDB..TEMPACCTRAN                      '"
            strSql += vbCrLf + "          	PRINT @QUERY"
            strSql += vbCrLf + "          	EXEC (@QUERY)"
            strSql += vbCrLf + "          	DECLARE @CHKFROMFLAG VARCHAR(1) "
            strSql += vbCrLf + "          	SELECT @CHKFROMFLAG =CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_CASHABS_CASH' "
            strSql += vbCrLf + "          	CREATE TABLE  TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(3))   "
            strSql += vbCrLf + "          	DECLARE @TCOMPANY VARCHAR(50) "
            strSql += vbCrLf + "          	IF CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          		INSERT INTO  TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT @COMPANYID   "
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "          	WHILE CHARINDEX(',',@COMPANYID)>0   "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          		SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)   "
            strSql += vbCrLf + "          		SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))   "
            strSql += vbCrLf + "          		IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0   "
            strSql += vbCrLf + "          		BEGIN"
            strSql += vbCrLf + "          			SET @COMPANYID= @COMPANYID + ','   "
            strSql += vbCrLf + "          		END"
            strSql += vbCrLf + "          		INSERT INTO  TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT @TCOMPANY   "
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "          	CREATE TABLE #SYSTEMID (SYSTEMID VARCHAR(3))   "
            strSql += vbCrLf + "          	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))   "
            strSql += vbCrLf + "          	IF (SELECT COUNT(*) FROM  " & cnAdminDb & "..COSTCENTRE)>0     "
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          		DECLARE @TEMPNAME VARCHAR(20)     "
            strSql += vbCrLf + "          		IF CHARINDEX(',',@COSTNAME)=0     "
            strSql += vbCrLf + "          		BEGIN"
            strSql += vbCrLf + "          			INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM  " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME   "
            strSql += vbCrLf + "          		End"
            strSql += vbCrLf + "          		WHILE CHARINDEX(',',@COSTNAME)>0     "
            strSql += vbCrLf + "          		BEGIN"
            strSql += vbCrLf + "          			SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)     "
            strSql += vbCrLf + "          			SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))     "
            strSql += vbCrLf + "          			IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0     "
            strSql += vbCrLf + "          			BEGIN"
            strSql += vbCrLf + "          				SET @COSTNAME= @COSTNAME + ','     "
            strSql += vbCrLf + "          			END"
            strSql += vbCrLf + "          			INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME     "
            strSql += vbCrLf + "          		END"
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "          	ELSE"
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          		INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "          	IF (SELECT COUNT(*) FROM  " & cnAdminDb & "..COSTCENTRE) = (SELECT COUNT(*) FROM #COSTCENTRE)      "
            strSql += vbCrLf + "          	INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
            strSql += vbCrLf + "          	IF @NODEID <> ''   "
            strSql += vbCrLf + "          		INSERT INTO #SYSTEMID(SYSTEMID) SELECT @NODEID   "
            strSql += vbCrLf + "          	ELSE"
            strSql += vbCrLf + "          	BEGIN"
            strSql += vbCrLf + "          		INSERT INTO #SYSTEMID(SYSTEMID)   "
            strSql += vbCrLf + "          		SELECT DISTINCT SYSTEMID FROM ..ISSUE     "
            strSql += vbCrLf + "          		UNION"
            strSql += vbCrLf + "          		SELECT DISTINCT SYSTEMID FROM ..RECEIPT     "
            strSql += vbCrLf + "          		UNION"
            strSql += vbCrLf + "          		SELECT DISTINCT SYSTEMID FROM ..ACCTRAN     "
            strSql += vbCrLf + "          		UNION"
            strSql += vbCrLf + "          		SELECT DISTINCT SYSTEMID FROM " & cnAdminDb & "..OUTSTANDING     "
            strSql += vbCrLf + "          		UNION"
            strSql += vbCrLf + "          		SELECT ''      "
            strSql += vbCrLf + "          	END"
            strSql += vbCrLf + "       	IF OBJECT_ID('TEMPDB..#CASHCOUNTER') IS NOT NULL DROP TABLE #CASHCOUNTER"
            strSql += vbCrLf + "          	CREATE TABLE #CASHCOUNTER(CASHID VARCHAR(10))"
            strSql += vbCrLf + "       	IF @CASHNAME <> '' AND @CASHNAME <> 'ALL'"
            strSql += vbCrLf + "       	BEGIN"
            strSql += vbCrLf + "       		SELECT @QUERY = CHAR(13) +' EXEC ..SP_SPLITVALUES_NEW @CHK_DB = ''" & cnAdminDb & "'',@CHK_TBL = ''CASHCOUNTER'',@CHK_FIELD = ''CASHNAME'',@OUTPUT_FIELD=''CASHID'',@RESULT_TBL = ''TEMPCASHCOUNTER'',@INPUTVALUES= '''+@CASHNAME+''',@DEF_VAL='',0'''"
            strSql += vbCrLf + "       		PRINT @QUERY"
            strSql += vbCrLf + "       		EXEC (@QUERY)"
            strSql += vbCrLf + "       		SELECT @QUERY = CHAR(13) +' INSERT INTO #CASHCOUNTER(CASHID) SELECT CASHID FROM ..TEMPCASHCOUNTER'"
            strSql += vbCrLf + "       	END"
            strSql += vbCrLf + "       	IF @CASHNAME = '' OR @CASHNAME = 'ALL'"
            strSql += vbCrLf + "       	BEGIN"
            strSql += vbCrLf + "       		SELECT @QUERY = CHAR(13) +' INSERT INTO #CASHCOUNTER(CASHID) SELECT CASHID FROM " & cnAdminDb & "..CASHCOUNTER UNION SELECT '''' '"
            strSql += vbCrLf + "       	END"
            strSql += vbCrLf + "       	PRINT @QUERY"
            strSql += vbCrLf + "       	EXEC (@QUERY)		"
            strSql += vbCrLf + "          	SELECT @QUERY= 'IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME =''TEMPACCTRAN'')>0 DROP TABLE  TEMPTABLEDB..TEMPACCTRAN'"
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +' SELECT * INTO  TEMPTABLEDB..TEMPACCTRAN   FROM ACCTRAN'    "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +' WHERE COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY)'       "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +' AND ISNULL(CANCEL,'''') ='''''   "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'       "
            strSql += vbCrLf + "          	SELECT @QUERY= @QUERY +' AND ISNULL(SYSTEMID,'''') IN (SELECT SYSTEMID FROM #SYSTEMID)'   "
            strSql += vbCrLf + "         	SELECT @QUERY= @QUERY+ CHAR(13) +' AND ISNULL(CASHID,'''') IN (SELECT CASHID FROM #CASHCOUNTER)'   "
            strSql += vbCrLf + "          	IF @CHKFROMFLAG='N'"
            strSql += vbCrLf + "          		SELECT @QUERY= @QUERY +' AND FROMFLAG NOT IN ('''',''S'',''O'',''A'')'    "
            strSql += vbCrLf + "          	PRINT @QUERY"
            strSql += vbCrLf + "          	EXEC (@QUERY)"
            strSql += vbCrLf + "          	IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME ='TEMPOUTSTANDING')>0 DROP TABLE  TEMPTABLEDB..TEMPOUTSTANDING "
            strSql += vbCrLf + "          	SELECT * INTO  TEMPTABLEDB..TEMPOUTSTANDING  FROM " & cnAdminDb & "..OUTSTANDING  "
            strSql += vbCrLf + "          	WHERE COMPANYID IN (SELECT COMPANYID FROM  TEMPTABLEDB..TEMPCOMPANY)       "
            strSql += vbCrLf + "          	AND ISNULL(CANCEL,'') = ''   "
            strSql += vbCrLf + "          	AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)       "
            strSql += vbCrLf + "          	AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEMID)    "
            strSql += vbCrLf + "          	AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)    "
            strSql += vbCrLf + "          	AND FROMFLAG NOT IN ('','S','O','A')    "
            strSql += vbCrLf + "          	IF @BANKDET = 'N'      "
            strSql += vbCrLf + "          	BEGIN "
            strSql += vbCrLf + "          		DELETE FROM  TEMPTABLEDB..TEMPACCTRAN  WHERE CONTRA IN (SELECT ACCODE FROM  " & cnAdminDb & "..ACHEAD WHERE ACTYPE='B') AND BATCHNO IN(SELECT BATCHNO FROM TEMPTABLEDB..TEMPACCTRAN WHERE PAYMODE='MP')"
            strSql += vbCrLf + "          		DELETE FROM  TEMPTABLEDB..TEMPACCTRAN  WHERE PAYMODE='MP' AND  ACCODE IN (SELECT ACCODE FROM  " & cnAdminDb & "..ACHEAD WHERE ACTYPE='B')"
            strSql += vbCrLf + "          		DELETE FROM  TEMPTABLEDB..TEMPOUTSTANDING  WHERE PAYMODE='MP' AND  ACCODE IN (SELECT ACCODE FROM  " & cnAdminDb & "..ACHEAD WHERE ACTYPE='B')"
            strSql += vbCrLf + "          	END "
            strSql += vbCrLf + "          	IF @CHITDBEXSISTS = 'N'      "
            strSql += vbCrLf + "          		DELETE FROM  TEMPTABLEDB..TEMPACCTRAN   WHERE FROMFLAG = 'C'    "
            strSql += vbCrLf + "          	IF (SELECT TOP 1 1 FROM  TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPBILLSUM_RE')>0 DROP TABLE  TEMPTABLEDB..TEMPBILLSUM_RE     "
            strSql += vbCrLf + "          	SELECT     "
            strSql += vbCrLf + "          	(SELECT CATNAME FROM  " & cnAdminDb & "..CATEGORY WHERE CATCODE = I.CATCODE) AS CATNAME  "
            strSql += vbCrLf + "          	,(SELECT ITEMCTRNAME FROM  " & cnAdminDb & "..ITEMCOUNTER WHERE ITEMCTRID = I.ITEMCTRID) AS COUNTERNAME         "
            strSql += vbCrLf + "          	,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM  " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID))AS PARTICULAR  "
            strSql += vbCrLf + "          	,TRANNO,TRANDATE  "
            strSql += vbCrLf + "          	,CONVERT(VARCHAR(200),(SELECT ITEMNAME FROM  " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID))AS ITEM     "
            strSql += vbCrLf + "          	,CONVERT(VARCHAR(200),(SELECT SUBITEMNAME FROM  " & cnAdminDb & "..SUBITEMMAST WHERE ITEMID = I.ITEMID AND SUBITEMID = I.SUBITEMID))AS SUBITEM     "
            strSql += vbCrLf + "          	,PCS,GRSWT,NETWT"
            strSql += vbCrLf + "          	,AMOUNT+ISNULL(FIN_DISCOUNT,0)-ISNULL((SELECT SUM(STNAMT) FROM ..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')),0)AS GRSAMOUNT"
            strSql += vbCrLf + "          	,AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM ..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM  " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')),0)AS AMOUNT     "
            strSql += vbCrLf + "          	,CONVERT(NUMERIC(15,2),NULL)SALRATE     "
            strSql += vbCrLf + "          	,CONVERT(NUMERIC(15,2),NULL)AVGRATE     "
            strSql += vbCrLf + "          	,CONVERT(NUMERIC(15,2),NULL)DIFFRATE  "
            strSql += vbCrLf + "          	,CONVERT(NUMERIC(15,2),NULL)RATEPER   "
            strSql += vbCrLf + "          	,TAX     "
            strSql += vbCrLf + "          	,ITEMID,SUBITEMID,BOARDRATE,1 RESULT,CONVERT(VARCHAR(1),NULL)STUDDED "
            strSql += vbCrLf + "          	, BATCHNO "
            strSql += vbCrLf + "          	,CONVERT(VARCHAR(15),SNO)SNO     "
