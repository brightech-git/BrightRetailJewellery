        strSql += vbCrLf + "          	IF @DESIGNERIDS <> 'ALL' SELECT @QRY =@QRY+' INSERT INTO #DESIGNERS(DESIGNERID) SELECT DESIGNERID FROM DESIGNER WHERE  DESIGNERID IN ('''+@DESIGNERIDS+''')'   "
        strSql += vbCrLf + "          	SET @COUNTERGROUP = REPLACE(@COUNTERGROUP,',',''',''') "
        strSql += vbCrLf + "          	IF @COUNTERGROUP <> ''  AND @COUNTERIDS='' SELECT @QRY =@QRY+' INSERT INTO #COUNTGRP(GRPID) SELECT ITEMCTRID FROM ITEMCOUNTER WHERE  CTRGROUP IN('''+@COUNTERGROUP+''')' "
        strSql += vbCrLf + "          	IF @COUNTERGROUP <> ''  AND @COUNTERIDS <>'' SELECT @QRY =@QRY+' INSERT INTO #COUNTGRP(GRPID) SELECT ITEMCTRID FROM ITEMCOUNTER WHERE   CTRGROUP IN('''+@COUNTERGROUP+''') AND ITEMCTRID IN('''+ @COUNTERIDS +''') ' "
        strSql += vbCrLf + "          	PRINT @COUNTERIDS"
        strSql += vbCrLf + " 			SET @SUBITEMGROUP = REPLACE(@SUBITEMGROUP,',',''',''') "
