        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  RPCS INT,RGRSWT NUMERIC(20,3),RNETWT NUMERIC(20,3),RAMOUNT NUMERIC(20,2),'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  IPCS INT,IGRSWT NUMERIC(20,3),INETWT NUMERIC(20,3),IAMOUNT NUMERIC(20,2),'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SSNO INT IDENTITY(1,1),METALID VARCHAR(1))'"
        strSql += vbCrLf + "   PRINT (@QRY)"
        strSql += vbCrLf + "   EXEC (@QRY)   "
        strSql += vbCrLf + "   SELECT @QRY = '  SELECT * INTO TEMPTABLEDB..TEMPCSTKVALUE1'+ @SYSTEMID+''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  FROM'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  ('"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SELECT DTYPE,TRANNO,TRANDATE,TRANTYPE,CATCODE,SNO,ACCODE,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SUM(RPCS) AS RPCS,SUM(RGRSWT) AS RGRSWT,SUM(RNETWT) AS RNETWT,SUM(RAMOUNT) AS RAMOUNT,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SUM(IPCS) AS IPCS,SUM(IGRSWT) AS IGRSWT,SUM(INETWT) AS INETWT,SUM(IAMOUNT) AS IAMOUNT'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  FROM'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  ('"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SELECT ''1'' AS DTYPE,0 TRANNO,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  (SELECT DATEADD(DD,-1,STARTDATE ) FROM DBMASTER WHERE DBNAME='''+ @DBNAME +''') TRANDATE,TRANTYPE,CATCODE,SNO,ACCODE,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  PCS RPCS,GRSWT RGRSWT,NETWT RNETWT,AMOUNT RAMOUNT,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  0 IPCS,0 IGRSWT,0 INETWT,0 IAMOUNT FROM '+ @DBNAME +'..OPENWEIGHT R'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  WHERE STOCKTYPE=''C'' '"
        strSql += vbCrLf + "   IF @COMPANYID <> 'ALL' "
        strSql += vbCrLf + "        SELECT @QRY = @QRY +CHAR(13) +'  AND COMPANYID ='''+ @COMPANYID +''''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  AND COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE'+ @SYSTEMID+')'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  AND CATCODE IN (SELECT CATCODE FROM '+ @ADMINDB +'..CATEGORY WHERE METALID IN (SELECT METALID FROM #METALMAST))'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  UNION ALL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SELECT ''1'' AS DTYPE,CASE WHEN TRANTYPE IN (''SR'',''PU'') THEN 0 ELSE TRANNO END TRANNO,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  TRANDATE,TRANTYPE,CATCODE,CASE WHEN TRANTYPE IN (''SR'',''PU'') THEN '''' ELSE SNO END SNO,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  CASE WHEN TRANTYPE IN (''SR'',''PU'') THEN '''' ELSE ACCODE END ACCODE,'"
