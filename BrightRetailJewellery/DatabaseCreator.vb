    Private Sub TAGCHECKREMARKS()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='TAGCHECKREMARKS')>0 "
        strSql += vbCrLf + "  	DROP PROCEDURE TAGCHECKREMARKS "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = ""
        strSql += vbCrLf + "CREATE PROCEDURE [dbo].[TAGCHECKREMARKS]"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@ITEMID VARCHAR(1000)"
        strSql += vbCrLf + ",@TAGNO VARCHAR(1000)"
        strSql += vbCrLf + ",@COSTID VARCHAR(2)"
        strSql += vbCrLf + ",@TABLENAME VARCHAR(20)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "DECLARE @QRY VARCHAR(8000)=''"
        strSql += vbCrLf + "SELECT @QRY = ''"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' SELECT '"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' COMPANYID'"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' ,(SELECT SEAL FROM DESIGNER WHERE DESIGNERID=A.DESIGNERID)DESIGNERSEAL'"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' ,(SELECT SNAME FROM ..ITEMTYPE WHERE ITEMTYPEID=A.ITEMTYPEID) ITEMTYPESHNAME'"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' ,ISNULL((SELECT TOP 1 SHORTNAME FROM ..ITEMMAST WHERE ITEMID IN ((SELECT STNITEMID FROM ..ITEMTAGSTONE S WHERE  '"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' S.ITEMID = A.ITEMID AND S.TAGNO = A.TAGNO  AND STNITEMID IN (SELECT ITEMID FROM ..ITEMMAST WHERE DIASTONE = ''D'')))),'''') [CLARITY]'"
        strSql += vbCrLf + "SELECT @QRY = @QRY + CHAR(13) + ' FROM ..'+@TABLENAME+' AS A '"
