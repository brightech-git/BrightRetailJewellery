        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "  	SELECT @QUERY = 'CREATE TABLE TEMPTABLEDB..TEMPSMITHTRAILBAL('"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + 'COSTID VARCHAR(2),COMPANYID VARCHAR(3),ACCODE VARCHAR(7),DEBIT NUMERIC(15,3) DEFAULT 0,CREDIT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + ',COLHEAD NVARCHAR(2))'"
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QUERY"

        strSql += vbCrLf + "  	SELECT @QUERY = 'INSERT INTO TEMPTABLEDB..TEMPSMITHTRAILBAL(COSTID ,COMPANYID,ACCODE,DEBIT,CREDIT) '"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + 'SELECT COSTID ,COMPANYID,ACCODE,SUM(DEBIT) DEBIT ,SUM(CREDIT) CREDIT'"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + ' FROM '+@DBNAME+'..OPENTRAILBALANCE A '"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + ' WHERE COMPANYID ='''+@COMPANYID +''''"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + ' AND ACCODE IN ( SELECT ACCODE FROM ACHEAD WHERE ACTYPE IN (''G'',''D''))'"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY + ' GROUP BY COSTID ,COMPANYID,ACCODE'"
        strSql += vbCrLf + "  	PRINT @QUERY "
        strSql += vbCrLf + "  	EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "  	SELECT @QUERY = 'INSERT INTO TEMPTABLEDB..TEMPSMITHTRAILBAL(COSTID,COMPANYID,ACCODE,DEBIT,CREDIT) '"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY +'SELECT COSTID,COMPANYID,ACCODE,CASE WHEN TRANMODE=''D''THEN SUM(ISNULL(AMOUNT,0)) ELSE 0 END DEBIT'"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY +' ,CASE WHEN TRANMODE=''C'' THEN SUM(ISNULL(AMOUNT,0)) ELSE 0 END CREDIT FROM '+@DBNAME+'..ACCTRAN '"
        strSql += vbCrLf + "  	SELECT @QUERY = @QUERY +' WHERE TRANDATE <= '''+@TODATE+'''' "
