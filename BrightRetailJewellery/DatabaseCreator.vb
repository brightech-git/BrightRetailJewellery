        strSql += vbCrLf + "		EXEC (@QRY)  "
        strSql += vbCrLf + "		SELECT @QRY='SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS1 ORDER BY INVOICEDATE,VOUCHERTYPE DESC'  "
        strSql += vbCrLf + "		EXEC (@QRY)     "
