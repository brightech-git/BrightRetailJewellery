    Function DropDb(ByVal dbname As String) As Integer
        STATUS = "Drop Database " + dbname
        funcProgressStep()
        If cn.State = ConnectionState.Closed Then cn.Open()
        strSql = "Alter database " & dbname & " SET AUTO_CLOSE OFF"
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        cmd.ExecuteNonQuery()

        strSql = "Drop database " & dbname & ""
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        cmd.ExecuteNonQuery()
        funcProgressStep(1)
        Return 0
    End Function

    Function CreateDuplicateDb(ByVal dbName As String) As Integer
        Createtempdb()
        If DbChecker("Duplicate" + dbName) = 1 Then
            ''drop old duplicate db
            DropDb("Duplicate" + dbName)
        End If
        ''create new duplicate db
        strSql = " CREATE database Duplicate" & dbName & ""
        If dbPath <> "" Then
            strSql += vbCrLf + "  On (Name = Duplicate" & dbName & "_dat,FILENAME = '" & dbPath & "\Duplicate" & dbName & ".mdf')"
            strSql += vbCrLf + "  Log On (Name = 'Duplicate" & dbName & "_log',FILENAME = '" & dbPath & "\Duplicate" & dbName & "_log.ldf')"
        End If
        If cn.State = ConnectionState.Closed Then cn.Open()
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        cmd.ExecuteNonQuery()

        strSql = "ALTER DATABASE Duplicate" & dbName & " SET AUTO_CLOSE OFF "
        If cn.State = ConnectionState.Closed Then cn.Open()
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        cmd.ExecuteNonQuery()

        Return 0
    End Function

    Function TraceDb(ByVal dbName As String, ByVal DupDbName As String) As Integer
        STATUS = dbName + " Tracing..."
        funcProgressStep()

        Dim RowTemp As DataRow = Nothing
        Dim RowTempCol() As DataRow = Nothing
        Dim DtTemp As New DataTable
        Dim ds As New Data.DataSet
        Dim da As New OleDbDataAdapter
        ds.Clear()
        ''To find Intersecting Tables
        strSql = "select name from " & DupDbName & "..sysobjects where xtype = 'u'"
        strSql += vbCrLf + " and name not in"
        strSql += vbCrLf + " (select name from " & dbName & "..sysobjects where xtype = 'u')"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.CommandTimeout = 1000
        da = New OleDbDataAdapter(cmd)
        da.Fill(ds, "extraTables")

        ''Add Tables from Duplicate Db into Original DB
        If ds.Tables("extraTables").Rows.Count > 0 Then
            Dim i As Integer
            For i = 0 To ds.Tables("extraTables").Rows.Count - 1
                strSql = "select *into " & dbName & ".."
                strSql += ds.Tables("extraTables").Rows(i).Item("name")
                strSql += vbCrLf + "  from " & DupDbName & ".."
                strSql += ds.Tables("extraTables").Rows(i).Item("name")
                strSql += " where 1<>1"
                If cnCostId = cnHOCostId Then
                    cmd = New OleDbCommand(strSql, cn, tran)
                    cmd.ExecuteNonQuery()
                    strSql = vbCrLf + " select co.name as ColName,st.name as ColType,case "
                    strSql += vbCrLf + " when st.name='varchar' then convert (varchar,co.length)"
                    strSql += vbCrLf + " when st.name='numeric' then convert(varchar,co.xprec) + ',' + convert(varchar,co.xscale) "
                    strSql += vbCrLf + " else '' end ColLength"
                    strSql += vbCrLf + " ,columnproperty(object_id(ob.name),co.name,'IsIdentity')IsIdent"
                    strSql += vbCrLf + " from " & DupDbName & "..syscolumns  co"
                    strSql += vbCrLf + " inner join " & DupDbName & "..sysobjects ob on ob.id=co.id and ob.name='" & ds.Tables("extraTables").Rows(i).Item("name") & "'"
                    strSql += vbCrLf + " inner join " & DupDbName & "..systypes as st on st.xusertype =co.xusertype  "
                    cmd = New OleDbCommand(strSql, cn, tran)
                    da = New OleDbDataAdapter(cmd)
                    DtTemp = New DataTable
                    da.Fill(DtTemp)
                    strSql = " if Object_id('" & dbName & ".." & ds.Tables("extraTables").Rows(i).Item("name") & "','u') is null"
                    strSql += " begin"
                    strSql += " Create Table " & dbName & ".." & ds.Tables("extraTables").Rows(i).Item("name")
                    strSql += " ("
                    For j As Integer = 0 To DtTemp.Rows.Count - 1
                        Dim ColName As String = ""
                        Dim ColType As String = ""
                        Dim ColLength As String = ""
                        Dim IsIdent As Integer = 0
                        ColName = DtTemp.Rows(j).Item("ColName").ToString
                        ColType = DtTemp.Rows(j).Item("ColType").ToString
                        ColLength = DtTemp.Rows(j).Item("ColLength").ToString
                        IsIdent = Val(DtTemp.Rows(j).Item("IsIdent").ToString)
                        strSql += ColName & " " & ColType
                        If ColLength <> "" Then strSql += " (" & ColLength & ")"
                        If IsIdent = 1 Then strSql += " IDENTITY (1,1)"
                        If j <> DtTemp.Rows.Count - 1 Then strSql += " ,"
                    Next
                    strSql += " )"
                    strSql += " end"
                    ExecQuery_DbCreator(SyncMode.Master, strSql, cn, tran, , , , , False)
                Else
                    cmd = New OleDbCommand(strSql, cn, tran)
                    cmd.ExecuteNonQuery()
                End If
            Next
        End If

        ''Importing fields into original db
        strSql = "select * from " & dbName & "..sysobjects where xtype = 'u'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(ds, "originalSysobjects")

        strSql = "select * from " & DupDbName & "..sysobjects where xtype = 'u'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(ds, "DupSysobjects")

        If ds.Tables("originalSysobjects").Rows.Count > 0 Then
            Dim i As Integer = Nothing
            Dim j As Integer = Nothing
            Dim OTableName As String = ""
            Dim DTableName As String = ""
            For i = 0 To ds.Tables("originalSysobjects").Rows.Count - 1
                OTableName = Trim(ds.Tables("originalSysobjects").Rows(i).Item("name"))
                For j = 0 To ds.Tables("DupSysobjects").Rows.Count - 1
                    DTableName = Trim(ds.Tables("DupSysobjects").Rows(j).Item("name"))
                    If UCase(OTableName) = UCase(DTableName) Then
                        strSql = "select name,xusertype,length from " & DupDbName & "..syscolumns where id in"
                        strSql += vbCrLf + " (select id from " & DupDbName & "..sysobjects where name = '" & DTableName & "'"
                        strSql += vbCrLf + " )and name not in"
                        strSql += vbCrLf + " (select name from " & dbName & "..syscolumns where id in"
                        strSql += vbCrLf + " (select id from " & dbName & "..sysobjects where name = '" & OTableName & "'))"
                        cmd = New OleDbCommand(strSql, cn, tran)
                        da = New OleDbDataAdapter(cmd)
                        Dim intDs As New Data.DataSet
                        intDs.Clear()
                        da.Fill(intDs, "intersectColumns")
                        If intDs.Tables("intersectColumns").Rows.Count > 0 Then
                            Dim cnt As Integer
                            Dim isectColumnName As String = ""
                            Dim isectVarName As String = ""
                            Dim isectLength As Integer

                            For cnt = 0 To intDs.Tables("intersectColumns").Rows.Count - 1
                                isectColumnName = intDs.Tables("intersectColumns").Rows(cnt).Item("name")
                                If isectColumnName = "" Then Continue For
                                strSql = "select name"

                                strSql += vbCrLf + " ,(select xprec from " & DupDbName & "..syscolumns where name =  '"
                                strSql += isectColumnName + "' and id in "
                                strSql += vbCrLf + " (select id from " & DupDbName & "..sysobjects where name =  '"
                                strSql += DTableName + "') and name <> 'varchar') "
                                strSql += vbCrLf + " as xprec "

                                strSql += vbCrLf + " ,(select xscale from " & DupDbName & "..syscolumns where name =  '"
                                strSql += isectColumnName + "' and id in "
                                strSql += vbCrLf + " (select id from " & DupDbName & "..sysobjects where name =  '"
                                strSql += DTableName + "') and name <> 'varchar') "
                                strSql += vbCrLf + " as xscale "

                                strSql += vbCrLf + " ,(select length from " & DupDbName & "..syscolumns where name =  '"
                                strSql += isectColumnName + "' and id in "
                                strSql += vbCrLf + " (select id from " & DupDbName & "..sysobjects where name =  '"
                                strSql += DTableName + "') and name <> 'varchar') "
                                strSql += vbCrLf + " as length "
                                strSql += vbCrLf + " from master..systypes as mname "
                                strSql += vbCrLf + " where mname.xusertype = "
                                strSql += vbCrLf + " (select xusertype from " & DupDbName & "..syscolumns where name = '"
                                strSql += isectColumnName + "' and id in "
                                strSql += vbCrLf + " (select id from " & DupDbName & "..sysobjects where name = '"
                                strSql += OTableName + "'))"
                                cmd = New OleDbCommand(strSql, cn, tran)
                                da = New OleDbDataAdapter(cmd)
                                da.Fill(ds, "insectFields")
                                If ds.Tables("insectFields").Rows.Count > 0 Then
                                    isectVarName = ds.Tables("insectFields").Rows(0).Item("name")
                                    If isectVarName = "" Then Continue For
                                    isectLength = ds.Tables("insectFields").Rows(0).Item("length")
                                    'adding fields
                                    strSql = ""
                                    strSql = "if(select count(*) from " & dbName & "..syscolumns where name='" & isectColumnName & "' and id=object_id('" & dbName & ".." & OTableName & "'))=0"
                                    If isectVarName = "varchar" Then
                                        strSql += " alter table " & dbName & ".."
                                        strSql += OTableName + " add " + isectColumnName + " " + isectVarName + "("
                                        strSql += isectLength.ToString + ")"
                                    ElseIf StrComp(isectVarName, "numeric", CompareMethod.Text) = 0 Then
                                        strSql += " alter table " & dbName & ".."
                                        strSql += OTableName + " add " + isectColumnName
                                        strSql += vbCrLf + "  numeric(" + ds.Tables("insectFields").Rows(0).Item("xprec").ToString + "," + ds.Tables("insectFields").Rows(0).Item("xscale").ToString + ")"
                                    Else
                                        strSql += " alter table " & dbName & ".."
                                        strSql += OTableName + " add " + isectColumnName
                                        strSql += vbCrLf + "  " + isectVarName
                                    End If
                                    If Not cnCostId Is Nothing And cnCostId = cnHOCostId Then
                                        ExecQuery_DbCreator(SyncMode.Master, strSql, cn, tran)
                                    Else
                                        cmd = New OleDbCommand(strSql, cn, tran)
                                        cmd.ExecuteNonQuery()
                                    End If
                                End If
                                ds.Tables("insectFields").Clear()
                            Next
                        End If
                    End If
                Next
            Next
        End If
        funcProgressStep(1)
        Return 0
    End Function

    Function funcProgressStep(Optional ByVal stepValue As Integer = 0) As Integer
        lblStatus.Text = UCase(STATUS)
        If pBar.Value >= pBar.Maximum - stepValue Then
            pBar.Value = 10
        Else
            pBar.Value = pBar.Value + stepValue
        End If
        Me.Refresh()
    End Function

