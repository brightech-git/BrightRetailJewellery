        strSql += vbCrLf + "   SET @COSTIDS=REPLACE(@COSTIDS,',',''',''')"
        strSql += vbCrLf + "   SELECT @DEFFINDISC =  CTLTEXT FROM SOFTCONTROL WHERE CTLID='FINALDISCOUNT'"
        strSql += vbCrLf + "   SET @QUERY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPDISCSALES'')'"
