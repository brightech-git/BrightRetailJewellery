        strSql += vbCrLf + "  /*   Purpose          : For INSPECTION OUTSTANDING REPORT      */"
        strSql += vbCrLf + "  /*   Refred Tables    : " & tranDbName & "..ISSUE," & tranDbName & "..RECEIPT," & compId + suffix & "..PERSONALINFO */"
        strSql += vbCrLf + "  /* 		     " & compId + suffix & "..ITEMMAST," & compId + suffix & "..ITEMCOUNTER," & compId + suffix & "..EMPMASTER */"
        strSql += vbCrLf + "  /*   Refred Forms/Dll : MDIREPORT=>FRMCARDCOLLECTIONSREPORT */"
        strSql += vbCrLf + "  /*     ---------------------/* --       */"
        strSql += vbCrLf + "  /*    Created/Modified            Modified                 Description       */"
        strSql += vbCrLf + "  /*     ---------------------/* -- */"
        strSql += vbCrLf + "  /* ******************************************************************************************* */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql += vbCrLf + "  /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_INSPECTIONOUTSTAND')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_INSPECTIONOUTSTAND"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Create store procedure */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  CREATE PROCEDURE SP_RPT_INSPECTIONOUTSTAND"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Declare Variables */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  (				"
        strSql += vbCrLf + "  		 @DateFrom  VARCHAR(12)/* -- FromDate */"
        strSql += vbCrLf + "  		,@DateTo VARCHAR(12)/* -- EndDate */"
        strSql += vbCrLf + "  		,@ITEMNAME NVARCHAR(75)/* -- Item Name from ITEMMAST Table */"
        strSql += vbCrLf + "  		,@PARTYNAME NVARCHAR(75)/* -- Party Name from PERSONALINFO Table */"
        strSql += vbCrLf + "  		,@SALESPERSON NVARCHAR(75)/* -- SalesPerson Name from EMPMASTET Table */"
        strSql += vbCrLf + "  		,@COUNTERNAME NVARCHAR(75)/* -- Counter Name from ITEMCOUNTER Table */"
        strSql += vbCrLf + "  		,@SystemId nvarchar(20)/* -- Give the SystemId for Temporary Tables */"
        strSql += vbCrLf + "  		,@cnAdminDB nvarchar(50)/* -- Give the DataBase Name For AdminDb  */"
        strSql += vbCrLf + "  		,@cnStockDB nvarchar(50)/* -- Give the DataBase Name For StockDb */"
        strSql += vbCrLf + "  		,@CNCOMPANYID NVARCHAR(3)/*  GIVE THE COMPANYID*/"
        strSql += vbCrLf + "  )AS "
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  /* -- Take the Datas from ISSUE Table with conditions into Temporary Table */"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  SELECT @STRQRY =''"
        strSql += vbCrLf + "  SELECT @STRQRY ='IF(SELECT 1 FROM MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'INSOUTSTAND'')>0'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' DROP TABLE MASTER..TEMP'+@SystemId+'INSOUTSTAND'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' SELECT'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' TRANNO BILLNO,CONVERT(VARCHAR,TRANDATE,103)BILLDATE,TAGNO'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(SELECT ITEMNAME FROM  '+@cnAdminDB+'..ITEMMAST WHERE ITEMID=I.ITEMID) AS ITEMNAME'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,PCS IPCS,GRSWT IGRSWT'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,ISNULL((SELECT GRSWT FROM  '+@cnStockDB+'..RECEIPT WHERE TRANTYPE=''AR'' AND REFNO=I.SNO AND COMPANYID = '''+@CNCOMPANYID+'''),0) RGRSWT'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,ISNULL((SELECT TOP 1 (PNAME+	CASE WHEN DOORNO <> '''' THEN '',''+ DOORNO ELSE '''' END +'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' CASE WHEN ADDRESS1 <> '''' THEN '',''+ ADDRESS1 ELSE '''' END+CASE WHEN ADDRESS2 <> '''' THEN '',''+ ADDRESS2 ELSE '''' END+'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' CASE WHEN ADDRESS3 <> '''' THEN '',''+ ADDRESS3 ELSE '''' END+CASE WHEN AREA <> '''' THEN '',''+ AREA ELSE '''' END+'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' CASE WHEN CITY <> '''' THEN '',''+ CITY ELSE '''' END +CASE WHEN PHONERES <> '''' THEN '',PH-''+ PHONERES ELSE '''' END)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' FROM  '+@cnAdminDB+'..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM '+@cnAdminDB+'..CUSTOMERINFO WHERE BATCHNO=I.BATCHNO) AND COMPANYID = '''+@CNCOMPANYID+'''),'''') AS ADDRESS'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' ,(REMARK1+REMARK2) AS REMARKS,ITEMID,BATCHNO,ITEMCTRID,EMPID,TRANDATE,TRANNO'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' INTO MASTER..TEMP'+@SystemId+'INSOUTSTAND'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' FROM  '+@cnStockDB+'..ISSUE AS I WHERE TRANTYPE =''AI'''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' and TRANDATE between '''+@DATEFROM+''' and '''+@DATETO+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND I.COMPANYID = '''+@CNCOMPANYID+'''' "
        strSql += vbCrLf + "  If @ItemName <>'ALL' And @itemName <>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY =@STRQRY + ' and ITEMID =(select ITEMID from  '+@cnAdminDB+'..ITEMMAST where ITEMNAME='''+@ITEMNAME+''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @PartyName <> 'ALL' And @PartyName <>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY =@STRQRY + ' and BATCHNO IN (select BATCHNO from '+@cnAdminDB+'..CUSTOMERINFO WHERE PSNO IN (SELECT SNO FROM '+@cnAdminDB+'..PERSONALINFO where PNAME='''+@PARTYNAME+''' AND COMPANYID = '''+@CNCOMPANYID+'''))'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @SalesPerson <> 'ALL' And @SalesPerson <>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY =@STRQRY + ' and EMPID =(select EMPID from  '+@cnAdminDB+'..EMPMASTER where EMPNAME='''+@SalesPerson+''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  If @CounterName <> 'ALL' And @CounterName <> ''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY =@STRQRY + ' and ITEMCTRID=(select ITEMCTRID from  '+@cnAdminDB+'..ITEMCOUNTER where ITEMCTRNAME='''+@COUNTERNAME+''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- Execute Query */"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- PRINT @STRQRY */"
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

