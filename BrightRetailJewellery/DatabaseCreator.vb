        strSql += vbCrLf + "  /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_INSPECTION')>0 "
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_INSPECTION "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Create store procedure */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  CREATE PROCEDURE SP_RPT_INSPECTION"
        strSql += vbCrLf + "  /* -- ================= */"
        strSql += vbCrLf + "  /* -- Declare Variables */"
        strSql += vbCrLf + "  /* -- ================= */"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  			 @DateFrom  VARCHAR(12)/* -- FromDate */"
        strSql += vbCrLf + "  			,@DateTo VARCHAR(12)/* -- EndDate */"
        strSql += vbCrLf + "  			,@OrderBy CHAR/* -- for OrderBy  */"
        strSql += vbCrLf + "  			,@SystemId nvarchar(20)/* -- Give the SystemId for Temporary Tables */"
        strSql += vbCrLf + "  			,@cnAdminDB nvarchar(50)/* -- Give the DataBase Name For AdminDb  */"
        strSql += vbCrLf + "  			,@cnStockDB nvarchar(50)/* -- Give the DataBase Name For StockDb */"
        strSql += vbCrLf + "  		    ,@CNCOMPANYID NVARCHAR(3)/*  GIVE THE COMPANYID*/"
        strSql += vbCrLf + "  )AS"
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  /* -- Take the Datas from ISSUE Table with conditions into Temporary Table */"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  SELECT @STRQRY=''"
        strSql += vbCrLf + "  SELECT @STRQRY='if(select 1 from MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'INSTOTAL'')> 0'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' Drop table MASTER..TEMP'+@SystemId+'INSTOTAL'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' select'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' convert(varchar,SNO)ISNO,TRANNO,TRANDATE'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,PCS IPCS,GRSWT IGRSWT,NETWT INETWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,BATCHNO,ITEMID,EMPID IEMPID'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,(REMARK1+REMARK2) IREMARK,ItemCtrId'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,(select sno from  '+@cnStockDB+'..Receipt where RefNo=convert(varchar,i.sno) and TRANTYPE=''AR'' AND COMPANYID = '''+@CNCOMPANYID+''') RSNO'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,(select refno from  '+@cnStockDB+'..Receipt where RefNo=convert(varchar,i.sno) and TRANTYPE=''AR'' AND COMPANYID = '''+@CNCOMPANYID+''') RREFNO'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' into MASTER..TEMP'+@SystemId+'INSTOTAL'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' from  '+@cnStockDB+'..Issue as i'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' where TranType =''AI'''"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' AND TRANDATE between '''+@DateFrom+''' and '''+@DateTo+''''"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' AND I.COMPANYID = '''+@CNCOMPANYID+'''' "
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- Execute Query */"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- PRINT @STRQRY */"
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY"
        strSql += vbCrLf + "  /* -- ============================================================================= */"
        strSql += vbCrLf + "  /* -- Query for take the datas of Stone details from IssStone & ReceiptStone Tables */"
        strSql += vbCrLf + "  /* -- ============================================================================= */"
        strSql += vbCrLf + "  SELECT @STRQRY='if(select 1 from MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'INSPECTIONFINAL'')> 0'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' Drop table MASTER..TEMP'+@SystemId+'INSPECTIONFINAL'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' select'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ISNO,RREFNO,TRANNO BILLNO,convert(varchar,TRANDATE,103) BILLDATE'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select Top 1 PNAME from  '+@cnStockDB+'..PersonalInfo  where BatchNo = T.BatchNo AND COMPANYID = '''+@CNCOMPANYID+'''),'''') as NAME'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select Top 1 PHONERES from  '+@cnStockDB+'..PersonalInfo  where BatchNo = T.BatchNo AND COMPANYID = '''+@CNCOMPANYID+'''),'''') as PHONENO'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select ITEMNAME from  '+@cnAdminDB+'..ItemMast where ItemId=T.ItemId),'''') as ITEMNAME'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull(IPCS,0) IPCS,IsNull(IGRSWT,0) IGRSWT,IsNull(INETWT,0) INETWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select SUM(STNWT) from  '+@cnStockDB+'..IssStone where IssSno =T.ISno AND COMPANYID = '''+@CNCOMPANYID+''' and'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' StnItemId IN (select ITEMID from  '+@cnAdminDB+'..ItemMast where METALID=''D'') GROUP BY ISSSNO),0) as ISTNWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select PCS from  '+@cnStockDB+'..Receipt where RefNo=T.ISNo and TRANTYPE=''AR'' AND COMPANYID = '''+@CNCOMPANYID+'''),0) RPCS'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select GRSWT from  '+@cnStockDB+'..Receipt where RefNo=T.ISNo and TRANTYPE=''AR'' AND COMPANYID = '''+@CNCOMPANYID+'''),0) RGRSWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select NETWT from  '+@cnStockDB+'..Receipt where RefNo=T.ISNo and TRANTYPE=''AR'' AND COMPANYID = '''+@CNCOMPANYID+'''),0) RNETWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select SUM(STNWT) from  '+@cnStockDB+'..ReceiptStone where IssSno =T.RSno AND COMPANYID = '''+@CNCOMPANYID+''' and'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' StnItemId IN (select ITEMID from  '+@cnAdminDB+'..ItemMast where METALID=''D'') GROUP BY ISSSNO),0) as RSTNWT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull(IREMARK,'''') REMARK'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select ITEMCTRNAME from  '+@cnAdminDB+'..ItemCounter where ItemCtrId=T.ItemCtrId),'''') as COUNTERNAME'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,IsNull((select Top 1 EMPNAME from  '+@cnAdminDB+'..EmpMaster where EmpId=IEmpId),'''') as SALESPERSON'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' INTO MASTER..TEMP'+@SystemId+'INSPECTIONFINAL'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' from MASTER..TEMP'+@SystemId+'INSTOTAL AS T'"
        strSql += vbCrLf + "  /* -- ======== */"
        strSql += vbCrLf + "  /* -- Order BY  */"
        strSql += vbCrLf + "  /* -- ======== */"
        strSql += vbCrLf + "  /* -- ============ */"
        strSql += vbCrLf + "  /* -- ItemNameWise */"
        strSql += vbCrLf + "  /* -- ============ */"
        strSql += vbCrLf + "  IF @ORDERBY='I' "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY=@STRQRY+' Order By ITEMNAME,TRANNO,TRANDATE'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- =============== */"
        strSql += vbCrLf + "  /* -- CounterNameWise */"
        strSql += vbCrLf + "  /* -- =============== */"
        strSql += vbCrLf + "  IF @ORDERBY='C'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY=@STRQRY+' Order By COUNTERNAME,TRANNO,TRANDATE'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- =============== */"
        strSql += vbCrLf + "  /* -- SalesPersonWise */"
        strSql += vbCrLf + "  /* -- =============== */"
        strSql += vbCrLf + "  IF @ORDERBY='S'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY=@STRQRY+' Order By SALESPERSON,TRANNO,TRANDATE'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- ========== */"
        strSql += vbCrLf + "  /* -- TranNoWise */"
        strSql += vbCrLf + "  /* -- ========== */"
        strSql += vbCrLf + "  IF @ORDERBY='N'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY=@STRQRY+' Order By TRANNO,TRANDATE'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- Execute Query */"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- PRINT @STRQRY */"
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function funcSP5_CounterSales() As Integer
        strSql = " /* -- ======================================== */"
        strSql += vbCrLf + "  /* -- Store procedure for CounterSales Report */"
        strSql += vbCrLf + "  /* -- ======================================== */"
        strSql += vbCrLf + "  /* ******************************************************************************************  */"
        strSql += vbCrLf + "  /*  Intitial Authors :       */"
        strSql += vbCrLf + "  /*  Create   Date    : 09/09/2008      */"
        strSql += vbCrLf + "  /*  Purpose          : For COUNTERSALES REPORT      */"
        strSql += vbCrLf + "  /*  Refred Tables    : " & tranDbName & "..ISSUE */"
        strSql += vbCrLf + "  /*		     " & compId + suffix & "..ITEMMAST," & compId + suffix & "..SUBITEMMAST," & compId + suffix & "..METALMAST */"
        strSql += vbCrLf + "  /*  Refred Forms/Dll : MDIREPORT=>FRMCOUNTERSALESREPORT */"
        strSql += vbCrLf + "  /*    --------------------/* --       */"
        strSql += vbCrLf + "  /*   Created/Modified            Modified                 Description       */"
        strSql += vbCrLf + "  /*    --------------------/* -- */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql += vbCrLf + "  /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COUNTERSALES')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERSALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        'strSql = vbCrLf + "  /* -- ======================= */  "
        'strSql += vbCrLf + "    /* -- Create store procedure */  "
        'strSql += vbCrLf + "    /* -- ======================= */  "
        'strSql += vbCrLf + "    CREATE PROCEDURE SP_RPT_COUNTERSALES  "
        'strSql += vbCrLf + "          /*  ======================= */  "
        'strSql += vbCrLf + "          /*  Declare Variables */  "
        'strSql += vbCrLf + "          /*  ======================= */  "
        'strSql += vbCrLf + "          (    @DateFrom  VARCHAR(12)/* FromDate */  "
        'strSql += vbCrLf + "           ,@DateTo VARCHAR(12)/* EndDate */  "
        'strSql += vbCrLf + "           ,@MetalName NVARCHAR(50)/* Metal Name from METALNAME Table */  "
        'strSql += vbCrLf + "           ,@FLAG CHAR/* Find th BackOffice or CounterSales */  "
        'strSql += vbCrLf + "           ,@SystemId nvarchar(20)/* Give the SystemId for Temporary Tables */  "
        'strSql += vbCrLf + "           ,@cnAdminDB nvarchar(50)/* Give the DataBase Name For AdminDb  */  "
        'strSql += vbCrLf + "           ,@cnStockDB nvarchar(50)/* Give the DataBase Name For StockDb */  "
        'strSql += vbCrLf + "           ,@COMPANYID NVARCHAR(500)/*  GIVE THE COMPANYID*/  "
        'strSql += vbCrLf + "           ,@GRPITEM VARCHAR(1)  "
        'strSql += vbCrLf + "           ,@COSTNAME VARCHAR(500)"
        'strSql += vbCrLf + "           ,@ITEMID VARCHAR(500)"
        'strSql += vbCrLf + "           ) AS"
        'strSql += vbCrLf + "        IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY  "
        'strSql += vbCrLf + "          CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))  "
        'strSql += vbCrLf + "          DECLARE @TCOMPANY VARCHAR(50)  "
        'strSql += vbCrLf + "          IF CHARINDEX(',',@COMPANYID)=0  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          WHILE CHARINDEX(',',@COMPANYID)>0  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)  "
        'strSql += vbCrLf + "          SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))  "
        'strSql += vbCrLf + "          IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SET @COMPANYID= @COMPANYID + ','  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE"
        'strSql += vbCrLf + "          CREATE TABLE #COSTCENTRE(COSTID VARCHAR(5))  "
        'strSql += vbCrLf + "          EXEC " & cnStockDb & "..SP_SPLITVALUES_NEW @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '" & cnStockDb & "..TEMPCST',@INPUTVALUES =@COSTNAME,@DEF_VAL=',0'  "
        'strSql += vbCrLf + "          INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM " & cnStockDb & "..TEMPCST  "
        'strSql += vbCrLf + "          DROP TABLE " & cnStockDb & "..TEMPCST  "
        'strSql += vbCrLf + "          DECLARE @STRQRY NVARCHAR(4000)  "
        'strSql += vbCrLf + "          DECLARE @ITEMFILTER NVARCHAR(1000)"
        'strSql += vbCrLf + "          SELECT @ITEMFILTER=''"
        'strSql += vbCrLf + "          IF @ITEMID<> 'ALL' and @ITEMID<>''"
        'strSql += vbCrLf + "          BEGIN"
        'strSql += vbCrLf + "          set @ITEMID = replace(@ITEMID,',',''',''')"
        'strSql += vbCrLf + "          SELECT @ITEMFILTER=' AND I.ITEMID IN ('''+ @ITEMID +''')' "
        'strSql += vbCrLf + "          End"
        'strSql += vbCrLf + "          /*  ====================================================================== */  "
        'strSql += vbCrLf + "          /*  Take the Datas from Issue Table with conditions into Temporary Table */  "
        'strSql += vbCrLf + "          /*  ====================================================================== */  "
        'strSql += vbCrLf + "          SELECT @STRQRY=''  "
        'strSql += vbCrLf + "          SELECT @STRQRY='IF (SELECT 1 FROM MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SYSTEMID+'COUNTERREPORT'') > 0'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' DROP TABLE MASTER..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' SELECT'   "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ISNULL(CONVERT(VARCHAR,TRANNO),'''') BILLNO'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,ISNULL(CONVERT(VARCHAR,I.TRANDATE,103),'''')  BILLDATE,IT.ITEMNAME,SIT.SUBITEMNAME'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,I.TAGNO,I.PCS AS PCS,I.GRSWT AS GRSWT,I.LESSWT AS LESSWT,I.NETWT AS NETWT,I.AMOUNT AS AMOUNT'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,I.REMARK1,I.REMARK2'"
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,CASE WHEN I.FLAG =''C'' THEN ''COUNTERSALES'' WHEN FLAG =''B'' THEN ''BACKOFFICE'' ELSE '''' END AS FLAG'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,CASE WHEN ISNULL(O.ODSNO,'''')<>'''' THEN ''6'' ELSE ''1'' END RESULT,TRANDATE,TRANNO,CONVERT(VARCHAR(15),I.SNO)SNO,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(VARCHAR(50),'''')SEP'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' INTO MASTER..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' FROM  '+@CNSTOCKDB+'..ISSUE AS I'"
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' INNER JOIN '+@CNADMINDB+'..ITEMMAST AS IT ON I.ITEMID = IT.ITEMID AND STOCKTYPE =''T'''"
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' LEFT JOIN '+@CNADMINDB+'..SUBITEMMAST AS SIT ON I.SUBITEMID = SIT.SUBITEMID '"
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' LEFT JOIN '+@CNADMINDB+'..ORMAST AS O ON I.SNO = O.ODSNO '"
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' WHERE TRANDATE BETWEEN ''' +@DATEFROM+''' AND '''+@DATETO+''''  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'   "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND ISNULL(I.TAGNO,'''') = '''' AND I.TRANTYPE IN (''SA'',''MI'') AND ISNULL(I.CANCEL,'''') <> ''Y'''   "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '   "
        'strSql += vbCrLf + "          IF @METALNAME<>'ALL' AND @METALNAME<>''  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND I.METALID=(SELECT METALID FROM '+@CNADMINDB+'..METALMAST WHERE METALNAME='''+@METALNAME+''')'  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          IF @FLAG='B'  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND FLAG = ''B'''  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          IF @FLAG='C'  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND FLAG = ''C'''  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          IF @FLAG='A'  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND FLAG IN (''C'',''B'')'  "
        'strSql += vbCrLf + "          END  "
        'strSql += vbCrLf + "          SELECT @STRQRY=@STRQRY+@ITEMFILTER+' ORDER BY TRANDATE'  "
        'strSql += vbCrLf + "          PRINT @STRQRY/* PRINT @STRQRY */  "
        'strSql += vbCrLf + "          EXEC SP_EXECUTESQL @STRQRY  "
        'strSql += vbCrLf + "          /* ====================================== */  "
        'strSql += vbCrLf + "          /* Find The Total Of already Find Result */  "
        'strSql += vbCrLf + "          /* ====================================== */  "
        'strSql += vbCrLf + "          SELECT @STRQRY='IF (SELECT COUNT(*) FROM MASTER..TEMP'+@SystemId+'COUNTERREPORT)>0'  "
        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' BEGIN'  "
        'strSql += vbCrLf + "          IF @GRPITEM = 'Y'  "
        'strSql += vbCrLf + "          BEGIN  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' INSERT INTO MASTER..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' (BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD,SEP)'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' (SELECT DISTINCT '' '' AS BILLNO,'' ''BILLDATE,ITEMNAME,'' '' AS SUBITEMNAME'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,0 AS PCS,0 AS GRSWT,0 AS LESSWT,0 AS NETWT'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,0 AS AMOUNT,'' ''FLAG,CASE WHEN RESULT=''6'' THEN ''5'' ELSE ''0'' END RESULT,'' ''TRANDATE,'' ''TRANNO,''T'' AS COLHEAD,'''' SEP'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' FROM MASTER..TEMP'+@SYSTEMID+'COUNTERREPORT WHERE RESULT IN(''1'',''6''))'  "
        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' INSERT INTO MASTER..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
