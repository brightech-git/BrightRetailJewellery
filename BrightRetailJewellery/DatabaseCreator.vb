        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' LEFT JOIN '+@DBNAME+'..EMPMASTER AS E ON E.EMPID = I.EMPID'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' LEFT JOIN TEMPTABLEDB..SA_COMM_METAL AS CO ON CO.METALNAME = M.METALNAME'    "
