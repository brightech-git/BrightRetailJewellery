    Private Sub SP_ACCODE_CHK()
        Dim ChitDbPrefix As String = ""
        ChitDbPrefix = GetSqlValue("SELECT CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'", , tran)
        strSql = " SELECT TOP 1 1 FROM MASTER..SYSDATABASES WHERE NAME = '" & ChitDbPrefix & "SAVINGS'"
        If GetSqlValue(strSql, "-1", tran) = "-1" Then
            Exit Sub
        End If

        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_ACCODE_CHK')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_ACCODE_CHK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE SP_ACCODE_CHK (@FRMDATE VARCHAR(20),@TODATE VARCHAR(20))   "
        strSql += vbCrLf + "  AS               "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "    DECLARE @QRY NVARCHAR(4000)     "
        strSql += vbCrLf + "    DECLARE @SYNCTO NVARCHAR(4000)     "
        strSql += vbCrLf + "    SELECT @SYNCTO = CTLTEXT FROM SOFTCONTROL WHERE CTLID='SYNC-TO'"
        strSql += vbCrLf + "    IF @SYNCTO=''"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    SELECT @QRY = ' SELECT ACCODE,NAME,SCHEMEID,COMPANYID,RDATE AS DATE FROM(SELECT DISTINCT(SELECT TOP 1 CASE WHEN ISNULL(DEFAULTAC,'''') <> '''' THEN DEFAULTAC ELSE ACCODE END FROM CREDITCARD '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE COMPCODE = T.COMPANYID AND SCHEMECODE = T.SCHEMEID)AS ACCODE,(SELECT TOP 1 NAME FROM CREDITCARD '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE COMPCODE = T.COMPANYID AND SCHEMECODE = T.SCHEMEID)AS NAME,T.SCHEMEID AS SCHEMEID,T.COMPANYID AS COMPANYID ,RDATE FROM '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' (SELECT(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(DEFAULT_ACC,'''')<>''''  THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE,RDATE '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C WHERE RDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND ISNULL(CANCEL,'''') = '''''"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' SELECT(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(DEFAULT_ACC,'''')<>'''' THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE,C.RDATE'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C INNER JOIN " & ChitDbPrefix & "SAVINGS..RECPAY R ON C.ENTREFNO = R.ENTREFNO'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE C.RDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND ISNULL(C.CANCEL,'''') = '''' AND R.PAYMODE=''CC''  AND (C.MODEPAY =''R'' OR C.MODEPAY=''D'')' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' SELECT(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(DEFAULT_ACC,'''')<>'''' THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE,C.RDATE'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C WHERE CHEQUERETDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND ISNULL(CANCEL,'''') = '''''"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' SELECT (SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,ACCODE,C.RDATE FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C INNER JOIN " & ChitDbPrefix & "SAVINGS..RECPAY R ON C.ENTREFNO = R.ENTREFNO'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE C.CHEQUERETDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND ISNULL(C.CANCEL,'''') = '''' AND R.PAYMODE=''CC''  AND C.MODEPAY =''R'''   "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' SELECT (SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,ISNULL((SELECT CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID=''BANKCHARGE-ID''),''BCCHRG'')AS ACCODE,C.RDATE '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C INNER JOIN " & ChitDbPrefix & "SAVINGS..RECPAY R ON C.ENTREFNO = R.ENTREFNO'   "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE R.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND C.MODEPAY =''R''  AND ISNULL(C.CANCEL,'''')=''''  AND ISNULL(R.CANCEL,'''')='''''   "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' UNION ALL' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' SELECT (SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ,ISNULL((SELECT CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID=''NETCHARGE-ID''),''NETCHRG'')AS ACCODE,C.RDATE '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C INNER JOIN " & ChitDbPrefix & "SAVINGS..RECPAY R ON C.ENTREFNO = R.ENTREFNO'   "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE R.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND C.MODEPAY =''D'' AND ISNULL(C.CANCEL,'''')='''' AND ISNULL(R.CANCEL,'''')=''''' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' ) T ) X '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY + ' WHERE ISNULL(X.ACCODE,'''') NOT IN (SELECT ACCODE FROM ACHEAD )' "
        strSql += vbCrLf + "    PRINT @QRY"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "  END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_PMTRAN()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_PMTRAN')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_PMTRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE SP_PMTRAN"
        strSql += vbCrLf + "      ("
        strSql += vbCrLf + "      @FROMDATE VARCHAR(12),"
        strSql += vbCrLf + "      @TODATE VARCHAR(12),"
        strSql += vbCrLf + "      @TRANNO VARCHAR(10),"
        strSql += vbCrLf + "      @COSTCENTRE VARCHAR(500),"
        strSql += vbCrLf + "      @PMNAME VARCHAR(12),"
        strSql += vbCrLf + "      @PMSUBNAME VARCHAR(12),"
        strSql += vbCrLf + "      @GROUPBY VARCHAR(12)"
        strSql += vbCrLf + "      )"
        strSql += vbCrLf + "      AS"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "      SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPCOMPREPORT'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPREPORT'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ 'SELECT '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' M.PMNAME ITEMNAME,S.PMSUBNAME SUBITEMNAME,PCS,'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' (SELECT TOP 1 PMNAME FROM " & cnAdminDb & "..PMMAST WHERE PMID=V.PMID)ORGITEMNAME,'"
        strSql += vbCrLf + "  	  SELECT @QRY = @QRY+CHAR(13)+ ' (SELECT TOP 1 PMSUBNAME FROM " & cnAdminDb & "..PMSUBMAST WHERE PMSUBID=V.PMSUBID)ORGSUBITEMNAME,CONVERT(INT,1) AS ORGPCS,'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' TRANNO,CONVERT(VARCHAR(12),TRANDATE,103) AS TRANDATE,AMOUNT,P.COSTID,2 AS RESULT'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' INTO TEMPTABLEDB..TEMPCOMPREPORT FROM PMTRAN AS P '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' INNER JOIN " & cnAdminDb & "..PMMAST AS M ON P.PMID = M.PMID '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' LEFT JOIN " & cnAdminDb & "..PMSUBMAST AS S ON P.PMSUBID = S.PMSUBID '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' LEFT JOIN " & cnAdminDb & "..PMVALIDATE AS V ON P.AMOUNT BETWEEN V.FROM_AMT AND V.TO_AMT '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' WHERE ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + "      IF @TRANNO <> '' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' AND TRANNO = '''+@TRANNO+''''"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      IF @COSTCENTRE <> '' AND @COSTCENTRE <> 'ALL' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' AND P.COSTID IN (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME IN ('''+@COSTCENTRE+'''))'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      IF @PMNAME <> '' AND @PMNAME <> 'ALL' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' AND P.PMID IN (SELECT PMID FROM " & cnAdminDb & "..PMMAST WHERE PMNAME IN ('''+ @PMNAME +'''))'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      IF @PMSUBNAME <> '' AND @PMSUBNAME <> 'ALL' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' AND P.PMSUBID IN (SELECT PMSUBID FROM " & cnAdminDb & "..PMSUBMAST WHERE PMSUBNAME IN ('''+ @PMSUBNAME +'''))'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPCOMPREPORT (ITEMNAME,TRANDATE,SUBITEMNAME,PCS,AMOUNT,RESULT) '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' SELECT ''GRAND TOTAL'',''ZZZZZZ'',''ZZZZZZ'',SUM(PCS),SUM(AMOUNT)AMOUNT,4 FROM TEMPTABLEDB..TEMPCOMPREPORT  WHERE RESULT=2 '"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      IF @GROUPBY = 'ITEM'"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPCOMPREPORT (ITEMNAME,RESULT) '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' SELECT ITEMNAME,1 FROM TEMPTABLEDB..TEMPCOMPREPORT WHERE RESULT=2 GROUP BY ITEMNAME '"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPCOMPREPORT (ITEMNAME,PCS,AMOUNT,RESULT) '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' SELECT ITEMNAME,SUM(PCS)PCS,SUM(AMOUNT)AMOUNT,3 FROM TEMPTABLEDB..TEMPCOMPREPORT WHERE RESULT=2 GROUP BY ITEMNAME '"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY) "
        strSql += vbCrLf + "      SELECT @QRY = ' SELECT ITEMNAME,SUBITEMNAME,TRANDATE,SUM(PCS)PCS,SUM(AMOUNT)AMOUNT,RESULT'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' FROM TEMPTABLEDB..TEMPCOMPREPORT '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' GROUP BY TRANDATE,ITEMNAME,SUBITEMNAME,RESULT'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' ORDER BY ITEMNAME,RESULT,SUBITEMNAME,TRANDATE'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)   "
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      ELSE IF @GROUPBY = 'SUBITEM'"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPCOMPREPORT (ITEMNAME,SUBITEMNAME,RESULT) '"
        strSql += vbCrLf + "      SELECT @QRY = @QRY+CHAR(13)+ ' SELECT ITEMNAME,SUBITEMNAME,1 FROM TEMPTABLEDB..TEMPCOMPREPORT WHERE RESULT=2 GROUP BY ITEMNAME,SUBITEMNAME '"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      SELECT @QRY = ' INSERT INTO TEMPTABLEDB..TEMPCOMPREPORT (ITEMNAME,SUBITEMNAME,PCS,AMOUNT,RESULT) '"
