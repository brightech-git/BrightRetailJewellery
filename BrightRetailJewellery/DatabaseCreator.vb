        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' LEFT JOIN '+@DBNAME+'..EMPMASTER AS E ON E.EMPID = I.EMPID'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' LEFT JOIN TEMPTABLEDB..SA_COMM_CATEGORY AS CO ON CO.CATGROUP = CG.CGROUPNAME'    "
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND I.TRANTYPE = ''SR'' AND ISNULL(CANCEL,'''') = '''''    "
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + @COMFILTER"
        strSql += vbCrLf + "  				PRINT @QRY"
        strSql += vbCrLf + "  				EXEC(@QRY) "
        strSql += vbCrLf + "  				SELECT @QRY = '  IF '''+@DETAILED+''' = ''N'' UPDATE TEMPTABLEDB..SA_COMMISION SET TRANDATE = NULL '   "
        strSql += vbCrLf + "  				EXEC(@QRY)    "
        strSql += vbCrLf + "  				SELECT @QRY = ' SELECT CONVERT(VARCHAR(350),CASE WHEN '''+@DETAILED+''' = ''Y'' THEN ''  '' + CONVERT(VARCHAR,TRANDATE,103) ELSE EMPNAME END)PARTICULAR'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,EMPID,METALNAME,SUM(CASE WHEN SEP = ''SA'' THEN PCS ELSE 0 END) SPCS'    "
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''SA'' THEN NETWT ELSE 0 END) SNETWT,SUM(CASE WHEN SEP = ''SA'' THEN AMOUNT ELSE 0 END) SAMOUNT'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''SR'' THEN PCS ELSE 0 END) RPCS,SUM(CASE WHEN SEP = ''SR'' THEN NETWT ELSE 0 END) RNETWT'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''SR'' THEN AMOUNT ELSE 0 END) RAMOUNT,SUM(CASE WHEN SEP = ''SA'' THEN PCS ELSE -1*PCS END) PCS'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''SA'' THEN NETWT ELSE -1*NETWT END) NETWT,SUM(CASE WHEN SEP = ''SA'' THEN AMOUNT ELSE -1*AMOUNT END) AMOUNT'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,2),'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' CASE WHEN COMM_BASTYPE=''PCS'' AND COMM_AMTTYPE=''AMOUNT'' THEN (SUM(CASE WHEN SEP = ''SA'' THEN PCS ELSE -1*PCS END) / COMM_BAS)*COMM_AMT '"
