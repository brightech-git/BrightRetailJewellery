        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	SELECT @QRY=' UPDATE TEMPTABLEDB..TEMPCASHBOOK SET PARTICULAR = PARTICULAR + CHAR(13) + W.WEIGHTINFO' "
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' FROM TEMPTABLEDB..TEMPCASHBOOK AS B,TEMPTABLEDB..TEMPWEIGHTINFO AS W' "
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' WHERE B.TRANDATE = W.TRANDATE AND B.BATCHNO = W.BATCHNO AND B.ENTRYORDER = W.ENTRYORDER' "
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	IF @SUMMARY='Y'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPCASHBOOK1'')>0 DROP TABLE TEMPTABLEDB..TEMPCASHBOOK1'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' SELECT * INTO TEMPTABLEDB..TEMPCASHBOOK1 FROM TEMPTABLEDB..TEMPCASHBOOK'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' DELETE FROM TEMPTABLEDB..TEMPCASHBOOK WHERE RESULT=2'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' INSERT INTO TEMPTABLEDB..TEMPCASHBOOK (TRANNO,PAYMODE,PARTICULAR,DEBIT,CREDIT,TRANDATE,RESULT)'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' SELECT TRANNO,PAYMODE,PARTICULAR'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' ,CASE WHEN SUM(ISNULL(DEBIT,0))=0 THEN NULL ELSE SUM(ISNULL(DEBIT,0)) END'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' ,CASE WHEN SUM(ISNULL(CREDIT,0))=0 THEN NULL ELSE SUM(ISNULL(CREDIT,0)) END'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' ,TRANDATE,RESULT FROM TEMPTABLEDB..TEMPCASHBOOK1 WHERE RESULT=2'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' GROUP BY TRANNO,PAYMODE,PARTICULAR,TRANDATE,RESULT'"
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " 	IF @ORDERBY='G'"
        strSql += vbCrLf + " 	BEGIN "
        strSql += vbCrLf + " 		SELECT @QRY=' UPDATE A SET A.CREDIT=CASE WHEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0))>0 THEN (ISNULL(A.CREDIT,0)-ISNULL(A.DEBIT,0)) ELSE NULL END'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' ,A.DEBIT=CASE WHEN (ISNULL(A.DEBIT,0)-ISNULL(CREDIT,0))>0 THEN (ISNULL(A.DEBIT,0)-ISNULL(A.CREDIT,0))  ELSE null END'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' FROM TEMPTABLEDB..TEMPCASHBOOK  A WHERE A.PAYMODE IN(''JE'',''CP'',''CR'') AND ISNULL(A.COLHEAD,'''') NOT IN(''T'',''S'')' "
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' UPDATE TEMPTABLEDB..TEMPCASHBOOK SET RESULT=(CASE WHEN PAYMODE=''SA'' THEN 2 WHEN PAYMODE=''SV'' THEN 3' "
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' WHEN PAYMODE=''PU'' THEN 4 WHEN PAYMODE=''PV'' THEN 5  WHEN PAYMODE=''SR'' THEN 6 WHEN PAYMODE=''RV'' THEN 7' "
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ ' WHEN PAYMODE in(''AA'',''AR'',''AP'') THEN 8 WHEN PAYMODE in(''SS'',''CB'',''CD'') THEN 9 WHEN PAYMODE in(''CC'') THEN 10 WHEN PAYMODE in(''CH'') THEN 11' "
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ ' ELSE 12 END) FROM TEMPTABLEDB..TEMPCASHBOOK  WHERE RESULT=2 AND ISNULL(COLHEAD,'''')='''''"
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	END "
        strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMPCASHBOOK ORDER BY TRANDATE,TDATE DESC ,RESULT,TRANNO,PARTICULAR"
        strSql += vbCrLf + " END /* sp_daybook end */ "

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_OTHERBRANCHADVANCEADJUST()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_OTHERBRANCHADVANCEADJUST')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_OTHERBRANCHADVANCEADJUST"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "  CREATE PROCEDURE SP_RPT_OTHERBRANCHADVANCEADJUST"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(13)"
        strSql += vbCrLf + ",@FROMDATE VARCHAR(13)"
        strSql += vbCrLf + ",@TODATE VARCHAR(13)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(1000)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(1000)"
        strSql += vbCrLf + ",@ACFILTER VARCHAR(2)"
        strSql += vbCrLf + ",@CHITDBID VARCHAR(3)"
        strSql += vbCrLf + ")    "
        strSql += vbCrLf + "AS    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "declare @QRY varchar(1000)  "
        strSql += vbCrLf + "DECLARE @@QRY VARCHAR(8000)  "
        strSql += vbCrLf + "DECLARE @ACCFILTER AS VARCHAR(500) "
        strSql += vbCrLf + "SET @@QRY=''          "
        strSql += vbCrLf + "SET @ACCFILTER='' "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..TEMP_OUT_COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE           "
        strSql += vbCrLf + "SELECT @@QRY='CREATE TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE(COSTID VARCHAR(3))'"
        strSql += vbCrLf + "EXEC (@@QRY)"
        strSql += vbCrLf + "SELECT @@QRY='INSERT INTO TEMPTABLEDB..TEMP_OUT_COSTCENTRE SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = '''+ @COSTNAME +''''"
        strSql += vbCrLf + "EXEC (@@QRY)"
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..TEMP_OUT_COMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUT_COMPANY           "
        strSql += vbCrLf + "SELECT @@QRY='CREATE TABLE TEMPTABLEDB..TEMP_OUT_COMPANY (COMPANYID VARCHAR(3))                        '"
        strSql += vbCrLf + "EXEC (@@QRY)"
        strSql += vbCrLf + "SELECT @@QRY='INSERT INTO TEMPTABLEDB..TEMP_OUT_COMPANY SELECT  COMPANYID FROM COMPANY WHERE COMPANYNAME = '''+ @COMPANYID +'''  '"
        strSql += vbCrLf + "EXEC (@@QRY)"
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..TEMP_OUTSTANDING') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..TEMP_CROUTSTANDING ') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_CROUTSTANDING  "
        strSql += vbCrLf + "SELECT @@QRY=' CREATE TABLE TEMPTABLEDB..TEMP_OUTSTANDING (PARTICULAR VARCHAR(200),RUNNO VARCHAR(20),TRANTYPE VARCHAR(50),TRANNO  VARCHAR(10),TRANDATE  SMALLDATETIME'    "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + ',DEBIT NUMERIC(15,2),CREDIT NUMERIC(15,2),BALANCE NUMERIC(15,2)'    "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + ',NAME VARCHAR(50), REMARK VARCHAR(50),MOBILE VARCHAR(20),AMOUNT  NUMERIC (15,2) '    "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + ',CTRANNO VARCHAR(20),CTRANDATE SMALLDATETIME,AREA VARCHAR(15)'    "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + ',SALESPERSON VARCHAR(30),COSTNAME VARCHAR(30),RESULT INT,COLHEAD VARCHAR(1),AREAORD INT'    "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY +',COSTID VARCHAR(4),BATCHNO VARCHAR(15),FROMCOSTID VARCHAR(20)'  "
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + ',COMPANYID VARCHAR(4),LASTTRANDATE VARCHAR(15))'"
        strSql += vbCrLf + "EXEC (@@QRY)"
        strSql += vbCrLf + "IF @ACFILTER= 'A'  OR @ACFILTER= 'B'"
        strSql += vbCrLf + "BEGIN "
        strSql += vbCrLf + "	SELECT @@QRY=  'INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING (PARTICULAR,RUNNO ,TRANTYPE,TRANNO,TRANDATE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',DEBIT,CREDIT,BALANCE,NAME,REMARK ,MOBILE,AMOUNT,CTRANNO,CTRANDATE,AREA'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',SALESPERSON,COSTNAME,RESULT,COLHEAD ,AREAORD,COSTID,BATCHNO,FROMCOSTID'  "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',COMPANYID,LASTTRANDATE)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,O.RUNNO'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',''ADVANCE'' TRANTYPE,O.TRANNO,O.TRANDATE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE 0 END AS DEBIT'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE 0 END AS CREDIT'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CONVERT(NUMERIC(15,2),NULL)BALANCE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(P.INITIAL+'' ''+P.PNAME) NAME,O.REMARK1 AS REMARK,P.MOBILE,CONVERT(NUMERIC,NULL) AMOUNT   '    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CONVERT(NUMERIC,NULL) CTRANNO,CONVERT(SMALLDATETIME,NULL)CTRANDATE,P.AREA                  '    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(SELECT EMPNAME FROM EMPMASTER WHERE EMPID = O.EMPID)AS SALESPERSON             '   "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = O.COSTID)AS COSTNAME             '   "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD,CONVERT(INT,1)AREAORD                '    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',O.COSTID,O.BATCHNO   '    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID =SUBSTRING(O.RUNNO,1,2)) AS FROMCOSTID'  "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',O.COMPANYID,CONVERT(VARCHAR(12),NULL)LASTTRANDATE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'FROM  OUTSTANDING AS O'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'INNER JOIN CUSTOMERINFO AS CU ON CU.BATCHNO = O.BATCHNO'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'INNER JOIN  PERSONALINFO AS P ON P.SNO = CU.PSNO'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'WHERE O.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''''    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND ISNULL(O.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMP_OUT_COSTCENTRE)'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND ISNULL(O.CANCEL,'''') = ''''  AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMP_OUT_COMPANY)'+ @ACCFILTER    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND O.COSTID<>( SUBSTRING(RUNNO,1,2))'    "
        strSql += vbCrLf + "	EXEC(@@QRY) "
        strSql += vbCrLf + "	SELECT @@QRY=  'IF(SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_OUTSTANDING)>0 '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'BEGIN'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(PARTICULAR,TRANTYPE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'SELECT ''ADVANCE'',''ADVANCE''TRANTYPE,0 RESULT,''T'' COLHEAD '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'END'"
        strSql += vbCrLf + "	EXEC(@@QRY)  "
        strSql += vbCrLf + "END  "
        strSql += vbCrLf + "IF (@ACFILTER='C'  OR @ACFILTER= 'B') AND @CHITDBID<>'' "
        strSql += vbCrLf + "BEGIN  "
        strSql += vbCrLf + "	SET @@QRY=''"
        strSql += vbCrLf + "	SELECT @@QRY=  'INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING (PARTICULAR,RUNNO ,TRANTYPE,TRANNO,TRANDATE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',DEBIT,CREDIT,BALANCE,NAME,AMOUNT,CTRANNO,CTRANDATE'    "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',COSTNAME,RESULT,COLHEAD ,COSTID,BATCHNO,AREAORD,AREA,FROMCOSTID'  "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',COMPANYID,LASTTRANDATE)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + 'SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,A.TRANNO AS RUNNO'   "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',''SCHEME'' TRANTYPE,A.TRANNO AS TRANNO, A.TRANDATE AS TRANDATE '  "
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',A.AMOUNT AS DEBIT, ''0'' AS CREDIT,''0'' AS BALANCE,(P.INITIAL+'' ''+P.PNAME) NAME'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ' ,A.AMOUNT,CONVERT(VARCHAR,A.CHQCARDNO+A.CHQCARDREF) AS CTRANNO  ,A.TRANDATE AS CTRANDATE       '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = A.COSTID)AS COSTNAME            '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',A.COSTID,A.BATCHNO  ,CONVERT(INT,1)AREAORD ,P.AREA AS AREA'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID ='"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ '(SELECT COSTID FROM '+@CHITDBID+'SAVINGS..SCHEMEMAST WHERE GROUPCODE=A.CHQCARDREF AND REGNO=A.CHQCARDNO)) AS FROMCOSTID'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ ',A.COMPANYID,CONVERT(VARCHAR(12),NULL)LASTTRANDATE              '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'FROM '+ @DBNAME +'..ACCTRAN AS A'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'INNER JOIN '+@CHITDBID+'SAVINGS..SCHEMEMAST AS S ON S.GROUPCODE=A.CHQCARDREF AND CONVERT (VARCHAR (10),S.REGNO)=A.CHQCARDNO'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'LEFT JOIN CUSTOMERINFO AS CU ON CU.BATCHNO = A.BATCHNO'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'LEFT JOIN PERSONALINFO AS P ON P.SNO = CU.PSNO'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'WHERE A.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''''"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND ISNULL(A.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMP_OUT_COSTCENTRE)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND ISNULL(A.CANCEL,'''') = ''''  AND ISNULL(A.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMP_OUT_COMPANY)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'AND ISNULL(A.PAYMODE,'''') IN (''SS'')'"
        strSql += vbCrLf + "	EXEC(@@QRY)"
        strSql += vbCrLf + "	SELECT @@QRY=  'IF(SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_OUTSTANDING)>0 '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'BEGIN'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(PARTICULAR,TRANTYPE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'SELECT ''SCHEME'',''SCHEME'',0 RESULT,''T'' COLHEAD '"
        strSql += vbCrLf + "	SELECT @@QRY= @@QRY + CHAR(13)+ 'END'"
        strSql += vbCrLf + "	EXEC(@@QRY)  "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "SELECT @@QRY=  'IF(SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_OUTSTANDING)>0 '"
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + CHAR(13)+ 'BEGIN'"
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + CHAR(13)+  'INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,PARTICULAR,DEBIT,CREDIT,RESULT,COLHEAD)'"
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + CHAR(13)+ 'SELECT DISTINCT TRANTYPE,''SUB TOTAL'',SUM(DEBIT),SUM(CREDIT),2 RESULT,''S'' COLHEAD FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT=1 GROUP BY TRANTYPE'"
        strSql += vbCrLf + "SELECT @@QRY= @@QRY + CHAR(13)+ 'END'"
        strSql += vbCrLf + "EXEC(@@QRY)  "
        strSql += vbCrLf + "SELECT @@QRY=  'SELECT * FROM TEMPTABLEDB..TEMP_OUTSTANDING ORDER BY TRANTYPE,RESULT'"
        strSql += vbCrLf + "EXEC(@@QRY)  "
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub
    Private Sub SP_COMPARE_AUDIT_VS_MASTER()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='COMPARE_AUDIT_VS_MASTER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE COMPARE_AUDIT_VS_MASTER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "CREATE PROCEDURE COMPARE_AUDIT_VS_MASTER  "
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "    @AUDITDB VARCHAR(20)  "
        strSql += vbCrLf + "   ,@DBNAME VARCHAR(20)"
        strSql += vbCrLf + "   ,@EDITDATE VARCHAR(15)  "
        strSql += vbCrLf + "   ,@USER VARCHAR(3)  "
        strSql += vbCrLf + "   ,@WITHVALUE VARCHAR(2)  "
        strSql += vbCrLf + "  )  "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  DECLARE @QRY NVARCHAR(4000)    "
        strSql += vbCrLf + "  DECLARE @QRY1 NVARCHAR(450)    "
        strSql += vbCrLf + "  DECLARE @TABLENAME VARCHAR(50)  "
        strSql += vbCrLf + "  DECLARE @COLNAME VARCHAR(50)  "
        strSql += vbCrLf + "  DECLARE @USERID VARCHAR(50)  "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @QRY='IF OBJECT_ID(''TEMPTABLEDB..AUDIT_VS_MASTER'')IS NOT NULL DROP TABLE TEMPTABLEDB..AUDIT_VS_MASTER'  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY + ' CREATE TABLE TEMPTABLEDB..AUDIT_VS_MASTER(USERID VARCHAR(3),TABLENAME VARCHAR(50),COLUMNNAME VARCHAR(100),OLDVALUE VARCHAR(50),NEWVALUE VARCHAR(100))'  "
        strSql += vbCrLf + "   PRINT @QRY  "
        strSql += vbCrLf + "   EXEC(@QRY)  "
        strSql += vbCrLf + "   DECLARE @CUR CURSOR   "
        strSql += vbCrLf + "   SET @CUR= CURSOR FOR SELECT DISTINCT NAME FROM sysobjects WHERE XTYPE='U' AND NAME NOT IN('SOFTCONTROL','ESTOUTSTANDING')"
        strSql += vbCrLf + "   union all SELECT DISTINCT NAME FROM " & tranDbName & "..sysobjects  WHERE XTYPE='U' AND NAME NOT IN('W_SOFTCONTROLTRAN','ESTOUTSTANDING','SOFTCONTROLTRAN','TBILLCONTROL','SNOCREATOR')"
        strSql += vbCrLf + "   OPEN @CUR   "
        strSql += vbCrLf + "   WHILE 1=1  "
        strSql += vbCrLf + "    BEGIN  "
        strSql += vbCrLf + "     FETCH NEXT FROM @CUR INTO @TABLENAME  "
        strSql += vbCrLf + "     IF @@FETCH_STATUS=-1 BREAK  "
        strSql += vbCrLf + "     DECLARE @TYPE VARCHAR(1)"
        strSql += vbCrLf + "     DECLARE @DB VARCHAR(20)"
        strSql += vbCrLf + "     IF OBJECT_ID(''+ @TABLENAME +'')IS NOT NULL "
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "     SET @TYPE='A'"
        strSql += vbCrLf + "     SET @DB=''"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "     ELSE"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "     SET @TYPE='T'"
        strSql += vbCrLf + "     SET @DB=@DBNAME"
        strSql += vbCrLf + "     END"

        strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM PKCONSTRAINT WHERE TABLENAME=@TABLENAME)>0  "
        strSql += vbCrLf + "     AND (SELECT COUNT(*) FROM (SELECT * FROM INFORMATION_SCHEMA.COLUMNS WHERE  TABLE_NAME=@TABLENAME AND COLUMN_NAME='USERID'"
        strSql += vbCrLf + "     UNION ALL SELECT * FROM " & tranDbName & ".INFORMATION_SCHEMA.COLUMNS WHERE  TABLE_NAME=@TABLENAME AND COLUMN_NAME='USERID')X)>0  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     DECLARE @PKCOLUMN VARCHAR(50)  "
        strSql += vbCrLf + "     SELECT @PKCOLUMN=PK_COLUMN FROM PKCONSTRAINT WHERE TABLENAME=@TABLENAME AND PK_COLUMN NOT LIKE '%,%'  "
        strSql += vbCrLf + "     DECLARE CUR2 CURSOR FOR "
        strSql += vbCrLf + "     SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME=@TABLENAME AND COLUMN_NAME NOT IN('UPDATED','UPTIME','CRTIME','CRDATE')   "
        strSql += vbCrLf + "     UNION ALL"
        strSql += vbCrLf + "     SELECT COLUMN_NAME FROM " & tranDbName & ".INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME=@TABLENAME AND COLUMN_NAME NOT IN('UPDATED','UPTIME','CRTIME','CRDATE')   "
        strSql += vbCrLf + "     OPEN CUR2  "
        strSql += vbCrLf + "     WHILE 1=1  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "      FETCH NEXT FROM CUR2 INTO @COLNAME  "
        strSql += vbCrLf + "      IF @@FETCH_STATUS=-1 BREAK  "
        strSql += vbCrLf + "      SELECT @QRY=' INSERT INTO TEMPTABLEDB..AUDIT_VS_MASTER(USERID,TABLENAME,COLUMNNAME,NEWVALUE,OLDVALUE)'  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' SELECT USERID,'''+ @TABLENAME +''','''+@COLNAME +''',CONVERT(VARCHAR(100),BCOL)NEWVALUE,CONVERT(VARCHAR(100),ACOL)OLDVALUE'  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' FROM ('  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' SELECT B.USERID,A.'+ @COLNAME +' AS ACOL ,B.'+ @COLNAME +' AS BCOL FROM  '+ @AUDITDB  +'..AUDIT_'+@TYPE+'_'+ @TABLENAME +' A '  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' INNER JOIN '+@DB+'..'+ @TABLENAME +' AS B  ON A.'+ @PKCOLUMN +'=B.'+ @PKCOLUMN +''  "
        strSql += vbCrLf + "      /*SELECT @QRY = @QRY +' WHERE CONVERT(VARCHAR(15),ISNULL(A.UPDATED,''''),111)='''+ @EDITDATE  +''''*/  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' WHERE ISNULL(A.UPDATED,'''')='''+ @EDITDATE  +''''  "
        strSql += vbCrLf + "      IF @USER<>'ALL' SELECT @QRY = @QRY +' AND ISNULL(B.USERID,'''')='+ @USER  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' )X'  "
        strSql += vbCrLf + "      SELECT @QRY = @QRY +' WHERE X.BCOL <> X.ACOL'  "
        strSql += vbCrLf + "      PRINT @QRY  "
        strSql += vbCrLf + "      EXEC (@QRY)  "
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "     CLOSE CUR2  "
        strSql += vbCrLf + "     DEALLOCATE CUR2  "
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "    END   "
        strSql += vbCrLf + "    CLOSE @CUR  "
        strSql += vbCrLf + "    DEALLOCATE @CUR  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  IF @WITHVALUE='N'  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "   SELECT @TABLENAME=''  "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..AUDIT_VS_MASTER_RES')IS NOT NULL DROP TABLE TEMPTABLEDB..AUDIT_VS_MASTER_RES  "
        strSql += vbCrLf + "   SELECT DISTINCT TABLENAME,USERID,CONVERT(VARCHAR(500),'')DESCRIPTION INTO TEMPTABLEDB..AUDIT_VS_MASTER_RES FROM TEMPTABLEDB..AUDIT_VS_MASTER  "
        strSql += vbCrLf + "   DECLARE CUR1 CURSOR FOR SELECT DISTINCT TABLENAME,USERID FROM TEMPTABLEDB..AUDIT_VS_MASTER_RES  "
        strSql += vbCrLf + "   OPEN CUR1  "
        strSql += vbCrLf + "   WHILE 1=1  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "    FETCH NEXT FROM CUR1 INTO @TABLENAME,@USERID  "
        strSql += vbCrLf + "    IF @@FETCH_STATUS=-1 BREAK  "
        strSql += vbCrLf + "    SELECT @QRY1=''  "
        strSql += vbCrLf + "    DECLARE CUR2 CURSOR FOR SELECT DISTINCT COLUMNNAME FROM TEMPTABLEDB..AUDIT_VS_MASTER WHERE TABLENAME=@TABLENAME AND USERID=@USERID  "
        strSql += vbCrLf + "    OPEN CUR2  "
        strSql += vbCrLf + "    WHILE 1=1  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "      FETCH NEXT FROM CUR2 INTO @COLNAME  "
        strSql += vbCrLf + "      IF @@FETCH_STATUS=-1 BREAK  "
        strSql += vbCrLf + "   SELECT @QRY1 = @QRY1+ @COLNAME  "
        strSql += vbCrLf + "   SELECT @QRY1 = @QRY1+ ', '  "
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "    CLOSE CUR2  "
        strSql += vbCrLf + "    DEALLOCATE CUR2  "
        strSql += vbCrLf + "    UPDATE TEMPTABLEDB..AUDIT_VS_MASTER_RES SET DESCRIPTION=@QRY1 +'. CHANGED.'WHERE TABLENAME=@TABLENAME AND USERID=@USERID  "
        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "   CLOSE CUR1  "
        strSql += vbCrLf + "   DEALLOCATE CUR1  "
        strSql += vbCrLf + "   SELECT U.USERNAME,TABLENAME,DESCRIPTION FROM TEMPTABLEDB..AUDIT_VS_MASTER_RES  T   "
        strSql += vbCrLf + "   LEFT JOIN USERMASTER AS U ON U.USERID=T.USERID ORDER BY USERNAME,TABLENAME  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  ELSE SELECT DISTINCT U.USERNAME,TABLENAME,COLUMNNAME,OLDVALUE,NEWVALUE FROM TEMPTABLEDB..AUDIT_VS_MASTER  T   "
        strSql += vbCrLf + "  LEFT JOIN USERMASTER AS U ON U.USERID=T.USERID ORDER BY USERNAME,TABLENAME    "
        strSql += vbCrLf + "  END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub CreateUserid()
        strSql = "DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "DECLARE @TABLENAME VARCHAR(100)"
        strSql += vbCrLf + "DECLARE CUR CURSOR FOR SELECT DISTINCT NAME FROM SYSOBJECTS WHERE XTYPE='U' AND NAME NOT LIKE '%TEMP%' and NAME NOT IN('ERRORLOG')"
        strSql += vbCrLf + "OPEN CUR"
        strSql += vbCrLf + "WHILE 1=1"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "FETCH NEXT FROM CUR INTO @TABLENAME"
        strSql += vbCrLf + "IF @@FETCH_STATUS=-1 BREAK"
        strSql += vbCrLf + "IF NOT EXISTS( SELECT * FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME =@TABLENAME"
        strSql += vbCrLf + "AND  COLUMN_NAME = 'USERID')"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SELECT @QRY='ALTER TABLE ['+ @TABLENAME +'] ADD USERID INT' "
        strSql += vbCrLf + "PRINT @QRY"
        strSql += vbCrLf + "EXEC (@QRY)"
        strSql += vbCrLf + "END"
        strSql += vbCrLf + "END"
        strSql += vbCrLf + "CLOSE CUR"
        strSql += vbCrLf + "DEALLOCATE CUR"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_WEB_CUST_MOBILEWISE()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='WEB_CUST_MOBILEWISE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE WEB_CUST_MOBILEWISE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "CREATE PROCEDURE WEB_CUST_MOBILEWISE  "
        strSql += vbCrLf + " (@MOBILENO VARCHAR(20))            "
        strSql += vbCrLf + " AS BEGIN          "
        strSql += vbCrLf + " DECLARE @DBNAME VARCHAR(50)        "
        strSql += vbCrLf + " DECLARE @STRSQL VARCHAR(MAX)       "
        strSql += vbCrLf + " DECLARE @COUNT AS INTEGER        "
        strSql += vbCrLf + " DECLARE @CHITDB AS VARCHAR(1)"
        strSql += vbCrLf + " DECLARE @CHITDBPREFIX AS VARCHAR(3)"
        strSql += vbCrLf + " SET @CHITDB ='N' "
        strSql += vbCrLf + " SET @STRSQL ='' "
        strSql += vbCrLf + " SET @COUNT = 0 "
        strSql += vbCrLf + " SELECT @CHITDB =ISNULL(CTLTEXT,'N') FROM SOFTCONTROL WHERE CTLID='CHITDB' "
        strSql += vbCrLf + " SELECT @CHITDBPREFIX =ISNULL(CTLTEXT,'') FROM SOFTCONTROL WHERE CTLID='CHITDBPREFIX' "
        strSql += vbCrLf + " SELECT @STRSQL = ' SELECT * FROM ('        "
        strSql += vbCrLf + " DECLARE CURSOR_PRODUCT CURSOR    FOR SELECT NAME AS DBNAME  FROM SYS.DATABASES WHERE NAME IN(SELECT DBNAME FROM DBMASTER) ORDER BY DBNAME;        "
        strSql += vbCrLf + " OPEN CURSOR_PRODUCT;        "
        strSql += vbCrLf + " FETCH NEXT FROM CURSOR_PRODUCT INTO    @DBNAME;        "
        strSql += vbCrLf + " WHILE @@FETCH_STATUS = 0        "
        strSql += vbCrLf + " BEGIN        "
        strSql += vbCrLf + " IF @COUNT >0        "
        strSql += vbCrLf + " BEGIN        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'UNION ALL'        "
        strSql += vbCrLf + " END        "
        strSql += vbCrLf + " ELSE IF @COUNT =0        "
        strSql += vbCrLf + " BEGIN        "
        strSql += vbCrLf + " SET @COUNT = @COUNT +1        "
        strSql += vbCrLf + " END        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ ' SELECT  SUBSTRING('''+@DBNAME+''',4,LEN('''+@DBNAME+''')) AS DBYEAR,CONVERT(VARCHAR,A.TRANDATE ,105)TRANDATE,TRANNO,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT,A.COSTID,'        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ '(SELECT PAYDESC FROM TRANPAYMODE WHERE PAYMODE =A.PAYMODE)TYPE,'     "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ '(CASE WHEN PAYMODE IN(''SA'',''RD'',''OD'') THEN''SALES'' WHEN PAYMODE IN(''PU'',''SR'') THEN ''RECEIPT'' WHEN PAYMODE IN(''AR'',''AA'',''DR'',''OR'') THEN ''OUTSTANDING'' ELSE ''OTHERS'' END )PAYTYPE,'          "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'PAYMODE,C.PNAME,C.MOBILE,A.BATCHNO '        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ ','''' GROUPCODE,''0'' REGNO,''01-01-1900'' DOCLOSE,A.TRANDATE AS TDATE'    "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ ',0 AS AGE'    "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'FROM '+@DBNAME+'..ACCTRAN A , CUSTOMERINFO B,'    "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'PERSONALINFO AS C'        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'WHERE A.BATCHNO = B.BATCHNO'         "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'AND B.PSNO = C.SNO'         "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'AND C.MOBILE = '''+@MOBILENO+''''         "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'AND ISNULL(A.CANCEL,'''')='''' '        "
        strSql += vbCrLf + " SELECT @STRSQL = @STRSQL+CHAR(13)+ 'GROUP BY A.TRANDATE,TRANNO,PAYMODE,C.PNAME,C.MOBILE,A.BATCHNO,A.COSTID'        "
        strSql += vbCrLf + " FETCH NEXT FROM CURSOR_PRODUCT INTO @DBNAME;        "
        strSql += vbCrLf + " END;       "
        strSql += vbCrLf + " IF @CHITDB='Y'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'UNION ALL'        "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'SELECT  NULL  DBYEAR,CONVERT(VARCHAR,S.JOINDATE ,105)TRANDATE,''0'' TRANNO,NULL GRSWT,NULL NETWT,SUM(T.AMOUNT)AMOUNT,S.COSTID,'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ '''CHIT''TYPE,'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ '''SS'' PAYTYPE,'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'NULL PAYMODE,P.PNAME,P.MOBILE,NULL  BATCHNO,'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'UPPER(T.GROUPCODE),T.REGNO,CONVERT(VARCHAR,S.DOCLOSE ,105)DOCLOSE,S.JOINDATE AS TDATE,0 AS AGE FROM ' + @CHITDBPREFIX + 'SAVINGS..SCHEMEMAST S'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'INNER JOIN ' + @CHITDBPREFIX + 'SAVINGS..PERSONALINFO P ON S.SNO=P.PERSONALID'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'INNER JOIN ' + @CHITDBPREFIX + 'SH0708..SCHEMETRAN T ON T.GROUPCODE=S.GROUPCODE AND T.REGNO=S.REGNO'    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'WHERE P.MOBILE='''+@MOBILENO+''' OR P.MOBILE2='''+@MOBILENO+''' AND ISNULL(T.CANCEL,'''')<>''Y'''    "
        strSql += vbCrLf + " 	SELECT @STRSQL = @STRSQL+CHAR(13)+ 'GROUP BY T.GROUPCODE,T.REGNO,S.DOCLOSE,S.COSTID,P.PNAME,P.MOBILE,S.JOINDATE '    "
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " SELECT @STRSQL =@STRSQL +' )X'        "
        strSql += vbCrLf + " SELECT @STRSQL =@STRSQL +CHAR(13)+' ORDER BY TDATE DESC'        "
        strSql += vbCrLf + " CLOSE CURSOR_PRODUCT;        "
        strSql += vbCrLf + " DEALLOCATE CURSOR_PRODUCT;       "
        strSql += vbCrLf + " PRINT(@STRSQL)        "
        strSql += vbCrLf + " EXEC (@STRSQL)        "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " /*    "
        strSql += vbCrLf + " EXEC " & cnAdminDb & "..[WEB_CUST_MOBILEWISE] @MOBILENO = '9840979441'    "
        strSql += vbCrLf + " */ "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_RPT_PREVILEGESUMMARY()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PREVILEGESUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PREVILEGESUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        Dim dtDupCheck As New DataTable
        strSql = " SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dtDupCheck)

        If dtDupCheck.Rows.Count > 0 Then
            cnChitCompanyid = dtDupCheck.Rows(0).Item(0).ToString()
        Else
            cnChitCompanyid = compId
        End If



        strSql = vbCrLf + " CREATE PROCEDURE [DBO].[SP_RPT_PREVILEGESUMMARY]"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @SYSTEMID VARCHAR(10)"
        strSql += vbCrLf + " ,@FRMDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME"
        strSql += vbCrLf + " ,@WITHCHITPOINTS VARCHAR(1)"
        strSql += vbCrLf + " ,@WITHFROMTO VARCHAR(1)"
        strSql += vbCrLf + " ,@FromPoints VARCHAR(50)"
        strSql += vbCrLf + " ,@ToPoints VARCHAR(50)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " SET NOCOUNT ON"
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + " SELECT @QRY = 'IF OBJECT_ID(''MASTER..TEMP'+ @SYSTEMID +'PREVILEGESUMMARY'') IS NOT NULL DROP TABLE MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'"
        strSql += vbCrLf + " EXEC (@QRY)"
        strSql += vbCrLf + " SELECT P.PREVILEGEID,CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,AMOUNT+TAX+SC AS TOTAL"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'S')))STNWT"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')))DIAWT"
        strSql += vbCrLf + " ,PNAME CUSTOMER,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') + ISNULL(ADDRESS2,'''') ADDRESS,MOBILE PHONENO,I.TRANDATE"
        strSql += vbCrLf + " ,TRANNO,I.SNO"
        strSql += vbCrLf + " ,(SELECT METALNAME FROM " & compId & "ADMINDB..METALMAST WHERE METALID = (SELECT METALID FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE))AS METALNAME"
        strSql += vbCrLf + " ,'N'STUDDED,CONVERT(VARCHAR(250),NULL)CATNAME,'I' SEP,CONVERT(VARCHAR,REFNO) BILLNO,CONVERT(VARCHAR,REFDATE,103) BILLDATE"
        strSql += vbCrLf + " ,I.COMPANYID,I.COSTID,METALID,ITEMID,' ' AS PVGBASED,CONVERT(NUMERIC(15,4),0) AS BPOINTS ,CONVERT(NUMERIC(15,4),0) AS POINTS,' 'FIXEDRANGE"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES"
        strSql += vbCrLf + " INTO #PRIVREP"
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS I"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO AS P ON C.PSNO = P.SNO"
        strSql += vbCrLf + " WHERE I.TRANDATE <= @TODATE AND TRANTYPE IN ('SA')"
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'') = ''"
        strSql += vbCrLf + " AND P.PREVILEGEID IS NOT NULL"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT P.PREVILEGEID,CATCODE,PCS*(-1) PCS,GRSWT*(-1) GRSWT,NETWT*(-1) NETWT,AMOUNT*(-1) AMOUNT,TAX*(-1) TAX,SC*(-1) SC,(AMOUNT+TAX+SC)*(-1) AS TOTAL"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'S')))STNWT"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM " & tranDbName & "..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')))DIAWT"
        strSql += vbCrLf + " ,PNAME CUSTOMER,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') + ISNULL(ADDRESS2,'''') ADDRESS,MOBILE PHONENO,I.TRANDATE"
        strSql += vbCrLf + " ,TRANNO,I.SNO"
        strSql += vbCrLf + " ,(SELECT METALNAME FROM " & compId & "ADMINDB..METALMAST WHERE METALID = (SELECT METALID FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE))AS METALNAME"
        strSql += vbCrLf + " ,'N'STUDDED,CONVERT(VARCHAR(250),NULL)CATNAME,'I' SEP,CONVERT(VARCHAR,REFNO) BILLNO,CONVERT(VARCHAR,REFDATE,103) BILLDATE"
        strSql += vbCrLf + " ,I.COMPANYID,I.COSTID,METALID,ITEMID,' ' AS PVGBASED,CONVERT(NUMERIC(15,4),0) AS BPOINTS ,CONVERT(NUMERIC(15,4),0) AS POINTS,' 'FIXEDRANGE"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES"
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS I"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO AS P ON C.PSNO = P.SNO"
        strSql += vbCrLf + " WHERE I.TRANDATE <= @TODATE AND TRANTYPE IN ('SR')"
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'') = ''"
        strSql += vbCrLf + " AND P.PREVILEGEID IS NOT NULL"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT P.PREVILEGEID,ISST.CATCODE,ISST.STNPCS,CASE WHEN ISST.STONEUNIT='C' THEN  STNWT/5 ELSE STNWT  END"
        strSql += vbCrLf + " ,CASE WHEN ISST.STONEUNIT='C' THEN  STNWT/5 ELSE STNWT  END,ISST.STNAMT,NULL,NULL,NULL"
        strSql += vbCrLf + " ,NULL,NULL"
        strSql += vbCrLf + " ,PNAME CUSTOMER,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') + ISNULL(ADDRESS2,'''') ADDRESS,MOBILE PHONENO,I.TRANDATE"
        strSql += vbCrLf + " ,I.TRANNO,I.SNO"
        strSql += vbCrLf + " ,(SELECT METALNAME FROM " & compId & "ADMINDB..METALMAST WHERE METALID = (SELECT METALID FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = ISST.CATCODE))AS METALNAME"
        strSql += vbCrLf + " ,'N'STUDDED,CONVERT(VARCHAR(250),NULL)CATNAME,'I' SEP,CONVERT(VARCHAR,REFNO) BILLNO,CONVERT(VARCHAR,REFDATE,103) BILLDATE "
        strSql += vbCrLf + " ,I.COMPANYID,I.COSTID,(SELECT METALID FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = ISST.CATCODE) METALID,ISST.STNITEMID,' ' AS PVGBASED,CONVERT(NUMERIC(15,4),0) AS BPOINTS ,CONVERT(NUMERIC(15,4),0) AS POINTS,' 'FIXEDRANGE"
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES"
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSSTONE  ISST"
        strSql += vbCrLf + " LEFT OUTER JOIN " & tranDbName & "..ISSUE AS I ON I.SNO=ISST.ISSSNO"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO AS P ON C.PSNO = P.SNO"
        strSql += vbCrLf + " WHERE I.TRANDATE <= @TODATE AND I.TRANTYPE IN ('SA')"
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'') = ''"
        strSql += vbCrLf + " AND P.PREVILEGEID IS NOT NULL"
