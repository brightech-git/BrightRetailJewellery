    Function AdmindbInsertValuesToPwdOption(ByVal rootdb As String, ByVal Menuid As String, ByVal Optname As String, ByVal OptKey As String, ByVal OptType As String) As Integer
        Dim dt As New DataTable

        dt.Clear()
        strSql = " select 1 from " & rootdb & "..SMSTEMPLATE WHERE TEMPLATE_NAME = '" & Optname & "'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
        If dt.Rows.Count = 0 Then
            AdmindbInsertValuesToSmsTemplate(compId & "ADMINDB", Optname, Optname, "Pls Share the OTP <OTP> for " + Optname + ". Initiated by <USERNAME>, <COMPANY>.", "C")
        End If
        dt.Clear()
        strSql = " select 1 from " & rootdb & "..PRJPWDOPTION WHERE OPTIONNAME = '" & Optname & "'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
        If dt.Rows.Count > 0 Then
            Return 0
        End If
        dt.Clear()
        strSql = " SELECT ISNULL(MAX(ISNULL(OPTIONID,0)),0) from " & rootdb & "..PRJPWDOPTION "
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
