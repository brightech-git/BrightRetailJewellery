    Private Sub FuncSP_InsertVacontrol()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_INSERT_VACONTROL')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_INSERT_VACONTROL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE [dbo].[SP_INSERT_VACONTROL]"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "  	DECLARE @COMPANYID VARCHAR(3)"
        strSql += vbCrLf + "  	DECLARE @COSTIDS VARCHAR(2)"
        strSql += vbCrLf + "  	DECLARE @VATYPE VARCHAR(1)"
        strSql += vbCrLf + "  	SELECT @COMPANYID = CTLTEXT FROM SOFTCONTROL WHERE CTLID='COMPANYID' "
        strSql += vbCrLf + "  	SELECT @COSTIDS = CTLTEXT FROM SOFTCONTROL WHERE CTLID='COSTID' "
        strSql += vbCrLf + "  	SELECT @VATYPE = CTLTEXT FROM SOFTCONTROL WHERE CTLID='FINALAMT_LOCKBASE' "
        strSql += vbCrLf + "  	SELECT @QRY='IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPVACONTROL'')> 0 DROP TABLE TEMPTABLEDB..TEMPVACONTROL'"
        strSql += vbCrLf + "  	EXEC (@QRY)"
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM VACONTROL)= 0 "
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  	IF (SELECT TOP 1 1 FROM ITEMMAST WHERE ISNULL(DISCVAPER,0)<>0 OR ISNULL(DISCPERGM,0)<>0 OR ISNULL(DISCFIXPER,0)<>0 OR ISNULL(MARGINPER,0)<>0 OR ISNULL(MARGINVALUE,0)<>0) =1 OR (SELECT TOP 1 1 FROM SUBITEMMAST WHERE ISNULL(DISCVAPER,0)<>0 OR ISNULL(DISCPERGM,0)<>0 OR ISNULL(DISCFIXPER,0)<>0 OR ISNULL(MARGINPER,0)<>0 OR ISNULL(MARGINVALUE,0)<>0) =1 OR(SELECT TOP 1 1 FROM WMCTABLE WHERE ISNULL(MARGINPER,0)<>0  AND ISNULL(TABLECODE,'')<>'')=1"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SELECT @QRY = ' SELECT TABLECODE,CONVERT(VARCHAR(15),'''') SNO,COSTID,ITEMID,SUBITEMID,VATYPE,VAPER,VAPERGM,VAFIXPER,WASTPER,MCPER,COMPANYID,IDENTITY(INT,1,1)AS KEYNO INTO TEMPTABLEDB..TEMPVACONTROL FROM ('"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' SELECT TABLECODE,NULL SNO,'''+@COSTIDS+''' COSTID,ITEMID,0 AS SUBITEMID,'''+@VATYPE+''' AS VATYPE'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(MARGINPER,0)<>0 THEN ISNULL(MARGINPER,0) ELSE ISNULL(DISCVAPER,0) END VAPER'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(MARGINVALUE,0)<>0 THEN ISNULL(MARGINVALUE,0) ELSE ISNULL(DISCPERGM,0) END VAPERGM'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,ISNULL(DISCFIXPER,0) VAFIXPER,0 WASTPER,0 MCPER,'''+@COMPANYID+''' COMPANYID FROM ITEMMAST' "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' WHERE ISNULL(DISCVAPER,0)<>0 OR ISNULL(DISCPERGM,0)<>0 OR ISNULL(DISCFIXPER,0)<>0 OR ISNULL(MARGINPER,0)<>0 OR ISNULL(MARGINVALUE,0)<>0' "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' SELECT TABLECODE,NULL SNO,'''+@COSTIDS+''' COSTID,ITEMID,SUBITEMID,'''+@VATYPE+''' AS VATYPE'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(MARGINPER,0)<>0 THEN ISNULL(MARGINPER,0) ELSE ISNULL(DISCVAPER,0) END VAPER'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(MARGINVALUE,0)<>0 THEN ISNULL(MARGINVALUE,0) ELSE ISNULL(DISCPERGM,0) END VAPERGM'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,ISNULL(DISCFIXPER,0) VAFIXPER,0 WASTPER,0 MCPER,'''+@COMPANYID+''' COMPANYID FROM SUBITEMMAST' "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' WHERE ISNULL(DISCVAPER,0)<>0 OR ISNULL(DISCPERGM,0)<>0 OR ISNULL(DISCFIXPER,0)<>0 OR ISNULL(MARGINPER,0)<>0 OR ISNULL(MARGINVALUE,0)<>0' "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' SELECT DISTINCT TABLECODE,NULL SNO,COSTID,ISNULL(ITEMID,0)ITEMID,ISNULL(SUBITEMID,0) SUBITEMID,'''+@VATYPE+''' AS  VATYPE'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(MARGINPER,0)<>0 THEN ISNULL(MARGINPER,0) ELSE 0 END VAPER,ISNULL(MARGINVALUE,0) VAPERGM,0 VAFIXPER,0 WASTPER,0 MCPER,'''+@COMPANYID+''' COMPANYID FROM WMCTABLE' "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' WHERE  ISNULL(TABLECODE,'''')<>'''' OR ISNULL(MARGINPER,0)<>0 OR ISNULL(MARGINVALUE,0)<>0 '"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + ' ) X ORDER BY ITEMID,SUBITEMID'"
        strSql += vbCrLf + "  		PRINT @QRY"
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  		SELECT @QRY =' UPDATE TEMPTABLEDB..TEMPVACONTROL SET SNO = KEYNO'"
        strSql += vbCrLf + "  		EXEC (@QRY)"


        strSql += vbCrLf + "  		SET @QRY = 'DECLARE @CUR_SNO VARCHAR(15)"
        strSql += vbCrLf + "  		DECLARE CUR CURSOR"
        strSql += vbCrLf + "  		FOR SELECT ISNULL(SNO,'''') FROM TEMPTABLEDB..TEMPVACONTROL"
        strSql += vbCrLf + "  		OPEN CUR"
        strSql += vbCrLf + "  		WHILE 1=1"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		FETCH NEXT FROM CUR INTO @CUR_SNO"
        strSql += vbCrLf + "  		IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "  		DECLARE @NEW_SNO VARCHAR(15) "
        strSql += vbCrLf + "  		DECLARE @COSTID VARCHAR(2)"
        strSql += vbCrLf + "  		DECLARE @COMPANYID VARCHAR(3)"
        strSql += vbCrLf + "  		SELECT @COSTID = COSTID,@COMPANYID = COMPANYID FROM TEMPTABLEDB..TEMPVACONTROL WHERE SNO = @CUR_SNO"
        strSql += vbCrLf + "  		EXEC " & tranDbName & "..GET_SNO_ADMIN "
        strSql += vbCrLf + "  		@COSTID =@COSTID,@CTLID =''VACONTROLCODE'',@CHECKTABLENAME =''VACONTROL'',@COMPANYID=@COMPANYID,@RETVALUE=@NEW_SNO  OUTPUT"
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPVACONTROL SET SNO = @NEW_SNO WHERE CURRENT OF CUR"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		CLOSE CUR"
        strSql += vbCrLf + "  		DEALLOCATE CUR'"
        strSql += vbCrLf + "  		EXEC (@QRY)"

        strSql += vbCrLf + "  		SELECT @QRY = ' INSERT INTO VACONTROL (SNO,COSTID,ITEMID,SUBITEMID,TABLECODE,VATYPE,VAPER,VAPERGM,VAFIXPER,WASTPER,MCPER,ACTIVE)'"
        strSql += vbCrLf + "  		SELECT @QRY =@QRY + ' SELECT SNO,COSTID,ITEMID,SUBITEMID,TABLECODE,VATYPE,VAPER,VAPERGM,VAFIXPER,WASTPER,MCPER,''Y'' ACTIVE FROM TEMPTABLEDB..TEMPVACONTROL'"
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  END"


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_DAYBOOKWITHJOURNAL_NEW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_DAYBOOKWITHJOURNAL_NEW')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_DAYBOOKWITHJOURNAL_NEW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        'strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_DAYBOOKWITHJOURNAL_NEW ("
        'strSql += vbCrLf + "     @DBNAME VARCHAR(20),@TEMPTABLE VARCHAR(20),@FROMDATE VARCHAR(12),@TODATE VARCHAR(12)     "
        'strSql += vbCrLf + "     ,@OPENING VARCHAR(1),@COMPANYID VARCHAR(3)    "
        'strSql += vbCrLf + "     ,@COSTID VARCHAR(300),@DETAILED VARCHAR(1)"
        'strSql += vbCrLf + "     ) AS      "
        'strSql += vbCrLf + "     BEGIN    "
        'strSql += vbCrLf + "     DECLARE @QUERY NVARCHAR(4000)"
        'strSql += vbCrLf + "     DECLARE @POSJFILTER VARCHAR(100)    "
        'strSql += vbCrLf + "     DECLARE @POSBFILTER VARCHAR(100)    "
        'strSql += vbCrLf + "     DECLARE @SALEFILTER VARCHAR(1000)    "
        'strSql += vbCrLf + "     DECLARE @PURFILTER VARCHAR(1000)    "
        'strSql += vbCrLf + "     DECLARE @CRFILTER VARCHAR(1000)    "
        'strSql += vbCrLf + "     DECLARE @ADVFILTER VARCHAR(1000)    "
        'strSql += vbCrLf + "     SET @QUERY = ' IF  EXISTS (SELECT * FROM SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '    "
        'strSql += vbCrLf + "     +''''+@TEMPTABLE+''''+' )'    "
        'strSql += vbCrLf + "     +    "
        'strSql += vbCrLf + "      'DROP TABLE ' + @TEMPTABLE     "
        'strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY    "
        'strSql += vbCrLf + "     SET @QUERY = 'CREATE TABLE ' + @TEMPTABLE+  '( [COMPANYID] [VARCHAR](5),[COSTID] [VARCHAR](5),TRANDATE DATETIME,PAYHEAD VARCHAR(50),PAYMODE VARCHAR(2),[PARTICULARS] [VARCHAR](100),[ACCODE] VARCHAR(10),[CONTRA] VARCHAR(10),'    "
        'strSql += vbCrLf + "     SELECT  @QUERY = @QUERY + '[BATCHNO] VARCHAR(20),TRANNO VARCHAR(20),JDEBIT DECIMAL(12,2) DEFAULT 0,JCREDIT DECIMAL(12,2) DEFAULT 0,'    "
        'strSql += vbCrLf + "     SELECT  @QUERY = @QUERY + '[DEBIT] DECIMAL(12,2) DEFAULT 0,[CREDIT] DECIMAL(12,2) DEFAULT 0,BILLTYPE VARCHAR(1),ORDERNO INT '    "
        'strSql += vbCrLf + "     SELECT @QUERY = @QUERY + ') ON [PRIMARY]'    "
        'strSql += vbCrLf + "     PRINT @QUERY"
        'strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY    "
        'strSql += vbCrLf + "      DECLARE @CASHID VARCHAR(10)    "
        'strSql += vbCrLf + "      SELECT @CASHID =CTLTEXT FROM SOFTCONTROL WHERE CTLID LIKE 'CASH'    "
        'strSql += vbCrLf + "      SET @POSBFILTER = '1=1'    "
        'strSql += vbCrLf + "      SET @POSJFILTER = 'ACCODE NOT IN ('''+@CASHID+''') AND CONTRA NOT IN ('''+@CASHID+''')'     "
        'strSql += vbCrLf + "      SET @SALEFILTER = 'SELECT BATCHNO FROM '+@DBNAME+'..ISSUE WHERE ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID IN ('''+@COMPANYID+''') AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''     "
        'strSql += vbCrLf + "      SET @PURFILTER = 'SELECT BATCHNO FROM '+@DBNAME+'..RECEIPT WHERE ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID IN ('''+@COMPANYID+''') AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''     "
        'strSql += vbCrLf + "      SET @CRFILTER = 'SELECT BATCHNO FROM '+@DBNAME+'..OUTSTANDING WHERE TRANTYPE = ''D'' AND RECPAY = ''P'' AND ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID IN ('''+@COMPANYID+''') AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''     "
        'strSql += vbCrLf + "      SET @ADVFILTER = 'SELECT BATCHNO FROM '+@DBNAME+'..OUTSTANDING WHERE ISNULL(CANCEL,'''') <> ''Y'' AND TRANTYPE = ''A'' AND COMPANYID IN ('''+@COMPANYID+''') AND TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''     "
        'strSql += vbCrLf + "      SELECT @QUERY ='INSERT INTO '+@TEMPTABLE+'(TRANDATE,PAYHEAD,PAYMODE,PARTICULARS,CREDIT)'    "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+' SELECT '''+@FROMDATE+''' AS DATE, ''OP'',''OP'',''CASH OPENING'' AS PARTICULARS '    "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+',ISNULL((SELECT SUM(DEBIT-CREDIT) FROM '+@DBNAME+'..OPENTRAILBALANCE WHERE ACCODE IN ('''+@CASHID+''')  AND COMPANYID IN ('''+@COMPANYID+''')),0)'     "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+'+ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM '+@DBNAME+'..ACCTRAN WHERE TRANDATE < '''+@FROMDATE+''' AND ACCODE IN ('''+@CASHID+''') AND ISNULL(CANCEL,'''') <> ''Y'''     "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+' AND COMPANYID IN ('''+@COMPANYID+''')),0)'  "
        'strSql += vbCrLf + "      PRINT @QUERY  "
        'strSql += vbCrLf + "      EXECUTE SP_EXECUTESQL @QUERY"
        'strSql += vbCrLf + "      SELECT @QUERY ='INSERT INTO '+@TEMPTABLE+'(TRANDATE,TRANNO,BATCHNO,PAYHEAD,PAYMODE,ACCODE,CONTRA,PARTICULARS,JDEBIT,JCREDIT,BILLTYPE)'    "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+' SELECT TRANDATE,TRANNO,BATCHNO,PAYMODE, PAYMODE,ACCODE, CONTRA,'''',CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) END JDEBIT,CASE WHEN TRANMODE = ''C'' THEN ISNULL(AMOUNT,0) END JCREDIT'   "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+',''C'' AS BILLTYPE FROM '+@DBNAME+'..ACCTRAN WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''    "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+' AND ISNULL(CANCEL,'''') <> ''Y'' AND FROMFLAG = ''P'' AND COMPANYID IN ('''+@COMPANYID+''') '    "
        'strSql += vbCrLf + "      SELECT @QUERY =@QUERY+' AND (BATCHNO IN ('+@SALEFILTER+')'    "
