        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  ELSE CASE WHEN TRANTYPE = ''PU'' THEN (AMOUNT+ISNULL((WASTAGE+DUSTWT)*RATE,0))-ISNULL((SELECT SUM(STNAMT) FROM '+ @DBNAME +'..RECEIPTSTONE WHERE ISSSNO = R.SNO),0) '"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  ELSE AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM '+ @DBNAME +'..RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END END RAMOUNT,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  0 IPCS,0 IGRSWT,0 INETWT,0 IAMOUNT FROM '+ @DBNAME +'..RECEIPT R'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  WHERE ISNULL(CANCEL,'''') <> ''Y''  AND TRANTYPE<>''RRC'''"
        strSql += vbCrLf + "   IF @COMPANYID <> 'ALL' "
        strSql += vbCrLf + "        SELECT @QRY = @QRY +CHAR(13) +' AND COMPANYID ='''+ @COMPANYID +''''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  AND COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE'+ @SYSTEMID+')'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  AND CATCODE IN (SELECT CATCODE FROM '+ @ADMINDB +'..CATEGORY WHERE METALID IN (SELECT METALID FROM #METALMAST))'  "
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  UNION ALL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  SELECT ''1'' AS DTYPE,CASE WHEN TRANTYPE IN (''SR'',''PU'') THEN 0 ELSE TRANNO END TRANNO,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  TRANDATE,TRANTYPE,CATCODE,CASE WHEN TRANTYPE IN (''SR'',''PU'') THEN '''' ELSE SNO END SNO,'''' AS ACCODE,'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  STNPCS RPCS,STNWT RGRSWT,STNWT RNETWT,STNAMT RAMOUNT,0 IPCS,0 IGRSWT,0 INETWT,0 IAMOUNT FROM '+ @DBNAME +'..RECEIPTSTONE'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  WHERE BATCHNO IN (SELECT BATCHNO FROM '+ @DBNAME +'..RECEIPT WHERE ISNULL(CANCEL,'''') <> ''Y''  AND TRANTYPE<>''RRC'') '"
        strSql += vbCrLf + "   IF @COMPANYID <> 'ALL' "
        strSql += vbCrLf + "        SELECT @QRY = @QRY +CHAR(13) +'  AND COMPANYID ='''+ @COMPANYID +''''"
        strSql += vbCrLf + "   SELECT @QRY = @QRY +CHAR(13) +'  AND COSTID IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE'+ @SYSTEMID+')'"
