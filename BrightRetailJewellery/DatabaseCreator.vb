        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''SG'' AND T.TRANTYPE =''AA'')AS SGST  "
