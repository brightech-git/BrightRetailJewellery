        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "              	SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY COUNTER'  "
        strSql += vbCrLf + "                      IF @WITHDIA='Y' AND @WITHSTONE='Y'"
        strSql += vbCrLf + "                      BEGIN"
        strSql += vbCrLf + "             	        SELECT @QRY= @QRY+CHAR(13)+',DIASTONE'"
        strSql += vbCrLf + "                      END"
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'IT'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY ITEMTYPE'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "        			 ELSE IF @GROUPBY = 'ME'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY METALNAME'  "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "      		 ELSE IF @GROUPBY ='HM'  /*HALLMARKWISE*/"
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY WITHHUID'   "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'DE'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY DESIGNER'  "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY CGROUP,TCGROUP'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + " 				  ELSE IF @GROUPBY = 'SG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY SGROUP'  "
        strSql += vbCrLf + "          		 END    "
        strSql += vbCrLf + "          		 ELSE  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY PARTICULAR'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "                     SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY COUNTER,(SELECT DISPLAYORDER FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'  "
        strSql += vbCrLf + "                     IF @WITHDIA='Y' AND @WITHSTONE='Y'"
        strSql += vbCrLf + "                      BEGIN"
        strSql += vbCrLf + "             	        SELECT @QRY= @QRY+CHAR(13)+',DIASTONE'"
        strSql += vbCrLf + "                      END"
        strSql += vbCrLf + "          		 END "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT DISPORDER FROM ITEMGROUPMAST WHERE GROUPNAME=T.CGROUP),COUNTERGROUP'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + " 				  IF @GROUPBY = 'SG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT SGROUPNAME FROM SUBITEMGROUP WHERE SGROUPNAME=T.SGROUP),SUBITEMGROUP'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 PRINT @QRY  "
        strSql += vbCrLf + "          		 EXEC (@QRY)  "
        strSql += vbCrLf + "          	END  "
        strSql += vbCrLf + "          END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

