        strSql += vbCrLf + "          	IF @ISORDREG = 'G' SET @REGORDFILTER= ' AND T.ORDREPNO = '''' '  "
        strSql += vbCrLf + "          	SET @CATCODE = REPLACE(@CATCODE,',',''',''')  "
        strSql += vbCrLf + "          	SET @COUNTERIDS = REPLACE(@COUNTERIDS,',',''',''')  "
