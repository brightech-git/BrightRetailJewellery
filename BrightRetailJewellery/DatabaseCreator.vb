        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,CASE WHEN IT.GRSNET=''N'' THEN IT.NETWT ELSE IT.GRSWT END WT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNPCS) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''T'',''S''))STNPCS'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNWT) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''T'',''S''))STNWT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNAMT) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''T'',''S''))STNAMT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNPCS) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''D''))DIAPCS'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNWT) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''D''))DIAWT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT SUM(STNAMT) FROM ITEMTAGSTONE IE,ITEMMAST IM /*WITH(READPAST)*/  WHERE IE.STNITEMID=IM.ITEMID AND IE.TAGNO=IT.TAGNO AND IE.ITEMID=IT.ITEMID AND TAGSNO=IT.SNO AND ISNULL(DIASTONE,'''') IN (''D''))DIAAMT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,IT.PCTFILE,IT.COSTID,D.DESIGNERNAME'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,IT.SALVALUE,(SELECT ITEMCTRNAME FROM ITEMCOUNTER WHERE ITEMCTRID=IT.ITEMCTRID) AS COUNTERNAME'"
        strSql += vbCrLf + "  SELECT @STRSQL = @STRSQL + CHAR(13) + ' ,''http:'' +REPLACE(REPLACE(IM.ITEMPCTPATH,''\'',''/''),''192.168.3.3/d'',''192.168.3.3:92'')+''\''+IT.PCTFILE PICNAME '  "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,CASE WHEN IT.ISSDATE IS NULL THEN ''LIVE'' ELSE ''SOLD'' END STATUS,IT.PURITY AS TOUCH '      "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,IT.ITEMTYPEID,IT.SIZEID TOFLAG'  "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,(SELECT NAME FROM ITEMTYPE WHERE ITEMTYPEID = IT.ITEMTYPEID)AS ITEMTYPE,(SELECT SIZENAME FROM ITEMSIZE WHERE SIZEID = IT.SIZEID)AS SIZE,(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = IT.COSTID)AS COSTNAME'  "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' FROM ITEMTAG  IT WITH(NOLOCK)'"
        strSql += vbCrLf + "  --LEFT JOIN ITEMTAGSTONE SS ON IT.SNO=SS.TAGSNO "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' INNER JOIN ITEMMAST IM   WITH(NOLOCK)/*WITH(READPAST)*/ ON IM.ITEMID =IT.ITEMID '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' LEFT JOIN SUBITEMMAST SI  WITH(NOLOCK) /*WITH(READPAST)*/ ON SI.SUBITEMID =IT.SUBITEMID '   "
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' LEFT JOIN CATEGORY CC  WITH(NOLOCK) /*WITH(READPAST)*/ ON CC.CATCODE=IM.CATCODE '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' LEFT JOIN DESIGNER D  WITH(NOLOCK) /*WITH(READPAST)*/ ON D.DESIGNERID =IT.DESIGNERID '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' WHERE   ' "
