        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " OPEN RUNCUR"
        strSql += vbCrLf + " FETCH NEXT FROM RUNCUR INTO @COLTYPE"
        strSql += vbCrLf + " WHILE @@FETCH_STATUS<>-1"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " BEGIN TRY"
        strSql += vbCrLf + " 	SET @QRY=''"
