        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY =' SELECT  (SELECT ITEMNAME FROM ITEMMAST WHERE ITEMID =X.TGITEMID)ITEM, (SELECT  SUBITEMNAME FROM SUBITEMMAST WHERE SUBITEMID=X.TGSUBITEMID)SUBITEM,'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' (SELECT ITEMNAME FROM ITEMMAST WHERE ITEMID=X.STNITEMID)STNITEM, (SELECT SUBITEMNAME FROM SUBITEMMAST WHERE SUBITEMID=X.STNSUBITEMID)STNSUBITEM,'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' STNRATE,STNAMT,STNWT,SHAPE,COLOR,CLARITY,CUT,CERTIFICATENO,TAGNO,PCTFILE,RESULT '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' INTO TEMPTABLEDB..TEMP'+@SYSID+'FOURCSTONE  FROM ('"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' SELECT TG.ITEMID AS TGITEMID,TG.SUBITEMID AS TGSUBITEMID ,NULL AS STNITEMID,NULL AS STNSUBITEMID ,TG.BOARDRATE AS STNRATE,TG.SALVALUE AS STNAMT,TG.GRSWT AS STNWT,SH.SHAPENAME AS SHAPE,'"
