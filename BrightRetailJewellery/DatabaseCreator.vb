        strSql += vbCrLf + "          	SELECT @LENGT = ISNULL(MAX(LEN(SUBITEMID)),0) FROM SUBITEMMAST"
        strSql += vbCrLf + "          	/*IF @LENGT<10 SET @LENGT='10'*/"
