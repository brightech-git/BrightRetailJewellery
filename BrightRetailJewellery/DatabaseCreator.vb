        strSql = " INSERT INTO " & rootdb & "..STATEMAST"
        strSql += vbCrLf + "  (STATEID,STATECODE,STATENAME,USERID,UPDATED,UPTIME)VALUES"
        strSql += vbCrLf + "  (" & stateId & ",'" & stateCode & "','" & stateName & "'," & userId & ""
        strSql += vbCrLf + "  ,'" & Today.Date & "','" & Date.Now.ToLongTimeString & "')"
