    Private Sub SP_RPT_SMITHBALANCEDETAILED()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SMITHBAL_DETNEW')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_SMITHBAL_DETNEW"
