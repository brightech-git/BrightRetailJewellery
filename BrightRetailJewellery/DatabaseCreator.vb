        strSql += vbCrLf + "      DECLARE @NAME VARCHAR(85)           "
        strSql += vbCrLf + "      DECLARE @MOBILE VARCHAR(30)           "
        strSql += vbCrLf + "      DECLARE CUR CURSOR            "
        strSql += vbCrLf + "      FOR SELECT DISTINCT RUNNO,TRANNO,TRANDATE,DUEDATE,TRANTYPE,AMOUNT,NAME,MOBILE            "
