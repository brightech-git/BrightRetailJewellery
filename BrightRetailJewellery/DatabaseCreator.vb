        'strSql += vbCrLf + "          SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,SUM(AMOUNT) AS AMOUNT,'' ''FLAG,''9'' RESULT,'' ''TRANDATE,'' ''TRANNO,''G''COLHEAD,''ZZZZZZZZ'' SEP'  "
