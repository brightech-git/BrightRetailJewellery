        strSql += vbCrLf + "  		    SELECT @QRY=@QRY+CHAR(13)+' ''PURCHASE'' AS VOUCHERTYPE,'"
        strSql += vbCrLf + "  		END"

        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' P.ACCODE PARTYCODE,PNAME PARTYNAME,'' '' PARTYGROUP,ISNULL(P.GSTNO,'''')GSTNO,'  "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ISNULL(P.ADDRESS1,'''') ADDRESS1,ISNULL(P.ADDRESS2,'''') ADDRESS2,ISNULL(P.ADDRESS3,'''') ADDRESS3,P.MOBILE CONTACTNO,'' '' PRODUCTGROUP'  "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ,I.ITEMID AS PRODUCTCODE'"
        strSql += vbCrLf + " 		IF @NEEDBILLPREFIX='Y' "
