        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '"
        'strSql += vbCrLf + "  		IF @USER<>'ALL'"
        'strSql += vbCrLf + "  			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.USERID,'''') IN (SELECT USERID FROM #USERNAME)'"
