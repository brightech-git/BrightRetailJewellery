        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QRY='SELECT  * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS1  FROM ('  "
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+'SELECT DISTINCT I.TRANDATE AS INVOICEDATE, I.TRANNO AS INVOICENO, ''SALES'' AS VOUCHERTYPE, PNAME, SUM(I.GRSWT)GRSWT, SUM(I.NETWT)NETWT,'"
