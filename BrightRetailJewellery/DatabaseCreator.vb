        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +'  WHEN PAYMODE = ''AA'' THEN ''ADVANCE ADJUSTED'''"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +'  WHEN PAYMODE = ''AP'' THEN ''ADVANCE PAYMENT'''"
