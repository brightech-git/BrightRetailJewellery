        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' WHERE ISSSNO = I.SNO AND TRANTYPE = I.TRANTYPE AND TAXID=''ED''))EDUCESSAMT   ,'  "
