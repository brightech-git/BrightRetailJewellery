        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +'  FROM ITEMTAG AS TG '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' INNER JOIN ITEMMAST AS IT  ON IT.ITEMID=TG.ITEMID '"
