        strSql += vbCrLf + "      PRINT (@METALID)  "
        strSql += vbCrLf + "  SELECT @GSTDATECONTROL=CTLTEXT FROM SOFTCONTROL WITH(NOLOCK) WHERE CTLID='GSTDATE'"
        strSql += vbCrLf + "  SELECT @STRSQL =' IF OBJECT_ID(''TEMPTAGINFO'',''U'')IS NOT NULL DELETE FROM TEMPTAGINFO '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+'INSERT INTO TEMPTAGINFO   SELECT TAGNO,ITEM,SUBITEM,ITEMID,SUBITEMID '"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,PCS,GRSWT,NETWT,CALTYPE,RATE,MAXWASTPER'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,CONVERT(NUMERIC(15,3),CASE WHEN MAXWASTPER<>0 THEN (WT*MAXWASTPER/100) ELSE MAXWAST END) WASTAGE '"
