    Private Sub SP_RPT_COUNTERWISESTOCK_F1()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COUNTERWISESTOCK_F1')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERWISESTOCK_F1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "CREATE PROCEDURE SP_RPT_COUNTERWISESTOCK_F1"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   @DBNAME VARCHAR(30)"
        strSql += vbCrLf + "   ,@ASONDATE  VARCHAR(15)"
        strSql += vbCrLf + "   ,@METAL VARCHAR(100)"
