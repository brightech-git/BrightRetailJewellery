        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED FROM " & cnAdminDb & "..OUTSTANDING AS O  WHERE TRANTYPE  = ''A'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(O.CANCEL,'''') <>''Y''   "
        strSql += vbCrLf + "  		AND  PAYMODE IN (''AA'',''AP'') AND O.RECPAY = ''P'' AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'')      "
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)     "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL11,COL12)      "
        strSql += vbCrLf + "  		SELECT ''SALES BY CASH'',COL11,COL12 FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1 WHERE COL1=''CASH''    "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL11,COL12,COLHEAD)    "
        strSql += vbCrLf + "  		SELECT TOP 1 ''CASH IN HAND'',0 ,ISNULL((SELECT SUM(DEBIT-CREDIT) FROM OPENTRAILBALANCE   "
        strSql += vbCrLf + "  		WHERE ACCODE IN (''' + @CASHACC + ''') AND COMPANYID  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)),0)    "
        strSql += vbCrLf + "  		+ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM ACCTRAN WHERE TRANDATE = ''' + @TODATE + ''' AND PAYMODE IN(''CA'') AND ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)),0)     "
        strSql += vbCrLf + "  		,''S1'' FROM ACCTRAN AS T WHERE TRANDATE = ''' + @TODATE + '''  "
        strSql += vbCrLf + "  		AND ISNULL(CANCEL,'''') <> ''Y''  AND ISNULL(T.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL12)    "
        strSql += vbCrLf + "  		SELECT ''TOTAL'',SUM(ISNULL(CONVERT(NUMERIC(15,2),COL12),0)) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2 WHERE COL1 IN(''TOTAL'',''CASH IN HAND'')'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		ALTER TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2 ADD KEYNO1 INT  "
        strSql += vbCrLf + "  		ALTER TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1 ADD KEYNO1 INT'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2 SET KEYNO1=KEYNO   "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1 SET KEYNO1=KEYNO '  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		ALTER TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2 DROP COLUMN KEYNO   "
        strSql += vbCrLf + "  		ALTER TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1 DROP COLUMN KEYNO '  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		SELECT @QRY= ' "
        strSql += vbCrLf + "  		DECLARE @RP1 INT   "
        strSql += vbCrLf + "  		DECLARE @RP2 INT   "
        strSql += vbCrLf + "  		SELECT @RP1 =MAX(KEYNO1) FROM TEMPTABLEDB ..TEMP'+@SYSTEMID+'DAYREPORT1   "
        strSql += vbCrLf + "  		SELECT @RP2= MAX(KEYNO1) FROM TEMPTABLEDB ..TEMP'+@SYSTEMID+'DAYREPORT2   "
        strSql += vbCrLf + "  		IF @RP1>@RP2  "
        strSql += vbCrLf + "  		BEGIN   "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2 SET KEYNO1=@RP1 wHERE KEYNO1=@RP2  "
        strSql += vbCrLf + "  		End  "
        strSql += vbCrLf + "  		ELSE  "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1 SET KEYNO1=@RP2 WHERE KEYNO1=@RP1   "
        strSql += vbCrLf + "  		End '   "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		/******************** ADV DUE SUMMARY DETAILS ******************/"
        strSql += vbCrLf + "  		/*SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVDUE'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE  "
        strSql += vbCrLf + "  		SELECT ''OPE'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE  "
        strSql += vbCrLf + "  		,CASE WHEN TRANTYPE IN (''D'',''J'') THEN CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE -1*AMOUNT END ELSE CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE -1*AMOUNT END END AS AMOUNT ,BATCHNO  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE < ''' + @FRMDATE + '''  AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''')  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''',''S'',''O'',''A'') AND TRANTYPE <> ''T''  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT ''REC'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE,CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE 0 END AS AMOUNT,BATCHNO  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND RECPAY = ''R'' AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''')  IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''',"
        strSql += vbCrLf + "  		''S'',''O'',''A'') AND TRANTYPE <> ''T''  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT ''PAY'' SEP,CASE WHEN SUBSTRING(RUNNO,6,1) IN (''O'',''R'') THEN ''O'' ELSE TRANTYPE END TRANTYPE,CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE 0 END AS AMOUNT,BATCHNO  "
        strSql += vbCrLf + "  		FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND RECPAY = ''P'' AND ISNULL(CANCEL,'''') = '''' AND ISNULL(COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND FROMFLAG NOT IN ('''','"
        strSql += vbCrLf + "  		'S'',''O'',''A'') AND TRANTYPE <> ''T''   "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE SET TRANTYPE = ''J'' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE AS O INNER JOIN " & cnAdminDb & "..ITEMDETAIL I ON I.BATCHNO = O.BATCHNO  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COLHEAD)SELECT ''DUE SUMMARY'',''T''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL2,COL4,COL5,COL12)SELECT ''OPENING'',''RECEIPT'',''PAYMENT'',''CLOSING''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL4,COL5,COL12)    "
        strSql += vbCrLf + "  		SELECT CASE TRANTYPE WHEN ''O'' THEN ''ORDER ADVANCE'' WHEN ''D'' THEN ''DUE'' WHEN ''T'' THEN ''OTHERS'' WHEN ''J'' THEN ''TOBE'' WHEN ''GV'' THEN ''GIFT VOUCHER'' ELSE ''ADVANCE'' END AS TRANTYPE  "
        strSql += vbCrLf + "  		,SUM(CASE WHEN SEP = ''OPE'' THEN AMOUNT ELSE 0 END) AS OPENING,SUM(CASE WHEN SEP = ''REC'' THEN AMOUNT ELSE 0 END)AS RECEIPT  "
        strSql += vbCrLf + "  		,SUM(CASE WHEN SEP = ''PAY'' THEN AMOUNT ELSE 0 END)AS PAYMENT,SUM(CASE WHEN SEP = ''REC'' THEN -1*AMOUNT ELSE AMOUNT END)AS CLOSING  "
        strSql += vbCrLf + "  		FROM (SELECT SEP,TRANTYPE,AMOUNT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVDUE WHERE TRANTYPE IN (''D'',''J''))X  "
        strSql += vbCrLf + "  		GROUP BY TRANTYPE'  "
        strSql += vbCrLf + "  		EXEC (@QRY)*/  "
        strSql += vbCrLf + "  	END   "
        strSql += vbCrLf + "  END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_DAILYREPORTNEW2()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAILYREPORTNEW2')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_DAILYREPORTNEW2"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_DAILYREPORTNEW2"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  @FRMDATE VARCHAR(15)  "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(15)  "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(5000)  "
        strSql += vbCrLf + "  ,@FORMAT VARCHAR(1)  "
        strSql += vbCrLf + "  ,@SYSTEMID VARCHAR(10) "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  	SET NOCOUNT ON  "
        strSql += vbCrLf + "  	DECLARE @QRY VARCHAR(8000)  "
        strSql += vbCrLf + "  	DECLARE  @CASHACC AS VARCHAR(7)    "
        strSql += vbCrLf + "  	SELECT @CASHACC = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE  CTLID='CASH'  "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY  "
        strSql += vbCrLf + "  	CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(9))  "
        strSql += vbCrLf + "  	DECLARE @TCOMPANY VARCHAR(9)  "
        strSql += vbCrLf + "  	IF @COMPANYID = 'ALL'  "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY  "
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	ELSE  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		IF @COMPANYID <> 'ALL' SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "  		SELECT @QRY= 'INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYID IN('''+ @COMPANYID + ''')'  "
        strSql += vbCrLf + "  		EXEC (@QRY)    "
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	IF @FORMAT<>'N'  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'DAYREPORT1'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1     "
        strSql += vbCrLf + "  		CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1  "
        strSql += vbCrLf + "  		(  "
        strSql += vbCrLf + "  		COL1 VARCHAR(150)  "
        strSql += vbCrLf + "  		,COL2 VARCHAR(100)  "
        strSql += vbCrLf + "  		,COL3 VARCHAR(100)  "
        strSql += vbCrLf + "  		,COL4 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL5 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL6 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL7 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL8 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9A VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9B VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL9C VARCHAR(25)"
        strSql += vbCrLf + "  		,COL10 VARCHAR(25)  "
        strSql += vbCrLf + "  		,COL11 VARCHAR(25)   "
        strSql += vbCrLf + "  		,COL12 VARCHAR(25)   "
        strSql += vbCrLf + "  		,COLHEAD VARCHAR(2)   "
        strSql += vbCrLf + "  		,KEYNO INT IDENTITY(0,1)  "
        strSql += vbCrLf + "  		)'  "
        strSql += vbCrLf + "  		PRINT (@QRY)  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		/******************** SALES ********************~*/      "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'SALES'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO  "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL) FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO  "
        strSql += vbCrLf + "  		WHERE BATCHNO = I.BATCHNO)) AS CUSNAME  "
        strSql += vbCrLf + "  		,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = I.ITEMID) AS ITEMNAME  "
        strSql += vbCrLf + "  		,MCHARGE,VALUEADD, RATE, AMOUNT, GRSWT,NETWT,SGST,CGST,IGST,TAX, AMOUNT + TAX AS  RECEIPT, 0 AS PAYMENT  "
        strSql += vbCrLf + "  		,(SELECT CATNAME FROM " & cnAdminDb & "..CATEGORY AS M WHERE M.CATCODE = I.CATCODE) AS METALNAME  "
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		FROM  "
        strSql += vbCrLf + "  		(  "
        strSql += vbCrLf + "  		SELECT TRANNO,BATCHNO,ITEMID,MCHARGE,CONVERT(DECIMAL(15,2),ISNULL(WASTAGE,0)*RATE) VALUEADD, RATE,AMOUNT-ISNULL((SELECT CASE WHEN ISNULL(I.TRANTYPE,'''')=''OD'' THEN 0 ELSE SUM(STNAMT) END FROM ISSSTONE WHERE ISSSNO = I.SNO),0) AS AMOUNT  "
        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE GRSWT END)AS GRSWT  "
        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE NETWT END)AS NETWT  "
        strSql += vbCrLf + "  		,CASE WHEN AMOUNT <> 0 THEN TAX-ISNULL((SELECT SUM(TAX)FROM ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END TAX  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''SG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''CG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,'''')<>''Y'')  "
        strSql += vbCrLf + "  		-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE ISSSNO IN(SELECT SNO FROM ISSSTONE WHERE ISSSNO = I.SNO) AND TAXID=''IG'' AND ISNULL(STUDDED,''Y'')=''Y'')  "
        strSql += vbCrLf + "  		AS IGST  "
        strSql += vbCrLf + "  		,CATCODE  "
        strSql += vbCrLf + "  		FROM ISSUE AS I  "
        strSql += vbCrLf + "  		WHERE TRANTYPE  IN (''SA'',''OD'',''RD'')   "
        strSql += vbCrLf + "  		AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''    "
        strSql += vbCrLf + "  		AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  		AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "  		AND ISNULL((SELECT AMOUNT FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND ACCODE=(SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID=''ORDMCACC'')),0)=0  "
        strSql += vbCrLf + "  		UNION ALL  "
        strSql += vbCrLf + "  		SELECT TRANNO,BATCHNO,STNITEMID,0 MCHARGE,0 VALUEADD,STNRATE RATE,STNAMT AS AMOUNT  "
        strSql += vbCrLf + "  		,STNWT GRSWT,STNWT NETWT  "
        strSql += vbCrLf + "  		,CASE WHEN STNAMT <> 0 THEN TAX ELSE 0 END  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=SS.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,''N'')=''Y'' AND TRANTYPE=SS.TRANTYPE)AS IGST  "
        strSql += vbCrLf + "  		,CATCODE  "
        strSql += vbCrLf + "  		FROM ISSSTONE SS WHERE ISSSNO IN (SELECT SNO FROM ISSUE AS I  "
        strSql += vbCrLf + "  		WHERE TRANTYPE  IN (''SA'',''OD'',''RD'') AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  		AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY))  "
        strSql += vbCrLf + "  		)AS I  "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES)>0  "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,COLHEAD,RESULT,PAYMENT)  "
        strSql += vbCrLf + "  		SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT,0 PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES WHERE RESULT = 1  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES  "
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,SGST,CGST,IGST,RECEIPT,PAYMENT,COLHEAD,RESULT)  "
        strSql += vbCrLf + "  		SELECT METALNAME + '' SUBTOTAL'' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT)  "
        strSql += vbCrLf + "  		,SUM(TAX),SUM(SGST),SUM(CGST),SUM(IGST),SUM(RECEIPT),SUM(PAYMENT),''S'' COLHEAD,2 RESULT  "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES WHERE RESULT = 1 GROUP BY METALNAME  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL9A,COL9B,COL9C,COL10,COL11,COL12,COLHEAD)  "
        strSql += vbCrLf + "  		SELECT ''CUSTOMER'',''BILLNO'',''ITEMNAME'',''MCHARGE'',''VALUEADD'',''RATE'',''AMOUNT'',''GRSWT'',''NETWT'',''SGST'',''CGST'',''IGST'',''TAX'',''RECEIPT'',''PAYMENT'',''S2''  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''SALES DETAIL'',''T''  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL9A,COL9B,COL9C,COL11,COL12,COLHEAD)  "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,VALUEADD,RATE,AMOUNT,GRSWT,NETWT,TAX,SGST,CGST,IGST,RECEIPT,NULL PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES ORDER BY METALNAME,RESULT  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''  "
