    Private Sub funcDump_TRIG_INSERT_CITEMTAG()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='TRIG_INSERT_CITEMTAG' AND XTYPE='TR')>0"
        strSql += vbCrLf + "  	DROP TRIGGER TRIG_INSERT_CITEMTAG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If TagIssCostId = "" Then Exit Sub
        If TagCostId <> "" Then Exit Sub
        If TagDumpCostId <> "" Then Exit Sub
        strSql = vbCrLf + "CREATE TRIGGER TRIG_INSERT_CITEMTAG ON ITEMTAG FOR UPDATE"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	IF UPDATE(ISSDATE)  AND UPDATE(BATCHNO)"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		DECLARE @ISSDATE SMALLDATETIME"
        strSql += vbCrLf + "		DECLARE @BATCHNO VARCHAR(15)"
        strSql += vbCrLf + "		DECLARE @TOFLAG VARCHAR(2)"
        strSql += vbCrLf + "		DECLARE @DBNAME VARCHAR(15)"
        strSql += vbCrLf + "		DECLARE @ITEMID VARCHAR(10)"
        strSql += vbCrLf + "		DECLARE @TAGNO VARCHAR(15)"
        strSql += vbCrLf + "		DECLARE @ACCODE VARCHAR(7)"
        strSql += vbCrLf + "		DECLARE @COSTID VARCHAR(2)"
        strSql += vbCrLf + "		SELECT  @ISSDATE=ISSDATE FROM INSERTED"
        strSql += vbCrLf + "		SELECT  @BATCHNO=BATCHNO FROM INSERTED"
        strSql += vbCrLf + "		SELECT  @TOFLAG=TOFLAG FROM INSERTED"
        strSql += vbCrLf + "		SELECT  @ITEMID=ITEMID FROM INSERTED"
        strSql += vbCrLf + "		SELECT  @TAGNO=TAGNO FROM INSERTED"
        strSql += vbCrLf + "		SET @ACCODE=''"
        strSql += vbCrLf + "		SET @COSTID=''"
        strSql += vbCrLf + "		SELECT  @ACCODE=ACCODE FROM PERSONALINFO WHERE SNO =(SELECT TOP 1 PSNO FROM CUSTOMERINFO WHERE BATCHNO=@BATCHNO)"
        strSql += vbCrLf + "		SELECT  @COSTID=ISNULL(TCOSTID,'') FROM ACHEAD WHERE ACCODE=@ACCODE"
        strSql += vbCrLf + "		IF @ISSDATE='' RETURN"
        strSql += vbCrLf + "		IF @BATCHNO='' RETURN"
        strSql += vbCrLf + "		IF @TOFLAG<>'SA' RETURN"
        strSql += vbCrLf + "		IF @COSTID='' RETURN"
        strSql += vbCrLf + "		IF @ACCODE='' RETURN"
        strSql += vbCrLf + "		IF SUBSTRING(@BATCHNO,1,2)=@COSTID RETURN"
        strSql += vbCrLf + "		IF OBJECT_ID('TEMPDB..#IINSERTED') IS NOT NULL DROP TABLE #IINSERTED"
        strSql += vbCrLf + " 		SELECT * INTO #IINSERTED FROM INSERTED"
        strSql += vbCrLf + "		DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 		DECLARE @CNAMES VARCHAR(8000)"
        strSql += vbCrLf + " 		DECLARE @CNAME VARCHAR(50)"
        strSql += vbCrLf + " 		SELECT @CNAME = ''"
        strSql += vbCrLf + " 		SELECT @CNAMES = ''"
        strSql += vbCrLf + " 		DECLARE CUR CURSOR"
        strSql += vbCrLf + " 		FOR SELECT NAME FROM SYSCOLUMNS WHERE ID = (SELECT ID FROM SYSOBJECTS WHERE NAME = 'CITEMTAG')"
        strSql += vbCrLf + " 		OPEN CUR"
        strSql += vbCrLf + " 		WHILE 1 = 1"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			FETCH NEXT FROM CUR INTO @CNAME"
        strSql += vbCrLf + " 			IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + " 			SELECT @CNAMES = @CNAMES + @CNAME + ','"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		SELECT @CNAMES =  SUBSTRING(@CNAMES,1,LEN(@CNAMES)-1)"
        strSql += vbCrLf + " 		CLOSE CUR"
        strSql += vbCrLf + " 		DEALLOCATE CUR"
        strSql += vbCrLf + "		IF @COSTID<>''"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + " 			SELECT @QRY = 'INSERT INTO CITEMTAG (' + @CNAMES + ') SELECT ' + @CNAMES + ' FROM #IINSERTED'"
        strSql += vbCrLf + " 			PRINT (@QRY)"
        strSql += vbCrLf + " 			EXEC (@QRY)"
        strSql += vbCrLf + " 			SELECT @CNAME = ''"
        strSql += vbCrLf + " 			SELECT @CNAMES = ''"
        strSql += vbCrLf + " 			DECLARE CUR CURSOR"
        strSql += vbCrLf + " 			FOR SELECT NAME FROM SYSCOLUMNS WHERE ID = (SELECT ID FROM SYSOBJECTS WHERE NAME = 'CITEMTAGSTONE')"
        strSql += vbCrLf + " 			OPEN CUR"
        strSql += vbCrLf + " 			WHILE 1 = 1"
        strSql += vbCrLf + " 			BEGIN"
        strSql += vbCrLf + " 				FETCH NEXT FROM CUR INTO @CNAME"
        strSql += vbCrLf + " 				IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + " 				SELECT @CNAMES = @CNAMES + @CNAME + ','"
        strSql += vbCrLf + " 			END"
        strSql += vbCrLf + " 			SELECT @CNAMES =  SUBSTRING(@CNAMES,1,LEN(@CNAMES)-1)"
        strSql += vbCrLf + " 			CLOSE CUR"
        strSql += vbCrLf + " 			DEALLOCATE CUR"
        strSql += vbCrLf + " 			SELECT @QRY = 'INSERT INTO CITEMTAGSTONE (' + @CNAMES + ') SELECT ' + @CNAMES + ' FROM ITEMTAGSTONE'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY+' WHERE TAGSNO IN(SELECT SNO FROM #IINSERTED)'"
        strSql += vbCrLf + " 			EXEC (@QRY)"
        strSql += vbCrLf + " 			UPDATE ITEMTAG  SET ISSDATE = NULL ,RECDATE=@ISSDATE,ISSREFNO = NULL ,ISSPCS = 0 ,ISSWT = 0 "
        strSql += vbCrLf + " 			,TOFLAG = NULL ,BATCHNO = NULL ,APPROVAL = NULL,COSTID=@COSTID,TCOSTID=@COSTID WHERE ITEMID = @ITEMID AND TAGNO = @TAGNO"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
