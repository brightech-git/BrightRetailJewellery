        strSql += vbCrLf + "	IF OBJECT_ID ('TEMPTABLEDB..TEMPACCTRAN_TEST_RES')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACCTRAN_TEST_RES      "
        strSql += vbCrLf + "	SELECT @QRY= CHAR(13)+'SELECT CASE WHEN PAYMODE IN (''CA'') THEN ''CASH'' '      "
        strSql += vbCrLf + "	SELECT @QRY= @QRY + CHAR(13)+'WHEN PAYMODE IN(''SA'',''RD'',''OD'',''SV'') THEN ''SALES'''      "
        strSql += vbCrLf + "	SELECT @QRY= @QRY + CHAR(13)+'WHEN PAYMODE IN(''SR'',''RV'') THEN ''SALESRETURN'''      "
