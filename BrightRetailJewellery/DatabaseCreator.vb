    Private Sub AKSCDM_SP_INSERT_CUSTOMERINFO(ByVal akscdmDbName As String, ByVal cnAks As OleDbConnection)
        strSql = " IF(SELECT 1 FROM " & akscdmDbName & "..SYSOBJECTS WHERE NAME='AKSCDM_SP_INSERT_CUSTOMERINFO')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE AKSCDM_SP_INSERT_CUSTOMERINFO"
        cmd = New OleDbCommand(strSql, cnAks)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE [dbo].[AKSCDM_SP_INSERT_CUSTOMERINFO]"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@TYPE VARCHAR(500),@TRANDATE VARCHAR(500),@TITLE VARCHAR(500),@INITIAL VARCHAR(500),@PNAME VARCHAR(500)"
        strSql += vbCrLf + ",@MNAME VARCHAR(500),@SNAME VARCHAR(500),@DOORNO VARCHAR(500),@ADDRESS1 VARCHAR(500),@ADDRESS2 VARCHAR(500),@ADDRESS3 VARCHAR(500)"
        strSql += vbCrLf + ",@AREA VARCHAR(500),@CITY VARCHAR(500),@STATE VARCHAR(500),@COUNTRY VARCHAR(500),@PINCODE VARCHAR(500),@PHONE VARCHAR(500)"
        strSql += vbCrLf + ",@PHONERES VARCHAR(500),@MOBILE VARCHAR(500),@MOBILERES VARCHAR(500),@EMAIL VARCHAR(500),@RELIGION VARCHAR(500)"
        strSql += vbCrLf + ",@DOB VARCHAR(500),@ANNIVERSARY VARCHAR(500),@APPVER VARCHAR(500),@PREVILEGEID VARCHAR(500)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(500),@COSTID VARCHAR(500),@USERID VARCHAR(500),@UPDATED VARCHAR(500)"
        strSql += vbCrLf + ",@UPTIME VARCHAR(500),@GENDER VARCHAR(500),@MARITALSTATUS VARCHAR(500),@PROFESSION VARCHAR(500)"
        strSql += vbCrLf + ",@CMODE VARCHAR(500),@CODEPH VARCHAR(500),@CODEPHRES VARCHAR(500),@CODEMOB VARCHAR(500)"
        strSql += vbCrLf + ",@CODEMOBRES VARCHAR(500),@CTYPE VARCHAR(500),@BATCHNO VARCHAR(500)"
        strSql += vbCrLf + ",@TEMPERATURE VARCHAR(500)"
        strSql += vbCrLf + ") "
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	DECLARE @UPDATEFLAG VARCHAR(1)"
        strSql += vbCrLf + "	/*DECLARE @TRANDATE AS VARCHAR(15) = '10-JULY-2020'"
        strSql += vbCrLf + "	DECLARE @MOBILE AS VARCHAR(15) = '9840296103'"
        strSql += vbCrLf + "	*/"
        strSql += vbCrLf + "	SELECT @UPDATEFLAG= CASE WHEN COUNT(*) = 0 THEN 'N' ELSE 'Y' END FROM CUSTOMERINFO WHERE TRANDATE = ''+@TRANDATE+'' AND (MOBILE = ''+@MOBILE+'') AND ISNULL(BILLED,'N') <> 'Y' "
        strSql += vbCrLf + "	PRINT @UPDATEFLAG"
        strSql += vbCrLf + "	IF @UPDATEFLAG = 'N'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		DECLARE @SNO VARCHAR(20) "
        strSql += vbCrLf + "		SET @SNO = LTRIM(@COSTID) + SUBSTRING(LTRIM(YEAR(GETDATE())),3,2) + REPLICATE('0',2-LEN(LTRIM(MONTH(GETDATE())))) + LTRIM(MONTH(GETDATE()))+REPLICATE('0',2-LEN(LTRIM(DAY(GETDATE())))) +LTRIM(DAY(GETDATE()))"
        strSql += vbCrLf + "		SELECT  @SNO += REPLICATE('0',5-LEN(LTRIM(ISNULL(COUNT(*),0)+1)))+LTRIM(ISNULL(COUNT(*),0)+1) FROM CUSTOMERINFO WHERE TRANDATE = REPLACE(CONVERT(VARCHAR(15),GETDATE(),102),'.','-')"
        strSql += vbCrLf + "		PRINT @SNO"
        strSql += vbCrLf + "		PRINT 'NO INSERT'"
        strSql += vbCrLf + "		SELECT @QRY = ' INSERT INTO '+ @DBNAME +'..CUSTOMERINFO('"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + 'SNO,TYPE,TRANDATE,TITLE,INITIAL,PNAME,MNAME,SNAME,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,STATE,COUNTRY,PINCODE'"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,PHONE,PHONERES,MOBILE,MOBILERES,EMAIL,RELIGION,DOB,ANNIVERSARY,APPVER,PREVILEGEID,COMPANYID,COSTID,USERID,UPDATED'"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) +',UPTIME,GENDER,MARITALSTATUS,PROFESSION,CMODE,CODEPH,CODEPHRES,CODEMOB,CODEMOBRES,CTYPE,BILLED,BATCHNO'"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) +',TEMPERATURE)VALUES('"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' '''+@SNO+''','''+@TYPE+''','''+@TRANDATE+''','''+@TITLE+''','''+@INITIAL+''','''+@PNAME+''','''+@MNAME+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@SNAME+''','''+@DOORNO+''','''+@ADDRESS1+''','''+@ADDRESS2+''','''+@ADDRESS3+''','''+@AREA+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@CITY+''','''+@STATE+''','''+@COUNTRY+''','''+@PINCODE+''','''+@PHONE+''','''+@PHONERES+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@MOBILE+''','''+@MOBILERES+''','''+@EMAIL+''','''+@RELIGION+''' '"
        strSql += vbCrLf + "		IF @DOB = '' SELECT @QRY = @QRY + CHAR(13) + ' ,NULL'"
        strSql += vbCrLf + "		IF @DOB <> '' SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@DOB+''''"
        strSql += vbCrLf + "		IF @ANNIVERSARY = '' SELECT @QRY = @QRY + CHAR(13) + ' ,NULL '"
        strSql += vbCrLf + "		IF @ANNIVERSARY <> '' SELECT @QRY = @QRY + CHAR(13) + ','''+@ANNIVERSARY+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@APPVER+''','''+@PREVILEGEID+''','''+@COMPANYID+''','''+@COSTID+''','''+@USERID+''','''+@UPDATED+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@UPTIME+''','''+@GENDER+''','''+@MARITALSTATUS+''','''+@PROFESSION+''','''+@CMODE+''','''+@CODEPH+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@CODEPHRES+''','''+@CODEMOB+''','''+@CODEMOBRES+''','''+@CTYPE+''',''Y'','''+@BATCHNO+''' '"
        strSql += vbCrLf + "		IF @TEMPERATURE <> ''	SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@TEMPERATURE+''' '"
        strSql += vbCrLf + "		IF @TEMPERATURE = ''	SELECT @QRY = @QRY + CHAR(13) + ' ,0 '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' ) '"
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + "		EXEC(@QRY)"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		PRINT 'YES UPDATE'"
        strSql += vbCrLf + "		SELECT @QRY = ' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' UPDATE '+ @DBNAME +'..CUSTOMERINFO SET BILLED = ''Y'',BATCHNO = '''+@BATCHNO+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' WHERE TRANDATE = '''+@TRANDATE+''' '"
        strSql += vbCrLf + "		SELECT @QRY = @QRY + CHAR(13) + ' AND MOBILE = '''+@MOBILE+''' AND ISNULL(BILLED,''N'') <> ''Y'' '"
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + "		EXEC(@QRY)"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cnAks)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub PROC_GSTR1()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_GSTR1')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_GSTR1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "CREATE PROCEDURE PROC_GSTR1"
        strSql += vbCrLf + "("
        strSql += vbCrLf + " @DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@FROMDATE VARCHAR(15)"
        strSql += vbCrLf + ",@TODATE VARCHAR(15)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(200)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(200)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME  "
        strSql += vbCrLf + "	SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2)'  "
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC (@QRY)  "
        strSql += vbCrLf + "	SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'  "
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..METALMAST') IS NOT NULL DROP TABLE TEMPTABLEDB..METALMAST CREATE TABLE TEMPTABLEDB..METALMAST(METALID VARCHAR(10))  "
        strSql += vbCrLf + "	IF @METALNAME = '' OR @METALNAME = 'ALL'  "
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..METALMAST(METALID) SELECT METALID FROM METALMAST  "
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..METALMAST(METALID) SELECT METALID FROM METALMAST WHERE METALNAME = @METALNAME "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPGSTRPT') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPGSTRPT "
        strSql += vbCrLf + "	SELECT @QRY='SELECT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' CASE WHEN ISNULL(P.GSTNO,'''')='''' THEN ''R- Regular B2C Invoices'' ELSE ''R- Regular B2B Invoices'' END AS A'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,'''' AS B'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No'' AS C'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No'' AS D'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No'' AS E'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No'' AS F'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No '' AS G'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,PNAME AS NAME,''Goods''AS NATURE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CASE WHEN ISNULL(I.COSTID,'''')<>'''' THEN I.COSTID+''-''+CAST(TRANNO AS VARCHAR) ELSE CAST(TRANNO AS VARCHAR) END AS INVNO '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,I.TRANDATE AS INVDATE,P.GSTNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,P.DOORNO,P.ADDRESS1,P.ADDRESS2,P.ADDRESS3,P.AREA,P.CITY'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,P.STATE AS CSTATE,NULL AS DSTATE,''No'' AS RCHARGE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,''No'' AS PROV_ASS'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,AMOUNT+ISNULL(TAX,0) AS INVALUE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,NULL AS OINVNO,NULL AS OINVDATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,WT_ENTORDER AS SNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,AMOUNT AS TAXABLE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+',(SELECT SUM(AMOUNT) FROM '+@DBNAME+'..ISSUE WHERE BATCHNO=I.BATCHNO)AS TOTALVALUE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXPER) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TRANTYPE =''SA'')AS RATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXPER) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'' AND TRANTYPE =''SA'')AS IGSTRATE'"
