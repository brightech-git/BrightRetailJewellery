        strSql += vbCrLf + "    		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT GRSWT FROM '+@DBNAME+'..ISSUE WHERE TRANTYPE IN('+ @TRANTYPE +') AND SNO=I.SNO AND TRANDATE BETWEEN '''+ @FRMDATE+''' AND '''+ @TODATE+''''    "
