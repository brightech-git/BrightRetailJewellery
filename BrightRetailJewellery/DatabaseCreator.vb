        strSql += vbCrLf + "  		,IPCS,IGRSWT,IPCS_MI,IGRSWT_MI,IPCS_NT,IGRSWT_NT,IPCS_PA,IGRSWT_PA,IPCS_AP,IGRSWT_AP,IPCS_TR,IGRSWT_TR,IPCS_NTTT,IGRSWT_NTTT    "
