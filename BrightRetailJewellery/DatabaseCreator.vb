        strSql += vbCrLf + "   SELECT @QUERY = @QUERY + ',COLHEAD)'"
        strSql += vbCrLf + "   SELECT @QUERY = @QUERY + 'SELECT TRANNO,TRANDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,NETWT,MCGRM,WASTPER'"
        strSql += vbCrLf + "   SELECT @QUERY = @QUERY + ',RATE,QUATAMOUNT,DISCOUNT,AMOUNT,[CATEGORY-'+@DEFFINDISC+'%] '"
        strSql += vbCrLf + "   SET @DISCARRAYLENGTH=0"
