        strSql += vbCrLf + "  		AND PAYMODE = ''OR'' AND O.RECPAY = ''R'' AND (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'')  AND SUBSTRING(O.RUNNO,6,1) <> ''R''      "
