        strSql += vbCrLf + "        	    SELECT @QRY = @QRY + ' SELECT DISTINCT EMPNAME,COSTNAME,EMPNAME,1 RES1,0 RES2,''T1'',EMPID FROM TEMPTABLEDB..SA_COMMISION_RES  WHERE RES1 = 1   AND ISNULL(COLHEAD,'''') = '''''"
        strSql += vbCrLf + "                SELECT @QRY = @QRY + ' INSERT INTO TEMPTABLEDB..SA_COMMISION_RES(PARTICULAR,COSTNAME,EMPNAME,EMPID,RES1,RES2,COLHEAD,SPCS,SNETWT,SAMOUNT'"
        strSql += vbCrLf + "        	    SELECT @QRY = @QRY + ' ,RPCS,RNETWT,RAMOUNT,PCS,NETWT,AMOUNT,INCENTIVE)'"
        strSql += vbCrLf + "        	    SELECT @QRY = @QRY + ' SELECT DISTINCT EMPNAME + ''-> TOT'',COSTNAME,EMPNAME,EMPID,1 RES1,1 RES2,''S1'''"
