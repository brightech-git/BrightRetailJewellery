        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' AND ISNULL(CANCEL,'''') = '''' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)  AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)),0) AS CREDIT'"
