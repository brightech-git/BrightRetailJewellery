        strSql += vbCrLf + "     		SET @QRY='INSERT INTO TEMPTABLEDB..OUT_COMPANY'+@SYSID+' (COMPANYID) SELECT '''+@TCOMPANY+''''"
        strSql += vbCrLf + "     		PRINT(@QRY)"
        strSql += vbCrLf + "     		EXEC (@QRY)"
        strSql += vbCrLf + "     	END"
        strSql += vbCrLf + "     	SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..OUT_TYPE'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..OUT_TYPE'+@SYSID+''"
        strSql += vbCrLf + "     	PRINT(@QRY)"
        strSql += vbCrLf + "     	EXEC (@QRY)"
