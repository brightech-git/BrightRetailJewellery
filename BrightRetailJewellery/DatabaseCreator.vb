        strSql += vbCrLf + "          IF @ACFILTER='A' SELECT @ACCFILTER=' AND H.ACCODE=''ADVANCE'''  "
        strSql += vbCrLf + "          IF @ACFILTER='O' SELECT @ACCFILTER=' AND H.ACCODE=''ADVORD'''  "
        strSql += vbCrLf + "          SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..TEMP_OUTSTANDING'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING'+@SYSID+''  "
        strSql += vbCrLf + "          PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          IF @ACGROUP <> 'ALL'  "
        strSql += vbCrLf + "          BEGIN  "
