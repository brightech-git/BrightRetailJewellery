        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCATEGORY(CATCODE)SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME = @CATNAME             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPITEM (ITEMID INT,STOCKTYPE VARCHAR(2))             "
        strSql += vbCrLf + " 	IF @ITEMNAME = 'ALL' OR @ITEMNAME = ''             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEM(ITEMID,STOCKTYPE)SELECT ITEMID,STOCKTYPE FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(ACTIVE,'') = 'Y' AND ISNULL(STOCKREPORT,'') = 'Y'             "
        strSql += vbCrLf + " 	ELSE             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEM(ITEMID,STOCKTYPE)SELECT ITEMID,STOCKTYPE FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMNAME = @ITEMNAME AND ISNULL(ACTIVE,'') = 'Y' AND ISNULL(STOCKREPORT,'') = 'Y'             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPDESIGNER (DESIGNERID INT)             "
        strSql += vbCrLf + " 	IF @DESIGNER = 'ALL' OR @DESIGNER = ''             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPDESIGNER(DESIGNERID)SELECT DESIGNERID FROM " & compId & "ADMINDB..DESIGNER UNION ALL SELECT 0             "
        strSql += vbCrLf + " 	ELSE             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPDESIGNER(DESIGNERID)SELECT DESIGNERID FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERNAME = @DESIGNER             "
        strSql += vbCrLf + " 	/**SPLIT COMPANY **/               "
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPCOMPANY', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOMPANY       "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPCOMPANY (COMPANYID VARCHAR(3))       "
        strSql += vbCrLf + " 	DECLARE @TCOMPANY VARCHAR(50)       "
        strSql += vbCrLf + " 	IF CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + " 	BEGIN       "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT @COMPANYID       "
        strSql += vbCrLf + " 	END       "
        strSql += vbCrLf + " 	WHILE CHARINDEX(',',@COMPANYID)>0       "
        strSql += vbCrLf + " 	BEGIN       "
        strSql += vbCrLf + " 		SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)       "
        strSql += vbCrLf + " 		SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))       "
        strSql += vbCrLf + " 		IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + " 		BEGIN       "
        strSql += vbCrLf + " 			SET @COMPANYID= @COMPANYID + ','       "
        strSql += vbCrLf + " 		END       "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCOMPANY (COMPANYID) SELECT @TCOMPANY       "
        strSql += vbCrLf + " 	END "
        strSql += vbCrLf + " 	/**SPLIT COSTNAME **/             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPCOSTCENTRE (COSTID VARCHAR(3))             "
        strSql += vbCrLf + " 	IF @COSTNAME = 'ALL' OR @COSTNAME = ''             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID)SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE UNION ALL SELECT ''             "
        strSql += vbCrLf + " 	ELSE IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..COSTCENTRE)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + " 		IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME              "
        strSql += vbCrLf + " 		WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + " 			SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + " 			IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + " 			SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMPNAME"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPCOSTCENTRE(COSTID)SELECT ''              "
        strSql += vbCrLf + " 	/**SPLIT ITEMTYPE **/             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPITEMTYPE (ITEMTYPEID INT)             "
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMTYPE)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		DECLARE @TEMPITEMTYPE VARCHAR(20)"
        strSql += vbCrLf + " 		IF CHARINDEX(',',@ITEMTYPE)=0"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEMTYPE (ITEMTYPEID) SELECT ITEMTYPEID FROM " & compId & "ADMINDB..ITEMTYPE WHERE NAME = @ITEMTYPE             "
        strSql += vbCrLf + " 		WHILE CHARINDEX(',',@ITEMTYPE)>0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SET @TEMPITEMTYPE=LEFT(@ITEMTYPE,CHARINDEX(',',@ITEMTYPE)-1)"
        strSql += vbCrLf + " 			SET @ITEMTYPE=RIGHT(@ITEMTYPE,LEN(@ITEMTYPE)-CHARINDEX(',',@ITEMTYPE))"
        strSql += vbCrLf + " 			IF @ITEMTYPE <>'' AND CHARINDEX(',',@ITEMTYPE)=0"
        strSql += vbCrLf + " 			SET @ITEMTYPE= @ITEMTYPE + ','"
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPITEMTYPE (ITEMTYPEID) SELECT ITEMTYPEID FROM " & compId & "ADMINDB..ITEMTYPE WHERE NAME = @TEMPITEMTYPE"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEMTYPE(ITEMTYPEID)SELECT 0             "
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPITEMTYPE) = (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMTYPE)             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEMTYPE(ITEMTYPEID) SELECT 0             "
        strSql += vbCrLf + " 	/**SPLIT COUNTER **/             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPITEMCOUNTER (ITEMCTRID INT)             "
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMCOUNTER)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		DECLARE @TEMPCOUNTER VARCHAR(100)"
        strSql += vbCrLf + " 		IF CHARINDEX(',',@COUNTER)=0"
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPITEMCOUNTER (ITEMCTRID) SELECT ITEMCTRID FROM " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRNAME = @COUNTER"
        strSql += vbCrLf + " 		WHILE CHARINDEX(',',@COUNTER)>0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SET @TEMPCOUNTER=LEFT(@COUNTER,CHARINDEX(',',@COUNTER)-1)"
        strSql += vbCrLf + " 			SET @COUNTER=RIGHT(@COUNTER,LEN(@COUNTER)-CHARINDEX(',',@COUNTER))"
        strSql += vbCrLf + " 			IF @COUNTER <>'' AND CHARINDEX(',',@COUNTER)=0"
        strSql += vbCrLf + " 			SET @COUNTER= @COUNTER + ','"
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPITEMCOUNTER (ITEMCTRID) SELECT ITEMCTRID FROM " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRNAME = @TEMPCOUNTER             "
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEMCOUNTER(ITEMCTRID)SELECT 0        "
        strSql += vbCrLf + " 	/** SPLIT APPROVAL **/       "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPAPPROVAL (APPROVAL VARCHAR(1))               "
        strSql += vbCrLf + " 	DECLARE @TEMPAPPROVAL VARCHAR(1)          "
        strSql += vbCrLf + " 	IF @APPROVAL = ''       "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPAPPROVAL(APPROVAL) SELECT DISTINCT APPROVAL FROM " & compId & "ADMINDB..ITEMTAG WHERE APPROVAL <>'A'       "
        strSql += vbCrLf + " 	IF @APPROVAL = 'A'         "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPAPPROVAL(APPROVAL) SELECT DISTINCT APPROVAL FROM " & compId & "ADMINDB..ITEMTAG"
        strSql += vbCrLf + " 	IF @APPROVAL = 'O'         "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPAPPROVAL(APPROVAL) SELECT 'A'"
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPITEMCOUNTER) = (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMCOUNTER)             "
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPITEMCOUNTER(ITEMCTRID) SELECT 0      "
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMTAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMTAG "
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 	SELECT @QRY='SELECT *,CONVERT(VARCHAR(5),''TAG'')FROMTABLE INTO TEMPTABLEDB..TEMPITEMTAG FROM " & compId & "ADMINDB..ITEMTAG AS T'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY))'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.ITEMID IN (SELECT ITEMID FROM TEMPTABLEDB..TEMPITEM)' "
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.DESIGNERID,0) IN (SELECT DESIGNERID FROM TEMPTABLEDB..TEMPDESIGNER)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.ITEMTYPEID,0) IN (SELECT ITEMTYPEID FROM TEMPTABLEDB..TEMPITEMTYPE)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.APPROVAL,'''') IN (SELECT APPROVAL FROM TEMPTABLEDB..TEMPAPPROVAL)'"
        strSql += vbCrLf + " 	PRINT(@QRY)		  "
        strSql += vbCrLf + " 	EXEC(@QRY)"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMNONTAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMNONTAG   "
        strSql += vbCrLf + " 	SELECT @QRY=CHAR(13)+'SELECT *'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'INTO TEMPTABLEDB..TEMPITEMNONTAG'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'FROM " & compId & "ADMINDB..ITEMNONTAG T'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETAL))'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY))'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.ITEMID IN (SELECT ITEMID FROM TEMPTABLEDB..TEMPITEM)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.DESIGNERID,0) IN (SELECT DESIGNERID FROM TEMPTABLEDB..TEMPDESIGNER)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.ITEMCTRID,0) IN (SELECT ITEMCTRID FROM TEMPTABLEDB..TEMPITEMCOUNTER)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.ITEMTYPEID,0) IN (SELECT ITEMTYPEID FROM TEMPTABLEDB..TEMPITEMTYPE)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE) '"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(T.FLAG,'''') IN (SELECT FLAG FROM TEMPTABLEDB..TEMPFLAG)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(CANCEL,'''') = '''''"
        strSql += vbCrLf + " 	PRINT(@QRY)		  "
        strSql += vbCrLf + " 	EXEC(@QRY)"
        strSql += vbCrLf + " 	/**Create Report Table **/             "
        strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPITEMSTOCK1')>0 DROP TABLE TEMPTABLEDB..TEMPITEMSTOCK1             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPITEMSTOCK1             "
        strSql += vbCrLf + " 	(             "
        strSql += vbCrLf + " 	SEP VARCHAR(5)             "
        strSql += vbCrLf + " 	,ITEMCTRID INT,ITEMID INT,SUBITEMID INT,PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),SNO VARCHAR(15)             "
        strSql += vbCrLf + " 	)             "
        strSql += vbCrLf + " 	IF @STOCKTYPE = 'T' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + " 	BEGIN             "
        strSql += vbCrLf + " 		/** Getting Opening **/             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPITEMSTOCK1 (SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO)             "
        strSql += vbCrLf + " 		SELECT 'OPE'SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO "
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMPITEMTAG T WHERE RECDATE < @ASONDATE AND (ISSDATE IS NULL OR ISSDATE >= @ASONDATE)       "
        strSql += vbCrLf + " 		AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CTRANSFER C WHERE C.TAGSNO = T.SNO)"
        strSql += vbCrLf + " 		AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT DISTINCT CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS'  ELSE 'ISS' END SEP       "
        strSql += vbCrLf + " 		,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO FROM TEMPTABLEDB..TEMPITEMTAG  T        "
        strSql += vbCrLf + " 		LEFT OUTER JOIN ISSUE AS I ON I.BATCHNO = T.BATCHNO AND I.TAGNO = T.TAGNO       "
        strSql += vbCrLf + " 		WHERE T.ISSDATE = @ASONDATE       "
        strSql += vbCrLf + " 		AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CTRANSFER C WHERE C.TAGSNO = T.SNO)       "
        strSql += vbCrLf + " 		AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT 'REC'SEP       "
        strSql += vbCrLf + " 		,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO FROM TEMPTABLEDB..TEMPITEMTAG T WHERE RECDATE = @ASONDATE       "
        strSql += vbCrLf + " 		AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CTRANSFER C WHERE C.TAGSNO = T.SNO )       "
        strSql += vbCrLf + " 		AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT 'OPE'SEP       "
        strSql += vbCrLf + " 		,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " 		FROM " & compId & "ADMINDB..CTRANSFER C INNER JOIN TEMPTABLEDB..TEMPITEMTAG AS T ON C.TAGSNO = T.SNO  AND (T.ISSDATE IS NULL OR T.ISSDATE >= @ASONDATE)"
        strSql += vbCrLf + " 		WHERE C.RECDATE < @ASONDATE AND (C.ISSDATE IS NULL OR C.ISSDATE >= @ASONDATE)  "
        strSql += vbCrLf + " 		AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN 'TISS'  ELSE 'ISS' END AS SEP     "
        strSql += vbCrLf + " 		,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " 		FROM " & compId & "ADMINDB..CTRANSFER AS C INNER JOIN TEMPTABLEDB..TEMPITEMTAG AS  T ON C.TAGSNO = T.SNO    "
        strSql += vbCrLf + " 		WHERE C.ISSDATE = @ASONDATE     "
        strSql += vbCrLf + " 		AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER    "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN C.ENTORDER = 1 THEN 'REC' ELSE 'TREC'END ELSE 'REC' END SEP       "
        strSql += vbCrLf + " 		,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " 		FROM " & compId & "ADMINDB..CTRANSFER AS C INNER JOIN TEMPTABLEDB..TEMPITEMTAG T ON C.TAGSNO = T.SNO WHERE C.RECDATE = @ASONDATE     "
        strSql += vbCrLf + " 		AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER    "
        strSql += vbCrLf + " 		UNION ALL       "
        strSql += vbCrLf + " 		SELECT DISTINCT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS' ELSE 'ISS' END ELSE 'ISS' END SEP    "
        strSql += vbCrLf + " 		,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " 		FROM " & compId & "ADMINDB..CTRANSFER AS C        "
        strSql += vbCrLf + " 		INNER JOIN TEMPTABLEDB..TEMPITEMTAG AS  T ON C.TAGSNO = T.SNO AND T.ISSDATE IS NOT NULL AND T.ISSDATE = @ASONDATE AND T.TOFLAG <> 'TR'    "
        strSql += vbCrLf + " 		LEFT OUTER JOIN ISSUE AS I ON I.BATCHNO = T.BATCHNO       "
        strSql += vbCrLf + " 		WHERE C.ISSDATE IS NULL       "
        strSql += vbCrLf + " 		AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)             "
        strSql += vbCrLf + " 		GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER,I.TRANTYPE    "
        strSql += vbCrLf + " 	END       "
        strSql += vbCrLf + " 	IF @STOCKTYPE = 'N' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + " 	BEGIN             "
        strSql += vbCrLf + " 	/** Getting Non Tag Values **/             "
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPITEMSTOCK1 (SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO)             "
        strSql += vbCrLf + " 	SELECT 'OPE'SEP,ITEMCTRID,ITEMID,SUBITEMID             "
        strSql += vbCrLf + " 	,CASE WHEN RECISS = 'R' THEN PCS ELSE -1*PCS END AS PCS             "
        strSql += vbCrLf + " 	,CASE WHEN RECISS = 'R' THEN GRSWT ELSE -1*GRSWT END AS GRSWT             "
        strSql += vbCrLf + " 	,CASE WHEN RECISS = 'R' THEN NETWT ELSE -1*NETWT END AS NETWT,SNO             "
        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPITEMNONTAG T WHERE RECDATE < @ASONDATE             "
        strSql += vbCrLf + " 	UNION ALL             "
        strSql += vbCrLf + " 	SELECT DISTINCT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS' WHEN ISNULL(POSTED,'') = 'C' THEN 'TISS' ELSE 'ISS' END ELSE 'ISS' END SEP     "
        strSql += vbCrLf + " 	,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO             "
        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPITEMNONTAG T              "
        strSql += vbCrLf + " 	LEFT OUTER JOIN ISSUE AS I ON ISNULL(T.BATCHNO,'') = I.BATCHNO             "
        strSql += vbCrLf + " 	WHERE T.RECDATE = @ASONDATE AND T.RECISS = 'I'             "
        strSql += vbCrLf + " 	UNION ALL             "
        strSql += vbCrLf + " 	SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN ISNULL(POSTED,'') = 'C' THEN 'TREC' ELSE 'REC' END ELSE 'REC' END SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO             "
        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPITEMNONTAG T WHERE RECDATE = @ASONDATE AND RECISS = 'R'             "
        strSql += vbCrLf + " 	END             "
        strSql += vbCrLf + " 	IF @SUMMARY = 'Y'             "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPITEMSTOCK1 SET ITEMID = NULL             "
        strSql += vbCrLf + " 	IF @SUMMARY = 'Y' OR @WITHSUBITEM = 'N'             "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPITEMSTOCK1 SET SUBITEMID = NULL             "
        strSql += vbCrLf + " 	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPSTOCKREPORT')>0 DROP TABLE TEMPTABLEDB..TEMPSTOCKREPORT             "
        strSql += vbCrLf + " 	SELECT      "
        strSql += vbCrLf + " 	CONVERT(vARCHAR(300),CASE WHEN @ORDERBYID = 'Y' THEN '['+REPLICATE(' ',5-LEN(C.ITEMCTRID)) + CONVERT(VARCHAR,C.ITEMCTRID) + '] ' + C.ITEMCTRNAME ELSE C.ITEMCTRNAME END) AS PARTICULAR    "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'OPE' THEN T.PCS ELSE 0 END) AS OPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'OPE' THEN T.GRSWT ELSE 0 END) AS OGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'OPE' THEN T.NETWT ELSE 0 END) AS ONETWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TREC' THEN T.PCS ELSE 0 END) AS TRPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TREC' THEN T.GRSWT ELSE 0 END) AS TRGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TREC' THEN T.NETWT ELSE 0 END) AS TRNETWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'REC' THEN T.PCS ELSE 0 END) AS RPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'REC' THEN T.GRSWT ELSE 0 END) AS RGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'REC' THEN T.NETWT ELSE 0 END) AS RNETWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TISS' THEN T.PCS ELSE 0 END) AS TIPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TISS' THEN T.GRSWT ELSE 0 END) AS TIGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'TISS' THEN T.NETWT ELSE 0 END) AS TINETWT "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' THEN T.PCS ELSE 0 END) AS IPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' THEN T.GRSWT ELSE 0 END) AS IGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' THEN T.NETWT ELSE 0 END) AS INETWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'MISS' THEN T.PCS ELSE 0 END) AS MIPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'MISS' THEN T.GRSWT ELSE 0 END) AS MIGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'MISS' THEN T.NETWT ELSE 0 END) AS MINETWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.PCS ELSE T.PCS END) AS CPCS             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.GRSWT ELSE T.GRSWT END) AS CGRSWT             "
        strSql += vbCrLf + " 	,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.NETWT ELSE T.NETWT END) AS CNETWT             "
        strSql += vbCrLf + " 	,CONVERT(vARCHAR(200),CASE WHEN @ORDERBYID = 'Y' THEN '['+REPLICATE(' ',5-LEN(C.ITEMCTRID)) + CONVERT(VARCHAR,C.ITEMCTRID) + '] ' + C.ITEMCTRNAME ELSE C.ITEMCTRNAME END) AS ITEMCTRNAME    "
        strSql += vbCrLf + " 	,CONVERT(vARCHAR(200),CASE WHEN @ORDERBYID = 'Y' AND @SUMMARY = 'N' AND @WITHSUBITEM = 'N'  THEN '['+REPLICATE(' ',5-LEN(I.ITEMID)) + CONVERT(VARCHAR,I.ITEMID) + '] ' + I.ITEMNAME ELSE I.ITEMNAME END) AS ITEMNAME  "
        strSql += vbCrLf + " 	,S.SUBITEMNAME,CONVERT(INT,1) RESULT,CONVERT(VARCHAR(2),'')COLHEAD  "
        strSql += vbCrLf + " 	INTO TEMPTABLEDB..TEMPSTOCKREPORT  "
        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMPITEMSTOCK1 AS T  "
        strSql += vbCrLf + " 	LEFT OUTER JOIN " & compId & "ADMINDB..ITEMMAST AS I ON I.ITEMID = T.ITEMID  "
        strSql += vbCrLf + " 	LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS S ON S.ITEMID = T.ITEMID AND S.SUBITEMID = T.SUBITEMID             "
        strSql += vbCrLf + " 	LEFT OUTER JOIN " & compId & "ADMINDB..ITEMCOUNTER AS C ON C.ITEMCTRID = T.ITEMCTRID  "
        strSql += vbCrLf + " 	WHERE ISNULL(T.ITEMCTRID,0) IN (SELECT ITEMCTRID FROM TEMPTABLEDB..TEMPITEMCOUNTER)  "
        strSql += vbCrLf + " 	GROUP BY C.ITEMCTRID,C.ITEMCTRNAME,I.ITEMNAME,S.SUBITEMNAME,I.ITEMID  "
        strSql += vbCrLf + " 	IF @TRANSACTIONONLY = 'PGN' /** TRAN CONTAIN PCS,GRSWT,NETWT **/     "
        strSql += vbCrLf + " 	BEGIN     "
        strSql += vbCrLf + " 	DELETE FROM TEMPTABLEDB..TEMPSTOCKREPORT     "
        strSql += vbCrLf + " 	WHERE      "
        strSql += vbCrLf + " 	(ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0 AND ISNULL(TRNETWT,0) = 0     "
        strSql += vbCrLf + " 	AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0 AND ISNULL(RNETWT,0) = 0     "
        strSql += vbCrLf + " 	AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0 AND ISNULL(TINETWT,0) = 0     "
        strSql += vbCrLf + " 	AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0 AND ISNULL(INETWT,0) = 0     "
        strSql += vbCrLf + " 	AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0 AND ISNULL(MINETWT,0) = 0)     "
        strSql += vbCrLf + " 	END     "
        strSql += vbCrLf + " 	IF @TRANSACTIONONLY <> '' /** TRAN CONTAIN PCS,GRSWT,NETWT **/     "
        strSql += vbCrLf + " 	BEGIN /** DELETE WITHOUT TRANSATION ROWS **/      "
        strSql += vbCrLf + " 		SELECT @QRY = ''     "
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + ' DELETE FROM TEMPTABLEDB..TEMPSTOCKREPORT'     "
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + ' WHERE '     "
        strSql += vbCrLf + " 		IF @TRANSACTIONONLY = 'P'"
        strSql += vbCrLf + " 		BEGIN     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' /**PCS ONLY**/'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(RPCS,0) = 0 AND ISNULL(TIPCS,0) = 0 AND ISNULL(IPCS,0) = 0 AND ISNULL(MIPCS,0) = 0 )'     "
        strSql += vbCrLf + " 		END     "
        strSql += vbCrLf + " 		IF @TRANSACTIONONLY = 'PG'     "
        strSql += vbCrLf + " 		BEGIN     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' /**PCS WITH GRSWT ONLY**/'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0)'     "
        strSql += vbCrLf + " 		END     "
        strSql += vbCrLf + " 		IF @TRANSACTIONONLY = 'PN'     "
        strSql += vbCrLf + " 		BEGIN     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' /**PCS WITH NETWT ONLY**/'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRNETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RNETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TINETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(INETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MINETWT,0) = 0)'     "
        strSql += vbCrLf + " 		END     "
        strSql += vbCrLf + " 		IF @TRANSACTIONONLY = 'PGN'     "
        strSql += vbCrLf + " 		BEGIN     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' /**PCS WITH GRSWT AND NETWT **/'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0 AND ISNULL(TRNETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0 AND ISNULL(RNETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0 AND ISNULL(TINETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0 AND ISNULL(INETWT,0) = 0'     "
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0 AND ISNULL(MINETWT,0) = 0)'     "
        strSql += vbCrLf + " 		END     "
        strSql += vbCrLf + " 		EXEC (@QRY)     "
        strSql += vbCrLf + " 	END /** DELETE WITHOUT TRANSATION ROWS **/     "
        strSql += vbCrLf + " 	/** Inserting Title,Subtotal and GrandTotal **/             "
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPSTOCKREPORT)>0             "
        strSql += vbCrLf + " 	BEGIN              "
        strSql += vbCrLf + " 		IF @SUMMARY = 'N'             "
        strSql += vbCrLf + " 		BEGIN             "
        strSql += vbCrLf + " 			UPDATE TEMPTABLEDB..TEMPSTOCKREPORT SET PARTICULAR = '  ' + CASE WHEN ISNULL(SUBITEMNAME,'') <> '' THEN SUBITEMNAME ELSE ITEMNAME END WHERE RESULT = 1             "
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD)             "
        strSql += vbCrLf + " 			SELECT DISTINCT ITEMCTRNAME,ITEMCTRNAME,0 RESULT,'T' FROM TEMPTABLEDB..TEMPSTOCKREPORT WHERE RESULT = 1             "
        strSql += vbCrLf + " 			INSERT INTO TEMPTABLEDB..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD             "
        strSql += vbCrLf + " 			,OPCS,OGRSWT,ONETWT     "
        strSql += vbCrLf + " 			,TRPCS,TRGRSWT,TRNETWT             "
        strSql += vbCrLf + " 			,RPCS,RGRSWT,RNETWT             "
        strSql += vbCrLf + " 			,TIPCS,TIGRSWT,TINETWT             "
        strSql += vbCrLf + " 			,IPCS,IGRSWT,INETWT             "
        strSql += vbCrLf + " 			,MIPCS,MIGRSWT,MINETWT             "
        strSql += vbCrLf + " 			,CPCS,CGRSWT,CNETWT             "
        strSql += vbCrLf + " 			)             "
        strSql += vbCrLf + " 			SELECT 'SUBTOTAL'PARTICULAR,ITEMCTRNAME,2 RESULT,'S'COLHEAD             "
        strSql += vbCrLf + " 			,SUM(OPCS),SUM(OGRSWT),SUM(ONETWT)             "
        strSql += vbCrLf + " 			,SUM(TRPCS),SUM(TRGRSWT),SUM(TRNETWT)     "
        strSql += vbCrLf + " 			,SUM(RPCS),SUM(RGRSWT),SUM(RNETWT)             "
        strSql += vbCrLf + " 			,SUM(TIPCS),SUM(TIGRSWT),SUM(TINETWT)             "
        strSql += vbCrLf + " 			,SUM(IPCS),SUM(IGRSWT),SUM(INETWT)             "
        strSql += vbCrLf + " 			,SUM(MIPCS),SUM(MIGRSWT),SUM(MINETWT)             "
        strSql += vbCrLf + " 			,SUM(CPCS),SUM(CGRSWT),SUM(CNETWT)             "
        strSql += vbCrLf + " 			FROM TEMPTABLEDB..TEMPSTOCKREPORT WHERE RESULT = 1 GROUP BY ITEMCTRNAME             "
        strSql += vbCrLf + " 		END             "
        strSql += vbCrLf + " 		/** Inserting Grand Total **/             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD             "
        strSql += vbCrLf + " 		,OPCS,OGRSWT,ONETWT             "
        strSql += vbCrLf + " 		,TRPCS,TRGRSWT,TRNETWT             "
        strSql += vbCrLf + " 		,RPCS,RGRSWT,RNETWT             "
        strSql += vbCrLf + " 		,TIPCS,TIGRSWT,TINETWT             "
        strSql += vbCrLf + " 		,IPCS,IGRSWT,INETWT             "
        strSql += vbCrLf + " 		,MIPCS,MIGRSWT,MINETWT             "
        strSql += vbCrLf + " 		,CPCS,CGRSWT,CNETWT             "
        strSql += vbCrLf + " 		)             "
        strSql += vbCrLf + " 		SELECT 'GRAND TOTAL'PARTICULAR,'ZZZZZ',3 RESULT,'G'COLHEAD             "
        strSql += vbCrLf + " 		,SUM(OPCS),SUM(OGRSWT),SUM(ONETWT)          "
        strSql += vbCrLf + " 		,SUM(TRPCS),SUM(TRGRSWT),SUM(TRNETWT)             "
        strSql += vbCrLf + " 		,SUM(RPCS),SUM(RGRSWT),SUM(RNETWT)             "
        strSql += vbCrLf + " 		,SUM(TIPCS),SUM(TIGRSWT),SUM(TINETWT)             "
        strSql += vbCrLf + " 		,SUM(IPCS),SUM(IGRSWT),SUM(INETWT)             "
        strSql += vbCrLf + " 		,SUM(MIPCS),SUM(MIGRSWT),SUM(MINETWT)             "
        strSql += vbCrLf + " 		,SUM(CPCS),SUM(CGRSWT),SUM(CNETWT)             "
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMPSTOCKREPORT WHERE RESULT = 1             "
        strSql += vbCrLf + " 	END             "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMPSTOCKREPORT SET              "
        strSql += vbCrLf + " 	OPCS = CASE WHEN OPCS = 0 THEN NULL ELSE OPCS END             "
        strSql += vbCrLf + " 	,OGRSWT = CASE WHEN OGRSWT = 0 THEN NULL ELSE OGRSWT END             "
        strSql += vbCrLf + " 	,ONETWT = CASE WHEN ONETWT = 0 THEN NULL ELSE ONETWT END             "
        strSql += vbCrLf + " 	,TRPCS = CASE WHEN TRPCS = 0 THEN NULL ELSE TRPCS END             "
        strSql += vbCrLf + " 	,TRGRSWT = CASE WHEN TRGRSWT = 0 THEN NULL ELSE TRGRSWT END             "
        strSql += vbCrLf + " 	,TRNETWT = CASE WHEN TRNETWT = 0 THEN NULL ELSE TRNETWT END             "
        strSql += vbCrLf + " 	,RPCS = CASE WHEN RPCS = 0 THEN NULL ELSE RPCS END             "
        strSql += vbCrLf + " 	,RGRSWT = CASE WHEN RGRSWT = 0 THEN NULL ELSE RGRSWT END             "
        strSql += vbCrLf + " 	,RNETWT = CASE WHEN RNETWT = 0 THEN NULL ELSE RNETWT END             "
        strSql += vbCrLf + " 	,TIPCS = CASE WHEN TIPCS = 0 THEN NULL ELSE TIPCS END             "
        strSql += vbCrLf + " 	,TIGRSWT = CASE WHEN TIGRSWT = 0 THEN NULL ELSE TIGRSWT END   "
        strSql += vbCrLf + " 	,TINETWT = CASE WHEN TINETWT = 0 THEN NULL ELSE TINETWT END             "
        strSql += vbCrLf + " 	,IPCS = CASE WHEN IPCS = 0 THEN NULL ELSE IPCS END             "
        strSql += vbCrLf + " 	,IGRSWT = CASE WHEN IGRSWT = 0 THEN NULL ELSE IGRSWT END             "
        strSql += vbCrLf + " 	,INETWT = CASE WHEN INETWT = 0 THEN NULL ELSE INETWT END        "
        strSql += vbCrLf + " 	,MIPCS = CASE WHEN MIPCS = 0 THEN NULL ELSE MIPCS END             "
        strSql += vbCrLf + " 	,MIGRSWT = CASE WHEN MIGRSWT = 0 THEN NULL ELSE MIGRSWT END             "
        strSql += vbCrLf + " 	,MINETWT = CASE WHEN MINETWT = 0 THEN NULL ELSE MINETWT END             "
        strSql += vbCrLf + " 	,CPCS = CASE WHEN CPCS = 0 THEN NULL ELSE CPCS END             "
        strSql += vbCrLf + " 	,CGRSWT = CASE WHEN CGRSWT = 0 THEN NULL ELSE CGRSWT END             "
        strSql += vbCrLf + " 	,CNETWT = CASE WHEN CNETWT = 0 THEN NULL ELSE CNETWT END "
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSP28CounterWiseStock1()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COUNTERWISESTOCK1')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERWISESTOCK1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "     CREATE PROCEDURE SP_RPT_COUNTERWISESTOCK1        ("
        strSql += vbCrLf + "@ASONDATE SMALLDATETIME             "
        strSql += vbCrLf + ",@METAL VARCHAR(100)             "
        strSql += vbCrLf + ",@CATNAME VARCHAR(100)             "
        strSql += vbCrLf + ",@ITEMNAME VARCHAR(100)             "
        strSql += vbCrLf + ",@DESIGNER VARCHAR(100)             "
        strSql += vbCrLf + ",@SUMMARY VARCHAR(1)             "
        strSql += vbCrLf + ",@STOCKTYPE VARCHAR(1)             "
        strSql += vbCrLf + ",@WITHSUBITEM VARCHAR(1)             "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(2000)             "
        strSql += vbCrLf + ",@ITEMTYPE VARCHAR(5000)             "
        strSql += vbCrLf + ",@COUNTER VARCHAR(5000)             "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(5000)             "
        strSql += vbCrLf + ",@ORDER VARCHAR(1) /** IF ORDER THEN 'O' ELSE '' END **/             "
        strSql += vbCrLf + ",@APPROVAL VARCHAR(10) /** IF APPROVAL THEN 'A' ELSE '' END **/             "
        strSql += vbCrLf + ",@TRANSFER_DETAIL VARCHAR(1)     "
        strSql += vbCrLf + ",@TRANSACTIONONLY VARCHAR(1)     "
        strSql += vbCrLf + ",@ORDERBYID VARCHAR(1)    "
        strSql += vbCrLf + ")             "
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "SET NOCOUNT ON             "
        strSql += vbCrLf + "        CREATE TABLE #FLAG (FLAG VARCHAR(1))       "
        strSql += vbCrLf + "INSERT INTO #FLAG(FLAG)       "
        strSql += vbCrLf + "SELECT 'C' UNION ALL  SELECT '' UNION ALL  SELECT NULL       "
        strSql += vbCrLf + "DECLARE @HIDEBACKOFFICE VARCHAR(1)       "
        strSql += vbCrLf + "SELECT @HIDEBACKOFFICE = CTLTEXT  FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE'       "
        strSql += vbCrLf + "IF ISNULL(@HIDEBACKOFFICE,'N') = 'N' INSERT INTO #FLAG(FLAG)SELECT 'B'       "
        strSql += vbCrLf + "CREATE TABLE #METAL (METALID VARCHAR(1))             "
        strSql += vbCrLf + "IF @METAL = 'ALL' OR @METAL = ''             "
        strSql += vbCrLf + "INSERT INTO #METAL(METALID)SELECT METALID FROM " & compId & "ADMINDB..METALMAST             "
        strSql += vbCrLf + "Else"
        strSql += vbCrLf + "INSERT INTO #METAL(METALID)SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METAL             "
        strSql += vbCrLf + "CREATE TABLE #CATEGORY (CATCODE VARCHAR(10))             "
        strSql += vbCrLf + "IF @CATNAME = 'ALL' OR @CATNAME = ''             "
        strSql += vbCrLf + "INSERT INTO #CATEGORY(CATCODE)SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY             "
        strSql += vbCrLf + "Else"
        strSql += vbCrLf + "INSERT INTO #CATEGORY(CATCODE)SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME = @CATNAME             "
        strSql += vbCrLf + "CREATE TABLE #ITEM (ITEMID INT,STOCKTYPE VARCHAR(2))             "
        strSql += vbCrLf + "IF @ITEMNAME = 'ALL' OR @ITEMNAME = ''             "
        strSql += vbCrLf + "INSERT INTO #ITEM(ITEMID,STOCKTYPE)SELECT ITEMID,STOCKTYPE FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(ACTIVE,'') = 'Y' AND ISNULL(STOCKREPORT,'') = 'Y'             "
        strSql += vbCrLf + "Else"
        strSql += vbCrLf + "INSERT INTO #ITEM(ITEMID,STOCKTYPE)SELECT ITEMID,STOCKTYPE FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMNAME = @ITEMNAME AND ISNULL(ACTIVE,'') = 'Y' AND ISNULL(STOCKREPORT,'') = 'Y'             "
        strSql += vbCrLf + "CREATE TABLE #DESIGNER (DESIGNERID INT)             "
        strSql += vbCrLf + "IF @DESIGNER = 'ALL' OR @DESIGNER = ''             "
        strSql += vbCrLf + "INSERT INTO #DESIGNER(DESIGNERID)SELECT DESIGNERID FROM " & compId & "ADMINDB..DESIGNER UNION ALL SELECT 0             "
        strSql += vbCrLf + "Else"
        strSql += vbCrLf + "INSERT INTO #DESIGNER(DESIGNERID)SELECT DESIGNERID FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERNAME = @DESIGNER             "
        strSql += vbCrLf + "/**SPLIT COMPANY **/               "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY       "
        strSql += vbCrLf + "CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))       "
        strSql += vbCrLf + "DECLARE @TCOMPANY VARCHAR(50)       "
        strSql += vbCrLf + "IF CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID       "
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "WHILE CHARINDEX(',',@COMPANYID)>0       "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)       "
        strSql += vbCrLf + "SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))       "
        strSql += vbCrLf + "IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @COMPANYID= @COMPANYID + ','       "
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY       "
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "/**SPLIT COSTNAME **/             "
        strSql += vbCrLf + "CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))             "
        strSql += vbCrLf + "IF @COSTNAME = 'ALL' OR @COSTNAME = ''             "
        strSql += vbCrLf + "INSERT INTO #COSTCENTRE(COSTID)SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE UNION ALL SELECT ''             "
        strSql += vbCrLf + " ELSE IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..COSTCENTRE)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + " IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME              "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + " SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + " IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + " SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMPNAME"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " Else"
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID)SELECT ''              "
        strSql += vbCrLf + " /**SPLIT ITEMTYPE **/             "
        strSql += vbCrLf + " CREATE TABLE #ITEMTYPE (ITEMTYPEID INT)             "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMTYPE)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @TEMPITEMTYPE VARCHAR(20)"
        strSql += vbCrLf + " IF CHARINDEX(',',@ITEMTYPE)=0"
        strSql += vbCrLf + " INSERT INTO #ITEMTYPE (ITEMTYPEID) SELECT ITEMTYPEID FROM " & compId & "ADMINDB..ITEMTYPE WHERE NAME = @ITEMTYPE             "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@ITEMTYPE)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @TEMPITEMTYPE=LEFT(@ITEMTYPE,CHARINDEX(',',@ITEMTYPE)-1)"
        strSql += vbCrLf + " SET @ITEMTYPE=RIGHT(@ITEMTYPE,LEN(@ITEMTYPE)-CHARINDEX(',',@ITEMTYPE))"
        strSql += vbCrLf + " IF @ITEMTYPE <>'' AND CHARINDEX(',',@ITEMTYPE)=0"
        strSql += vbCrLf + " SET @ITEMTYPE= @ITEMTYPE + ','"
        strSql += vbCrLf + " INSERT INTO #ITEMTYPE (ITEMTYPEID) SELECT ITEMTYPEID FROM " & compId & "ADMINDB..ITEMTYPE WHERE NAME = @TEMPITEMTYPE"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " Else"
        strSql += vbCrLf + " INSERT INTO #ITEMTYPE(ITEMTYPEID)SELECT 0             "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM #ITEMTYPE) = (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMTYPE)             "
        strSql += vbCrLf + " INSERT INTO #ITEMTYPE(ITEMTYPEID) SELECT 0             "
        strSql += vbCrLf + " /**SPLIT COUNTER **/             "
        strSql += vbCrLf + " CREATE TABLE #ITEMCOUNTER (ITEMCTRID INT)             "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMCOUNTER)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @TEMPCOUNTER VARCHAR(100)"
        strSql += vbCrLf + " IF CHARINDEX(',',@COUNTER)=0"
        strSql += vbCrLf + " INSERT INTO #ITEMCOUNTER (ITEMCTRID) SELECT ITEMCTRID FROM " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRNAME = @COUNTER             "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COUNTER)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @TEMPCOUNTER=LEFT(@COUNTER,CHARINDEX(',',@COUNTER)-1)"
        strSql += vbCrLf + " SET @COUNTER=RIGHT(@COUNTER,LEN(@COUNTER)-CHARINDEX(',',@COUNTER))"
        strSql += vbCrLf + " IF @COUNTER <>'' AND CHARINDEX(',',@COUNTER)=0"
        strSql += vbCrLf + " SET @COUNTER= @COUNTER + ','"
        strSql += vbCrLf + " INSERT INTO #ITEMCOUNTER (ITEMCTRID) SELECT ITEMCTRID FROM " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRNAME = @TEMPCOUNTER             "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " Else"
        strSql += vbCrLf + " INSERT INTO #ITEMCOUNTER(ITEMCTRID)SELECT 0        "
        strSql += vbCrLf + " /** SPLIT APPROVAL **/       "
        strSql += vbCrLf + " CREATE TABLE #APPROVAL (APPROVAL VARCHAR(1))               "
        strSql += vbCrLf + " DECLARE @TEMPAPPROVAL VARCHAR(1)          "
        strSql += vbCrLf + " IF @APPROVAL = ''       "
        strSql += vbCrLf + " INSERT INTO #APPROVAL(APPROVAL) SELECT DISTINCT APPROVAL FROM " & cnAdminDb & "..ITEMTAG WHERE APPROVAL <>'A'       "
        strSql += vbCrLf + " IF @APPROVAL = 'A'         "
        strSql += vbCrLf + " INSERT INTO #APPROVAL(APPROVAL) SELECT DISTINCT APPROVAL FROM " & cnAdminDb & "..ITEMTAG"
        strSql += vbCrLf + " IF @APPROVAL = 'O'         "
        strSql += vbCrLf + " INSERT INTO #APPROVAL(APPROVAL) SELECT 'A'"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM #ITEMCOUNTER) = (SELECT COUNT(*) FROM " & compId & "ADMINDB..ITEMCOUNTER)             "
        strSql += vbCrLf + " INSERT INTO #ITEMCOUNTER(ITEMCTRID) SELECT 0      "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ITEMTAG') IS NOT NULL DROP TABLE #ITEMTAG   "
        strSql += vbCrLf + " SELECT *,CONVERT(VARCHAR(5),'TAG')FROMTABLE INTO #ITEMTAG FROM " & cnAdminDb & "..ITEMTAG AS T   "
        strSql += vbCrLf + " WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT METALID FROM #METAL))             "
        strSql += vbCrLf + " AND T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE CATCODE IN (SELECT CATCODE FROM #CATEGORY))             "
        strSql += vbCrLf + " AND T.ITEMID IN (SELECT ITEMID FROM #ITEM)             "
        strSql += vbCrLf + " AND ISNULL(T.DESIGNERID,0) IN (SELECT DESIGNERID FROM #DESIGNER)             "
        strSql += vbCrLf + " AND T.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)             "
        strSql += vbCrLf + " AND ISNULL(T.ITEMTYPEID,0) IN (SELECT ITEMTYPEID FROM #ITEMTYPE)             "
        strSql += vbCrLf + " AND ISNULL(T.APPROVAL,'') IN (SELECT APPROVAL FROM #APPROVAL)    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ITEMNONTAG') IS NOT NULL DROP TABLE #ITEMNONTAG   "
        strSql += vbCrLf + " SELECT *    "
        strSql += vbCrLf + " INTO #ITEMNONTAG    "
        strSql += vbCrLf + " FROM " & cnAdminDb & "..ITEMNONTAG T   "
        strSql += vbCrLf + " WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT METALID FROM #METAL))             "
        strSql += vbCrLf + " AND T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE CATCODE IN (SELECT CATCODE FROM #CATEGORY))        "
        strSql += vbCrLf + " AND T.ITEMID IN (SELECT ITEMID FROM #ITEM)             "
        strSql += vbCrLf + " AND ISNULL(T.DESIGNERID,0) IN (SELECT DESIGNERID FROM #DESIGNER)             "
        strSql += vbCrLf + " AND T.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)             "
        strSql += vbCrLf + " AND ISNULL(T.ITEMCTRID,0) IN (SELECT ITEMCTRID FROM #ITEMCOUNTER)             "
        strSql += vbCrLf + " AND ISNULL(T.ITEMTYPEID,0) IN (SELECT ITEMTYPEID FROM #ITEMTYPE)             "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " AND ISNULL(T.FLAG,'') IN (SELECT FLAG FROM #FLAG)       "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + " /**Create Report Table **/             "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPITEMSTOCK1')>0 DROP TABLE MASTER..TEMPITEMSTOCK1             "
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMPITEMSTOCK1             "
        strSql += vbCrLf + " (             "
        strSql += vbCrLf + " SEP VARCHAR(5)"
        strSql += vbCrLf + " ,ITEMCTRID INT,ITEMID INT,SUBITEMID INT,PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),SNO VARCHAR(15)             "
        strSql += vbCrLf + " )             "
        strSql += vbCrLf + " IF @STOCKTYPE = 'T' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " /** Getting Opening **/             "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPITEMSTOCK1 (SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO)             "
        strSql += vbCrLf + " SELECT 'OPE'SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO FROM #ITEMTAG T WHERE RECDATE < @ASONDATE AND (ISSDATE IS NULL OR ISSDATE >= @ASONDATE)       "
        strSql += vbCrLf + " AND NOT EXISTS (SELECT 1 FROM ..CTRANSFER C WHERE C.TAGSNO = T.SNO)"
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT DISTINCT CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS'  ELSE 'ISS' END SEP       "
        strSql += vbCrLf + " ,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO FROM #ITEMTAG  T        "
        strSql += vbCrLf + " LEFT OUTER JOIN ISSUE AS I ON I.BATCHNO = T.BATCHNO AND I.TAGNO = T.TAGNO       "
        strSql += vbCrLf + " WHERE T.ISSDATE = @ASONDATE       "
        strSql += vbCrLf + " AND NOT EXISTS (SELECT 1 FROM ..CTRANSFER C WHERE C.TAGSNO = T.SNO)       "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT 'REC'SEP       "
        strSql += vbCrLf + " ,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO FROM #ITEMTAG T WHERE RECDATE = @ASONDATE       "
        strSql += vbCrLf + " AND NOT EXISTS (SELECT 1 FROM ..CTRANSFER C WHERE C.TAGSNO = T.SNO)       "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT 'OPE'SEP       "
        strSql += vbCrLf + " ,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " FROM ..CTRANSFER C INNER JOIN #ITEMTAG AS T ON C.TAGSNO = T.SNO  AND (T.ISSDATE IS NULL OR T.ISSDATE >= @ASONDATE)"
        strSql += vbCrLf + " WHERE C.RECDATE < @ASONDATE AND (C.ISSDATE IS NULL OR C.ISSDATE >= @ASONDATE)  "
        strSql += vbCrLf + " AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)        "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN 'TISS'  ELSE 'ISS' END AS SEP     "
        strSql += vbCrLf + " ,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " FROM ..CTRANSFER AS C INNER JOIN #ITEMTAG AS  T ON C.TAGSNO = T.SNO    "
        strSql += vbCrLf + " WHERE C.ISSDATE = @ASONDATE     "
        strSql += vbCrLf + " AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER    "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN C.ENTORDER = 1 THEN 'REC' ELSE 'TREC'END ELSE 'REC' END SEP       "
        strSql += vbCrLf + " ,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " FROM ..CTRANSFER AS C INNER JOIN #ITEMTAG T ON C.TAGSNO = T.SNO WHERE C.RECDATE = @ASONDATE     "
        strSql += vbCrLf + " AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER    "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT DISTINCT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS' ELSE 'ISS' END ELSE 'ISS' END SEP    "
        strSql += vbCrLf + " ,C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO       "
        strSql += vbCrLf + " FROM ..CTRANSFER AS C        "
        strSql += vbCrLf + " INNER JOIN #ITEMTAG AS  T ON C.TAGSNO = T.SNO AND T.ISSDATE IS NOT NULL AND T.ISSDATE = @ASONDATE AND T.TOFLAG <> 'TR'    "
        strSql += vbCrLf + " LEFT OUTER JOIN ISSUE AS I ON I.BATCHNO = T.BATCHNO       "
        strSql += vbCrLf + " WHERE(C.ISSDATE Is NULL)"
        strSql += vbCrLf + " AND ISNULL(C.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + " GROUP BY C.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO,C.ENTORDER,I.TRANTYPE    "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @STOCKTYPE = 'N' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " /** Getting Non Tag Values **/             "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPITEMSTOCK1 (SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO)             "
        strSql += vbCrLf + " SELECT 'OPE'SEP,ITEMCTRID,ITEMID,SUBITEMID             "
        strSql += vbCrLf + " ,CASE WHEN RECISS = 'R' THEN PCS ELSE -1*PCS END AS PCS             "
        strSql += vbCrLf + " ,CASE WHEN RECISS = 'R' THEN GRSWT ELSE -1*GRSWT END AS GRSWT             "
        strSql += vbCrLf + " ,CASE WHEN RECISS = 'R' THEN NETWT ELSE -1*NETWT END AS NETWT,SNO             "
        strSql += vbCrLf + " FROM #ITEMNONTAG T WHERE RECDATE < @ASONDATE             "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT DISTINCT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN I.TRANTYPE = 'MI' THEN 'MISS' WHEN ISNULL(POSTED,'') = 'C' THEN 'TISS' ELSE 'ISS' END ELSE 'ISS' END SEP     "
        strSql += vbCrLf + " ,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT,T.SNO             "
        strSql += vbCrLf + " FROM #ITEMNONTAG T              "
        strSql += vbCrLf + " LEFT OUTER JOIN " & tranDbName & "..ISSUE AS I ON ISNULL(T.BATCHNO,'') = I.BATCHNO             "
        strSql += vbCrLf + " WHERE T.RECDATE = @ASONDATE AND T.RECISS = 'I'             "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT CASE WHEN @TRANSFER_DETAIL = 'Y' THEN CASE WHEN ISNULL(POSTED,'') = 'C' THEN 'TREC' ELSE 'REC' END ELSE 'REC' END SEP,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,SNO             "
        strSql += vbCrLf + " FROM #ITEMNONTAG T WHERE RECDATE = @ASONDATE AND RECISS = 'R'             "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @SUMMARY = 'Y'             "
        strSql += vbCrLf + " UPDATE MASTER..TEMPITEMSTOCK1 SET ITEMID = NULL             "
        strSql += vbCrLf + " IF @SUMMARY = 'Y' OR @WITHSUBITEM = 'N'             "
        strSql += vbCrLf + " UPDATE MASTER..TEMPITEMSTOCK1 SET SUBITEMID = NULL             "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSTOCKREPORT')>0 DROP TABLE MASTER..TEMPSTOCKREPORT             "
        strSql += vbCrLf + " SELECT      "
        strSql += vbCrLf + " CONVERT(vARCHAR(300),CASE WHEN @ORDERBYID = 'Y' THEN '['+REPLICATE(' ',5-LEN(C.ITEMCTRID)) + CONVERT(VARCHAR,C.ITEMCTRID) + '] ' + C.ITEMCTRNAME ELSE C.ITEMCTRNAME END) AS PARTICULAR    "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'OPE' THEN T.PCS ELSE 0 END) AS OPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'OPE' THEN T.GRSWT ELSE 0 END) AS OGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'OPE' THEN T.NETWT ELSE 0 END) AS ONETWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TREC' THEN T.PCS ELSE 0 END) AS TRPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TREC' THEN T.GRSWT ELSE 0 END) AS TRGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TREC' THEN T.NETWT ELSE 0 END) AS TRNETWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'REC' THEN T.PCS ELSE 0 END) AS RPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'REC' THEN T.GRSWT ELSE 0 END) AS RGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'REC' THEN T.NETWT ELSE 0 END) AS RNETWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TISS' THEN T.PCS ELSE 0 END) AS TIPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TISS' THEN T.GRSWT ELSE 0 END) AS TIGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'TISS' THEN T.NETWT ELSE 0 END) AS TINETWT "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' THEN T.PCS ELSE 0 END) AS IPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' THEN T.GRSWT ELSE 0 END) AS IGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' THEN T.NETWT ELSE 0 END) AS INETWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'MISS' THEN T.PCS ELSE 0 END) AS MIPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'MISS' THEN T.GRSWT ELSE 0 END) AS MIGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'MISS' THEN T.NETWT ELSE 0 END) AS MINETWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.PCS ELSE T.PCS END) AS CPCS             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.GRSWT ELSE T.GRSWT END) AS CGRSWT             "
        strSql += vbCrLf + " ,SUM(CASE WHEN SEP = 'ISS' OR SEP = 'TISS' OR SEP = 'MISS' THEN -1*T.NETWT ELSE T.NETWT END) AS CNETWT             "
        strSql += vbCrLf + " ,CONVERT(vARCHAR(200),CASE WHEN @ORDERBYID = 'Y' THEN '['+REPLICATE(' ',5-LEN(C.ITEMCTRID)) + CONVERT(VARCHAR,C.ITEMCTRID) + '] ' + C.ITEMCTRNAME ELSE C.ITEMCTRNAME END) AS ITEMCTRNAME    "
        strSql += vbCrLf + " ,CONVERT(vARCHAR(200),CASE WHEN @ORDERBYID = 'Y' AND @SUMMARY = 'N' AND @WITHSUBITEM = 'N'  THEN '['+REPLICATE(' ',5-LEN(I.ITEMID)) + CONVERT(VARCHAR,I.ITEMID) + '] ' + I.ITEMNAME ELSE I.ITEMNAME END) AS ITEMNAME  "
        strSql += vbCrLf + " ,S.SUBITEMNAME,CONVERT(INT,1) RESULT,CONVERT(VARCHAR(2),'')COLHEAD  "
        strSql += vbCrLf + " INTO MASTER..TEMPSTOCKREPORT  "
        strSql += vbCrLf + " FROM MASTER..TEMPITEMSTOCK1 AS T  "
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..ITEMMAST AS I ON I.ITEMID = T.ITEMID  "
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS S ON S.ITEMID = T.ITEMID AND S.SUBITEMID = T.SUBITEMID             "
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..ITEMCOUNTER AS C ON C.ITEMCTRID = T.ITEMCTRID  "
        strSql += vbCrLf + " WHERE ISNULL(T.ITEMCTRID,0) IN (SELECT ITEMCTRID FROM #ITEMCOUNTER)  "
        strSql += vbCrLf + " GROUP BY C.ITEMCTRID,C.ITEMCTRNAME,I.ITEMNAME,S.SUBITEMNAME,I.ITEMID  "
        strSql += vbCrLf + " IF @TRANSACTIONONLY = 'PGN' /** TRAN CONTAIN PCS,GRSWT,NETWT **/     "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DELETE FROM MASTER..TEMPSTOCKREPORT     "
        strSql += vbCrLf + " WHERE"
        strSql += vbCrLf + " (ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0 AND ISNULL(TRNETWT,0) = 0     "
        strSql += vbCrLf + " AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0 AND ISNULL(RNETWT,0) = 0     "
        strSql += vbCrLf + " AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0 AND ISNULL(TINETWT,0) = 0     "
        strSql += vbCrLf + " AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0 AND ISNULL(INETWT,0) = 0     "
        strSql += vbCrLf + " AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0 AND ISNULL(MINETWT,0) = 0)     "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @TRANSACTIONONLY <> '' /** TRAN CONTAIN PCS,GRSWT,NETWT **/     "
        strSql += vbCrLf + " BEGIN /** DELETE WITHOUT TRANSATION ROWS **/     "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(4000)     "
        strSql += vbCrLf + " SELECT @QRY = ''     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' DELETE FROM MASTER..TEMPSTOCKREPORT'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' WHERE '     "
        strSql += vbCrLf + " IF @TRANSACTIONONLY = 'P'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' /**PCS ONLY**/'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(RPCS,0) = 0 AND ISNULL(TIPCS,0) = 0 AND ISNULL(IPCS,0) = 0 AND ISNULL(MIPCS,0) = 0 )'     "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @TRANSACTIONONLY = 'PG'     "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' /**PCS WITH GRSWT ONLY**/'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0)'     "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @TRANSACTIONONLY = 'PN'     "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' /**PCS WITH NETWT ONLY**/'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRNETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RNETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TINETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(INETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MINETWT,0) = 0)'     "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " IF @TRANSACTIONONLY = 'PGN'     "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' /**PCS WITH GRSWT AND NETWT **/'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' (ISNULL(TRPCS,0) = 0 AND ISNULL(TRGRSWT,0) = 0 AND ISNULL(TRNETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0 AND ISNULL(RNETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(TIPCS,0) = 0 AND ISNULL(TIGRSWT,0) = 0 AND ISNULL(TINETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0 AND ISNULL(INETWT,0) = 0'     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + ' AND ISNULL(MIPCS,0) = 0 AND ISNULL(MIGRSWT,0) = 0 AND ISNULL(MINETWT,0) = 0)'     "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " EXEC (@QRY)     "
        strSql += vbCrLf + " END /** DELETE WITHOUT TRANSATION ROWS **/     "
        strSql += vbCrLf + " /** Inserting Title,Subtotal and GrandTotal **/             "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMPSTOCKREPORT)>0             "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF @SUMMARY = 'N'             "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " UPDATE MASTER..TEMPSTOCKREPORT SET PARTICULAR = '  ' + CASE WHEN ISNULL(SUBITEMNAME,'') <> '' THEN SUBITEMNAME ELSE ITEMNAME END WHERE RESULT = 1             "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD)             "
        strSql += vbCrLf + " SELECT DISTINCT ITEMCTRNAME,ITEMCTRNAME,0 RESULT,'T' FROM MASTER..TEMPSTOCKREPORT WHERE RESULT = 1             "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD             "
        strSql += vbCrLf + " ,OPCS,OGRSWT,ONETWT     "
        strSql += vbCrLf + " ,TRPCS,TRGRSWT,TRNETWT             "
        strSql += vbCrLf + " ,RPCS,RGRSWT,RNETWT             "
        strSql += vbCrLf + " ,TIPCS,TIGRSWT,TINETWT             "
        strSql += vbCrLf + " ,IPCS,IGRSWT,INETWT             "
        strSql += vbCrLf + " ,MIPCS,MIGRSWT,MINETWT             "
        strSql += vbCrLf + " ,CPCS,CGRSWT,CNETWT             "
        strSql += vbCrLf + " )             "
        strSql += vbCrLf + " SELECT 'SUBTOTAL'PARTICULAR,ITEMCTRNAME,2 RESULT,'S'COLHEAD             "
        strSql += vbCrLf + " ,SUM(OPCS),SUM(OGRSWT),SUM(ONETWT)             "
        strSql += vbCrLf + " ,SUM(TRPCS),SUM(TRGRSWT),SUM(TRNETWT)     "
        strSql += vbCrLf + " ,SUM(RPCS),SUM(RGRSWT),SUM(RNETWT)             "
        strSql += vbCrLf + " ,SUM(TIPCS),SUM(TIGRSWT),SUM(TINETWT)             "
        strSql += vbCrLf + " ,SUM(IPCS),SUM(IGRSWT),SUM(INETWT)             "
        strSql += vbCrLf + " ,SUM(MIPCS),SUM(MIGRSWT),SUM(MINETWT)             "
        strSql += vbCrLf + " ,SUM(CPCS),SUM(CGRSWT),SUM(CNETWT)             "
        strSql += vbCrLf + " FROM MASTER..TEMPSTOCKREPORT WHERE RESULT = 1 GROUP BY ITEMCTRNAME             "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " /** Inserting Grand Total **/             "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMPSTOCKREPORT(PARTICULAR,ITEMCTRNAME,RESULT,COLHEAD             "
        strSql += vbCrLf + " ,OPCS,OGRSWT,ONETWT             "
        strSql += vbCrLf + " ,TRPCS,TRGRSWT,TRNETWT             "
        strSql += vbCrLf + " ,RPCS,RGRSWT,RNETWT             "
        strSql += vbCrLf + " ,TIPCS,TIGRSWT,TINETWT             "
        strSql += vbCrLf + " ,IPCS,IGRSWT,INETWT             "
        strSql += vbCrLf + " ,MIPCS,MIGRSWT,MINETWT             "
        strSql += vbCrLf + " ,CPCS,CGRSWT,CNETWT             "
        strSql += vbCrLf + " )             "
        strSql += vbCrLf + " SELECT 'GRAND TOTAL'PARTICULAR,'ZZZZZ',3 RESULT,'G'COLHEAD             "
        strSql += vbCrLf + " ,SUM(OPCS),SUM(OGRSWT),SUM(ONETWT)          "
        strSql += vbCrLf + " ,SUM(TRPCS),SUM(TRGRSWT),SUM(TRNETWT)             "
        strSql += vbCrLf + " ,SUM(RPCS),SUM(RGRSWT),SUM(RNETWT)             "
        strSql += vbCrLf + " ,SUM(TIPCS),SUM(TIGRSWT),SUM(TINETWT)             "
        strSql += vbCrLf + " ,SUM(IPCS),SUM(IGRSWT),SUM(INETWT)             "
        strSql += vbCrLf + " ,SUM(MIPCS),SUM(MIGRSWT),SUM(MINETWT)             "
        strSql += vbCrLf + " ,SUM(CPCS),SUM(CGRSWT),SUM(CNETWT)             "
        strSql += vbCrLf + " FROM MASTER..TEMPSTOCKREPORT WHERE RESULT = 1             "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " UPDATE MASTER..TEMPSTOCKREPORT SET              "
        strSql += vbCrLf + " OPCS = CASE WHEN OPCS = 0 THEN NULL ELSE OPCS END             "
        strSql += vbCrLf + " ,OGRSWT = CASE WHEN OGRSWT = 0 THEN NULL ELSE OGRSWT END             "
        strSql += vbCrLf + " ,ONETWT = CASE WHEN ONETWT = 0 THEN NULL ELSE ONETWT END             "
        strSql += vbCrLf + " ,TRPCS = CASE WHEN TRPCS = 0 THEN NULL ELSE TRPCS END             "
        strSql += vbCrLf + " ,TRGRSWT = CASE WHEN TRGRSWT = 0 THEN NULL ELSE TRGRSWT END             "
        strSql += vbCrLf + " ,TRNETWT = CASE WHEN TRNETWT = 0 THEN NULL ELSE TRNETWT END             "
        strSql += vbCrLf + " ,RPCS = CASE WHEN RPCS = 0 THEN NULL ELSE RPCS END             "
        strSql += vbCrLf + " ,RGRSWT = CASE WHEN RGRSWT = 0 THEN NULL ELSE RGRSWT END             "
        strSql += vbCrLf + " ,RNETWT = CASE WHEN RNETWT = 0 THEN NULL ELSE RNETWT END             "
        strSql += vbCrLf + " ,TIPCS = CASE WHEN TIPCS = 0 THEN NULL ELSE TIPCS END             "
        strSql += vbCrLf + " ,TIGRSWT = CASE WHEN TIGRSWT = 0 THEN NULL ELSE TIGRSWT END   "
        strSql += vbCrLf + " ,TINETWT = CASE WHEN TINETWT = 0 THEN NULL ELSE TINETWT END             "
        strSql += vbCrLf + " ,IPCS = CASE WHEN IPCS = 0 THEN NULL ELSE IPCS END             "
        strSql += vbCrLf + " ,IGRSWT = CASE WHEN IGRSWT = 0 THEN NULL ELSE IGRSWT END             "
        strSql += vbCrLf + " ,INETWT = CASE WHEN INETWT = 0 THEN NULL ELSE INETWT END        "
        strSql += vbCrLf + " ,MIPCS = CASE WHEN MIPCS = 0 THEN NULL ELSE MIPCS END             "
        strSql += vbCrLf + " ,MIGRSWT = CASE WHEN MIGRSWT = 0 THEN NULL ELSE MIGRSWT END             "
        strSql += vbCrLf + " ,MINETWT = CASE WHEN MINETWT = 0 THEN NULL ELSE MINETWT END             "
        strSql += vbCrLf + " ,CPCS = CASE WHEN CPCS = 0 THEN NULL ELSE CPCS END             "
        strSql += vbCrLf + " ,CGRSWT = CASE WHEN CGRSWT = 0 THEN NULL ELSE CGRSWT END             "
        strSql += vbCrLf + " ,CNETWT = CASE WHEN CNETWT = 0 THEN NULL ELSE CNETWT END"
        'printline(strSql)
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        'MsgBox("Created")
    End Sub

    Private Sub funcSP27TransactionSummary()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TRANSACTIONSUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TRANSACTIONSUMMARY"
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPSALES') IS NOT NULL   DROP TABLE TEMPTABLEDB..TEMPSALES"
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..TEMPTRANSUMMARY') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPTRANSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_TRANSACTIONSUMMARY"
        strSql += vbCrLf + "(      "
        strSql += vbCrLf + "  @FROMDATE SMALLDATETIME      "
        strSql += vbCrLf + "  ,@TODATE SMALLDATETIME      "
        strSql += vbCrLf + "  ,@COSTNAME VARCHAR(5000)      "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + "  ,@SYSTEMID VARCHAR(500)      "
        strSql += vbCrLf + "  ,@CASHNAME VARCHAR(5000)      "
        strSql += vbCrLf + "  ,@CASHOPENING VARCHAR(1)    "
        strSql += vbCrLf + "  ,@AR_OTHERCOSTCENTRE VARCHAR(1)    "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  AS     "
        strSql += vbCrLf + "  BEGIN   "
        strSql += vbCrLf + "  	SET NOCOUNT ON      "
        strSql += vbCrLf + "  	DECLARE @CASHFORMAT VARCHAR(20) SET @CASHFORMAT=''"
        strSql += vbCrLf + "  	SELECT @CASHFORMAT = CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CASH_REC_PAY'"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE     "
        strSql += vbCrLf + "  	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))   "
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE) > 0   "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		DECLARE @TEMPNAME VARCHAR(20)     "
        strSql += vbCrLf + "  		IF CHARINDEX(',',@COSTNAME)=0     "
        strSql += vbCrLf + "  		INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME     "
        strSql += vbCrLf + "  		WHILE CHARINDEX(',',@COSTNAME)>0     "
        strSql += vbCrLf + "  	BEGIN     "
        strSql += vbCrLf + "  		SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)     "
        strSql += vbCrLf + "  		SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))     "
        strSql += vbCrLf + "  		IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0     "
        strSql += vbCrLf + "  		SET @COSTNAME= @COSTNAME + ','     "
        strSql += vbCrLf + "  		INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME     "
        strSql += vbCrLf + "  	END     "
        strSql += vbCrLf + "  	END   "
        strSql += vbCrLf + "  	ELSE   "
        strSql += vbCrLf + "  		INSERT INTO #COSTCENTRE (COSTID) SELECT ''   "
        strSql += vbCrLf + "  		IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY   "
        strSql += vbCrLf + "  		CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))   "
        strSql += vbCrLf + "  		DECLARE @TCOMPANY VARCHAR(3)   "
        strSql += vbCrLf + "  		IF CHARINDEX(',',@COMPANYID)=0   "
        strSql += vbCrLf + "  		INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID   "
        strSql += vbCrLf + "  		WHILE CHARINDEX(',',@COMPANYID)>0   "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)   "
        strSql += vbCrLf + "  		SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))   "
        strSql += vbCrLf + "  		IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0   "
        strSql += vbCrLf + "  		SET @COMPANYID= @COMPANYID + ','   "
        strSql += vbCrLf + "  		INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY   "
        strSql += vbCrLf + "  	END    "
        strSql += vbCrLf + "  		IF OBJECT_ID('TEMPDB..#CASHCOUNTER', 'U') IS NOT NULL DROP TABLE #CASHCOUNTER   "
        strSql += vbCrLf + "  		CREATE TABLE #CASHCOUNTER (CASHID VARCHAR(5))   "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) WHERE @CASHNAME LIKE '%ALL%')>0 "
        strSql += vbCrLf + "  		INSERT INTO #CASHCOUNTER (CASHID) SELECT CASHID FROM " & cnAdminDb & "..CASHCOUNTER UNION ALL SELECT '' "
        strSql += vbCrLf + "  	ELSE "
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  		DECLARE @TCASHNAME VARCHAR(20)   "
        strSql += vbCrLf + "  		IF CHARINDEX(',',@CASHNAME)=0   "
        strSql += vbCrLf + "  		INSERT INTO #CASHCOUNTER (CASHID) SELECT CASHID FROM " & cnAdminDb & "..CASHCOUNTER WHERE CASHNAME = @CASHNAME   "
        strSql += vbCrLf + "  		WHILE CHARINDEX(',',@CASHNAME)>0   "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		SET @TCASHNAME=LEFT(@CASHNAME,CHARINDEX(',',@CASHNAME)-1)   "
        strSql += vbCrLf + "  		SET @CASHNAME=RIGHT(@CASHNAME,LEN(@CASHNAME)-CHARINDEX(',',@CASHNAME))   "
        strSql += vbCrLf + "  		IF @CASHNAME <>'' AND CHARINDEX(',',@CASHNAME)=0   "
        strSql += vbCrLf + "  		SET @CASHNAME= @CASHNAME + ','   "
        strSql += vbCrLf + "  		INSERT INTO #CASHCOUNTER (CASHID) SELECT CASHID FROM " & cnAdminDb & "..CASHCOUNTER WHERE CASHNAME = @TCASHNAME   "
        strSql += vbCrLf + "  	END    "
        strSql += vbCrLf + "  	END "
        strSql += vbCrLf + "  		IF OBJECT_ID('TEMPDB..#SYSTEM', 'U') IS NOT NULL DROP TABLE #SYSTEM   "
        strSql += vbCrLf + "  		CREATE TABLE #SYSTEM (SYSTEMID VARCHAR(3))   "
        strSql += vbCrLf + "  		DECLARE @TSYSTEMID VARCHAR(3)   "
        strSql += vbCrLf + "  		IF CHARINDEX(',',@SYSTEMID)=0   "
        strSql += vbCrLf + "  		INSERT INTO #SYSTEM (SYSTEMID) SELECT @SYSTEMID   "
        strSql += vbCrLf + "  		WHILE CHARINDEX(',',@SYSTEMID)>0   "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		SET @TSYSTEMID=LEFT(@SYSTEMID,CHARINDEX(',',@SYSTEMID)-1)   "
        strSql += vbCrLf + "  		SET @SYSTEMID=RIGHT(@SYSTEMID,LEN(@SYSTEMID)-CHARINDEX(',',@SYSTEMID))   "
        strSql += vbCrLf + "  		IF @SYSTEMID <>'' AND CHARINDEX(',',@SYSTEMID)=0   "
        strSql += vbCrLf + "  		SET @SYSTEMID= @SYSTEMID + ','   "
        strSql += vbCrLf + "  		INSERT INTO #SYSTEM (SYSTEMID) SELECT @TSYSTEMID   "
        strSql += vbCrLf + "  	END    "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPSALES','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPSALES      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPTRANSUMMARY','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPTRANSUMMARY      "
        strSql += vbCrLf + "  	CREATE TABLE TEMPTABLEDB..TEMPTRANSUMMARY   "
        strSql += vbCrLf + "  	(      "
        strSql += vbCrLf + "  	PARTICULAR VARCHAR(350)      "
        strSql += vbCrLf + "  	,PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),DIAWT NUMERIC(15,3),AMOUNT NUMERIC(15,2)"
        strSql += vbCrLf + "  	,CGST NUMERIC(15,2),SGST NUMERIC(15,2),IGST NUMERIC(15,2)"
        strSql += vbCrLf + "  	,ED NUMERIC(15,2),TAX NUMERIC(15,2),TCS NUMERIC(15,2),TOTAL NUMERIC(15,2),COLHEAD VARCHAR(3),SYM VARCHAR(1),KEYNO INT IDENTITY(0,1)      "
        strSql += vbCrLf + "  	)      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPDB..#ACCTRAN') IS NOT NULL DROP TABLE #ACCTRAN   "
        strSql += vbCrLf + "  	SELECT * INTO #ACCTRAN FROM ACCTRAN WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "  	AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)             "
        strSql += vbCrLf + "  	AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER) "
        strSql += vbCrLf + "  	AND ISNULL(CANCEL,'') = ''         "
        strSql += vbCrLf + "  	AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + "  	AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)   "
        strSql += vbCrLf + "  	AND FROMFLAG NOT IN ('','S','O','A')   "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPDB..#OUTSTANDING') IS NOT NULL DROP TABLE #OUTSTANDING "
        strSql += vbCrLf + "  	SELECT * INTO #OUTSTANDING FROM " & cnAdminDb & "..OUTSTANDING "
        strSql += vbCrLf + "  	WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)             "
        strSql += vbCrLf + "  	AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)             "
        strSql += vbCrLf + "  	/*AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)*/ "
        strSql += vbCrLf + "  	AND ISNULL(CANCEL,'') = ''         "
        strSql += vbCrLf + "  	AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)             "
        strSql += vbCrLf + "  	/*AND ISNULL(SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)*/   "
        strSql += vbCrLf + "  	AND FROMFLAG NOT IN ('','S','O','A')     "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPDB..#OPENTRAILBALANCE') IS NOT NULL DROP TABLE OPENTRAILBALANCE   "
        strSql += vbCrLf + "  	SELECT DEBIT-CREDIT AMOUNT INTO #OPENTRAILBALANCE FROM OPENTRAILBALANCE   "
        strSql += vbCrLf + "  	WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)             "
        strSql += vbCrLf + "  	AND ISNULL(ACCODE,'') IN ((SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CASH'))    "
        strSql += vbCrLf + "  	AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)        "
        strSql += vbCrLf + "  	/** INSERTING SALES **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPSALES','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPSALES      "
        strSql += vbCrLf + "  	SELECT /*C.CATNAME*/"
        strSql += vbCrLf + "  	CASE WHEN (SELECT 1 FROM ISSUE WHERE BATCHNO=I.BATCHNO AND SNO=I.SNO AND REMARK1 ='SECOND HAND SALES ') = 1 THEN 'SECOND SALES' ELSE C.CATNAME END CATNAME"
        strSql += vbCrLf + "  	,SUM(ISNULL(I.PCS,0))PCS,SUM(ISNULL(I.GRSWT,0))GRSWT,SUM(I.NETWT)NETWT"
        strSql += vbCrLf + "  	,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')))DIAWT   "
        strSql += vbCrLf + "  	,SUM(I.AMOUNT)AMOUNT  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND TAXID='ED')ED  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='CG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SA')AS CGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='SG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SA')AS SGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='IG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SA')AS IGST  "
        strSql += vbCrLf + "  	,SUM(I.TAX)TAX  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(AMOUNT),0) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND ACCODE='TCS') AS TCS"
        strSql += vbCrLf + "  	,CONVERT(NUMERIC(15,2),SUM(ISNULL(I.AMOUNT,0)+ISNULL(I.TAX,0))+ (SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND TAXID='ED')"
        strSql += vbCrLf + "  	+ (SELECT ISNULL(SUM(AMOUNT),0) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND ACCODE='TCS') ) AS TOTAL      "
        strSql += vbCrLf + "  	,CASE WHEN O.TRANTYPE = 'D' THEN 'CREDIT SALES' WHEN I.TRANTYPE = 'RD' THEN 'REPAIR DELIVERY' WHEN I.TRANTYPE = 'OD' THEN 'ORDER DELIVERY' ELSE 'SALES' END TRANTYPE"
        strSql += vbCrLf + "  	,3 RESULT,1 SEP,I.BATCHNO,ROW_NUMBER() OVER (PARTITION BY I.BATCHNO ORDER BY I.BATCHNO)UPDSNO "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPSALES      "
        strSql += vbCrLf + "  	FROM ISSUE AS I      "
        strSql += vbCrLf + "  	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = I.CATCODE "
        strSql += vbCrLf + "  	LEFT OUTER JOIN #OUTSTANDING AS O ON O.BATCHNO = I.BATCHNO AND O.TRANTYPE = 'D' AND RECPAY = 'P'  "
        strSql += vbCrLf + "  	WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE IN ('SA','OD','RD')      "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)   "
        strSql += vbCrLf + "  	AND ISNULL(I.SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)   "
        strSql += vbCrLf + "  	AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CANCEL,'') = ''   "
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,I.TRANTYPE,O.TRANTYPE,I.BATCHNO ,I.SNO      "
        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMPSALES SET TRANTYPE = 'REPAIR DELIVERY' "
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMPSALES AS S," & cnAdminDb & "..ORMAST AS OM WHERE S.BATCHNO = OM.ODBATCHNO AND SUBSTRING(OM.ORNO,6,1) = 'R'  AND S.TRANTYPE <> 'SALES'  "
        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMPSALES SET TRANTYPE = 'ORDER DELIVERY' "
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMPSALES AS S," & cnAdminDb & "..ORMAST AS OM WHERE S.BATCHNO = OM.ODBATCHNO AND SUBSTRING(OM.ORNO,6,1) = 'O'  /** AND S.TRANTYPE <> 'SALES' **/     "

        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMPSALES SET TOTAL = ISNULL(TOTAL,0)-ISNULL(TCS,0) WHERE UPDSNO <> 1 "
        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMPSALES SET TCS = 0 WHERE UPDSNO <> 1 "

        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPSALES)>0      "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'RPT_TDET_TRANGROUP' AND CTLTEXT = 'Y')>0"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TCS,TOTAL,COLHEAD,SYM)"
        strSql += vbCrLf + "  			SELECT PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TCS,TOTAL,COLHEAD,SYM"
        strSql += vbCrLf + "  			FROM"
        strSql += vbCrLf + "  			("
        strSql += vbCrLf + "  			SELECT 'SALES' PARTICULAR,NULL PCS,NULL GRSWT,NULL NETWT,NULL DIAWT,NULL AMOUNT,NULL CGST,NULL SGST ,NULL IGST,NULL ED,NULL TAX,NULL TCS,NULL TOTAL,'T' COLHEAD,' ' SYM,1 RESULT,1 SEP,CONVERT(VARCHAR,'') CATNAME"
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT DISTINCT ' ' + CATNAME PARTICULAR,NULL PCS,NULL GRSWT,NULL NETWT,NULL DIAWT,NULL AMOUNT,NULL CGST,NULL SGST,NULL IGST,NULL ED,NULL TAX,NULL TCS,NULL TOTAL,'S' COLHEAD,' ' SYM,2 RESULT,2 SEP,CATNAME FROM TEMPTABLEDB..TEMPSALES"
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT '  ' + TRANTYPE PARTICULAR,SUM(PCS) PCS,SUM(GRSWT) GRSWT,SUM(NETWT) NETWT,SUM(DIAWT) DIAWT,SUM(AMOUNT) AMOUNT"
        strSql += vbCrLf + "  			,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  			,SUM(ED) ED,SUM(TAX) TAX,SUM(TCS) TCS,SUM(TOTAL) TOTAL"
        strSql += vbCrLf + "  			,'' COLHEAD,'+' SYM,3 RESULT,2 SEP,CATNAME"
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPSALES GROUP BY TRANTYPE,CATNAME"
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT ' ' + CATNAME + ' TOT' PARTICULAR,SUM(PCS) PCS,SUM(GRSWT) GRSWT,SUM(NETWT) NETWT,SUM(DIAWT) DIAWT,SUM(AMOUNT) AMOUNT"
        strSql += vbCrLf + "  			,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  			,SUM(ED) ED,SUM(TAX) TAX,SUM(TCS) TCS,SUM(TOTAL) TOTAL"
        strSql += vbCrLf + "  			,'S' COLHEAD,'' SYM,4 RESULT,2 SEP,CATNAME FROM TEMPTABLEDB..TEMPSALES GROUP BY CATNAME"
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT 'SALES[SA]' AS PARTICULAR,SUM(PCS) PCS,SUM(GRSWT) GRSWT,SUM(NETWT) NETWT,SUM(DIAWT) DIAWT,SUM(AMOUNT) AMOUNT"
        strSql += vbCrLf + "  			,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  			,SUM(ED) ED,SUM(TAX) TAX,SUM(TCS) TCS,SUM(TOTAL) TOTAL"
        strSql += vbCrLf + "  			,'G' COLHEAD,'' SYM,5 RESULT,3 SEP,NULL CATNAME FROM TEMPTABLEDB..TEMPSALES"
        strSql += vbCrLf + "  			)X ORDER BY SEP,CATNAME,RESULT   "
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'SALES','T'   "
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TCS,TOTAL,SYM)      "
        strSql += vbCrLf + "  			SELECT CATNAME,SUM(PCS) PCS, SUM(GRSWT) GRSWT,SUM(NETWT) NETWT,SUM(DIAWT) DIAWT,SUM(AMOUNT) AMOUNT"
        strSql += vbCrLf + "  			,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  			,SUM(ED),SUM(TAX) TAX,SUM(TCS) TCS,SUM(TOTAL) TOTAL,'+' SYM "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPSALES GROUP BY CATNAME ORDER BY CATNAME      "
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TCS,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  			SELECT 'SALES [SA]' AS CATNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT) DIAWT,SUM(AMOUNT)"
        strSql += vbCrLf + "  			,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  			,SUM(ED),SUM(TAX),SUM(TCS) TCS,SUM(TOTAL),'S' "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPSALES      "
        strSql += vbCrLf + "  		END    "
        strSql += vbCrLf + "  	END      "
        strSql += vbCrLf + "  	/** INSERTING RETURN **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPRETURN','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPRETURN      "
        strSql += vbCrLf + "  	SELECT C.CATNAME,SUM(I.PCS)PCS,SUM(I.GRSWT)GRSWT,SUM(I.NETWT)NETWT"
        strSql += vbCrLf + "  	,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM RECEIPTSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')))DIAWT  "
        strSql += vbCrLf + "  	,SUM(I.AMOUNT)AMOUNT"
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='CG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SR')AS CGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='SG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SR')AS SGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='IG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='SR')AS IGST  "
        strSql += vbCrLf + "  	,SUM(I.TAX)TAX,CONVERT(NUMERIC(15,2),SUM(ISNULL(I.AMOUNT,0)+ISNULL(I.TAX,0))) AS TOTAL      "
        strSql += vbCrLf + "  	,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1)RESULT      "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPRETURN      "
        strSql += vbCrLf + "  	FROM RECEIPT AS I      "
        strSql += vbCrLf + "  	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = I.CATCODE      "
        strSql += vbCrLf + "  	WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE IN ('SR')      "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)   "
        strSql += vbCrLf + "  	AND ISNULL(I.SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)   "
        strSql += vbCrLf + "  	AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CANCEL,'') = ''   "
        strSql += vbCrLf + "  	GROUP BY C.CATNAME ,BATCHNO,SNO     "
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPRETURN)>0      "
        strSql += vbCrLf + "  	BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'SALES RETURN','T'      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,SYM)      "
        strSql += vbCrLf + "  		SELECT CATNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT),SUM(CGST),SUM(SGST),SUM(IGST),SUM(TAX),SUM(TOTAL),'-' SYM "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMPRETURN "
        strSql += vbCrLf + "  		GROUP BY CATNAME      "
        strSql += vbCrLf + "  		ORDER BY CATNAME      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT 'SALES RETURN [SR]' AS CATNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT)"
        strSql += vbCrLf + "  		,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  		,SUM(TAX),SUM(TOTAL),'S' FROM TEMPTABLEDB..TEMPRETURN      "
        strSql += vbCrLf + "  	END      "
        strSql += vbCrLf + "  	/** INSERTING PURCHASE **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPPURCHASE','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPURCHASE      "
        strSql += vbCrLf + "  	SELECT C.CATNAME,SUM(I.PCS)PCS,SUM(I.GRSWT)GRSWT,SUM(I.NETWT)NETWT "
        strSql += vbCrLf + "  	,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM RECEIPTSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')))DIAWT  "
        strSql += vbCrLf + "  	,SUM(I.AMOUNT)AMOUNT"
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='CG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='PU')AS CGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='SG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='PU')AS SGST  "
        strSql += vbCrLf + "  	,(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID='IG' AND ISNULL(STUDDED,'N')<>'Y' AND TRANTYPE='PU')AS IGST  "
        strSql += vbCrLf + "  	,SUM(I.TAX)TAX,CONVERT(NUMERIC(15,2),SUM(ISNULL(I.AMOUNT,0)-ISNULL(I.TAX,0))) AS TOTAL      "
        strSql += vbCrLf + "  	,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1)RESULT      "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPPURCHASE      "
        strSql += vbCrLf + "  	FROM RECEIPT AS I      "
        strSql += vbCrLf + "  	INNER JOIN " & cnAdminDb & "..CATEGORY AS C ON C.CATCODE = I.CATCODE      "
        strSql += vbCrLf + "  	WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE IN ('PU')      "
        strSql += vbCrLf + "  	AND ISNULL(I.COMPANYID,'') IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)   "
        strSql += vbCrLf + "  	AND ISNULL(I.SYSTEMID,'') IN (SELECT SYSTEMID FROM #SYSTEM)   "
        strSql += vbCrLf + "  	AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + "  	AND ISNULL(I.CANCEL,'') = ''   "
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,BATCHNO,SNO      "
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPPURCHASE)>0      "
        strSql += vbCrLf + "  	BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'PURCHASE','T'      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,SYM)      "
        strSql += vbCrLf + "  		SELECT CATNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT),SUM(CGST),SUM(SGST),SUM(IGST),SUM(TAX),SUM(TOTAL),'-' SYM "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMPPURCHASE "
        strSql += vbCrLf + "  		GROUP BY CATNAME      "
        strSql += vbCrLf + "  		ORDER BY CATNAME      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT 'PURCHASE [PU]' AS CATNAME,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT)"
        strSql += vbCrLf + "  		,SUM(CGST)CGST,SUM(SGST)SGST,SUM(IGST)IGST"
        strSql += vbCrLf + "  		,SUM(TAX),SUM(TOTAL),'S' FROM TEMPTABLEDB..TEMPPURCHASE      "
        strSql += vbCrLf + "  	END      "
        strSql += vbCrLf + "  	/** INSERTING RECEIPT **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPREC_TBL','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPREC_TBL      "
        strSql += vbCrLf + "  	SELECT CASE WHEN O.PAYMODE IN ('DR','DU') THEN 'DR'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'MR' THEN 'MR'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'OR' AND SUBSTRING(RUNNO,6,1) <> 'R' THEN 'OR'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'OR' AND SUBSTRING(RUNNO,6,1) = 'R' THEN 'RE'      "
        strSql += vbCrLf + "  	ELSE 'AR' END AS PAYMODE     "
        strSql += vbCrLf + "  	,AMOUNT,(CASE WHEN ISNULL(COSTID,'')<>'' AND O.PAYMODE = 'AR' THEN (CASE WHEN SUBSTRING(RUNNO,1,2)=ISNULL(COSTID,'') THEN 'RECEIPT' ELSE 'RECEIVED' END) ELSE '' END)TRANTYPE"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='C' AND ACCODE='IGST')AS IGST"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='C' AND ACCODE='CGST')AS CGST"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='C' AND ACCODE='SGST')AS SGST"
        strSql += vbCrLf + "  	,GSTVAL AS TAX"
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPREC_TBL      "
        strSql += vbCrLf + "  	FROM #OUTSTANDING AS O WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND RECPAY = 'R'      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPRECEIPT','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPRECEIPT      "
        strSql += vbCrLf + "  	SELECT CATNAME,AMOUNT,IGST,CGST,SGST,TAX,CONVERT(INT,0)RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD      "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPRECEIPT      "
        strSql += vbCrLf + "  	FROM      "
        strSql += vbCrLf + "  	(      "
        strSql += vbCrLf + "  	SELECT 'CREDIT RECEIPT' AS CATNAME,SUM(AMOUNT)AMOUNT,SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'DR' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'MISCELLANEOUS RECEIPT' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX) FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'MR' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'ORDER RECEIPT' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX) FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'OR' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'REPAIR RECEIPT' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX) FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'RE' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'ADVANCE RECEIPT' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX) FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'AR' AND ISNULL(TRANTYPE,'')<>'RECEIVED' UNION ALL"
        strSql += vbCrLf + "  	SELECT 'ADVANCE RECEIVED FROM OTHER COSTCENTRE' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX) FROM TEMPTABLEDB..TEMPREC_TBL WHERE PAYMODE = 'AR' AND ISNULL(TRANTYPE,'')='RECEIVED'"
        strSql += vbCrLf + "  	)X      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'RECEIPT','T'      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,IGST,CGST,SGST,TAX,SYM)      "
        strSql += vbCrLf + "  	SELECT CATNAME,AMOUNT,AMOUNT+ISNULL(TAX,0),IGST,CGST,SGST,TAX,'+' FROM TEMPTABLEDB..TEMPRECEIPT ORDER BY CATNAME      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,IGST,CGST,SGST,TAX,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  	SELECT 'RECEIPT [REC]' AS CATNAME,SUM(AMOUNT),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX),SUM(AMOUNT)+ISNULL(SUM(TAX),0),'S' "
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMPRECEIPT      "
        strSql += vbCrLf + "  	/** INSERTING PAYMENT **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPPAY','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPAY      "
        strSql += vbCrLf + "  	SELECT CASE WHEN O.PAYMODE IN ('DP','DU') THEN 'DP'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'MP' THEN 'MP'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'GV' THEN 'GV'      "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'AP' AND SUBSTRING(O.RUNNO,6,1) = 'O' THEN 'OP'   "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'AP' AND SUBSTRING(O.RUNNO,6,1) = 'R' THEN 'RP'    "
        strSql += vbCrLf + "  	WHEN O.PAYMODE = 'AP' AND SUBSTRING(O.RUNNO,6,1) NOT IN ('O','R') THEN 'AP'   "
        strSql += vbCrLf + "  	ELSE 'AA' END AS PAYMODE      "
        strSql += vbCrLf + "  	,AMOUNT ,ACCODE"
        strSql += vbCrLf + "  	,(CASE WHEN ISNULL(COSTID,'')<>'' AND O.PAYMODE = 'AP' THEN (CASE WHEN O.BATCHNO IN ((SELECT BATCHNO FROM ACCTRAN WHERE ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..COSTCENTRE))) THEN 'PAID' ELSE 'REPAY' END) ELSE '' END)TRANTYPE"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='D' AND ACCODE='IGST')AS IGST"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='D' AND ACCODE='CGST')AS CGST"
        strSql += vbCrLf + "  	,(SELECT SUM(AMOUNT) FROM #ACCTRAN WHERE BATCHNO=O.BATCHNO AND TRANMODE='D' AND ACCODE='SGST')AS SGST"
        strSql += vbCrLf + "  	,GSTVAL AS TAX"
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPPAY      "
        strSql += vbCrLf + "  	FROM #OUTSTANDING AS O WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND RECPAY = 'P'      "
        strSql += vbCrLf + "  	UNION ALL"
        strSql += vbCrLf + "  	SELECT PAYMODE,SUM(CASE WHEN PAYMODE = 'HP' THEN AMOUNT ELSE AMOUNT * -1 END)AS AMOUNT"
        strSql += vbCrLf + "  	,NULL ACCODE,NULL AS TRANTYPE,NULL AS IGST,NULL AS CGST,NULL AS SGST,NULL AS TAX"
        strSql += vbCrLf + "  	FROM ACCTRAN T WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  	AND ISNULL(CANCEL,'')=''"
        strSql += vbCrLf + "  	AND PAYMODE IN ('HP','HD') "
        strSql += vbCrLf + "  	AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)  "
        strSql += vbCrLf + "  	AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)"
        strSql += vbCrLf + "  	GROUP BY PAYMODE"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPDETAIL','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPDETAIL      "
        strSql += vbCrLf + "  	SELECT AC.ACNAME,AMOUNT,PAYMODE,O.ACCODE, '' AS COLHEAD, '2' AS RESULT "
        strSql += vbCrLf + "  	INTO  TEMPTABLEDB..TEMPDETAIL "
        strSql += vbCrLf + "  	FROM " & cnAdminDb & "..OUTSTANDING AS O  "
        strSql += vbCrLf + "  	INNER JOIN " & cnAdminDb & "..ACHEAD AS AC ON AC.ACCODE = O.ACCODE  "
        strSql += vbCrLf + "  	WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND PAYMODE = 'MP' AND O.ACCODE IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACTYPE = 'B' ) AND ISNULL(CANCEL,'')=''   "
        strSql += vbCrLf + "  	AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)  "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'BANK DETAILS','T'      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,SYM)      "
        strSql += vbCrLf + "  	SELECT ACNAME,AMOUNT,AMOUNT,'+' FROM TEMPTABLEDB..TEMPDETAIL ORDER BY ACNAME      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  	SELECT 'TOTAL' AS CATNAME,SUM(AMOUNT),SUM(AMOUNT),'S' FROM  TEMPTABLEDB..TEMPDETAIL  "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPPAYMENT','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPAYMENT      "
        strSql += vbCrLf + "  	SELECT CATNAME,AMOUNT,IGST,CGST,SGST,TAX,CONVERT(INT,0)RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD      "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPPAYMENT      "
        strSql += vbCrLf + "  	FROM      "
        strSql += vbCrLf + "  	(      "
        strSql += vbCrLf + "  	SELECT 'CREDIT BILLS' AS CATNAME,SUM(AMOUNT)AMOUNT,SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'DP' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'MISCELLANEOUS PAYMENT' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'MP' AND ACCODE NOT IN (SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACTYPE = 'B') UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'ORDER REPAY' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'OP' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'REPAIR REPAY' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'RP' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'ADVANCE REPAY' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'AP' AND ISNULL(TRANTYPE,'')<>'PAID' UNION ALL"
        strSql += vbCrLf + "  	SELECT 'ADVANCE TRANSFERED TO OTHER COSTCENTRE' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'AP' AND ISNULL(TRANTYPE,'')='PAID' UNION ALL"
        strSql += vbCrLf + "  	SELECT 'ADVANCE ADJUSTED' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE = 'AA' UNION ALL"
        strSql += vbCrLf + "  	SELECT 'SCHEME REPAY' AS CATNAME,SUM(AMOUNT),SUM(IGST)IGST,SUM(CGST)CGST,SUM(SGST)SGST,SUM(TAX)TAX FROM TEMPTABLEDB..TEMPPAY WHERE PAYMODE IN('HD','HP') "
        strSql += vbCrLf + "  	)X      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'PAYMENT','T'      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,IGST,CGST,SGST,TAX,SYM)      "
        strSql += vbCrLf + "  	SELECT CATNAME,AMOUNT,AMOUNT,IGST,CGST,SGST,TAX,'-' FROM TEMPTABLEDB..TEMPPAYMENT ORDER BY CATNAME      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,IGST,CGST,SGST,TAX,COLHEAD)      "
        strSql += vbCrLf + "  	SELECT 'PAYMENT [PAY]' AS CATNAME,SUM(AMOUNT),SUM(AMOUNT)+ISNULL(SUM(TAX),0),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX),'S' FROM TEMPTABLEDB..TEMPPAYMENT      "
        strSql += vbCrLf + "  	/** INSERTING OTHERS **/      "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPOTHERS','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPOTHERS      "
        strSql += vbCrLf + "  	SELECT PAYMODE,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT      "
        strSql += vbCrLf + "  	INTO TEMPTABLEDB..TEMPOTHERS      "
        strSql += vbCrLf + "  	FROM #ACCTRAN AS T WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND PAYMODE IN ('DI','RO','HC')      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'OTHERS','T'      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD,SYM)      "
        strSql += vbCrLf + "  	SELECT 'DISCOUNT [DI]',SUM(AMOUNT),SUM(AMOUNT),'S','-' FROM TEMPTABLEDB..TEMPOTHERS WHERE PAYMODE = 'DI' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'ROUND OFF [RO]',SUM(AMOUNT),SUM(AMOUNT),'S','-' FROM TEMPTABLEDB..TEMPOTHERS WHERE PAYMODE = 'RO' UNION ALL      "
        strSql += vbCrLf + "  	SELECT 'HANDLING CHARGES [HC]',-1*SUM(AMOUNT),-1*SUM(AMOUNT),'S','+' FROM TEMPTABLEDB..TEMPOTHERS WHERE PAYMODE = 'HC'      "
        strSql += vbCrLf + "  	IF @CASHOPENING = 'Y' "
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD,SYM) "
        strSql += vbCrLf + "  		SELECT 'CASH OPENING ',SUM(AMOUNT),SUM(AMOUNT),'S','+'    "
        strSql += vbCrLf + "  		FROM     "
        strSql += vbCrLf + "  		("
        strSql += vbCrLf + "  		SELECT DEBIT-CREDIT AS AMOUNT FROM OPENTRAILBALANCE"
        strSql += vbCrLf + "  		WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)               "
        strSql += vbCrLf + "  		AND ISNULL(ACCODE,'') IN ((SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CASH'))      "
        strSql += vbCrLf + "  		AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)     "
        strSql += vbCrLf + "  		UNION ALL"
        strSql += vbCrLf + "  		SELECT case when tranmode = 'd' then amount else -1*AMOUNT end as amont FROM ACCTRAN    "
        strSql += vbCrLf + "  		WHERE COMPANYID IN (SELECT COMPANYID FROM #COMPANY)   "
        strSql += vbCrLf + "  		AND ISNULL(CANCEL,'') = ''    "
        strSql += vbCrLf + "  		AND ISNULL(CASHID,'') IN (SELECT CASHID FROM #CASHCOUNTER)               "
        strSql += vbCrLf + "  		AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + "  		AND ISNULL(ACCODE,'') IN ((SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CASH'))"
        strSql += vbCrLf + "  		AND TRANDATE < @FROMDATE "
        strSql += vbCrLf + "  		) X  "
        strSql += vbCrLf + "  	END   "
        strSql += vbCrLf + "  	/** INSERTING TOTAL **/      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD)      "
        strSql += vbCrLf + "  	SELECT 'TOTAL' AS CATNAME,'T'      "
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TCS,TOTAL)      "
        strSql += vbCrLf + "  	SELECT"
        strSql += vbCrLf + "  	'SA-SR+REC-PAY-PU-DI-RO+HC+CA' PARTICULAR,'G'COLHEAD      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN PCS ELSE -1*PCS END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN GRSWT ELSE -1*GRSWT END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN NETWT ELSE -1*NETWT END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN DIAWT ELSE -1*DIAWT END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN AMOUNT ELSE -1*AMOUNT END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN CGST ELSE -1*CGST END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN SGST ELSE -1*SGST END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN IGST ELSE -1*IGST END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN TAX ELSE -1*TAX END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN TCS ELSE -1*TCS END)      "
        strSql += vbCrLf + "  	,SUM(CASE WHEN SYM = '+' THEN TOTAL ELSE -1*TOTAL END)      "
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMPTRANSUMMARY WHERE ISNULL(SYM,'') IN ('-','+')      "
        strSql += vbCrLf + "  	IF @CASHFORMAT ='N' BEGIN "
        strSql += vbCrLf + "  		/** PAY COLLECTION **/      "
        strSql += vbCrLf + "  		IF OBJECT_ID('TEMPTABLEDB..TEMPCOLL','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOLL      "
        strSql += vbCrLf + "  		SELECT    "
        strSql += vbCrLf + "  		PAYMODE,TRANMODE  "
        strSql += vbCrLf + "  		,AMOUNT,CHQCARDREF   "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMPCOLL      "
        strSql += vbCrLf + "  		FROM #ACCTRAN AS T   "
        strSql += vbCrLf + "  		WHERE T.TRANDATE BETWEEN @FROMDATE AND @TODATE AND T.PAYMODE IN ('CA','CC','CH','SS','CB','CZ','CG','CD','GV','CT')  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'PAY COLLECTION','T'      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT 'CASH [CREC]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CA' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CASH [CPAY]',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CA' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CREDIT CARD [CC]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CC' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HREC]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' AND CHQCARDREF NOT LIKE '%ONLINE%' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HREC-ONLINE]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' AND CHQCARDREF LIKE '%ONLINE%' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HPAY]',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'GIFT VOUCHER [GV]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'GV' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'SAVINGS SCHEME [SS]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE IN ('SS','CB','CZ','CG','CD') UNION ALL "
        strSql += vbCrLf + "  		SELECT 'SAVINGS COLLECTION [SC]',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE IN ('CT') "
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	IF @CASHFORMAT <>'N' BEGIN "
        strSql += vbCrLf + "  		/** PAY COLLECTION **/      "
        strSql += vbCrLf + "  		IF OBJECT_ID('TEMPTABLEDB..TEMPCOLL','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOLL      "
        strSql += vbCrLf + "  		SELECT    "
        strSql += vbCrLf + "  		PAYMODE,TRANMODE  "
        strSql += vbCrLf + "  		,AMOUNT,CHQCARDREF   "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMPCOLL      "
        strSql += vbCrLf + "  		FROM #ACCTRAN AS T   "
        strSql += vbCrLf + "  		WHERE T.TRANDATE BETWEEN @FROMDATE AND @TODATE AND T.PAYMODE IN ('CA','CC','CH','SS','CB','CZ','CG','CD','GV','CT')  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,COLHEAD) SELECT 'PAY COLLECTION','T'      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT 'CASH [ R-P ] ( ' + CONVERT(VARCHAR(50),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END)) +' - ' + CONVERT(VARCHAR(50),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END)) "
        strSql += vbCrLf + "  		+' )' AS TEST , SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END), SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END)"
        strSql += vbCrLf + "  		,'S'  FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CA' 	UNION ALL  "
        strSql += vbCrLf + "  		SELECT 'CREDIT CARD [CC]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CC' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HREC]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' AND CHQCARDREF NOT LIKE '%ONLINE%' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HREC-ONLINE]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' AND CHQCARDREF LIKE '%ONLINE%' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'CHEQUE [HPAY]',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'CH' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'GIFT VOUCHER [GV]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE = 'GV' UNION ALL      "
        strSql += vbCrLf + "  		SELECT 'SAVINGS SCHEME [SS]',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE IN ('SS','CB','CZ','CG','CD')   UNION ALL "
        strSql += vbCrLf + "  		SELECT 'SAVINGS COLLECTION [SC]',SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),SUM(CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END),'S' FROM TEMPTABLEDB..TEMPCOLL WHERE PAYMODE IN ('CT') "
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,AMOUNT,TOTAL,COLHEAD)      "
        strSql += vbCrLf + "  	SELECT 'CREC-CPAY+GV+CC+HREC-HPAY+SS',SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END),'G' COLHEAD FROM TEMPTABLEDB..TEMPCOLL      "
        strSql += vbCrLf + "  	IF @CASHOPENING = 'Y'   "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  	    IF @CASHFORMAT ='N' BEGIN "
        strSql += vbCrLf + "  	    	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,TOTAL,COLHEAD)       "
        strSql += vbCrLf + "  	    	SELECT 'CASH CLOSING'  "
        strSql += vbCrLf + "  	    	,SUM(CASE WHEN PARTICULAR = 'CASH [CPAY]' THEN -1*TOTAL ELSE TOTAL END)TOTAL  "
        strSql += vbCrLf + "  	    	,'G'  "
        strSql += vbCrLf + "  	    	FROM TEMPTABLEDB..TEMPTRANSUMMARY  "
        strSql += vbCrLf + "  	    	WHERE PARTICULAR IN  "
        strSql += vbCrLf + "  	    	(  "
        strSql += vbCrLf + "  	    	'CASH OPENING'  "
        strSql += vbCrLf + "  	    	,'CASH [CREC]'  "
        strSql += vbCrLf + "  	    	,'CASH [CPAY]'  "
        strSql += vbCrLf + "  	    	)  "
        strSql += vbCrLf + "  	    END  "
        strSql += vbCrLf + "  	    IF @CASHFORMAT <>'N' BEGIN "
        strSql += vbCrLf + "  	    	INSERT INTO TEMPTABLEDB..TEMPTRANSUMMARY(PARTICULAR,TOTAL,COLHEAD)       "
        strSql += vbCrLf + "  	    	SELECT 'CASH CLOSING'  "
        strSql += vbCrLf + "  	    	,SUM(CASE WHEN PARTICULAR = 'CASH [CPAY]' THEN -1*TOTAL ELSE TOTAL END)TOTAL  "
        strSql += vbCrLf + "  	    	,'G'  "
        strSql += vbCrLf + "  	    	FROM TEMPTABLEDB..TEMPTRANSUMMARY  "
        strSql += vbCrLf + "  	    	WHERE PARTICULAR LIKE '%CASH%' "
        strSql += vbCrLf + "  	    END  "
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	SELECT PARTICULAR,CASE WHEN PCS <> 0 THEN PCS END PCS  "
        strSql += vbCrLf + "  	,CASE WHEN GRSWT <> 0 THEN GRSWT END GRSWT"
        strSql += vbCrLf + "  	,CASE WHEN NETWT <> 0 THEN NETWT END NETWT  "
        strSql += vbCrLf + "  	,CASE WHEN DIAWT <> 0 THEN DIAWT END DIAWT  "
        strSql += vbCrLf + "  	,CASE WHEN AMOUNT <> 0 THEN AMOUNT END AMOUNT"
        strSql += vbCrLf + "  	,CASE WHEN CGST <> 0 THEN CGST END CGST  "
        strSql += vbCrLf + "  	,CASE WHEN SGST <> 0 THEN SGST END SGST"
