        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(10) + ',COLHEAD FROM TEMPTABLEDB..TEMP_MI_FINAL ORDER BY KEYNO'"
        strSql += vbCrLf + "	PRINT (@QRY)"
        strSql += vbCrLf + "	EXEC  (@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

