        strSql += vbCrLf + "  			SELECT @QRY = @QRY +CHAR(13)+' SELECT ''TOTAL'' ,SUM(AMOUNT),SUM(ITAX),SUM(CTAX),SUM(STAX),SUM(GNETAMOUNT),SUM(IRCMTAX),SUM(CRCMTAX),SUM(SRCMTAX),SUM(RNETAMOUNT),3,''G'','''' FROM TEMPTABLEDB..TEMPGSTRPT'			"
        strSql += vbCrLf + "  			PRINT(@QRY)"
        strSql += vbCrLf + "  			EXEC(@QRY)"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
