        strSql += vbCrLf + "              EXEC(@QRY)"
        strSql += vbCrLf + "              /** INSERTING GRAND TOTAL*/    "
        strSql += vbCrLf + "              SELECT @QRY = ' INSERT INTO TEMPTABLEDB..SA_COMMISION_RES(PARTICULAR,COSTNAME,EMPNAME,EMPID,RES1,COLHEAD,SPCS,SNETWT,SAMOUNT'"
        strSql += vbCrLf + "              SELECT @QRY = @QRY + ' ,RPCS,RNETWT,RAMOUNT,PCS,NETWT,AMOUNT,INCENTIVE)'"
