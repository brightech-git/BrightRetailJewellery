    Function funcSP17_DataCheckReceiptVsTran() As Integer
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Sp_ReceiptVsAcctran')>0"
        strSql += vbCrLf + "  DROP PROCEDURE Sp_ReceiptVsAcctran"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE Sp_ReceiptVsAcctran"
        strSql += vbCrLf + "  (@FRMDATE VARCHAR(10),@TODATE VARCHAR(10),@CATCODE VARCHAR(7),@CNCOMPANYID VARCHAR(3))"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  DECLARE @ADMINDB VARCHAR(15)"
        strSql += vbCrLf + "  DECLARE @TRANDB VARCHAR(15)"
        strSql += vbCrLf + "  DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  SELECT @ADMINDB = '" & compId & "ADMINDB'"
        strSql += vbCrLf + "  SELECT @TRANDB = '" & tranDbName & "'"
        strSql += vbCrLf + "  SELECT @QRY = ''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + '/** RECEIPT VS ACCTRAN **/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + '/**TAKING SA RECORD ONLY**/ /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' IF (SELECT 1 FROM MASTER..SYSOBJECTS WHERE NAME = ''TEMP_SRPU'')>0 /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' DROP TABLE MASTER..TEMP_SRPU /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT ''IS''SEP,TRANNO,TRANDATE,PCS,GRSWT,NETWT,AMOUNT,TAX,CATCODE,BATCHNO,0 ITEMID,TRANTYPE PAYMODE /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' INTO MASTER..TEMP_SRPU FROM '+@TRANDB+'..RECEIPT /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE TRANDATE BETWEEN '''+@FRMDATE+''' AND ''' +@TODATE + ''''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND TRANTYPE IN (''SR'',''PU'') /**/'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(CANCEL,'''') = '''' /**/'"
        strSql += vbCrLf + "  IF @CATCODE <> '' BEGIN SELECT @QRY = @QRY + ' AND CATCODE = '''+@CATCODE+'''' END"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(CANCEL,'''') = '''' /**/ '"
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @QRY"

        strSql += vbCrLf + "  SELECT @QRY = ' INSERT INTO MASTER..TEMP_SRPU /**/'"
