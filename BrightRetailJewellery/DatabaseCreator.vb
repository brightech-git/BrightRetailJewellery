        strSql += vbCrLf + "   			PRINT @STR"
        strSql += vbCrLf + "    			EXEC SP_EXECUTESQL @STR 	"
        strSql += vbCrLf + "    			SELECT @STR = 'UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'COSTCENTREWISERECEIPTVIEW SET TOTGRSWT  = (SELECT ISNULL(SUM(GWT),0) FROM TEMPTABLEDB..TEMPCOSTCENTREWISERECEIPT WHERE 1 = 1 AND DEALER = T.DEALER AND ITEMNAME = T.ITEMNAME '"
        strSql += vbCrLf + "   			SELECT @STR=@STR+CHAR(13)+ ' ) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COSTCENTREWISERECEIPTVIEW AS T '"
