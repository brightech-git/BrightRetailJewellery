        strSql += vbCrLf + "      ,@PRODUCT VARCHAR(100)      "
        strSql += vbCrLf + "      ,@SUBPRODUCT VARCHAR(100)   "
        strSql += vbCrLf + "      ,@PURITY VARCHAR(25)    "
        strSql += vbCrLf + "      ,@SUPPLIER VARCHAR(100)"
