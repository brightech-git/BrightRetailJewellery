        strSql += vbCrLf + "   IF @@FETCH_STATUS = -1 BREAK       "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..DAYBOOK2(PAYHEAD,ORDERNO) SELECT @PAYHEAD,@ORDERNO      "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..DAYBOOK2(TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO)SELECT  CONVERT(VARCHAR(13),TRANDATE,103) AS TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO "
        strSql += vbCrLf + "FROM TEMPTABLEDB..DAYBOOK1 WHERE PAYHEAD=@PAYHEAD AND ORDERNO=@ORDERNO        "
        strSql += vbCrLf + "  END       "
        strSql += vbCrLf + " END       "
        strSql += vbCrLf + " CLOSE CUR      "
        strSql += vbCrLf + " DEALLOCATE CUR       "
        strSql += vbCrLf + " SELECT @QUERY= ' SELECT * FROM TEMPTABLEDB..DAYBOOK2 WHERE ORDERNO<>0 ORDER BY ORDERNO,TRANNO,JDEBIT  '      "
        strSql += vbCrLf + " PRINT @QUERY      "
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY       "
        strSql += vbCrLf + " /*EXECUTE SP_RPT_DAYBOOKWITHJOURNAL  'SENT1213','TTEMP1','10-APR-2012','10-APR-2012','Y','SEN','','N'      */  "
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSP_ItemWiseboffStock()

        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_BACKOFFSTK')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_BACKOFFSTK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE  procedure SP_RPT_BACKOFFSTK"
        strSql += vbCrLf + "    ("
        strSql += vbCrLf + "  @DBNAME VARCHAR(100) ,@TODATE VARCHAR(12),@METALID VARCHAR(100),@ITEMIDS VARCHAR(500),@COMPANYID VARCHAR(3),@COSTIDS VARCHAR(200) "
        strSql += vbCrLf + "   ) AS"
        strSql += vbCrLf + "   BEGIN "
        strSql += vbCrLf + "  declare @COSTFILTER VARCHAR(200) "
        strSql += vbCrLf + "  declare @METALFILTER VARCHAR(200) "
        strSql += vbCrLf + "  DECLARE @ITEMFILTER VARCHAR(500)"
        strSql += vbCrLf + "  SET @ITEMFILTER=''    "
        strSql += vbCrLf + "  SET @METALFILTER = ''"
        strSql += vbCrLf + "  SET @COSTFILTER = ''"
        strSql += vbCrLf + "  IF @COSTIDS <> '' SET @COSTFILTER = ' AND I.COSTID IN('''+REPLACE(@COSTIDS,',',''',''')+''')'"
        strSql += vbCrLf + "  IF @ITEMIDS <> '' SET @ITEMFILTER = ' AND I.ITEMID IN ('+@ITEMIDS+')'"
        strSql += vbCrLf + "  IF @METALID <> '' SET @METALFILTER = ' AND I.METALID IN ('''+@METALID+''')'"
        strSql += vbCrLf + "  DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  SELECT @QRY = 'SELECT X.METALID,MM.METALNAME,X.CATCODE,CC.CATNAME,X.itemid,II.ITEMNAME,SUM(X.PCS) PCS,SUM(X.GRSWT) GRSWT,SUM(X.NETWT) NETWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM  ('"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT  C.METALID,R.CATCODE,R.itemid'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ',SUM(PCS) PCS ,SUM(GRSWT)GRSWT ,SUM(NETWT)NETWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM '+@DBNAME+'..OPENWEIGHT AS R INNER JOIN CATEGORY C ON R.CATCODE = C.CATCODE'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE STOCKTYPE = ''C'''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND R.TRANTYPE <> ''WOT'''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY C.METALID,R.CATCODE,R.ITEMID'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT METALID,CATCODE,ITEMID'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,SUM(PCS) PCS ,SUM(GRSWT)*(-1)GRSWT ,SUM(NETWT)*(-1)NETWT '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM '+@DBNAME+'..ISSUE AS I '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + '  WHERE TRANDATE < '''+@TODATE+''' AND ISNULL(CANCEL,'''') <> ''Y'''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND TRANTYPE IN(''PR'',''SA'',''MI'',''IIS'',''IOT'')   '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + @COSTFILTER +' '+@METALFILTER+ ' '+@ITEMFILTER    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY METALID,CATCODE,ITEMID'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT METALID,CATCODE,ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,SUM(PCS) PCS ,SUM(GRSWT)GRSWT ,SUM(NETWT)NETWT '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM '+@DBNAME+'..RECEIPT AS I '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE TRANDATE <= '''+@TODATE+''' AND ISNULL(CANCEL,'''') <> ''Y'''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND TRANTYPE IN (''RRE'',''RPU'')'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + @COSTFILTER+@METALFILTER+@ITEMFILTER"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY METALID,CATCODE,ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL  '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT I.METALID,I.CATCODE,T.ITEMID TITEMID,SUM(T.PCS),SUM(T.GRSWT),SUM(T.NETWT) FROM ITEMNONTAG T  '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST I ON I.ITEMID = T.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE RECDATE <= '''+@TODATE+''' AND RECISS = ''I'' AND ISNULL(CANCEL,'''') <> ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + REPLACE(@COSTFILTER,'I.','T.')+@METALFILTER+@ITEMFILTER"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY I.METALID,I.CATCODE,T.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT I.METALID,I.CATCODE,T.ITEMID TITEMID,SUM(T.PCS)*(-1),SUM(T.GRSWT)*(-1),SUM(T.NETWT)*(-1) FROM ITEMNONTAG T '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST I ON I.ITEMID = T.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE RECDATE <='''+@TODATE+''' AND RECISS = ''R'' AND ISNULL(CANCEL,'''') <> ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + REPLACE(@COSTFILTER,'I.','T.')+@METALFILTER+@ITEMFILTER"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY I.METALID,I.CATCODE,T.ITEMID'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT I.METALID,I.CATCODE,T.ITEMID TITEMID,SUM(T.PCS)*(-1),SUM(T.GRSWT)*(-1),SUM(T.NETWT)*(-1) FROM ITEMTAG AS T INNER JOIN ITEMMAST AS I ON T.ITEMID=I.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE T.RECDATE <= '''+@TODATE+''' AND (ISSDATE >= '''+@TODATE+''' OR ISSDATE IS NULL)'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + REPLACE(@COSTFILTER,'I.','T.')+@METALFILTER+@ITEMFILTER"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY I.METALID,I.CATCODE,T.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' )X '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN METALMAST MM ON MM.METALID = X.METALID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN CATEGORY CC ON CC.CATCODE = X.CATCODE '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST II ON II.ITEMID = X.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY X.METALID,X.CATCODE,X.ITEMID,MM.METALNAME,CC.CATNAME,II.ITEMNAME ' "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "  END   "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP_ItemWisePendingStock()

        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PENDINGSTK')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_PENDINGSTK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE SP_RPT_PENDINGSTK"
        strSql += vbCrLf + "  (@DBNAME VARCHAR(100) ,@TODATE VARCHAR(12),@METALID VARCHAR(100),@ITEMIDS VARCHAR(500),@COMPANYID VARCHAR(3),@COSTIDS VARCHAR(200) "
        strSql += vbCrLf + "  ) AS"
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  DECLARE @COSTFILTER VARCHAR(200) "
        strSql += vbCrLf + "  DECLARE @METALFILTER VARCHAR(200) "
        strSql += vbCrLf + "  DECLARE @ITEMFILTER VARCHAR(500)"
        strSql += vbCrLf + "  SET @ITEMFILTER=''    "
        strSql += vbCrLf + "  SET @METALFILTER = ''"
        strSql += vbCrLf + "  SET @COSTFILTER = ''"
        strSql += vbCrLf + "  IF @COSTIDS <> '' AND @COSTIDS <> 'ALL' SET @COSTFILTER = ' AND T.COSTID IN('''+REPLACE(@COSTIDS,',',''',''')+''')'"
        strSql += vbCrLf + "  IF @ITEMIDS <> '' AND @ITEMIDS <> 'ALL' SET @ITEMFILTER = ' AND T.ITEMID IN ('+@ITEMIDS+')'"
        strSql += vbCrLf + "  IF @METALID <> '' AND @METALID <> 'ALL' SET @METALFILTER = ' AND I.METALID IN ('''+@METALID+''')'"
        strSql += vbCrLf + "  DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "  SELECT @QRY = 'SELECT X.METALID,MM.METALNAME,X.CATCODE,CC.CATNAME,X.ITEMID,II.ITEMNAME,SUM(X.PCS) PCS,SUM(X.GRSWT) GRSWT,SUM(X.NETWT) NETWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,SUM(X.DIAPCS) DIAPCS,SUM(X.DIAWT) DIAWT,SUM(X.STNPCS) STNPCS,SUM(X.STNCRWT) STNCRWT,SUM(X.STNGRWT) STNGRWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM  ('"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT I.METALID,I.CATCODE,T.ITEMID ITEMID,SUM(T.PCS) PCS,SUM(T.GRSWT) GRSWT,SUM(T.NETWT) NETWT '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNPCS) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAPCS'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNPCS) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNPCS'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STONEUNIT=''C'' AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNCRWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STONEUNIT=''D'' AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNGRWT'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' FROM PITEMTAG AS T INNER JOIN ITEMMAST AS I ON T.ITEMID=I.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' AND ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y''' "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE 1=1 '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + @COSTFILTER+@METALFILTER+@ITEMFILTER"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY I.METALID,I.CATCODE,T.ITEMID,T.SNO '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' )X '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN METALMAST MM ON MM.METALID = X.METALID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN CATEGORY CC ON CC.CATCODE = X.CATCODE '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST II ON II.ITEMID = X.ITEMID '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' GROUP BY X.METALID,X.CATCODE,X.ITEMID,MM.METALNAME,CC.CATNAME,II.ITEMNAME ' "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "END   "

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP_ItemWiseStock()
        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ITEMWISESTOCK')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_RPT_ITEMWISESTOCK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE [SP_RPT_ITEMWISESTOCK]    "
        strSql += vbCrLf + "        ("
        strSql += vbCrLf + "        @DBNAME VARCHAR(100)"
        strSql += vbCrLf + "        ,@FRMDATE VARCHAR(12)"
        strSql += vbCrLf + "        ,@TODATE VARCHAR(12)   "
        strSql += vbCrLf + "        ,@METALID VARCHAR(100)   "
        strSql += vbCrLf + "        ,@CATCODE VARCHAR(1000)     "
        strSql += vbCrLf + "        ,@ITEMTYPE VARCHAR(100)  "
        strSql += vbCrLf + "        ,@ITEMIDS VARCHAR(500)"
        strSql += vbCrLf + "        ,@ITEMTYPEIDS VARCHAR(500)"
        strSql += vbCrLf + "        ,@DESIGNERIDS VARCHAR(200)"
        strSql += vbCrLf + "        ,@COMPANYID VARCHAR(50) "
        strSql += vbCrLf + "        ,@COUNTERIDS VARCHAR(500)"
        strSql += vbCrLf + "        ,@COSTIDS VARCHAR(200) "
        strSql += vbCrLf + "        ,@SYSTEMID VARCHAR(10)"
        strSql += vbCrLf + "        ,@TAGTYPE VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHSUBITEM VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHTR VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHDIA VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHSTONE VARCHAR(1)"
        strSql += vbCrLf + "        ,@DIASTNBYROW VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHAPP VARCHAR(1)"
        strSql += vbCrLf + "        ,@SHORTNAME VARCHAR(1)"
        strSql += vbCrLf + "        ,@ORDERBY VARCHAR(1)"
        strSql += vbCrLf + "        ,@HIDEBACKOFF VARCHAR(1) "
        strSql += vbCrLf + "        ,@GROUPBY VARCHAR(20)"
        strSql += vbCrLf + "        ,@SEPAPP VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHCUMSTK VARCHAR(1)"
        strSql += vbCrLf + "        ,@WITHRATE VARCHAR(1)"
        strSql += vbCrLf + "        )"
        strSql += vbCrLf + "        AS  "
        strSql += vbCrLf + "        BEGIN /** PROC STARTS **/  "
        strSql += vbCrLf + "        	SET NOCOUNT ON"
        strSql += vbCrLf + "        	DECLARE @QRY VARCHAR(8000) "
        strSql += vbCrLf + "        	DECLARE @SQLQRY NVARCHAR(4000)     "
        strSql += vbCrLf + "        	DECLARE @ITEMFILTER VARCHAR(1000)"
        strSql += vbCrLf + "        	DECLARE @TAGFILTER VARCHAR(1000)"
        strSql += vbCrLf + "        	DECLARE @DESFILTER VARCHAR(1000)"
        strSql += vbCrLf + "        	DECLARE @RECDATE VARCHAR(20)"
        strSql += vbCrLf + "        	SET @RECDATE='T.RECDATE'"
        strSql += vbCrLf + "        	SET @ITEMFILTER='' /** ITEM FILTER**/ "
        strSql += vbCrLf + "        	SET @GROUPBY = REPLACE(@GROUPBY ,',',''',''')  "
        strSql += vbCrLf + "        	SET @ITEMFILTER= @ITEMFILTER +' T.ITEMID IN(SELECT ITEMID FROM ITEMMAST WHERE ISNULL(STOCKREPORT,'''')<>''N'' )'"
        strSql += vbCrLf + "        	SET @METALID = REPLACE(@METALID,',',''',''')  "
        strSql += vbCrLf + "        	IF @METALID <> '' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN(SELECT ITEMID FROM ITEMMAST WHERE METALID IN('''+@METALID+'''))'"
        strSql += vbCrLf + "        	SET @CATCODE = REPLACE(@CATCODE,',',''',''')  "
        strSql += vbCrLf + "        	IF @CATCODE <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN(SELECT ITEMID FROM ITEMMAST WHERE CATCODE IN('''+@CATCODE +'''))'"
        strSql += vbCrLf + "        	SET @ITEMTYPE = REPLACE(@ITEMTYPE,',',''',''')  "
        strSql += vbCrLf + "        	IF @ITEMTYPE<>'' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN(SELECT ITEMID FROM SUBITEMMAST WHERE CALTYPE IN('''+@ITEMTYPE+'''))'"
        strSql += vbCrLf + "        	IF @ITEMIDS <> '' SET @ITEMFILTER= @ITEMFILTER + ' AND T.ITEMID IN('+@ITEMIDS+')'"
        strSql += vbCrLf + "        	SET @DESIGNERIDS = REPLACE(@DESIGNERIDS,',',''',''')  "
        strSql += vbCrLf + "        	SET @DESFILTER='' /** DESIGNER FILTER**/ "
        strSql += vbCrLf + "        	IF @DESIGNERIDS <> '' SET @DESFILTER= @DESFILTER + 'AND T.DESIGNERID IN('''+ @DESIGNERIDS +''')'"
        strSql += vbCrLf + "        	SET @TAGFILTER='' /** TAG FILTER**/ "
        strSql += vbCrLf + "        	IF @ITEMTYPEIDS <> '' SET @TAGFILTER= @TAGFILTER + 'AND T.ITEMTYPEID IN('+ @ITEMTYPEIDS +')'"
        strSql += vbCrLf + "        	SET @COUNTERIDS = REPLACE(@COUNTERIDS,',',''',''')  "
        strSql += vbCrLf + "        	IF @COUNTERIDS <> '' SET @TAGFILTER= @TAGFILTER + 'AND T.ITEMCTRID IN('''+ @COUNTERIDS +''')'"
        strSql += vbCrLf + "        	SET @COSTIDS = REPLACE(@COSTIDS,',',''',''')  "
        strSql += vbCrLf + "        	IF @COSTIDS <> '' SET @TAGFILTER= @TAGFILTER + 'AND T.COSTID IN('''+ @COSTIDS+''')'"
        strSql += vbCrLf + "        	SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "        	IF @COMPANYID<>'' SET @TAGFILTER= @TAGFILTER + ' AND T.COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTK'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTOCK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTOCK'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER1'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER1'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTKVIEW'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTKVIEW'"
        strSql += vbCrLf + "        	SELECT @SQLQRY = @SQLQRY + ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMPENSTK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMPENSTK'"
        strSql += vbCrLf + "        	PRINT @SQLQRY"
        strSql += vbCrLf + "        	EXECUTE SP_EXECUTESQL @SQLQRY"
        strSql += vbCrLf + "        	SELECT @SQLQRY = ' CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1 (SEP VARCHAR(20),COSTID VARCHAR(10),DESIGNERID INT,ITEMCTRID INT,'"
