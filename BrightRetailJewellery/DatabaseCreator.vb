    Private Sub PROC_OTP_DISCOUNT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_OTP_DISCOUNT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_OTP_DISCOUNT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If SqlVersion <= 8 Then Exit Sub
        strSql = vbCrLf + "CREATE PROCEDURE PROC_OTP_DISCOUNT"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@FROMDATE VARCHAR(20)"
        strSql += vbCrLf + ",@TODATE VARCHAR(20)"
        strSql += vbCrLf + ",@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@COSTID VARCHAR(150)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	IF @COSTID<>'ALL' AND @COSTID<>''"
        strSql += vbCrLf + "	    SELECT @COSTID=REPLACE(@COSTID,',',''',''')"
        strSql += vbCrLf + "	SELECT @QRY='IF OBJECT_ID(''TEMPTABLEDB..TEMPOTPREPORT'',''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPOTPREPORT'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY='SELECT TRANNO,SPACE(1)+CONVERT(VARCHAR,TRANDATE,105)DATE'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT METALNAME FROM " & cnAdminDb & "..METALMAST WHERE METALID=X.METALID)METAL'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',ITEM, FIN_DISCOUNT,AMOUNT,WT,RATE,WASTPER'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',CONVERT(NUMERIC(20,2),((WASTPER*WT)/100)*RATE) AS WAST,ROUNDOFF AS RND'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',CONVERT(NUMERIC(20,2),((ROUNDOFF*WT)/100)*RATE) AS ROUNDOFF,MCPER'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',CONVERT(NUMERIC(20,2),(MCHARGE*MCPER)/100) AS MC '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',CONVERT(NUMERIC(20,2),((WASTPER*WT)/100)*RATE) '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'+CONVERT(NUMERIC(20,2),((ROUNDOFF*WT)/100)*RATE) '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'+CONVERT(NUMERIC(20,2),(MCHARGE*MCPER)/100) AS TOTALDISC '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT TOP 1 DISCLIMITAMT FROM '+@DBNAME+'..DISCHISTORY WHERE BATCHNO=X.BATCHNO)DISCLIMIT'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT TOP 1 DISCALLOWAMT FROM '+@DBNAME+'..DISCHISTORY WHERE BATCHNO=X.BATCHNO)DISCALLOW'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT SUM(AMOUNT) FROM '+@DBNAME+'..ACCTRAN WHERE BATCHNO=X.BATCHNO AND PAYMODE=''SS'')SCHEMEAMT'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',BATCHNO,''N''UPDATED,TRANDATE'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'INTO TEMPTABLEDB..TEMPOTPREPORT'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'FROM('"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'SELECT TRANNO,TRANDATE,METALID'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT ITEMNAME FROM ITEMMAST WHERE ITEMID=I.ITEMID)ITEM'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',FIN_DISCOUNT,AMOUNT,BATCHNO'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT TOP 1 WASTPER FROM VACONTROL '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'WHERE ITEMID=I.ITEMID AND SUBITEMID=I.SUBITEMID AND COSTID=I.COSTID)WASTPER'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT CTLTEXT FROM SOFTCONTROL WHERE CTLID=''EXTRADISC_VA'')ROUNDOFF'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',(SELECT TOP 1 MCPER FROM VACONTROL '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'WHERE ITEMID=I.ITEMID AND SUBITEMID=I.SUBITEMID AND COSTID=I.COSTID)MCPER'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',CASE WHEN GRSNET=''G'' THEN GRSWT ELSE NETWT END WT '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',RATE,MCHARGE'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'FROM '+@DBNAME+'..ISSUE I '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(CANCEL,'''')='''' AND TRANTYPE IN(''SA'',''OD'',''RD'') '"
        strSql += vbCrLf + "	IF @COSTID<>'ALL' AND @COSTID<>'' "
        strSql += vbCrLf + "		SELECT @QRY= @QRY + CHAR(13) +' AND I.COSTID IN('''+ @COSTID +''')'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'AND ISNULL(FIN_DISCOUNT,0)>0'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+')X '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'ORDER BY TRANDATE,TRANNO'"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC(@QRY)"

        strSql += vbCrLf + "	DECLARE @BATCHNO VARCHAR(15)"
        strSql += vbCrLf + "	DECLARE CUR CURSOR FOR"
        strSql += vbCrLf + "	SELECT DISTINCT BATCHNO FROM TEMPTABLEDB..TEMPOTPREPORT"
        strSql += vbCrLf + "	OPEN CUR"
        strSql += vbCrLf + "	FETCH NEXT FROM CUR INTO @BATCHNO"
        strSql += vbCrLf + "	WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		UPDATE TOP(1) TEMPTABLEDB..TEMPOTPREPORT  SET SCHEMEAMT=(SELECT TOP 1 SCHEMEAMT FROM TEMPTABLEDB..TEMPOTPREPORT WHERE BATCHNO=@BATCHNO AND ISNULL(SCHEMEAMT,0)<>0) ,UPDATED='Y' WHERE BATCHNO=@BATCHNO"
        strSql += vbCrLf + "		UPDATE TOP(1) TEMPTABLEDB..TEMPOTPREPORT  SET DISCALLOW =(SELECT TOP 1 DISCALLOW  FROM TEMPTABLEDB..TEMPOTPREPORT WHERE BATCHNO=@BATCHNO AND ISNULL(DISCALLOW ,0)<>0),UPDATED='Y' WHERE BATCHNO=@BATCHNO"
        strSql += vbCrLf + "		UPDATE TOP(1) TEMPTABLEDB..TEMPOTPREPORT  SET DISCLIMIT =(SELECT TOP 1 DISCLIMIT  FROM TEMPTABLEDB..TEMPOTPREPORT WHERE BATCHNO=@BATCHNO AND ISNULL(DISCLIMIT ,0)<>0),UPDATED='Y' WHERE BATCHNO=@BATCHNO"
        strSql += vbCrLf + "		FETCH NEXT FROM CUR INTO @BATCHNO"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	CLOSE CUR"
        strSql += vbCrLf + "	DEALLOCATE CUR"
        strSql += vbCrLf + "	SELECT @QRY=CHAR(13)+'UPDATE TEMPTABLEDB..TEMPOTPREPORT SET SCHEMEAMT=NULL,DISCALLOW =NULL,DISCLIMIT =NULL WHERE UPDATED=''N'''"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY=CHAR(13)+'SELECT TRANNO,DATE,METAL,SUM(FIN_DISCOUNT)FIN_DISCOUNT,SUM(AMOUNT)AMOUNT,SUM(WT)WT'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+',SUM(WAST)WAST,SUM(ROUNDOFF)ROUNDOFF,SUM(MC)MC,SUM(TOTALDISC)TOTALDISC,'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'SUM(DISCALLOW)DISCALLOW,SUM(SCHEMEAMT)SCHEMEAMT,BATCHNO,TRANDATE '"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'FROM TEMPTABLEDB..TEMPOTPREPORT GROUP BY TRANNO,DATE,METAL,BATCHNO,TRANDATE'"
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'ORDER BY TRANDATE,TRANNO'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub RPT_SALESABS()
