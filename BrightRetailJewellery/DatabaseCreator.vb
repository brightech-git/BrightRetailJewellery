        strSql += vbCrLf + "  	SELECT @QRY = @QRY +' ,SUM(ISNULL(PCS,0))PCS,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(DISCOUNT,0))DISCOUNT ,SUM(ISNULL(AMOUNT,0))AMOUNT'"
        strSql += vbCrLf + "  	SELECT @QRY = @QRY +' ,SUM(ISNULL(TAX,0))TAX,SUM(ISNULL(SC,0))SC,SUM(ISNULL(TOTAL,0))TOTAL,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(DIAWT,0))DIAWT'"
