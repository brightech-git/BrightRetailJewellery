        strSql += vbCrLf + "	PRINT @QRY "
        strSql += vbCrLf + "  /*REGULAR*/"
        strSql += vbCrLf + "  IF PATINDEX('%H%',@ADDRESSMODE) <> 0"
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  SELECT @QRY = ''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' INSERT INTO TEMPTABLEDB..ADDRESSINFO'"
