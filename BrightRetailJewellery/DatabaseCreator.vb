            strSql = "IF OBJECT_ID('" & tranDbName & ".." & Trim(T) & "','U') IS NOT NULL SELECT * INTO " & compId & "ADMINDB.." & Trim(T) & " FROM " & tranDbName & ".." & Trim(T)
