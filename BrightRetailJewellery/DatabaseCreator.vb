        strSql += vbCrLf + "   ,@ORDERBYID VARCHAR(1)"
        strSql += vbCrLf + "   ,@SYSTEMID VARCHAR(20)"
        strSql += vbCrLf + "   ,@SEPMISC VARCHAR(1)"
        strSql += vbCrLf + "   ,@SEPPARTSALE VARCHAR(1)"
        strSql += vbCrLf + "   ,@SEPAPP VARCHAR(1)"
        strSql += vbCrLf + "   ,@DIASTNBYROW VARCHAR(3)"
        strSql += vbCrLf + "   ,@GROUPBY VARCHAR(20)"
        strSql += vbCrLf + "   ,@SUBITEMGROUP VARCHAR(1000) "
        strSql += vbCrLf + "   )"
        strSql += vbCrLf + "   AS"
        strSql += vbCrLf + "   SET NOCOUNT ON"
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(MAX) "
        strSql += vbCrLf + "   /** GETTING WHEATHER BACK OFFICE ENTRY SHOULD AFFECT D REPORT OR NOT **/"
        strSql += vbCrLf + "   SELECT @QRY=' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPFLAG'') DROP TABLE TEMPTABLEDB.dbo.TEMPFLAG'"
        strSql += vbCrLf + "   SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''APPROVAL'') DROP TABLE TEMPTABLEDB.dbo.APPROVAL'"
        strSql += vbCrLf + "   SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMNONTAG'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'ITEMNONTAG'"
        strSql += vbCrLf + "   SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMSTOCK1'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'ITEMSTOCK1'"
        strSql += vbCrLf + "   SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'STOCKREPORT'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'STOCKREPORT'"
        strSql += vbCrLf + "   PRINT @QRY"
        strSql += vbCrLf + "   EXEC(@QRY)"
        strSql += vbCrLf + "   SELECT @QRY=' CREATE TABLE TEMPTABLEDB.dbo.TEMPFLAG (FLAG VARCHAR(1))  '"
        strSql += vbCrLf + "   EXEC(@QRY)"
        strSql += vbCrLf + "   SELECT @QRY=' INSERT INTO TEMPTABLEDB.dbo.TEMPFLAG(FLAG) '"
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' SELECT ''C'' UNION ALL  SELECT '''' UNION ALL  SELECT NULL'  "
        strSql += vbCrLf + "   EXEC(@QRY) "
        strSql += vbCrLf + "   DECLARE @HIDEBACKOFFICE VARCHAR(1)"
        strSql += vbCrLf + "   SELECT @HIDEBACKOFFICE = CTLTEXT  FROM "& cnAdminDb &".dbo.SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE'"
        strSql += vbCrLf + "   IF ISNULL(@HIDEBACKOFFICE,'N') = 'N' INSERT INTO TEMPTABLEDB.dbo.TEMPFLAG(FLAG)SELECT 'B'"
        strSql += vbCrLf + "   DECLARE @ITEMFILTER VARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @COUNTERFILTER VARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @COSTFILTER VARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @SUBITEMFILTER VARCHAR(4000) "
        strSql += vbCrLf + "   IF @CATCODE <> 'ALL'  SET @CATCODE = REPLACE(@CATCODE,',',''',''')"
        strSql += vbCrLf + "   SET @ITEMFILTER=' ' /** ITEM FILTER**/ "
        strSql += vbCrLf + "   /*SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y'')'"
        strSql += vbCrLf + "   */"
        strSql += vbCrLf + "   IF @METAL <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE METALID IN('''+@METAL+'''))'"
        strSql += vbCrLf + "   IF @ITEMIDS <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND T.ITEMID IN('+@ITEMIDS+')' "
        strSql += vbCrLf + "   IF @DESIGNERID <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND ISNULL(T.DESIGNERID,0) IN('''+ @DESIGNERID +''')'"
        strSql += vbCrLf + "   IF @CATCODE <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE CATCODE IN('''+@CATCODE+'''))'"
        strSql += vbCrLf + "   IF @ITEMTYPEIDS <> 'ALL'  SET @ITEMFILTER = @ITEMFILTER + ' AND ISNULL(T.ITEMTYPEID,0) IN('+ @ITEMTYPEIDS +',0)'"
        strSql += vbCrLf + "   SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "   IF @COMPANYID <> 'ALL' SET @ITEMFILTER = @ITEMFILTER+ ' AND T.COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "   SET @COUNTERFILTER='' /** COUNTER FILTER**/ "
        strSql += vbCrLf + "   SET @COUNTERID = REPLACE(@COUNTERID,',',''',''')"
        strSql += vbCrLf + "   IF @COUNTERID <> 'ALL' SET @COUNTERFILTER= @COUNTERFILTER + ' AND ISNULL(T.ITEMCTRID,0) IN ('''+ @COUNTERID +''')'"
