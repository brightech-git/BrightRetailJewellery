        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(8000) = ''  "
        strSql += vbCrLf + " DECLARE @CQRY VARCHAR(8000) = ''"
        strSql += vbCrLf + " DECLARE @PREVIOUSFROMDATE VARCHAR(30) = ''  "
        strSql += vbCrLf + " SET @PREVIOUSFROMDATE =  DATEADD(YEAR,-1,@TODAYFROMDATE)  "
        strSql += vbCrLf + " DECLARE @S1 AS INTEGER=0  "
        strSql += vbCrLf + " SELECT @QRY=''  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' SELECT ISNULL(SUM(AMOUNT),0) AMOUNT '  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' ,ACNAME'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY +CHAR(13)+ ' ,ACCODE '  "
