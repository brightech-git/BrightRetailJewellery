        strSql += vbCrLf + "  		, CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, O.RATE  "
        strSql += vbCrLf + "  		, O.AMOUNT+ISNULL(GSTVAL,0) AS AMOUNT, O.GRSWT ,O.NETWT  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''IG'' AND T.TRANTYPE IN(''AD'',''AR''))AS IGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''CG'' AND T.TRANTYPE IN(''AD'',''AR''))AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''SG'' AND T.TRANTYPE IN(''AD'',''AR''))AS SGST  "
        strSql += vbCrLf + "  		,GSTVAL AS TAX,A.AMOUNT  AS RECEIPT, 0 AS PAYMENT"
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT  "
