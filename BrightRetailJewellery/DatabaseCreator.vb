        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERSTOCKDIARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  	CREATE PROCEDURE SP_RPT_COUNTERSTOCKDIARY"
        strSql += vbCrLf + "  	  	(     "
        strSql += vbCrLf + "  	  	@DBNAME VARCHAR(30)      "
        strSql += vbCrLf + "  	  	,@ASONDATE  VARCHAR(15)             "
        strSql += vbCrLf + "  	  	,@METAL VARCHAR(100)             "
        strSql += vbCrLf + "  	  	,@CATCODE VARCHAR(100)             "
        strSql += vbCrLf + "  	  	,@ITEMIDS VARCHAR(100)             "
        strSql += vbCrLf + "  	  	,@DESIGNERID VARCHAR(100)             "
        strSql += vbCrLf + "  	  	,@STOCKTYPE VARCHAR(1)             "
        strSql += vbCrLf + "  	  	,@COSTIDS VARCHAR(2000)             "
        strSql += vbCrLf + "  	  	,@ITEMTYPEIDS VARCHAR(5000)             "
        strSql += vbCrLf + "  	  	,@COUNTERID VARCHAR(5000)             "
        strSql += vbCrLf + "  	  	,@COMPANYID VARCHAR(5000)             "
        strSql += vbCrLf + "  	  	,@SYSTEMID VARCHAR(20)  "
        strSql += vbCrLf + "  	  	)             "
        strSql += vbCrLf + "  	  	AS            "
        strSql += vbCrLf + "  	  	SET NOCOUNT ON   "
        strSql += vbCrLf + "  	  	DECLARE @QRY VARCHAR(8000)               "
        strSql += vbCrLf + "  	  	/** GETTING WHEATHER BACK OFFICE ENTRY SHOULD AFFECT D REPORT OR NOT **/   "
        strSql += vbCrLf + "  	  	SELECT @QRY='IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPFLAG'') DROP TABLE TEMPTABLEDB..TEMPFLAG'"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMNONTAG'') DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAG'"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMSTOCK1'') DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1'"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'STOCKREPORT'') DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'STOCKREPORT'"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' IF EXISTS(SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMTAG'') DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMTAG'"
        strSql += vbCrLf + "  	  	PRINT @QRY"
        strSql += vbCrLf + "  	  	EXEC(@QRY)"
        strSql += vbCrLf + "  	  	SELECT @QRY=' CREATE TABLE TEMPTABLEDB..TEMPFLAG (FLAG VARCHAR(1))  '     "
        strSql += vbCrLf + "  	  	EXEC(@QRY)   "
        strSql += vbCrLf + "  	  	SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPFLAG(FLAG) '      "
        strSql += vbCrLf + "  	  	SELECT @QRY= @QRY+' SELECT ''C'' UNION ALL  SELECT '''' UNION ALL  SELECT NULL'  "
        strSql += vbCrLf + "  	  	EXEC(@QRY) "
        strSql += vbCrLf + "  	  	DECLARE @HIDEBACKOFFICE VARCHAR(1)       "
        strSql += vbCrLf + "  	  	SELECT @HIDEBACKOFFICE = CTLTEXT  FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE'       "
        strSql += vbCrLf + "  	  	IF ISNULL(@HIDEBACKOFFICE,'N') = 'N' INSERT INTO TEMPTABLEDB..TEMPFLAG(FLAG)SELECT 'B'  "
        strSql += vbCrLf + "  	  	DECLARE @ITEMFILTER VARCHAR(4000)"
        strSql += vbCrLf + "  	  	DECLARE @COUNTERFILTER VARCHAR(4000)"
        strSql += vbCrLf + "  	  	DECLARE @COSTFILTER VARCHAR(4000)"
        strSql += vbCrLf + "  	  	SET @ITEMFILTER=' ' /** ITEM FILTER**/ "
        strSql += vbCrLf + "  	  	SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM ITEMMAST WHERE ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y'')'"
        strSql += vbCrLf + "  	  	IF @METAL <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM ITEMMAST WHERE METALID IN('''+@METAL+'''))'"
        strSql += vbCrLf + "  	  	IF @ITEMIDS <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND T.ITEMID IN('+@ITEMIDS+')' "
        strSql += vbCrLf + "  	  	IF @DESIGNERID <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND ISNULL(T.DESIGNERID,0) IN('''+ @DESIGNERID +''')'"
        strSql += vbCrLf + "  	  	IF @CATCODE <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM ITEMMAST WHERE CATCODE IN('''+@CATCODE+'''))'"
        strSql += vbCrLf + "  	  	IF @ITEMTYPEIDS <> 'ALL'  SET @ITEMFILTER = @ITEMFILTER + ' AND ISNULL(T.ITEMTYPEID,0) IN('+ @ITEMTYPEIDS +',0)'"
        strSql += vbCrLf + "  	  	SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')  "
        strSql += vbCrLf + "  	  	IF @COMPANYID <> 'ALL' SET @ITEMFILTER = @ITEMFILTER+ ' AND T.COMPANYID IN('''+ @COMPANYID +''')'"
        strSql += vbCrLf + "  	  	SET @COUNTERFILTER='' /** COUNTER FILTER**/ "
        strSql += vbCrLf + "  	  	SET @COUNTERID = REPLACE(@COUNTERID,',',''',''')  "
        strSql += vbCrLf + "  	  	IF @COUNTERID <> 'ALL' SET @COUNTERFILTER= @COUNTERFILTER + ' AND ISNULL(T.ITEMCTRID,0) IN ('''+ @COUNTERID +''')'"
        strSql += vbCrLf + "  	  	SET @COSTFILTER='' /** COSTNAME FILTER**/ "
        strSql += vbCrLf + "  	  	SET @COSTIDS = REPLACE(@COSTIDS,',',''',''')  "
        strSql += vbCrLf + "  	  	IF @COSTIDS <> 'ALL'  SET @COSTFILTER= @COSTFILTER + ' AND ISNULL(T.COSTID,'''') IN('''+ @COSTIDS +''')'"
        strSql += vbCrLf + "  	  	SELECT @QRY='SELECT *,CONVERT(VARCHAR(5),''TAG'')FROMTABLE INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMTAG FROM ITEMTAG AS T WHERE 1=1'    "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + @ITEMFILTER     "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + @COSTFILTER  "
        strSql += vbCrLf + "  	  	EXEC(@QRY) "
        strSql += vbCrLf + "  	  	SET @QRY=''"
        strSql += vbCrLf + "  	  	SELECT @QRY='SELECT * '   "
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAG  '  "
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' FROM ITEMNONTAG T   WHERE 1=1 '      "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + @ITEMFILTER"
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + @COUNTERFILTER   "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + @COSTFILTER  "
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' AND ISNULL(T.FLAG,'''') IN (SELECT FLAG FROM TEMPTABLEDB..TEMPFLAG)  '     "
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' AND ISNULL(CANCEL,'''') = ''''  '  "
        strSql += vbCrLf + "  	  	EXEC (@QRY)"
        strSql += vbCrLf + "  	  	SET @QRY=''"
        strSql += vbCrLf + "  	  	/**CREATE REPORT TABLE **/             "
        strSql += vbCrLf + "  	  	SELECT @QRY='CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1 '"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' ( SEP VARCHAR(10),CATCODE VARCHAR(10),ITEMCTRID INT,ITEMID INT,SUBITEMID INT,PCS INT,GRSWT NUMERIC(15,3)'"
        strSql += vbCrLf + "  	  	SELECT @QRY=@QRY+' ,NETWT NUMERIC(15,3),STNWT NUMERIC(15,3),DIAWT NUMERIC(15,3),SALVALUE DOUBLE PRECISION(15),SNO VARCHAR(15))'"
        strSql += vbCrLf + "  	  	PRINT @QRY"
        strSql += vbCrLf + "  	  	EXEC (@QRY)"
        strSql += vbCrLf + "  	  	IF @STOCKTYPE = 'T' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + "  	  	BEGIN             "
        strSql += vbCrLf + "  	  		/** GETTING OPENING **/             "
        strSql += vbCrLf + "  	  		SET @QRY ='INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1 (SEP,CATCODE,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,STNWT,DIAWT,SALVALUE,SNO) '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''OPE''SEP,IM.CATCODE,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN T.SALEMODE=''R'' THEN T.SALVALUE ELSE 0 END SALVALUE,T.SNO' "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMTAG T '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IM ON T.ITEMID=IM.ITEMID '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE RECDATE < '''+ @ASONDATE +''' AND (ISSDATE IS NULL OR ISSDATE >= '''+ @ASONDATE +''')'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + @COSTFILTER  "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''ISS'' SEP'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,IM.CATCODE,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN T.SALEMODE=''R'' THEN T.SALVALUE ELSE 0 END SALVALUE,T.SNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMTAG  T'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT OUTER JOIN ' + @DBNAME + '..ISSUE AS I ON I.BATCHNO = T.BATCHNO AND I.TAGNO = T.TAGNO'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IM ON T.ITEMID=IM.ITEMID '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE T.ISSDATE = '''+ @ASONDATE +''''"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + @COSTFILTER  "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' UNION ALL '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''REC''SEP '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,IM.CATCODE,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN T.SALEMODE=''R'' THEN T.SALVALUE ELSE 0 END SALVALUE,T.SNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMTAG T '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IM ON T.ITEMID=IM.ITEMID '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE RECDATE = '''+ @ASONDATE +''''"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + @COSTFILTER"
        strSql += vbCrLf + "  	  		PRINT @QRY"
        strSql += vbCrLf + "  	  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		SET @QRY=''"
        strSql += vbCrLf + "  	  	END       "
        strSql += vbCrLf + "  	  	IF @STOCKTYPE = 'N' OR @STOCKTYPE = 'B'             "
        strSql += vbCrLf + "  	  	BEGIN             "
        strSql += vbCrLf + "  	  		/** GETTING NON TAG VALUES **/             "
        strSql += vbCrLf + "  	  		SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1 (SEP,CATCODE,ITEMCTRID,ITEMID,SUBITEMID,PCS,GRSWT,NETWT,STNWT,DIAWT,SALVALUE,SNO)'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''OPE''SEP,IT.CATCODE,ITEMCTRID,T.ITEMID,T.SUBITEMID'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN RECISS = ''R'' THEN PCS ELSE -1*PCS END AS PCS'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN RECISS = ''R'' THEN T.GRSWT ELSE -1*T.GRSWT END AS GRSWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN RECISS = ''R'' THEN NETWT ELSE -1*NETWT END AS NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN RECISS=''R'' THEN CASE WHEN IT.CALTYPE=''R'' THEN (ISNULL(T.RATE,0)*ISNULL(T.PCS,0)) ELSE 0 END ELSE CASE WHEN IT.CALTYPE=''R'' THEN (ISNULL(T.RATE,0)*ISNULL(T.PCS,0))*(-1) ELSE 0 END END SALVALUE'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,SNO  FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAG T '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IT ON T.ITEMID=IT.ITEMID'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE RECDATE < '''+ @ASONDATE +''''"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' UNION ALL  '   "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''ISS'' SEP '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,IT.CATCODE,T.ITEMCTRID,T.ITEMID,T.SUBITEMID,T.PCS,T.GRSWT,T.NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN IT.CALTYPE=''R'' THEN (ISNULL(T.RATE,0)*ISNULL(T.PCS,0)) ELSE 0 END SALVALUE'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,T.SNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAG T '         "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..ISSUE AS I ON ISNULL(T.BATCHNO,'''') = I.BATCHNO'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IT ON T.ITEMID=IT.ITEMID'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE T.RECDATE = '''+ @ASONDATE +''' AND T.RECISS = ''I'''"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' UNION ALL   '  "
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' SELECT ''REC'' SEP,IT.CATCODE,ITEMCTRID,T.ITEMID,SUBITEMID,PCS,T.GRSWT,NETWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''S''))) AS STNWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM ITEMNONTAGSTONE WHERE TAGSNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE = ''D''))) AS DIAWT'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,CASE WHEN IT.CALTYPE=''R'' THEN (ISNULL(T.RATE,0)*ISNULL(T.PCS,0)) ELSE 0 END SALVALUE'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' ,SNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAG T '"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' LEFT JOIN ITEMMAST IT ON T.ITEMID=IT.ITEMID'"
        strSql += vbCrLf + "  	  		SELECT @QRY = @QRY + ' WHERE RECDATE = '''+ @ASONDATE +''' AND RECISS = ''R'' '"
        strSql += vbCrLf + "  	  		PRINT (@QRY)"
        strSql += vbCrLf + "  	  		EXEC (@QRY) "
        strSql += vbCrLf + "  	  		SET @QRY=''"
        strSql += vbCrLf + "  	  	END "
        strSql += vbCrLf + "  	  	SELECT @QRY='UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1 SET SUBITEMID = NULL '"
        strSql += vbCrLf + "  	  	EXEC (@QRY) "
        strSql += vbCrLf + "  	  	SET @QRY=''"
        strSql += vbCrLf + "  	  	SELECT @QRY='IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'STOCKREPORT'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'STOCKREPORT '            "
        strSql += vbCrLf + "  	  	EXEC (@QRY) "
        strSql += vbCrLf + "  	  	SET @QRY=''"
        strSql += vbCrLf + "  	  	SELECT @QRY ='SELECT '     "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' CONVERT(NVARCHAR(300),CA.CATNAME) AS PARTICULAR' "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.PCS ELSE 0 END) AS OPCS'         "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.GRSWT ELSE 0 END) AS OGRSWT'           "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.NETWT ELSE 0 END) AS ONETWT'  "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.STNWT ELSE 0 END) AS OSTNWT'  "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.DIAWT ELSE 0 END) AS ODIAWT'  "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN T.SALVALUE ELSE 0 END) AS OSALVALUE'"
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.PCS ELSE 0 END) AS RPCS'          "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.GRSWT ELSE 0 END) AS RGRSWT'           "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.NETWT ELSE 0 END) AS RNETWT'  "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.STNWT ELSE 0 END) AS RSTNWT'  "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.DIAWT ELSE 0 END) AS RDIAWT'            "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN T.SALVALUE ELSE 0 END) AS RSALVALUE'"
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''ISS'' THEN T.PCS ELSE 0 END) AS IPCS'          "
        strSql += vbCrLf + "  	  	SELECT @QRY = @QRY + ' ,SUM(CASE WHEN SEP = ''ISS'' THEN T.GRSWT ELSE 0 END) AS IGRSWT'"
