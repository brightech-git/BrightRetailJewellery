        strSql += vbCrLf + " 		PRINT @TEMPDES"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " END"

        strSql += vbCrLf + " /*"
        strSql += vbCrLf + " INSERT INTO SMSTEMPLATE(TEMPLATE_NAME,TEMPLATE_CAPTION,TEMPLATE_DESC)"
        strSql += vbCrLf + " VALUES('MIMR_WMCDEALERCHANGE','MIMR WMC DEALER CHANGE ','MIMR TOUCH <OTOUCH>/<NTOUCH>"
