        strSql += vbCrLf + " IF NOT EXISTS (SELECT 1 FROM SYS.INDEXES I WHERE I.NAME = 'WEB_ITEMTAG' AND I.OBJECT_ID = OBJECT_ID('DBO.ITEMTAG'))     "
