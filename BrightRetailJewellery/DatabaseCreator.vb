    Private Sub SP_RPT_ITEMSALESPERFORMANCE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ITEMSALESPERFORMANCE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ITEMSALESPERFORMANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "  CREATE PROCEDURE SP_RPT_ITEMSALESPERFORMANCE"
        strSql += vbCrLf + "  (       "
        strSql += vbCrLf + "  @DATEFROM  VARCHAR(12),       "
        strSql += vbCrLf + "  @DATETO VARCHAR(12),       "
        strSql += vbCrLf + "  @GROUPBY NVARCHAR(1),       "
        strSql += vbCrLf + "  @METALNAME VARCHAR(100),    "
        strSql += vbCrLf + "  @ITEMNAME VARCHAR(8000),       "
        strSql += vbCrLf + "  @CNCOMPANYID NVARCHAR(50),  "
        strSql += vbCrLf + "  @COSTNAME VARCHAR(500) "
        strSql += vbCrLf + "  ,@WITHOPENING VARCHAR(1)"
        strSql += vbCrLf + "  ,@OPENINGFDATE VARCHAR(12)     "
        strSql += vbCrLf + "  ,@OPENINGTDATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@GRSNET VARCHAR(1)   "
        strSql += vbCrLf + "  ,@ORDERONLY VARCHAR(1)      "
        strSql += vbCrLf + "  ,@ORMAST VARCHAR(1)      "
        strSql += vbCrLf + "  ,@CASHCOUNTER VARCHAR (300)      "
        strSql += vbCrLf + "  )AS        "
        strSql += vbCrLf + "  SET NOCOUNT ON    "
        strSql += vbCrLf + "  DECLARE @STRQRY VARCHAR(8000)         "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPITEM') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEM"
        strSql += vbCrLf + "  SELECT @STRQRY = 'EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = ''" & compId & "ADMINDB'', @CHK_TBL = ''ITEMMAST'', '"
        strSql += vbCrLf + "  SELECT @STRQRY = @STRQRY + ' @CHK_FIELD = ''ITEMNAME'',@OUTPUT_FIELD=''ITEMID'',@RESULT_TBL = ''TEMPTABLEDB..TEMPITEM'',@INPUTVALUES = '''+@ITEMNAME+'''  '"
        strSql += vbCrLf + "  PRINT @STRQRY"
        strSql += vbCrLf + "  EXEC(@STRQRY)"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..METAL') IS NOT NULL DROP TABLE TEMPTABLEDB..METAL    "
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..METAL(METALID VARCHAR(1))    "
        strSql += vbCrLf + "  IF @METALNAME <> '' AND @METALNAME <> 'ALL'    "
        strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..METAL(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METALNAME    "
        strSql += vbCrLf + "  ELSE    "
        strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..METAL(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST    "

        'strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..CASHCOUNTERID') IS NOT NULL DROP TABLE TEMPTABLEDB..CASHCOUNTERID "
        'strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..CASHCOUNTERID(CASHID VARCHAR(5)) "
        ''strSql += vbCrLf + "  IF @CASHCOUNTER <> '' AND @CASHCOUNTER <> 'ALL' "
        ''strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..CASHCOUNTERID(CASHID) SELECT CASHID FROM " & compId & "ADMINDB..CASHCOUNTER WHERE CASHNAME = @CASHCOUNTER "
        ''strSql += vbCrLf + "  ELSE    "
        ''strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..CASHCOUNTERID(CASHID) SELECT CASHID FROM " & compId & "ADMINDB..CASHCOUNTER   "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#CASHCOUNTER') IS NOT NULL DROP TABLE #CASHCOUNTER "
        strSql += vbCrLf + "  CREATE TABLE #CASHCOUNTER(CASHID VARCHAR(5)) "
        strSql += vbCrLf + " IF @CASHCOUNTER <> '' AND @CASHCOUNTER <> 'ALL'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "    SELECT @STRQRY = CHAR(13) +' EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = ''" & compId & "ADMINDB'',@CHK_TBL = ''CASHCOUNTER'',@CHK_FIELD = ''CASHNAME'',@OUTPUT_FIELD=''CASHID'',@RESULT_TBL = ''TEMPCASHCOUNTER'',@INPUTVALUES= '''+@CASHCOUNTER+''',@DEF_VAL='',0'''"
        strSql += vbCrLf + "    PRINT @STRQRY"
        strSql += vbCrLf + "    EXEC (@STRQRY)"
        strSql += vbCrLf + "    SELECT @STRQRY = CHAR(13) +' INSERT INTO #CASHCOUNTER(CASHID) SELECT CASHID FROM " & tranDbName & "..TEMPCASHCOUNTER'"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " IF @CASHCOUNTER = '' OR @CASHCOUNTER = 'ALL'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "    SELECT @STRQRY = CHAR(13) +' INSERT INTO #CASHCOUNTER(CASHID) SELECT CASHID FROM " & compId & "ADMINDB..CASHCOUNTER'"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " PRINT @STRQRY"
        strSql += vbCrLf + " EXEC (@STRQRY)"

        strSql += vbCrLf + " IF OBJECT_ID('TEMPTABLEDB..COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..COSTCENTRE"
        strSql += vbCrLf + " CREATE TABLE TEMPTABLEDB..COSTCENTRE(COSTID VARCHAR(5))  "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '" & tranDbName & "..TEMPCST',@INPUTVALUES =@COSTNAME,@DEF_VAL=',0'  "
        strSql += vbCrLf + " INSERT INTO TEMPTABLEDB..COSTCENTRE(COSTID) SELECT COSTID FROM " & tranDbName & "..TEMPCST  "
        strSql += vbCrLf + " DROP TABLE " & tranDbName & "..TEMPCST  "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..ITM_PER') IS NOT NULL DROP TABLE TEMPTABLEDB..ITM_PER"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..ITM_PER  "
        strSql += vbCrLf + "	("
        strSql += vbCrLf + "	 ITEMNAME VARCHAR(50),  "
        strSql += vbCrLf + "	 PCS INT,  "
        strSql += vbCrLf + "	 GRSWT NUMERIC(12,3),  "
        strSql += vbCrLf + "	 NETWT NUMERIC(12,3),  "
        strSql += vbCrLf + "	 STNWT NUMERIC(12,3),  "
        strSql += vbCrLf + "	 AMOUNT NUMERIC(15,2),  "
        strSql += vbCrLf + "	 COUNTERNAME VARCHAR(30),  "
        strSql += vbCrLf + "	 METALNAME VARCHAR(30),  "
        strSql += vbCrLf + "	 SEP VARCHAR(2), "
        strSql += vbCrLf + "	 COSTNAME VARCHAR(30),"
        strSql += vbCrLf + "	 COUNTERGROUP VARCHAR(30) )    "
        strSql += vbCrLf + " IF @ORDERONLY='N'   "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "	PRINT '@ORDERONLY' +          @ORDERONLY	"
        strSql += vbCrLf + "	SELECT @STRQRY = 'INSERT INTO TEMPTABLEDB..ITM_PER     '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' SELECT (SELECT ITEMNAME FROM  " & compId & "ADMINDB..ITEMMAST AS IM WHERE IM.ITEMID=I.ITEMID) ITEMNAME                     '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,ISNULL(PCS,0) AS PCS ,ISNULL(GRSWT,0) GRSWT, ISNULL(NETWT,0) NETWT '    "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,ISNULL((SELECT SUM(STNWT) FROM  " & tranDbName & "..ISSSTONE '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' WHERE ISSSNO = I.SNO AND I.COMPANYID IN ('+@CNCOMPANYID+') AND STNITEMID IN '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' (SELECT ITEMID FROM  " & compId & "ADMINDB..ITEMMAST WHERE METALID=''D'') GROUP BY ISSSNO),0) STNWT'"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,ISNULL(AMOUNT,0) AMOUNT' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,(SELECT ITEMCTRNAME FROM  " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRID=I.ITEMCTRID) AS COUNTERNAME '       "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,(SELECT METALNAME FROM  " & compId & "ADMINDB..METALMAST WHERE METALID=I.METALID) AS METALNAME'    "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,CONVERT(VARCHAR(2), ''I'') SEP , (SELECT COSTNAME FROM " & compId & "ADMINDB..COSTCENTRE WHERE ISNULL(COSTID,'''') = I.COSTID)' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' COSTNAME , ISNULL((SELECT  GROUPNAME FROM " & compId & "ADMINDB..ITEMGROUPMAST WHERE GROUPID =   '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' (SELECT TOP 1 CTRGROUP  FROM " & compId & "ADMINDB..ITEMCOUNTER WHERE ITEMCTRID =   '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' (SELECT TOP 1 ITEMCTRID FROM " & compId & "ADMINDB..ITEMTAG WHERE ITEMCTRID = I.ITEMCTRID))),''ZZZZ'') COUNTERGROUP'         "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' FROM  " & tranDbName & "..ISSUE AS I '       "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' WHERE I.TRANDATE BETWEEN '''+@DATEFROM+''' AND '''+@DATETO+''' AND I.COMPANYID IN ('+@CNCOMPANYID+') '       "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' AND ISNULL(I.CANCEL,'''')<>''Y''  AND I.TRANTYPE IN (''SA'',''OD'',''RD'') '     "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' AND ISNULL(ITEMID,'''') IN (SELECT ITEMID FROM  TEMPTABLEDB..TEMPITEM WHERE ITEMID'  "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' IN (SELECT ITEMID   FROM TEMPTABLEDB..TEMPITEM ) UNION SELECT 0) '      "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' AND ISNULL(METALID,'''') IN (SELECT METALID FROM TEMPTABLEDB..METAL)'    "
        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' AND ISNULL(CASHID,'''') IN (SELECT CASHID FROM #CASHCOUNTER) ' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..COSTCENTRE)' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' UNION ALL '       "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' SELECT (SELECT ITEMNAME FROM  " & compId & "ADMINDB..ITEMMAST AS IM WHERE IM.ITEMID=R.ITEMID) ITEMNAME'        "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,ISNULL(PCS,0) AS PCS ,ISNULL(GRSWT,0)GRSWT,ISNULL(NETWT,0)NETWT '"
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' ,ISNULL((SELECT SUM(STNWT) FROM  " & tranDbName & "..RECEIPTSTONE WHERE ISSSNO=R.SNO AND' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' COMPANYID IN ('+@CNCOMPANYID+') AND STNITEMID IN (SELECT ITEMID FROM  " & compId & "ADMINDB..ITEMMAST WHERE METALID=''D'')' "
        strSql += vbCrLf + "	SELECT @STRQRY= @STRQRY + CHAR(13) + ' GROUP BY ISSSNO),0) STNWT                      '"
