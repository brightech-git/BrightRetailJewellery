        'strSql += vbCrLf + "  	AND ACCODE NOT IN (SELECT ACCODE FROM #CASHACC)  AND ISNULL(CANCEL,'') = ''  "
        'strSql += vbCrLf + "  	  AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) "
