        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + 'METALID VARCHAR(1),PARTICULARS VARCHAR(50),R_PCS DECIMAL(10,2) DEFAULT 0,R_GRSWT DECIMAL(15,3) DEFAULT 0,'"
