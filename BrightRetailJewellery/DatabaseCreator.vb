            'strSql = " SELECT 1 FROM " & compId + usuffix & "..SYSOBJECTS WHERE NAME = 'SENDSYNC'"
            'cmd = New OleDbCommand(strSql, cn, tran)
            'da = New OleDbDataAdapter(cmd)
            'da.Fill(dtDupCheck)
            'If dtDupCheck.Rows.Count > 0 Then
            '    ''Create Dup db
