        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND I.TRANTYPE = ''SA'' AND ISNULL(CANCEL,'''') = '''''"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + @COMFILTER"
