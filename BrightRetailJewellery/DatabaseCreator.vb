        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' ELSE '''' END AS	COLTYPE FROM  '+ @DBNAME +'..SYSCOLUMNS CO'"
        strSql += vbCrLf + " SELECT @QRY=@QRY+CHAR(13)+' INNER JOIN  '+ @DBNAME +'..SYSOBJECTS AS OB ON OB.ID = CO.ID AND OB.XTYPE = ''U'' AND OB.NAME = '''+ @TABLENAME +''' AND CO.NAME IN('''+ REPLACE(@COLUMNNAME,',',''',''') +''') '"
