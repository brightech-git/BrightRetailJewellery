        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<COSTID>',@COSTID)"
        strSql += vbCrLf + " 		INSERT INTO BRIGHTECHSMSDB..SMSDATA(MOBILENO,MESSAGES,STATUS)"
