    Private Sub SP_RPT_GETTRANJOBNO()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='GET_TRANJOBNO_TRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE GET_TRANJOBNO_TRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE GET_TRANJOBNO_TRAN"
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @COSTID VARCHAR(2)  "
        strSql += vbCrLf + " ,@CTLID VARCHAR(150)  "
        strSql += vbCrLf + " ,@CHECKTABLENAME VARCHAR(200)  "
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + " ,@JOBNO varchar(2)"
        strSql += vbCrLf + " ,@RETVALUE VARCHAR(50) OUTPUT"
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET NOCOUNT ON  "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(4000)  "
        strSql += vbCrLf + " DECLARE @SNO VARCHAR(15)  "
        strSql += vbCrLf + " DECLARE @TSNO INT  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#CHECKSNO', 'U') IS NOT NULL DROP TABLE #CHECKSNO  "
        strSql += vbCrLf + " CREATE TABLE #CHECKSNO (SNO VARCHAR(15))  "
        strSql += vbCrLf + " While 1 = 1"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " While 1 = 1"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @TSNO = ISNULL(CONVERT(INT,CTLVALUE),0) FROM  " & cnStockDb & "..SNOCREATOR WHERE CTLID = @CTLID AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + " IF (SELECT @@ROWCOUNT) = 0 "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " INSERT  " & cnStockDb & "..SNOCREATOR VALUES(@CTLID,0,@COMPANYID,@COSTID)"
        strSql += vbCrLf + " SET @TSNO =0"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " UPDATE  " & cnStockDb & "..SNOCREATOR SET CTLVALUE = @TSNO+1 WHERE CTLID = @CTLID AND ISNULL(CONVERT(INT,CTLVALUE),0) = @TSNO AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + " IF (SELECT @@ROWCOUNT) > 0 BREAK  "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " if @JOBNO='Y'"
        strSql += vbCrLf + " SELECT @SNO = REPLICATE('0',2-LEN(@COSTID))+ @COSTID + REPLICATE('0',3-LEN(@COMPANYID))+ @COMPANYID +'J' + '13' + CONVERT(VARCHAR,@TSNO+1)  "
        strSql += vbCrLf + " if @JOBNO='N'"
        strSql += vbCrLf + " SELECT @SNO = REPLICATE('0',2-LEN(@COSTID))+ @COSTID + REPLICATE('0',3-LEN(@COMPANYID))+ @COMPANYID + '13' + CONVERT(VARCHAR,@TSNO+1)  "
        strSql += vbCrLf + " SELECT @QRY = ' INSERT INTO #CHECKSNO(SNO) SELECT SNO FROM  " & cnStockDb & "..'+@CHECKTABLENAME+ ' WHERE SNO = '''+ @SNO + ''''  "

        strSql += vbCrLf + " EXEC (@QRY)  "
        strSql += vbCrLf + " IF NOT (SELECT COUNT(*) FROM #CHECKSNO)>0 BREAK  "
        strSql += vbCrLf + " DELETE FROM #CHECKSNO"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " SELECT @RETVALUE = CONVERT(VARCHAR(50),@SNO)  "
        strSql += vbCrLf + " End"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_GETCONTROLS()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_GETCONTROLS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_GETCONTROLS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_GETCONTROLS (@DBNAME VARCHAR(25),@IDS VARCHAR(500) )"
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " DECLARE @SQLQRY NVARCHAR(2000)"
        strSql += vbCrLf + " SET @SQLQRY = ''"
        strSql += vbCrLf + " SELECT @SQLQRY = @SQLQRY+'SELECT CTLID,CTLTEXT FROM '+@DBNAME+'..SOFTCONTROL'"
        strSql += vbCrLf + " IF @IDS<> '' SELECT @SQLQRY = @SQLQRY+' WHERE CTLID IN('+@IDS+')'"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @SQLQRY"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

