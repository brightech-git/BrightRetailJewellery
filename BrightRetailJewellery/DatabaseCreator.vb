    Private Sub SP_RPT_SIZEWISESTOCKREPORT()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SIZEWISESTOCK')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SIZEWISESTOCK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "   CREATE PROCEDURE SP_RPT_SIZEWISESTOCK"
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "   @ITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@SUBITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@COSTID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@SIZEID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@ASONDATE VARCHAR(12) "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(3)  "
        strSql += vbCrLf + "  ,@CNADMINDB NVARCHAR(50) "
        strSql += vbCrLf + "  ,@CNSTOCKDB NVARCHAR(50)"
        strSql += vbCrLf + "  ,@WITHAPPROVAL VARCHAR(1)"
        strSql += vbCrLf + "  ,@METALID VARCHAR(5000)"
        strSql += vbCrLf + "  )  "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  SET NOCOUNT ON  "
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000) "
        strSql += vbCrLf + "  SELECT @STRQRY =' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''ITEMMAST'',@CHK_FEILD = ''ITEMID'',@RESULT_TBL = ''TEMPITEMMAST'',@INPUTVALUES ='''+@ITEMID+''''  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''SUBITEMMAST'',@CHK_FEILD = ''SUBITEMID'',@RESULT_TBL = ''TEMPSUBITEMMAST'',@INPUTVALUES = '''+@SUBITEMID+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''ITEMSIZE'',@CHK_FEILD = ''SIZEID'',@RESULT_TBL = ''TEMPITEMSIZE'',@INPUTVALUES = '''+@SIZEID+''''  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''COSTCENTRE'',@CHK_FEILD = ''COSTID'',@RESULT_TBL = ''TEMPCOSTCENTRE'',@INPUTVALUES = '''+@COSTID+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''COMPANY'',@CHK_FEILD = ''COMPANYID'',@RESULT_TBL = ''TEMPCOMPANY'',@INPUTVALUES = '''+@COMPANYID+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' EXEC  SP_SPLITVALUES @CHK_DB = '+@CNADMINDB+',@CHK_TBL = ''METALMAST'',@CHK_FEILD = ''METALID'',@RESULT_TBL = ''TEMPMETALMAST'',@INPUTVALUES = '''+@METALID+''''"
        strSql += vbCrLf + "  PRINT @STRQRY    "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY  "

        strSql += vbCrLf + "  SELECT @STRQRY =''"
        strSql += vbCrLf + "  SELECT @STRQRY =' IF OBJECT_ID(''TEMPTABLEDB..TEMPSIZE'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPSIZE '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT SUBITEMNAME,CONVERT (VARCHAR(50),SIZENAME)SIZENAME,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(RATE)RATE,SUM(IPCS)IPCS,SUM(IGRSWT)IGRSWT,SUM(IRATE)IRATE,SUM(RPCS)RPCS,SUM(RGRSWT)RGRSWT,SUM(RRATE)RRATE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(NUMERIC(15,3),0)DIFFPCS,CONVERT(NUMERIC(15,3),0)DIFFWT,CONVERT(NUMERIC(15,3),0)DIFFRT,ITEM,SUBITEM,SIZE,'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' RESULT, COLHEAD'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' INTO TEMPTABLEDB..TEMPSIZE  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ('"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT SM.SUBITEMNAME,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZENAME,T.PCS,T.GRSWT,T.RATE,0 IPCS,0 IGRSWT,0 IRATE,0 RPCS,0 RGRSWT,0 RRATE,IM.ITEMNAME AS ITEM,SM.SUBITEMNAME AS SUBITEM,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(INT,1) AS RESULT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(VARCHAR(3),NULL)COLHEAD '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM  ITEMTAG AS T'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT JOIN  ITEMMAST AS IM ON IM.ITEMID = T.ITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  ITEMSIZE AS SI ON SI.SIZEID = T.SIZEID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' WHERE   RECDATE < '''+@ASONDATE+''''     "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND (ISSDATE > '''+@ASONDATE+''' OR ISSDATE IS NULL)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COMPANYID,0) IN (SELECT COMPANYID FROM TEMPCOMPANY)'  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(IM.METALID,0) IN (SELECT COMPANYID FROM TEMPMETALMAST)'"
        strSql += vbCrLf + "  IF @WITHAPPROVAL = 'N' "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.APPROVAL,'''') <> ''A'' '"

        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' UNION ALL'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT SM.SUBITEMNAME,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZENAME,0 PCS,0 GRSWT,0 RATE,T.PCS IPCS,T.GRSWT IGRSWT,T.RATE IRATE,0 RPCS ,0 RGRSWT,0 RRATE,IM.ITEMNAME AS ITEM,SM.SUBITEMNAME AS SUBITEM,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(INT,1) AS RESULT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(VARCHAR(3),NULL)COLHEAD'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM  ITEMTAG AS T'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT JOIN '+@CNADMINDB+'..ITEMMAST AS IM ON IM.ITEMID = T.ITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  ITEMSIZE AS SI ON SI.SIZEID = T.SIZEID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' WHERE ISSDATE BETWEEN '''+@ASONDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COMPANYID,0) IN (SELECT COMPANYID FROM TEMPCOMPANY)'  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(IM.METALID,0) IN (SELECT COMPANYID FROM TEMPMETALMAST)'"
        strSql += vbCrLf + "  IF @WITHAPPROVAL = 'N' "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.APPROVAL,'''') <> ''A'' '"

        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' UNION ALL'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT SM.SUBITEMNAME,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZENAME,0 PCS,0 GRSWT,0 RATE,0 IPCS,0 IGRSWT,0 IRATE,T.PCS RPCS,T.GRSWT RGRSWT,T.RATE RRATE,IM.ITEMNAME AS ITEM,SM.SUBITEMNAME AS SUBITEM,CASE WHEN SI.SIZENAME<>'''' THEN SI.SIZENAME ELSE ''NO SIZE'' END SIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(INT,1) AS RESULT'    "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,CONVERT(VARCHAR(3),NULL)COLHEAD'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM  ITEMTAG AS T'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT JOIN '+@CNADMINDB+'..ITEMMAST AS IM ON IM.ITEMID = T.ITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' LEFT OUTER JOIN  ITEMSIZE AS SI ON SI.SIZEID = T.SIZEID'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' WHERE RECDATE BETWEEN '''+@ASONDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COMPANYID,'''') = '''+@COMPANYID+'''' "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)  '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.COMPANYID,0) IN (SELECT COMPANYID FROM TEMPCOMPANY)'  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(IM.METALID,0) IN (SELECT COMPANYID FROM TEMPMETALMAST)'"
        strSql += vbCrLf + "  IF @WITHAPPROVAL = 'N' "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' AND ISNULL(T.APPROVAL,'''') <> ''A'' '"

        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' )X GROUP BY SUBITEMNAME,ITEM,SUBITEM,SIZENAME,'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' RESULT, COLHEAD,SIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' UPDATE TEMPTABLEDB..TEMPSIZE SET DIFFPCS =(PCS-IPCS)+(RPCS),DIFFWT = (GRSWT-IGRSWT)+(RGRSWT),DIFFRT = (RATE-IRATE)+(RRATE)'"
        strSql += vbCrLf + "  PRINT @STRQRY     "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY  "
        strSql += vbCrLf + "  SELECT @STRQRY =' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPSIZE)>0'  "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' BEGIN'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' INSERT INTO TEMPTABLEDB..TEMPSIZE(ITEM,SUBITEM,SIZENAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT DISTINCT ITEM,SUBITEM,ITEM,0 RESULT,''T''COLHEAD FROM TEMPTABLEDB..TEMPSIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' INSERT INTO TEMPTABLEDB..TEMPSIZE(ITEM,SUBITEM,SIZENAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT DISTINCT ITEM,SUBITEM,SUBITEM,2 RESULT,''N''COLHEAD FROM TEMPTABLEDB..TEMPSIZE'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' INSERT INTO TEMPTABLEDB..TEMPSIZE (ITEM,SUBITEM,SIZENAME,RESULT,COLHEAD,PCS,GRSWT,IPCS,IGRSWT,RPCS,RGRSWT,DIFFPCS,DIFFWT,SIZE)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SELECT DISTINCT ITEM,SUBITEM,''SUB TOTAL'',3 RESULT,''S''COLHEAD,'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' SUM(PCS),SUM(GRSWT),SUM(IPCS),SUM(IGRSWT),SUM(RPCS),SUM(RGRSWT),SUM(DIFFPCS),SUM(DIFFWT),''ZZ.SUB TOTAL'''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM TEMPTABLEDB..TEMPSIZE GROUP BY ITEM,SUBITEM'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' INSERT INTO TEMPTABLEDB..TEMPSIZE(ITEM,SUBITEM,SIZENAME,RESULT,COLHEAD,PCS,GRSWT,IPCS,IGRSWT,RPCS,RGRSWT,DIFFPCS,DIFFWT,SIZE)'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' Select DISTINCT ''ZZZZZZZ'',''ZZZZZZZZZZZZ'',''GRAND TOTAL'',4 RESULT,''G'' COLHEAD'"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' ,SUM(PCS),SUM(GRSWT),SUM(IPCS),SUM(IGRSWT),SUM(RPCS),SUM(RGRSWT),SUM(DIFFPCS),SUM(DIFFWT),''GRAND TOTAL'''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' FROM TEMPTABLEDB..TEMPSIZE WHERE RESULT IN (1) '"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY +' END'"
        strSql += vbCrLf + "  PRINT @STRQRY "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY  "
        strSql += vbCrLf + "  SELECT @STRQRY =' SELECT SIZENAME,PCS,GRSWT,RATE,IPCS,IGRSWT,IRATE,RPCS,RGRSWT,RRATE,DIFFPCS,DIFFWT,DIFFRT,ITEM,SUBITEM,SIZE,RESULT,COLHEAD FROM TEMPTABLEDB..TEMPSIZE ORDER BY ITEM,SUBITEM,SIZE,RESULT,COLHEAD'"
        strSql += vbCrLf + "  PRINT @STRQRY "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_MATERIALISSUEBALNACE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SMITHACCOUNTBALANCE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SMITHACCOUNTBALANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "    CREATE PROCEDURE SP_RPT_SMITHACCOUNTBALANCE"
        strSql += vbCrLf + "    ("
        strSql += vbCrLf + "    @DBNAME VARCHAR(50)"
        strSql += vbCrLf + "    ,@FROMDATE VARCHAR(13)"
        strSql += vbCrLf + "    ,@TODATE VARCHAR(13)"
        strSql += vbCrLf + "    ,@ACCODE VARCHAR(20)"
        strSql += vbCrLf + "    ,@WEIGHT VARCHAR(3) "
        strSql += vbCrLf + "    )AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   DECLARE @QUERY NVARCHAR(4000) "

        strSql += vbCrLf + "      SELECT @QUERY =' IF OBJECT_ID(''TEMPTABLEDB..TEMPBALANCE'') IS NOT NULL'"
        strSql += vbCrLf + "      SELECT @QUERY =@QUERY +' DROP TABLE TEMPTABLEDB..TEMPBALANCE ' "
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE sp_executesql @QUERY "
        strSql += vbCrLf + "     SELECT @QUERY='CREATE TABLE TEMPTABLEDB..TEMPBALANCE ('"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'ACCODE VARCHAR(7),  OPGRWT NUMERIC(15,3) DEFAULT 0,OPNETWT NUMERIC(15,3)  DEFAULT 0,OPPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',RGRWT NUMERIC(15,3)  DEFAULT 0,RNETWT NUMERIC(15,3)  DEFAULT 0,RPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',IGRWT NUMERIC(15,3)  DEFAULT 0,INETWT NUMERIC(15,3)  DEFAULT 0,IPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',COLHEAD NVARCHAR(2))'"
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "    SELECT @QUERY='INSERT INTO TEMPTABLEDB..TEMPBALANCE(ACCODE,OPGRWT,OPNETWT,OPPUREWT) '"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY+'SELECT ACCODE,CASE WHEN TRANTYPE =''R'' THEN SUM(GRSWT) ELSE SUM(GRSWT)*(-1) END, CASE WHEN TRANTYPE = ''R'' THEN SUM(NETWT) ELSE SUM(NETWT)*(-1) END,'"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY+' CASE WHEN TRANTYPE = ''R'' THEN SUM(PUREWT) ELSE SUM(PUREWT)*(-1) END FROM '+@DBNAME+'..OPENWEIGHT WHERE 1 =1'"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY+' AND ACCODE= '''+@ACCODE+''''"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY+' GROUP BY ACCODE,TRANTYPE '"
        strSql += vbCrLf + "    PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..TEMPBALANCE(ACCODE,OPGRWT,OPNETWT,OPPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT ACCODE,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)), SUM(ISNULL(PUREWT,0)) FROM '+@DBNAME+'..RECEIPT '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE < '''+@FROMDATE+''' AND ACCODE='''+@ACCODE+''''"
        strSql += vbCrLf + "      SELECT @QUERY=@QUERY+' GROUP BY ACCODE '"
        strSql += vbCrLf + "      PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..TEMPBALANCE(ACCODE,OPGRWT,OPNETWT,OPPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT ACCODE,SUM(ISNULL(GRSWT,0))*(-1),SUM(ISNULL(NETWT,0))*(-1), SUM(ISNULL(PUREWT,0)) *(-1)FROM '+@DBNAME+'..ISSUE'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE < '''+@FROMDATE+''' AND ACCODE='''+@ACCODE+''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY ACCODE '"
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..TEMPBALANCE(ACCODE,RGRWT,RNETWT,RPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT ACCODE,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)), SUM(ISNULL(PUREWT,0)) FROM '+@DBNAME+'..RECEIPT '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE BETWEEN '''+@FROMDATE +''' AND '''+ @TODATE +''' AND ACCODE='''+@ACCODE+''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY ACCODE '"
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..TEMPBALANCE(ACCODE,IGRWT,INETWT,IPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT ACCODE,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)) , SUM(ISNULL(PUREWT,0)) FROM '+@DBNAME+'..ISSUE'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE BETWEEN '''+@FROMDATE +''' AND '''+ @TODATE +''' AND ACCODE='''+@ACCODE+''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY ACCODE '"
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "    SELECT @QUERY='SELECT '"
        strSql += vbCrLf + "    IF CHARINDEX('G',@WEIGHT,1) > 0  SELECT @QUERY=@QUERY+' ,SUM(OPGRWT) AS [OPENING],SUM(RGRWT) AS [RECEIPT],SUM(IGRWT) AS [ISSUE],SUM(OPGRWT)+SUM(RGRWT)-SUM(IGRWT) AS [CLOSING]'"
        strSql += vbCrLf + "    IF CHARINDEX('N',@WEIGHT,1) > 0  SELECT @QUERY=@QUERY+',SUM(OPNETWT) AS [OPENING],SUM(RNETWT) AS [RECEIPT],SUM(INETWT) AS [ISSUE],SUM(OPNETWT)+SUM(RNETWT)-SUM(INETWT) AS [CLOSING]'"
        strSql += vbCrLf + "    IF CHARINDEX('P',@WEIGHT,1) > 0  SELECT @QUERY=@QUERY+' SUM(OPPUREWT) AS [OPENING],SUM(RPUREWT) AS [RECEIPT],SUM(IPUREWT) AS [ISSUE],SUM(OPPUREWT)+SUM(RPUREWT)-SUM(IPUREWT) AS [CLOSING]'"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY+' FROM TEMPTABLEDB..TEMPBALANCE A INNER JOIN ACHEAD AS H ON A.ACCODE = H.ACCODE '"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY +' WHERE A.ACCODE='''+@ACCODE+''''"
        strSql += vbCrLf + "    SELECT @QUERY=@QUERY +' GROUP BY ACNAME'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' ORDER BY H.ACNAME'"
        strSql += vbCrLf + "     PRINT @QUERY"
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

