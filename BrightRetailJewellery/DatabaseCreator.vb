        strSql += vbCrLf + "	SELECT @QUERY = 'SELECT  * ,IDENTITY(INT,0,1)AS KEYNO INTO  TEMPTABLEDB..' + @TEMPTABLE +'2 FROM TEMPTABLEDB..' + @TEMPTABLE +'1 '  "
        strSql += vbCrLf + "	IF @FORMAT='Y'"
