        strSql += vbCrLf + " SELECT T1.LPARTICULAR,T1.LTYPE,T1.LACNAME,T1.LCLSWT,T1.LRESULT,T1.LCOLHEAD,T2.RPARTICULAR,T2.RTYPE,T2.RACNAME,T2.RCLSWT,T2.RRESULT,T2.RCOLHEAD     "
        strSql += vbCrLf + " FROM  MASTER..TEMP_RESULT_L AS T1 FULL JOIN MASTER..TEMP_RESULT_R AS T2 ON T1.LKeyNo=T2.RKeyNo "
