        strSql += vbCrLf + "		SELECT @QUERY ='INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'CRADV(TRANNO,TRANDATE ,DEBIT,CREDIT,COLHEAD)  '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' SELECT '''' TRANNO,''TOTAL'' TRANDATE ,SUM(DEBIT)DEBIT,SUM(CREDIT)CREDIT,''S1'' '"
