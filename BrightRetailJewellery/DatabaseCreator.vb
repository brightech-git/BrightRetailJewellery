        strSql += vbCrLf + " 			PRINT @QUERY"
        strSql += vbCrLf + " 			EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		SELECT @QUERY='UPDATE T SET T.USERNAME=U.USERNAME FROM '+@TEMPTABLE +' AS T LEFT JOIN USERMASTER U ON T.USERID=U.USERID'"
