        strSql += vbCrLf + "          	IF @STKTYPE <>'' SET @TAGFILTER =@TAGFILTER + ' AND ISNULL(T.STKTYPE,'''') IN('''+ REPLACE(@STKTYPE ,',',''',''') +''') '"
        strSql += vbCrLf + "          	PRINT @TAGFILTER"
        strSql += vbCrLf + "          	PRINT 'DGJHB'"
        strSql += vbCrLf + "          	SELECT @SQLQRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK1'  "
        strSql += vbCrLf + "          	SELECT @SQLQRY= @SQLQRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCK'  "
        strSql += vbCrLf + "          	SELECT @SQLQRY= @SQLQRY+CHAR(13)+'  IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTK'  "
        strSql += vbCrLf + "          	SELECT @SQLQRY= @SQLQRY+CHAR(13)+'  IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTOCK'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTOCK'  "
        strSql += vbCrLf + "          	SELECT @SQLQRY= @SQLQRY+CHAR(13)+'  IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER1'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER1'  "
        strSql += vbCrLf + "          	SELECT @SQLQRY= @SQLQRY+CHAR(13)+'  IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CTRANSFER'  "
