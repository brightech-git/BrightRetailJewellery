        TrigDisable = funcCheckTriggerStatus("CRBILL_ISSUE_SMS_TRG")
        CRBILL_ISSUE_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("OUTSTANDING", "CRBILL_ISSUE_SMS_TRG")

    End Sub
    Public Sub CUSTOMERSALES_REGD_SMS_TRG()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='CUSTOMERSALES_REGD_SMS_TRG')>0"
        strSql += vbCrLf + " DROP TRIGGER CUSTOMERSALES_REGD_SMS_TRG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE TRIGGER CUSTOMERSALES_REGD_SMS_TRG ON CUSTOMERINFO"
        strSql += vbCrLf + " FOR INSERT AS"
        strSql += vbCrLf + " DECLARE @QRY NVARCHAR(4000),@SMSALERT VARCHAR(1)"
        strSql += vbCrLf + " DECLARE @MESSAGE NVARCHAR(2000),@PSNO VARCHAR(100)"
        strSql += vbCrLf + " DECLARE @MOBILENO VARCHAR(50),@MOBILENOS VARCHAR(100)"
        strSql += vbCrLf + " DECLARE @TEMP VARCHAR(100),@ARRAYSTRING VARCHAR(250)"
        strSql += vbCrLf + " DECLARE @STRLEN INT ,@ARRAYLENGTH INT"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @MOBILENOS=''"
        strSql += vbCrLf + " SET @TEMP=''"
        strSql += vbCrLf + " SET @PSNO=''"
        strSql += vbCrLf + " SET @SMSALERT=''"
        strSql += vbCrLf + " SELECT @SMSALERT= SMSALERT FROM INSERTED"
        strSql += vbCrLf + " IF @SMSALERT <> 'Y' RETURN	"
        strSql += vbCrLf + " SELECT @PSNO= PSNO FROM INSERTED"
        strSql += vbCrLf + " SELECT @MOBILENOS= MOBILE FROM PERSONALINFO WHERE SNO = @PSNO"
        strSql += vbCrLf + " SELECT @MESSAGE =CTLTEXT FROM SOFTCONTROL WHERE CTLID ='SMS_MSG_POS'"
        strSql += vbCrLf + " IF @MOBILENOS <> ''"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF (SELECT ISNULL(CTLTEXT,'N') FROM SOFTCONTROL WHERE CTLID= 'SMS_NAME') ='Y' "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SET @TEMP='DEAR '+(SELECT TITLE+' '+INITIAL+' '+PNAME FROM PERSONALINFO WHERE SNO = @PSNO)"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " SET @MESSAGE = @TEMP +' '+@MESSAGE"
        strSql += vbCrLf + " SET @STRLEN = 0"
        strSql += vbCrLf + " SET @ARRAYSTRING = @MOBILENOS"
        strSql += vbCrLf + " SET @ARRAYLENGTH = LEN(@ARRAYSTRING)"
        strSql += vbCrLf + " WHILE @STRLEN < @ARRAYLENGTH"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF CHARINDEX(',', @ARRAYSTRING,1) > 0 SET @MOBILENO= SUBSTRING(@ARRAYSTRING,1,CHARINDEX(',', @ARRAYSTRING,1)-1)"
        strSql += vbCrLf + " IF CHARINDEX(',', @ARRAYSTRING,1) = 0 SET @MOBILENO = SUBSTRING(@ARRAYSTRING,1,@ARRAYLENGTH)"
        strSql += vbCrLf + " SET @STRLEN = @STRLEN+LEN(@MOBILENO)+1"
        strSql += vbCrLf + " SET @ARRAYSTRING = SUBSTRING(@ARRAYSTRING,LEN(@MOBILENO)+2,@ARRAYLENGTH)"
        strSql += vbCrLf + " SET @QRY ='INSERT INTO BRIGHTECHSMSDB..SMSDATA(MOBILENO,MESSAGES,STATUS)'"
        strSql += vbCrLf + " SET @QRY = @QRY+' SELECT '''+@MOBILENO+''','''+@MESSAGE+''','''''"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub
    Public Sub ITEMMAST_SMS_TRG()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='ITEMMAST_CHANGE_SMS_TRG')>0"
        strSql += vbCrLf + " DROP TRIGGER [ITEMMAST_CHANGE_SMS_TRG]"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE TRIGGER ITEMMAST_CHANGE_SMS_TRG ON ITEMMAST"
        strSql += vbCrLf + " FOR INSERT,UPDATE AS"
        strSql += vbCrLf + "DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "DECLARE @MESSAGE NVARCHAR(2000)"
        strSql += vbCrLf + "DECLARE @MOBILENO VARCHAR(50)"
        strSql += vbCrLf + "DECLARE @MOBILENOS VARCHAR(250),@GROUPMOBILENOS VARCHAR(200)"
        strSql += vbCrLf + "DECLARE @MAILID VARCHAR(50)"
        strSql += vbCrLf + "DECLARE @MAILIDS VARCHAR(250),@GROUPMAILIDS VARCHAR(500)"
        strSql += vbCrLf + "DECLARE @DESC1 VARCHAR(100)"
        strSql += vbCrLf + "DECLARE @TEMP VARCHAR(100),@ARRAYSTRING VARCHAR(250)"
        strSql += vbCrLf + "DECLARE @COUNT INT"
        strSql += vbCrLf + "DECLARE @STRLEN INT ,@ARRAYLENGTH INT"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @MOBILENOS=''"
        strSql += vbCrLf + "SELECT @COUNT = COUNT(*) FROM DELETED"
        strSql += vbCrLf + "SET @MESSAGE ='FYI-'"
        strSql += vbCrLf + "IF @COUNT > 0 SET @MESSAGE =@MESSAGE+' ITEM ALTERED '"
        strSql += vbCrLf + "IF @COUNT = 0 SET @MESSAGE =@MESSAGE+' ITEM CREATED '"
        strSql += vbCrLf + "IF (SELECT ISNULL(ITEMNAME,'') FROM INSERTED) <> '' OR  (SELECT ISNULL(ITEMNAME,'') FROM DELETED) <> ''"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP='NAME:'+(SELECT ITEMNAME FROM INSERTED)"
        strSql += vbCrLf + "IF (SELECT ITEMNAME  FROM INSERTED) <>  (SELECT ITEMNAME  FROM DELETED) "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP = @TEMP+'('+(SELECT ITEMNAME FROM DELETED)+')'"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "IF (SELECT ISNULL(STOCKTYPE,'') FROM INSERTED) <> '' OR (SELECT ISNULL(STOCKTYPE,'') FROM DELETED) <> '' "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP=' STOCK MODE: '+(SELECT CASE WHEN STOCKTYPE = 'T' THEN 'TAGED'  WHEN STOCKTYPE ='N' THEN 'NON TAGED' ELSE 'OTHER' END STOCKTYPE  FROM INSERTED)"
        strSql += vbCrLf + "IF (SELECT ISNULL(STOCKTYPE,'') FROM INSERTED) <> (SELECT ISNULL(STOCKTYPE,'') FROM DELETED) "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP = @TEMP+'('+(SELECT CASE WHEN STOCKTYPE = 'T' THEN 'TAGED'  WHEN STOCKTYPE ='N' THEN 'NON TAGED' ELSE 'OTHER' END STOCKTYPE  FROM DELETED)+')'"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "IF (SELECT ISNULL(SUBITEM,'') FROM INSERTED) <> '' OR (SELECT ISNULL(SUBITEM,'') FROM DELETED) <> '' "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP=' SUB ITEM:'+(SELECT CASE WHEN SUBITEM = 'Y' THEN 'YES'  WHEN SUBITEM ='N' THEN 'NO' END SUBITEM  FROM INSERTED)"
        strSql += vbCrLf + "IF (SELECT ISNULL(SUBITEM,'') FROM INSERTED) <>  (SELECT ISNULL(SUBITEM,'') FROM DELETED) "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP = @TEMP+'('+(SELECT CASE WHEN SUBITEM = 'Y' THEN 'YES'  WHEN SUBITEM ='N' THEN 'NO' END SUBITEM  FROM DELETED)+')'"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "IF (SELECT ISNULL(STUDDEDSTONE,'') FROM INSERTED) <> '' OR (SELECT ISNULL(STUDDEDSTONE,'') FROM DELETED) <> '' "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP=' STUDED :'+(SELECT CASE WHEN STUDDEDSTONE = 'Y' THEN 'YES'  WHEN STUDDEDSTONE ='N' THEN 'NO' END STUDDED  FROM INSERTED)"
        strSql += vbCrLf + "IF (SELECT ISNULL(STUDDEDSTONE,'') FROM INSERTED) <>  (SELECT ISNULL(STUDDEDSTONE,'') FROM DELETED) "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @TEMP = @TEMP+'('+(SELECT CASE WHEN STUDDEDSTONE = 'Y' THEN 'YES'  WHEN STUDDEDSTONE ='N' THEN 'NO' END STUDDEDSTONE  FROM DELETED)+')'"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "SET @MESSAGE = @MESSAGE+ @TEMP"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "DECLARE @CUR CURSOR"
        strSql += vbCrLf + "IF @COUNT > 0 	SET @CUR =  CURSOR FOR SELECT  B.GROUPMOBILES FROM " & cnAdminDb & "..ALERTTRAN A LEFT JOIN " & cnAdminDb & "..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'ITEMMAST' AND _EDIT ='Y' "
        strSql += vbCrLf + "IF @COUNT = 0 	SET @CUR = CURSOR FOR SELECT  B.GROUPMOBILES FROM " & cnAdminDb & "..ALERTTRAN A LEFT JOIN " & cnAdminDb & "..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'ITEMMAST' AND _ADD ='Y' "
        strSql += vbCrLf + "OPEN @CUR"
        strSql += vbCrLf + "While 1 = 1"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "FETCH NEXT FROM @CUR INTO @GROUPMOBILENOS"
        strSql += vbCrLf + "IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "SET NOCOUNT ON"
        strSql += vbCrLf + "IF @MOBILENOS <> '' SET @MOBILENOS= @MOBILENOS +','+ @GROUPMOBILENOS"
        strSql += vbCrLf + "IF @MOBILENOS = '' SET @MOBILENOS= @GROUPMOBILENOS"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "Close @CUR"
        strSql += vbCrLf + "DEALLOCATE @CUR"

        strSql += vbCrLf + "IF @MOBILENOS <> ''"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "SET @STRLEN = 0"
        strSql += vbCrLf + "SET @ARRAYSTRING = @MOBILENOS"
        strSql += vbCrLf + "SET @ARRAYLENGTH = LEN(@ARRAYSTRING)"
        strSql += vbCrLf + "WHILE @STRLEN < @ARRAYLENGTH"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "IF CHARINDEX(',', @ARRAYSTRING,1) > 0 SET @MOBILENO= SUBSTRING(@ARRAYSTRING,1,CHARINDEX(',', @ARRAYSTRING,1)-1)"
        strSql += vbCrLf + "IF CHARINDEX(',', @ARRAYSTRING,1) = 0 SET @MOBILENO = SUBSTRING(@ARRAYSTRING,1,@ARRAYLENGTH)"
        strSql += vbCrLf + "SET @STRLEN = @STRLEN+LEN(@MOBILENO)+1"
        strSql += vbCrLf + "SET @ARRAYSTRING = SUBSTRING(@ARRAYSTRING,LEN(@MOBILENO)+2,@ARRAYLENGTH)"
        strSql += vbCrLf + "SET @QRY ='INSERT INTO BRIGHTECHSMSDB..SMSDATA(MOBILENO,MESSAGES,STATUS)'"
        strSql += vbCrLf + "SET @QRY = @QRY+' SELECT '''+@MOBILENO+''','''+@MESSAGE+''','''''"
        strSql += vbCrLf + "EXECUTE sp_executesql @QRY"
        strSql += vbCrLf + "End"
        strSql += vbCrLf + "End"

        strSql += vbCrLf & " SET @MAILIDS = ''"
        strSql += vbCrLf & " 	DECLARE @MAILCUR CURSOR"
        strSql += vbCrLf & " 	IF @COUNT > 0 	SET @MAILCUR =  CURSOR FOR SELECT  B.GROUPMAILS FROM " & cnAdminDb & "..ALERTTRAN A LEFT JOIN " & cnAdminDb & "..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'ITEMMAST' AND _EDIT ='Y' "
        strSql += vbCrLf & " 	IF @COUNT = 0 	SET @MAILCUR = CURSOR FOR SELECT  B.GROUPMAILS FROM " & cnAdminDb & "..ALERTTRAN A LEFT JOIN " & cnAdminDb & "..ALERTGROUP B ON A.GROUPID=B.GROUPID WHERE LTRIM(A.TABLENAME) = 'ITEMMAST' AND _ADD ='Y' "
        strSql += vbCrLf & " 	OPEN @MAILCUR"
        strSql += vbCrLf & " 	While 1 = 1"
        strSql += vbCrLf & " 	BEGIN"
        strSql += vbCrLf & " 		FETCH NEXT FROM @MAILCUR INTO @GROUPMAILIDS"
        strSql += vbCrLf & " 		IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf & " 		SET NOCOUNT ON"
        strSql += vbCrLf & " 		IF @MAILIDS <> '' SET @MAILIDS= @MAILIDS +','+ @GROUPMAILIDS"
        strSql += vbCrLf & " 		IF @MAILIDS = '' SET @MAILIDS= @GROUPMAILIDS"
        strSql += vbCrLf & " 	END"
        strSql += vbCrLf & " 	Close @MAILCUR"
        strSql += vbCrLf & " 	DEALLOCATE @MAILCUR"
        strSql += vbCrLf & " 	IF @MAILIDS <> ''"
        strSql += vbCrLf & " 	BEGIN"
        strSql += vbCrLf & " 		SET @STRLEN = 0"
        strSql += vbCrLf & " 		SET @ARRAYSTRING = @MAILIDS"
        strSql += vbCrLf & " 		SET @ARRAYLENGTH = LEN(@ARRAYSTRING)"
