        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMP_OUTSTANDING AS T WHERE SUBSTRING(RUNNO,6,1) = 'O'"


        strSql += vbCrLf + "      IF @DISPLAY = 'C'       "
