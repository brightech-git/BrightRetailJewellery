        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' GROUP BY T.TRANDATE,T.CONTRA,T.REMARK1,REMARK2,TRANNO,T.BATCHNO,WT_ENTORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE,PAYMODE,P.PNAME'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	/** TOTAL BALANCE **/"
        strSql += vbCrLf + " 	SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPCASHBOOK(TRANDATE,PARTICULAR,DEBIT,CREDIT,COLHEAD,RESULT)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' SELECT TRANDATE,''TOTAL'' AS PARTICULAR,SUM(DEBIT)DEBIT,SUM(CREDIT),''S''COLHEAD,20 RESULT' "
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' FROM TEMPTABLEDB..TEMPCASHBOOK WHERE RESULT IN (2) GROUP BY TRANDATE' "
