        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	SET NOCOUNT ON"
        strSql += vbCrLf + "	DECLARE @TEMP VARCHAR(200)"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "	/** MONTH SEPERATION **/"
        strSql += vbCrLf + "	SELECT @QRY =' IF OBJECT_ID(''TEMPTABLEDB..TEMPMONTHH'', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMONTHH'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' CREATE TABLE TEMPTABLEDB..TEMPMONTHH (MONTHNAME VARCHAR(20),MM INT)'"
