        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "   CLOSE CUR  "
        strSql += vbCrLf + "   DEALLOCATE CUR "
        strSql += vbCrLf + "   SELECT @QRY=  ' ALTER TABLE  TEMPTEST11_ACCODE ADD  [TRAN] VARCHAR(3)'"
        strSql += vbCrLf + "   EXEC(@QRY)"
