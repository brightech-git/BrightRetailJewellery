        strSql += vbCrLf + "@CHQCARDREF VARCHAR(50),"
        strSql += vbCrLf + "@CHQDATE VARCHAR(20),"
        strSql += vbCrLf + "@BRSFLAG VARCHAR(1),"
        strSql += vbCrLf + "@RELIASEDATE VARCHAR(20),"
        strSql += vbCrLf + "@FROMFLAG VARCHAR(1),"
        strSql += vbCrLf + "@REMARK1 VARCHAR(100),"
        strSql += vbCrLf + "@REMARK2 VARCHAR(100),"
        strSql += vbCrLf + "@CONTRA VARCHAR(7),"
        strSql += vbCrLf + "@BATCHNO VARCHAR(15),"
        strSql += vbCrLf + "@USERID VARCHAR(20),"
        strSql += vbCrLf + "@UPDATED VARCHAR(20),"
        strSql += vbCrLf + "@UPTIME VARCHAR(30),"
        strSql += vbCrLf + "@SYSTEMID VARCHAR(3),"
        strSql += vbCrLf + "@CASHID VARCHAR(6),"
        strSql += vbCrLf + "@COSTID VARCHAR(2),"
        strSql += vbCrLf + "@SCOSTID VARCHAR(2),"
        strSql += vbCrLf + "@VATEXM VARCHAR(1),"
        strSql += vbCrLf + "@APPVER VARCHAR(12),"
        strSql += vbCrLf + "@COMPANYID VARCHAR(3),"
        strSql += vbCrLf + "@WT_ENTORDER VARCHAR(20),"
        strSql += vbCrLf + "@TDSCATID VARCHAR(20),"
        strSql += vbCrLf + "@TDSPER VARCHAR(20),"
        strSql += vbCrLf + "@TDSAMOUNT VARCHAR(20),"
        strSql += vbCrLf + "@FLAG VARCHAR(1),"
        strSql += vbCrLf + "@DISC_EMPID VARCHAR(20),"
        strSql += vbCrLf + "@PCODE VARCHAR(3)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "    DECLARE @QRY VARCHAR(4000)   "
