        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' DISTINCT MTRANNAME, MTRANNAME AS TRANNAME,'"
        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' sum(RECEIPT) RECEIPT,'"
        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' sum(PAYMENT) PAYMENT,3 RESULT'"
        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' FROM MASTER..TEMP'+@SYSTEMID+'CASHTRAN WHERE RESULT=2 GROUP BY MTRANNAME'"
        strSql += vbCrLf + "    SELECT @STRQRY= @STRQRY + CHAR(13) + ' END'"
        strSql += vbCrLf + "    PRINT @STRQRY"
        strSql += vbCrLf + "    /* COMPANY ============== */"
        strSql += vbCrLf + "    /* COMPANY Execute Query */"
        strSql += vbCrLf + "    /* COMPANY ============== */"
        strSql += vbCrLf + "    /* COMPANY PRINT @STRQRY */"
        strSql += vbCrLf + "    EXEC SP_EXECUTESQL @STRQRY"
        strSql += vbCrLf + "    /*END*/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function


    Function funcSP3_CardCollectionReport() As Integer
        strSql = " /* -- ========================================== */"
        strSql += vbCrLf + " /* -- Store procedure for CARDCOLLECTIONS Report */"
        strSql += vbCrLf + " /* -- =========================================== */"
        strSql += vbCrLf + " /* *************************************************************************************** */"
        strSql += vbCrLf + " /*   Intitial Authors :       */"
        strSql += vbCrLf + " /*   Create   Date    : 09/09/2008 */"
        strSql += vbCrLf + " /*   Purpose          : For CARDCOLLECTIONS REPORT      */"
        strSql += vbCrLf + " /*   Refred Tables    : " & tranDbName & "..ACCTRAN */"
        strSql += vbCrLf + " /* 		     " & compId + suffix & "..COSTCENTRE */"
        strSql += vbCrLf + " /*   Refred Forms/Dll : MDIREPORT=>FRMCARDCOLLECTIONSREPORT */"
        strSql += vbCrLf + " /*   --------       */"
        strSql += vbCrLf + " /*    Created/Modified            Modified                 Description       */"
        strSql += vbCrLf + " /*   --------    */"

        strSql += vbCrLf + " /* **************************************************************************************** */"
        strSql += vbCrLf + " /* -- ================================================= */"
        strSql += vbCrLf + " /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + " /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CARDCOLLECTION')>0 "
        strSql += vbCrLf + " 	DROP PROCEDURE SP_RPT_CARDCOLLECTION"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_CARDCOLLECTION    "
        strSql += vbCrLf + "   (    "
        strSql += vbCrLf + "   @FRMDATE  SMALLDATETIME/* --FromDate */    "
        strSql += vbCrLf + "   ,@TODATE SMALLDATETIME/* --EndDate */    "
        strSql += vbCrLf + "   ,@TYPE VARCHAR(100) /*(C)redit Card,Che(Q)ue,C(H)it **/  "
        strSql += vbCrLf + "   ,@NODEID VARCHAR(2000)/* --Give the SystemId for Temporary Tables */    "
        strSql += vbCrLf + "   ,@SYSTEMID VARCHAR(3)/* --Give the SystemId for Temporary Tables */    "
        strSql += vbCrLf + "   ,@COSTNAME VARCHAR(2000) /* --for @CostCentre */    "
        strSql += vbCrLf + "   ,@COMPANYID NVARCHAR(500)/*  GIVE THE COMPANYID*/    "
        strSql += vbCrLf + "   ,@WITHCHIT VARCHAR(3) /* WITH CHIT DATA */    "
        strSql += vbCrLf + "   )AS    "
        strSql += vbCrLf + "   BEGIN /** PROC STARTS **/  "
        strSql += vbCrLf + "   SET NOCOUNT ON  "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY  "
        strSql += vbCrLf + "  CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))  "
        strSql += vbCrLf + "  DECLARE @TCOMPANY VARCHAR(50)  "
        strSql += vbCrLf + "  IF @COMPANYID <>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "    IF CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + "        BEGIN  "
        strSql += vbCrLf + "        INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID  "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    WHILE CHARINDEX(',',@COMPANYID)>0  "
        strSql += vbCrLf + "    BEGIN  "
        strSql += vbCrLf + "        SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)  "
        strSql += vbCrLf + "        SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))  "
        strSql += vbCrLf + "        IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + "        BEGIN  "
        strSql += vbCrLf + "            SET @COMPANYID= @COMPANYID + ','  "
        strSql += vbCrLf + "        END  "
        strSql += vbCrLf + "        INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY  "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "        INSERT INTO #COMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY "
        strSql += vbCrLf + "   END"

        strSql += vbCrLf + "   /** type **/  "
        strSql += vbCrLf + "   CREATE TABLE #TYPE (TYPE VARCHAR(3))    "
        strSql += vbCrLf + "   IF @TYPE <> ''  "
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    DECLARE @TEMPTYPE VARCHAR(20)   "
        strSql += vbCrLf + "    IF CHARINDEX(',',@TYPE)=0"
        strSql += vbCrLf + "     INSERT INTO #TYPE (TYPE) SELECT @TYPE  "
        strSql += vbCrLf + "    WHILE CHARINDEX(',',@TYPE)>0"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "     SET @TEMPTYPE=LEFT(@TYPE,CHARINDEX(',',@TYPE)-1)"
        strSql += vbCrLf + "     SET @TYPE=RIGHT(@TYPE,LEN(@TYPE)-CHARINDEX(',',@TYPE))"
        strSql += vbCrLf + "     IF @TYPE <>'' AND CHARINDEX(',',@TYPE)=0"
        strSql += vbCrLf + "      SET @TYPE= @TYPE + ','"
        strSql += vbCrLf + "     INSERT INTO #TYPE (TYPE) SELECT @TEMPTYPE  "
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "    INSERT INTO #TYPE(TYPE) SELECT 'CC' UNION SELECT 'CH' UNION SELECT 'SS'  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "      DECLARE @WITHCHITQRY AS VARCHAR(500)"
        strSql += vbCrLf + "      SELECT @WITHCHITQRY = 'ZZZ'"
        strSql += vbCrLf + "      IF @WITHCHIT = 'N'"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "       SELECT @WITHCHITQRY = 'C'"
        strSql += vbCrLf + "      END"

        strSql += vbCrLf + "   /** MULTI COSTCENTRE **/  "
        strSql += vbCrLf + "   CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))   "
        strSql += vbCrLf + "   IF @COSTNAME = 'ALL' OR @COSTNAME = ''  "
        strSql += vbCrLf + "    INSERT INTO #COSTCENTRE(COSTID)SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE UNION ALL SELECT ''  "
        strSql += vbCrLf + "   ELSE IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..COSTCENTRE)>0"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + "    IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "     INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME    "
        strSql += vbCrLf + "    WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "     SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + "     SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + "     IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "      SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + "     INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @TEMPNAME"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "    INSERT INTO #COSTCENTRE(COSTID)SELECT ''     "
        strSql += vbCrLf + "   /** MULTI NODEID **/  "
        strSql += vbCrLf + "   CREATE TABLE #NODEID (NODEID VARCHAR(3))  "
        strSql += vbCrLf + "   IF @NODEID <> '' AND @NODEID <> 'ALL'  "
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    DECLARE @TEMPNODEID VARCHAR(20)"
        strSql += vbCrLf + "    IF CHARINDEX(',',@NODEID)=0"
        strSql += vbCrLf + "     INSERT INTO #NODEID (NODEID) SELECT @NODEID  "
        strSql += vbCrLf + "    WHILE CHARINDEX(',',@NODEID)>0"
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "     SET @TEMPNODEID=LEFT(@NODEID,CHARINDEX(',',@NODEID)-1)"
        strSql += vbCrLf + "     SET @NODEID=RIGHT(@NODEID,LEN(@NODEID)-CHARINDEX(',',@NODEID))"
        strSql += vbCrLf + "     IF @NODEID <>'' AND CHARINDEX(',',@NODEID)=0"
        strSql += vbCrLf + "      SET @NODEID= @NODEID + ','"
        strSql += vbCrLf + "     INSERT INTO #NODEID (NODEID) SELECT @TEMPNODEID"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "    BEGIN    "
        strSql += vbCrLf + "     INSERT INTO #NODEID(NODEID)  "
        strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..ISSUE WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "     UNION    "
        strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..RECEIPT WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "     UNION    "
        strSql += vbCrLf + "     SELECT DISTINCT SYSTEMID FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE    "
        strSql += vbCrLf + "    END     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "   IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPCARDCOLLECT')>0 DROP TABLE TEMPTABLEDB..TEMPCARDCOLLECT  "
        strSql += vbCrLf + "   SELECT CONVERT(VARCHAR(500),PARTICULAR)PARTICULAR,TRANDATE,TRANNO,SUM(AMOUNT)AMOUNT,CHQCARDNO,SYSTEMID,PAYMODE,CONVERT(VARCHAR(3),COLHEAD)COLHEAD,RESULT,CARDNAME  "
        strSql += vbCrLf + "   INTO TEMPTABLEDB..TEMPCARDCOLLECT   "
        strSql += vbCrLf + "   FROM (  "
        strSql += vbCrLf + "   SELECT ' ' + CHQCARDREF AS PARTICULAR,TRANDATE,TRANNO  "
        strSql += vbCrLf + "   ,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT,CASE WHEN PAYMODE IN ('SS','CB','CZ','CG','CD','HP','HR') THEN CHQCARDREF + ':' + CHQCARDNO ELSE CHQCARDNO END CHQCARDNO,SYSTEMID,CASE PAYMODE WHEN 'CC' THEN 'CREDIT CARD' WHEN 'CH' THEN 'CHEQUE'"
        strSql += vbCrLf + "  ELSE 'CHIT CARD' END AS PAYMODE,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(INT,2) RESULT  "
        strSql += vbCrLf + "   ,(SELECT TOP 1 NAME FROM " & compId & "ADMINDB..CREDITCARD WHERE CARDCODE = T.CARDID)AS CARDNAME  "
        strSql += vbCrLf + "   FROM " & tranDbName & "..ACCTRAN T   "
        strSql += vbCrLf + "   WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND PAYMODE IN (SELECT TYPE FROM #TYPE) AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + "   AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)  "
        strSql += vbCrLf + "   AND SYSTEMID IN (SELECT NODEID FROM #NODEID) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)  "
        'strSql += vbCrLf + "   AND ISNULL(FROMFLAG,'') <> 'C'"
        strSql += vbCrLf + "   AND ISNULL(FROMFLAG,'') <> @WITHCHITQRY"
        strSql += vbCrLf + "   )X  "
        strSql += vbCrLf + "   GROUP BY PARTICULAR,TRANDATE,TRANNO,CHQCARDNO,SYSTEMID,PAYMODE,CARDNAME,RESULT,COLHEAD  "
        strSql += vbCrLf + "   /** INSERTING TITLE AND SUBTOTAL AND GRAND TOTAL **/  "
        strSql += vbCrLf + "   IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPCARDCOLLECT)>0  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCARDCOLLECT(PAYMODE,PARTICULAR,RESULT,COLHEAD)  "
        strSql += vbCrLf + "   SELECT DISTINCT PAYMODE,PAYMODE,0 RESULT,'T' COLHEAD FROM TEMPTABLEDB..TEMPCARDCOLLECT WHERE RESULT = 2  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCARDCOLLECT(PAYMODE,PARTICULAR,AMOUNT,RESULT,COLHEAD,CARDNAME)  "
        strSql += vbCrLf + "   SELECT DISTINCT PAYMODE,'SUB TOTAL',SUM(AMOUNT),3 RESULT,'S','ZZZZ' COLHEAD FROM TEMPTABLEDB..TEMPCARDCOLLECT WHERE RESULT = 2 GROUP BY PAYMODE  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCARDCOLLECT(PAYMODE,PARTICULAR,AMOUNT,RESULT,COLHEAD,CARDNAME)  "
        strSql += vbCrLf + "   SELECT DISTINCT 'ZZZZZ','GRAND TOTAL',SUM(AMOUNT),4 RESULT,'G','ZZZZZ' COLHEAD FROM TEMPTABLEDB..TEMPCARDCOLLECT WHERE RESULT = 2  "
        strSql += vbCrLf + "   INSERT INTO TEMPTABLEDB..TEMPCARDCOLLECT(PAYMODE,RESULT,COLHEAD,CARDNAME,PARTICULAR)  "
        strSql += vbCrLf + "   SELECT DISTINCT PAYMODE,1 RESULT,'T1' COLHEAD,CARDNAME,CARDNAME + ' [' + ISNULL(CONVERT(VARCHAR,SUM(AMOUNT)),'') +']' FROM TEMPTABLEDB..TEMPCARDCOLLECT WHERE RESULT = 2 AND PAYMODE = 'CREDIT CARD'  GROUP BY PAYMODE,CARDNAME"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   DECLARE @QRY VARCHAR(4000)  "
        strSql += vbCrLf + "   SET @QRY = ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CARDCOLLECTION'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECTION'  "
        strSql += vbCrLf + "   SET @QRY = @QRY + ' SELECT * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECTION FROM TEMPTABLEDB..TEMPCARDCOLLECT ORDER BY PAYMODE,CARDNAME,RESULT,PARTICULAR,TRANDATE,TRANNO'  "
        strSql += vbCrLf + "   EXEC (@QRY)  "
        strSql += vbCrLf + "   END /** PROC ENDS **/  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function SP_RPT_CANCEL() As Integer
        strSql = " /* -- ================================= */"
        strSql += vbCrLf + "  /*  STORE PROCEDURE FOR CANCEL REPORT  */"
        strSql += vbCrLf + "  /* ***************************************************************************************** */"
        strSql += vbCrLf + "  /* ================================================= */"
        strSql += vbCrLf + "  /* ALREADY EXISTS THIS PROCEDURE DROP THIS PROCEDURE */"
        strSql += vbCrLf + "  /* ================================================= */"
        strSql += vbCrLf + "  IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CANCEL')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CANCEL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " /* -- ======================= */"
        strSql += vbCrLf + "  /* CREATE STORE PROCEDURE */"
        strSql += vbCrLf + "  /* ======================= */"
        strSql += vbCrLf + "  CREATE PROCEDURE SP_RPT_CANCEL"
        strSql += vbCrLf + "  /* ================= */"
        strSql += vbCrLf + "  /* DECLARE VARIABLES */"
        strSql += vbCrLf + "  /* ================= */"
        strSql += vbCrLf + "  (			"
        strSql += vbCrLf + "  			 @DATEFROM  VARCHAR(12)/* --FROMDATE */"
        strSql += vbCrLf + "  			,@DATETO VARCHAR(12)/* --ENDDATE */"
        strSql += vbCrLf + "  			,@COSTNAME NVARCHAR(75)/* --COSTCENTRE NAME FROM COSTCENTRE TABLE */"
        strSql += vbCrLf + "  			,@SYSTEMID NVARCHAR(20)/* --GIVE THE SYSTEMID FOR TEMPORARY TABLES */"
        strSql += vbCrLf + "  			,@CNADMINDB NVARCHAR(50)/* --GIVE THE DATABASE NAME FOR ADMINDB  */"
        strSql += vbCrLf + "  			,@CNSTOCKDB NVARCHAR(50)/* --GIVE THE DATABASE NAME FOR STOCKDB */"
        strSql += vbCrLf + "  		    ,@CNCOMPANYID NVARCHAR(3)/*  GIVE THE COMPANYID*/"
        strSql += vbCrLf + "  )AS"
        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)"
        strSql += vbCrLf + "  /* ====================================================================== */"
        strSql += vbCrLf + "  /* TAKE THE DATAS FROM ISSUE TABLE WITH CONDITIONS INTO TEMPORARY TABLE */"
        strSql += vbCrLf + "  /* ====================================================================== */"
        strSql += vbCrLf + "  SELECT @STRQRY=''"
        strSql += vbCrLf + "  SELECT @STRQRY='IF(SELECT 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'CANCELREPORT'')>0 '"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' DROP TABLE TEMPTABLEDB..TEMP'+@SystemId+'CANCELREPORT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' SELECT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' BATCHNO AS BATCHNO,CONVERT(VARCHAR(50),TRANTYPE) AS BILLTYPE,TRANNO AS BILLNO,CONVERT(VARCHAR,TRANDATE,103) AS BILLDATE,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' USERNAME,CONVERT(VARCHAR,UPDATED,103) UPDATED,CONVERT(VARCHAR(12),UPTIME,108) UPTIME,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' PCS,GRSWT,NETWT,AMOUNT,TAX,SC,ADSC,(AMOUNT+TAX+SC+ADSC) AS TOTAL,DUMMYDATE,REMARK1,REMARK2'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' INTO TEMPTABLEDB..TEMP'+@SystemId+'CANCELREPORT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' FROM'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ('"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' SELECT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' TI.BATCHNO,TI.TRANNO,TI.TRANDATE,TI.TRANTYPE,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' (SELECT USERNAME FROM '+@CNADMINDB+'..USERMASTER WHERE USERID =CA.USERID) AS USERNAME,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' TI.UPDATED,TI.UPTIME,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' TI.PCS,TI.GRSWT,TI.NETWT,TI.AMOUNT,TI.TAX,TI.SC,TI.ADSC,TI.TRANDATE AS DUMMYDATE'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ,CA.REMARK1,CA.REMARK2'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' FROM  '+@CNSTOCKDB+'..ISSUE AS TI'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' LEFT OUTER JOIN '+@CNSTOCKDB+'..CANCELLEDTRAN  AS CA ON CA.BATCHNO=TI.BATCHNO'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' WHERE TI.TRANDATE BETWEEN '''+@DATEFROM+''' AND '''+@DATETO+''''"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' AND TI.CANCEL =''Y'''"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' AND TI.COMPANYID = '''+@CNCOMPANYID+'''' "
        strSql += vbCrLf + "  IF @COSTNAME<>'ALL' AND @COSTNAME<>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @STRQRY=@STRQRY+' AND TI.COSTID =(SELECT COSTID FROM '+@CNADMINDB+'..COSTCENTRE WHERE COSTNAME ='''+@COSTNAME+''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' )I'"
        strSql += vbCrLf + "  /* ============== */"
        strSql += vbCrLf + "  /* EXECUTE QUERY */"
        strSql += vbCrLf + "  /* ============== */"
        strSql += vbCrLf + "  PRINT @STRQRY "
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @STRQRY"
        strSql += vbCrLf + "  /* ====================================================================== */"
        strSql += vbCrLf + "  /* TAKE THE DATAS FROM RECEIPT TABLE WITH CONDITIONS INTO TEMPORARY TABLE */"
        strSql += vbCrLf + "  /* ====================================================================== */"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' INSERT INTO TEMPTABLEDB..TEMP'+@SystemId+'CANCELREPORT'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' (BATCHNO,BILLTYPE,BILLNO,BILLDATE,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' USERNAME,UPDATED,UPTIME,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' PCS,GRSWT,NETWT,AMOUNT,TAX,SC,ADSC,TOTAL,DUMMYDATE,REMARK1,REMARK2)'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' (SELECT' "
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' BATCHNO AS BATCHNO,TRANTYPE AS BILLTYPE,TRANNO AS BILLNO,CONVERT(VARCHAR,TRANDATE,103) AS BILLDATE,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' USERNAME,CONVERT(VARCHAR,UPDATED,103) UPDATED,CONVERT(VARCHAR(12),UPTIME,108) UPTIME,'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' PCS,GRSWT,NETWT,AMOUNT,TAX,SC,ADSC,(AMOUNT+TAX+SC+ADSC) AS TOTAL,DUMMYDATE,REMARK1,REMARK2'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' FROM'"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' ('"
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' SELECT' "
        strSql += vbCrLf + "  SELECT @STRQRY=@STRQRY+' TR.BATCHNO,TR.TRANNO,TR.TRANDATE,TR.TRANTYPE,'"
