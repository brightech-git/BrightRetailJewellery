        strSql += vbCrLf + "  	SET @DATEFILTER='  AND TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''''"
        strSql += vbCrLf + "  	SET @ODATEFILTER=' AND TRANDATE < '''+ @FROMDATE +''' '"
