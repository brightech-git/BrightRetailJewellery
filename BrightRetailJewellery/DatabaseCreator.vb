    Private Sub SP_RPT_SALESPERFORMANCE_ANALYSIS()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SALESPERFORMANCE_ANALYSIS')>0"
