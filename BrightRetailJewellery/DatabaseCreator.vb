    Function FUNC_RUPEES_WITHCOMMA(ByVal rootdb As String) As Integer
        strSql = " IF OBJECT_ID('FUNC_RUPEES_WITHCOMMA','FN')IS NOT NULL DROP FUNCTION FUNC_RUPEES_WITHCOMMA"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE FUNCTION [DBO].FUNC_RUPEES_WITHCOMMA   "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + "  @NUMERICVAL NUMERIC(30,2)    "
        strSql += vbCrLf + " ,@DECIMALPLACE VARCHAR(1)  "
        strSql += vbCrLf + " ,@EMPTY VARCHAR(1)  "
        strSql += vbCrLf + " )     "
        strSql += vbCrLf + " RETURNS VARCHAR(50)    "
        strSql += vbCrLf + " AS    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " DECLARE @STR AS VARCHAR(50)    "
        strSql += vbCrLf + " DECLARE @NUMREV VARCHAR(15)     "
        strSql += vbCrLf + " DECLARE @CNT AS INT    "
        strSql += vbCrLf + " DECLARE @NEXTCOMMAINDEX AS INT    "
        strSql += vbCrLf + " DECLARE @MINUS VARCHAR(1)  "
        strSql += vbCrLf + " SELECT @NEXTCOMMAINDEX = 3    "
        strSql += vbCrLf + " SELECT @CNT = 0    "
        strSql += vbCrLf + " SELECT @STR = ''  "
        strSql += vbCrLf + " SELECT @MINUS = CASE WHEN PATINDEX('%-%',CONVERT(VARCHAR,@NUMERICVAL)) > 0 THEN '-' ELSE '' END  "
        strSql += vbCrLf + " SELECT @NUMERICVAL = REPLACE(@NUMERICVAL,'-','')  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SELECT @NUMREV = REVERSE(SUBSTRING(CONVERT(VARCHAR,@NUMERICVAL),1,CASE WHEN CHARINDEX('.',CONVERT(VARCHAR,@NUMERICVAL)) > 0 THEN CHARINDEX('.',CONVERT(VARCHAR,@NUMERICVAL)) - 1 ELSE LEN(@NUMERICVAL) - 1 END))    "
        strSql += vbCrLf + " WHILE @CNT <= LEN(CONVERT(VARCHAR,@NUMREV))    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " SELECT @STR = @STR + SUBSTRING(CONVERT(VARCHAR,@NUMREV),@CNT,1)    "
        strSql += vbCrLf + " IF @NEXTCOMMAINDEX = @CNT AND LEN(CONVERT(VARCHAR,@NUMREV)) != @CNT    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " SELECT @STR = @STR + ','    "
        strSql += vbCrLf + " SELECT @NEXTCOMMAINDEX = @NEXTCOMMAINDEX + 2    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " SELECT @CNT = @CNT + 1    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " IF @DECIMALPLACE = ''    "
        strSql += vbCrLf + " SELECT @STR = REVERSE(@STR)    "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " SELECT @STR =  ISNULL(REVERSE(@STR),'') + ISNULL(RIGHT(CONVERT(VARCHAR,@NUMERICVAL),CHARINDEX('.',REVERSE(CONVERT(VARCHAR,@NUMERICVAL)))),'')    "
        strSql += vbCrLf + " IF @EMPTY = 'Y'  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " IF @STR = '0.00'   "
        strSql += vbCrLf + " SELECT @STR = ''  "
        strSql += vbCrLf + " END  "
        strSql += vbCrLf + " RETURN @MINUS + @STR    "
        strSql += vbCrLf + " END    "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function CreateFunctionGetGroupName(ByVal rootdb As String) As Integer
        strSql = " IF OBJECT_ID('GETGROUPNAME','FN')IS NOT NULL DROP FUNCTION GETGROUPNAME"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE FUNCTION GETGROUPNAME(@ACGRPCODE VARCHAR(200)) RETURNS VARCHAR(200)"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @ACGRPNAME VARCHAR(200)"
        strSql += vbCrLf + "	DECLARE @ACMAINSUB VARCHAR(200)"
        strSql += vbCrLf + "	DECLARE @ACMAINCODE VARCHAR(200)"
        strSql += vbCrLf + "	SELECT @ACMAINSUB=ACMAINSUB FROM ACGROUP WHERE CAST(ACGRPCODE AS VARCHAR)=CAST(@ACGRPCODE AS VARCHAR)"
        strSql += vbCrLf + "	IF @ACMAINSUB<>'1'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @ACMAINCODE=ACMAINCODE FROM ACGROUP WHERE CAST(ACGRPCODE AS VARCHAR) =CAST(@ACGRPCODE AS VARCHAR)"
        strSql += vbCrLf + "		SELECT @ACGRPCODE= DBO.GETGROUPNAME(@ACMAINCODE)"
        strSql += vbCrLf + "	END	"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "		SELECT @ACGRPNAME=ACGRPNAME  FROM ACGROUP WHERE CAST(ACGRPCODE AS VARCHAR) =CAST(@ACGRPCODE AS VARCHAR)"
        strSql += vbCrLf + "	RETURN CASE WHEN @ACGRPNAME IS NULL THEN DBO.GETGROUPNAME(@ACMAINCODE) ELSE  @ACGRPNAME END"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionGetCode() As Integer
        strSql = " IF OBJECT_ID('FUNCGETCODE','FN')IS NOT NULL DROP FUNCTION FUNCGETCODE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE FUNCTION FUNCGETCODE(@STR VARCHAR(3))RETURNS VARCHAR(3)"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @I INT   "
        strSql += vbCrLf + "	DECLARE @RETSTR VARCHAR(3)"
        strSql += vbCrLf + "	DECLARE @STR1 VARCHAR(3)"
        strSql += vbCrLf + "	SET @RETSTR=''"
        strSql += vbCrLf + "	SET @I = 1"
        strSql += vbCrLf + "	WHILE (@I <= LEN(@STR))"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @STR1= MASK FROM WASTMCCODE WHERE VALUE=SUBSTRING(@STR, @I, 1)"
        strSql += vbCrLf + "		SET @RETSTR = @RETSTR +@STR1"
        strSql += vbCrLf + "		SET @I = @I + 1"
        strSql += vbCrLf + "	END "
        strSql += vbCrLf + "	RETURN(@RETSTR)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionTodayRate() As Integer
        strSql = " IF OBJECT_ID('GET_TODAY_RATE','FN')IS NOT NULL DROP FUNCTION GET_TODAY_RATE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE FUNCTION GET_TODAY_RATE(@CATCODE AS VARCHAR(7),@DATE AS VARCHAR(20))RETURNS NUMERIC(15,2)  "
        strSql += vbCrLf + "AS  "
        strSql += vbCrLf + "BEGIN  "
        strSql += vbCrLf + "	RETURN (SELECT TOP 1 SRATE FROM RATEMAST "
        strSql += vbCrLf + "	WHERE RDATE =@DATE"
        strSql += vbCrLf + "	AND RATEGROUP = (SELECT MAX(RATEGROUP) FROM RATEMAST WHERE RDATE = @DATE)  "
        strSql += vbCrLf + "	AND METALID =  (SELECT METALID FROM CATEGORY WHERE CATCODE = @CATCODE)  "
        strSql += vbCrLf + "	AND PURITY = (SELECT PURITY FROM PURITYMAST WHERE PURITYID =   "
        strSql += vbCrLf + "	(SELECT PURITYID FROM CATEGORY  WHERE CATCODE = @CATCODE))  "
        strSql += vbCrLf + "	ORDER BY SNO DESC)  "
        strSql += vbCrLf + "END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionGETDIGIT2WORD() As Integer
        strSql = " IF OBJECT_ID('GET_DIGIT2WORD','FN')IS NOT NULL DROP FUNCTION GET_DIGIT2WORD"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE FUNCTION GET_DIGIT2WORD(@M_AMOUNT AS NUMERIC(18,0)) RETURNS VARCHAR(100)"
        strSql += vbCrLf + "AS  "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "   DECLARE @M_FIRST AS VARCHAR(50)"
        strSql += vbCrLf + "   DECLARE @M_LAST AS VARCHAR(50)"
        strSql += vbCrLf + "   SELECT @M_FIRST = "
        strSql += vbCrLf + "     CASE WHEN @M_AMOUNT >= 10 AND @M_AMOUNT <= 19 THEN"
        strSql += vbCrLf + "       CASE @M_AMOUNT "
        strSql += vbCrLf + "         WHEN 10 THEN 'Ten '"
        strSql += vbCrLf + "         WHEN 11 THEN 'Eleven '"
        strSql += vbCrLf + "         WHEN 12 THEN 'Twelve '"
        strSql += vbCrLf + "         WHEN 13 THEN 'Thirteen '"
        strSql += vbCrLf + "         WHEN 14 THEN 'Fourteen '"
        strSql += vbCrLf + "         WHEN 15 THEN 'Fifteen '"
        strSql += vbCrLf + "         WHEN 16 THEN 'Sixteen '"
        strSql += vbCrLf + "         WHEN 17 THEN 'Seventeen '"
        strSql += vbCrLf + "         WHEN 18 THEN 'Eighteen '"
        strSql += vbCrLf + "         WHEN 19 THEN 'Nineteen '"
        strSql += vbCrLf + "         ELSE ''  "
        strSql += vbCrLf + "       END"
        strSql += vbCrLf + "     ELSE"
        strSql += vbCrLf + "       CASE WHEN LEN(@M_AMOUNT) = 2 THEN"
        strSql += vbCrLf + "         CASE LEFT(@M_AMOUNT,1) "
        strSql += vbCrLf + "           WHEN  2 THEN 'Twenty '"
        strSql += vbCrLf + "           WHEN  3 THEN 'Thirty '"
        strSql += vbCrLf + "           WHEN  4 THEN 'Forty '"
        strSql += vbCrLf + "           WHEN  5 THEN 'Fifty '"
        strSql += vbCrLf + "           WHEN  6 THEN 'Sixty '"
        strSql += vbCrLf + "           WHEN  7 THEN 'Seventy '"
        strSql += vbCrLf + "           WHEN  8 THEN 'Eighty '"
        strSql += vbCrLf + "           WHEN  9 THEN 'Ninety '"
        strSql += vbCrLf + "           ELSE ''"
        strSql += vbCrLf + "         END"
        strSql += vbCrLf + "       ELSE ''"
        strSql += vbCrLf + "       END"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "   SELECT @M_LAST = "
        strSql += vbCrLf + "   CASE WHEN @M_AMOUNT >= 10 AND @M_AMOUNT <= 19 THEN"
        strSql += vbCrLf + "     ''"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "     CASE RIGHT(@M_AMOUNT,1) "
        strSql += vbCrLf + "       WHEN  1 THEN 'One'"
        strSql += vbCrLf + "       WHEN  2 THEN 'Two'"
        strSql += vbCrLf + "       WHEN  3 THEN 'Three'"
        strSql += vbCrLf + "       WHEN  4 THEN 'Four'"
        strSql += vbCrLf + "       WHEN  5 THEN 'Five'"
        strSql += vbCrLf + "       WHEN  6 THEN 'Six'"
        strSql += vbCrLf + "       WHEN  7 THEN 'Seven'"
        strSql += vbCrLf + "       WHEN  8 THEN 'Eight'"
        strSql += vbCrLf + "       WHEN  9 THEN 'Nine'"
        strSql += vbCrLf + "       ELSE ''"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   RETURN RTRIM(LTRIM(@M_FIRST + @M_LAST))"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function


    Function CreateFunctionGETNUM2WORD() As Integer
        strSql = " IF OBJECT_ID('GET_NUM2WORD','FN')IS NOT NULL DROP FUNCTION GET_NUM2WORD"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE FUNCTION GET_NUM2WORD(@M_AMOUNT AS NUMERIC(18,2)) RETURNS VARCHAR(MAX)"
        strSql += vbCrLf + "AS  "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "    DECLARE @M_RS AS NUMERIC(18,0)"
        strSql += vbCrLf + "    DECLARE @M_PAISA AS NUMERIC(18,0)"
        strSql += vbCrLf + "    DECLARE @M_CURRENT AS NUMERIC(18,0)"
        strSql += vbCrLf + "    DECLARE @M_RETSTR AS VARCHAR(MAX)"
        strSql += vbCrLf + "    DECLARE @M_POSTFIX AS VARCHAR(20)  "
        strSql += vbCrLf + "    DECLARE @M_DIGIWORD AS VARCHAR(100)"
        strSql += vbCrLf + "    SET @M_AMOUNT = ISNULL(@M_AMOUNT,0)"
        strSql += vbCrLf + "    SET @M_RS = LEFT(@M_AMOUNT,LEN(@M_AMOUNT)-3)"
        strSql += vbCrLf + "    SET @M_PAISA = RIGHT(@M_AMOUNT,2)"
        strSql += vbCrLf + "    SET @M_RETSTR = ''"
        strSql += vbCrLf + "    IF @M_RS = 0 AND @M_PAISA = 0 "
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "      SET @M_RETSTR = 'Zero'"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "    ELSE"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "      IF @M_RS = 0"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "        SET @M_RETSTR = 'Zero'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      ELSE"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "        WHILE @M_RS > 0"
        strSql += vbCrLf + "        BEGIN"
        strSql += vbCrLf + "          SELECT @M_CURRENT = "
        strSql += vbCrLf + "            CASE WHEN LEN(@M_RS) = 3 THEN LEFT(@M_RS,1)"
        strSql += vbCrLf + "            WHEN LEN(@M_RS) <= 2 THEN LEFT(@M_RS,2)"
        strSql += vbCrLf + "            ELSE CASE WHEN (LEN(@M_RS)-2) % 2 = 0 THEN LEFT(@M_RS,1) ELSE LEFT(@M_RS,2) END"
        strSql += vbCrLf + "            END"
        strSql += vbCrLf + "          SELECT @M_DIGIWORD = [DBO].[GET_DIGIT2WORD](@M_CURRENT)"
        strSql += vbCrLf + "          SELECT @M_POSTFIX = CASE "
        strSql += vbCrLf + "          WHEN LEN(@M_RS) = 8 OR LEN(@M_RS) = 9 THEN 'Crore' "
        strSql += vbCrLf + "          WHEN LEN(@M_RS) = 6 OR LEN(@M_RS) = 7 THEN 'Lakh' "
        strSql += vbCrLf + "          WHEN LEN(@M_RS) = 4 OR LEN(@M_RS) = 5 THEN 'Thousand' "
        strSql += vbCrLf + "          WHEN LEN(@M_RS) = 3 THEN 'Hundred'"
        strSql += vbCrLf + "          ELSE '' END"
        strSql += vbCrLf + "          SELECT @M_RS = CASE WHEN LEN(@M_RS) > 2 THEN RIGHT(@M_RS,LEN(@M_RS)-LEN(@M_CURRENT)) ELSE 0 END"
        strSql += vbCrLf + "          SET @M_RETSTR = @M_RETSTR + ' ' + @M_DIGIWORD + ' ' + @M_POSTFIX"
        strSql += vbCrLf + "        END"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      IF @M_PAISA = 0 "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "        SET @M_RETSTR = @M_RETSTR + ' Rupees'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "      ELSE"
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "        SELECT @M_DIGIWORD = [DBO].[GET_DIGIT2WORD](@M_PAISA)"
        strSql += vbCrLf + "        SET @M_RETSTR = @M_RETSTR + ' Rupees and ' + @M_DIGIWORD + ' Paise only'"
        strSql += vbCrLf + "      END"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "    RETURN RTRIM(LTRIM(@M_RETSTR))"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionSpecific(ByVal rootdb As String) As Integer
        strSql = " IF OBJECT_ID('FUNCSPECIFIC','FN')IS NOT NULL DROP FUNCTION FUNCSPECIFIC"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE FUNCTION FUNCSPECIFIC(@SNO VARCHAR(15),@MISCID VARCHAR(100),@TYPE VARCHAR(1)) RETURNS VARCHAR(500)"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	DECLARE @NAME VARCHAR(50)"
        strSql += vbCrLf + " 	DECLARE @VALUE VARCHAR(500)"
        strSql += vbCrLf + " 	DECLARE @TEMP VARCHAR(50)"
        strSql += vbCrLf + " 	DECLARE @TEMP1 VARCHAR(50)"
        strSql += vbCrLf + " 	SET @VALUE=''	"
        strSql += vbCrLf + " 	IF @TYPE='S'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		DECLARE  CUR CURSOR FOR"
        strSql += vbCrLf + " 		SELECT NAME FROM " & rootdb & "..OTHERMASTER WHERE MISCID=@MISCID"
        strSql += vbCrLf + " 		AND ID IN(SELECT OTHID FROM " & rootdb & "..WADDINFOITEMTAG WHERE TAGSNO=@SNO)"
        strSql += vbCrLf + " 		OPEN CUR "
        strSql += vbCrLf + " 		FETCH NEXT FROM CUR INTO @NAME"
        strSql += vbCrLf + " 		WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SET @VALUE=@VALUE+@NAME + ':'"
        strSql += vbCrLf + " 			FETCH NEXT FROM CUR INTO @NAME"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		CLOSE CUR"
        strSql += vbCrLf + " 		DEALLOCATE CUR"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		WHILE CHARINDEX(',',@MISCID)>0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SET @TEMP=LEFT(@MISCID,CHARINDEX(',',@MISCID)-1)"
        strSql += vbCrLf + " 			SET @MISCID=RIGHT(@MISCID,LEN(@MISCID)-CHARINDEX(',',@MISCID))"
        strSql += vbCrLf + " 			IF @MISCID <> '' AND CHARINDEX(',',@MISCID)=0"
        strSql += vbCrLf + " 				SET @MISCID= @MISCID + ','"
        strSql += vbCrLf + " 			SELECT @TEMP=SUBITEMNAME FROM " & rootdb & "..SUBITEMMAST WHERE SUBITEMID =CAST(@TEMP AS INT)"
        strSql += vbCrLf + " 			SELECT @VALUE=@VALUE+@TEMP+':' "
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	IF LEN(@VALUE)>0 SELECT @VALUE=SUBSTRING(@VALUE,1, LEN(@VALUE)-1)"
        strSql += vbCrLf + " 	RETURN @VALUE"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionGetColumns(ByVal rootdb As String) As Integer
        strSql = " IF OBJECT_ID('GETCOLUMNS','FN')IS NOT NULL DROP FUNCTION GETCOLUMNS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE FUNCTION GETCOLUMNS(@TBLNAME VARCHAR(100)) RETURNS VARCHAR(8000)  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " DECLARE @RETSTR VARCHAR(8000) "
        strSql += vbCrLf + " DECLARE @COLNAME VARCHAR(100)  "
        strSql += vbCrLf + " SELECT @RETSTR = ' '  "
        strSql += vbCrLf + " DECLARE CUR CURSOR FOR SELECT NAME FROM " & rootdb & "..SYSCOLUMNS WHERE NAME <> 'TRANSFERED' AND ID = (SELECT ID FROM " & rootdb & "..SYSOBJECTS WHERE NAME = @TBLNAME) ORDER BY NAME  "
        strSql += vbCrLf + " OPEN CUR"
        strSql += vbCrLf + "  WHILE 1=1"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  FETCH NEXT FROM CUR INTO @COLNAME"
        strSql += vbCrLf + "  IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "  SELECT @RETSTR = @RETSTR + @COLNAME + ','"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + " CLOSE CUR"
        strSql += vbCrLf + " DEALLOCATE CUR"
        strSql += vbCrLf + " RETURN CASE WHEN LEN(@RETSTR)>0 THEN SUBSTRING(@RETSTR,1,LEN(@RETSTR)-1)  ELSE '' END"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function CreateFunctionGetPartyBalance(ByVal rootdb As String)
        strSql = " IF OBJECT_ID('GETPARTYBALANCE','FN')IS NOT NULL DROP FUNCTION GETPARTYBALANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE FUNCTION GETPARTYBALANCE"
        strSql += vbCrLf + " ( "
        strSql += vbCrLf + " @ACCODE VARCHAR(7)"
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + " ,@ASONDATE VARCHAR(20)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " RETURNS VARCHAR(50)    "
        strSql += vbCrLf + " AS    "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " 	RETURN("
        strSql += vbCrLf + " 	SELECT "
        strSql += vbCrLf + " 	ISNULL(SUM(DEBIT),0) - ISNULL(SUM(CREDIT),0) BALANCE"
        strSql += vbCrLf + " 	FROM"
        strSql += vbCrLf + " 	("
        strSql += vbCrLf + " 	SELECT DEBIT,CREDIT FROM OPENTRAILBALANCE"
        strSql += vbCrLf + " 	WHERE ACCODE = @ACCODE"
        strSql += vbCrLf + " 	AND COMPANYID = @COMPANYID"
        strSql += vbCrLf + " 	UNION ALL"
        strSql += vbCrLf + " 	SELECT "
        strSql += vbCrLf + " 	ISNULL(SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE 0 END),0) AS DEBIT"
        strSql += vbCrLf + " 	,ISNULL(SUM(CASE WHEN TRANMODE = 'C' THEN ISNULL(AMOUNT,0) ELSE 0 END),0) AS CREDIT"
        strSql += vbCrLf + " 	FROM   ACCTRAN"
        strSql += vbCrLf + " 	WHERE ACCODE = @ACCODE AND TRANDATE <= @ASONDATE"
        strSql += vbCrLf + " 	AND COMPANYID = @COMPANYID  AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + " 	)X)"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function
    Function CreateFunctionWordCaps(ByVal rootDb As String) As Integer
        strSql = " IF (sELECT COUNT(*) FROM SYSOBJECTS WHERE NAME = 'WORDCAPS')>0"
        strSql += vbCrLf + "  DROP FUNCTION WORDCAPS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " CREATE Function WordCaps(@pi_string varchar(500))"
        strSql += vbCrLf + "   RETURNS varchar(500)"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "   DECLARE"
        strSql += vbCrLf + "    @string varchar(500)"
        strSql += vbCrLf + "    ,@formatted_string varchar(500)"
        strSql += vbCrLf + "    ,@length int"

        strSql += vbCrLf + "   SET @string = ltrim(rtrim(@pi_string))"
        strSql += vbCrLf + "   SET @length = len(@string)"
        strSql += vbCrLf + "  SET @formatted_string = upper(left(@string,1)) + lower(substring(@string,2,@length))"
        strSql += vbCrLf + "  /* change first character after each space to upper */"
        strSql += vbCrLf + "  DECLARE @space int"
        strSql += vbCrLf + "  SET @space = charindex(' ', @string)"
        strSql += vbCrLf + "  WHILE @space > 0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET @formatted_string = left(@formatted_string,@space)"
        strSql += vbCrLf + "  + upper(substring(@formatted_string,@space+1, 1))"
        strSql += vbCrLf + "  + substring(@formatted_string,@space+2, 2000)"

        strSql += vbCrLf + "  SET @space = charindex(' ', @string, @space+1)"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "   RETURN @formatted_string"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function funcSP18_CheckBatchno() As Integer
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Sp_Check_Batchno')>0"
        strSql += vbCrLf + "  DROP PROCEDURE Sp_Check_Batchno"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "  CREATE PROCEDURE Sp_Check_Batchno(@BATCHNO VARCHAR(15))"
        strSql += vbCrLf + "   AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @TNAME VARCHAR(100)"
        strSql += vbCrLf + "   DECLARE @TRANDB VARCHAR(10)"
        strSql += vbCrLf + "   SELECT @TRANDB = '" & tranDbName & "'"
        strSql += vbCrLf + "   SELECT @QRY = ''"
        strSql += vbCrLf + "   CREATE TABLE #CHECKBATCH(BATCHNO VARCHAR(15))"
        strSql += vbCrLf + "   DECLARE CUR CURSOR"
        strSql += vbCrLf + "   FOR SELECT "
        strSql += vbCrLf + "   (SELECT NAME FROM " & tranDbName & "..SYSOBJECTS WHERE ID = T.ID)NAME"
        strSql += vbCrLf + "   FROM " & tranDbName & "..SYSCOLUMNS AS T WHERE NAME = 'BATCHNO'"
        strSql += vbCrLf + "   OPEN CUR"
        strSql += vbCrLf + "   WHILE 1 = 1"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   	FETCH NEXT FROM CUR INTO @TNAME"
        strSql += vbCrLf + "   	SET NOCOUNT ON"
        strSql += vbCrLf + "   	IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "    	SELECT @QRY = ' INSERT INTO #CHECKBATCH(BATCHNO) SELECT DISTINCT BATCHNO FROM '+@TRANDB+'..'+ @TNAME + ' WHERE CONVERT(VARCHAR,BATCHNO) = ''' + @BATCHNO + ''' /**/'"
        strSql += vbCrLf + "   	EXEC SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   CLOSE CUR"
        strSql += vbCrLf + "   DEALLOCATE CUR"
        strSql += vbCrLf + "   SELECT DISTINCT BATCHNO FROM #CHECKBATCH"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Sp_Check_WBatchno')>0"
        strSql += vbCrLf + "  DROP PROCEDURE Sp_Check_WBatchno"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "  CREATE PROCEDURE Sp_Check_WBatchno(@BATCHNO VARCHAR(15))"
        strSql += vbCrLf + "   AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @TNAME VARCHAR(100)"
        strSql += vbCrLf + "   DECLARE @TRANDB VARCHAR(10)"
        strSql += vbCrLf + "   SELECT @TRANDB = '" & tranDbName & "'"
        strSql += vbCrLf + "   SELECT @QRY = ''"
        strSql += vbCrLf + "   CREATE TABLE #CHECKBATCH(BATCHNO VARCHAR(15))"
        strSql += vbCrLf + "   DECLARE CUR CURSOR"
        strSql += vbCrLf + "   FOR SELECT NAME FROM (SELECT "
        strSql += vbCrLf + "   (SELECT NAME FROM " & tranDbName & "..SYSOBJECTS WHERE ID = T.ID)NAME"
        strSql += vbCrLf + "   FROM " & tranDbName & "..SYSCOLUMNS AS T WHERE NAME = 'BATCHNO')X WHERE NAME LIKE 'W_%'"
        strSql += vbCrLf + "   OPEN CUR"
        strSql += vbCrLf + "   WHILE 1 = 1"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   	FETCH NEXT FROM CUR INTO @TNAME"
        strSql += vbCrLf + "   	SET NOCOUNT ON"
        strSql += vbCrLf + "   	IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "    	SELECT @QRY = ' INSERT INTO #CHECKBATCH(BATCHNO) SELECT DISTINCT BATCHNO FROM '+@TRANDB+'..'+ @TNAME + ' WHERE BATCHNO = ''' + @BATCHNO + ''' /**/'"
        strSql += vbCrLf + "   	EXEC SP_EXECUTESQL @QRY"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   CLOSE CUR"
        strSql += vbCrLf + "   DEALLOCATE CUR"
        strSql += vbCrLf + "   SELECT DISTINCT BATCHNO FROM #CHECKBATCH"
        strSql += vbCrLf + "   END"
