        strSql += vbCrLf + "    SET @TEMPTBL3 = 'TBLFSTK01'"
        strSql += vbCrLf + "    EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEMMAST',@INPUTVALUES = @ITEMID  "
        strSql += vbCrLf + "    EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'SUBITEMMAST',@CHK_FEILD = 'SUBITEMID',@RESULT_TBL = 'TEMPSUBITEMMAST',@INPUTVALUES = @SUBITEMID  "
        strSql += vbCrLf + "    EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID"
        strSql += vbCrLf + "    SET @QRY = ' IF  EXISTS (SELECT * FROM sysobjects WHERE xtype = ''U'' AND NAME = '"
        strSql += vbCrLf + "    +''''+@TEMPTBL2+''''+' ) DROP TABLE ' + @TEMPTBL2 "
        strSql += vbCrLf + "    PRINT @QRY"
        strSql += vbCrLf + "    EXECUTE sp_executesql @QRY"
        strSql += vbCrLf + "    SELECT @QRY = 'SELECT DESIGNID,ITEMID,SUBITEMID,CONVERT(VARCHAR(200),RANGE)RANGE,SUM(REPCS)REORDPCS,SUM(REWT)REORDWT,SUM(MINPIECE)MINPCS,SUM(STKPCS)STKPCS,SUM(STKWT)STKWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,SUM(DIFFPCS)DIFFPCS,SUM(DIFFWT)DIFFWT,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD,SUM(STRPCS)STRPCS,SUM(STRWT)STRWT,SUM(TOTPCS)TOTPCS,SUM(TOTWT)TOTWT,SUM(LEADTIME)LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' INTO '+@TEMPTBL2"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' FROM(SELECT RE.DESIGNID,RE.ITEMID,RE.SUBITEMID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,(CONVERT(VARCHAR(100),FROMWEIGHT) + '' TO '' + CONVERT(VARCHAR(100),TOWEIGHT) + '' ['' + CONVERT(VARCHAR(100),(CONVERT(DECIMAL(15,3),(CONVERT(VARCHAR(100),((FROMWEIGHT+TOWEIGHT)/2)))))) + '']'')AS RANGE,CONVERT(INT,SUM(T.PCS))STKPCS,CONVERT(NUMERIC(15,3),SUM(T.GRSWT))STKWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,RE.PIECE REPCS,RE.WEIGHT AS REWT,0 MINPIECE,CONVERT(INT,ISNULL(SUM(T.PCS),0)- ISNULL(RE.PIECE,0)) AS DIFFPCS' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,CONVERT(NUMERIC(15,3),ISNULL(SUM(T.GRSWT),0) - ISNULL(RE.WEIGHT,0)) AS DIFFWT' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,RE.FROMWEIGHT,RE.TOWEIGHT,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,0 STRPCS,0 STRWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,RE.PIECE TOTPCS,RE.WEIGHT AS TOTWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' FROM STKREORDER AS RE'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' LEFT OUTER JOIN ITEMTAG AS T ON T.RECDATE <='''+ @ASONDATE +''' AND (T.ISSDATE IS NULL OR T.ISSDATE >='''+ @ASONDATE +''')'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID AND T.DESIGNERID=RE.DESIGNID AND T.GRSWT BETWEEN FROMWEIGHT AND TOWEIGHT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.COMPANYID = '''+@COMPANYID +''' AND T.COSTID = RE.COSTID'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' WHERE RE.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND RE.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND ISNULL(RE.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' GROUP BY RE.DESIGNID,RE.ITEMID,RE.SUBITEMID,RE.FROMWEIGHT,RE.TOWEIGHT,RE.PIECE,RE.WEIGHT,RE.MINPIECE,LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' SELECT RE.DESIGNID,RE.ITEMID, RE.SUBITEMID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,(CONVERT(VARCHAR(100),FROMWEIGHT) + '' TO '' + CONVERT(VARCHAR(100),TOWEIGHT) + '' ['' + CONVERT(VARCHAR(100),(CONVERT(DECIMAL (15,3),(CONVERT(VARCHAR(100),((FROMWEIGHT+TOWEIGHT)/2)))))) + '']'')AS RANGE,CONVERT(INT,0)STKPCS,CONVERT(NUMERIC(15,3),0 )STKWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,0 REPCS,0 AS REWT ,(CASE WHEN RE.DESIGNID=T.DESIGNERID THEN ISNULL(SUM(T.PCS),0) ELSE 0 END ) AS  MINPIECE ,CONVERT(INT,0) AS DIFFPCS' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,CONVERT(NUMERIC(15,3),0) AS DIFFWT' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,RE.FROMWEIGHT,RE.TOWEIGHT ,CONVERT(INT,1) AS RESULT  ,CONVERT(VARCHAR(3),NULL)COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,ISNULL(SUM(T.PCS),0) STRPCS,ISNULL(SUM(T.GRSWT),0) STRWT'"
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,(CASE WHEN RE.DESIGNID=T.DESIGNERID THEN ISNULL(SUM(T.PCS),0)*(-1) ELSE 0 END) TOTPCS,(CASE WHEN RE.DESIGNID=T.DESIGNERID THEN ISNULL(SUM(T.GRSWT),0)*(-1) ELSE 0 END) AS TOTWT'"
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,0 LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' FROM STKREORDER AS RE'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' LEFT OUTER JOIN ..ITEMTAG AS T ON T.ISSDATE ='''+ @ASONDATE +''''"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.ITEMID = RE.ITEMID  AND T.SUBITEMID = RE.SUBITEMID AND T.DESIGNERID=RE.DESIGNID AND T.GRSWT BETWEEN FROMWEIGHT AND TOWEIGHT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.COMPANYID = '''+@COMPANYID +''' AND T.COSTID = RE.COSTID'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' WHERE RE.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND RE.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND ISNULL(RE.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' GROUP BY RE.DESIGNID,T.DESIGNERID,RE.ITEMID,RE.SUBITEMID,RE.FROMWEIGHT,RE.TOWEIGHT,RE.PIECE,RE.WEIGHT,RE.MINPIECE,LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' UNION ALL'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' SELECT DISTINCT 0 DESIGNID,T.ITEMID,T.SUBITEMID,''OTHER RANGE'' RANGE,SUM(T.PCS)STKPCS,SUM(T.GRSWT)STKWT,0 PIECE,0 WEIGHT,0 MINPCS,CONVERT(INT,ISNULL(SUM(T.PCS),0)- 0) AS DIFFPCS'    "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,CONVERT(NUMERIC(15,3),ISNULL(SUM(T.GRSWT),0) - 0) AS DIFFWT'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' ,0 FROMWEIGHT,0 TOWEIGHT,CONVERT(INT,2) AS RESULT,CONVERT(VARCHAR(3),NULL)COLHEAD'  "
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,0 STRPCS,0 STRWT'"
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,0 TOTPCS,0 AS TOTWT'"
        strSql += vbCrLf + "    SELECT @QRY=  @QRY+' ,0 LEADTIME'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' FROM ..ITEMTAG AS T' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' WHERE (T.GRSWT < (SELECT MIN(FROMWEIGHT) from STKREORDER AS S WHERE S.ITEMID=T.ITEMID AND  S.SUBITEMID=T.SUBITEMID)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' OR T.GRSWT > (SELECT MAX(towEIGHT) from STKREORDER AS S WHERE S.ITEMID=T.ITEMID AND S.SUBITEMID=T.SUBITEMID )) '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)' "
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' GROUP BY T.ITEMID,T.SUBITEMID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' )X GROUP BY DESIGNID,RANGE,SUBITEMID,FROMWEIGHT,TOWEIGHT,ITEMID,RESULT,COLHEAD'"
        strSql += vbCrLf + "    PRINT @QRY"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY  "
        strSql += vbCrLf + "    SET @QRY = ' IF  EXISTS (SELECT * FROM sysobjects WHERE xtype = ''U'' AND NAME = '"
        strSql += vbCrLf + "    +''''+@TEMPTBL3+''''+' ) DROP TABLE ' + @TEMPTBL3 "
        strSql += vbCrLf + "    EXECUTE sp_executesql @QRY"
        strSql += vbCrLf + "    SELECT @QRY = 'SELECT DS.DESIGNERNAME,ITEMNAME,SUBITEMNAME,RANGE,R.REORDPCS,R.REORDWT,STRPCS,STRWT,TOTPCS,TOTWT,LEADTIME,R.MINPCS,STKPCS STKPCS,STKWT,CASE WHEN ISNULL(MINPCS,0) > ISNULL(STKPCS,0) THEN ISNULL(R.REORDPCS,0)-ISNULL(STKPCS,0) ELSE 0 END DIFFPCS,'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' CONVERT(NUMERIC(12,3),0.000)  DIFFWT,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD,ITEMNAME AS ITEM,SUBITEMNAME AS SUBITEM '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' INTO '+@TEMPTBL3+' FROM '+@TEMPTBL2+' R '"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+'LEFT JOIN DESIGNER DS ON DS.DESIGNERID = R.DESIGNID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' LEFT JOIN ITEMMAST I ON I.ITEMID= R.ITEMID'"
        strSql += vbCrLf + "    SELECT @QRY = @QRY+' LEFT JOIN SUBITEMMAST ST ON ST.SUBITEMID= R.SUBITEMID'"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY "
        strSql += vbCrLf + "    SELECT @QRY ='UPDATE A SET A.DIFFWT = DIFFPCS*(REORDWT/REORDPCS) FROM '+ @TEMPTBL3+' A WHERE ISNULL(DIFFPCS,0) <> 0 AND ISNULL(REORDWT,0) <> 0 '"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY "
        strSql += vbCrLf + "    SELECT @QRY =' INSERT INTO '+@TEMPTBL3+'(ITEM,SUBITEMNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "    SELECT @QRY =@QRY+' SELECT DISTINCT ITEM,ITEM,0 RESULT,''T''COLHEAD  FROM '+@TEMPTBL3"
        strSql += vbCrLf + "    PRINT @QRY"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY "
        strSql += vbCrLf + "    SELECT @QRY ='INSERT INTO '+@TEMPTBL3+' (ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDWT,STKPCS,STKWT,DIFFPCS,DIFFWT,TOTPCS,TOTWT,MINPCS,SUBITEM)'"
        strSql += vbCrLf + "    SELECT @QRY =@QRY+' SELECT ITEM,''SUB TOTAL'',3 RESULT,''S''COLHEAD, SUM(REORDPCS),SUM(REORDWT),SUM(STKPCS),SUM(STKWT),SUM(DIFFPCS),SUM(DIFFWT),SUM(TOTPCS),SUM(TOTWT),SUM(MINPCS),''ZZ.SUB TOTAL'''"
        strSql += vbCrLf + "    SELECT @QRY =@QRY+' FROM '+@TEMPTBL3+' GROUP BY ITEM'"
        strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QRY "
        strSql += vbCrLf + "    SELECT @QRY ='INSERT INTO '+@TEMPTBL3+'(ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDWT,STKPCS,STKWT,DIFFPCS,DIFFWT,TOTPCS,TOTWT,MINPCS,SUBITEM)  '"
        strSql += vbCrLf + "    SELECT @QRY =@QRY+' Select DISTINCT ''ZZZZZZZ'',''GRAND TOTAL'',4 RESULT,''G'' COLHEAD'"
