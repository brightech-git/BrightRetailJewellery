        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''P'' THEN I.TAGGRSWT- I.GRSWT  END) PS_PLATINUM_GRSWT'"
