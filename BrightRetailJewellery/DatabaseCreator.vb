            'strSql = " INSERT INTO " & compId + suffix & "..SYNCMAST"
            'strSql += vbCrLf + "  SELECT CONVERT(VARCHAR(200),NAME) AS NAME,SYNC,FLAG FROM"
            'strSql += vbCrLf + "  ("
