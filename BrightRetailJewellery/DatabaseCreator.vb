        strSql += vbCrLf + " 	    IF @OLDWS <> @NEWWS"
        strSql += vbCrLf + " 		SET @CNG_WS = 'O:'+LTRIM(@OLDWS)+',N:'+LTRIM(@NEWWS)"

        strSql += vbCrLf + " 		IF @OLDMC <> @NEWMC "
