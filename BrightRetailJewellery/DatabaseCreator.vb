        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " 	/** POS TRANS **/ "
        strSql += vbCrLf + " 	SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPCASHBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,GRSWT,ACCODE,PAYMODE,RESULT,BATCHNO,ENTRYORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE)'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' SELECT TRANDATE,CONVERT(INT,TRANNO)AS TRANNO,ACNAME,SUM(DEBIT)DEBIT,SUM(CREDIT)CREDIT,SUM(GRSWT) GRSWT'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,ACCODE,PAYMODE,2 RESULT,CONVERT(VARCHAR(15),NULL)BATCHNO,CONVERT(INT,NULL)ENTRYORDER'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' ,REFNO,REFDATE,CHQCARDNO,CHQDATE'"
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' FROM'"
