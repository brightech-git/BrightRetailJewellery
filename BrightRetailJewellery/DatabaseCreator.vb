    Private Sub SP_RPT_STOCKFLOW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_STOCKFLOW')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_STOCKFLOW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE [dbo].[SP_RPT_STOCKFLOW]"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  @FROMDATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@TODATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@ITEMID_ORDER VARCHAR(1)"
        strSql += vbCrLf + "  ,@ITEMID VARCHAR(8000)"
        strSql += vbCrLf + "  ,@COSTID VARCHAR(8000)"
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(8000)"
        strSql += vbCrLf + "  ,@METALID VARCHAR(8000)"
        strSql += vbCrLf + "  ,@STOCKTYPE VARCHAR(1)"
        strSql += vbCrLf + "  ,@WITHSUBITEM VARCHAR(1)"
        strSql += vbCrLf + "  ,@COUNTER VARCHAR(1)"
        strSql += vbCrLf + "  ,@COUNTERID VARCHAR(8000)"
        strSql += vbCrLf + "  ,@BEADS VARCHAR(1) "
        strSql += vbCrLf + "  ,@WITHCUMSTK VARCHAR(1)"
        strSql += vbCrLf + "  ,@WITHAPP VARCHAR(1)"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  SET NOCOUNT ON"
        strSql += vbCrLf + "  EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'METALMAST',@CHK_FEILD = 'METALID',@RESULT_TBL = 'TEMPMETALMAST',@INPUTVALUES = @METALID     "
        strSql += vbCrLf + "  EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEMMAST',@INPUTVALUES = @ITEMID     "
        strSql += vbCrLf + "  EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANYID     "
        strSql += vbCrLf + "  EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID     "
        strSql += vbCrLf + "  EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMCOUNTER',@CHK_FEILD = 'ITEMCTRID',@RESULT_TBL = 'TEMPITEMCOUNTER',@INPUTVALUES = @COUNTERID     "
        strSql += vbCrLf + "  DECLARE @LEN_ITEMNAME INT"
        strSql += vbCrLf + "  DECLARE @LEN_ITEMID INT"
        strSql += vbCrLf + "  DECLARE @LEN_SUBITEMNAME INT"
        strSql += vbCrLf + "  DECLARE @LEN_SUBITEMID INT"
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "  IF @COUNTER  ='Y'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMP_FLAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_FLAG"
        strSql += vbCrLf + "  	SELECT DISTINCT ISNULL(FLAG,'') FLAG INTO TEMPTABLEDB..TEMP_FLAG FROM " & compId & "ADMINDB..ITEMNONTAG"
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE' AND CTLTEXT = 'Y') > 0"
        strSql += vbCrLf + "  	DELETE FROM TEMPTABLEDB..TEMP_FLAG WHERE FLAG = 'B'"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMTAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMTAG"
        strSql += vbCrLf + "  	SELECT *,CONVERT(VARCHAR(5),'TAG')FROMTABLE INTO TEMPTABLEDB..TEMPITEMTAG FROM " & compId & "ADMINDB..ITEMTAG AS T"
        strSql += vbCrLf + "  	WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  	AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  	AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND ISNULL(T.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND ISNULL(T.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  	IF @WITHCUMSTK ='Y'  "
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPITEMTAG"
        strSql += vbCrLf + "  		SELECT *,CONVERT(VARCHAR(5),'TAG')FROMTABLE  FROM " & compId & "ADMINDB..CITEMTAG AS T"
        strSql += vbCrLf + "  		WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  		AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  		AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  		AND ISNULL(T.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  		AND ISNULL(T.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	IF @BEADS<>'Y'  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		UPDATE IT SET GRSWT=GRSWT - REDUCTION FROM (SELECT ISNULL(SUM(CASE WHEN STONEUNIT='C' THEN STNWT/5 ELSE STNWT END),0) REDUCTION,TAGSNO FROM " & compId & "ADMINDB..ITEMTAGSTONE"
        strSql += vbCrLf + "  		WHERE (STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(BEEDS,'')='Y') OR"
        strSql += vbCrLf + "  		STNSUBITEMID IN (SELECT SUBITEMID FROM " & compId & "ADMINDB..SUBITEMMAST WHERE ISNULL(BEEDS,'')='Y')) GROUP BY TAGSNO ) ITS , TEMPTABLEDB..TEMPITEMTAG IT WHERE IT.SNO=ITS.TAGSNO"
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMNONTAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMNONTAG"
