        strSql += vbCrLf + "          	IF @ITEMIDS <> '' SET @ITEMFILTER= @ITEMFILTER + ' AND I.ITEMID IN('+@ITEMIDS+')'  "
        strSql += vbCrLf + "          	SET @QRY = ''    "
        strSql += vbCrLf + "          	SELECT @QRY=' INSERT INTO #ITEMIDS(ITEMID) SELECT ITEMID FROM ITEMMAST I WHERE '+@ITEMFILTER"
