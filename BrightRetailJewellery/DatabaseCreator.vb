        strSql += vbCrLf + "   EXEC (@QRY)"
        strSql += vbCrLf + "   EXEC SP_SPLITVALUES @CHK_DB = @ADMINDB,@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = @TB1,@INPUTVALUES = @COSTNAME       "
        strSql += vbCrLf + "   EXEC SP_SPLITVALUES @CHK_DB = @ADMINDB,@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL = @TB2,@INPUTVALUES = @CATCODE       "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPDB..#METALMAST') IS NOT NULL DROP TABLE #METALMAST CREATE TABLE #METALMAST(METALID VARCHAR(10))     "
