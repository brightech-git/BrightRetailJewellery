    Private Sub SP_DEALERSMITHBALANCE()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DEALERSMITHBALANCE')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_DEALERSMITHBALANCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "  CREATE PROCEDURE SP_DEALERSMITHBALANCE"
        strSql += vbCrLf + "    ("
        strSql += vbCrLf + "    @DBNAME VARCHAR(50)"
        strSql += vbCrLf + "    ,@TODATE VARCHAR(13)"
        strSql += vbCrLf + "    ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + "    ,@TEMPTABLE VARCHAR(50)"
        strSql += vbCrLf + "    )AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   DECLARE @QUERY NVARCHAR(4000) "
        strSql += vbCrLf + "     SELECT @QUERY =' IF OBJECT_ID(''TEMPTABLEDB..'+@TEMPTABLE+''') IS NOT NULL'"
        strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' DROP TABLE TEMPTABLEDB..'+@TEMPTABLE "

        strSql += vbCrLf + "     EXECUTE sp_executesql @QUERY "
        strSql += vbCrLf + "     SELECT @QUERY='CREATE TABLE TEMPTABLEDB..'+@TEMPTABLE+'('"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'COSTID VARCHAR(2),COMPANYID VARCHAR(3),CATCODE VARCHAR(5),METALID VARCHAR(1),ACCODE VARCHAR(7),PURITY NUMERIC(15,3),OPGRWT NUMERIC(15,3) DEFAULT 0,OPNETWT NUMERIC(15,3)  DEFAULT 0,OPPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',RGRWT NUMERIC(15,3)  DEFAULT 0,RNETWT NUMERIC(15,3)  DEFAULT 0,RPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',IGRWT NUMERIC(15,3)  DEFAULT 0,INETWT NUMERIC(15,3)  DEFAULT 0,IPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',CLGRWT NUMERIC(15,3)  DEFAULT 0,CLNETWT NUMERIC(15,3)  DEFAULT 0,ClPUREWT NUMERIC(15,3)  DEFAULT 0'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+',COLHEAD NVARCHAR(2))'"

        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY,OPGRWT,OPNETWT,OPPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT COSTID ,COMPANYID ,A.CATCODE ,B.METALID ,ACCODE,PURITY,CASE WHEN A.TRANTYPE =''R'' THEN SUM(GRSWT) ELSE SUM(GRSWT)*(-1) END, CASE WHEN A.TRANTYPE = ''R'' THEN SUM(NETWT) ELSE SUM(NETWT)*(-1) END,'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' CASE WHEN A.TRANTYPE = ''R'' THEN SUM(PUREWT) ELSE SUM(PUREWT)*(-1) END FROM '+@DBNAME+'..OPENWEIGHT A INNER JOIN CATEGORY B ON A.CATCODE = B.CATCODE '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE COMPANYID ='''+@COMPANYID +''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' AND ACCODE IN ( SELECT ACCODE FROM ACHEAD WHERE ACTYPE IN (''G'',''D''))'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY COSTID ,COMPANYID ,A.CATCODE ,B.METALID, ACCODE,A.TRANTYPE,PURITY '"
        strSql += vbCrLf + "     PRINT @QUERY "
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY,RGRWT,RNETWT,RPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY,SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)), SUM(ISNULL(PUREWT,0)) FROM '+@DBNAME+'..RECEIPT '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE <= '''+@TODATE+'''' "
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' AND ACCODE IN ( SELECT ACCODE FROM ACHEAD WHERE ACTYPE IN (''G'',''D''))  AND TRANTYPE NOT IN (''IPU'',''RPU'')'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' AND ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID ='''+@COMPANYID +''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY '"
        strSql += vbCrLf + "     PRINT @QUERY "
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY='INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'(COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY,IGRWT,INETWT,IPUREWT) '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+'SELECT COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY,SUM(ISNULL(GRSWT,0))*(-1),SUM(ISNULL(NETWT,0))*(-1), SUM(ISNULL(PUREWT,0)) *(-1)FROM '+@DBNAME+'..ISSUE'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' WHERE TRANDATE <= '''+@TODATE+''' '"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' AND ACCODE IN ( SELECT ACCODE FROM ACHEAD WHERE ACTYPE IN (''G'',''D'')) AND TRANTYPE NOT IN (''IPU'',''RPU'')'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' AND ISNULL(CANCEL,'''') <> ''Y'' AND COMPANYID ='''+@COMPANYID +''''"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' GROUP BY COSTID ,COMPANYID ,CATCODE ,METALID,ACCODE,PURITY'"
        strSql += vbCrLf + "     PRINT @QUERY "
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "     SELECT @QUERY=' UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET CLGRWT = (ISNULL(OPGRWT,0)+ISNULL(IGRWT,0))+ISNULL(RGRWT,0)'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' , CLNETWT = (ISNULL(OPNETWT,0)+ISNULL(INETWT,0))+ISNULL(RNETWT,0)'"
        strSql += vbCrLf + "     SELECT @QUERY=@QUERY+' , CLPUREWT = (ISNULL(OPPUREWT,0)+ISNULL(IPUREWT,0))+ISNULL(RPUREWT,0)'"
        strSql += vbCrLf + "     PRINT @QUERY "
        strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "   END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_DEALERSMITHTRIALBALANCE()
