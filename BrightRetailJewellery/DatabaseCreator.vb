        strSql += vbCrLf + "   DEALLOCATE RECVIEWCUR "


        strSql += vbCrLf + "   DECLARE @TOTCOSTID VARCHAR(50) "
        strSql += vbCrLf + "   DECLARE @TOTCOSTNAME VARCHAR(50)"
        strSql += vbCrLf + "   DECLARE @UPQRY1 VARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @UPQRY2 VARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE CUR CURSOR FOR    	"
        strSql += vbCrLf + "   SELECT TCOSTID ,COSTNAME FROM TEMPTABLEDB..TEMPCOSTCENTREWISERECEIPT GROUP BY TCOSTID,COSTNAME"
        strSql += vbCrLf + "   OPEN CUR"
        strSql += vbCrLf + "   FETCH NEXT FROM CUR INTO @TOTCOSTID,@TOTCOSTNAME"
        strSql += vbCrLf + "   SELECT @UPQRY1='INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COSTCENTREWISERECEIPTVIEW (ITEMNAME'"
        strSql += vbCrLf + "   SELECT @UPQRY2 ='SELECT ''TOTAL'' ITEMNAME'	"
        strSql += vbCrLf + "   WHILE @@FETCH_STATUS<>-1"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SELECT @UPQRY1=@UPQRY1+','+@TOTCOSTID+'_PCS'"
        strSql += vbCrLf + "   SELECT @UPQRY1=@UPQRY1+','+@TOTCOSTID+'_GRSWT'"
        strSql += vbCrLf + "   SELECT @UPQRY1=@UPQRY1+','+@TOTCOSTID+'_NETWT'"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+',SUM(ISNULL('+@TOTCOSTID+'_PCS,0))'"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+',SUM(ISNULL('+@TOTCOSTID+'_GRSWT,0))'"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+',SUM(ISNULL('+@TOTCOSTID+'_NETWT,0))'"
        strSql += vbCrLf + "   FETCH NEXT FROM CUR INTO @TOTCOSTID,@TOTCOSTNAME"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   SELECT @UPQRY1=@UPQRY1+',TOTPCS,TOTGRSWT,TOTNETWT,RESULT)'"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+' ,SUM(ISNULL(TOTPCS,0))TOTPCS,SUM(ISNULL(TOTGRSWT,0))TOTGRSWT,'"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+' SUM(ISNULL(TOTNETWT,0))TOTNETWT ,1 AS RESULT  '"
        strSql += vbCrLf + "   SELECT @UPQRY2=@UPQRY2+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COSTCENTREWISERECEIPTVIEW   '"
        strSql += vbCrLf + "   PRINT @UPQRY1"
        strSql += vbCrLf + "   PRINT @UPQRY2"
        strSql += vbCrLf + "   EXEC (@UPQRY1+@UPQRY2)"
        strSql += vbCrLf + "   Close CUR"
        strSql += vbCrLf + "   DEALLOCATE CUR"
        strSql += vbCrLf + "   SELECT @STR = 'SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COSTCENTREWISERECEIPTVIEW ORDER BY RESULT '"
        strSql += vbCrLf + "   PRINT @STR"
        strSql += vbCrLf + "   EXEC SP_EXECUTESQL @STR "
        strSql += vbCrLf + "   END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_OrderDetails()
        strSql = vbCrLf + "IF OBJECT_ID('SP_ORDERDETILS','P')IS NOT NULL "
        strSql += vbCrLf + " DROP PROC SP_ORDERDETILS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE SP_ORDERDETILS"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   @DBNAME VARCHAR(15),"
        strSql += vbCrLf + "   @ORNO VARCHAR(25), @ORSNO VARCHAR(25) "
        strSql += vbCrLf + "   )"
        strSql += vbCrLf + "   AS "
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPORDETAILS','U') IS NOT NULL DROP TABLE MASTER..TEMPORDETAILS"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPORDERITEM','U') IS NOT NULL DROP TABLE MASTER..TEMPORDERITEM"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPORDETAILSTOT','U') IS NOT NULL DROP TABLE MASTER..TEMPORDETAILSTOT"

        strSql += vbCrLf + "   	SELECT @QRY=' SELECT *INTO MASTER..TEMPORDETAILS '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'FROM ('"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'SELECT I.ITEMNAME,SUM(O.GRSWT)GRSWT,SUM(ORS.STNWT)LESSWT,SUM(NETWT-ORS.STNWT)NETWT,O.RATE,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'CONVERT(NUMERIC(15,2),SUM(NETWT*RATE))GOLDVALUE'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',SUM(NETWT-ORS.STNWT)MC,SUM(MCGRM)MCGRM,CONVERT(NUMERIC(15,2),SUM((NETWT-ORS.STNWT)*MCGRM))TOTMC'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',ORNO FROM ORMAST O '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN ITEMMAST I ON I.ITEMID=O.ITEMID'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN ORSTONE ORS ON O.SNO =ORS.ORSNO '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'WHERE ORNO ='''+ @ORNO +'''AND  O.SNO ='''+ @ORSNO  +''' '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'GROUP BY RATE ,ITEMNAME,ORNO'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'UNION ALL'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'SELECT (SELECT ITEMNAME  FROM ITEMMAST WHERE ITEMID=ORS .STNITEMID )PARTICULAR,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'NULL AS GRSWT,NULL LESSWT,SUM(ORS.STNWT)NETWT ,ORS.STNRATE,ORS.STNAMT,NULL MC'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',NULL MCGRM,NULL AS TOTMC,ORNO'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'FROM ORMAST O '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN ORSTONE ORS ON O.SNO =ORS.ORSNO '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'WHERE ORNO ='''+ @ORNO +''' AND  O.SNO ='''+ @ORSNO  +''''"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'GROUP BY STNITEMID ,ORS.STNRATE ,ORS.STNAMT,ORNO'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+')X'"
        strSql += vbCrLf + "   	PRINT(@QRY)"
        strSql += vbCrLf + "   	EXEC(@QRY)"
        strSql += vbCrLf + "   	SELECT @QRY='	SELECT  IM.ITEMNAME ,SM.SUBITEMNAME ,IT.NAME ,SUBSTRING(ORNO,6,15)ORDERNO,ORDATE, O.PICTFILE, ORNO,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT PNAME FROM PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM CUSTOMERINFO WHERE BATCHNO = O.BATCHNO))AS CUSTOMER,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT MOBILE FROM PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM CUSTOMERINFO WHERE BATCHNO = O.BATCHNO))AS MOBILE'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+',(SELECT EMPNAME FROM EMPMASTER WHERE EMPID=O.EMPID)  EMPNAME ,SIZENO,O.SNO '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' INTO MASTER..TEMPORDERITEM FROM ORMAST O'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN  ITEMMAST IM ON O.ITEMID=IM.ITEMID '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN SUBITEMMAST SM ON O.SUBITEMID =SM.SUBITEMID' "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'LEFT JOIN ITEMTYPE IT ON O.ITEMTYPEID =IT.ITEMTYPEID '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'WHERE ORNO ='''+  @ORNO +''' AND  O.SNO ='''+ @ORSNO  +''''"
        strSql += vbCrLf + "   	PRINT(@QRY)"
        strSql += vbCrLf + "   	EXEC(@QRY)"

        strSql += vbCrLf + "   	SELECT @QRY='	SELECT ISNULL(SUM(TOTMC)+SUM(GOLDVALUE),0)TOTAL INTO MASTER..TEMPORDETAILSTOT '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' FROM MASTER..TEMPORDETAILS'"
        strSql += vbCrLf + "   	PRINT(@QRY)"
        strSql += vbCrLf + "   	EXEC(@QRY)"

        strSql += vbCrLf + "   	SELECT @QRY='	ALTER TABLE MASTER..TEMPORDERITEM  ADD ORIMAGE IMAGE'"
        strSql += vbCrLf + "   	PRINT(@QRY)"
        strSql += vbCrLf + "   	EXEC(@QRY)"

        strSql += vbCrLf + "   	SELECT @QRY='SELECT * FROM MASTER..TEMPORDETAILS'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'SELECT * FROM MASTER..TEMPORDERITEM'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'SELECT * FROM MASTER..TEMPORDETAILSTOT'"
        strSql += vbCrLf + "   	PRINT(@QRY)"
        strSql += vbCrLf + "   	EXEC(@QRY)"

        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
