        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "END /** PROC ENDS **/  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP20_AbstractReport_NEW()
        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ABSTRACT_SASRPU_NEW')>0"
