        strSql += vbCrLf + "  	  				SELECT @QRY= @QRY + CHAR(13) +',(SELECT TOP 1 REMARK1 FROM '+@ADMINDB+'..CUSTOMERINFO WHERE BATCHNO=I.BATCHNO) REMARK' "
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'INTO TEMPTABLEDB..'+@TEMPTABLE+' FROM ISSUE AS I'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'INNER JOIN '+@ADMINDB+'..ITEMMAST AS IM ON IM.ITEMID=I.ITEMID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'LEFT JOIN '+@ADMINDB+'..SUBITEMMAST AS SI ON SI.SUBITEMID=I.SUBITEMID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'INNER JOIN '+@ADMINDB+'..METALMAST AS M ON M.METALID=I.METALID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'INNER JOIN '+@ADMINDB+'..EMPMASTER AS E ON E.EMPID=I.EMPID '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'LEFT JOIN '+@ADMINDB+'..EMPMASTER AS E1 ON E1.EMPID=I.DISC_EMPID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'WHERE I.TRANDATE BETWEEN  '''+@FROMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'AND I.COMPANYID IN('''+@COMPANYID+''')'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'AND ISNULL(I.CANCEL,'''')='''''"
        strSql += vbCrLf + "  	  		  		IF @COSTID<>'ALL'"
        strSql += vbCrLf + "  	  		  		BEGIN"
        strSql += vbCrLf + "  	  		  			SELECT @QRY= @QRY + CHAR(13) +'AND I.COSTID IN('''+@COSTID+''')'"
        strSql += vbCrLf + "  	  		  		END"
        strSql += vbCrLf + "  	  		  	    IF @METALID<>'ALL'"
        strSql += vbCrLf + "  	  		  		BEGIN"
        strSql += vbCrLf + "  	  		  			SELECT @QRY= @QRY + CHAR(13) +' AND I.METALID IN('''+@METALID+''') '"
        strSql += vbCrLf + "  	  		  		END 	  		  		"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MAXWASTPER =W.MAXWASTPER,MAXMCGRM=W.MAXMCGRM , MAXWAST =W.MAXWAST, MAXMC =W.MAXMC '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'FROM '+@ADMINDB+'..ITEMTAG  W,TEMPTABLEDB..'+@TEMPTABLE+' T'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'WHERE W.TAGNO = T.TAGNO AND T.STOCKTYPE =''T'' AND  T.MAXWASTPER IS NULL'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MAXWASTPER =W.WASTPER,MAXMCGRM=W.MCPERGRM , MAXWAST =W.WASTAGE , MAXMC =W.MC  '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'FROM '+@ADMINDB+'..ITEMNONTAG  W,TEMPTABLEDB..'+@TEMPTABLE+' T'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'WHERE W.ITEMID  = T.ITEMID  AND T.STOCKTYPE =''N'' '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'AND T.SUBITEMID = W.SUBITEMID AND T.TAGDESIGNER =W.DESIGNERID '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'AND T.ITEMCTRID = W.ITEMCTRID AND W.RECISS =''R'''"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET WASTAGE = GRSWT * MAXWASTPER / 100 WHERE ISNULL(MAXWASTPER,0)>0'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET WASTAGE = MAXWAST WHERE ISNULL(MAXWAST,0)>0 AND ISNULL(WASTAGE,0)=0'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		DECLARE @MCWITHWASTAGE VARCHAR(1); "
        strSql += vbCrLf + "  	  		  		SELECT @MCWITHWASTAGE=CASE WHEN ISNULL(CTLTEXT,'N') <>'' THEN ISNULL(CTLTEXT,'N')  ELSE 'N' END  FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'MCWITHWASTAGE'"
        strSql += vbCrLf + "  	  		  		IF  @MCWITHWASTAGE='Y' "
        strSql += vbCrLf + "  	  		  		BEGIN"
        strSql += vbCrLf + "  	  		   			SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MC = (GRSWT +WASTAGE) * MAXMCGRM * PCS  WHERE ISNULL(MAXMCGRM,0)>0'"
        strSql += vbCrLf + "  	  		   			EXEC (@QRY)"
        strSql += vbCrLf + "  	  		   		END"
        strSql += vbCrLf + "  	  		  		ELSE"
        strSql += vbCrLf + "  	  		  		BEGIN"
        strSql += vbCrLf + "  	  		   			SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MC = GRSWT  * MAXMCGRM * PCS  WHERE ISNULL(MAXMCGRM,0)>0'"
        strSql += vbCrLf + "  	  		   			EXEC (@QRY)"
        strSql += vbCrLf + "  	  		   		END"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MC = MAXMC * PCS  WHERE ISNULL(MAXMC,0)>0 AND ISNULL(MC,0)=0'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET WASTAGE =0 WHERE MAXWASTPER=0 AND MAXWAST=0 AND WASTAGE IS NULL'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET MC =0 WHERE MAXMCGRM=0 AND MAXMC=0 AND MC IS NULL'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET STNAMT = I.STNAMT FROM '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'(SELECT SUM(STNAMT)STNAMT,ISSSNO  FROM ISSSTONE GROUP BY ISSSNO) I'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +',TEMPTABLEDB..'+@TEMPTABLE+' T WHERE I.ISSSNO =T.SNO '"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE TEMPTABLEDB..'+@TEMPTABLE+' SET TAGVALUE = (ISNULL(GRSWT,0)+ISNULL(WASTAGE,0))*ISNULL(RATE,0) + ISNULL(MC ,0) +ISNULL(STNAMT,0)	'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN RATE'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN ITEMID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN SUBITEMID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN METAL'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN STNAMT'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN TAGDESIGNER'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN ITEMCTRID'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN STOCKTYPE'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN MAXWAST'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN MC'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN WASTAGE'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN MAXWASTPER'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN MAXMCGRM'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN MAXMC'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'ALTER TABLE TEMPTABLEDB..'+@TEMPTABLE+' DROP COLUMN SNO'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= 'IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMP'+@TEMPTABLE+''' )DROP TABLE TEMPTABLEDB..TEMP'+@TEMPTABLE+' '"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'SELECT BILLNO,BILLDATE,TAGNO,ITEMNAME,SUBITEMNAME'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(TAGVALUE)TAGVALUE'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,SUM(AMOUNT)AMOUNT'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,CONVERT(NUMERIC(20,2),((SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' AND PAYMODE=''DI'' AND TRANMODE=''D'')'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' /(SELECT CASE WHEN COUNT(*)=0 THEN 1 ELSE COUNT(*) END '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' FROM ISSUE WHERE BATCHNO=I.BATCHNO))) DISCOUNT'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,SUM(DISCOUNT) AS OFFERDISC,SUM(FIN_DISCOUNT) AS FINALDISC,CONVERT(NUMERIC(20,2),NULL)TOTALDISC'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,CONVERT(NUMERIC(20,2),NULL)DISCPER'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,SALESMAN,AUTHORIZE,REMARK,BATCHNO,COLHEAD,RESULT'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' INTO TEMPTABLEDB..TEMP'+@TEMPTABLE+''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' FROM TEMPTABLEDB..'+@TEMPTABLE+' I '"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' GROUP BY BILLNO,BILLDATE,TAGNO,ITEMNAME,SUBITEMNAME,SALESMAN'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +' ,AUTHORIZE,COLHEAD,RESULT,BATCHNO,REMARK'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'INSERT INTO TEMPTABLEDB..TEMP'+@TEMPTABLE+''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'(TAGNO,PCS,GRSWT,NETWT,TAGVALUE,AMOUNT,DISCOUNT,OFFERDISC,FINALDISC,RESULT,COLHEAD,BATCHNO)'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'SELECT '' '''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(TAGVALUE),SUM(AMOUNT),SUM(DISCOUNT),SUM(OFFERDISC),SUM(FINALDISC)'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +',2,''S'',BATCHNO'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'FROM TEMPTABLEDB..TEMP'+@TEMPTABLE+' GROUP BY BATCHNO /*HAVING COUNT(BATCHNO)>1*/'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'INSERT INTO TEMPTABLEDB..TEMP'+@TEMPTABLE+''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'(TAGNO,PCS,GRSWT,NETWT,TAGVALUE,AMOUNT,DISCOUNT,OFFERDISC,FINALDISC,RESULT,COLHEAD,BATCHNO)'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'SELECT ''TOTAL'''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(TAGVALUE),SUM(AMOUNT),SUM(DISCOUNT),SUM(OFFERDISC),SUM(FINALDISC)'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +',3,''G'',''ZZZZZ99999999'''"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY + CHAR(13) +'FROM TEMPTABLEDB..TEMP'+@TEMPTABLE+' WHERE RESULT=1'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET TOTALDISC=(ISNULL(OFFERDISC,0)+ISNULL(FINALDISC,0)+ISNULL(DISCOUNT,0))'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET DISCPER=(TOTALDISC*100)/CASE WHEN AMOUNT=0 THEN 1 ELSE AMOUNT END'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET TOTALDISC=NULL WHERE TOTALDISC=0'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY+CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET DISCPER=NULL WHERE DISCPER=0'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY+CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET DISCOUNT=NULL WHERE DISCOUNT=0'"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= @QRY+CHAR(13) +'UPDATE  TEMPTABLEDB..TEMP'+@TEMPTABLE+' SET FINALDISC=NULL WHERE FINALDISC=0'"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  		SELECT @QRY= CHAR(13) +'SELECT * FROM  TEMPTABLEDB..TEMP'+@TEMPTABLE+' ORDER BY CONVERT(INT,SUBSTRING(BATCHNO,6,20)),RESULT '"
        strSql += vbCrLf + "  	  		  		PRINT @QRY"
        strSql += vbCrLf + "  	  		  		EXEC (@QRY)"
        strSql += vbCrLf + "  	  		  	END"
        strSql += vbCrLf + "  	  		   END"
        strSql += vbCrLf + "  	  		   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub PROC_DISCOUNT_FORMAT3()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'PROC_DISCOUNT_FORMAT3')>0"
        strSql += vbCrLf + "  DROP PROCEDURE PROC_DISCOUNT_FORMAT3"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE PROC_DISCOUNT_FORMAT3"
        strSql += vbCrLf + "  	  		   ("
        strSql += vbCrLf + "  	  		    @ADMINDB VARCHAR(15),"
        strSql += vbCrLf + "  	  		    @DBNAME VARCHAR(15),"
        strSql += vbCrLf + "  	  		    @FROMDATE VARCHAR(30),"
        strSql += vbCrLf + "  	  		    @TODATE VARCHAR(30),"
        strSql += vbCrLf + "  	  		    @COMPANYID VARCHAR(500),"
        strSql += vbCrLf + "  	  		    @TEMPTABLE VARCHAR(50),"
        strSql += vbCrLf + "  	  		    @COSTID VARCHAR(500),"
        strSql += vbCrLf + "  	  		    @METALID VARCHAR(500), 	  		    "
        strSql += vbCrLf + "  	  		    @GROUPBY VARCHAR(1)  	  	"
        strSql += vbCrLf + "  	  		    )"
        strSql += vbCrLf + "  	  		    AS "
        strSql += vbCrLf + "  	  		    BEGIN"
        strSql += vbCrLf + "  	  		  		DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "  	  		  		SET @COSTID = REPLACE(@COSTID,',',''',''')"
        strSql += vbCrLf + "  	  		  		SET @METALID = REPLACE(@METALID,',',''',''')"
        strSql += vbCrLf + "  	  		  		SET @COMPANYID = ''+REPLACE(@COMPANYID,',',''',''')+'' "
        strSql += vbCrLf + "  	  		  		  SELECT @QRY= 'IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPDISCOUNTSPF3'' )DROP TABLE TEMPTABLEDB..TEMPDISCOUNTSPF3'"
        strSql += vbCrLf + "  	  				  EXEC (@QRY)"
        strSql += vbCrLf + "  	  				  SELECT @QRY= 'IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '''+@TEMPTABLE+''' )DROP TABLE TEMPTABLEDB..'+@TEMPTABLE+''"
        strSql += vbCrLf + "  	  				  EXEC (@QRY)"
        strSql += vbCrLf + "  	  				  SELECT @QRY= 'SELECT CONVERT(VARCHAR(20),TRANNO)TRANNO,CONVERT(VARCHAR,TRANDATE,105)BILLDATE'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,(SELECT METALNAME FROM '+@ADMINDB+'..METALMAST WHERE METALID=X.METALID)METAL'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,ITEM, FIN_DISCOUNT,AMOUNT,WT,RATE,WASTPER,CONVERT(NUMERIC(20,2),((WASTPER*WT)/100)*RATE) AS WAST,ROUNDOFF AS RND'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,CONVERT(NUMERIC(20,2),((ROUNDOFF*WT)/100)*RATE) AS ROUNDOFF,MCPER'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,CONVERT(NUMERIC(20,2),(MCHARGE*MCPER)/100) AS MC '"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,CONVERT(NUMERIC(20,2),((WASTPER*WT)/100)*RATE) '"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' +CONVERT(NUMERIC(20,2),((ROUNDOFF*WT)/100)*RATE) '"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' +CONVERT(NUMERIC(20,2),(MCHARGE*MCPER)/100) AS TOTALDISC '"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,(SELECT TOP 1 DISCLIMITAMT FROM DISCHISTORY WHERE BATCHNO=X.BATCHNO)DISCLIMIT'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,(SELECT TOP 1 DISCALLOWAMT FROM DISCHISTORY WHERE BATCHNO=X.BATCHNO)DISCALLOW'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=X.BATCHNO AND PAYMODE=''SS'')SCHEMEAMT'"
        strSql += vbCrLf + " 				  SELECT @QRY= @QRY + CHAR(13) +' ,BATCHNO,''N''UPDATED'"
