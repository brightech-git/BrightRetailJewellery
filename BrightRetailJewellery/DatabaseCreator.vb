        'strSql += vbCrLf + " DECLARE @BALWEIGHT NUMERIC(15,2),@ISSUE NUMERIC(15,3),@RECEIPT NUMERIC(15,3),@BALAMOUNT NUMERIC(15,2),@CREDIT NUMERIC(15,2),@DEBIT NUMERIC(15,2) ,@AMOUNT NUMERIC(15,2),@PUREWT NUMERIC(15,2)   "
