        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' ,SUM(I.AMOUNT)AS AMOUNT,SUM(I.TAX)TAX,SUM(I.AMOUNT + ISNULL(I.TAX,0)) AS TOTAL,P.ACCODE AS ACCODE'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' ,P.PNAME AS CUSTOMER,I.TRANNO,I.BATCHNO' "
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(2),NULL)COLHEAD'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' FROM ISSUE AS I'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN '+@DBNAME+'..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN '+@DBNAME+'..PERSONALINFO AS P ON P.SNO = C.PSNO'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN TEMPTABLEDB..TEMPOUTSTANDING AS O ON O.BATCHNO = I.BATCHNO AND O.TRANTYPE = ''D'' AND RECPAY = ''P'''"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND I.TRANTYPE IN (''MI'')'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.CASHID,'''') IN (SELECT CASHID FROM TEMPTABLEDB..TEMPCASHCOUNTER)'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.SYSTEMID,'''') IN (SELECT SYSTEMID FROM TEMPTABLEDB..TEMPSYSTEM)'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.CANCEL,'''') = '''''"
        strSql += vbCrLf + "      SELECT @QRY = @QRY + CHAR(13) +' GROUP BY I.TRANNO,P.PNAME,I.BATCHNO,O.TRANTYPE,I.TRANTYPE,P.ACCODE'"
        strSql += vbCrLf + "      PRINT @QRY"
        strSql += vbCrLf + "      EXEC (@QRY)"
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + "  SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMPTRANDET SET PCS = NULL WHERE PCS = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET GRSWT = NULL WHERE GRSWT = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET NETWT = NULL WHERE NETWT = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET AMOUNT = NULL WHERE AMOUNT = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET TAX = NULL WHERE TAX = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET TOTAL = NULL WHERE TOTAL = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET CASH = NULL WHERE CASH = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [ROUND OFF] = NULL WHERE [ROUND OFF] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [CREDIT CARD] = NULL WHERE [CREDIT CARD] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [CREDIT] = NULL WHERE [CREDIT] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [ADVANCE ADJ] = NULL WHERE [ADVANCE ADJ] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET CHEQUE = NULL WHERE CHEQUE = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [CHIT CARD] = NULL WHERE [CHIT CARD] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET [GIFT VOUCHER] = NULL WHERE [GIFT VOUCHER] = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET DISCOUNT = NULL WHERE DISCOUNT = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET HANDLING = NULL WHERE HANDLING = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET PURCHASE = NULL WHERE PURCHASE = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET SRETURN = NULL WHERE SRETURN = 0'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET SET TOT = NULL WHERE TOT = 0'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC (@QRY)           "
        strSql += vbCrLf + "  SELECT @QRY = ' SELECT * FROM TEMPTABLEDB..TEMPTRANDET ORDER BY KEYNO'"
        strSql += vbCrLf + "  EXEC (@QRY)"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub funcSP25_W_SmithLedger()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_PROC_W_SMITHLEDGER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_PROC_W_SMITHLEDGER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'WJEWELADMINDB'"
        Dim WAdmindb As String = GetSqlValue(strSql, , tran)
        If WAdmindb = "" Then WAdmindb = cnAdminDb Else WAdmindb += "ADMINDB"

        strSql = vbCrLf + "  CREATE  PROCEDURE SP_PROC_W_SMITHLEDGER     "
        strSql += vbCrLf + "       (     "
        strSql += vbCrLf + "       @FROMDATE SMALLDATETIME     "
        strSql += vbCrLf + "       ,@TODATE SMALLDATETIME     "
        strSql += vbCrLf + "       ,@ACNAME VARCHAR(55)"
        strSql += vbCrLf + "       ,@WTYPE varchar(1)  "
        strSql += vbCrLf + "       ,@METALID VARCHAR(5)  "
        strSql += vbCrLf + "       )     "
        strSql += vbCrLf + "       AS     "
        strSql += vbCrLf + "       /**DECLARE @FROMDATE SMALLDATETIME     "
        strSql += vbCrLf + "       DECLARE @TODATE SMALLDATETIME     "
        strSql += vbCrLf + "       SELECT @FROMDATE = '2010-07-08'     "
        strSql += vbCrLf + "       SELECT @TODATE = '2010-08-10'**/     "
        strSql += vbCrLf + "       DECLARE @ACCODE VARCHAR(7)     "
        strSql += vbCrLf + "       SELECT @ACCODE = ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACNAME = @ACNAME /**'ACH_AKBAR'**/     "
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSMITHLEDGER') > 0 DROP TABLE MASTER..TEMPSMITHLEDGER     "
        strSql += vbCrLf + "       CREATE TABLE MASTER..TEMPSMITHLEDGER     "
        strSql += vbCrLf + "       (     "
        strSql += vbCrLf + "       TYPE VARCHAR(1),TRANNO INT,TRANDATE SMALLDATETIME     "
        strSql += vbCrLf + "       ,PARTICULAR VARCHAR(200),CATEGORY VARCHAR(200)     "
        strSql += vbCrLf + "       ,PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),WASTAGE NUMERIC(15,2),TOUCH NUMERIC(15,3),PUREWT NUMERIC(15,3),AMOUNT NUMERIC(15,2)     "
        strSql += vbCrLf + "       ,BALWEIGHT NUMERIC(15,3),BALAMOUNT NUMERIC(15,2),REMARK1 varchar(50),REMARK2 varchar(50)     "
        strSql += vbCrLf + "       ,FLAG VARCHAR(3)     "
        strSql += vbCrLf + "       ,RESULT INT DEFAULT 2  ,COLHEAD VARCHAR(5)     "
        strSql += vbCrLf + "       )     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSMITHLEDGER (PARTICULAR,BALWEIGHT,BALAMOUNT,RESULT)     "
        strSql += vbCrLf + "       SELECT 'OPENING..',SUM(PUREWT)BALWEIGHT,SUM(AMOUNT)BALAMOUNT,1 RESULT FROM     "
        strSql += vbCrLf + "       (     "
        strSql += vbCrLf + "       SELECT CREDITWT-DEBITWT PUREWT,CREDIT-DEBIT AMOUNT FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE = @ACCODE     "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT CASE WHEN TRANTYPE = 'R' THEN PUREWT ELSE -1*PUREWT END AS PUREWT,CONVERT(NUMERIC(15,2),0)AMOUNT     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..OPENWEIGHT WHERE ACCODE = @ACCODE     "
        strSql += vbCrLf + "       AND CATCODE IN (SELECT CATCODE FROM " & WAdmindb & "..CATEGORY WHERE PURITYID <> '' AND METALID =''+ @METALID   +'')   "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT -1*PUREWT,0 AMOUNT FROM " & tranDbName & "..W_ISSUE I WHERE TRANDATE < @FROMDATE AND ACCODE = @ACCODE     "
        strSql += vbCrLf + "       AND ISNULL(CANCEL,'') = ''     "
        strSql += vbCrLf + "       AND I.CATCODE IN (SELECT CATCODE FROM " & WAdmindb & "..CATEGORY WHERE PURITYID <> '' AND METALID =''+ @METALID   +'')   "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT PUREWT,0 AMOUNT     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_RECEIPT I WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'') = ''  AND ACCODE = @ACCODE     "
        strSql += vbCrLf + "       AND I.CATCODE IN (SELECT CATCODE FROM " & WAdmindb & "..CATEGORY WHERE PURITYID <> '' AND METALID =''+ @METALID   +'')   "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT 0 PUREWT,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_ACCTRAN WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'') = ''  AND ACCODE = @ACCODE     "
        strSql += vbCrLf + "       )X HAVING SUM(PUREWT) <> 0 OR SUM(AMOUNT) <> 0     "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSMITHLEDGER(TYPE,FLAG,TRANNO,TRANDATE,CATEGORY,PCS,GRSWT,NETWT,WASTAGE,TOUCH,PUREWT,PARTICULAR,REMARK1,REMARK2)     "
        strSql += vbCrLf + "       SELECT 'I'TYPE,I.TRANFLAG,I.TRANNO,I.TRANDATE,CA.CATNAME,I.PCS,I.GRSWT,I.NETWT,I.WASTAGE,I.TOUCH,I.PUREWT     "
        strSql += vbCrLf + "       ,CASE WHEN I.SUBITEMID <> 0 THEN SM.SUBITEMNAME WHEN I.ITEMID <> 0 THEN IM.ITEMNAME      "
        strSql += vbCrLf + "       ELSE CA.CATNAME END AS PARTICULAR ,I.REMARK1,I.REMARK2    "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_ISSUE I     "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID   "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..SUBITEMMAST AS SM ON SM.SUBITEMID = I.SUBITEMID AND SM.ITEMID = I.ITEMID     "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..CATEGORY AS CA ON CA.CATCODE = I.CATCODE   "
        strSql += vbCrLf + "       WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' AND ACCODE = @ACCODE     "
        strSql += vbCrLf + "       AND CA.METALID=''+ @METALID +''  "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT 'R'TYPE,TRANFLAG,TRANNO,TRANDATE,CA.CATNAME,PCS,I.GRSWT,NETWT,I.WASTAGE,TOUCH,PUREWT     "
        strSql += vbCrLf + "       ,CASE WHEN I.SUBITEMID <> 0 THEN SM.SUBITEMNAME WHEN I.ITEMID <> 0 THEN IM.ITEMNAME     "
        strSql += vbCrLf + "       ELSE CA.CATNAME END AS PARTICULAR ,I.REMARK1,I.REMARK2     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_RECEIPT I      "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID   "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..SUBITEMMAST AS SM ON SM.SUBITEMID = I.SUBITEMID AND SM.ITEMID = I.ITEMID     "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..CATEGORY AS CA ON CA.CATCODE = I.CATCODE --AND CA.METALID=''+@METALID+''  "
        strSql += vbCrLf + "       WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' AND ACCODE = @ACCODE     "
        strSql += vbCrLf + "       AND CA.METALID=''+@METALID  +''  "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPSMITHLEDGER(TYPE,FLAG,TRANNO,TRANDATE,AMOUNT,PARTICULAR)     "
        strSql += vbCrLf + "       SELECT 'I'TYPE,TRANFLAG,TRANNO,TRANDATE,AMOUNT,H.ACNAME     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_ACCTRAN AS T     "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..ACHEAD AS H ON H.ACCODE = T.CONTRA     "
        strSql += vbCrLf + "       WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' AND T.ACCODE = @ACCODE AND TRANMODE = 'D'     "
        strSql += vbCrLf + "       UNION ALL     "
        strSql += vbCrLf + "       SELECT 'R'TYPE,TRANFLAG,TRANNO,TRANDATE,AMOUNT,H.ACNAME     "
        strSql += vbCrLf + "       FROM " & tranDbName & "..W_ACCTRAN T     "
        strSql += vbCrLf + "       LEFT OUTER JOIN " & WAdmindb & "..ACHEAD AS H ON H.ACCODE = T.CONTRA     "
        strSql += vbCrLf + "       WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' AND T.ACCODE = @ACCODE AND TRANMODE = 'C'     "
        strSql += vbCrLf + "       IF @Wtype='I'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "      DELETE FROM MASTER..TEMPSMITHLEDGER WHERE TYPE <> 'I'"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "       ELSE IF @WTYPE='R'"
        strSql += vbCrLf + "   BEGIN "
        strSql += vbCrLf + "      DELETE FROM MASTER..TEMPSMITHLEDGER WHERE TYPE <> 'R'"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "       IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSMITHLEDGER_RES')>0 DROP TABLE MASTER..TEMPSMITHLEDGER_RES     "
        strSql += vbCrLf + "       SELECT * INTO MASTER..TEMPSMITHLEDGER_RES FROM MASTER..TEMPSMITHLEDGER ORDER BY RESULT,TRANDATE,TRANNO   "
        strSql += vbCrLf + "       DECLARE @BALWEIGHT NUMERIC(15,2),@PUREWT NUMERIC(15,3),@BALAMOUNT NUMERIC(15,2),@AMOUNT NUMERIC(15,2)     "
        strSql += vbCrLf + "       DECLARE @RWT NUMERIC(15,3),@RAMT NUMERIC(15,2)     "
        strSql += vbCrLf + "       SELECT @BALWEIGHT = 0     "
        strSql += vbCrLf + "       SELECT @BALAMOUNT = 0     "
        strSql += vbCrLf + "       SELECT @RWT = 0     "
        strSql += vbCrLf + "       SELECT @RAMT = 0     "
        strSql += vbCrLf + "       DECLARE CUR CURSOR     "
        strSql += vbCrLf + "       FOR SELECT CASE WHEN ISNULL(TYPE,'') = 'R' THEN PUREWT ELSE -1*PUREWT END PUREWT,CASE WHEN ISNULL(TYPE,'') = 'R' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT,BALWEIGHT,BALAMOUNT FROM MASTER..TEMPSMITHLEDGER_RES     "
        strSql += vbCrLf + "       OPEN CUR     "
        strSql += vbCrLf + "       WHILE 1=1     "
        strSql += vbCrLf + "       BEGIN     "
        strSql += vbCrLf + "       FETCH NEXT FROM CUR INTO @PUREWT,@AMOUNT,@BALWEIGHT,@BALAMOUNT     "
        strSql += vbCrLf + "       SET NOCOUNT ON     "
        strSql += vbCrLf + "       IF @@FETCH_STATUS = -1 BREAK     "
        strSql += vbCrLf + "       SET @RAMT = ISNULL(@RAMT,0) + ISNULL(@BALAMOUNT,0) + ISNULL(@AMOUNT,0)     "
        strSql += vbCrLf + "       SET @RWT = ISNULL(@RWT,0) + ISNULL(@BALWEIGHT,0) + ISNULL(@PUREWT,0)     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET BALWEIGHT =@RWT,BALAMOUNT = @RAMT WHERE CURRENT OF CUR     "
        strSql += vbCrLf + "       END     "
        strSql += vbCrLf + "       CLOSE CUR     "
        strSql += vbCrLf + "       DEALLOCATE CUR     "
        strSql += vbCrLf + "       IF(SELECT COUNT(*) FROM MASTER..TEMPSMITHLEDGER_RES   )>1    "
        strSql += vbCrLf + "     INSERT INTO MASTER..TEMPSMITHLEDGER_RES(PARTICULAR,GRSWT,NETWT,PUREWT,RESULT,COLHEAD,BALWEIGHT,BALAMOUNT)    "
        strSql += vbCrLf + "     SELECT 'TOTAL -->' PARTICULAR,SUM(ISNULL(GRSWT,0)) GRSWT,SUM(ISNULL(NETWT,0)) NETWT,SUM(ISNULL(PUREWT,0))PUREWT,3 RESULT,     "
        strSql += vbCrLf + "     'G' COLHEAD,(SELECT TOP 1 BALWEIGHT FROM MASTER..TEMPSMITHLEDGER_RES WHERE RESULT=2 ORDER BY TRANDATE DESC,TRANNO DESC)  "
        strSql += vbCrLf + "     ,(SELECT TOP 1 BALAMOUNT FROM MASTER..TEMPSMITHLEDGER_RES WHERE RESULT=2 ORDER BY TRANDATE DESC,TRANNO DESC)  "
        strSql += vbCrLf + "     FROM  MASTER..TEMPSMITHLEDGER_RES    "
        strSql += vbCrLf + "     WHERE RESULT=2          "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET PCS = NULL WHERE PCS = 0     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET GRSWT = NULL WHERE GRSWT = 0     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET NETWT = NULL WHERE NETWT = 0     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET TOUCH = NULL WHERE TOUCH = 0 "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET WASTAGE = NULL WHERE WASTAGE = 0     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET PUREWT = NULL WHERE PUREWT = 0  "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET BALWEIGHT = NULL WHERE BALWEIGHT = 0     "
        strSql += vbCrLf + "       UPDATE MASTER..TEMPSMITHLEDGER_RES SET BALAMOUNT = NULL WHERE BALAMOUNT = 0 "
        strSql += vbCrLf + "       SELECT * FROM MASTER..TEMPSMITHLEDGER_RES ORDER BY RESULT,TRANDATE,TRANNO   "


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSP25_AcHeadRunningBalance()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ACCRUNNINGBAL')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ACCRUNNINGBAL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_ACCRUNNINGBAL"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME"
        strSql += vbCrLf + " ,@ACNAME VARCHAR(60)"
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(50)"
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(500)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " /** SPLIT COMPANY DETAIL **/"
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY  "
        strSql += vbCrLf + " CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))  "
        strSql += vbCrLf + " DECLARE @TCOMPANY VARCHAR(50)  "
        strSql += vbCrLf + " IF CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID  "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COMPANYID)>0  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)  "
        strSql += vbCrLf + " 	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))  "
        strSql += vbCrLf + " 	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + " 		SET @COMPANYID= @COMPANYID + ','  "
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " /** SPLIT COSTCENTRE DETAIL **/   "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE    "
        strSql += vbCrLf + " CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))  "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE) > 0  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 	DECLARE @TEMPNAME VARCHAR(20)    "
        strSql += vbCrLf + " 	IF CHARINDEX(',',@COSTNAME)=0    "
        strSql += vbCrLf + " 		INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME)  "
        strSql += vbCrLf + " 	WHILE CHARINDEX(',',@COSTNAME)>0    "
        strSql += vbCrLf + " 		BEGIN    "
        strSql += vbCrLf + " 		SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)    "
        strSql += vbCrLf + " 		SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))    "
        strSql += vbCrLf + " 		IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0    "
        strSql += vbCrLf + " 			SET @COSTNAME= @COSTNAME + ','    "
        strSql += vbCrLf + " 		INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME)  "
        strSql += vbCrLf + " 		END  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " ELSE  "
        strSql += vbCrLf + " 	INSERT INTO #COSTCENTRE(COSTID) SELECT '' COSTID  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @ACCODE VARCHAR(7)"
        strSql += vbCrLf + " SELECT @ACCODE = ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACNAME = @ACNAME"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPACHEADRUNNINGBAL')>0 DROP TABLE MASTER..TEMPACHEADRUNNINGBAL"
        strSql += vbCrLf + "  SELECT TRANDATE,"
        strSql += vbCrLf + "  CASE WHEN OPENING<0 THEN CONVERT(VARCHAR(50),abs(OPENING))+' Cr.' WHEN OPENING = 0 THEN '--- N i l ---' ELSE CONVERT(VARCHAR(50),abs(OPENING))+' Dr.' END OPENING"
        strSql += vbCrLf + "  ,DEBIT,CREDIT,"
        strSql += vbCrLf + "  CASE WHEN OPENING+DEBIT-CREDIT<0 THEN CONVERT(VARCHAR(50),abs(OPENING+DEBIT-CREDIT))+' Cr.' WHEN OPENING+DEBIT-CREDIT = 0 THEN '--- N i l ---' ELSE CONVERT(VARCHAR(50),abs(OPENING+DEBIT-CREDIT))+' Dr.' END CLOSING"
        strSql += vbCrLf + "  INTO MASTER..TEMPACHEADRUNNINGBAL  "
        strSql += vbCrLf + "  FROM  "
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " SELECT A.ACNAME,T.TRANDATE"
        strSql += vbCrLf + " ,ISNULL((SELECT SUM(DEBIT-CREDIT) FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE = T.ACCODE AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)),0) "
        strSql += vbCrLf + "  + ISNULL((SELECT SUM(CASE WHEN TRANMODE = 'D' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) "
        strSql += vbCrLf + " 	        FROM " & tranDbName & "..ACCTRAN "
        strSql += vbCrLf + " 		WHERE TRANDATE < T.TRANDATE AND ACCODE = T.ACCODE "
        strSql += vbCrLf + " 		AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + " 		AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) "
        strSql += vbCrLf + " 		AND ISNULL(COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)"
        strSql += vbCrLf + "          ),0) AS OPENING"
        strSql += vbCrLf + " ,SUM(CASE WHEN T.TRANMODE = 'D' THEN T.AMOUNT ELSE 0 END) AS DEBIT"
        strSql += vbCrLf + " ,SUM(CASE WHEN T.TRANMODE = 'C' THEN T.AMOUNT ELSE 0 END) AS CREDIT"
        strSql += vbCrLf + " FROM " & tranDbName & "..ACCTRAN AS T," & cnAdminDb & "..ACHEAD AS A"
        strSql += vbCrLf + " WHERE T.TRANDATE BETWEEN @FROMDATE AND @TODATE AND T.ACCODE = @ACCODE AND A.ACCODE = T.ACCODE "
        strSql += vbCrLf + " AND ISNULL(T.CANCEL,'') = '' "
        strSql += vbCrLf + " AND T.COMPANYID IN (SELECT COMPANYID FROM #COMPANY) "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)"
        strSql += vbCrLf + " GROUP BY A.ACNAME,T.TRANDATE,T.ACCODE"
        strSql += vbCrLf + " )X"
        strSql += vbCrLf + " ORDER BY TRANDATE"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMPACHEADRUNNINGBAL SET OPENING = NULL WHERE OPENING = '0'"
        strSql += vbCrLf + " UPDATE MASTER..TEMPACHEADRUNNINGBAL SET DEBIT = NULL WHERE DEBIT = '0'"
        strSql += vbCrLf + " UPDATE MASTER..TEMPACHEADRUNNINGBAL SET CREDIT = NULL WHERE CREDIT = '0'"
        strSql += vbCrLf + " UPDATE MASTER..TEMPACHEADRUNNINGBAL SET CLOSING = NULL WHERE CLOSING= '0'"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub funcSP24_TagWiseProfitLoss_Format4()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFITLOSS_FORMAT4')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGWISEPROFITLOSS_FORMAT4"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_TAGWISEPROFITLOSS_FORMAT4"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@FROMDATE VARCHAR(20)"
        strSql += vbCrLf + ",@TODATE VARCHAR(20)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(50)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(30)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(30)"
        strSql += vbCrLf + ",@GROUPBY VARCHAR(30)"
        strSql += vbCrLf + ",@GP VARCHAR(1)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TAGWISEPROFITLOSS'', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TAGWISEPROFITLOSS '"
        strSql += vbCrLf + "PRINT(@QRY)"
        strSql += vbCrLf + "EXEC (@QRY)"
        strSql += vbCrLf + "	SELECT @QRY=' SELECT TRANNO, TRANDATE, COSTID, CONVERT(NUMERIC(10,2),RATE) RATE, (SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = I.ITEMID ) ITEMNAME, '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' (SELECT SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID ) SUBITEMNAME,  PCS, GRSWT , NETWT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID ) [PUR_VA%]  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,3),(NETWT * (SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID)/100)) PUR_VA_WT  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,2),((((MCHARGE - FIN_DISCOUNT - DISCOUNT) / RATE) + WASTAGE) / NETWT * 100)) [SAL_VA%] '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,3),NETWT * ((((MCHARGE - FIN_DISCOUNT - DISCOUNT) / RATE) + WASTAGE) / NETWT * 100)/100) [SAL_VA_WT] '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,2),(((((MCHARGE - FIN_DISCOUNT - DISCOUNT) / RATE) + WASTAGE) / NETWT * 100) - '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' (SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID ))) [GP%]  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,3),(NETWT *(((((MCHARGE - FIN_DISCOUNT - DISCOUNT) / RATE) + WASTAGE) / NETWT * 100) - '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' (SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID ))) / 100) GP_WT  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,2),((GRSWT + (GRSWT * (SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID)/100))) * RATE) PUR_AMT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,2),AMOUNT) AS SAL_AMT  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(10,2),(AMOUNT - ((GRSWT + (GRSWT * (SELECT ISNULL(GPPER,0) FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID  = I.SUBITEMID)/100))) * RATE)) GP_AMT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+'   INTO  TEMPTABLEDB..TAGWISEPROFITLOSS  FROM " & tranDbName & "..ISSUE I WHERE TRANTYPE IN (''SA'',''OD'',''RD'')  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND TRANDATE BETWEEN ''' + @FROMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') = ''''  '"
        strSql += vbCrLf + "	IF @COSTNAME <> 'ALL'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND COSTID IN (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = ''' + @COSTNAME + ''') '"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @COMPANYID <> 'ALL'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY WHERE COMPANYID = ''' + @COMPANYID+ ''')'"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @METALNAME <> 'ALL'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+' AND METALID IN (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = ''' + @METALNAME + ''') '"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC (@QRY) "

        ''strSql += vbCrLf + "	strSql += vbCrLf + "Select @QRY = @QRY +Char(13)+' AND SUBITEMID IN (SELECT SUBITEMID FROM " & cnAdminDb & "..SUBITEMMAST WHERE GPPER > 0) ORDER BY COSTID  '"
        strSql += vbCrLf + " 	SELECT @QRY=' IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = ''TEMP_TAGWISEPROFITLOSS'')>0 DROP TABLE MASTER..TEMP_TAGWISEPROFITLOSS  '  "
        strSql += vbCrLf + "	IF @GROUPBY = 'I'    "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY +CHAR(13)+'SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY ITEMNAME,TRANDATE,TRANNO    '"
        strSql += vbCrLf + "	ELSE IF @GROUPBY = 'N'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY +CHAR(13)+'SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY TRANDATE,TRANNO  '"
        strSql += vbCrLf + "	ELSE IF @GROUPBY = 'E'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY +CHAR(13)+'SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY TRANDATE,TRANNO    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY +CHAR(13)+'SELECT * FROM MASTER..TEMP_TAGWISEPROFITLOSS ORDER BY KEYNO   '"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "	END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP24_TagWiseProfitLoss_Format3()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFITLOSS_FORMAT3')>0"
