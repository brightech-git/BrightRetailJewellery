        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNSHAPE AS SH ON SH.SHAPEID=TG.SHAPEID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCOLOR AS SC ON SC.COLORID=TG.COLORID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCLARITY AS CL ON CL.CLARITYID=TG.CLARITYID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' LEFT JOIN STNCUT AS CT ON CT.CUTID=TG.CUTID '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13) +' WHERE ' "
