        strSql += vbCrLf + " 	SELECT @QRY = ' CREATE TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE1 (SEP VARCHAR(20),COSTID VARCHAR(10)'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,TITEMID INT,ITEMID INT,SUBITEMID INT,STNPCS INT,STNWT DECIMAL(15,3),VALUE DECIMAL(15,2)'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,SNO VARCHAR(20),STONE VARCHAR(20),STNRATE DECIMAL(15,2),DIAPCS INT,DIAWT DECIMAL(15,3),RECISS VARCHAR(20))' "
