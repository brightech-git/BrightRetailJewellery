        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,TISSDIAPCS)) TISSDIAPCS,SUM(TISSDIAWT) TISSDIAWT,SUM(CONVERT(INT,TISSSTNPCS)) TISSSTNPCS,SUM(TISSSTNCRWT) TISSSTNCRWT,SUM(TISSSTNGRWT) TISSSTNGRWT,SUM(TISSVALUE) TISSVALUE,SUM(CONVERT(DECIMAL(15,2),TISSSALVALUE)) TISSSALVALUE'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,AIITAGS)) AIITAGS,SUM(CONVERT(INT,AIIPCS)) AIIPCS,SUM(AIIGRSWT) AIIGRSWT,SUM(AIINETWT) AIINETWT'"
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(AIIEXTRAWT) AIIEXTRAWT,SUM(AIITAGWT) AIITAGWT,SUM(AIICOVERWT) AIICOVERWT'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,AIIDIAPCS)) AIIDIAPCS,SUM(AIIDIAWT) AIIDIAWT,SUM(CONVERT(INT,AIISTNPCS)) AIISTNPCS,SUM(AIISTNCRWT) AIISTNCRWT,SUM(AIISTNGRWT) AIISTNGRWT,SUM(AIIVALUE) AIIVALUE,SUM(CONVERT(DECIMAL(15,2),AIISALVALUE)) AIISALVALUE'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,CTAGS)) CTAGS,SUM(CONVERT(INT,CPCS)) CPCS,SUM(CGRSWT) CGRSWT,SUM(CNETWT) CNETWT'"
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CEXTRAWT) CEXTRAWT,SUM(CTAGWT) CTAGWT,SUM(CCOVERWT) CCOVERWT'  "
        strSql += vbCrLf + " 		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'   ,(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)CBOXWT'"
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CGRSWT)+ISNULL(SUM(CTAGWT),0)+ISNULL(SUM(CCOVERWT),0) '"
        strSql += vbCrLf + " 		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'   +(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'"
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   AS CTOTWT'"
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,CDIAPCS)) CDIAPCS,SUM(CDIAWT) CDIAWT,SUM(CONVERT(INT,CSTNPCS)) CSTNPCS,SUM(CSTNCRWT) CSTNCRWT,SUM(CSTNGRWT) CSTNGRWT,SUM(CVALUE) CVALUE,SUM(CONVERT(DECIMAL(15,2),CSALVALUE)) CSALVALUE'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPCTAGS)) APPCTAGS,SUM(CONVERT(INT,APPCPCS)) APPCPCS,SUM(APPCGRSWT) APPCGRSWT,SUM(APPCNETWT) APPCNETWT'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(APPCEXTRAWT) APPCEXTRAWT,SUM(APPCTAGWT) APPCTAGWT,SUM(APPCCOVERWT) APPCCOVERWT '  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPCDIAPCS)) APPCDIAPCS,SUM(APPCDIAWT) APPCDIAWT,SUM(CONVERT(INT,APPCSTNPCS)) APPCSTNPCS,SUM(APPCSTNCRWT) APPCSTNCRWT,SUM(APPCSTNGRWT) APPCSTNGRWT,SUM(APPCVALUE) APPCVALUE,SUM(CONVERT(DECIMAL(15,2),APPCSALVALUE))APPCSALVALUE'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,PTAGS)) PTAGS,SUM(CONVERT(INT,PPCS)) PPCS,SUM(PGRSWT) PGRSWT,SUM(PNETWT) PNETWT '  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(PEXTRAWT) PEXTRAWT'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,PDIAPCS)) PDIAPCS,SUM(PDIAWT) PDIAWT,SUM(CONVERT(INT,PSTNPCS)) PSTNPCS,SUM(PSTNCRWT) PSTNCRWT,SUM(PSTNGRWT) PSTNGRWT,SUM(PVALUE) PVALUE,SUM(CONVERT(DECIMAL(15,2),PSALVALUE))PSALVALUE'  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'   '  "
        strSql += vbCrLf + " 		 SELECT @QRY= @QRY+CHAR(13)+'    FROM TEMPTABLEDB..TEMP' + @SYSTEMID + 'ITEMSTK AS T'  "
        strSql += vbCrLf + " 		 IF @GROUPBY = 'CO'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY COSTCENTRE'  "
        strSql += vbCrLf + " 		 END  "
        strSql += vbCrLf + " 		 ELSE IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY COUNTER'  "
        strSql += vbCrLf + " 		 END  "
        strSql += vbCrLf + " 		 ELSE IF @GROUPBY = 'IT'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY ITEMTYPE'  "
        strSql += vbCrLf + " 		 END  "
        strSql += vbCrLf + " 		 ELSE IF @GROUPBY = 'DE'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY DESIGNER'  "
        strSql += vbCrLf + " 		 END"
        strSql += vbCrLf + " 		 ELSE IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY CGROUP,TCGROUP'  "
        strSql += vbCrLf + " 		 END    "
        strSql += vbCrLf + " 		 ELSE  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY PARTICULAR'  "
        strSql += vbCrLf + " 		 END  "
        strSql += vbCrLf + " 		 IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT DISPLAYORDER FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER),COUNTER'  "
        strSql += vbCrLf + " 		 END "
        strSql += vbCrLf + " 		 IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + " 		 BEGIN  "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT DISPORDER FROM ITEMGROUPMAST WHERE GROUPNAME=T.CGROUP),COUNTERGROUP'  "
        strSql += vbCrLf + " 		 END  "
        strSql += vbCrLf + " 		 PRINT @QRY  "
        strSql += vbCrLf + " 		 EXEC (@QRY)  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

