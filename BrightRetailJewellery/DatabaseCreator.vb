    Private Sub CreateTriggerMIInserttoReceipt()
        Dim TrigAvail As Boolean = False
        strSql = " SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'TRIG_MISCISSUETORECEIPT_INS'"
        If Val(GetSqlValue(strSql, 0, tran).ToString) = 1 Then
            TrigAvail = True
        End If
        Dim TrigDisable As Boolean = False
        If TrigAvail Then
            TrigDisable = funcCheckTriggerStatus("TRIG_MISCISSUETORECEIPT_INS")
        End If
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'TRIG_MISCISSUETORECEIPT_INS')>0"
        strSql += vbCrLf + "  DROP TRIGGER TRIG_MISCISSUETORECEIPT_INS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If cnHOCostId = "" Then Exit Sub
        If cnHOCostId <> cnCostId Then Exit Sub
        If MIAUTOPOST <> "Y" Then Exit Sub
        strSql = vbCrLf + "CREATE TRIGGER TRIG_MISCISSUETORECEIPT_INS ON ISSUE FOR INSERT,DELETE"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @TRANTYPE VARCHAR(2)"
        strSql += vbCrLf + "	DECLARE @COSTID VARCHAR(2)"
        strSql += vbCrLf + "	DECLARE @HOCOSTID VARCHAR(2)"
        strSql += vbCrLf + "	DECLARE @INSCOSTID VARCHAR(2)"
        strSql += vbCrLf + "	DECLARE @AUTOPOST VARCHAR(1)"
        strSql += vbCrLf + "	SET @COSTID=''"
        strSql += vbCrLf + "	SET @HOCOSTID=''"
        strSql += vbCrLf + "	SET @INSCOSTID=''"
        strSql += vbCrLf + "	SET @AUTOPOST=''"
        strSql += vbCrLf + "	SELECT @HOCOSTID=COSTID FROM " & cnAdminDb & "..SYNCCOSTCENTRE WHERE MAIN='Y'"
        strSql += vbCrLf + "	SELECT @COSTID=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='COSTID'"
        strSql += vbCrLf + "	SELECT @AUTOPOST=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='MIAUTOPOST'"
        strSql += vbCrLf + "	SELECT @TRANTYPE=TRANTYPE FROM INSERTED"
        strSql += vbCrLf + "	SELECT @INSCOSTID=COSTID FROM INSERTED"
        strSql += vbCrLf + "	DECLARE @I INT, @D INT;"
        strSql += vbCrLf + "	SELECT @I = COUNT(*) FROM INSERTED;"
        strSql += vbCrLf + "	SELECT @D = COUNT(*) FROM DELETED;"
        strSql += vbCrLf + "	IF @TRANTYPE='MI' AND @COSTID=@HOCOSTID AND @COSTID<>'' AND @AUTOPOST='Y' AND @I > 0 AND @D = 0"
        strSql += vbCrLf + "	BEGIN /** INSERT RECEIPT **/"
        strSql += vbCrLf + "		DECLARE @SNO VARCHAR(15)"
        strSql += vbCrLf + "		DECLARE @RECPAY VARCHAR(1)"
        strSql += vbCrLf + "		DECLARE @COMPID VARCHAR(3)"
        strSql += vbCrLf + "		DECLARE @ACCODE VARCHAR(7)"
        strSql += vbCrLf + "		SELECT @ACCODE=''"
        strSql += vbCrLf + "		SELECT @ACCODE=ACCODE FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTID=@INSCOSTID"
        strSql += vbCrLf + "		SELECT @COMPID = COMPANYID FROM INSERTED"
        strSql += vbCrLf + "		SELECT @SNO "
        strSql += vbCrLf + "		EXECUTE GET_TRANSNO_TRAN"
        strSql += vbCrLf + "		@COSTID = @COSTID"
        strSql += vbCrLf + "		,@CTLID =  'RECEIPTCODE'"
        strSql += vbCrLf + "		,@CHECKTABLENAME = 'RECEIPT'"
        strSql += vbCrLf + "		,@COMPANYID = @COMPID"
        strSql += vbCrLf + "		,@RETVALUE = @SNO OUTPUT"
        strSql += vbCrLf + "		INSERT INTO RECEIPT"
        strSql += vbCrLf + "		("
        strSql += vbCrLf + "		SNO,ITEMID,SUBITEMID,COMPANYID,TRANNO,TRANDATE"
        strSql += vbCrLf + "		,PCS,GRSWT,LESSWT,NETWT,TAGNO,ACCODE"
        strSql += vbCrLf + "		,TRANTYPE,ITEMCTRID,REMARK1"
        strSql += vbCrLf + "		,RATE,COSTID,METALID,CATCODE,OCATCODE"
        strSql += vbCrLf + "		,TAGDESIGNER,ITEMTYPEID"
        strSql += vbCrLf + "		,BATCHNO,CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "		,UPTIME,SYSTEMID,APPVER,ISSNO,STKTYPE"
        strSql += vbCrLf + "		)"
        strSql += vbCrLf + "		SELECT "
        strSql += vbCrLf + "		@SNO,ITEMID,SUBITEMID,COMPANYID,TRANNO,TRANDATE"
        strSql += vbCrLf + "		,PCS,GRSWT,LESSWT,NETWT,TAGNO,@ACCODE"
        strSql += vbCrLf + "		,'RIN',ITEMCTRID,'AUTO GENERATION AGAINST MI FROM ' + COSTID"
        strSql += vbCrLf + "		,RATE,@HOCOSTID,METALID,CATCODE,OCATCODE"
        strSql += vbCrLf + "		,TAGDESIGNER,ITEMTYPEID"
        strSql += vbCrLf + "		,BATCHNO,'' AS CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "		,UPTIME,SYSTEMID,APPVER,SNO,STKTYPE"
        strSql += vbCrLf + "		FROM INSERTED	"
        strSql += vbCrLf + "	END /** INSERT RECEIPT **/"
        strSql += vbCrLf + "	IF @I = 0 AND @D > 0 /* DELETE RECEIPT */"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		DECLARE @DSNO VARCHAR(15)"
        strSql += vbCrLf + "		SET @DSNO=''"
        strSql += vbCrLf + "		SELECT @DSNO=SNO FROM DELETED"
        strSql += vbCrLf + "		IF @DSNO<>''"
        strSql += vbCrLf + "			DELETE FROM RECEIPT WHERE ISSNO=@DSNO AND ISSNO<>''"
        strSql += vbCrLf + "	END/* DELETE RECEIPT */"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If TrigDisable Then funcTriggerDisable("ISSUE", "TRIG_MISCISSUETORECEIPT_INS")
    End Sub
    Private Sub CreateTriggerIssueInsert()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'TRIG_ISSUE_INS')>0"
        strSql += vbCrLf + "  DROP TRIGGER TRIG_ISSUE_INS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE TRIGGER TRIG_ISSUE_INS ON ISSUE AFTER INSERT"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  DECLARE @ITEMID INT"
        strSql += vbCrLf + "  DECLARE @SITEMID INT"
        strSql += vbCrLf + "  DECLARE @SUBITEMID INT"
        strSql += vbCrLf + "  DECLARE @MSG VARCHAR(50)"
        strSql += vbCrLf + "  SELECT @ITEMID=ITEMID FROM INSERTED"
        strSql += vbCrLf + "  SELECT @SUBITEMID=isnull(SUBITEMID,0) FROM INSERTED"
        strSql += vbCrLf + "  IF @SUBITEMID<>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "    SELECT @SITEMID= ITEMID FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID=@SUBITEMID"
        strSql += vbCrLf + "    IF @SITEMID<>@ITEMID"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        SELECT @MSG='Subitemid MisMatch'"
        strSql += vbCrLf + "        RAISERROR ( @MSG, 16, 1)"
        strSql += vbCrLf + "        ROLLBACK TRANSACTION"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "  END"

        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE)>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "   IF EXISTS ( SELECT * FROM INSERTED WHERE ISNULL(COSTID,'')='')"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "     ROLLBACK TRANSACTION"
        strSql += vbCrLf + "     RAISERROR ('TRIGGER FROM DATABASE ERROR: COSTID IS EMPTY', 16, 1)"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "  END"

        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM INSERTED WHERE ISNULL(TRANFLAG,'') IN ('W','A')) > 0"
        strSql += vbCrLf + "  	BEGIN /** TRIG **/"
        strSql += vbCrLf + "  	DECLARE @SNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @BATCHNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @TRANDATE SMALLDATETIME"
        strSql += vbCrLf + "  	DECLARE @TRANTYPE VARCHAR(3)"
        strSql += vbCrLf + "  	DECLARE @TAGNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @STOCKTYPE VARCHAR(5)"
        strSql += vbCrLf + "  	DECLARE @COSTID VARCHAR(3)"
        strSql += vbCrLf + "  	DECLARE @TRANNO INT"
        strSql += vbCrLf + "  	DECLARE @ESTSNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @ORSNO VARCHAR(15)"
        strSql += vbCrLf + "  	SELECT @SNO = INS.SNO "
        strSql += vbCrLf + "  	,@TRANDATE = INS.TRANDATE"
        strSql += vbCrLf + "  	,@BATCHNO = INS.BATCHNO"
        strSql += vbCrLf + "  	,@TRANTYPE = INS.TRANTYPE"
        strSql += vbCrLf + "  	,@TAGNO = ISNULL(INS.TAGNO,'')"
        strSql += vbCrLf + "  	,@STOCKTYPE = I.STOCKTYPE"
        strSql += vbCrLf + "  	,@COSTID = INS.COSTID"
        strSql += vbCrLf + "  	,@TRANNO = INS.TRANNO"
        strSql += vbCrLf + "  	,@ESTSNO = INS.ESTSNO"
        strSql += vbCrLf + "  	,@ORSNO = INS.ORSNO"
        strSql += vbCrLf + "  	FROM INSERTED AS INS"
        strSql += vbCrLf + "  	LEFT OUTER JOIN " & cnAdminDb & "..ITEMMAST AS I ON I.ITEMID = INS.ITEMID"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  	IF ISNULL(@TAGNO,'') <> '' AND @STOCKTYPE = 'T' "
        strSql += vbCrLf + "  		BEGIN/** Update TagDetails into ISSUE **/"
        strSql += vbCrLf + "  		UPDATE ISSUE SET"
        strSql += vbCrLf + "  		TAGPCS = T.PCS"
        strSql += vbCrLf + "  		,TAGGRSWT = T.GRSWT"
        strSql += vbCrLf + "  		,TAGNETWT = T.NETWT"
        strSql += vbCrLf + "  		,TAGRATEID = T.RATE"
        strSql += vbCrLf + "  		,TAGSVALUE = T.SALVALUE"
        strSql += vbCrLf + "  		,TAGDESIGNER = T.DESIGNERID"
        strSql += vbCrLf + "  		,ITEMCTRID = T.ITEMCTRID"
        strSql += vbCrLf + "  		,ITEMTYPEID = T.ITEMTYPEID"
        strSql += vbCrLf + "  		FROM ISSUE AS I," & cnAdminDb & "..ITEMTAG AS T"
        strSql += vbCrLf + "  		WHERE I.TRANDATE = @TRANDATE AND I.BATCHNO = @BATCHNO AND T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO"
        strSql += vbCrLf + "  		END/** Update TagDetails **/"
        strSql += vbCrLf + "  	/** Update StnAmt And MiscAmt **/"
        strSql += vbCrLf + "  	UPDATE ISSUE SET STNAMT = (SELECT SUM(STNAMT) FROM ISSSTONE WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO AND "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  ISSSNO = @SNO)"
        strSql += vbCrLf + "  			,MISCAMT = (SELECT SUM(AMOUNT) FROM ISSMISC WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO AND "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  ISSSNO = @SNO)"
        strSql += vbCrLf + "  			WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  	IF (@TRANTYPE = 'SA' OR @TRANTYPE = 'MI') AND ISNULL(@TAGNO,'') <> '' AND @STOCKTYPE ='T' "
        strSql += vbCrLf + "  		BEGIN /** Update ItemTag **/"
        strSql += vbCrLf + "  		UPDATE " & cnAdminDb & "..ITEMTAG SET"
        strSql += vbCrLf + "  			ISSDATE = INS.TRANDATE"
        strSql += vbCrLf + "  			,ISSREFNO = INS.TRANNO"
        strSql += vbCrLf + "  			,ISSPCS = INS.PCS"
        strSql += vbCrLf + "  			,ISSWT = INS.GRSWT"
        strSql += vbCrLf + "  			,TOFLAG = INS.TRANTYPE"
        strSql += vbCrLf + "  			,BATCHNO = INS.BATCHNO"
        strSql += vbCrLf + "  			,COMPANYID = INS.COMPANYID"
        strSql += vbCrLf + "  			FROM " & cnAdminDb & "..ITEMTAG AS T,INSERTED AS INS"
        strSql += vbCrLf + "  			WHERE T.ITEMID = INS.ITEMID AND T.TAGNO = INS.TAGNO"
        strSql += vbCrLf + "  		END /** Update ItemTag **/"
        strSql += vbCrLf + "  	ELSE IF (@TRANTYPE = 'AI' AND ISNULL(@TAGNO,'') <> '' AND @STOCKTYPE='T' )"
        strSql += vbCrLf + "  		BEGIN /** Update ItemTag Approval**/"
        strSql += vbCrLf + "  		UPDATE " & cnAdminDb & "..ITEMTAG SET"
        strSql += vbCrLf + "  			APPROVAL = 'A'"
        strSql += vbCrLf + "  			,BATCHNO = INS.BATCHNO"
        strSql += vbCrLf + "  			,COMPANYID = INS.COMPANYID"
        strSql += vbCrLf + "  			FROM " & cnAdminDb & "..ITEMTAG AS T,INSERTED AS INS"
        strSql += vbCrLf + "  			WHERE T.ITEMID = INS.ITEMID AND T.TAGNO = INS.TAGNO"
        strSql += vbCrLf + "  		END /** Update ItemTag Approval**/"
        strSql += vbCrLf + "  	ELSE IF @STOCKTYPE <> 'T' AND @TRANTYPE IN ('SA','MI','AI')"
        strSql += vbCrLf + "  		BEGIN /** Insert ItemNonTag **/"
        strSql += vbCrLf + "  		DECLARE @NONTAGSNO VARCHAR(15)"
        strSql += vbCrLf + "  		DECLARE @RECPAY VARCHAR(1)"
        strSql += vbCrLf + "  		DECLARE @COMPID VARCHAR(3)"
        strSql += vbCrLf + "  		SELECT @COMPID = COMPANYID FROM INSERTED"
        strSql += vbCrLf + "  		SELECT @NONTAGSNO "
        strSql += vbCrLf + "  		EXECUTE " & tranDbName & "..GET_ADMINSNO_TRAN"
        strSql += vbCrLf + "  		@COSTID = @COSTID"
        strSql += vbCrLf + "  		,@CTLID =  'ITEMNONTAGCODE'"
        strSql += vbCrLf + "  		,@CHECKTABLENAME = 'ITEMNONTAG'"
        strSql += vbCrLf + "  		,@COMPANYID = @COMPID"
        strSql += vbCrLf + "  		,@RETVALUE = @NONTAGSNO OUTPUT"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  		INSERT INTO " & cnAdminDb & "..ITEMNONTAG"
        strSql += vbCrLf + "  		("
        strSql += vbCrLf + "  		SNO,ITEMID,SUBITEMID,COMPANYID,RECDATE"
        strSql += vbCrLf + "  		,PCS,GRSWT,LESSWT,NETWT,FINRATE"
        strSql += vbCrLf + "  		,ISSTYPE,RECISS,POSTED,LOTNO,PACKETNO"
        strSql += vbCrLf + "  		,DREFNO,ITEMCTRID,ORDREPNO,ORSNO,NARRATION"
        strSql += vbCrLf + "  		,PURWASTAGE,PURRATE,PURMC,RATE,COSTID"
        strSql += vbCrLf + "  		,CTGRM,DESIGNERID,ITEMTYPEID,CARRYFLAG"
        strSql += vbCrLf + "  		,REASON,BATCHNO,CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "  		,UPTIME,SYSTEMID,APPVER,APPROVAL,FLAG,EXTRAWT"
        strSql += vbCrLf + "  		)"
        strSql += vbCrLf + "  		SELECT "
        strSql += vbCrLf + "  		@NONTAGSNO,ITEMID,SUBITEMID,COMPANYID,TRANDATE"
        strSql += vbCrLf + "  		,PCS,GRSWT,LESSWT,NETWT,RATE"
        strSql += vbCrLf + "  		,TRANTYPE,'I','' ASPOSTED,0 AS LOTNO,TAGNO AS PACKETNO"
        strSql += vbCrLf + "  		,0 AS DREFNO,ITEMCTRID,'' AS ORDREPNO,'' AS ORSNO,'' AS NARRATION"
        strSql += vbCrLf + "  		,0 AS PURWASTAGE,0 AS PURRATE,0 AS PURMC,RATE,COSTID"
        strSql += vbCrLf + "  		,''CTGRM,TAGDESIGNER,ITEMTYPEID,''CARRYFLAG"
        strSql += vbCrLf + "  		,0 REASON,BATCHNO,'' AS CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "  		,UPTIME,SYSTEMID,APPVER,CASE WHEN TRANTYPE IN ('AI') THEN 'A' ELSE '' END APPROVAL,FLAG,EXTRAWT"
        strSql += vbCrLf + "  		FROM INSERTED	"
        strSql += vbCrLf + "  		END /** Insert ItemNonTag **/"
        strSql += vbCrLf + "  	IF ISNULL(@ESTSNO,'') <> ''"
        strSql += vbCrLf + "  		BEGIN /** Update Estimation **/"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTISSUE SET BATCHNO = @BATCHNO WHERE SNO = @ESTSNO"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTISSSTONE SET BATCHNO = @BATCHNO WHERE ISSSNO = @ESTSNO"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTISSMISC SET BATCHNO = @BATCHNO WHERE ISSSNO = @ESTSNO"
        strSql += vbCrLf + "  		END  /** Update Estimation **/"
        strSql += vbCrLf + "  	IF ISNULL(@ORSNO,'') <> '' /** Update Delivered Sno into OrMast **/"
        strSql += vbCrLf + "  		UPDATE " & compId & "ADMINDB..ORMAST SET ODBATCHNO = @BATCHNO ,ODSNO = @SNO WHERE SNO = @ORSNO"
        strSql += vbCrLf + "  	END /** TRIG **/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub CreateTriggerReceiptInsertion()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'TRIG_RECEIPT_INS')>0"
        strSql += vbCrLf + "  DROP TRIGGER TRIG_RECEIPT_INS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE TRIGGER TRIG_RECEIPT_INS ON RECEIPT FOR INSERT"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM INSERTED WHERE ISNULL(TRANFLAG,'') IN ('W','A')) > 0"
        strSql += vbCrLf + "  	BEGIN /** TRIG **/"
        strSql += vbCrLf + "  	DECLARE @SNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @BATCHNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @TRANDATE SMALLDATETIME"
        strSql += vbCrLf + "  	DECLARE @TRANTYPE VARCHAR(3)"
        strSql += vbCrLf + "  	DECLARE @TAGNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @STOCKTYPE VARCHAR(5)"
        strSql += vbCrLf + "  	DECLARE @COSTID VARCHAR(3)"
        strSql += vbCrLf + "  	DECLARE @TRANNO INT"
        strSql += vbCrLf + "  	DECLARE @ISSNO VARCHAR(15)"
        strSql += vbCrLf + "  	DECLARE @ESTSNO VARCHAR(15)"
        strSql += vbCrLf + "  	SELECT @SNO = INS.SNO "
        strSql += vbCrLf + "  	,@TRANDATE = INS.TRANDATE"
        strSql += vbCrLf + "  	,@BATCHNO = INS.BATCHNO"
        strSql += vbCrLf + "  	,@TRANTYPE = INS.TRANTYPE"
        strSql += vbCrLf + "  	,@TAGNO = ISNULL(INS.TAGNO,'')"
        strSql += vbCrLf + "  	,@STOCKTYPE = I.STOCKTYPE"
        strSql += vbCrLf + "  	,@COSTID = INS.COSTID"
        strSql += vbCrLf + "  	,@TRANNO = INS.TRANNO"
        strSql += vbCrLf + "  	,@ISSNO = INS.ISSNO"
        strSql += vbCrLf + "  	,@ESTSNO = INS.ESTSNO"
        strSql += vbCrLf + "  	FROM INSERTED AS INS"
        strSql += vbCrLf + "  	LEFT OUTER JOIN " & compId & "Admindb..ITEMMAST AS I ON I.ITEMID = INS.ITEMID"
        strSql += vbCrLf + "  	"

        strSql += vbCrLf + "  	IF ISNULL(@TAGNO,'') <> ''"
        strSql += vbCrLf + "  		BEGIN/** Update TagDetails into ISSUE **/"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..RECEIPT SET"
        strSql += vbCrLf + "  		TAGPCS = T.PCS"
        strSql += vbCrLf + "  		,TAGGRSWT = T.GRSWT"
        strSql += vbCrLf + "  		,TAGNETWT = T.NETWT"
        strSql += vbCrLf + "  		,TAGRATEID = T.RATE"
        strSql += vbCrLf + "  		,TAGSVALUE = T.SALVALUE"
        strSql += vbCrLf + "  		,TAGDESIGNER = T.DESIGNERID"
        strSql += vbCrLf + "  		,ITEMCTRID = T.ITEMCTRID"
        strSql += vbCrLf + "  		,ITEMTYPEID = T.ITEMTYPEID"
        strSql += vbCrLf + "  		FROM INSERTED AS I," & cnAdminDb & "..ITEMTAG AS T"
        strSql += vbCrLf + "  		WHERE I.TRANDATE = @TRANDATE AND I.BATCHNO = @BATCHNO AND T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO"
        strSql += vbCrLf + "  		END/** Update TagDetails **/"
        strSql += vbCrLf + "  	/** Update StnAmt And MiscAmt **/"
        strSql += vbCrLf + "  	UPDATE RECEIPT SET STNAMT = (SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  AND ISSSNO = @SNO)"
        strSql += vbCrLf + "  			,MISCAMT = (SELECT SUM(AMOUNT) FROM RECEIPTMISC WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  AND ISSSNO = @SNO)"
        strSql += vbCrLf + "  			WHERE TRANDATE = @TRANDATE AND BATCHNO = @BATCHNO"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  	IF (@TRANTYPE = 'SR' OR @TRANTYPE = 'AR') AND ISNULL(@ISSNO,'') <> ''"
        strSql += vbCrLf + "  		BEGIN/** Update RefNo,RefDate into Issue for AR or SR **/"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ISSUE SET RESNO = @SNO ,REFNO = @TRANNO ,REFDATE = @TRANDATE WHERE SNO = @ISSNO"
        strSql += vbCrLf + "  		END/** Update RefNo,RefDate into Issue for AR or SR **/"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  	IF (@TRANTYPE = 'AR' AND ISNULL(@TAGNO,'') <> '')"
        strSql += vbCrLf + "  		BEGIN /** Update ItemTag Approval**/"
        strSql += vbCrLf + "  		UPDATE " & cnAdminDb & "..ITEMTAG SET"
        strSql += vbCrLf + "  			APPROVAL = ''"
        strSql += vbCrLf + "  			,BATCHNO = INS.BATCHNO"
        strSql += vbCrLf + "  			,COMPANYID = INS.COMPANYID"
        strSql += vbCrLf + "  			FROM " & cnAdminDb & "..ITEMTAG AS T,INSERTED AS INS"
        strSql += vbCrLf + "  			WHERE T.ITEMID = INS.ITEMID AND T.TAGNO = INS.TAGNO"
        strSql += vbCrLf + "  		END /** Update ItemTag Approval**/"
        strSql += vbCrLf + "  	ELSE IF @STOCKTYPE <> 'T' AND @TRANTYPE IN ('AR')"
        strSql += vbCrLf + "  		BEGIN /** Insert ItemNonTag **/"
        strSql += vbCrLf + "  		DECLARE @NONTAGSNO VARCHAR(15)"
        strSql += vbCrLf + "  		DECLARE @RECPAY VARCHAR(1)"
        strSql += vbCrLf + "        DECLARE @COMPID VARCHAR(3)"
        strSql += vbCrLf + "        SELECT @COMPID = COMPANYID FROM INSERTED"
        strSql += vbCrLf + "  		SELECT @NONTAGSNO "

        strSql += vbCrLf + "  		EXECUTE " & tranDbName & "..GET_TRANSNO_ADMIN"
        strSql += vbCrLf + "  		@COSTID = @COSTID"
        strSql += vbCrLf + "  		,@CTLID = 'ITEMNONTAGSNO'"
        strSql += vbCrLf + "  		,@CHECKTABLENAME = 'ITEMNONTAG'"
        strSql += vbCrLf + "        ,@COMPANYID = @COMPID"
        strSql += vbCrLf + "  		,@RETVALUE = @NONTAGSNO OUTPUT"
        strSql += vbCrLf + "  	"
        strSql += vbCrLf + "  		INSERT INTO " & cnAdminDb & "..ITEMNONTAG"
        strSql += vbCrLf + "  		("
        strSql += vbCrLf + "  		SNO,ITEMID,SUBITEMID,COMPANYID,RECDATE"
        strSql += vbCrLf + "  		,PCS,GRSWT,LESSWT,NETWT,FINRATE"
        strSql += vbCrLf + "  		,ISSTYPE,RECISS,POSTED,LOTNO,PACKETNO"
        strSql += vbCrLf + "  		,DREFNO,ITEMCTRID,ORDREPNO,ORSNO,NARRATION"
        strSql += vbCrLf + "  		,PURWASTAGE,PURRATE,PURMC,RATE,COSTID"
        strSql += vbCrLf + "  		,CTGRM,DESIGNERID,ITEMTYPEID,CARRYFLAG"
        strSql += vbCrLf + "  		,REASON,BATCHNO,CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "  		,UPTIME,SYSTEMID,APPVER,APPROVAL,FLAG"
        strSql += vbCrLf + "  		)"
        strSql += vbCrLf + "  		SELECT "
        strSql += vbCrLf + "  		@NONTAGSNO,ITEMID,SUBITEMID,COMPANYID,TRANDATE"
        strSql += vbCrLf + "  		,PCS,GRSWT,LESSWT,NETWT,RATE"
        strSql += vbCrLf + "  		,TRANTYPE,'R','' ASPOSTED,0 AS LOTNO,TAGNO AS PACKETNO"
        strSql += vbCrLf + "  		,0 AS DREFNO,ITEMCTRID,'' AS ORDREPNO,'' AS ORSNO,'' AS NARRATION"
        strSql += vbCrLf + "  		,0 AS PURWASTAGE,0 AS PURRATE,0 AS PURMC,RATE,COSTID"
        strSql += vbCrLf + "  		,''CTGRM,TAGDESIGNER,ITEMTYPEID,''CARRYFLAG"
        strSql += vbCrLf + "  		,0 REASON,BATCHNO,'' AS CANCEL,USERID,UPDATED"
        strSql += vbCrLf + "  		,UPTIME,SYSTEMID,APPVER,'A' APPROVAL,FLAG"
        strSql += vbCrLf + "  		FROM INSERTED	"
        strSql += vbCrLf + "  		END /** Insert ItemNonTag **/"
        strSql += vbCrLf + "  	IF ISNULL(@ESTSNO,'') <> ''"
        strSql += vbCrLf + "  		BEGIN /** Update Estimation **/"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTRECEIPT SET BATCHNO = @BATCHNO WHERE SNO = @ESTSNO"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTRECEIPTSTONE SET BATCHNO = @BATCHNO WHERE ISSSNO = @ESTSNO"
        strSql += vbCrLf + "  		UPDATE " & tranDbName & "..ESTRECEIPTMISC SET BATCHNO = @BATCHNO WHERE ISSSNO = @ESTSNO"
        strSql += vbCrLf + "  		END  /** Update Estimation **/"
        strSql += vbCrLf + "  	END /** TRIG **/"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "Admindb..COSTCENTRE)>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "   IF EXISTS ( SELECT * FROM INSERTED WHERE ISNULL(COSTID,'')='')"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "     ROLLBACK TRANSACTION"
        strSql += vbCrLf + "     RAISERROR ('TRIGGER FROM DATABASE ERROR: COSTID IS EMPTY', 16, 1)"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub CreateTriggerCancelTran()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'TRI_CANCELLEDTRAN_INS')>0"
        strSql += vbCrLf + "  DROP TRIGGER TRI_CANCELLEDTRAN_INS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE TRIGGER TRI_CANCELLEDTRAN_INS ON CANCELLEDTRAN FOR INSERT  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " 	BEGIN /** TRIG **/  "
        strSql += vbCrLf + " 	DECLARE @BATCHNO VARCHAR(15)  "
        strSql += vbCrLf + " 	DECLARE @TRANDATE SMALLDATETIME  "
        strSql += vbCrLf + " 	DECLARE @UPDATED SMALLDATETIME"
        strSql += vbCrLf + " 	DECLARE @UPTIME SMALLDATETIME"
        strSql += vbCrLf + " 	DECLARE @USERID INT"
        strSql += vbCrLf + " 	DECLARE @FLAG VARCHAR(1)  "
        strSql += vbCrLf + " 	SELECT   "
        strSql += vbCrLf + " 	@BATCHNO = BATCHNO,@TRANDATE = TRANDATE,@FLAG = FLAG,@UPDATED = UPDATED,@UPTIME = UPTIME,@USERID = USERID"
        strSql += vbCrLf + " 	FROM INSERTED  "
        strSql += vbCrLf + " 	IF @BATCHNO=''"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	    ROLLBACK TRANSACTION"
        strSql += vbCrLf + " 	    RAISERROR ('Batchno was empty.Cannot cancel this record.',16,3)"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	UPDATE ..ESTISSUE SET BATCHNO = '' WHERE BATCHNO = @BATCHNO  "
        strSql += vbCrLf + " 	UPDATE ..ESTRECEIPT SET BATCHNO = '' WHERE BATCHNO = @BATCHNO  "
        strSql += vbCrLf + " 	IF @FLAG = 'C'  "
        strSql += vbCrLf + " 		BEGIN /** Cancel Mode **/  "
        strSql += vbCrLf + " 		IF (SELECT COUNT(*) FROM " & tranDbName & "..RECEIPT WHERE BATCHNO = @BATCHNO AND TRANTYPE = 'AR') > 0  "
        strSql += vbCrLf + " 			BEGIN   "
        strSql += vbCrLf + " 			/** Item Tag Cancel **/    "
        strSql += vbCrLf + " 			UPDATE " & cnAdminDb & "..ITEMTAG SET ISSDATE = NULL,ISSREFNO = 0,ISSPCS = 0,ISSWT = 0 ,TOFLAG = '',BATCHNO = '',APPROVAL = 'A'    "
        strSql += vbCrLf + " 			WHERE BATCHNO = @BATCHNO    "
        strSql += vbCrLf + " 			END  "
        strSql += vbCrLf + " 		ELSE  "
        strSql += vbCrLf + " 			BEGIN  "
        strSql += vbCrLf + " 			/** Item Tag Cancel **/    "
        strSql += vbCrLf + "            IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CENT-STOCK' AND CTLTEXT = 'Y')>0"
        strSql += vbCrLf + "                BEGIN"
        strSql += vbCrLf + "          DECLARE @STKCOMID VARCHAR(5)"
        strSql += vbCrLf + "     SELECT @STKCOMID = CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'COMPANYID'"
        strSql += vbCrLf + "     UPDATE " & cnAdminDb & "..ITEMTAG SET COMPANYID = @STKCOMID WHERE BATCHNO = @BATCHNO    "
        strSql += vbCrLf + " 			    END"
        strSql += vbCrLf + " 			UPDATE " & cnAdminDb & "..ITEMTAG SET ISSDATE = NULL,ISSREFNO = 0,ISSPCS = 0,ISSWT = 0 ,TOFLAG = '',BATCHNO = '',APPROVAL = ''    "
        strSql += vbCrLf + " 			WHERE BATCHNO = @BATCHNO    "
        strSql += vbCrLf + " 			END "
        strSql += vbCrLf + " 		/** Sales Return Cancel **/  "

        strSql += vbCrLf + " 	declare @RETDB VARCHAR(10)"
        strSql += vbCrLf + " 	SELECT @RETDB = DBNAME FROM " & compId & "ADMINDB..DBMASTER WHERE (SELECT TOP 1 REFDATE FROM " & tranDbName & "..RECEIPT WHERE BATCHNO = @BATCHNO AND TRANTYPE = 'SR') BETWEEN STARTDATE AND ENDDATE"
        strSql += vbCrLf + " 	IF @RETDB <> '" & tranDbName & "'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	DECLARE @EQRY NVARCHAR(1000)"
        strSql += vbCrLf + " 	SELECT @EQRY ='UPDATE '+@RETDB +'..ISSUE  SET REFNO = '''' ,REFDATE = NULL,RUNNO = '''' '"
        strSql += vbCrLf + " 	SELECT @EQRY =@EQRY+' WHERE REFNO = CONVERT(VARCHAR,(SELECT TOP 1 TRANNO FROM " & tranDbName & "..RECEIPT WHERE BATCHNO = '''+@BATCHNO +''' AND TRANTYPE = ''SR''))'  "
        strSql += vbCrLf + " 	SELECT @EQRY =@EQRY+' AND REFDATE = (SELECT TOP 1 TRANDATE FROM " & tranDbName & "..RECEIPT WHERE BATCHNO = '''+@BATCHNO+''' AND TRANTYPE = ''SR'') ' "
        strSql += vbCrLf + " 	EXEC (@EQRY) 		"
        strSql += vbCrLf + " 	End"
        strSql += vbCrLf + " 		UPDATE " & tranDbName & "..ISSUE  SET REFNO = '' ,REFDATE = NULL  "
