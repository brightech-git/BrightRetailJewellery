    Private Sub funcPWD_ENCRYPTION()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='ENCRPTPWD')>0"
        strSql += vbCrLf + "  	DROP FUNCTION ENCRPTPWD"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " create function ENCRPTPWD(@PWDSTRING VARCHAR(100) ) RETURNS varchar(100) AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE   @AGEARRAYLENGTH INT "
        strSql += vbCrLf + " ,@PWDLEN INT, @COUNT INT"
        strSql += vbCrLf + " SET @AGEARRAYLENGTH = LEN(@PWDSTRING)"
        strSql += vbCrLf + " SET @PWDLEN = 1"
        strSql += vbCrLf + " SET @COUNT = 0 "
        strSql += vbCrLf + " DECLARE @FULLPWD VARCHAR(100) "
        strSql += vbCrLf + " DECLARE  @RETURNPWD CHAR(100)"
        strSql += vbCrLf + " SET @AGEARRAYLENGTH = LEN(@PWDSTRING)"
        strSql += vbCrLf + " SET @PWDLEN = 1"
        strSql += vbCrLf + " SET @COUNT = 1 "
        strSql += vbCrLf + " SET @FULLPWD=''"
        strSql += vbCrLf + " WHILE @PWDLEN <= @AGEARRAYLENGTH"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @PWDASC INT "
        strSql += vbCrLf + " SET @RETURNPWD =' '  "
        strSql += vbCrLf + " SET @PWDASC = ASCII(SUBSTRING(@PWDSTRING,@COUNT,1))+(@COUNT*2)+14"
        strSql += vbCrLf + " SET @RETURNPWD =  LTRIM(CHAR(@PWDASC))"
        strSql += vbCrLf + " SET @FULLPWD = @FULLPWD+ SUBSTRING(@RETURNPWD,1,1)"
        strSql += vbCrLf + " SET @COUNT= @COUNT+1"
        strSql += vbCrLf + " SET @PWDLEN = @PWDLEN+1"
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " RETURN @FULLPWD"
        strSql += vbCrLf + " End"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

