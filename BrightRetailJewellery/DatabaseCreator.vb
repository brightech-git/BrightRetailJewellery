        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' INTO TEMPTABLEDB..TEMP_OUTSTANDING'  "
        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' FROM'  "
