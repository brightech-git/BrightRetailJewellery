        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,REPLACE(CONVERT(VARCHAR(15),GETDATE(),102),''.'',''-'') '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,REPLACE(CONVERT(VARCHAR(15),GETDATE(),108),''.'',''-'') '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@USERID+''' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@RANDOMNUMBER+''' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@PWDOPTIONID+''' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,''1'' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,''N'' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' ,'''+@USERID+''' '"
        strSql += vbCrLf + " 		SELECT @QRY = @QRY + CHAR(13) + ' )'"
