    Private Sub funcSp39Homesales()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_HOMESALES')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_HOMESALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE [DBO].[SP_RPT_HOMESALES]  "
        strSql += vbCrLf + " (   @DATEFROM  VARCHAR(12)/* --FROMDATE */  "
        strSql += vbCrLf + " ,@DATETO VARCHAR(12)/* --ENDDATE */  "
        strSql += vbCrLf + " ,@TEMPTABLE VARCHAR(25)/* --GIVE THE SYSTEMID FOR TEMPORARY TABLES */  "
        strSql += vbCrLf + " ,@CNSTOCKDB NVARCHAR(50)/* --GIVE THE DATABASE NAME FOR STOCKDB */  "
        strSql += vbCrLf + " ,@METALID NVARCHAR(50)/* --METAL NAME FROM METALNAME TABLE */  "
        strSql += vbCrLf + " ,@COMPANYID NVARCHAR(500)/*  GIVE THE COMPANYID*/  "
        strSql += vbCrLf + " ,@COSTID VARCHAR(500)"
        strSql += vbCrLf + " ,@GRPITEM VARCHAR(1)  "
        strSql += vbCrLf + " ,@FLAG CHAR/* --FIND TH BACKOFFICE OR COUNTERSALES */"
        strSql += vbCrLf + " ) AS"
        strSql += vbCrLf + " DECLARE @CENTREFILTER VARCHAR(500),@COMPANYFILTER VARCHAR(500),@METALFILTER VARCHAR(500)"
        strSql += vbCrLf + " SET @COMPANYFILTER=''"
        strSql += vbCrLf + " SET @CENTREFILTER=''"
        strSql += vbCrLf + " SET @METALFILTER =''"
        strSql += vbCrLf + " IF @METALID <> ''  SET @METALFILTER = ' AND I.METALID IN (' + @METALID+ ')'"
        strSql += vbCrLf + " IF @COSTID <> ''  SET @CENTREFILTER = ' AND I.COSTID IN (' + @COSTID+ ')'"
        strSql += vbCrLf + " IF @COMPANYID <> ''  SET @COMPANYFILTER = ' AND I.COMPANYID IN (' + @COMPANYID+ ')'"
        strSql += vbCrLf + " DECLARE @STRQRY NVARCHAR(4000)  "
        strSql += vbCrLf + " SELECT @STRQRY=' IF  EXISTS (SELECT * FROM sysobjects WHERE xtype = ''U'' AND NAME = '+''''+@TEMPTABLE+''''+' ) DROP TABLE ' + @TEMPTABLE "
        strSql += vbCrLf + " EXECUTE sp_executesql @STRQRY"
        strSql += vbCrLf + " SELECT @STRQRY=' SELECT ISNULL(CC.COSTNAME,'''') AS COSTNAME,'   "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ISNULL(CONVERT(VARCHAR,TRANNO),'''') BILLNO'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,ISNULL(CONVERT(VARCHAR,I.TRANDATE,103),'''')  BILLDATE,IT.ITEMNAME,SIT.SUBITEMNAME'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,I.TAGNO,I.PCS AS PCS,I.GRSWT AS GRSWT,I.LESSWT AS LESSWT,I.NETWT AS NETWT,I.AMOUNT AS AMOUNT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,CASE WHEN I.FLAG =''C'' THEN ''COUNTERSALES'' WHEN FLAG =''B'' THEN ''BACKOFFICE'' ELSE '''' END AS FLAG'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,''1'' RESULT,TRANDATE,TRANNO,CONVERT(VARCHAR(15),SNO)SNO,CONVERT(VARCHAR(1),NULL)COLHEAD'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' INTO '+@TEMPTABLE  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' FROM  '+@CNSTOCKDB+'..ISSUE AS I'"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' INNER JOIN ITEMMAST AS IT ON I.ITEMID = IT.ITEMID AND STOCKTYPE =''T'''"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' LEFT JOIN SUBITEMMAST AS SIT ON I.SUBITEMID = SIT.SUBITEMID '"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' LEFT JOIN COSTCENTRE AS CC ON I.COSTID = CC.COSTID '"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' WHERE TRANDATE BETWEEN ''' +@DATEFROM+''' AND '''+@DATETO+''''  "
        strSql += vbCrLf + " SELECT @STRQRY =@STRQRY + @COMPANYFILTER+@CENTREFILTER+@METALFILTER"
        strSql += vbCrLf + " IF @FLAG='B' SELECT @STRQRY=@STRQRY+' AND FLAG = ''B'''  "
        strSql += vbCrLf + " IF @FLAG='C' SELECT @STRQRY=@STRQRY+' AND FLAG = ''C'''  "
        strSql += vbCrLf + " IF @FLAG='A'   SELECT @STRQRY=@STRQRY+' AND FLAG IN (''C'',''B'')'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ORDER BY TRANDATE'  "
        strSql += vbCrLf + "     EXEC SP_EXECUTESQL @STRQRY  "
        strSql += vbCrLf + " SELECT @STRQRY='IF (SELECT COUNT(*) FROM '+@TEMPTABLE+')>0'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' BEGIN'  "
        strSql += vbCrLf + " IF @GRPITEM = 'Y'  "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' INSERT INTO '+@TEMPTABLE"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (COSTNAME,BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD)'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (SELECT DISTINCT '''' AS COSTNAME,'' '' AS BILLNO,'' ''BILLDATE,ITEMNAME,'' '' AS SUBITEMNAME'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,0 AS PCS,0 AS GRSWT,0 AS LESSWT,0 AS NETWT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,0 AS AMOUNT,'' ''FLAG,''0'' RESULT,'' ''TRANDATE,'' ''TRANNO,''T'' AS COLHEAD'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' FROM '+@TEMPTABLE+' WHERE RESULT = ''1'')'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' INSERT INTO '+@TEMPTABLE  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (COSTNAME,BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD)'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (SELECT COSTNAME,'' '' AS BILLNO,'' ''BILLDATE,ITEMNAME,'' '' AS SUBITEMNAME'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,SUM(PCS) AS PCS,SUM(GRSWT) AS GRSWT,SUM(LESSWT) AS LESSWT,SUM(NETWT) AS NETWT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,SUM(AMOUNT) AS AMOUNT,'' ''FLAG,''2'' RESULT,'' ''TRANDATE,'' ''TRANNO,''S'' AS COLHEAD'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' FROM '+@TEMPTABLE+' WHERE RESULT = ''1'' GROUP BY COSTNAME,ITEMNAME)'  "
        strSql += vbCrLf + " End"
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' INSERT INTO '+@TEMPTABLE  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (COSTNAME,BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD)'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' (SELECT ''ZZZZZZZZ'' AS COSTNAME,'' '' AS BILLNO,'' ''BILLDATE,''ZZZZZZZZ'' AS ITEMNAME,'' '' AS SUBITEMNAME'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,SUM(PCS) AS PCS,SUM(GRSWT) AS GRSWT,SUM(LESSWT) AS LESSWT,SUM(NETWT) AS NETWT'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' ,SUM(AMOUNT) AS AMOUNT,'' ''FLAG,''3'' RESULT,'' ''TRANDATE,'' ''TRANNO,''G''COLHEAD'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' FROM '+@TEMPTABLE+' WHERE RESULT = ''1'')'  "
        strSql += vbCrLf + " SELECT @STRQRY=@STRQRY+' END'  "
        strSql += vbCrLf + " EXEC SP_EXECUTESQL @STRQRY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub



    Private Sub funcSp38GroupLedger()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_GROUPLEDGER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_GROUPLEDGER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE  SP_RPT_GROUPLEDGER"
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " @FROMDATE VARCHAR(20)    "
        strSql += vbCrLf + " ,@TODATE VARCHAR(20)    "
        strSql += vbCrLf + " ,@RPTYPE VARCHAR(1)    "
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(8000)    "
        strSql += vbCrLf + " ,@ACGRPNAME VARCHAR(1000)    "
        strSql += vbCrLf + " ,@ACCNAME VARCHAR(2000)    "
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(10)    "
        strSql += vbCrLf + " ,@NILBAL VARCHAR(1)    "
        strSql += vbCrLf + " ,@SYSID VARCHAR(3)    "
        strSql += vbCrLf + " ,@CRDR VARCHAR(3)    "
        strSql += vbCrLf + " ,@FORMAT VARCHAR(1)    "
        strSql += vbCrLf + " )    "
        strSql += vbCrLf + " AS    "
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(8000)    "
        strSql += vbCrLf + " DECLARE @VAL INTEGER    "
        strSql += vbCrLf + " DECLARE @NATHELLA VARCHAR(20)    "
        strSql += vbCrLf + " SET NOCOUNT ON    "
        strSql += vbCrLf + " DECLARE @TEMP0 VARCHAR(1000)    "
        strSql += vbCrLf + " DECLARE @INCLGV VARCHAR(1)    "
        strSql += vbCrLf + " SELECT @INCLGV=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='INCLUDEGV'    "
        strSql += vbCrLf + " IF @INCLGV='' SELECT @INCLGV='Y'    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ACGROUP', 'U') IS NOT NULL DROP TABLE #ACGROUP    "
        strSql += vbCrLf + " CREATE TABLE #ACGROUP (ACGROUPID INT)    "
        strSql += vbCrLf + " IF @ACGRPNAME = 'ALL'    "
        strSql += vbCrLf + " INSERT INTO #ACGROUP (ACGROUPID) SELECT ACGRPCODE FROM " & cnAdminDb & "..ACGROUP UNION SELECT ''    "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " IF CHARINDEX(',',@ACGRPNAME)=0    "
        strSql += vbCrLf + " INSERT INTO #ACGROUP (ACGROUPID) SELECT ACGRPCODE FROM " & cnAdminDb & "..ACGROUP WHERE ACGRPNAME = @ACGRPNAME    "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@ACGRPNAME)>0    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SET @TEMP0=LEFT(@ACGRPNAME,CHARINDEX(',',@ACGRPNAME)-1)    "
        strSql += vbCrLf + "  SET @ACGRPNAME=RIGHT(@ACGRPNAME,LEN(@ACGRPNAME)-CHARINDEX(',',@ACGRPNAME))    "
        strSql += vbCrLf + "  IF @ACGRPNAME <>'' AND CHARINDEX(',',@ACGRPNAME)=0    "
        strSql += vbCrLf + "  SET @ACGRPNAME= @ACGRPNAME + ','    "
        strSql += vbCrLf + "  INSERT INTO #ACGROUP (ACGROUPID) SELECT ACGRPCODE FROM " & cnAdminDb & "..ACGROUP WHERE ACGRPNAME = @TEMP0    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " /** AC HEAD **/    "
        strSql += vbCrLf + " DECLARE @TEMP1 VARCHAR(1000)    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ACHEAD', 'U') IS NOT NULL DROP TABLE #ACHEAD    "
        strSql += vbCrLf + " CREATE TABLE #ACHEAD (ACCODE VARCHAR(10))    "
        strSql += vbCrLf + " IF @ACCNAME = 'ALL'    "
        strSql += vbCrLf + " INSERT INTO #ACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACGRPCODE IN (SELECT ACGROUPID FROM #ACGROUP) UNION SELECT ''    "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " IF CHARINDEX(',',@ACCNAME)=0     "
        strSql += vbCrLf + " INSERT INTO #ACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACGRPCODE IN (SELECT ACGROUPID FROM #ACGROUP) AND ACNAME = @ACCNAME      "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@ACCNAME)>0         "
        strSql += vbCrLf + " BEGIN         "
        strSql += vbCrLf + "  SET @TEMP1=LEFT(@ACCNAME,CHARINDEX(',',@ACCNAME)-1)         "
        strSql += vbCrLf + "  SET @ACCNAME=RIGHT(@ACCNAME,LEN(@ACCNAME)-CHARINDEX(',',@ACCNAME))         "
        strSql += vbCrLf + "  IF @ACCNAME <>'' AND CHARINDEX(',',@ACCNAME)=0         "
        strSql += vbCrLf + "  SET @ACCNAME= @ACCNAME + ','         "
        strSql += vbCrLf + "  INSERT INTO #ACHEAD (ACCODE) SELECT ACCODE FROM " & cnAdminDb & "..ACHEAD WHERE ACGRPCODE IN (SELECT ACGROUPID FROM #ACGROUP) AND ACNAME = @TEMP1    "
        strSql += vbCrLf + " END          "
        strSql += vbCrLf + " /** COSTNAME SEPERATION **/     "
        strSql += vbCrLf + " DECLARE @TEMP VARCHAR(200)          "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE         "
        strSql += vbCrLf + " CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))         "
        strSql += vbCrLf + " IF @COSTNAME = 'ALL'     "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE UNION SELECT ''     "
        strSql += vbCrLf + " ELSE     "
        strSql += vbCrLf + " IF CHARINDEX(',',@COSTNAME)=0     "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME     "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COSTNAME)>0         "
        strSql += vbCrLf + " BEGIN         "
        strSql += vbCrLf + "  SET @TEMP=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)         "
        strSql += vbCrLf + "  SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))         "
        strSql += vbCrLf + "  IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0         "
        strSql += vbCrLf + "  SET @COSTNAME= @COSTNAME + ','         "
        strSql += vbCrLf + "  INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMP     "
        strSql += vbCrLf + " END         "
        strSql += vbCrLf + " IF @RPTYPE = 'A' OR @RPTYPE = 'L' OR @RPTYPE='W'      "
        strSql += vbCrLf + " BEGIN         "
        strSql += vbCrLf + "  SELECT @QRY =  ' IF OBJECT_ID(''TEMPTABLEDB..GROUPLEDGER_RES'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..GROUPLEDGER_RES'+@SYSID+''    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' SELECT NULL  AS TRANNO,NULL AS TRANDATE'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,'' OPENING '' CONTRA'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,SUM(ISNULL(DEBIT,0)) AS DEBIT'        "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,SUM(ISNULL(CREDIT ,0)) AS CREDIT'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,SUM(ISNULL(DEBIT,0) - ISNULL(CREDIT,0)) AS BALANCE'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,NULL AS CHQCARDNO,NULL AS CARDID,CONVERT(VARCHAR(100),NULL) AS CHQCARDREF,NULL AS CHQDATE,CONVERT(NVARCHAR,'''+@TODATE+''',105) AS FNYDATE'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(STR1 + CASE WHEN STR2 != '''' THEN CHAR(10) + STR2 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR3 != '''' THEN CHAR(10) + STR3 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR4 != '''' THEN CHAR(10) + STR4 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR5 != '''' THEN CHAR(10) + STR5 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR6 != '''' THEN CHAR(10) + STR6 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR7 != '''' THEN CHAR(10) + STR7 ELSE '''' END    '    "
        strSql += vbCrLf + "  /*SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN TIN  != '''' THEN CHAR(10) + ''TIN:'' + TIN  ELSE '''' END    '*/    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN PAN  != '''' THEN CHAR(10) + ''PAN:'' + PAN  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN GSTNO  != '''' THEN CHAR(10) + ''GSTNO:'' + GSTNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN LOCALTAXNO != '''' THEN CHAR(10) + '' LTAX:'' + LOCALTAXNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN CENTRALTAXNO != '''' THEN CHAR(10) + '' CTAX:'' + CENTRALTAXNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,''UN KNOWN'') ACNAME '    "
        strSql += vbCrLf + "  /*SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(STR1,''UN KNOWN'') ACNAME1 '*/    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,STR1 ACNAME1 '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(CASE WHEN STR2 != '''' THEN CHAR(10) + STR2 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR3 != '''' THEN CHAR(10) + STR3 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR4 != '''' THEN CHAR(10) + STR4 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR5 != '''' THEN CHAR(10) + STR5 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR6 != '''' THEN CHAR(10) + STR6 ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN STR7 != '''' THEN CHAR(10) + STR7 ELSE '''' END    '    "
        strSql += vbCrLf + "  /*SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN TIN  != '''' THEN CHAR(10) + ''TIN:'' + TIN  ELSE '''' END    ' */   "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN PAN  != '''' THEN CHAR(10) + ''PAN:'' + PAN  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN GSTNO  != '''' THEN CHAR(10) + ''GSTNO:'' + GSTNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN LOCALTAXNO != '''' THEN CHAR(10) + '' LTAX:'' + LOCALTAXNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' + CASE WHEN CENTRALTAXNO != '''' THEN CHAR(10) + '' CTAX:'' + CENTRALTAXNO  ELSE '''' END    '    "
        strSql += vbCrLf + "  /*SELECT @QRY = @QRY + CHAR(13)+' ,''UN KNOWN'') ACADDRESS '*/    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,NULL) ACADDRESS '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,T.ACCODE,'''' as REMARK'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' INTO TEMPTABLEDB..GROUPLEDGER_RES'+@SYSID+''    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' FROM OPENTRAILBALANCE  AS T LEFT OUTER JOIN'         "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' (SELECT ACCODE,ISNULL(ACNAME,'''') STR1,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') STR2'        "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(ADDRESS2,'''') STR3, CASE WHEN ISNULL(ADDRESS3,'''') != '''' THEN '','' ELSE '''' END + ISNULL(ADDRESS3,'''') STR4'        "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(AREA,'''') + CASE WHEN ISNULL(CITY,'''') != '''' THEN '',''+ISNULL(CITY,'''') ELSE '''' END + ISNULL(PINCODE,'''') + CASE WHEN ISNULL(PINCODE,'''') != '''' THEN ''-'' ELSE '''' END + ISNULL(PINCODE,'''') STR5'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(PHONENO,'''')  + CASE WHEN ISNULL(MOBILE,'''') != '''' THEN '','' ELSE '''' END + ISNULL(MOBILE,'''')  STR6'        "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,CASE WHEN ISNULL(EMAILID,'''') != '''' THEN ''EMAIL:'' ELSE '''' END + ISNULL(EMAILID,'''') STR7 '       "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(TIN,'''') TIN,ISNULL(PAN,'''') PAN,ISNULL(GSTNO,'''') GSTNO,ISNULL(LOCALTAXNO,'''') LOCALTAXNO,ISNULL(CENTRALTAXNO,'''') CENTRALTAXNO '       "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' FROM " & cnAdminDb & "..ACHEAD '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' )X ON  X.ACCODE = T.ACCODE  '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' WHERE   COMPANYID = '''+@COMPANYID+'''  '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' AND T.ACCODE IN (SELECT ACCODE FROM #ACHEAD) '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' AND ISNULL(T.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' GROUP BY  T.ACCODE,STR1,STR2,STR3,STR4,STR5,STR6,STR7,TIN,PAN,GSTNO,LOCALTAXNO,CENTRALTAXNO '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' HAVING SUM(ISNULL(DEBIT,0) - ISNULL(CREDIT,0))<>0 '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' UNION ALL '    "
        strSql += vbCrLf + "  IF @FORMAT<>'Y'     "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + CHAR(13)+' SELECT CONVERT(VARCHAR,TRANNO)TRANNO,CONVERT(NVARCHAR,TRANDATE,105) AS TRANDATE '    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  ELSE    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "   SELECT @QRY = @QRY + CHAR(13)+' SELECT CONVERT(VARCHAR,CASE WHEN FROMFLAG=''P'' THEN TRANNO ELSE 0 END)TRANNO,CONVERT(NVARCHAR,TRANDATE,105) AS TRANDATE '    "
        strSql += vbCrLf + "  END      "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,(SELECT TOP 1 ACNAME FROM " & cnAdminDb & "..ACHEAD WHERE ACCODE = T.CONTRA)CONTRA '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+' ,ISNULL(CASE WHEN TRANMODE = ''D'' THEN AMOUNT END,0) AS DEBIT '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+',ISNULL(CASE WHEN TRANMODE = ''C'' THEN AMOUNT END,0) AS CREDIT '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+',ISNULL(CASE WHEN TRANMODE = ''D'' THEN AMOUNT ELSE -1* AMOUNT END,0) AS BAL'    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+',CHQCARDNO,CARDID,CHQCARDREF,CONVERT(NVARCHAR,CHQDATE,105) AS CHQDATE  ,CONVERT(NVARCHAR,'''+@TODATE+''',105) AS FNYDATE '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+',ISNULL(STR1 + CASE WHEN STR2 != '''' THEN CHAR(10) + STR2 ELSE '''' END '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN STR3 != '''' THEN CHAR(10) + STR3 ELSE '''' END  '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN STR4 != '''' THEN CHAR(10) + STR4 ELSE '''' END  '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN STR5 != '''' THEN CHAR(10) + STR5 ELSE '''' END  '     "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN STR6 != '''' THEN CHAR(10) + STR6 ELSE '''' END  '    "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN STR7 != '''' THEN CHAR(10) + STR7 ELSE '''' END  '    "
        strSql += vbCrLf + " /* SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN TIN  != '''' THEN CHAR(10) + ''TIN:'' + TIN  ELSE '''' END    ' */   "
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13)+'+ CASE WHEN PAN  != '''' THEN CHAR(10) + ''PAN:'' + PAN  ELSE '''' END    '   "
