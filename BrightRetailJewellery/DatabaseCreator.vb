    Function funcSP12_Purchase() As Integer
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PURCHASE_SRETURN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PURCHASE_SRETURN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_PURCHASE_SRETURN    "
        strSql += vbCrLf + "    (    "
        strSql += vbCrLf + "    @FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + "    ,@TODATE SMALLDATETIME    "
        strSql += vbCrLf + "    ,@GROUPBY VARCHAR(1)    "
        strSql += vbCrLf + "    ,@COMPANYID VARCHAR(500)    "
        strSql += vbCrLf + "    ,@TRANTYPE VARCHAR(500)    "
        strSql += vbCrLf + "    ,@METALNAME VARCHAR(500)    "
        strSql += vbCrLf + "    ,@COSTNAME VARCHAR(500)    "
        strSql += vbCrLf + "    ,@RPTTYPE VARCHAR(1)  "
        strSql += vbCrLf + "    )    "
        strSql += vbCrLf + "    AS    "
        strSql += vbCrLf + "    SET NOCOUNT ON    "
        strSql += vbCrLf + " -- -- DECLARE @FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + " -- -- DECLARE @TODATE SMALLDATETIME    "
        strSql += vbCrLf + " -- -- DECLARE @GROUPBY VARCHAR(1)    "
        strSql += vbCrLf + " -- -- DECLARE @COMPANYID VARCHAR(500)    "
        strSql += vbCrLf + " -- -- DECLARE @TRANTYPE VARCHAR(500)    "
        strSql += vbCrLf + " -- -- DECLARE @METALNAME VARCHAR(500)    "
        strSql += vbCrLf + " -- -- DECLARE @COSTNAME VARCHAR(500)    "
        strSql += vbCrLf + " -- -- DECLARE @RPTTYPE VARCHAR(1)  "
        strSql += vbCrLf + " -- -- SET @RPTTYPE = 'S'  "
        strSql += vbCrLf + " -- -- SET @GROUPBY = 'N' /** (N)ONE (I)TEM TYPE**/    "
        strSql += vbCrLf + " -- -- SET @FROMDATE = '2010-11-01'    "
        strSql += vbCrLf + " -- -- SET @TODATE = '2010-12-06'    "
        strSql += vbCrLf + " -- -- SET @COMPANYID = 'ALL'  "
        strSql += vbCrLf + " -- -- SET @TRANTYPE = 'ALL'  "
        strSql += vbCrLf + " -- -- SET @METALNAME = 'ALL'  "
        strSql += vbCrLf + " -- -- SET @COSTNAME = 'ALL'  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     DECLARE @TEMP VARCHAR(200)    "
        strSql += vbCrLf + "     /** COMPANYID SEPERATION **/"
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY    "
        strSql += vbCrLf + "     CREATE TABLE #COMPANY (COMPANYID VARCHAR(7))    "
        strSql += vbCrLf + "     IF @COMPANYID = 'ALL' "
        strSql += vbCrLf + "      INSERT INTO #COMPANY (COMPANYID) SELECT COMPANYID FROM " & compId & "ADMINDB..COMPANY UNION ALL SELECT ''"
        strSql += vbCrLf + "     ELSE"
        strSql += vbCrLf + "      IF CHARINDEX(',',@COMPANYID)=0"
        strSql += vbCrLf + "       BEGIN"
        strSql += vbCrLf + "       INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID"
        strSql += vbCrLf + "     WHILE CHARINDEX(',',@COMPANYID)>0    "
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "     SET @TEMP=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)    "
        strSql += vbCrLf + "     SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))    "
        strSql += vbCrLf + "     IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "     SET @COMPANYID= @COMPANYID + ','    "
        strSql += vbCrLf + "     INSERT INTO #COMPANY (COMPANYID) SELECT @TEMP"
        strSql += vbCrLf + "     END     "
        strSql += vbCrLf + "       END    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "     /** TRANTYPE SEPERATION **/"
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#TRANTYPE', 'U') IS NOT NULL DROP TABLE #TRANTYPE    "
        strSql += vbCrLf + "     CREATE TABLE #TRANTYPE (TRANTYPE VARCHAR(7))    "
        strSql += vbCrLf + "     IF @TRANTYPE = 'ALL' "
        strSql += vbCrLf + "      INSERT INTO #TRANTYPE (TRANTYPE) SELECT 'PU' UNION ALL SELECT 'SR'    "
        strSql += vbCrLf + "     ELSE"
        strSql += vbCrLf + "      IF CHARINDEX(',',@TRANTYPE)=0"
        strSql += vbCrLf + "       BEGIN"
        strSql += vbCrLf + "       INSERT INTO #TRANTYPE (TRANTYPE) SELECT @TRANTYPE"
        strSql += vbCrLf + "     WHILE CHARINDEX(',',@TRANTYPE)>0    "
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "     SET @TEMP=LEFT(@TRANTYPE,CHARINDEX(',',@TRANTYPE)-1)    "
        strSql += vbCrLf + "     SET @TRANTYPE=RIGHT(@TRANTYPE,LEN(@TRANTYPE)-CHARINDEX(',',@TRANTYPE))    "
        strSql += vbCrLf + "     IF @TRANTYPE <>'' AND CHARINDEX(',',@TRANTYPE)=0    "
        strSql += vbCrLf + "     SET @TRANTYPE= @TRANTYPE + ','    "
        strSql += vbCrLf + "     INSERT INTO #TRANTYPE (TRANTYPE) SELECT @TEMP"
        strSql += vbCrLf + "     END     "
        strSql += vbCrLf + "       END    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE    "
        strSql += vbCrLf + "     CREATE TABLE #COSTCENTRE (COSTID VARCHAR(2))    "
        strSql += vbCrLf + "     IF @COSTNAME = 'ALL' OR @COSTNAME = ''    "
        strSql += vbCrLf + "     INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE UNION ALL SELECT ''    "
        strSql += vbCrLf + "     ELSE    "
        strSql += vbCrLf + "     INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = @COSTNAME    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#METAL', 'U') IS NOT NULL DROP TABLE #METAL    "
        strSql += vbCrLf + "     CREATE TABLE #METAL (METALID VARCHAR(2))    "
        strSql += vbCrLf + "     IF @METALNAME = 'ALL' OR @METALNAME = ''    "
        strSql += vbCrLf + "     INSERT INTO #METAL(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST    "
        strSql += vbCrLf + "     ELSE    "
        strSql += vbCrLf + "     INSERT INTO #METAL(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METALNAME    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPDB..#PUSR_VIEW') IS NOT NULL DROP TABLE #PUSR_VIEW    "
        strSql += vbCrLf + "    SELECT    "
        strSql += vbCrLf + "    CONVERT(VARCHAR(400),NULL)AS PARTICULAR"
        strSql += vbCrLf + "    ,R.TRANNO    "
        strSql += vbCrLf + "    ,R.TRANDATE    "
        strSql += vbCrLf + "    ,CASE WHEN ISNULL(SM.SUBITEMNAME,'') <> '' THEN SM.SUBITEMNAME WHEN ISNULL(IM.ITEMNAME,'') <> '' THEN IM.ITEMNAME ELSE C.CATNAME END AS DESCRIPT    "
        strSql += vbCrLf + "    ,(SELECT NAME FROM " & compId & "ADMINDB..ITEMTYPE WHERE ITEMTYPEID = R.ITEMTYPEID)AS ITEMTYPE    "
        strSql += vbCrLf + "    ,CONVERT(NUMERIC(15,2),R.PURITY)PURITY,R.PCS,R.GRSWT    "
        strSql += vbCrLf + "    ,ISNULL((SELECT SUM(STNWT) FROM  " & tranDbName & "..RECEIPTSTONE WHERE ISSSNO = R.SNO),0) + ISNULL(DUSTWT,0)STONEWT    "
        strSql += vbCrLf + "    ,R.WASTAGE,R.WASTPER,R.NETWT,R.RATE,R.AMOUNT,CONVERT(VARCHAR(20),CASE WHEN R.TRANTYPE = 'PU' THEN 'PURCHASE' ELSE 'SALES RETURN' END) AS TRANTYPE    "
        strSql += vbCrLf + "    ,(SELECT EMPNAME FROM " & compId & "ADMINDB..EMPMASTER WHERE EMPID=R.EMPID)EMPNAME    "
        strSql += vbCrLf + "    ,(SELECT METALNAME FROM " & compId & "ADMINDB..METALMAST WHERE METALID = R.METALID)AS METALNAME"
        strSql += vbCrLf + "    ,CONVERT(VARCHAR(300),NULL)GROUP1,CONVERT(VARCHAR(300),NULL)GROUP2,CONVERT(VARCHAR(300),NULL)GROUP3    "
        strSql += vbCrLf + "    ,CONVERT(INT,1)ORDG1,CONVERT(INT,1)ORDG2,CONVERT(INT,1)ORDG3,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + "    INTO #PUSR_VIEW  "
        strSql += vbCrLf + "    FROM " & tranDbName & "..RECEIPT AS R     "
        strSql += vbCrLf + "    INNER JOIN " & compId & "ADMINDB..CATEGORY AS C ON C.CATCODE = R.CATCODE    "
        strSql += vbCrLf + "    LEFT OUTER JOIN " & compId & "ADMINDB..ITEMMAST AS IM ON IM.ITEMID = R.ITEMID    "
        strSql += vbCrLf + "    LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS SM ON SM.ITEMID = R.ITEMID AND SM.SUBITEMID =R.SUBITEMID    "
        strSql += vbCrLf + "    WHERE R.TRANDATE BETWEEN @FROMDATE AND @TODATE    "
        strSql += vbCrLf + "    AND ISNULL(R.CANCEL,'') = ''    "
        strSql += vbCrLf + "    AND R.TRANTYPE IN (SELECT TRANTYPE FROM #TRANTYPE)    "
        strSql += vbCrLf + "    AND R.CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (SELECT METALID FROM #METAL))    "
        strSql += vbCrLf + "    AND ISNULL(R.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)"
        strSql += vbCrLf + "    AND R.GRSWT <> 0"
        strSql += vbCrLf + "    AND R.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)"
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    IF @GROUPBY = 'N'    "
        strSql += vbCrLf + "     UPDATE #PUSR_VIEW SET PARTICULAR = ' ' + DESCRIPT,GROUP1 = TRANTYPE,GROUP2 = METALNAME"
        strSql += vbCrLf + "    ELSE IF @GROUPBY = 'I' /**ITEMTYPE**/    "
        strSql += vbCrLf + "     UPDATE #PUSR_VIEW SET PARTICULAR = '   ' + DESCRIPT,GROUP1 = TRANTYPE,GROUP2 = METALNAME,GROUP3 = ITEMTYPE    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    IF @RPTTYPE = 'S'  "
        strSql += vbCrLf + "      UPDATE #PUSR_VIEW SET PARTICULAR = NULL,TRANNO = NULL,TRANDATE = NULL,DESCRIPT = NULL,PURITY = NULL,RATE = NULL,EMPNAME = NULL,TRANTYPE = NULL,ITEMTYPE = NULL  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPDB..#PUSR') IS NOT NULL DROP TABLE #PUSR  "
        strSql += vbCrLf + "   SELECT PARTICULAR,TRANNO,TRANDATE,DESCRIPT,ITEMTYPE,PURITY  "
        strSql += vbCrLf + "   ,SUM(PCS)PCS,SUM(GRSWT)GRSWT,SUM(STONEWT)STONEWT,SUM(WASTAGE)WASTAGE,AVG(WASTPER) WASTPER,SUM(NETWT)NETWT,RATE,SUM(AMOUNT)AMOUNT  "
        strSql += vbCrLf + "   ,TRANTYPE,EMPNAME,GROUP1,GROUP2,GROUP3,ORDG1,ORDG2,ORDG3,COLHEAD,METALNAME"
        strSql += vbCrLf + "   INTO #PUSR  "
        strSql += vbCrLf + "   FROM #PUSR_VIEW  "
        strSql += vbCrLf + "   GROUP BY PARTICULAR,TRANNO,TRANDATE,DESCRIPT,ITEMTYPE,PURITY,RATE,TRANTYPE,EMPNAME,GROUP1,GROUP2,GROUP3,ORDG1,ORDG2,COLHEAD,METALNAME,ORDG3"
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     /** INSERT GROUP1 TITLE PU,SR**/    "
        strSql += vbCrLf + "    INSERT INTO #PUSR(PARTICULAR,GROUP1,ORDG1,ORDG2,ORDG3,COLHEAD)    "
        strSql += vbCrLf + "    SELECT DISTINCT GROUP1,GROUP1,0 ORDG1,0 ORDG2,0 ORDG3,'T' FROM #PUSR WHERE COLHEAD IS NULL"
        strSql += vbCrLf + "    /** INSERT GROUP1 SUBTOTAL **/    "
        strSql += vbCrLf + "    INSERT INTO #PUSR(PARTICULAR,GROUP1,ORDG1,ORDG2,ORDG3,COLHEAD,PCS,GRSWT,STONEWT,WASTAGE,WASTPER,NETWT,AMOUNT)    "
        strSql += vbCrLf + "    SELECT CASE WHEN @RPTTYPE = 'S' THEN GROUP1 ELSE GROUP1 + ' SUBTOTAL' END GROUP1,GROUP1,2 ORDG1,1 ORDG2,1 ORDG3,'S'     "
        strSql += vbCrLf + "    ,SUM(PCS),SUM(GRSWT),SUM(STONEWT),SUM(WASTAGE),AVG(WASTPER),SUM(NETWT),SUM(AMOUNT)    "
        strSql += vbCrLf + "    FROM #PUSR WHERE COLHEAD IS NULL GROUP BY GROUP1    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "     /** INSERT GROUP2 TITLE **/    "
        strSql += vbCrLf + "     INSERT INTO #PUSR(PARTICULAR,GROUP1,GROUP2,ORDG1,ORDG2,COLHEAD)    "
        strSql += vbCrLf + "     SELECT DISTINCT ' ' + GROUP2,GROUP1,GROUP2,1 ORDG1,0 ORDG2,'T1' FROM #PUSR WHERE COLHEAD IS NULL"
        strSql += vbCrLf + "     /** INSERT GROUP2 SUBTOTAL **/    "
        strSql += vbCrLf + "     INSERT INTO #PUSR(PARTICULAR,GROUP1,GROUP2,ORDG1,ORDG2,ORDG3,COLHEAD,PCS,GRSWT,STONEWT,WASTAGE,WASTPER,NETWT,AMOUNT)    "
        strSql += vbCrLf + "     SELECT GROUP2 + ' SUBTOTAL',GROUP1,GROUP2,1 ORDG1,3 ORDG2,2 ORDG3,'S1'     "
        strSql += vbCrLf + "     ,SUM(PCS),SUM(GRSWT),SUM(STONEWT),SUM(WASTAGE),AVG(WASTPER),SUM(NETWT),SUM(AMOUNT)    "
        strSql += vbCrLf + "     FROM #PUSR WHERE COLHEAD IS NULL GROUP BY GROUP1,GROUP2    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "    IF @GROUPBY = 'I'    "
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "     /** INSERT GROUP2 TITLE **/    "
        strSql += vbCrLf + "     INSERT INTO #PUSR(PARTICULAR,GROUP1,GROUP2,GROUP3,ORDG1,ORDG2,ORDG3,COLHEAD)    "
        strSql += vbCrLf + "     SELECT DISTINCT ' ' + GROUP3,GROUP1,GROUP2,GROUP3,1 ORDG1,1 ORDG2,0 ORDG3,'T2' FROM #PUSR WHERE COLHEAD IS NULL"
        strSql += vbCrLf + "     /** INSERT GROUP2 SUBTOTAL **/    "
        strSql += vbCrLf + "     INSERT INTO #PUSR(PARTICULAR,GROUP1,GROUP2,GROUP3,ORDG1,ORDG2,ORDG3,COLHEAD,PCS,GRSWT,STONEWT,WASTAGE,WASTPER,NETWT,AMOUNT)    "
        strSql += vbCrLf + "     SELECT ' '+CASE WHEN @RPTTYPE = 'S' THEN GROUP3 ELSE GROUP3 +' SUBTOTAL' END,GROUP1,GROUP2,GROUP3,1 ORDG1,2 ORDG2,2 ORDG3,'S2'     "
        strSql += vbCrLf + "     ,SUM(PCS),SUM(GRSWT),SUM(STONEWT),SUM(WASTAGE),AVG(WASTPER),SUM(NETWT),SUM(AMOUNT)    "
        strSql += vbCrLf + "     FROM #PUSR WHERE COLHEAD IS NULL GROUP BY GROUP1,GROUP2,GROUP3    "
        strSql += vbCrLf + "     END    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    UPDATE #PUSR SET     "
        strSql += vbCrLf + "    PCS = CASE WHEN PCS = 0 THEN NULL ELSE PCS END    "
        strSql += vbCrLf + "    ,GRSWT = CASE WHEN GRSWT = 0 THEN NULL ELSE GRSWT END    "
        strSql += vbCrLf + "    ,STONEWT = CASE WHEN STONEWT = 0 THEN NULL ELSE STONEWT END    "
        strSql += vbCrLf + "    ,WASTAGE = CASE WHEN WASTAGE = 0 THEN NULL ELSE WASTAGE END    "
        strSql += vbCrLf + "    ,WASTPER = CASE WHEN WASTPER = 0 THEN NULL ELSE WASTPER END    "
        strSql += vbCrLf + "    ,NETWT = CASE WHEN NETWT = 0 THEN NULL ELSE NETWT END    "
        strSql += vbCrLf + "    ,AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "    /** INSERT GRAND TOTAL **/    "
        strSql += vbCrLf + "    INSERT INTO #PUSR(PARTICULAR,GROUP1,GROUP2,GROUP3,ORDG1,ORDG2,ORDG3,COLHEAD,PCS,GRSWT,STONEWT,WASTAGE,WASTPER,NETWT,AMOUNT)    "
        strSql += vbCrLf + "    SELECT 'GRAND TOTAL'GROUP1,'ZZZZZZZ' GROUP1,'ZZZZZZ','ZZZZZZZZZ',3 ORDG1,3 ORDG2,3 ORDG3,'G',SUM(PCS),SUM(GRSWT),SUM(STONEWT),SUM(WASTAGE),AVG(WASTPER),SUM(NETWT),SUM(AMOUNT)  "
        strSql += vbCrLf + "    FROM #PUSR WHERE COLHEAD IS NULL"
        strSql += vbCrLf + " -- --     "
        strSql += vbCrLf + "    IF @RPTTYPE = 'S'  "
        strSql += vbCrLf + "      BEGIN  "
        strSql += vbCrLf + "      DELETE FROM #PUSR WHERE COLHEAD = 'T2' OR COLHEAD IS NULL"
        strSql += vbCrLf + "       IF @GROUPBY = 'N' "
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 		DELETE FROM #PUSR WHERE COLHEAD = 'T1'"
        strSql += vbCrLf + " 		UPDATE #PUSR SET PARTICULAR = GROUP2 WHERE COLHEAD = 'S1'"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + "      END  "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "    SELECT * FROM #PUSR ORDER BY GROUP1,ORDG1,GROUP2,ORDG2,GROUP3,ORDG3,TRANDATE,TRANNO"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function


    Private Sub funcSP19_DayBook()
        strSql = "  IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK"
        strSql += " IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK1')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_DAYBOOK')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_DAYBOOK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()


        strSql = vbCrLf + " CREATE PROCEDURE SP_DAYBOOK"
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "  @FRMDATE VARCHAR(12) "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(12) "
        strSql += vbCrLf + "  ,@OPENING VARCHAR(1) "
        strSql += vbCrLf + "  ,@PAGEBREAK VARCHAR(1) "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(100) "
        strSql += vbCrLf + "  ,@COSTID VARCHAR(300)           "
        strSql += vbCrLf + "  ,@DETAILED VARCHAR(1)"
        strSql += vbCrLf + "  ,@SUMMARY VARCHAR(1) "
        strSql += vbCrLf + "  ,@ORDERBY VARCHAR(1)    "
        strSql += vbCrLf + "  ,@USERID VARCHAR(800) "
        strSql += vbCrLf + "  ) "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "   	/** "
        strSql += vbCrLf + "   	RESULT = 1 OPENING CASH "
        strSql += vbCrLf + "   	RESULT = 2 TRANSATION "
        strSql += vbCrLf + "   	RESULT = 3 TOTAL "
        strSql += vbCrLf + "   	RESULT = 4 CLOSING "
        strSql += vbCrLf + "   	RESULT = 5 PAGEBREAK "
        strSql += vbCrLf + "   	**/    "
        strSql += vbCrLf + "   	DECLARE @USER VARCHAR(1000)  "
        strSql += vbCrLf + "   	SET @USER=@USERID  "
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE           "
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#NONPOSBATCHNO', 'U') IS NOT NULL DROP TABLE #NONPOSBATCHNO "
        strSql += vbCrLf + "   	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3)) "
        strSql += vbCrLf + "   	DECLARE @TEMPID VARCHAR(5) "
        strSql += vbCrLf + "   	IF CHARINDEX(',',@COSTID)=0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	INSERT INTO #COSTCENTRE (COSTID) SELECT @COSTID "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   	WHILE CHARINDEX(',',@COSTID)>0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	SET @TEMPID=LEFT(@COSTID,CHARINDEX(',',@COSTID)-1) "
        strSql += vbCrLf + "   	SET @COSTID=RIGHT(@COSTID,LEN(@COSTID)-CHARINDEX(',',@COSTID)) "
        strSql += vbCrLf + "   	IF @COSTID <>'' AND CHARINDEX(',',@COSTID)=0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	SET @COSTID= @COSTID + ',' "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   	INSERT INTO #COSTCENTRE (COSTID) SELECT @TEMPID "
        strSql += vbCrLf + "   	END     "
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY "
        strSql += vbCrLf + "  	 CREATE TABLE #COMPANY (COMPANYID VARCHAR(3)) "
        strSql += vbCrLf + "  	 DECLARE @TCOMPANY VARCHAR(3) "
        strSql += vbCrLf + "  	 IF CHARINDEX(',',@COMPANYID)=0 "
        strSql += vbCrLf + "  	 INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID "
        strSql += vbCrLf + "  	 WHILE CHARINDEX(',',@COMPANYID)>0 "
        strSql += vbCrLf + "  	 BEGIN "
        strSql += vbCrLf + "  	 SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1) "
        strSql += vbCrLf + "  	 SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID)) "
        strSql += vbCrLf + "  	 IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0 "
        strSql += vbCrLf + "  	 SET @COMPANYID= @COMPANYID + ',' "
        strSql += vbCrLf + "  	 INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY "
        strSql += vbCrLf + "     END  	"
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#USERNAME', 'U') IS NOT NULL DROP TABLE #USERNAME"
        strSql += vbCrLf + "   	CREATE TABLE #USERNAME (USERID VARCHAR(6)) "
        strSql += vbCrLf + "   	DECLARE @TEMPUSERID VARCHAR(5) "
        strSql += vbCrLf + "   	IF CHARINDEX(',',@USERID)=0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	INSERT INTO #USERNAME (USERID) SELECT @USERID "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   	WHILE CHARINDEX(',',@USERID)>0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	SET @TEMPUSERID=LEFT(@USERID,CHARINDEX(',',@USERID)-1) "
        strSql += vbCrLf + "   	SET @USERID=RIGHT(@USERID,LEN(@USERID)-CHARINDEX(',',@USERID)) "
        strSql += vbCrLf + "   	IF @USERID <>'' AND CHARINDEX(',',@USERID)=0 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	SET @USERID= @USERID + ',' "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   	INSERT INTO #USERNAME (USERID) SELECT @TEMPUSERID "
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#CASHACC', 'U') IS NOT NULL DROP TABLE #CASHACC     "
        strSql += vbCrLf + "   	CREATE TABLE #CASHACC(ACCODE VARCHAR(7))    "
        strSql += vbCrLf + "   	INSERT INTO #CASHACC(ACCODE) SELECT ACCODE FROM " + cnAdminDb + "..ACHEAD WHERE ACTYPE = 'H' AND ACCODE IN (SELECT CTLTEXT FROM " + cnAdminDb + "..SOFTCONTROL WHERE CTLID = 'CASH')"
        strSql += vbCrLf + "   	SET NOCOUNT ON "
        strSql += vbCrLf + "   	SELECT * INTO #NONPOSBATCHNO "
        strSql += vbCrLf + "   	FROM "
        strSql += vbCrLf + "   	( "
        strSql += vbCrLf + "   	SELECT DISTINCT BATCHNO FROM ACCTRAN      "
        strSql += vbCrLf + "   	WHERE TRANDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + "   	 AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(FROMFLAG,'') = 'A'      "
        strSql += vbCrLf + "   	 AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)"
        strSql += vbCrLf + "   	)X      "
        strSql += vbCrLf + "   	IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPDAYBOOK')>0 DROP TABLE TEMPTABLEDB..TEMPDAYBOOK "
        strSql += vbCrLf + "   	CREATE TABLE TEMPTABLEDB..TEMPDAYBOOK "
        strSql += vbCrLf + "   	( "
        strSql += vbCrLf + "   	TDATE VARCHAR(12) "
        strSql += vbCrLf + "   	,TRANNO INT "
        strSql += vbCrLf + "   	,PARTICULAR VARCHAR(1000) "
        strSql += vbCrLf + "   	,DEBIT NUMERIC(15,2) "
        strSql += vbCrLf + "   	,CREDIT NUMERIC(15,2) "
        strSql += vbCrLf + "   	,GRSWT NUMERIC(15,3) "
        strSql += vbCrLf + "   	,COLHEAD VARCHAR(1) "
        strSql += vbCrLf + "   	,RESULT INT "
        strSql += vbCrLf + "   	,ACCODE VARCHAR(50)     "
        strSql += vbCrLf + "   	,PAYMODE VARCHAR(50) "
        strSql += vbCrLf + "   	,PAGEBREAK VARCHAR(10) "
        strSql += vbCrLf + "   	,TRANDATE SMALLDATETIME      "
        strSql += vbCrLf + "   	,SNO INT IDENTITY(1,1)      "
        strSql += vbCrLf + "   	,BATCHNO VARCHAR(15)      "
        strSql += vbCrLf + "   	,REFNO VARCHAR(25)  "
        strSql += vbCrLf + "   	,REFDATE SMALLDATETIME  "
        strSql += vbCrLf + "   	,CHQCARDNO VARCHAR(30)  "
        strSql += vbCrLf + "   	,CHQDATE SMALLDATETIME  "
        strSql += vbCrLf + "   	,ENTRYORDER INT     "
        strSql += vbCrLf + "   	,TMP NUMERIC(15,2) "
        strSql += vbCrLf + "   	) "
        strSql += vbCrLf + "   	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "   	/** OPENING CASH **/     "
        strSql += vbCrLf + "   	IF @OPENING = 'Y' "
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		SELECT @QRY=CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR,DEBIT,CREDIT,ACCODE,COLHEAD,RESULT)   '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' SELECT TRANDATE,CONVERT(VARCHAR,'''')TRANNO,''CASH OPENING''ACNAME              '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN SUM(CREDIT)- SUM(DEBIT) > 0 THEN SUM(CREDIT)- SUM(DEBIT) ELSE 0 END AS DEBIT'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN SUM(DEBIT) - SUM(CREDIT) > 0 THEN SUM(DEBIT) - SUM(CREDIT) ELSE 0 END AS CREDIT '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(VARCHAR(8),NULL) ACCODE,''T'',1  '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' FROM'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ('"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT T.TRANDATE,CONVERT(VARCHAR,'''')TRANNO'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL((SELECT SUM(DEBIT) FROM OPENTRAILBALANCE '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) '"
        strSql += vbCrLf + "   		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID = '''+@COMPANYID+''' '*/"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) '"
        strSql += vbCrLf + "   		IF @USER<>'ALL'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+' AND USERID IN (SELECT USERID FROM #USERNAME)'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ),0) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' + ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE 0 END) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' FROM ACCTRAN  WHERE TRANDATE < T.TRANDATE AND ACCODE IN (SELECT ACCODE FROM #CASHACC)'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(CANCEL,'''') = '''' '"
        strSql += vbCrLf + "   		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN ('''+@COMPANYID+''')  '*/"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '"
        strSql += vbCrLf + "   		IF @USER<>'ALL'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(USERID,'''') IN (SELECT USERID FROM #USERNAME) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ),0) AS DEBIT'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL((SELECT SUM(CREDIT) FROM OPENTRAILBALANCE '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) '"
        strSql += vbCrLf + "   		/*SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID = '''+@COMPANYID+''' '*/"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND COSTID IN (SELECT COSTID FROM #COSTCENTRE) '"
        strSql += vbCrLf + "   		IF @USER<>'ALL'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+' AND USERID IN (SELECT USERID FROM #USERNAME) '"
