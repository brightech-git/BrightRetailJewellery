        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'UNION ALL'  "
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+'SELECT ''0'' AS DTYPE, '  "
