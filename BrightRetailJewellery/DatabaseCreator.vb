        strSql += vbCrLf + "  		WHERE TRANTYPE  = ''A'' AND A.TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''      "
        strSql += vbCrLf + "  		AND O.PAYMODE = ''AR'' AND O.RECPAY = ''R''  AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'')   AND ISNULL(O.CANCEL,'''') <>''Y''"
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)    "
