    Private Sub Sp_RPT_WALL_LEDGER_SUMMARY()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Sp_RPT_WALL_LEDGER_SUMMARY')>0"
        strSql += vbCrLf + "  DROP PROCEDURE Sp_RPT_WALL_LEDGER_SUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE Procedure  Sp_RPT_WALL_LEDGER_SUMMARY "
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@CUMULATIVE VARCHAR(1),         "
        strSql += vbCrLf + " @CUSTNAME VARCHAR(8000),@CUST VARCHAR(1)         "
        strSql += vbCrLf + " AS          "
        strSql += vbCrLf + " SET  NOCOUNT ON          "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " -- //SELECT @FROMDATE  = '2010-12-02'         "
        strSql += vbCrLf + " -- //SELECT @TODATE  = '2010-12-02'         "
        strSql += vbCrLf + " DECLARE @TEMP_ACNAME VARCHAR(250)            "
        strSql += vbCrLf + " DECLARE @CHKVAL INT          "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMP..TEMP_ACHEAD', 'U') IS NOT NULL DROP TABLE #TEMP_ACHEAD  "
        strSql += vbCrLf + " CREATE TABLE #TEMP_ACHEAD (ACNAME VARCHAR(250))               "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF CHARINDEX(',',@CUSTNAME)=0               "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @CUSTNAME               "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@CUSTNAME)>0               "
        strSql += vbCrLf + " BEGIN     "
        strSql += vbCrLf + " SET @TEMP_ACNAME=LEFT(@CUSTNAME,CHARINDEX(',',@CUSTNAME)-1)            "
        strSql += vbCrLf + " SET @CUSTNAME=RIGHT(@CUSTNAME,LEN(@CUSTNAME)-CHARINDEX(',',@CUSTNAME))          "
        strSql += vbCrLf + " IF @CUSTNAME <>'' AND CHARINDEX(',',@CUSTNAME)=0               "
        strSql += vbCrLf + " SET @CUSTNAME= @CUSTNAME + ','             "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @TEMP_ACNAME     "
        strSql += vbCrLf + " END   "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_WTLEDGEROPENING') IS NOT NULL DROP TABLE MASTER..TEMP_WTLEDGEROPENING      "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,    "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN CASE WHEN ISNULL(PUREWT,0) > 0 THEN PUREWT ELSE NULL END    "
        strSql += vbCrLf + " ELSE CASE WHEN ISNULL(PUREWT,0) > 0 THEN NULL ELSE -1*PUREWT END END AS ISSWT,    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN CASE WHEN ISNULL(AMOUNT,0) > 0 THEN AMOUNT ELSE NULL END     "
        strSql += vbCrLf + " ELSE CASE WHEN ISNULL(AMOUNT,0) > 0 THEN NULL ELSE -1*AMOUNT END END AS ISSAMT,    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN CASE WHEN ISNULL(PUREWT,0) > 0 THEN NULL ELSE -1*PUREWT END     "
        strSql += vbCrLf + " ELSE CASE WHEN ISNULL(PUREWT,0) > 0 THEN PUREWT ELSE NULL END END AS RECWT,    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN CASE WHEN ISNULL(AMOUNT,0) > 0 THEN NULL ELSE -1*AMOUNT END     "
        strSql += vbCrLf + " ELSE CASE WHEN ISNULL(AMOUNT,0) > 0 THEN AMOUNT ELSE NULL END END AS RECAMT    "
        strSql += vbCrLf + " INTO MASTER..TEMP_WTLEDGEROPENING    "
        strSql += vbCrLf + " FROM    "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,SUM(PUREWT) AS PUREWT,SUM(AMOUNT) AS AMOUNT      "
        strSql += vbCrLf + " FROM     "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,NULL TRANDATE,   "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN (CASE WHEN TRANTYPE = 'I' THEN PUREWT ELSE -1*PUREWT END) ELSE    "
        strSql += vbCrLf + " (CASE WHEN TRANTYPE = 'I' THEN -1*PUREWT ELSE PUREWT END) END AS PUREWT ,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT           "
        strSql += vbCrLf + " FROM " & tranDbName & "..OPENWEIGHT   AS T      "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD))          "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,NULL TRANDATE, "
        strSql += vbCrLf + " 0 PUREWT,DEBIT-CREDIT AMOUNT          "
        strSql += vbCrLf + " FROM " & tranDbName & "..OPENTRAILBALANCE    AS T     "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD))         "
        strSql += vbCrLf + " UNION ALL          "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,NULL TRANDATE, "
        strSql += vbCrLf + " 0 PUREWT,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT FROM " & tranDbName & "..ACCTRAN  AS T       "
        strSql += vbCrLf + " WHERE TRANDATE < @FROMDATE AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD)) AND ISNULL(CANCEL,'') = ''         "
        strSql += vbCrLf + " UNION ALL     "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,NULL TRANDATE, "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN PUREWT ELSE -1*PUREWT END AS PUREWT , 0 AS AMOUNT FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')=''    "
        strSql += vbCrLf + " AND TRANTYPE NOT IN ('AI','IAP') AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD))        "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,NULL TRANDATE, "
        strSql += vbCrLf + " CASE WHEN @CUST='Y' THEN -1*PUREWT ELSE PUREWT END AS PUREWT , 0 AS AMOUNT FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE < @FROMDATE  AND ISNULL(CANCEL,'')=''    "
        strSql += vbCrLf + " AND TRANTYPE NOT IN ('AR','RAP') AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD))     "
        strSql += vbCrLf + " ) AS X GROUP BY ACNAME,TRANDATE    "
        strSql += vbCrLf + " ) AS STMT    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_WTLEDGERISSUE') IS NOT NULL DROP TABLE MASTER..TEMP_WTLEDGERISSUE     "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,SUM(ISSWT) AS  ISSWT,SUM(ISSAMT) AS ISSAMT,SUM(RECWT) AS  RECWT,SUM(RECAMT) AS RECAMT,TRANNO    "
        strSql += vbCrLf + " INTO MASTER..TEMP_WTLEDGERISSUE"
        strSql += vbCrLf + " FROM     "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME, TRANDATE,TRANNO,       "
        strSql += vbCrLf + " PUREWT AS ISSWT,0 AS ISSAMT,0 AS RECWT,0 AS RECAMT FROM " & tranDbName & "..ISSUE  AS T       "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND T.ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD)) AND ISNULL(CANCEL,'') = '' AND TRANTYPE NOT IN ('AI','IAP')               "
        strSql += vbCrLf + " UNION ALL "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME, TRANDATE,TRANNO,       "
        strSql += vbCrLf + " 0 AS ISSWT,AMOUNT AS ISSAMT,0 AS RECWT,0 AS RECAMT FROM " & tranDbName & "..ACCTRAN  AS T       "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE  AND "
        strSql += vbCrLf + " ISNULL(TRANMODE,'')='D'     "
        strSql += vbCrLf + " AND T.ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD)) AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + " ) AS X GROUP BY ACNAME,TRANDATE ,TRANNO "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_WTLEDGERRECEIPT') IS NOT NULL DROP TABLE MASTER..TEMP_WTLEDGERRECEIPT    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,SUM(ISSWT) AS ISSWT,SUM(ISSAMT) AS ISSAMT,SUM(RECWT) AS RECWT,SUM(RECAMT) AS RECAMT,TRANNO         "
        strSql += vbCrLf + " INTO MASTER..TEMP_WTLEDGERRECEIPT "
        strSql += vbCrLf + " FROM     "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,TRANDATE,TRANNO,       "
        strSql += vbCrLf + " 0 AS ISSWT,0 AS ISSAMT,PUREWT AS RECWT,0 RECAMT FROM " & tranDbName & "..RECEIPT  AS T        "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE    "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD)) AND ISNULL(CANCEL,'') = ''  AND TRANTYPE NOT IN ('AR','RAP')         "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE)AS ACNAME,TRANDATE,TRANNO,   "
        strSql += vbCrLf + " 0 AS ISSWT,0 AS  ISSAMT   ,  "
        strSql += vbCrLf + " 0 AS RECWT,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE 0 END RECAMT   FROM " & tranDbName & "..ACCTRAN T   "
        strSql += vbCrLf + " WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (select ACNAME from #TEMP_ACHEAD))   "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = ''  "
        strSql += vbCrLf + " ) AS X GROUP BY ACNAME,TRANDATE ,TRANNO    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " if @CUMULATIVE='Y'    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGEROPENING SET TRANDATE=NULL    "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGERISSUE SET TRANDATE=NULL    "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGERRECEIPT SET TRANDATE=NULL    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_WTLEDGERRESULT') IS NOT NULL DROP TABLE MASTER..TEMP_WTLEDGERRESULT    "
        strSql += vbCrLf + " SELECT CONVERT(VARCHAR(300),NULL) AS PARTICULAR,ACNAME,TRANDATE,ISSWT,ISSAMT,RECWT,RECAMT,ISNULL(ISSWT,0)-ISNULL(RECWT,0) AS CLSWT,ISNULL(ISSAMT,0)-ISNULL(RECAMT,0) AS CLSAMT,    "
        strSql += vbCrLf + " CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD     "
        strSql += vbCrLf + " INTO MASTER..TEMP_WTLEDGERRESULT    "
        strSql += vbCrLf + " FROM     "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,SUM(ISSWT) AS ISSWT,SUM(ISSAMT)AS ISSAMT,SUM(RECWT) AS RECWT,SUM(RECAMT) AS RECAMT    "
        strSql += vbCrLf + " FROM     "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,ISSWT,ISSAMT,RECWT,RECAMT FROM MASTER..TEMP_WTLEDGEROPENING     "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,ISSWT,ISSAMT,RECWT,RECAMT FROM MASTER..TEMP_WTLEDGERISSUE    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT ACNAME,TRANDATE,ISSWT,ISSAMT,RECWT,RECAMT FROM MASTER..TEMP_WTLEDGERRECEIPT     "
        strSql += vbCrLf + " ) AS X GROUP BY ACNAME,TRANDATE     "
        strSql += vbCrLf + " ) AS STMT ORDER BY ACNAME,TRANDATE    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " if @CUMULATIVE='Y'     "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGERRESULT SET PARTICULAR=ACNAME"
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " BEGIN "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGERRESULT SET PARTICULAR="
        strSql += vbCrLf + " CASE WHEN TRANDATE IS NULL THEN 'OPENING'  ELSE CONVERT(VARCHAR(300),TRANDATE,(103)) END"
        strSql += vbCrLf + " ,RESULT="
        strSql += vbCrLf + " CASE WHEN TRANDATE IS NULL THEN 1 ELSE 2 END"
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_WTLEDGERRESULT(PARTICULAR,ACNAME,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT DISTINCT ACNAME,ACNAME,0,'T' FROM MASTER..TEMP_WTLEDGERRESULT    "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_WTLEDGERRESULT(PARTICULAR,ACNAME,ISSWT,ISSAMT,RECWT,RECAMT,CLSWT,CLSAMT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT 'TOTAL',ACNAME,SUM(ISSWT),SUM(ISSAMT),SUM(RECWT),SUM(RECAMT),SUM(CLSWT),SUM(CLSAMT),3,'S'    "
        strSql += vbCrLf + " FROM MASTER..TEMP_WTLEDGERRESULT GROUP BY ACNAME    "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_WTLEDGERRESULT(PARTICULAR,ACNAME,ISSWT,ISSAMT,RECWT,RECAMT,CLSWT,CLSAMT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT 'GRAND TOTAL','ZZ',SUM(ISSWT),SUM(ISSAMT),SUM(RECWT),SUM(RECAMT),SUM(CLSWT),SUM(CLSAMT),4,'G'    "
        strSql += vbCrLf + " FROM MASTER..TEMP_WTLEDGERRESULT WHERE RESULT NOT IN(3)    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_WTLEDGERRESULT SET     "
        strSql += vbCrLf + " ISSWT = CASE WHEN ISSWT=0 THEN NULL ELSE ISSWT END ,    "
        strSql += vbCrLf + " ISSAMT = CASE WHEN ISSAMT=0 THEN NULL ELSE ISSAMT END,    "
        strSql += vbCrLf + " RECWT = CASE WHEN RECWT=0 THEN NULL ELSE RECWT END,    "
        strSql += vbCrLf + " RECAMT = CASE WHEN RECAMT=0 THEN NULL ELSE RECAMT END,    "
        strSql += vbCrLf + " CLSWT = CASE WHEN CLSWT=0 THEN NULL ELSE CLSWT END,    "
        strSql += vbCrLf + " CLSAMT = CASE WHEN CLSAMT=0 THEN NULL ELSE CLSAMT END    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SELECT PARTICULAR,ACNAME,TRANDATE,RECWT,RECAMT,ISSWT,ISSAMT,CLSWT,CLSAMT,RESULT,COLHEAD FROM MASTER..TEMP_WTLEDGERRESULT ORDER BY ACNAME,RESULT "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_ISSUERECEIPT()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_ISSUERECEIPT')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_ISSUERECEIPT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE [dbo].[SP_RPT_ISSUERECEIPT]"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  	@FROMDATE SMALLDATETIME,"
        strSql += vbCrLf + "  	@TODATE SMALLDATETIME,"
        strSql += vbCrLf + "  	@COMPANYID VARCHAR(4000),"
        strSql += vbCrLf + "  	@METALID VARCHAR(4000),"
        strSql += vbCrLf + "  	@COSTID VARCHAR(4000),"
        strSql += vbCrLf + "  	@CATID VARCHAR(4000)"
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  AS "
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  	SET NOCOUNT ON"
        strSql += vbCrLf + "  EXEC SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANYID     "
        strSql += vbCrLf + "  EXEC SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'METALMAST',@CHK_FEILD = 'METALID',@RESULT_TBL = 'TEMPMETAL',@INPUTVALUES = @METALID     "
        strSql += vbCrLf + "  EXEC SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID"
        strSql += vbCrLf + "  EXEC SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL  = 'TEMPCATEGORY',@INPUTVALUES = @CATID"

        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#OPENISSUERECEIPT') IS NOT NULL DROP TABLE #OPENISSUERECEIPT"


        strSql += vbCrLf + "  SELECT METAL,CATEGORY,PARTYNAME,TOUCH,SUM(RGRSWT) AS RGRSWT,SUM(RNETWT) AS RNETWT,SUM(RPURWT) AS RPURWT"
        strSql += vbCrLf + "  ,SUM(IGRSWT) AS IGRSWT,SUM(INETWT) AS INETWT,SUM(IPURWT) AS IPURWT,"
        strSql += vbCrLf + "  ISNULL(SUM(RGRSWT),0)-ISNULL(SUM(IGRSWT),0) AS CGRSWT,ISNULL(SUM(RNETWT),0) -ISNULL(SUM(INETWT),0) AS CNETWT "
        strSql += vbCrLf + "  ,ISNULL(SUM(RPURWT),0)- ISNULL(SUM(IPURWT),0) AS CPURWT"
        strSql += vbCrLf + "  INTO  #OPENISSUERECEIPT"
        strSql += vbCrLf + "  FROM "
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  	SELECT M.METALNAME AS METAL,C.CATNAME AS CATEGORY,'OPENING' AS PARTYNAME ,0 AS TOUCH,ISNULL(SUM(GRSWT),0) AS RGRSWT,"
        strSql += vbCrLf + "  	ISNULL(SUM(NETWT),0) AS RNETWT,ISNULL(SUM(PUREWT),0) AS RPURWT"
        strSql += vbCrLf + "  	,0 AS IGRSWT,0 AS INETWT,0 AS IPURWT,0 AS NGRSWT,0 AS NNETWT,0 AS NPURWT"
        strSql += vbCrLf + "  	FROM " & tranDbName & "..OPENWEIGHT AS O INNER JOIN " & compId & "ADMINDB..CATEGORY AS C"
        strSql += vbCrLf + "  	ON C.CATCODE=O.CATCODE "
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS M ON C.METALID =M.METALID"
        strSql += vbCrLf + "  	WHERE O.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND O.CATCODE IN (SELECT COMPANYID FROM TEMPCATEGORY)"
        strSql += vbCrLf + "  	AND O.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND M.METALID IN (SELECT COMPANYID FROM TEMPMETAL)"
        strSql += vbCrLf + "  	GROUP BY C.CATNAME ,M.METALNAME"

        strSql += vbCrLf + "  	UNION ALL"

        strSql += vbCrLf + "  	SELECT M.METALNAME AS METAL,C.CATNAME AS CATEGORY,'OPENING' AS PARTYNAME ,TOUCH AS TOUCH,ISNULL(SUM(R.GRSWT),0) AS RGRSWT,"
        strSql += vbCrLf + "  	ISNULL(SUM(R.NETWT),0) AS RNETWT,ISNULL(SUM(R.PUREWT),0) AS RPURWT"
        strSql += vbCrLf + "  	,0 AS IGRSWT,0 AS INETWT,0 AS IPURWT,0 AS NGRSWT,0 AS NNETWT,0 AS NPURWT"
        strSql += vbCrLf + "  	FROM " & tranDbName & "..RECEIPT AS R INNER JOIN " & compId & "ADMINDB..CATEGORY AS C"
        strSql += vbCrLf + "  	ON C.CATCODE=R.CATCODE"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS M ON R.METALID =M.METALID"
        strSql += vbCrLf + "  	WHERE R.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND R.CATCODE IN (SELECT COMPANYID FROM TEMPCATEGORY )"
        strSql += vbCrLf + "  	AND R.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND M.METALID IN (SELECT COMPANYID FROM TEMPMETAL)"
        strSql += vbCrLf + "  	AND R.TRANDATE < @TODATE AND R.TRANTYPE IN ('RRE','RPU') AND R.CANCEL <>'Y'"
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,M.METALNAME,TOUCH"

        strSql += vbCrLf + "  	UNION ALL "

        strSql += vbCrLf + "  	SELECT M.METALNAME AS METAL,C.CATNAME AS CATEGORY,'OPENING' AS PARTYNAME ,TOUCH AS TOUCH"
        strSql += vbCrLf + "  	,0 AS RGRSWT,0 AS RNETWT,0 AS RPURWT"
        strSql += vbCrLf + "  	,ISNULL(SUM(I.GRSWT),0) AS IGRSWT,"
        strSql += vbCrLf + "  	ISNULL(SUM(I.NETWT),0) AS INETWT,ISNULL(SUM(I.PUREWT),0) AS IPURWT,"
        strSql += vbCrLf + "  	0 AS NGRSWT,0 AS NNETWT,0 AS NPURWT"
        strSql += vbCrLf + "  	FROM " & tranDbName & "..ISSUE AS I INNER JOIN " & compId & "ADMINDB..CATEGORY AS C"
        strSql += vbCrLf + "  	ON C.CATCODE=I.CATCODE"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS M ON I.METALID =M.METALID"
        strSql += vbCrLf + "  	WHERE I.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND I.CATCODE IN (SELECT COMPANYID FROM TEMPCATEGORY  )"
        strSql += vbCrLf + "  	AND I.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND M.METALID IN (SELECT COMPANYID FROM TEMPMETAL)"
        strSql += vbCrLf + "  	AND I.TRANDATE < @TODATE AND  I.TRANTYPE IN ('IIS','IPU') AND I.CANCEL <>'Y'"
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,M.METALNAME,TOUCH"

        strSql += vbCrLf + "  	UNION ALL "

        strSql += vbCrLf + "  	SELECT M.METALNAME AS METAL,C.CATNAME AS CATEGORY,AC.ACNAME AS PARTYNAME ,TOUCH AS TOUCH,ISNULL(SUM(R.GRSWT),0) AS RGRSWT,"
        strSql += vbCrLf + "  	ISNULL(SUM(R.NETWT),0) AS RNETWT,ISNULL(SUM(R.PUREWT),0) AS RPURWT"
        strSql += vbCrLf + "  	,0 AS IGRSWT,0 AS INETWT,0 AS IPURWT,0 AS NGRSWT,0 AS NNETWT,0 AS NPURWT"
        strSql += vbCrLf + "  	FROM " & tranDbName & "..RECEIPT AS R INNER JOIN " & compId & "ADMINDB..CATEGORY AS C"
        strSql += vbCrLf + "  	ON C.CATCODE=R.CATCODE"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS M ON  R.METALID =M.METALID"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..ACHEAD  AS AC ON AC.ACCODE=R.ACCODE"
        strSql += vbCrLf + "  	WHERE R.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND R.CATCODE IN (SELECT COMPANYID FROM TEMPCATEGORY  )"
        strSql += vbCrLf + "  	AND R.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND M.METALID IN (SELECT COMPANYID FROM TEMPMETAL)"
        strSql += vbCrLf + "  	AND R.TRANDATE BETWEEN @FROMDATE AND @TODATE AND R.TRANTYPE IN ('RRE','RPU')"
        strSql += vbCrLf + "  	AND R.CANCEL <>'Y'"
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,AC.ACNAME,M.METALNAME,TOUCH"

        strSql += vbCrLf + "  	UNION ALL "

        strSql += vbCrLf + "  	SELECT M.METALNAME AS METAL, C.CATNAME AS CATEGORY,AC.ACNAME AS PARTYNAME ,TOUCH AS TOUCH"
        strSql += vbCrLf + "  	,0 AS RGRSWT,0 AS RNETWT,0 AS RPURWT"
        strSql += vbCrLf + "  	,ISNULL(SUM(I.GRSWT),0) AS IGRSWT,"
        strSql += vbCrLf + "  	ISNULL(SUM(I.NETWT),0) AS INETWT,ISNULL(SUM(I.PUREWT),0) AS IPURWT"
        strSql += vbCrLf + "  	,0 AS NGRSWT,0 AS NNETWT,0 AS NPURWT"
        strSql += vbCrLf + "  	FROM " & tranDbName & "..ISSUE AS I INNER JOIN " & compId & "ADMINDB..CATEGORY AS C"
        strSql += vbCrLf + "  	ON C.CATCODE=I.CATCODE"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS M ON  I.METALID =M.METALID"
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..ACHEAD  AS AC ON AC.ACCODE=I.ACCODE"
        strSql += vbCrLf + "  	WHERE I.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND I.CATCODE IN (SELECT COMPANYID FROM TEMPCATEGORY )"
        strSql += vbCrLf + "  	AND I.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND M.METALID IN (SELECT COMPANYID FROM TEMPMETAL)"
        strSql += vbCrLf + "  	AND I.TRANDATE BETWEEN '2011-12-29' AND '2011-12-31'  AND I.TRANTYPE IN ('IIS','IPU')"
        strSql += vbCrLf + "  	AND I.CANCEL <>'Y'"
        strSql += vbCrLf + "  	GROUP BY C.CATNAME,AC.ACNAME,M.METALNAME,TOUCH"
        strSql += vbCrLf + "  ) AS X  GROUP BY METAL,CATEGORY,PARTYNAME,TOUCH ORDER  BY CATEGORY"

        strSql += vbCrLf + "  SELECT * FROM #OPENISSUERECEIPT ORDER BY CATEGORY,PARTYNAME"
        strSql += vbCrLf + "  END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_RPT_WDailyAbstract()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WDailyAbstract')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WDailyAbstract"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE procedure SP_RPT_WDailyAbstract"
        strSql += vbCrLf + "              "
        strSql += vbCrLf + "    @FromDate datetime,@ToDate datetime,@SUMMARY varchar(5),@PARTLYSALES VARCHAR(1),             "
        strSql += vbCrLf + "    @APPPENDINGS VARCHAR(1),@CANCELEDBILL VARCHAR(1),@METALSTOCK VARCHAR(1) "
        strSql += vbCrLf + "    as     "
        strSql += vbCrLf + "   --declare @FromDate datetime               "
        strSql += vbCrLf + "   --declare @ToDate datetime               "
        strSql += vbCrLf + "   --declare @SUMMARY varchar(5)             "
        strSql += vbCrLf + "            "
        strSql += vbCrLf + "   --select @FromDate='2010-01-01'               "
        strSql += vbCrLf + "   --select @ToDate='2010-10-31'               "
        strSql += vbCrLf + "   --select @SUMMARY='N' "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "   set nocount on             "
        strSql += vbCrLf + "   ---LEFT HAND SIDE   "
        strSql += vbCrLf + "       "
        strSql += vbCrLf + "   if Exists(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_OPENING_TRANS')Drop Table MASTER..TEMP_OPENING_TRANS"
        strSql += vbCrLf + " "
        strSql += vbCrLf + "   select Convert(Varchar(250),'OPENING BALANCE') AS Particular,convert(int,Null) as TranNo,Convert(varchar(50),Null)as AcName ,     "
        strSql += vbCrLf + "   Convert(Numeric(12,3),Null) as GrsWeight,Convert(Numeric(12,3),Null) as PureWeight,      "
        strSql += vbCrLf + "   Convert(Numeric(12,3),Null) as CutWeight,"
        strSql += vbCrLf + "   (IsNull((SELECT Sum(Debit)  FROM OPENTRAILBALANCE),0) + Sum(Case when TranMode='C' Then Amount Else -1*Amount End)) as Amount,      "
        strSql += vbCrLf + "   Convert(varchar(3) ,'T') AS ColHead,     "
        strSql += vbCrLf + "   Convert(int ,1) as Result INTO MASTER..TEMP_OPENING_TRANS from  ACCTRAN AS  T  where TranDate  < @FromDate     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "    IF EXISTS(SELECT NAME FROM MASTER..SYSOBJECTS where XTYPE='U' AND NAME='TEMP_ISSUE_TRANS')DROP TABLE MASTER..TEMP_ISSUE_TRANS    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    SELECT  PARTICULAR,TRANNO,TRANDATE,ACNAME,    "
        strSql += vbCrLf + "    SUM(CASE WHEN  TYPE='ISSUE' THEN GRSWT ELSE 0 END) AS GRSWT,    "
        strSql += vbCrLf + "    SUM(CASE WHEN  TYPE='ISSUE' THEN PUREWT ELSE 0 END) AS PUREWT,    "
        strSql += vbCrLf + "    ISNULL(SUM(CASE WHEN TYPE='ISSUE' THEN PUREWT ELSE 0 END),0) -ISNULL(SUM(CASE WHEN TYPE='RATECUT' THEN CUTWEIGHT ELSE 0 END),0) AS MTSAL,    "
        strSql += vbCrLf + "    SUM(CASE WHEN  TYPE='RATECUT' THEN CUTWEIGHT ELSE 0 END) AS CUTWEIGHT,    "
        strSql += vbCrLf + "    SUM(CASE WHEN TYPE='AMOUNT' THEN AMOUNT ELSE 0 END) AS AMOUNT,CONVERT(INTEGER,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD    "
        strSql += vbCrLf + "    INTO MASTER..TEMP_ISSUE_TRANS    "
        strSql += vbCrLf + "    FROM ("
        strSql += vbCrLf + "    SELECT CONVERT(VARCHAR(300),'SALES') AS   PARTICULAR ,'ISSUE' AS TYPE, TRANNO,TRANDATE,     "
        strSql += vbCrLf + "   (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    GRSWT,PUREWT,CONVERT(NUMERIC(13,3),NULL)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ISSUE AS T WHERE ISNULL(TRANTYPE,'')='SA' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    UNION ALL     "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'SALES') AS   PARTICULAR , 'RATECUT' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM RECEIPT AS T WHERE ISNULL(TRANTYPE,'')='PU' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    AND ISNULL(TRANFLAG,'')='AC'   "
        strSql += vbCrLf + "    AND EXISTS (SELECT BATCHNO FROM ISSUE WHERE BATCHNO=T.BATCHNO AND  ISNULL(TRANTYPE,'')='SA')    "
        strSql += vbCrLf + "    UNION ALL    "
        strSql += vbCrLf + "    SELECT CONVERT(VARCHAR(300),'ISSUE') AS   PARTICULAR ,'ISSUE' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "   (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    GRSWT,PUREWT,CONVERT(NUMERIC(13,3),NULL)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ISSUE AS T WHERE ISNULL(TRANTYPE,'')='IIS' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    UNION ALL     "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'ISSUE') AS   PARTICULAR , 'RATECUT' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM RECEIPT AS T WHERE ISNULL(TRANTYPE,'')='IIS' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    AND ISNULL(TRANFLAG,'')='AC'   "
        strSql += vbCrLf + "    AND EXISTS (SELECT BATCHNO FROM ISSUE WHERE BATCHNO=T.BATCHNO AND  ISNULL(TRANTYPE,'')='RRE')    "
        strSql += vbCrLf + "    UNION ALL   "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'ISSUE') AS   PARTICULAR , 'AMOUNT' AS TYPE, TRANNO,TRANDATE,   "
        strSql += vbCrLf + "   (SELECT TOP 1 ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE IN (SELECT ACCODE FROM ISSUE WHERE BATCHNO=T.BATCHNO )) AS ACNAME,  "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,  "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),AMOUNT) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ACCTRAN AS T WHERE TRANMODE='C' AND PAYMODE IN ('SA','SV') AND TRANDATE BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "    UNION ALL  "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'ISSUE') AS   PARTICULAR , 'AMOUNT' AS TYPE, TRANNO,TRANDATE,   "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,  "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),AMOUNT) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ACCTRAN AS T WHERE TRANMODE='C' AND PAYMODE IN ('CP') AND TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + "    ) AS X GROUP BY PARTICULAR,TRANDATE,TRANNO,ACNAME ORDER BY PARTICULAR,TRANDATE,TRANNO,ACNAME    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM MASTER..TEMP_ISSUE_TRANS) > 0"
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "      IF @SUMMARY='N'    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_ISSUE_TRANS(PARTICULAR,GRSWT,PUREWT,AMOUNT,COLHEAD,RESULT,CUTWEIGHT,MTSAL)SELECT    "
        strSql += vbCrLf + "  'SUBTOTAL',SUM(GRSWT),SUM(PUREWT),SUM(AMOUNT),'S',2,SUM(CUTWEIGHT),SUM(MTSAL) FROM MASTER..TEMP_ISSUE_TRANS  GROUP BY PARTICULAR  "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_ISSUE_TRANS(PARTICULAR,AMOUNT,COLHEAD,RESULT,CUTWEIGHT)    "
        strSql += vbCrLf + "  SELECT PARTICULAR,0,'T',0,0 FROM  MASTER..TEMP_ISSUE_TRANS WHERE ISNULL(PARTICULAR,'') <> 'SUBTOTAL' GROUP BY    PARTICULAR  "
        strSql += vbCrLf + "  END     "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    IF EXISTS(SELECT NAME FROM MASTER..SYSOBJECTS where XTYPE='U' AND NAME='TEMP_RECEIPT_TRANS')DROP TABLE MASTER..TEMP_RECEIPT_TRANS"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "    SELECT  ACGRPNAME AS PARTICULAR,ACGRPNAME ,TRANNO,TRANDATE,ACNAME,    "
        strSql += vbCrLf + "    SUM(CASE WHEN TYPE='RECEIVE' THEN GRSWT ELSE 0 END) AS GRSWT,    "
        strSql += vbCrLf + "    SUM(CASE WHEN TYPE='RECEIVE' THEN PUREWT ELSE 0 END) AS PUREWT,    "
        strSql += vbCrLf + "    ISNULL(SUM(CASE WHEN TYPE='RECEIVE' THEN PUREWT ELSE 0 END),0) -ISNULL(SUM(CASE WHEN TYPE='RATECUT' THEN CUTWEIGHT ELSE 0 END),0) AS MTSAL,    "
        strSql += vbCrLf + "    SUM(CASE WHEN TYPE='RATECUT' THEN CUTWEIGHT ELSE 0 END) AS CUTWEIGHT,    "
        strSql += vbCrLf + "    SUM(CASE WHEN TYPE='AMOUNT' THEN AMOUNT ELSE 0 END) AS AMOUNT,CONVERT(INTEGER,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD    "
        strSql += vbCrLf + "    INTO MASTER..TEMP_RECEIPT_TRANS    "
        strSql += vbCrLf + "    FROM ("
        strSql += vbCrLf + "    SELECT CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR ,'RECEIVE' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "   (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "   (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    GRSWT,PUREWT,CONVERT(NUMERIC(13,3),NULL)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM RECEIPT AS T WHERE ISNULL(TRANTYPE,'')='PU' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    UNION ALL   "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR , 'RATECUT' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "    (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ISSUE AS T WHERE ISNULL(TRANTYPE,'')='SA' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    AND ISNULL(TRANFLAG,'')='AC'   "
        strSql += vbCrLf + "    AND EXISTS (SELECT BATCHNO FROM RECEIPT WHERE BATCHNO=T.BATCHNO AND  ISNULL(TRANTYPE,'')='PU')    "
        strSql += vbCrLf + "    UNION ALL   "
        strSql += vbCrLf + ""
        strSql += vbCrLf + "    SELECT CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR ,'RECEIVE' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "   (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "   (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    GRSWT,PUREWT,CONVERT(NUMERIC(13,3),NULL)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM RECEIPT AS T WHERE ISNULL(TRANTYPE,'')='RRE' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    UNION ALL     "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR , 'RATECUT' AS TYPE, TRANNO,TRANDATE,    "
        strSql += vbCrLf + "    (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),NULL) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ISSUE AS T WHERE ISNULL(TRANTYPE,'')='RRE' AND TRANDATE BETWEEN @FROMDATE AND @TODATE AND  ISNULL(CANCEL,'') <> ('Y')"
        strSql += vbCrLf + "    AND ISNULL(TRANFLAG,'')='AC'   "
        strSql += vbCrLf + "    AND EXISTS (SELECT BATCHNO FROM RECEIPT WHERE BATCHNO=T.BATCHNO AND  ISNULL(TRANTYPE,'')='IIS')    "
        strSql += vbCrLf + "    UNION ALL   "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR , 'AMOUNT' AS TYPE, TRANNO,TRANDATE,   "
        strSql += vbCrLf + "    (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "   (SELECT TOP 1 ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE IN (SELECT ACCODE FROM ISSUE WHERE BATCHNO=T.BATCHNO )) AS ACNAME,  "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,CONVERT(NUMERIC(13,3),NULL)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),AMOUNT) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ACCTRAN AS T WHERE TRANMODE='D' AND PAYMODE IN ('PU','PV') AND TRANDATE BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "    UNION ALL  "
        strSql += vbCrLf + "    SELECT  CONVERT(VARCHAR(300),'RECEIPTS') AS   PARTICULAR , 'AMOUNT' AS TYPE, TRANNO,TRANDATE,   "
        strSql += vbCrLf + "    (SELECT ACGRPNAME FROM " & compId & "ADMINDB..ACGROUP  WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)) AS ACGRPNAME,  "
        strSql += vbCrLf + "    (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME,    "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),NULL) AS GRSWT, CONVERT(NUMERIC(13,3),NULL) AS PUREWT,  "
        strSql += vbCrLf + "    CONVERT(NUMERIC(13,3),PUREWT)  AS CUTWEIGHT,CONVERT(NUMERIC(13,2),AMOUNT) AS AMOUNT     "
        strSql += vbCrLf + "    FROM ACCTRAN AS T WHERE TRANMODE='D' AND PAYMODE IN ('CR') AND TRANDATE BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "    ) AS X GROUP BY PARTICULAR,ACGRPNAME,TRANDATE,TRANNO,ACNAME ORDER BY PARTICULAR,TRANDATE,TRANNO,ACNAME    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..TEMP_RECEIPT_TRANS) > 0"
        strSql += vbCrLf + "     BEGIN    "
        strSql += vbCrLf + "      IF @SUMMARY='N'    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_RECEIPT_TRANS(PARTICULAR,ACGRPNAME,GRSWT,PUREWT,AMOUNT,COLHEAD,RESULT,CUTWEIGHT,MTSAL)    "
        strSql += vbCrLf + "  SELECT 'SUBTOTAL',PARTICULAR,SUM(GRSWT),SUM(PUREWT),SUM(AMOUNT),'S',2,SUM(CUTWEIGHT),SUM(MTSAL) FROM MASTER..TEMP_RECEIPT_TRANS  GROUP BY PARTICULAR  "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_RECEIPT_TRANS(PARTICULAR,ACGRPNAME,AMOUNT,COLHEAD,RESULT,CUTWEIGHT)    "
        strSql += vbCrLf + "  SELECT PARTICULAR,PARTICULAR,0,'T',0,0 FROM  MASTER..TEMP_RECEIPT_TRANS WHERE ISNULL(PARTICULAR,'') <> 'SUBTOTAL' GROUP BY    PARTICULAR  "
        strSql += vbCrLf + "  END   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + "   IF EXISTS(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_L_Result_TRANS')Drop Table MASTER..TEMP_L_Result_TRANS             "
        strSql += vbCrLf + "   Create Table MASTER..TEMP_L_Result_TRANS(LParticular varchar(250) ,LTranNo varchar(10) ,LTranDate smalldatetime ,  "
        strSql += vbCrLf + "   LAcName  varchar(200),LGrsWeight Numeric(13,3),LPureWeight Numeric(13,3),LMtSal Numeric(13,3),  "
        strSql += vbCrLf + "   LCutWeight Numeric(13,3),LAmount Numeric(13,2), LColHead varchar(3),LResult int,LkeyNo int Identity)      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + "   if EXISTS(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_R_Result_TRANS')Drop Table MASTER..TEMP_R_Result_TRANS             "
        strSql += vbCrLf + "   Create Table MASTER..TEMP_R_Result_TRANS(RParticular varchar(250),RTranNo varchar(10) ,RTranDate smalldatetime ,RAcName  varchar(200),RGrsWeight Numeric(13,3),RPureWeight Numeric(13,3),RMtPur Numeric(13,3),RCutWeight Numeric(13,3),RAmount Numeric(13,2),"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   RColHead varchar(3),RResult int,RkeyNo int Identity)    "
        strSql += vbCrLf + "   if @SUMMARY='Y'"
        strSql += vbCrLf + "   Begin     "
        strSql += vbCrLf + "     UPDATE  MASTER..TEMP_ISSUE_TRANS Set TranNo=Null ,TranDate=Null ,AcName=Null,ColHead=Null,Result=Null "
        strSql += vbCrLf + "     UPDATE  MASTER..TEMP_RECEIPT_TRANS Set TranNo=Null ,TranDate=Null ,AcName=Null,ColHead=Null,Result=Null"
        strSql += vbCrLf + "   End  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "   INSERT into MASTER..TEMP_L_Result_TRANS(LParticular,LTranNo,LAcName,LGrsWeight,LPureWeight,LMtSal,LCutWeight,LAmount,LColHead,LResult)           "
        strSql += vbCrLf + "   select Particular,TranNo,AcName,0,0,0,0,Amount,ColHead,Result            "
        strSql += vbCrLf + "   from MASTER..TEMP_OPENING_TRANS   "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "   INSERT into MASTER..TEMP_L_Result_TRANS(LParticular,LTranNo,LTranDate,LAcName,LGrsWeight,LPureWeight,LMtSal,LCutWeight,LAmount,LColHead,LResult)           "
        strSql += vbCrLf + "   select Particular,TranNo,TranDate,AcName,Sum(IsNull(GrsWt,0)),Sum(IsNull(PureWt,0)),Sum(IsNull(MtSal,0)),Sum(IsNull(CutWeight,0)),Sum(IsNull(Amount,0)),ColHead,Result            "
        strSql += vbCrLf + "   from MASTER..TEMP_ISSUE_TRANS    "
        strSql += vbCrLf + "   group by Particular,TranNo,TranDate,AcName,ColHead,Result    "
        strSql += vbCrLf + "   Order by Particular,Result    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   INSERT into MASTER..TEMP_R_Result_TRANS(RParticular,RTranNo,RAcName,RGrsWeight,RPureWeight,RMtPur,RCutWeight,RAmount,RColHead,RResult)           "
        strSql += vbCrLf + "   values('',0,'',0,0,0,0,0,'',0)    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "   INSERT into MASTER..TEMP_R_Result_TRANS(RParticular,RTranNo,RTranDate,RAcName,RGrsWeight,RPureWeight,RMtPur,RCutWeight,RAmount,RColHead,RResult)           "
        strSql += vbCrLf + "   select Particular,TranNo,TranDate,AcName,Sum(IsNull(GrsWt,0)),Sum(IsNull(PureWt,0)),Sum(IsNull(MtSal,0)),Sum(IsNull(CutWeight,0)),Sum(IsNull(Amount,0)),ColHead,Result            "
        strSql += vbCrLf + "   from MASTER..TEMP_RECEIPT_TRANS    "
        strSql += vbCrLf + "   group by Particular,ACGRPNAME,Result,TranNo,TranDate,AcName,ColHead,Result"
        strSql += vbCrLf + "    Order by ACGRPNAME,RESULT,AcName"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   Update MASTER..TEMP_L_Result_TRANS Set LParticular = '    '+IsNull(LAcName,'No Name')+' ['+LTranNo + '-' + convert(varchar(25),IsNull(LTranDate,''),103) + ']' from MASTER..TEMP_L_Result_TRANS as T where LResult=1  AND IsNull(LColHead,'') <>'T'    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "       "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "   Update MASTER..TEMP_R_Result_TRANS Set RParticular = '    '+IsNull(RAcName,'No Name')+' ['+RTranNo + '-' + convert(varchar(25),IsNull(RTranDate,''),103) + ']' from MASTER..TEMP_R_Result_TRANS as T where RResult=1   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "              "
        strSql += vbCrLf + "   if Exists(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_Final_Result_TRANS')Drop Table MASTER..TEMP_Final_Result_TRANS             "
        strSql += vbCrLf + "   Create Table MASTER..TEMP_Final_Result_TRANS(  "
        strSql += vbCrLf + "   LParticular varchar(250),LGrsWeight Numeric(13,3),LPureWeight Numeric(13,3),LMtSal Numeric(13,3),LCutWeight Numeric(13,3),LAmount Numeric(13,2),LColHead varchar(3),LResult int,  "
        strSql += vbCrLf + "   RParticular varchar(250),RGrsWeight Numeric(13,3),RPureWeight Numeric(13,3),RMtPur Numeric(13,3),RCutWeight Numeric(13,3),RAmount Numeric(13,2),RColHead varchar(3),RResult int,Result int Identity)     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LMtSal,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "  RParticular,RGrsWeight,RPureWeight,RMtPur,RCutWeight,RAmount,RColHead,RResult)"
        strSql += vbCrLf + "  select T1.LParticular,T1.LGrsWeight,T1.LPureWeight,T1.LMtSal,T1.LCutWeight,T1.LAmount,T1.LColHead,T1.LResult,  "
        strSql += vbCrLf + "  T2.RParticular,T2.RGrsWeight,T2.RPureWeight,T2.RMtPur,T2.RCutWeight,T2.RAmount,T2.RColHead,T2.RResult         "
        strSql += vbCrLf + "  from  MASTER..TEMP_L_Result_TRANS as T1 Full Join MASTER..TEMP_R_Result_TRANS as T2 ON T1.LKeyNo=T2.RKeyNo     "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "  if @SUMMARY='Y'       "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LMtSal,LCutWeight,LPureWeight,LAmount,LColHead)   "
        strSql += vbCrLf + "    select 'Grand Total',Sum(IsNull(LGrsWeight,0)),Sum(IsNull(LMtSal,0)),Sum(IsNull(LCutWeight,0)),Sum(IsNull(LPureWeight,0)),Sum(IsNull(LAmount,0)),'G' from    MASTER..TEMP_Final_Result_TRANS       "
        strSql += vbCrLf + "    Update MASTER..TEMP_Final_Result_TRANS set  RParticular='Grand Total',     "
        strSql += vbCrLf + "    RGrsWeight=(Select Sum(IsNull(RGrsWeight,0)) from MASTER..TEMP_Final_Result_TRANS ) ,     "
        strSql += vbCrLf + "    RPureWeight=(Select Sum(IsNull(RPureWeight,0)) from MASTER..TEMP_Final_Result_TRANS) ,    "
        strSql += vbCrLf + "    RCutWeight=(Select Sum(IsNull(RCutWeight,0)) from MASTER..TEMP_Final_Result_TRANS) ,    "
        strSql += vbCrLf + "    RMtPur=(Select Sum(IsNull(RMtPur,0)) from MASTER..TEMP_Final_Result_TRANS) ,     "
        strSql += vbCrLf + "    RAmount=(Select Sum(IsNull(RAmount,0)) from MASTER..TEMP_Final_Result_TRANS ) ,   "
        strSql += vbCrLf + "    LColHead='G' from MASTER..TEMP_Final_Result_TRANS as  T  where T.LParticular='Grand Total'       "
        strSql += vbCrLf + "   END     "
        strSql += vbCrLf + "   ELSE             "
        strSql += vbCrLf + "   BEGIN     "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LMtSal,LCutWeight,LAmount,LColHead)       "
        strSql += vbCrLf + "    select 'Grand Total',Sum(IsNull(LGrsWeight,0)),Sum(IsNull(LPureWeight,0)),Sum(IsNull(LMtSal,0)),Sum(IsNull(LCutWeight,0)),Sum(IsNull(LAmount,0)),'G' from   MASTER..TEMP_Final_Result_TRANS   WHERE LResult=1  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "    Update MASTER..TEMP_Final_Result_TRANS set  RParticular='Grand Total',     "
        strSql += vbCrLf + "    RGrsWeight=(Select Sum(IsNull(RGrsWeight,0)) from MASTER..TEMP_Final_Result_TRANS WHERE RResult=1) ,     "
        strSql += vbCrLf + "    RPureWeight=(Select Sum(IsNull(RPureWeight,0)) from MASTER..TEMP_Final_Result_TRANS WHERE RResult=1) ,     "
        strSql += vbCrLf + "    RCutWeight=(Select Sum(IsNull(RCutWeight,0)) from MASTER..TEMP_Final_Result_TRANS WHERE RResult=1) ,     "
        strSql += vbCrLf + "    RMtPur=(Select Sum(IsNull(RMtPur,0)) from MASTER..TEMP_Final_Result_TRANS WHERE RResult=1) ,             "
        strSql += vbCrLf + "    RAmount=(Select Sum(IsNull(RAmount,0)) from MASTER..TEMP_Final_Result_TRANS WHERE RResult=1) ,     "
        strSql += vbCrLf + "    LColHead='G' from MASTER..TEMP_Final_Result_TRANS as  T  where T.LParticular='Grand Total'       "
        strSql += vbCrLf + "   END   "
        strSql += vbCrLf + "         "
        strSql += vbCrLf + "   INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "   RParticular,RGrsWeight,RPureWeight,RCutWeight,RAmount,RColHead,RResult)    "
        strSql += vbCrLf + "   select '',Null,Null,Null,Null,Null,Null,           "
        strSql += vbCrLf + "   'Closing',Null,Null,Null,(Sum(LAmount)-Sum(RAmount)) as Amount,'G',Null         "
        strSql += vbCrLf + "   from  MASTER..TEMP_Final_Result_TRANS   where LColHead='G'     "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    /*EMPTY ROW */ "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "    RParticular,RGrsWeight,RPureWeight,RCutWeight,RAmount,RColHead,RResult)VALUES(    "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null,           "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null)"
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    if Exists(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_PARTLYSALES')Drop Table MASTER..TEMP_PARTLYSALES             "
        strSql += vbCrLf + "    SELECT CONVERT(VARCHAR(300),NULL) AS PARTICULAR ,TRANNO,ITEMNAME,TAGNO,ACTPCS,ACTGRSWT,ACTNETWT,SALPCS,SALGRSWT,SALNETWT,DIFFPCS,DIFFGRSWT,DIFFNETWT,EMPNAME,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD  "
        strSql += vbCrLf + "    INTO MASTER..TEMP_PARTLYSALES "
        strSql += vbCrLf + "    FROM  "
        strSql += vbCrLf + "    ( "
        strSql += vbCrLf + "    SELECT T.TRANNO,(SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID=T.ITEMID) AS ITEMNAME,T.TAGNO, "
        strSql += vbCrLf + "    I.PCS AS ACTPCS,I.GRSWT AS ACTGRSWT,I.NETWT AS ACTNETWT, "
        strSql += vbCrLf + "    T.PCS AS SALPCS,T.GRSWT AS SALGRSWT,T.NETWT AS SALNETWT, "
        strSql += vbCrLf + "    I.PCS-T.PCS AS DIFFPCS,I.GRSWT-T.GRSWT AS DIFFGRSWT,I.NETWT-T.NETWT AS DIFFNETWT, "
        strSql += vbCrLf + "    (SELECT EMPNAME FROM " & compId & "ADMINDB..EMPMASTER WHERE EMPID=T.EMPID) AS EMPNAME  "
        strSql += vbCrLf + "    FROM " & tranDbName & "..ISSUE AS T ," & cnAdminDb & "..ITEMTAG AS I WHERE "
        strSql += vbCrLf + "    ISNULL(T.ITEMID,0) = ISNULL(I.ITEMID,0) AND"
        strSql += vbCrLf + "    ISNULL(T.TAGNO,'') = ISNULL(I.TAGNO,'') AND  ISNULL(T.GRSWT,0) <> ISNULL(I.GRSWT,0)    "
        strSql += vbCrLf + "    AND T.TRANDATE BETWEEN @FROMDATE AND @TODATE   "
        strSql += vbCrLf + "    ) AS X"
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "    if (Select COUNT(*) from MASTER..TEMP_PARTLYSALES)>0             "
        strSql += vbCrLf + "    BEGIN           "
        strSql += vbCrLf + "    UPDATE  MASTER..TEMP_PARTLYSALES SET PARTICULAR= '  '+ITEMNAME + '-' + CONVERT(VARCHAR(5),TRANNO ) "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_PARTLYSALES(PARTICULAR,RESULT,COLHEAD)VALUES "
        strSql += vbCrLf + "    ('PARTLYSALES','','T') "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_PARTLYSALES(PARTICULAR,ITEMNAME,ACTPCS,ACTGRSWT,ACTNETWT,SALPCS,SALGRSWT,SALNETWT,DIFFPCS,DIFFGRSWT,DIFFNETWT,RESULT,COLHEAD) "
        strSql += vbCrLf + "    SELECT 'TOTAL','ZZ',SUM(ACTPCS),SUM(ACTGRSWT),SUM(ACTNETWT),SUM(SALPCS),SUM(SALGRSWT),SUM(SALNETWT),SUM(DIFFPCS),SUM(DIFFGRSWT),SUM(DIFFNETWT),2,'G' FROM MASTER..TEMP_PARTLYSALES  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    IF @PARTLYSALES='Y'  "
        strSql += vbCrLf + "    BEGIN "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_Final_Result_TRANS(LPARTICULAR,LGRSWEIGHT,LPUREWEIGHT,LMTSAL,LCUTWEIGHT,LAMOUNT,LCOLHEAD,LRESULT) "
        strSql += vbCrLf + "    SELECT PARTICULAR,DIFFPCS,DIFFGRSWT,DIFFNETWT,0,0,COLHEAD,RESULT FROM MASTER..TEMP_PARTLYSALES ORDER BY ITEMNAME,RESULT "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    /*EMPTY ROW */ "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "    RParticular,RGrsWeight,RPureWeight,RCutWeight,RAmount,RColHead,RResult)VALUES(    "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null,           "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null )        "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    if Exists(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_APPPENDINGS')Drop Table MASTER..TEMP_APPPENDINGS             "
        strSql += vbCrLf + "     Select CONVERT(VARCHAR(300),NULL) AS PARTICULAR,Partyname, Sum(Pcs) as Pcs,Sum(GrsWt) as GrsWt,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD  "
        strSql += vbCrLf + "           INTO MASTER..TEMP_APPPENDINGS   "
        strSql += vbCrLf + "     from ( "
        strSql += vbCrLf + "     Select  "
        strSql += vbCrLf + "    (Select AcName from " & compId & "ADMINDB..ACHEAD where AcCode=T.AcCode) as Partyname ,  "
        strSql += vbCrLf + "     Pcs,GrsWt  "
        strSql += vbCrLf + "     from " & tranDbName & "..ISSUE AS T WHERE TRANDATE <= @TODATE AND  "
        strSql += vbCrLf + "     TRANTYPE='AI' and isnull(cancel,'')=''  "
        strSql += vbCrLf + "     union all  "
        strSql += vbCrLf + "     Select  "
        strSql += vbCrLf + "    (Select AcName from " & compId & "ADMINDB..ACHEAD where AcCode=T.AcCode) as Partyname ,  "
        strSql += vbCrLf + "    -1*Pcs,-1*GrsWt  "
        strSql += vbCrLf + "     from " & tranDbName & "..RECEIPT AS T WHERE TRANDATE <= @TODATE AND  "
        strSql += vbCrLf + "     TRANTYPE='AR' and isnull(cancel,'')=''  "
        strSql += vbCrLf + "     ) as xx GROUP BY Partyname Order by Partyname  "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    if (Select COUNT(*) from MASTER..TEMP_APPPENDINGS)>0    "
        strSql += vbCrLf + "    BEGIN     "
        strSql += vbCrLf + "    UPDATE  MASTER..TEMP_APPPENDINGS SET PARTICULAR= '  '+ PARTYNAME  "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_APPPENDINGS(PARTICULAR,RESULT,COLHEAD)VALUES "
        strSql += vbCrLf + "    ('APPPENDINGS','','T') "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_APPPENDINGS(PARTICULAR,PARTYNAME,Pcs,GrsWt,RESULT,COLHEAD) "
        strSql += vbCrLf + "    SELECT 'TOTAL','ZZ',SUM(Pcs),SUM(GrsWt),2,'G' FROM MASTER..TEMP_APPPENDINGS  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    IF @APPPENDINGS ='Y'  "
        strSql += vbCrLf + "    BEGIN "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_Final_Result_TRANS(LPARTICULAR,LGRSWEIGHT,LPUREWEIGHT,LCOLHEAD,LRESULT) "
        strSql += vbCrLf + "    SELECT PARTICULAR,Pcs,GrsWt,COLHEAD,RESULT FROM MASTER..TEMP_APPPENDINGS ORDER BY PARTYNAME,RESULT "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    /*EMPTY ROW */ "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "    RParticular,RGrsWeight,RPureWeight,RCutWeight,RAmount,RColHead,RResult)VALUES(    "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null,           "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null )        "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    if Exists(Select Name from MASTER..SYSOBJECTS where XType='U' and Name='TEMP_CANCELEDBILL')Drop Table MASTER..TEMP_CANCELEDBILL             "
        strSql += vbCrLf + "    Select CONVERT(VARCHAR(300),NULL) AS PARTICULAR, "
        strSql += vbCrLf + "    (Select AcName from " & compId & "ADMINDB..ACHEAD where AcCode=T.AcCode) as Partyname ,  "
        strSql += vbCrLf + "    TranNo, TranDate,  "
        strSql += vbCrLf + "    (Select ItemName from " & compId & "ADMINDB..ITEMMAST where ItemId=T.ItemId) as ItemName ,  "
        strSql += vbCrLf + "    TagNo,Pcs,GrsWt,NetWt, "
        strSql += vbCrLf + "    Amount,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD  "
        strSql += vbCrLf + "    INTO MASTER..TEMP_CANCELEDBILL "
        strSql += vbCrLf + "    from " & tranDbName & "..ISSUE AS T WHERE TRANDATE BETWEEN @FROMDATE AND  @TODATE  and isnull(cancel,'')='Y'  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "    if (Select COUNT(*) from MASTER..TEMP_CANCELEDBILL)>0  "
        strSql += vbCrLf + "    BEGIN   "
        strSql += vbCrLf + "    UPDATE  MASTER..TEMP_CANCELEDBILL SET PARTICULAR= '  '+ ITEMNAME + '-' + CONVERT(VARCHAR(5),TRANNO) "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_CANCELEDBILL(PARTICULAR,RESULT,COLHEAD)VALUES "
        strSql += vbCrLf + "    ('CANCELEDBILL','','T') "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_CANCELEDBILL(PARTICULAR,ITEMNAME,Pcs,GrsWt,NETWT,AMOUNT,RESULT,COLHEAD) "
        strSql += vbCrLf + "    SELECT 'TOTAL','ZZ',SUM(Pcs),SUM(GrsWt),SUM(NetWt),sum(Amount),2,'G' FROM MASTER..TEMP_CANCELEDBILL "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    IF @CANCELEDBILL  ='Y'  "
        strSql += vbCrLf + "    BEGIN "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMP_Final_Result_TRANS(LPARTICULAR,LGRSWEIGHT,LPUREWEIGHT,LMTsal,lcutweight,LCOLHEAD,LRESULT) "
        strSql += vbCrLf + "    SELECT PARTICULAR,Pcs,GrsWt,NetWt,Amount,COLHEAD,RESULT FROM MASTER..TEMP_CANCELEDBILL ORDER BY ITEMNAME,RESULT "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    /*EMPTY ROW */ "
        strSql += vbCrLf + "    INSERT into MASTER..TEMP_Final_Result_TRANS(LParticular,LGrsWeight,LPureWeight,LCutWeight,LAmount,LColHead,LResult,  "
        strSql += vbCrLf + "    RParticular,RGrsWeight,RPureWeight,RCutWeight,RAmount,RColHead,RResult)VALUES(    "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null,           "
        strSql += vbCrLf + "    Null,Null,Null,Null,Null,Null,Null )    "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "         "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     --GETING  WEIGHT--"
        strSql += vbCrLf + "    IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME='TEMP_METALBALANCE') > 0 DROP TABLE MASTER..TEMP_METALBALANCE                      "
        strSql += vbCrLf + "     SELECT      "
        strSql += vbCrLf + "      CONVERT(VARCHAR(300),NULL) AS PARTICULAR,     "
        strSql += vbCrLf + "     (SELECT CASE WHEN ISNULL(GS11,'')='Y' THEN 'GS11' WHEN ISNULL(GS12,'')='Y' THEN 'GS12' ELSE 'OTHERS' END FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=X.CATCODE) AS TYPE,     "
        strSql += vbCrLf + "     CATCODE,CATNAME,"
        strSql += vbCrLf + "     SUM(OPWT) AS OPWT,SUM(ISSWT)AS ISSWT,SUM(RECWT) as RECWT,  "
        strSql += vbCrLf + "     ((ISNULL(SUM(OPWT),0)+ISNULL(SUM(RECWT),0))-ISNULL(SUM(ISSWT),0)) AS CLWT,"
        strSql += vbCrLf + "     convert(VARCHAR(2),null) as COLHEAD, convert(INT,1) as RESULT "
        strSql += vbCrLf + "     INTO MASTER..TEMP_METALBALANCE FROM  "
        strSql += vbCrLf + "     ( "
        strSql += vbCrLf + "     SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,"
        strSql += vbCrLf + "     CASE WHEN TRANTYPE='R' THEN  "
        strSql += vbCrLf + "     PUREWT              "
        strSql += vbCrLf + "     ELSE -1 *  "
        strSql += vbCrLf + "     PUREWT "
        strSql += vbCrLf + "     END AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT   "
        strSql += vbCrLf + "     FROM " & tranDbName & "..OPENWEIGHT AS T WHERE ISNULL(STOCKTYPE,'')='C'  "
        strSql += vbCrLf + "     /* AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME))*/      "
        strSql += vbCrLf + "     UNION ALL    "
        strSql += vbCrLf + "     SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,"
        strSql += vbCrLf + "     PUREWT   AS OPWT, "
        strSql += vbCrLf + "     CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT   "
        strSql += vbCrLf + "     FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')=''  AND  TRANFLAG IN ('A','W')  "
        strSql += vbCrLf + "     /* AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME))*/      "
        strSql += vbCrLf + "     UNION ALL "
        strSql += vbCrLf + "     SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,"
        strSql += vbCrLf + "     -1 *  PUREWT  AS OPWT, "
        strSql += vbCrLf + "     CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT"
        strSql += vbCrLf + "     FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')='' AND   TRANFLAG IN ('A','W')  "
        strSql += vbCrLf + "     /* AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME))*/      "
        strSql += vbCrLf + "     UNION ALL "
        strSql += vbCrLf + "     SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,"
        strSql += vbCrLf + "     CONVERT(NUMERIC(12,3),NULL) AS OPWT,         "
        strSql += vbCrLf + "     PUREWT   AS ISSWT, "
        strSql += vbCrLf + "     CONVERT(NUMERIC(12,3),NULL) AS RECWT               "
        strSql += vbCrLf + "     FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND   TRANFLAG IN ('A','W')  "
        strSql += vbCrLf + "     /* AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME))*/      "
        strSql += vbCrLf + "     UNION ALL "
        strSql += vbCrLf + "     SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,"
        strSql += vbCrLf + "     CONVERT(NUMERIC(12,3),NULL) AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT, "
        strSql += vbCrLf + "     PUREWT   AS RECWT "
        strSql += vbCrLf + "     FROM " & tranDbName & "..RECEIPT  AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND  TRANFLAG IN ('A','W')               "
        strSql += vbCrLf + "     /* AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME))*/  "
        strSql += vbCrLf + "     )AS X GROUP BY CATCODE,CATNAME     "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + "     if (Select COUNT(*) from MASTER..TEMP_METALBALANCE)>0     "
        strSql += vbCrLf + "     BEGIN"
        strSql += vbCrLf + "      "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "     INSERT INTO MASTER..TEMP_METALBALANCE(TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)     "
        strSql += vbCrLf + "     SELECT TYPE,NULL,NULL,NULL,NULL,'T',0 FROM MASTER..TEMP_METALBALANCE GROUP BY TYPE     "
        strSql += vbCrLf + "         "
        strSql += vbCrLf + "     INSERT INTO MASTER..TEMP_METALBALANCE(PARTICULAR,TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)     "
        strSql += vbCrLf + "     SELECT 'Total',TYPE,sum(OPWT),sum(RECWT),sum(ISSWT),sum(CLWT),'S',2  FROM MASTER..TEMP_METALBALANCE GROUP BY TYPE     "
        strSql += vbCrLf + "         "
        strSql += vbCrLf + "     UPDATE  MASTER..TEMP_METALBALANCE SET PARTICULAR=TYPE WHERE RESULT<>2      "
        strSql += vbCrLf + "     UPDATE  MASTER..TEMP_METALBALANCE SET PARTICULAR= '  ' + CATNAME WHERE ISNULL(CATNAME,'')<>''     "
        strSql += vbCrLf + "         "
        strSql += vbCrLf + "     INSERT INTO MASTER..TEMP_METALBALANCE(PARTICULAR,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)VALUES(     "
        strSql += vbCrLf + "     'METALSTOCK',0,0,0,0,'T',0 )    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     INSERT INTO MASTER..TEMP_METALBALANCE (PARTICULAR,TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)"
        strSql += vbCrLf + "     SELECT 'Grand Total','ZZ',sum(OPWT),SUM(RECWT),SUM(ISSWT),SUM(CLWT),'G',3 FROM MASTER..TEMP_METALBALANCE  WHERE RESULT=1    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     UPDATE MASTER..TEMP_METALBALANCE SET OPWT=CASE WHEN OPWT=0 THEN NULL ELSE OPWT END ,"
        strSql += vbCrLf + "     RECWT=CASE WHEN RECWT=0 THEN NULL ELSE RECWT END,"
        strSql += vbCrLf + "     ISSWT=CASE WHEN ISSWT=0 THEN NULL ELSE ISSWT END ,"
        strSql += vbCrLf + "     CLWT=CASE WHEN CLWT=0 THEN NULL ELSE CLWT END"
        strSql += vbCrLf + "              "
        strSql += vbCrLf + "     IF @METALSTOCK   ='Y'  "
        strSql += vbCrLf + "     BEGIN      "
        strSql += vbCrLf + "            INSERT INTO MASTER..TEMP_Final_Result_TRANS(LPARTICULAR,LGRSWEIGHT,LPUREWEIGHT,LMTsal,lcutweight,LCOLHEAD,LRESULT) "
        strSql += vbCrLf + "     SELECT PARTICULAR,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT FROM  MASTER..TEMP_METALBALANCE      "
        strSql += vbCrLf + "     ORDER BY  TYPE,RESULT     "
        strSql += vbCrLf + "            END    "
        strSql += vbCrLf + "     END   "
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    update MASTER..TEMP_Final_Result_TRANS set LGrsWeight=CASE WHEN LGrsWeight=0 THEN NULL ELSE LGrsWeight END,               "
        strSql += vbCrLf + "     LPureWeight=CASE WHEN LPureWeight=0 THEN NULL ELSE LPureWeight END,               "
        strSql += vbCrLf + "     LAmount=CASE WHEN LAmount=0 THEN NULL ELSE LAmount END,               "
        strSql += vbCrLf + "     LCutWeight=CASE WHEN LCutWeight=0 THEN NULL ELSE LCutWeight END,               "
        strSql += vbCrLf + "     RGrsWeight=CASE WHEN RGrsWeight=0 THEN NULL ELSE RGrsWeight END,               "
        strSql += vbCrLf + "     RPureWeight=CASE WHEN RPureWeight=0 THEN NULL ELSE RPureWeight END,               "
        strSql += vbCrLf + "     RCutWeight=CASE WHEN RCutWeight=0 THEN NULL ELSE RCutWeight END,               "
        strSql += vbCrLf + "     RAmount=CASE WHEN RAmount=0 THEN NULL ELSE RAmount END,               "
        strSql += vbCrLf + "     LMtSal=CASE WHEN LMtSal=0 THEN NULL ELSE LMtSal END,               "
        strSql += vbCrLf + "     RMtPur=CASE WHEN RMtPur=0 THEN NULL ELSE RMtPur END"
        strSql += vbCrLf + "    "
        strSql += vbCrLf + "    SELECT *,'' AS SCROLL FROM MASTER..TEMP_Final_Result_TRANS order by result  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --EXEC " & tranDbName & "..SP_RPT_WDailyAbstract_New       @FromDate='2011-01-28', @Todate='2011-01-28', @SUMMARY='N' ,@PARTLYSALES ='Y' ,@APPPENDINGS ='Y' ,@CANCELEDBILL ='Y' ,@METALSTOCK ='N'    "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_WDAILYRATE()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WDAILYRATE')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WDAILYRATE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_WDAILYRATE @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@METAL  VARCHAR(10),@RATE NUMERIC(12,2)      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + ""
        strSql += vbCrLf + " SET NOCOUNT ON      "
        strSql += vbCrLf + " --DECLARE @FROMDATE SMALLDATETIME      "
        strSql += vbCrLf + " --DECLARE @TODATE SMALLDATETIME      "
        strSql += vbCrLf + " --DECLARE @METAL VARCHAR(10)      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --SET  @FROMDATE='2010-01-01'      "
        strSql += vbCrLf + " --SET  @TODATE='2010-12-31'      "
        strSql += vbCrLf + " --SET  @METAL='GOLD'      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --GETING RECEIPT VALUES"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_RECIPT_CB')>0  DROP TABLE MASTER..TEMP_RECIPT_CB      "
        strSql += vbCrLf + " SELECT TRANDATE,sum(PUREWT)AS NETWT,sum(Amount) AS AMOUNT,      "
        strSql += vbCrLf + " isnull(sum(Amount),0)/case when isnull(sum(PureWt),0)=0 then 1 else sum(PureWt) end  as RATE"
        strSql += vbCrLf + " INTO MASTER..TEMP_RECIPT_CB FROM"
        strSql += vbCrLf + " RECEIPT WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND      "
        strSql += vbCrLf + " CATCODE IN ( SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (      "
        strSql += vbCrLf + " SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME=@METAL)) AND"
        strSql += vbCrLf + " TRANFLAG IN ('AC')      "
        strSql += vbCrLf + " GROUP BY TRANDATE ORDER BY TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --GETING ISSUE VALUES      "
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_ISSUE_CB')>0  DROP TABLE MASTER..TEMP_ISSUE_CB      "
        strSql += vbCrLf + " SELECT TRANDATE,sum(PureWt) AS NETWT ,sum(Amount) AS AMOUNT,      "
        strSql += vbCrLf + " isnull(sum(Amount),0)/case when isnull(sum(PureWt),0)=0 then 1 else sum(PureWt) end  as RATE"
        strSql += vbCrLf + " INTO MASTER..TEMP_ISSUE_CB FROM"
        strSql += vbCrLf + " ISSUE WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND      "
        strSql += vbCrLf + " CATCODE IN ( SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (      "
        strSql += vbCrLf + " SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME=@METAL)) AND"
        strSql += vbCrLf + " TRANFLAG IN ('AC')      "
        strSql += vbCrLf + " GROUP BY TRANDATE ORDER BY TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --JOINING RECIPT AND ISSUE FOR CASHBALANCE"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_CASHBALANCE')>0 DROP TABLE MASTER..TEMP_CASHBALANCE      "
        strSql += vbCrLf + " SELECT ISNULL(R.TRANDATE,I.TRANDATE) AS TRANDATE,R.NETWT AS RNETWT,R.AMOUNT AS RAMOUNT,R.RATE AS RRATE ,I.NETWT AS INETWT,I.AMOUNT AS IAMOUNT,I.RATE AS IRATE      "
        strSql += vbCrLf + " INTO MASTER..TEMP_CASHBALANCE FROM      "
        strSql += vbCrLf + " MASTER..TEMP_RECIPT_CB AS R FULL JOIN  MASTER..TEMP_ISSUE_CB AS I ON R.TRANDATE=I.TRANDATE      "
        strSql += vbCrLf + " ORDER BY R.TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --GETING RECEIPT VALUES"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_RECEIPT_MB')>0  DROP TABLE MASTER..TEMP_RECEIPT_MB      "
        strSql += vbCrLf + " SELECT TRANDATE,sum(PureWt)AS NETWT,SUM(MCHARGE) AS MC      "
        strSql += vbCrLf + " INTO MASTER..TEMP_RECEIPT_MB FROM"
        strSql += vbCrLf + " RECEIPT WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND      "
        strSql += vbCrLf + " CATCODE IN ( SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (      "
        strSql += vbCrLf + " SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME=@METAL)) AND"
        strSql += vbCrLf + " TRANFLAG IN ('A','W')      "
        strSql += vbCrLf + " GROUP BY TRANDATE ORDER BY TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --GETING ISSUE VALUES"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_ISSUE_MB')>0  DROP TABLE MASTER..TEMP_ISSUE_MB      "
        strSql += vbCrLf + " SELECT TRANDATE,sum(PureWt)AS NETWT,SUM(MCHARGE) AS MC      "
        strSql += vbCrLf + " INTO MASTER..TEMP_ISSUE_MB FROM"
        strSql += vbCrLf + " ISSUE WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND      "
        strSql += vbCrLf + " CATCODE IN ( SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (      "
        strSql += vbCrLf + " SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME=@METAL)) AND"
        strSql += vbCrLf + " TRANFLAG IN ('A','W')      "
        strSql += vbCrLf + " GROUP BY TRANDATE ORDER BY TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --JOINING RECIPT AND ISSUE FOR METALBALANCE"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_METBALANCE')>0 DROP TABLE MASTER..TEMP_METBALANCE      "
        strSql += vbCrLf + " SELECT ISNULL(I.TRANDATE,R.TRANDATE) AS TRANDATE,I.NETWT AS INETWT,I.MC AS IMC ,R.NETWT AS RNETWT,R.MC AS RMC      "
        strSql += vbCrLf + " INTO MASTER..TEMP_METBALANCE FROM      "
        strSql += vbCrLf + " MASTER..TEMP_ISSUE_MB AS I FULL JOIN  MASTER..TEMP_RECEIPT_MB AS R ON I.TRANDATE=R.TRANDATE"
        strSql += vbCrLf + " ORDER BY I.TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --JOINING CASHBALNCE AND METALBALNCE FOR RESULT"
        strSql += vbCrLf + " IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_RESULT')>0 DROP TABLE MASTER..TEMP_RESULT      "
        strSql += vbCrLf + " SELECT CONVERT(VARCHAR(300),NULL) AS PARTICULAR ,ISNULL(C.TRANDATE,M.TRANDATE) AS TRANDATE,C.RNETWT AS CRNETWT,C.RAMOUNT AS CRAMOUNT ,CONVERT(NUMERIC(12,2),C.RRATE) AS CRRATE,      "
        strSql += vbCrLf + " C.INETWT AS CINETWT,C.IAMOUNT AS CIAMOUNT ,CONVERT(NUMERIC(12,2),C.IRATE) AS CIRATE,      "
        strSql += vbCrLf + " M.INETWT AS MINETWT,M.IMC AS MIMC,M.RNETWT AS MRNETWT,M.RMC AS MRMC,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD      "
        strSql += vbCrLf + " INTO MASTER..TEMP_RESULT FROM      "
        strSql += vbCrLf + " MASTER..TEMP_CASHBALANCE AS C FULL JOIN  MASTER..TEMP_METBALANCE AS M ON M.TRANDATE=C.TRANDATE      "
        strSql += vbCrLf + " ORDER BY M.TRANDATE      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " UPDATE MASTER..TEMP_RESULT SET PARTICULAR=CONVERT(VARCHAR,TRANDATE,103)      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_RESULT(PARTICULAR,CRNETWT,CRAMOUNT,CRRATE,CINETWT,CIAMOUNT,CIRATE,MINETWT,MIMC,MRNETWT,MRMC,RESULT,COLHEAD)      "
        strSql += vbCrLf + " SELECT 'TOTAL',      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,3),SUM(CRNETWT)),CONVERT(NUMERIC(12,2),SUM(CRAMOUNT)),      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,2),SUM(CRAMOUNT)/CASE WHEN ISNULL(SUM(CRNETWT),0)=0 THEN 1 ELSE SUM(CRNETWT) END),      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,3),SUM(CINETWT)),CONVERT(NUMERIC(12,2),SUM(CIAMOUNT)),      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,2),SUM(CIAMOUNT)/CASE WHEN ISNULL(SUM(CINETWT),0)=0 THEN 1 ELSE SUM(CINETWT) END),      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,3),SUM(MINETWT)),CONVERT(NUMERIC(12,2),SUM(MIMC)),      "
        strSql += vbCrLf + " CONVERT(NUMERIC(12,3),SUM(MRNETWT)),CONVERT(NUMERIC(12,2),SUM(MRMC)),2,'G' FROM MASTER..TEMP_RESULT      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + ""
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_RESULT(PARTICULAR,CRNETWT,CRAMOUNT,CRRATE,Result)      "
        strSql += vbCrLf + " select 'Diff in wt & amt & rate ', Isnull(sum(CRNETWT),0)-isnull(sum(CINETWT),0),isnull(sum(CRAMOUNT),0)-isnull(sum(CIAMOUNT),0),    "
        strSql += vbCrLf + " (isnull(sum(CRAMOUNT),0)-isnull(sum(CIAMOUNT),0))/ CASE WHEN (isnull(sum(CRNETWT),0)-isnull(sum(CINETWT),0))=0 THEN 1 ELSE (isnull(sum(CRNETWT),0)-isnull(sum(CINETWT),0)) END ,    "
        strSql += vbCrLf + " 3 from MASTER..TEMP_RESULT  WHERE  ISNULL(RESULT,0)=1    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_RESULT(PARTICULAR,CRNETWT,CRAMOUNT,CRRATE,Result)      "
        strSql += vbCrLf + " select 'Cur wt & amt & rate ', Isnull(sum(CRNETWT),0)-isnull(sum(CINETWT),0), (Isnull(sum(CRNETWT),0)-isnull(sum(CINETWT),0)) * @rate ,    "
        strSql += vbCrLf + " (@rate),    "
        strSql += vbCrLf + " 4 from MASTER..TEMP_RESULT  WHERE  ISNULL(RESULT,0)=1     "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_RESULT(PARTICULAR,CRNETWT,CRAMOUNT,CRRATE,Result)     "
        strSql += vbCrLf + "  select 'Profit/Loss', (select CRNETWT from MASTER..TEMP_RESULT where result=3)-(select CRNETWT from MASTER..TEMP_RESULT where result=4),    "
        strSql += vbCrLf + " (select CRAMOUNT from MASTER..TEMP_RESULT where result=3)-(select CRAMOUNT from MASTER..TEMP_RESULT where result=4),NULL,  "
        strSql += vbCrLf + " 5 from MASTER..TEMP_RESULT where ISNULL(colhead,'')='G'    "
        strSql += vbCrLf + ""
        strSql += vbCrLf + ""
        strSql += vbCrLf + " update MASTER..TEMP_RESULT"
        strSql += vbCrLf + " SET  CRNETWT = CASE WHEN CRNETWT=0 THEN NULL ELSE CRNETWT END ,      "
        strSql += vbCrLf + " CRAMOUNT= CASE WHEN CRAMOUNT=0 THEN NULL ELSE CRAMOUNT END,      "
        strSql += vbCrLf + " CRRATE= CASE WHEN CRRATE=0 THEN NULL ELSE CRRATE END,      "
        strSql += vbCrLf + " CINETWT= CASE WHEN CINETWT=0 THEN NULL ELSE CINETWT END,      "
        strSql += vbCrLf + " CIAMOUNT= CASE WHEN CIAMOUNT=0 THEN NULL ELSE CIAMOUNT END,      "
        strSql += vbCrLf + " CIRATE= CASE WHEN CIRATE=0 THEN NULL ELSE CIRATE END,      "
        strSql += vbCrLf + " MRNETWT= CASE WHEN MRNETWT=0 THEN NULL ELSE MRNETWT END,      "
        strSql += vbCrLf + " MRMC= CASE WHEN MRMC=0 THEN NULL ELSE MRMC END,      "
        strSql += vbCrLf + " MINETWT= CASE WHEN MINETWT=0 THEN NULL ELSE MINETWT END,      "
        strSql += vbCrLf + " MIMC = CASE WHEN MIMC=0 THEN NULL ELSE MIMC END      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " update   MASTER..TEMP_RESULT  set CRRATE =convert(numeric(12,2),CRRATE),      "
        strSql += vbCrLf + " CIRATE =convert(numeric(12,2),CIRATE)      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " SELECT * FROM MASTER..TEMP_RESULT ORDER BY RESULT      "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_WINTERESTCAL()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WINTERESTCAL')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WINTERESTCAL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_WINTERESTCAL "
        strSql += vbCrLf + "  @RPTOPTION VARCHAR(1),@CALTYPE VARCHAR(1),"
        strSql += vbCrLf + "  @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,"
        strSql += vbCrLf + "  @CALDATE SMALLDATETIME,@GRACEPERIOD INT,@TOTDAYS INT,"
        strSql += vbCrLf + "  @AMTCALVAL NUMERIC(12,2),@WTCALVAL NUMERIC(12,2),"
        strSql += vbCrLf + "  @CUSTNAME VARCHAR(8000)  "
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --DECLARE @RPTOPTION VARCHAR(1)"
        strSql += vbCrLf + " --DECLARE @CALTYPE VARCHAR(1)"
        strSql += vbCrLf + " --DECLARE @FROMDATE SMALLDATETIME"
        strSql += vbCrLf + " --DECLARE @TODATE SMALLDATETIME"
        strSql += vbCrLf + " --DECLARE @CUSTNAME VARCHAR(8000)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --DECLARE @CALDATE SMALLDATETIME"
        strSql += vbCrLf + " --DECLARE @GRACEPERIOD INT"
        strSql += vbCrLf + " --DECLARE @TOTDAYS INT"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --DECLARE @AMTCALVAL NUMERIC(12,2)"
        strSql += vbCrLf + " --DECLARE @WTCALVAL NUMERIC(12,2)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @AMTPERCENTAGE  NUMERIC(12,3)"
        strSql += vbCrLf + " DECLARE @WTPERCENTAGE  NUMERIC(12,3)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /* @RPTOPTION='R' THEN RECEIPT ONLY*/"
        strSql += vbCrLf + " /* @RPTOPTION='I' THEN ISSUE ONLY*/"
        strSql += vbCrLf + " /* @RPTOPTION='A' THEN RECEIPT AND ISSUE */"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SET NOCOUNT ON "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --SET @RPTOPTION='A'"
        strSql += vbCrLf + " --SET @CALTYPE='A'"
        strSql += vbCrLf + " --SET @FROMDATE='2010-01-01'"
        strSql += vbCrLf + " --SET @TODATE='2010-12-10'"
        strSql += vbCrLf + " --SET @CALDATE='2010-12-12'"
        strSql += vbCrLf + " --SET @GRACEPERIOD=2"
        strSql += vbCrLf + " --SET @TOTDAYS=365"
        strSql += vbCrLf + " --SET @CUSTNAME='A G S JEWELLERY (AT NAGAR)'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --SET @WTCALVAL=10"
        strSql += vbCrLf + " --SET @AMTCALVAL=10"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " /*IF THE CALTYPE IS AMOUNT ('A') THEN */"
        strSql += vbCrLf + " /*HERE CONVERTING FROM AMOUNT TO PERCENTTAGE*/"
        strSql += vbCrLf + " IF @CALTYPE='A' "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET @AMTPERCENTAGE=@AMTCALVAL*12  "
        strSql += vbCrLf + "  SET @WTPERCENTAGE=@WTCALVAL*12 "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + " ELSE"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET @AMTPERCENTAGE=@AMTCALVAL"
        strSql += vbCrLf + "  SET @WTPERCENTAGE=@WTCALVAL"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SET @AMTPERCENTAGE=@AMTPERCENTAGE/100"
        strSql += vbCrLf + " SET @WTPERCENTAGE=@WTPERCENTAGE/100"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_METALISSREC') IS NOT NULL DROP TABLE MASTER..TEMP_METALISSREC"
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMP_METALISSREC(TRANDATE SMALLDATETIME, TYPE VARCHAR(1),METALRECEIPT NUMERIC(13,3),METALISSUE NUMERIC(13,3),MKEYNO INT IDENTITY)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_METALISSREC(TYPE,TRANDATE,METALRECEIPT,METALISSUE)"
        strSql += vbCrLf + " SELECT TYPE,TRANDATE,SUM(ISNULL(METALRECEIPT,0)) AS METALRECEIPT,SUM(ISNULL(METALISSUE,0)) AS METALISSUE"
        strSql += vbCrLf + " FROM ("
        strSql += vbCrLf + " SELECT NULL AS TRANDATE,'O' AS TYPE,NULL AS METALRECEIPT,CASE WHEN TRANTYPE='I' THEN PUREWT ELSE NULL END AS METALISSUE  FROM OPENWEIGHT"
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT NULL AS TRANDATE,'O' AS TYPE,CASE WHEN TRANTYPE='I' THEN NULL ELSE PUREWT END  AS    METALRECEIPT ,NULL AS METALISSUE  FROM OPENWEIGHT     "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT NULL AS TRANDATE,'O' AS TYPE,NULL AS METALRECEIPT,PUREWT AS METALISSUE FROM ISSUE WHERE TRANFLAG='W' AND TRANDATE<@FROMDATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT NULL AS TRANDATE,'O' AS TYPE,PUREWT AS METALRECEIPT , NULL AS METALISSUE FROM RECEIPT WHERE TRANFLAG='W' AND TRANDATE < @FROMDATE "
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT TRANDATE,'R' AS TYPE,PUREWT AS METALRECEIPT , NULL AS METALISSUE FROM RECEIPT WHERE TRANFLAG='W' AND TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT TRANDATE,'I' AS TYPE,NULL AS METALRECEIPT,PUREWT AS METALISSUE FROM ISSUE WHERE TRANFLAG='W' AND TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME))"
        strSql += vbCrLf + " ) X GROUP BY  TYPE,TRANDATE ORDER BY TYPE,TRANDATE"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @REC  NUMERIC(13,3)"
        strSql += vbCrLf + " DECLARE @ISS  NUMERIC(13,3)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SET @REC=(SELECT METALRECEIPT FROM MASTER..TEMP_METALISSREC WHERE TYPE='O')"
        strSql += vbCrLf + " SET @ISS=(SELECT METALISSUE FROM MASTER..TEMP_METALISSREC WHERE TYPE='O')"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @REC > 0 "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METALISSREC SET METALRECEIPT=@REC-@ISS,METALISSUE=NULL WHERE TYPE='O'   "
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + " ELSE"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METALISSREC SET METALISSUE=@ISS-@REC,METALRECEIPT=NULL WHERE TYPE='O'"
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_CASHISSREC') IS NOT NULL DROP TABLE MASTER..TEMP_CASHISSREC"
        strSql += vbCrLf + " CREATE TABLE MASTER..TEMP_CASHISSREC(TRANDATE SMALLDATETIME, TYPE VARCHAR(1),CASHRECEIPT NUMERIC(13,2),CASHISSUE NUMERIC(13,2),CKEYNO INT IDENTITY)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_CASHISSREC(TYPE,TRANDATE,CASHRECEIPT,CASHISSUE)"
        strSql += vbCrLf + " SELECT TYPE,TRANDATE,SUM(CASHRECEIPT) AS CASHRECEIPT ,SUM(CASHISSUE) AS CASHISSUE"
        strSql += vbCrLf + " FROM ("
        strSql += vbCrLf + " SELECT  NULL TRANDATE,'O' AS TYPE,DEBIT AS CASHRECEIPT, NULL AS CASHISSUE  FROM " & tranDbName & "..OPENTRAILBALANCE "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT  NULL TRANDATE,'O' AS TYPE,NULL AS CASHRECEIPT, CREDIT AS CASHISSUE  FROM " & tranDbName & "..OPENTRAILBALANCE "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT NULL,'O' AS TYPE,AMOUNT AS CASHRECEIPT , NULL AS CASHISSUE FROM ACCTRAN  WHERE TRANMODE='D' AND TRANDATE <@FROMDATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT NULL,'O' AS TYPE,NULL AS CASHRECEIPT , AMOUNT AS CASHISSUE FROM ACCTRAN  WHERE TRANMODE='C' AND TRANDATE <@FROMDATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT TRANDATE,'R' AS TYPE,AMOUNT AS CASHRECEIPT , NULL AS CASHISSUE FROM ACCTRAN  WHERE TRANMODE='D' AND TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " UNION ALL"
        strSql += vbCrLf + " SELECT TRANDATE,'I' AS TYPE,NULL AS CASHRECEIPT , AMOUNT AS CASHISSUE FROM ACCTRAN  WHERE TRANMODE='C' AND TRANDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + " AND ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (@CUSTNAME)) "
        strSql += vbCrLf + " ) AS X GROUP BY TYPE,TRANDATE ORDER BY TYPE,TRANDATE"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SET @REC=(SELECT CASHRECEIPT FROM MASTER..TEMP_CASHISSREC WHERE TYPE='O')"
        strSql += vbCrLf + " SET @ISS=(SELECT CASHISSUE FROM MASTER..TEMP_CASHISSREC WHERE TYPE='O')"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @REC > 0 "
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_CASHISSREC SET CASHRECEIPT=@REC-@ISS,CASHISSUE=NULL WHERE TYPE='O'   "
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + " ELSE"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_CASHISSREC SET CASHISSUE=@ISS-@REC,CASHRECEIPT=NULL WHERE TYPE='O'"
        strSql += vbCrLf + "  END "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --SELECT * FROM  MASTER..TEMP_METALISSREC"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_METALISSREC SET METALRECEIPT= ISNULL(METALRECEIPT,0)+ISNULL((SELECT METALRECEIPT FROM MASTER..TEMP_METALISSREC WHERE TYPE='O'),0)"
        strSql += vbCrLf + " WHERE TRANDATE IN(SELECT MIN(TRANDATE) FROM MASTER..TEMP_METALISSREC WHERE TRANDATE IS NOT NULL)"
        strSql += vbCrLf + " AND TYPE='R'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_METALISSREC SET METALISSUE= ISNULL(METALISSUE,0)+ISNULL((SELECT METALISSUE FROM MASTER..TEMP_METALISSREC WHERE TYPE='O'),0)"
        strSql += vbCrLf + " WHERE TRANDATE IN(SELECT MIN(TRANDATE) FROM MASTER..TEMP_METALISSREC WHERE TRANDATE IS NOT NULL)"
        strSql += vbCrLf + " AND TYPE='I'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_CASHISSREC SET CASHRECEIPT= ISNULL(CASHRECEIPT,0)+ISNULL((SELECT CASHRECEIPT FROM MASTER..TEMP_CASHISSREC WHERE TYPE='O'),0)"
        strSql += vbCrLf + " WHERE TRANDATE IN(SELECT MIN(TRANDATE) FROM MASTER..TEMP_CASHISSREC WHERE TRANDATE IS NOT NULL)"
        strSql += vbCrLf + " AND TYPE='R'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_CASHISSREC SET CASHISSUE= ISNULL(CASHISSUE,0)+ISNULL((SELECT CASHISSUE FROM MASTER..TEMP_CASHISSREC WHERE TYPE='O'),0)"
        strSql += vbCrLf + " WHERE TRANDATE IN(SELECT MIN(TRANDATE) FROM MASTER..TEMP_CASHISSREC WHERE TRANDATE IS NOT NULL) AND "
        strSql += vbCrLf + " TYPE='I'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DELETE FROM MASTER..TEMP_METALISSREC WHERE TYPE='O'"
        strSql += vbCrLf + " DELETE FROM MASTER..TEMP_CASHISSREC WHERE TYPE='O'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_RES_SHOW') IS NOT NULL DROP TABLE MASTER..TEMP_RES_SHOW"
        strSql += vbCrLf + " --PRINT @TOTDAYS"
        strSql += vbCrLf + " SELECT CONVERT(VARCHAR(300),NULL) AS PARTICULAR,T1.TRANDATE AS TRANDATE1 ,T2.TRANDATE AS TRANDATE2 ,"
        strSql += vbCrLf + " T1.METALRECEIPT,T1.METALISSUE ,T2.CASHRECEIPT,T2.CASHISSUE"
        strSql += vbCrLf + " INTO MASTER..TEMP_RES_SHOW "
        strSql += vbCrLf + " FROM MASTER..TEMP_METALISSREC AS T1 FULL JOIN MASTER..TEMP_CASHISSREC AS T2"
        strSql += vbCrLf + " ON T1.MKEYNO=T2.CKEYNO ORDER BY  T1.TRANDATE"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_RES_SHOW SET TRANDATE1=TRANDATE2 WHERE ISNULL(TRANDATE1 ,'')=''"
        strSql += vbCrLf + " UPDATE MASTER..TEMP_RES_SHOW SET PARTICULAR=CONVERT(VARCHAR(100),TRANDATE1,103)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " --SELECT * FROM MASTER..TEMP_RES_SHOW  ORDER BY TRANDATE1"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..TEMP_RES') IS NOT NULL DROP TABLE MASTER..TEMP_RES"
        strSql += vbCrLf + " SELECT PARTICULAR,TRANDATE1 AS TRANDATE,METALRECEIPT,METALISSUE,CASHRECEIPT,CASHISSUE,DATEDIFF(DAY,TRANDATE1,@CALDATE)-@GRACEPERIOD AS DAYS,"
        strSql += vbCrLf + " CONVERT(NUMERIC(13,3),NULL) AS METALINT ,CONVERT(NUMERIC(13,2),NULL) AS CASHINT,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD"
        strSql += vbCrLf + " INTO MASTER..TEMP_RES"
        strSql += vbCrLf + " FROM MASTER..TEMP_RES_SHOW ORDER BY TRANDATE"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_RES SET METALINT=CASE WHEN ISNULL(METALRECEIPT,0) <>0 THEN  (METALRECEIPT*DAYS*@WTPERCENTAGE)/@TOTDAYS"
        strSql += vbCrLf + "             WHEN ISNULL(METALISSUE,0) <> 0 THEN  -1*((METALISSUE*DAYS*@WTPERCENTAGE)/@TOTDAYS)"
        strSql += vbCrLf + "             ELSE NULL END "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE MASTER..TEMP_RES SET CASHINT=CASE WHEN ISNULL(CASHRECEIPT,0) <>0 THEN  (CASHRECEIPT*DAYS*@AMTPERCENTAGE)/@TOTDAYS"
        strSql += vbCrLf + "             WHEN ISNULL(CASHISSUE,0) <> 0 THEN  -1*((CASHISSUE*DAYS*@AMTPERCENTAGE)/@TOTDAYS)"
        strSql += vbCrLf + "             ELSE NULL END"
        strSql += vbCrLf + " --SELECT * FROM MASTER..TEMP_RES"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_RES(PARTICULAR,TRANDATE,METALRECEIPT,METALISSUE,CASHRECEIPT,CASHISSUE,DAYS,METALINT,CASHINT,RESULT,COLHEAD)"
        strSql += vbCrLf + " SELECT 'Total',null,null,null,null,null,null,SUM(METALINT),SUM(CASHINT),2,'G' FROM MASTER..TEMP_RES"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @RPTOPTION='A'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SELECT PARTICULAR,METALRECEIPT,METALISSUE,CASHRECEIPT,CASHISSUE,DAYS,METALINT,CASHINT,RESULT,COLHEAD FROM MASTER..TEMP_RES"
        strSql += vbCrLf + "  ORDER BY RESULT,TRANDATE,COLHEAD"
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @RPTOPTION='I'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SELECT PARTICULAR,TRANDATE,METALISSUE,CASHISSUE,DAYS,METALINT,CASHINT FROM MASTER..TEMP_RES"
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @RPTOPTION='R'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SELECT PARTICULAR,TRANDATE,METALRECEIPT,CASHRECEIPT,DAYS,METALINT,CASHINT FROM MASTER..TEMP_RES"
        strSql += vbCrLf + "  END  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_WMETALSTOCK_DETAILS()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WMETALSTOCK_DETAILS')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WMETALSTOCK_DETAILS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_WMETALSTOCK_DETAILS     "
        strSql += vbCrLf + "  (    "
        strSql += vbCrLf + "  @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME     "
        strSql += vbCrLf + "  ,@CATNAME AS VARCHAR(250)    "
        strSql += vbCrLf + "  ,@WT VARCHAR(1)     "
        strSql += vbCrLf + "  )    "
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  SET NOCOUNT ON  "
        strSql += vbCrLf + "  --GETING  WEIGHT--      "
        strSql += vbCrLf + "  IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME='TEMP_METALBALANCE_DET') > 0 DROP TABLE MASTER..TEMP_METALBALANCE_DET    "
        strSql += vbCrLf + "  SELECT TRANDATE,TRANNO,PARTYNAME AS PARTICULAR,CATCODE,CATNAME,      "
        strSql += vbCrLf + "  SUM(OPWT) AS OPWT,SUM(ISSWT)AS ISSWT,SUM(RECWT)as RECWT,             "
        strSql += vbCrLf + "  ((ISNULL(SUM(OPWT),0)+ISNULL(SUM(RECWT),0))-ISNULL(SUM(ISSWT),0))  AS CLWT  ,CONVERT(VARCHAR(2),NULL) AS COLHEAD  "
        strSql += vbCrLf + "  INTO MASTER..TEMP_METALBALANCE_DET FROM "
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,   "
        strSql += vbCrLf + "  CONVERT(SMALLDATETIME,NULL) AS TRANDATE ,CONVERT(INT,NULL) AS TRANNO ,     "
        strSql += vbCrLf + "  CONVERT(VARCHAR(250),'OPENING') AS PARTYNAME,   "
        strSql += vbCrLf + "  SUM(CASE WHEN TRANTYPE='I' THEN      "
        strSql += vbCrLf + "  CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END      "
        strSql += vbCrLf + "  ELSE -1 *      "
        strSql += vbCrLf + "  CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END      "
        strSql += vbCrLf + "  END) AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT"
        strSql += vbCrLf + "  FROM " & tranDbName & "..OPENWEIGHT AS T WHERE CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (@CATNAME))   "
        strSql += vbCrLf + "  GROUP BY  CATCODE  "
        strSql += vbCrLf + "  UNION ALL "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,   "
        strSql += vbCrLf + "  CONVERT(SMALLDATETIME,NULL) AS TRANDATE ,CONVERT(INT,NULL) AS TRANNO , "
        strSql += vbCrLf + "  CONVERT(VARCHAR(250),'OPENING') AS PARTYNAME,        "
        strSql += vbCrLf + "  SUM(CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END) AS OPWT,"
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS RECEIPT,CONVERT(NUMERIC(12,3),NULL) AS RECWT"
        strSql += vbCrLf + "  FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')=''  AND     "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (@CATNAME)) "
        strSql += vbCrLf + "  GROUP BY CATCODE     "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,    "
        strSql += vbCrLf + "  CONVERT(SMALLDATETIME,NULL) AS TRANDATE ,CONVERT(INT,NULL) AS TRANNO ,"
        strSql += vbCrLf + "  CONVERT(VARCHAR(250),'OPENING') AS PARTYNAME,   "
        strSql += vbCrLf + "  -1 *      "
        strSql += vbCrLf + "  SUM(CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END) AS OPWT,"
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT      "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')='' AND "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (@CATNAME)) "
        strSql += vbCrLf + "  GROUP BY CATCODE      "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,   "
        strSql += vbCrLf + "  CONVERT(SMALLDATETIME,TRANDATE) AS TRANDATE ,CONVERT(INT,TRANNO) AS TRANNO , "
        strSql += vbCrLf + "  (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS PARTYNAME,"
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS OPWT,     "
        strSql += vbCrLf + "  SUM(CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END) AS ISSWT,                          CONVERT(NUMERIC(12,3),NULL) AS RECWT"
        strSql += vbCrLf + "  FROM " & tranDbName & "..ISSUE  AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND      "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (@CATNAME))     "
        strSql += vbCrLf + "  GROUP BY CATCODE,TRANDATE,TRANNO,ACCODE               "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,   "
        strSql += vbCrLf + "  CONVERT(SMALLDATETIME,TRANDATE) AS TRANDATE ,CONVERT(INT,TRANNO) AS TRANNO , "
        strSql += vbCrLf + "  (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS PARTYNAME,    "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT,     "
        strSql += vbCrLf + "  SUM(CASE @WT WHEN 'P' THEN PUREWT WHEN 'G' THEN GRSWT WHEN 'N' THEN NETWT END) AS RECWT"
        strSql += vbCrLf + "  FROM " & tranDbName & "..RECEIPT  AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND      "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (@CATNAME))    "
        strSql += vbCrLf + "  GROUP BY CATCODE,TRANDATE,TRANNO ,ACCODE "
        strSql += vbCrLf + "  )AS X GROUP BY CATCODE,CATNAME,TRANDATE,TRANNO,PARTYNAME             "
        strSql += vbCrLf + "             "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_METALBALANCE_DET (PARTICULAR,OPWT,RECWT,ISSWT,CLWT,COLHEAD)           "
        strSql += vbCrLf + "  SELECT 'Total',sum(OPWT),SUM(RECWT),SUM(ISSWT),SUM(CLWT),'G' FROM MASTER..TEMP_METALBALANCE_DET "
        strSql += vbCrLf + "             "
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METALBALANCE_DET SET OPWT=CASE WHEN OPWT=0 THEN NULL ELSE OPWT END ,           "
        strSql += vbCrLf + "  RECWT=CASE WHEN RECWT=0 THEN NULL ELSE RECWT END,           "
        strSql += vbCrLf + "  ISSWT=CASE WHEN ISSWT=0 THEN NULL ELSE ISSWT END ,           "
        strSql += vbCrLf + "  CLWT=CASE WHEN CLWT=0 THEN NULL ELSE CLWT END           "
