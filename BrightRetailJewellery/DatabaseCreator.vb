        End If
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_TAGWISEPROFIT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFIT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGWISEPROFIT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_TAGWISEPROFIT  "
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME  "
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME  "
        strSql += vbCrLf + " ,@PURRATE VARCHAR(1)"
        strSql += vbCrLf + " ,@METALID VARCHAR(100)     "
        strSql += vbCrLf + " ,@CATCODE VARCHAR(1000) "
        strSql += vbCrLf + " ,@ITEMIDS VARCHAR(500)"
        strSql += vbCrLf + " ,@DESIGNERIDS VARCHAR(200)"
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " BEGIN  "
        strSql += vbCrLf + " SET NOCOUNT ON  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#TAGWISEPROFIT','U') IS NOT NULL DROP TABLE #TAGWISEPROFIT  "
        strSql += vbCrLf + " DECLARE @ITEMFILTER VARCHAR(1000)"
        strSql += vbCrLf + " DECLARE @DESFILTER VARCHAR(1000)"
        strSql += vbCrLf + " DECLARE @QRY VARCHAR(8000) "
        strSql += vbCrLf + " SET @DESIGNERIDS = REPLACE(@DESIGNERIDS,',',''',''')     "
        strSql += vbCrLf + " SET @METALID = REPLACE(@METALID,',',''',''')    "
        strSql += vbCrLf + " SET @CATCODE = REPLACE(@CATCODE,',',''',''')  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ITEMIDS') IS NOT NULL DROP TABLE #ITEMIDS   "
        strSql += vbCrLf + " CREATE TABLE #ITEMIDS(ITEMID INT) "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#DESIGNERS') IS NOT NULL DROP TABLE #DESIGNERS  "
        strSql += vbCrLf + " CREATE TABLE #DESIGNERS(DESIGNERID INT)    "
        strSql += vbCrLf + " SET @ITEMFILTER='' /** ITEM FILTER**/   "
        strSql += vbCrLf + " SET @ITEMFILTER= @ITEMFILTER +' I.ITEMID IN(SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(STOCKREPORT,'''')<>''N'' )'  "
        strSql += vbCrLf + " IF @METALID <> '' SET @ITEMFILTER= @ITEMFILTER +' AND I.ITEMID IN(SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN('''+@METALID+'''))'  "
        strSql += vbCrLf + " IF @CATCODE <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND I.ITEMID IN(SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE CATCODE IN('''+@CATCODE +'''))'  "
        strSql += vbCrLf + " IF @ITEMIDS <> '' SET @ITEMFILTER= @ITEMFILTER + ' AND I.ITEMID IN('+@ITEMIDS+')'  "
        strSql += vbCrLf + " SET @QRY = ''    "
        strSql += vbCrLf + " SELECT @QRY=' INSERT INTO #ITEMIDS(ITEMID) SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST I WHERE '+@ITEMFILTER"
        strSql += vbCrLf + " IF @DESIGNERIDS <> 'ALL' SELECT @QRY =@QRY+' INSERT INTO #DESIGNERS(DESIGNERID) SELECT DESIGNERID FROM " & compId & "ADMINDB..DESIGNER WHERE  DESIGNERID IN ('''+@DESIGNERIDS+''')' "
        strSql += vbCrLf + " PRINT @QRY  "
        strSql += vbCrLf + " EXEC(@QRY) "
        strSql += vbCrLf + " SET @ITEMFILTER='' /** DESIGNER FILTER**/   "
        strSql += vbCrLf + " SET @ITEMFILTER=  ' AND T.ITEMID IN(SELECT ITEMID FROM #ITEMIDS) '  "
        strSql += vbCrLf + " SET @DESFILTER='' /** DESIGNER FILTER**/   "
        strSql += vbCrLf + " IF @DESIGNERIDS <> '' SET @DESFILTER= @DESFILTER + ' AND T.DESIGNERID IN(SELECT DESIGNERID FROM #DESIGNERS)'  "
        strSql += vbCrLf + " SET @QRY = '  SELECT *  "
        strSql += vbCrLf + " ,AMOUNT-PURVALUE_CALC AS DIFF_ISSRATE  "
        strSql += vbCrLf + " ,AMOUNT-PURVALUE AS DIFF_STKRATE"
        strSql += vbCrLf + " ,WASTAGE-PURWASTAGE AS WASTAGEPROFIT"
        strSql += vbCrLf + " ,CASE WHEN ISNULL((ISNULL(WASTAGE,0) - ISNULL(PURWASTAGE,0)),0) <> 0 and ISNULL(GRSNETWT,0) > 0 "
        strSql += vbCrLf + " THEN  ROUND(CONVERT(NUMERIC(15,2),((ISNULL(WASTAGE,0) - ISNULL(PURWASTAGE,0))/GRSNETWT)*100),0) ELSE NULL END WASTAGEPROFITPER "
        strSql += vbCrLf + " ,CASE WHEN SEP = 1 THEN ''SALES'' ELSE ''SALES RETURN'' END TRANTYPE"
        strSql += vbCrLf + " INTO #TAGWISEPROFIT  "
        strSql += vbCrLf + " FROM  "
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " SELECT   "
        strSql += vbCrLf + " IM.ITEMNAME,SM.SUBITEMNAME  "
        strSql += vbCrLf + " ,I.TAGNO,I.PCS,I.GRSWT,I.NETWT  "
        strSql += vbCrLf + " ,(SELECT SUM(STNPCS) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAPCS  "
        strSql += vbCrLf + " ,(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAWT  "
        strSql += vbCrLf + " ,(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAAMT  "
        strSql += vbCrLf + " ,(SELECT DESIGNERNAME FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERID = T.DESIGNERID)AS DESIGNER  "
        strSql += vbCrLf + " ,I.TOUCH,I.WASTAGE,I.WASTPER AS SALWASTPER,PT.PURNETWT,PT.PURTOUCH,PT.PURWASTAGE"
        strSql += vbCrLf + " ,ROUND(CONVERT(NUMERIC(15,2),(CASE WHEN ISNULL(PT.PURWASTAGE,0) <> 0 AND ISNULL(PT.PURNETWT,0) <> 0 THEN ( ISNULL(PT.PURWASTAGE,0))/PT.PURNETWT ELSE 0 END)*100),2) PURWASTPER "
        strSql += vbCrLf + " ,I.RATE,I.MCHARGE,I.AMOUNT  "
        strSql += vbCrLf + " ,CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END GRSNETWT "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),CASE WHEN ISNULL(PT.PURTOUCH,0) > 0 THEN   "
        strSql += vbCrLf + " CASE WHEN PT.PURGRSNET = ''N'' THEN PT.PURNETWT ELSE T.GRSWT END * (PT.PURTOUCH/100) * CASE WHEN '''+@PURRATE+'''=''Y'' THEN PT.PURRATE ELSE I.RATE END "
        strSql += vbCrLf + " ELSE  "
        strSql += vbCrLf + " ((CASE WHEN PT.PURGRSNET = ''N'' THEN PT.PURNETWT ELSE T.GRSWT END + PT.PURWASTAGE) * CASE WHEN '''+@PURRATE+'''=''Y'' THEN PT.PURRATE ELSE I.RATE END )+PT.PURMC  "
        strSql += vbCrLf + " +(SELECT SUM(ISNULL(STNAMT,0)) FROM " & compId & "ADMINDB..PURITEMTAGSTONE  WHERE TAGSNO = T.SNO)"
        strSql += vbCrLf + " END)AS PURVALUE_CALC  "
        strSql += vbCrLf + " ,(PT.PURVALUE-PURTAX "
        strSql += vbCrLf + " +(SELECT SUM(ISNULL(STNAMT,0)) FROM " & compId & "ADMINDB..PURITEMTAGSTONE  WHERE TAGSNO = T.SNO))"
        strSql += vbCrLf + " AS PURVALUE,I.BATCHNO,CONVERT(INT,1) SEP"
        strSql += vbCrLf + " FROM ISSUE AS I  "
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID  "
        strSql += vbCrLf + " LEFT JOIN " & compId & "ADMINDB..SUBITEMMAST AS SM ON SM.ITEMID = I.ITEMID AND SM.SUBITEMID = I.SUBITEMID  "
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..ITEMTAG AS T ON T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO AND T.BATCHNO = I.BATCHNO  "
        strSql += vbCrLf + " LEFT JOIN " & compId & "ADMINDB..PURITEMTAG AS PT ON PT.TAGSNO = T.SNO  "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN '''+CONVERT(VARCHAR,@FROMDATE,101)+''' AND '''+CONVERT(VARCHAR,@TODATE,101)+''' AND ISNULL(I.CANCEL,'''') = ''''  "
        strSql += vbCrLf + " AND TRANTYPE IN (''SA'',''OD'') '"
        strSql += vbCrLf + " + @ITEMFILTER  "
        strSql += vbCrLf + " + @DESFILTER  "
        strSql += vbCrLf + " SET @QRY = @QRY + 'UNION ALL"
        strSql += vbCrLf + " SELECT   "
        strSql += vbCrLf + " IM.ITEMNAME,SM.SUBITEMNAME  "
        strSql += vbCrLf + " ,I.TAGNO,I.PCS,I.GRSWT,I.NETWT  "
        strSql += vbCrLf + " ,(SELECT SUM(STNPCS) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAPCS  "
        strSql += vbCrLf + " ,(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAWT  "
        strSql += vbCrLf + " ,(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')) AS DIAAMT  "
        strSql += vbCrLf + " ,(SELECT DESIGNERNAME FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERID = T.DESIGNERID)AS DESIGNER  "
        strSql += vbCrLf + " ,I.TOUCH,I.WASTAGE,I.WASTPER AS SALWASTPER,PT.PURNETWT,PT.PURTOUCH,PT.PURWASTAGE"
        strSql += vbCrLf + " ,ROUND(CONVERT(NUMERIC(15,2),(CASE WHEN ISNULL(PT.PURWASTAGE,0) <> 0 AND ISNULL(PT.PURNETWT,0) <> 0 THEN ( ISNULL(PT.PURWASTAGE,0))/PT.PURNETWT ELSE 0 END)*100 ),2) PURWASTPER "
        strSql += vbCrLf + " ,I.RATE,I.MCHARGE,I.AMOUNT  "
        strSql += vbCrLf + " ,CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END GRSNETWT "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),CASE WHEN ISNULL(PT.PURTOUCH,0) > 0 THEN   "
        strSql += vbCrLf + " CASE WHEN PT.PURGRSNET = ''N'' THEN PT.PURNETWT ELSE T.GRSWT END * (PT.PURTOUCH/100) * I.RATE  "
        strSql += vbCrLf + " ELSE  "
        strSql += vbCrLf + " ((CASE WHEN PT.PURGRSNET = ''N'' THEN PT.PURNETWT ELSE T.GRSWT END + PT.PURWASTAGE) * I.RATE)+PT.PURMC  "
        strSql += vbCrLf + " +(SELECT SUM(ISNULL(STNAMT,0)) FROM " & compId & "ADMINDB..PURITEMTAGSTONE  WHERE TAGSNO = T.SNO)"
        strSql += vbCrLf + " END)AS PURVALUE_CALC  "
        strSql += vbCrLf + " ,(PT.PURVALUE-PURTAX "
        strSql += vbCrLf + " +(SELECT SUM(ISNULL(STNAMT,0)) FROM " & compId & "ADMINDB..PURITEMTAGSTONE  WHERE TAGSNO = T.SNO))"
        strSql += vbCrLf + " AS PURVALUE,I.BATCHNO,CONVERT(INT,2) SEP  "
        strSql += vbCrLf + " FROM RECEIPT AS I  "
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID  "
        strSql += vbCrLf + " LEFT JOIN " & compId & "ADMINDB..SUBITEMMAST AS SM ON SM.ITEMID = I.ITEMID AND SM.SUBITEMID = I.SUBITEMID  "
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..ITEMTAG AS T ON T.ITEMID = I.ITEMID AND T.TAGNO = I.TAGNO AND T.BATCHNO = I.BATCHNO  "
        strSql += vbCrLf + " LEFT JOIN " & compId & "ADMINDB..PURITEMTAG AS PT ON PT.TAGSNO = T.SNO  "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN '''+CONVERT(VARCHAR,@FROMDATE,101)+''' AND '''+CONVERT(VARCHAR,@TODATE,101)+''' AND ISNULL(I.CANCEL,'''') = ''''  "
        strSql += vbCrLf + " AND TRANTYPE IN (''SR'') '"
        strSql += vbCrLf + " + @ITEMFILTER  "
        strSql += vbCrLf + " + @DESFILTER  "
        strSql += vbCrLf + " SET @QRY = @QRY + ' )X  "
        strSql += vbCrLf + " UPDATE #TAGWISEPROFIT SET  "
        strSql += vbCrLf + " PCS = CASE WHEN PCS = 0 THEN NULL ELSE PCS END  "
        strSql += vbCrLf + " ,GRSWT = CASE WHEN GRSWT = 0 THEN NULL ELSE GRSWT END  "
        strSql += vbCrLf + " ,NETWT = CASE WHEN NETWT = 0 THEN NULL ELSE NETWT END  "
        strSql += vbCrLf + " ,DIAPCS = CASE WHEN DIAPCS = 0 THEN NULL ELSE DIAPCS END  "
        strSql += vbCrLf + " ,DIAWT = CASE WHEN DIAWT = 0 THEN NULL ELSE DIAWT END  "
        strSql += vbCrLf + " ,TOUCH = CASE WHEN TOUCH = 0 THEN NULL ELSE TOUCH END  "
        strSql += vbCrLf + " ,WASTAGE = CASE WHEN WASTAGE = 0 THEN NULL ELSE WASTAGE END  "
        strSql += vbCrLf + " ,MCHARGE = CASE WHEN MCHARGE = 0 THEN NULL ELSE MCHARGE END  "
