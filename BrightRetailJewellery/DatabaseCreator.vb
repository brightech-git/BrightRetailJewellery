    Private Sub funcSP28CounterWiseStock_old()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COUNTERWISESTOCK_OLD')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERWISESTOCK_OLD"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_COUNTERWISESTOCK_OLD"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @ASONDATE SMALLDATETIME             "
        strSql += vbCrLf + " ,@METAL VARCHAR(100)             "
        strSql += vbCrLf + " ,@CATNAME VARCHAR(100)             "
