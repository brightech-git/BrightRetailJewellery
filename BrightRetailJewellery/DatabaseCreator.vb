        strSql += vbCrLf + "  		SELECT PAYMENT,'''' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDI "
        strSql += vbCrLf + "  		END'   "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		PRINT'/*******************~ ORDER ADJUSTED ***************~*/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ORDADJUSTED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADJUSTED "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,''   '' + (SELECT (PNAME+'' ''+INITIAL) CUSNAME FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT,0 AS PCS, GRSWT,NETWT ,0 AS TAX, 0 AS RECEIPT, AMOUNT  AS PAYMENT     "
