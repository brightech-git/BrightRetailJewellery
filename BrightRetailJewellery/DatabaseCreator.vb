        strSql += vbCrLf + "    DECLARE @TAGKEY VARCHAR(30)"
        strSql += vbCrLf + "    DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "    /*FOR TAGNO TRANDB*/"
