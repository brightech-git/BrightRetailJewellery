        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' THEN 0 ELSE PCS END)AS PCS,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' AND ISNULL(GRSWT,0)<0 THEN 0 ELSE CASE WHEN ISNULL(ITEMID,0)<>0 THEN GRSWT ELSE 0 END END)AS GRSWT,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD'' AND ISNULL(NETWT,0)<0 THEN 0 ELSE CASE WHEN ISNULL(ITEMID,0)<>0 THEN NETWT ELSE 0 END END)AS NETWT,TAX AS TAX,CATCODE"
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')=''N'' AND TRANTYPE=I.TRANTYPE)AS SGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')=''N'' AND TRANTYPE=I.TRANTYPE)AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,''N'')=''N'' AND TRANTYPE=I.TRANTYPE)AS IGST"
        strSql += vbCrLf + "  		,TAGNO  "
