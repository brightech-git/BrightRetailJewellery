    Private Sub funcsp_DataConsistentCheck()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CHECKDATACONSISTENT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CHECKDATACONSISTENT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_CHECKDATACONSISTENT(@DBNAME AS VARCHAR(8),@CHKCOSTID AS VARCHAR(1))"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	DECLARE @COSTID VARCHAR(2)"
        strSql += vbCrLf + " 	DECLARE @COMPANYID VARCHAR(3)"
        strSql += vbCrLf + " 	DECLARE @TABLENAME VARCHAR(25)"
        strSql += vbCrLf + " 	DECLARE @COLUMNNAME VARCHAR(25)"
        strSql += vbCrLf + " 	DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + " 	SELECT  @COSTID=REPLICATE('0',2-LEN(CTLTEXT))+ CTLTEXT FROM SOFTCONTROL WHERE CTLID='COSTID'"
        strSql += vbCrLf + " 	SELECT  @COMPANYID=REPLICATE('0',3-LEN(CTLTEXT))+ CTLTEXT FROM SOFTCONTROL WHERE CTLID='COMPANYID'"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..CHKFIELD','U') IS NOT NULL DROP TABLE TEMPTABLEDB..CHKFIELD"
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..CHKFIELD(TABLENAME VARCHAR(50),FIELD VARCHAR(30),STATUS VARCHAR(10))"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..CHKCOLUMN','U') IS NOT NULL DROP TABLE TEMPTABLEDB..CHKCOLUMN"
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..CHKCOLUMN(COLUMNNAME VARCHAR(50))"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'BATCHNO'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'SNO'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'RUNNO'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'TAGSNO'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'ORNO'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..CHKCOLUMN SELECT 'ORUNNO'"
        strSql += vbCrLf + " 	DECLARE CCUR CURSOR FOR SELECT COLUMNNAME FROM TEMPTABLEDB..CHKCOLUMN"
        strSql += vbCrLf + " 	OPEN CCUR "
        strSql += vbCrLf + " 	FETCH NEXT FROM CCUR INTO @COLUMNNAME"
        strSql += vbCrLf + " 	WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QRY='DECLARE ACUR CURSOR FOR  SELECT NAME FROM SYSOBJECTS WHERE XTYPE=''U'' AND ID IN(SELECT ID FROM SYSCOLUMNS WHERE NAME='''+@COLUMNNAME+''')'"
        strSql += vbCrLf + " 		IF @CHKCOSTID='Y'"
        strSql += vbCrLf + " 			SELECT @QRY=@QRY+' AND ID IN(SELECT ID FROM SYSCOLUMNS WHERE NAME=''COSTID'')'"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 		OPEN ACUR "
        strSql += vbCrLf + " 		FETCH NEXT FROM ACUR INTO @TABLENAME"
        strSql += vbCrLf + " 		WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SELECT @QRY='IF (SELECT COUNT(*) FROM '+@TABLENAME+' WHERE '+@COLUMNNAME+' NOT LIKE '''+@COSTID+@COMPANYID+'%'''"
        strSql += vbCrLf + " 			IF @CHKCOSTID='Y'"
        strSql += vbCrLf + " 				SELECT @QRY= @QRY+' AND COSTID='''+@COSTID+''''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' )>0'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' BEGIN' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' INSERT INTO TEMPTABLEDB..CHKFIELD(TABLENAME,FIELD,STATUS)SELECT '''+@TABLENAME+''','''+@COLUMNNAME+''',''Not Ok'''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' END' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' ELSE'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' BEGIN' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' INSERT INTO TEMPTABLEDB..CHKFIELD(TABLENAME,FIELD,STATUS)SELECT '''+@TABLENAME+''','''+@COLUMNNAME+''',''Ok'''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' END' "
        strSql += vbCrLf + " 			PRINT @QRY"
        strSql += vbCrLf + " 			EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 			FETCH NEXT FROM ACUR INTO @TABLENAME"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		CLOSE ACUR"
        strSql += vbCrLf + " 		DEALLOCATE ACUR"
        strSql += vbCrLf + " 		SELECT @QRY='DECLARE TCUR CURSOR FOR  '"
        strSql += vbCrLf + " 		SELECT @QRY= @QRY+' SELECT NAME FROM '+ @DBNAME + '..SYSOBJECTS WHERE XTYPE=''U'' AND ID IN(SELECT ID FROM '+@DBNAME+'..SYSCOLUMNS WHERE NAME='''+@COLUMNNAME+''')'"
        strSql += vbCrLf + " 		IF @CHKCOSTID='Y'"
        strSql += vbCrLf + " 			SELECT @QRY=@QRY+' AND ID IN(SELECT ID FROM SYSCOLUMNS WHERE NAME=''COSTID'')'"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 		OPEN TCUR "
        strSql += vbCrLf + " 		FETCH NEXT FROM TCUR INTO @TABLENAME"
        strSql += vbCrLf + " 		WHILE @@FETCH_STATUS <>-1"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SELECT @QRY='IF (SELECT COUNT(*) FROM '+ @DBNAME + '..'+@TABLENAME+' WHERE '+@COLUMNNAME+' NOT LIKE '''+@COSTID+@COMPANYID+'%'''"
        strSql += vbCrLf + " 			IF @CHKCOSTID='Y'"
        strSql += vbCrLf + " 				SELECT @QRY= @QRY+' AND COSTID='''+@COSTID+''''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' )>0'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' BEGIN' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' INSERT INTO TEMPTABLEDB..CHKFIELD(TABLENAME,FIELD,STATUS)SELECT '''+@TABLENAME+''','''+@COLUMNNAME+''',''Not Ok'''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' END' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' ELSE'"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' BEGIN' "
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' INSERT INTO TEMPTABLEDB..CHKFIELD(TABLENAME,FIELD,STATUS)SELECT '''+@TABLENAME+''','''+@COLUMNNAME+''',''Ok'''"
        strSql += vbCrLf + " 			SELECT @QRY= @QRY+' END' "
        strSql += vbCrLf + " 			PRINT @QRY"
        strSql += vbCrLf + " 			EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 			FETCH NEXT FROM TCUR INTO @TABLENAME"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		CLOSE TCUR"
        strSql += vbCrLf + " 		DEALLOCATE TCUR"
        strSql += vbCrLf + " 		FETCH NEXT FROM CCUR INTO @COLUMNNAME"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	CLOSE CCUR"
        strSql += vbCrLf + " 	DEALLOCATE CCUR"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_CUSTOMEROUTSTANDING()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CUSTOMEROUTSTANDING')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CUSTOMEROUTSTANDING"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_CUSTOMEROUTSTANDING"
        strSql += vbCrLf + "(  "
        strSql += vbCrLf + "@FROMDATE VARCHAR(12)"
        strSql += vbCrLf + ",@TODATE VARCHAR(12)"
        strSql += vbCrLf + ",@DISPLAY VARCHAR(1)"
        strSql += vbCrLf + ",@SUMMARY VARCHAR(1)"
        strSql += vbCrLf + ",@ORDERBY VARCHAR(1)"
        strSql += vbCrLf + ",@FILTERBY VARCHAR(50)"
        strSql += vbCrLf + ",@FILTERCAPTION VARCHAR(50)"
        strSql += vbCrLf + ",@COSTNAME VARCHAR(50)"
        strSql += vbCrLf + ",@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + ",@TYPEID VARCHAR(50)"
        strSql += vbCrLf + ",@ACCODE VARCHAR(25)"
        strSql += vbCrLf + ",@GRPAREA VARCHAR(1)"
        strSql += vbCrLf + ",@GRPCC VARCHAR(1)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "	DECLARE @TYPE VARCHAR(50)"
        strSql += vbCrLf + "	SET @TYPE = @TYPEID"
        strSql += vbCrLf + "	SET @TYPEID = REPLACE(@TYPEID,'DP','D')"
        strSql += vbCrLf + "	SET @ACCODE= REPLACE(@ACCODE,',',''',''')"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..COSTCENTRE"
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..COSTCENTRE(COSTID VARCHAR(3))  "
        strSql += vbCrLf + "	IF @COSTNAME = 'ALL' OR @COSTNAME = ''  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..COSTCENTRE SELECT COSTID FROM COSTCENTRE UNION ALL SELECT ''  "
        strSql += vbCrLf + "	ELSE  "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..COSTCENTRE SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = @COSTNAME  "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..COMPANY', 'U') IS NOT NULL DROP TABLE  TEMPTABLEDB..COMPANY    "
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..COMPANY (COMPANYID VARCHAR(3))    "
        strSql += vbCrLf + "	DECLARE @TCOMPANY VARCHAR(50)    "
        strSql += vbCrLf + "	IF CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..COMPANY (COMPANYID) SELECT @COMPANYID    "
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@COMPANYID)>0    "
        strSql += vbCrLf + "	BEGIN    "
        strSql += vbCrLf + "	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)    "
        strSql += vbCrLf + "	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))    "
        strSql += vbCrLf + "	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "	SET @COMPANYID= @COMPANYID + ','    "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..COMPANY (COMPANYID) SELECT @TCOMPANY    "
        strSql += vbCrLf + "	END    "
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TYPE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TYPE   "
        strSql += vbCrLf + "	CREATE TABLE TEMPTABLEDB..TYPE (TYPEID VARCHAR(3))      "
        strSql += vbCrLf + "	DECLARE @TEMPID VARCHAR(5)      "
        strSql += vbCrLf + "	IF CHARINDEX(',',@TYPEID)=0      "
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TYPE (TYPEID) SELECT @TYPEID      "
