        strSql += vbCrLf + " 	END CATCH"
        strSql += vbCrLf + " 	FETCH NEXT FROM RUNCUR INTO @COLTYPE"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " CLOSE RUNCUR"
        strSql += vbCrLf + " DEALLOCATE RUNCUR"
