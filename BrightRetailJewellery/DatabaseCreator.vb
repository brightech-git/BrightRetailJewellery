        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ',SUM(R.NETWT)NETWT,'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ '(SELECT METALNAME FROM ' + @DBNAME + '..METALMAST WHERE METALID=R.METALID) AS METALTYPE,'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'SUM(R.AMOUNT)VALUE, SUM(R.TAX)SALESTAXAMT,'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'R.REMARK1, SUM(R.AMOUNT + R.TAX)TOTAL'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ',C.SALESTAX, R.BATCHNO'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'FROM RECEIPT AS R'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'LEFT JOIN ' + @DBNAME + '..CATEGORY AS C ON C.CATCODE = R.CATCODE'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'LEFT JOIN ' + @DBNAME + '..CUSTOMERINFO AS CI ON CI.BATCHNO = R.BATCHNO'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'LEFT JOIN ' + @DBNAME + '..PERSONALINFO AS PIN ON PIN.SNO = CI.PSNO'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'WHERE R.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''''"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'AND R.TRANTYPE IN (''SR'',''PU'')'    "
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'AND ISNULL(R.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'AND ISNULL(R.COMPANYID,'''') =  '''+@COMPANYID+''' AND R.AMOUNT > 0 AND ISNULL(R.CANCEL,'''') = '''''"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'GROUP BY R.TRANDATE, R.TRANNO, R.REMARK1'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ',C.SALESTAX, PNAME'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ',R.METALID, R.BATCHNO'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ')Z '"
