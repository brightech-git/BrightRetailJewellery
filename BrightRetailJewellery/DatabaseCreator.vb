        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' AND ISNULL(O.CANCEL,'''') = '''''  "
        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMP_OUT_COMPANY)'+ @ACCFILTER + @ACCCFILTER  "
