    Private Sub Alter_Column_Length(ByVal ColumnName As String, ByVal Length As Integer, ByVal Dbname As String)
        Func_Sp_Alter_Column_Length()
        strSql = "EXEC " & cnAdminDb & "..SP_ADDLENGTH "
        strSql += vbCrLf + "@DBNAME = '" & Dbname & "'"
        strSql += vbCrLf + ",@COLUMNNAME = '" & ColumnName & "'"
        strSql += vbCrLf + ",@LENGTH = '" & Length & "'"
        cmd = New OleDbCommand(strSql, cn)
        cmd.ExecuteNonQuery()

        'Dim CnCatalog As String = cn.Database
        'strSql = vbCrLf + "  IF OBJECT_ID('" + Dbname + "..TEMPQUERY') IS NOT NULL DROP TABLE " + Dbname + "..TEMPQUERY"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  CREATE TABLE " + Dbname + "..TEMPQUERY (QUERY VARCHAR(8000))"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  USE " & Dbname & ""
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  declare @SchemaName varchar(100)declare @TableName varchar(256)"
        'strSql += vbCrLf + "  declare @IndexName varchar(256)"
        'strSql += vbCrLf + "  declare @ColumnName varchar(100)"
        'strSql += vbCrLf + "  declare @is_unique varchar(100)"
        'strSql += vbCrLf + "  declare @IndexTypeDesc varchar(100)"
        'strSql += vbCrLf + "  declare @FileGroupName varchar(100)"
        'strSql += vbCrLf + "  declare @is_disabled varchar(100)"
        'strSql += vbCrLf + "  declare @IndexOptions varchar(max)"
        'strSql += vbCrLf + "  declare @IndexColumnId int"
        'strSql += vbCrLf + "  declare @IsDescendingKey int "
        'strSql += vbCrLf + "  declare @IsIncludedColumn int"
        'strSql += vbCrLf + "  declare @TSQLScripCreationIndex varchar(max)"
        'strSql += vbCrLf + "  declare @TSQLScripDisableIndex varchar(max)"
        'strSql += vbCrLf + "  declare CursorIndex cursor for"
        'strSql += vbCrLf + "   select schema_name(t.schema_id) [schema_name], t.name, ix.name,"
        'strSql += vbCrLf + "   case when ix.is_unique = 1 then 'UNIQUE ' else '' END "
        'strSql += vbCrLf + "   , ix.type_desc,"
        'strSql += vbCrLf + "   case when ix.is_padded=1 then 'PAD_INDEX = ON, ' else 'PAD_INDEX = OFF, ' end"
        'strSql += vbCrLf + "   + case when ix.allow_page_locks=1 then 'ALLOW_PAGE_LOCKS = ON, ' else 'ALLOW_PAGE_LOCKS = OFF, ' end"
        'strSql += vbCrLf + "   + case when ix.allow_row_locks=1 then  'ALLOW_ROW_LOCKS = ON, ' else 'ALLOW_ROW_LOCKS = OFF, ' end"
        'strSql += vbCrLf + "   + case when INDEXPROPERTY(t.object_id, ix.name, 'IsStatistics') = 1 then 'STATISTICS_NORECOMPUTE = ON, ' else 'STATISTICS_NORECOMPUTE = OFF, ' end"
        'strSql += vbCrLf + "   + case when ix.ignore_dup_key=1 then 'IGNORE_DUP_KEY = ON, ' else 'IGNORE_DUP_KEY = OFF, ' end"
        'strSql += vbCrLf + "   + 'SORT_IN_TEMPDB = OFF, FILLFACTOR =100' AS IndexOptions"
        'strSql += vbCrLf + "   , ix.is_disabled , FILEGROUP_NAME(ix.data_space_id) FileGroupName"
        'strSql += vbCrLf + "   from sys.tables t "
        'strSql += vbCrLf + "   inner join sys.indexes ix on t.object_id=ix.object_id"
        'strSql += vbCrLf + "   where ix.type>0 and ix.is_primary_key=0 and ix.is_unique_constraint=0 "
        'strSql += vbCrLf + "   and t.is_ms_shipped=0 and t.name<>'sysdiagrams'"
        'strSql += vbCrLf + "   order by schema_name(t.schema_id), t.name, ix.name"
        'strSql += vbCrLf + "  open CursorIndex"
        'strSql += vbCrLf + "  fetch next from CursorIndex into  @SchemaName, @TableName, @IndexName, @is_unique, @IndexTypeDesc, @IndexOptions,@is_disabled, @FileGroupName"
        'strSql += vbCrLf + "  while (@@fetch_status=0)"
        'strSql += vbCrLf + "  begin"
        'strSql += vbCrLf + "   declare @IndexColumns varchar(max)"
        'strSql += vbCrLf + "   declare @IncludedColumns varchar(max)"
        'strSql += vbCrLf + "   set @IndexColumns=''"
        'strSql += vbCrLf + "   set @IncludedColumns=''"
        'strSql += vbCrLf + "   declare CursorIndexColumn cursor for "
        'strSql += vbCrLf + "    select col.name, ixc.is_descending_key, ixc.is_included_column"
        'strSql += vbCrLf + "    from sys.tables tb "
        'strSql += vbCrLf + "    inner join sys.indexes ix on tb.object_id=ix.object_id"
        'strSql += vbCrLf + "    inner join sys.index_columns ixc on ix.object_id=ixc.object_id and ix.index_id= ixc.index_id"
        'strSql += vbCrLf + "    inner join sys.columns col on ixc.object_id =col.object_id  and ixc.column_id=col.column_id"
        'strSql += vbCrLf + "    where ix.type>0 and (ix.is_primary_key=0 or ix.is_unique_constraint=0)"
        'strSql += vbCrLf + "    and schema_name(tb.schema_id)=@SchemaName and tb.name=@TableName and ix.name=@IndexName"
        'strSql += vbCrLf + "    order by ixc.index_column_id"
        'strSql += vbCrLf + "   open CursorIndexColumn "
        'strSql += vbCrLf + "   fetch next from CursorIndexColumn into  @ColumnName, @IsDescendingKey, @IsIncludedColumn"
        'strSql += vbCrLf + "   while (@@fetch_status=0)"
        'strSql += vbCrLf + "   begin"
        'strSql += vbCrLf + "    if @IsIncludedColumn=0 "
        'strSql += vbCrLf + "     set @IndexColumns=@IndexColumns + @ColumnName  + case when @IsDescendingKey=1  then ' DESC, ' else  ' ASC, ' end"
        'strSql += vbCrLf + "    else "
        'strSql += vbCrLf + "     set @IncludedColumns=@IncludedColumns  + @ColumnName  +', ' "
        'strSql += vbCrLf + "    fetch next from CursorIndexColumn into @ColumnName, @IsDescendingKey, @IsIncludedColumn"
        'strSql += vbCrLf + "   end"
        'strSql += vbCrLf + "   close CursorIndexColumn"
        'strSql += vbCrLf + "   deallocate CursorIndexColumn"
        'strSql += vbCrLf + "   set @IndexColumns = substring(@IndexColumns, 1, len(@IndexColumns)-1)"
        'strSql += vbCrLf + "   set @IncludedColumns = case when len(@IncludedColumns) >0 then substring(@IncludedColumns, 1, len(@IncludedColumns)-1) else '' end "
        'strSql += vbCrLf + "   set @TSQLScripCreationIndex =''"
        'strSql += vbCrLf + "   set @TSQLScripDisableIndex =''"
        'strSql += vbCrLf + "   set @TSQLScripCreationIndex='CREATE '+ @is_unique  +@IndexTypeDesc + ' INDEX ' +QUOTENAME(@IndexName)+' ON ' + QUOTENAME(@SchemaName) +'.'+ QUOTENAME(@TableName)+ '('+@IndexColumns+') '+ "
        'strSql += vbCrLf + "    case when len(@IncludedColumns)>0 then CHAR(13) +'INCLUDE (' + @IncludedColumns+ ')' else '' end + CHAR(13)+'WITH (' + @IndexOptions+ ') ON ' + QUOTENAME(@FileGroupName) + ';'  "
        'strSql += vbCrLf + "   if @is_disabled=1 "
        'strSql += vbCrLf + "    set  @TSQLScripDisableIndex=  CHAR(13) +'ALTER INDEX ' +QUOTENAME(@IndexName) + ' ON ' + QUOTENAME(@SchemaName) +'.'+ QUOTENAME(@TableName) + ' DISABLE;' + CHAR(13) "
        'strSql += vbCrLf + "   print @TSQLScripCreationIndex"
        'strSql += vbCrLf + "   print @TSQLScripDisableIndex"
        'strSql += vbCrLf + "  INSERT INTO " + Dbname + "..TEMPQUERY"
        'strSql += vbCrLf + "  SELECT @TSQLScripCreationIndex"
        'strSql += vbCrLf + "  INSERT INTO " + Dbname + "..TEMPQUERY"
        'strSql += vbCrLf + "  SELECT @TSQLScripDisableIndex"
        'strSql += vbCrLf + "   fetch next from CursorIndex into  @SchemaName, @TableName, @IndexName, @is_unique, @IndexTypeDesc, @IndexOptions,@is_disabled, @FileGroupName"
        'strSql += vbCrLf + "  end"
        'strSql += vbCrLf + "  close CursorIndex"
        'strSql += vbCrLf + "  deallocate CursorIndex"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = "  SELECT * FROM " + Dbname + "..TEMPQUERY WHERE ISNULL(QUERY,'')<>''"
        'Dim dtQry As New DataTable
        'dtQry = GetSqlTable(strSql, cn)

        'strSql = vbCrLf + "  IF OBJECT_ID('" + Dbname + "..TEMPQUERYDROP') IS NOT NULL DROP TABLE " + Dbname + "..TEMPQUERYDROP"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  CREATE TABLE " + Dbname + "..TEMPQUERYDROP (QUERY VARCHAR(8000))"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  USE " & Dbname & ""
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = vbCrLf + "  DECLARE @SchemaName VARCHAR(256)DECLARE @TableName VARCHAR(256)"
        'strSql += vbCrLf + "  DECLARE @IndexName VARCHAR(256)"
        'strSql += vbCrLf + "  DECLARE @TSQLDropIndex VARCHAR(MAX)"
        'strSql += vbCrLf + "  DECLARE CursorIndexes CURSOR FOR"
        'strSql += vbCrLf + "   SELECT schema_name(t.schema_id), t.name,  i.name "
        'strSql += vbCrLf + "   FROM sys.indexes i"
        'strSql += vbCrLf + "   INNER JOIN sys.tables t ON t.object_id= i.object_id"
        'strSql += vbCrLf + "   WHERE i.type>0 and t.is_ms_shipped=0 and t.name<>'sysdiagrams'"
        'strSql += vbCrLf + "   and (is_primary_key=0 and is_unique_constraint=0)"
        'strSql += vbCrLf + "  OPEN CursorIndexes"
        'strSql += vbCrLf + "  FETCH NEXT FROM CursorIndexes INTO @SchemaName,@TableName,@IndexName"
        'strSql += vbCrLf + "  WHILE @@fetch_status = 0"
        'strSql += vbCrLf + "  BEGIN"
        'strSql += vbCrLf + "   SET @TSQLDropIndex = 'DROP INDEX '+QUOTENAME(@SchemaName)+ '.' + QUOTENAME(@TableName) + '.' +QUOTENAME(@IndexName)"
        'strSql += vbCrLf + "   PRINT @TSQLDropIndex"
        'strSql += vbCrLf + "   INSERT INTO " + Dbname + "..TEMPQUERYDROP"
        'strSql += vbCrLf + "   SELECT @TSQLDropIndex"
        'strSql += vbCrLf + "   FETCH NEXT FROM CursorIndexes INTO @SchemaName,@TableName,@IndexName"
        'strSql += vbCrLf + "  END"
        'strSql += vbCrLf + "  CLOSE CursorIndexes"
        'strSql += vbCrLf + "  DEALLOCATE CursorIndexes"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
        'strSql = "  SELECT * FROM " + Dbname + "..TEMPQUERYDROP"
        'Dim dtQryDrop As New DataTable
        'dtQryDrop = GetSqlTable(strSql, cn)

        'For Each dr As DataRow In dtQryDrop.Rows
        '    cmd = New OleDbCommand(dr.Item(0).ToString, cn)
        '    cmd.ExecuteNonQuery()
        'Next

        'strSql = "EXEC " & cnAdminDb & "..SP_ADDLENGTH "
        'strSql += vbCrLf + "@DBNAME = '" & Dbname & "'"
        'strSql += vbCrLf + ",@COLUMNNAME = '" & ColumnName & "'"
        'strSql += vbCrLf + ",@LENGTH = '" & Length & "'"
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()

        'For Each dr As DataRow In dtQry.Rows
        '    cmd = New OleDbCommand(dr.Item(0).ToString, cn)
        '    cmd.ExecuteNonQuery()
        'Next
        'strSql = vbCrLf + "  USE " & CnCatalog & ""
        'cmd = New OleDbCommand(strSql, cn)
        'cmd.ExecuteNonQuery()
    End Sub
