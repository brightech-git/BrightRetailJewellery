        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' CASE WHEN I.TRANTYPE = ''PU'' THEN (AMOUNT-TAX-SC-(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM  TAXTRAN WHERE ISSSNO = I.SNO AND TRANTYPE = I.TRANTYPE))    '  "
