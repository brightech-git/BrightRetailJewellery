        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' SELECT TRANDATE,''T'',1 FROM'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' ('"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT T.TRANDATE FROM ACCTRAN AS T, " & compId & "ADMINDB..ACHEAD AS A'"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' WHERE T.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' '"
        'strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.CANCEL,'''') = '''' '"
        'strSql += vbCrLf + "  		/*SELECT @QRY=@QRY+CHAR(13)+' AND T.COMPANYID = '''+@COMPANYID+''' '*/"
