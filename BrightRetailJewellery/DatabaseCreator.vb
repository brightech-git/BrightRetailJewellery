        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,TAXPER,CONVERT(NUMERIC(15,2),WT+CASE WHEN MAXWASTPER<>0 THEN (WT*MAXWASTPER/100) ELSE MAXWAST END)SALEWT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,CONVERT(NUMERIC(15,2),CASE WHEN CALTYPE IN(''R'',''M'',''P'',''F'') THEN RATE ELSE'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' (WT+CASE WHEN MAXWASTPER<>0 THEN (WT*MAXWASTPER/100) ELSE MAXWAST END)*RATE END) GRSAMOUNT'"
        strSql += vbCrLf + "  SELECT @STRSQL=@STRSQL+CHAR(13)+' ,CONVERT(NUMERIC(15,2),STNAMT)STONEAMT '"
