    Private Sub btnMenuModifier_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles btnMenuModifier.Click
        Me.Hide()
        Try
            If dbType.ToUpper = "W" Then
                GlobalVariables.cn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=;Data Source=" & serverName & "")
            Else
                GlobalVariables.cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=;Data Source=" & serverName & ";password=" & pwd & "")
            End If
            'GlobalVariables.cn = New OleDbConnection(cn.ConnectionString)
            GlobalVariables.cnAdminDb = compId & "ADMINDB"
            GlobalVariables.cn.Open()
            Dim obj As New ExeExtender
            obj.ShowDialog()
        Catch ex As Exception
            MsgBox(ex.Message + vbCrLf + ex.StackTrace)
        Finally
            Me.Show()
        End Try
    End Sub
