        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,O.RUNNO,CONVERT(VARCHAR(50),O.TRANTYPE)TRANTYPE'  "
