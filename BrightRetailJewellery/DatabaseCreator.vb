        strSql += vbCrLf + "  			SELECT @QRY= @QRY + ' AND C.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))'"
        strSql += vbCrLf + "  			SELECT @QRY= @QRY + ' AND C.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)'"
