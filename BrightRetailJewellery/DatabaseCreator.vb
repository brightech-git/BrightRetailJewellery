        strSql += vbCrLf + " SELECT @QRY =  'IF (SELECT COUNT(*) FROM TEMPTABLEDB..GROUPLEDGER_RES'+@SYSID+')>0 '    "
        strSql += vbCrLf + " SELECT @QRY = @QRY + CHAR(13)+'BEGIN '    "
        strSql += vbCrLf + " SELECT @QRY = @QRY + CHAR(13)+'UPDATE TEMPTABLEDB..GROUPLEDGER_RES'+@SYSID+' set fnydate=REPLACE(CONVERT(NVARCHAR,CAST(fnydate AS DATETIME), 106), '' '', ''-'') '     "
        strSql += vbCrLf + " SELECT @QRY = @QRY + CHAR(13)+'END '    "
        strSql += vbCrLf + " EXEC (@QRY)    "
        strSql += vbCrLf + " PRINT @QRY  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSP_RPT_VATFORM_ANNEXURE_1()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_VATFORM_ANNEXURE_1')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_VATFORM_ANNEXURE_1"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "  CREATE PROCEDURE [SP_RPT_VATFORM_ANNEXURE_1]       "
        strSql += vbCrLf + "  (       "
        strSql += vbCrLf + "  @DBNAME VARCHAR(20),       "
        strSql += vbCrLf + "  @FROMDATE VARCHAR(20),       "
        strSql += vbCrLf + "  @TODATE VARCHAR(20),  "
        strSql += vbCrLf + "  @COSTID VARCHAR(20),"
        strSql += vbCrLf + "  @COMPANYIDS VARCHAR(50) "
        strSql += vbCrLf + "  )AS       "
        strSql += vbCrLf + "  DECLARE @QUERY NVARCHAR(3500)       "
        strSql += vbCrLf + "  DECLARE @COMPFILTER VARCHAR(2000)  "
        strSql += vbCrLf + "  DECLARE @COSTFILTER VARCHAR(2000)  "
        strSql += vbCrLf + "  BEGIN              "
        strSql += vbCrLf + "  SET @COMPFILTER=''  "
        strSql += vbCrLf + "  SET @COSTFILTER=''  "
        strSql += vbCrLf + "  IF @COMPANYIDS<>'ALL' SELECT @COMPFILTER=' AND T.COMPANYID IN('''+ @COMPANYIDS +''')'  "
        strSql += vbCrLf + "  IF @COSTID<>'ALL' SELECT @COSTFILTER=' AND T.COSTID IN('''+ REPLACE(@COSTID,',',''',''') +''')'  "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPACHEAD', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD "
        strSql += vbCrLf + "  CREATE TABLE TEMPTABLEDB..TEMPACHEAD (ACCODE VARCHAR(7)) "
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMPACHEAD (ACCODE) SELECT ACCODE FROM ACHEAD  WHERE LOCALOUTST IN('L','O') UNION ALL SELECT ''             "

        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM SOFTCONTROL WHERE CTLID='DEFAULTTINNO')<=0"
        strSql += vbCrLf + "  INSERT INTO SOFTCONTROL(CTLID,CTLTEXT,CTLNAME,CTLMODULE,CTLTYPE)"
        strSql += vbCrLf + "  SELECT 'DEFAULTTINNO','33960000000','DEFAULT TINNO FOR ANNUXTURE I AND II','A','T'"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMPANNEXTUREI', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPANNEXTUREI    "
        strSql += vbCrLf + "  SELECT @QUERY = 'SELECT AC.ACNAME  AS SELLERNAME,CONVERT(VARCHAR(40),CASE WHEN ISNULL(AC.TIN,'''')='''' THEN (SELECT CTLTEXT FROM SOFTCONTROL WHERE CTLID=''DEFAULTTINNO'') ELSE AC.TIN END) AS SELLERTINNO,CONVERT(VARCHAR(40),ISNULL(CT.COMMODITY,'''')) AS COMMODITYCODE '   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' ,CONVERT(VARCHAR(2),CASE WHEN AC.LOCALOUTST=''L'' THEN ''R'' ELSE ''O'' END) AS CATEGORYCODE,'     "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' CONVERT(VARCHAR(13),REFNO) AS INVNO,CONVERT(VARCHAR(13),REFDATE,105) AS INVDATE,CT.SALESTAX,SUM(ISNULL(T.AMOUNT,0)) AS INVVALUE,SUM(CASE AC.LOCALOUTST WHEN ''O'' THEN 0 ELSE ISNULL(T.TAX,0) END) AS TAX'  "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ',1 RESULT INTO TEMPTABLEDB..TEMPANNEXTUREI FROM ' + @DBNAME+ '..RECEIPT AS T LEFT JOIN ACHEAD AS AC ON AC.ACCODE = T.ACCODE LEFT JOIN CATEGORY AS CT ON CT.CATCODE = T.CATCODE'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' WHERE T.CANCEL <> ''Y'' AND ISNULL(T.ACCODE,'''') <> '''' '+ @COMPFILTER +' '+@COSTFILTER     "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.TRANDATE BETWEEN '''+@FROMDATE+''' AND  '''+@TODATE+''''          "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.TRANTYPE IN (''RPU'')'           "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)'             "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' GROUP BY AC.ACNAME  ,AC.TIN ,CT.COMMODITY,AC.LOCALOUTST, REFNO ,REFDATE ,CT.SALESTAX,CT.CATNAME'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' HAVING (SUM(ISNULL(T.AMOUNT,0))<>0 OR SUM(CASE AC.LOCALOUTST WHEN ''O'' THEN 0 ELSE ISNULL(T.TAX,0) END)<>0)'    "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' UNION ALL '   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' SELECT ''CONSUMERS''  AS SELLERNAME,(SELECT CTLTEXT FROM SOFTCONTROL WHERE CTLID=''DEFAULTTINNO'') AS SELLERTINNO,ISNULL(CT.COMMODITY,'''') AS COMMODITYCODE'   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' ,''R'' AS CATEGORYCODE,'     "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+' ''0'' INVNO,'''' AS INVDATE,0 SALESTAX,SUM(ISNULL(T.AMOUNT,0)) AS INVVALUE, SUM(ISNULL(T.AMOUNT,0)*0.01) AS TAX'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' ,1 RELULT FROM ' + @DBNAME+ '..RECEIPT AS T LEFT JOIN CATEGORY AS CT ON CT.CATCODE = T.CATCODE'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' WHERE T.CANCEL <> ''Y'' '+ @COMPFILTER  +' '+@COSTFILTER     "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.TRANDATE BETWEEN '''+@FROMDATE+''' AND  '''+@TODATE+''''          "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.TRANTYPE IN (''PU'')'           "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.CATCODE IN(SELECT CATCODE FROM CATEGORY WHERE ISNULL(COMMODITY,'''')=104)' "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' AND T.ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD)'             "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY +CHAR(13)+ ' GROUP BY CT.COMMODITY '       "
        strSql += vbCrLf + "  /**SELECT @QUERY = @QUERY + CHAR(13)+' UNION ALL '   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' SELECT ACNAME AS [SELLER NAME],TIN AS [SELLER TIN NO.],'''' AS [COMMODITY CODE]'   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' ,''R'' AS [CATEGORY CODE],'     "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' INVNO,INVDATE,0 SALESTAX,SUM(ISNULL(AMOUNT,0)) AS INVVALUE, SUM(ISNULL(TAX,0)) AS TAX  FROM ('       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+ ' SELECT AC.ACNAME,AC.TIN,CONVERT(VARCHAR(13),REFNO) AS INVNO,REFDATE AS INVDATE, '      "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AMOUNT,0.00 TAX '      "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' FROM ' + @DBNAME+ '..ACCTRAN AS T LEFT JOIN ACHEAD AS AC ON AC.ACCODE = T.ACCODE'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' WHERE T.CANCEL <> ''Y'' '+ @COMPFILTER       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.TRANDATE BETWEEN '''+@FROMDATE+''' AND  '''+@TODATE+''''          "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.TRANMODE IN (''D'')'           "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN(''127''))'             "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' UNION ALL '   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' SELECT AC.ACNAME,AC.TIN,CONVERT(VARCHAR(13),REFNO) AS INVNO,REFDATE AS INVDATE, '      "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' 0.00 AMOUNT,AMOUNT TAX '      "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' FROM ' + @DBNAME+ '..ACCTRAN AS T LEFT JOIN ACHEAD AS AC ON AC.ACCODE = T.ACCODE'       "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' WHERE T.CANCEL <> ''Y'' '+ @COMPFILTER            "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.TRANDATE BETWEEN '''+@FROMDATE+''' AND  '''+@TODATE+''''          "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.TRANMODE IN (''D'')'           "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' AND T.ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN(''128''))'   "
        strSql += vbCrLf + "  SELECT @QUERY = @QUERY + CHAR(13)+' )X GROUP BY ACNAME,TIN,INVNO,INVDATE '**/"
        strSql += vbCrLf + "  PRINT @QUERY  "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY       "

        strSql += vbCrLf + "  SELECT @QUERY='IF(SELECT COUNT(*) FROM TEMPTABLEDB..TEMPANNEXTUREI)>0 '"
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'INSERT INTO TEMPTABLEDB..TEMPANNEXTUREI(SELLERNAME,INVVALUE,TAX,RESULT)'    "
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+'SELECT ''TOTAL'',SUM(INVVALUE),SUM(TAX),2 FROM TEMPTABLEDB..TEMPANNEXTUREI WHERE RESULT=1'    "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY       "
        strSql += vbCrLf + "  SELECT @QUERY=' SELECT * FROM TEMPTABLEDB..TEMPANNEXTUREI ORDER BY RESULT'    "
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY       "
        strSql += vbCrLf + "  END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
