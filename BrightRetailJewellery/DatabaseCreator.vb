        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,SUM(AMOUNT) AS AMOUNT'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'' AND TRANTYPE =I.TRANTYPE AND ISSSNO=I.SNO)AS CTAX'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'' AND TRANTYPE =I.TRANTYPE AND ISSSNO=I.SNO)AS STAX'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'' AND TRANTYPE =I.TRANTYPE AND ISSSNO=I.SNO)AS ITAX'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,SUM(TAX)+SUM(AMOUNT) AS GNETAMOUNT'						"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'' AND TRANTYPE =''RC'' AND ISSSNO=I.SNO)AS CRCMTAX'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'' AND TRANTYPE =''RC'' AND ISSSNO=I.SNO)AS SRCMTAX'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'' AND TRANTYPE =''RC'' AND ISSSNO=I.SNO)AS IRCMTAX'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,SUM(AMOUNT) AS RNETAMOUNT'				"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 DOORNO FROM ACHEAD WHERE ACCODE=I.ACCODE) AS DOORNO'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 ADDRESS1 FROM ACHEAD WHERE ACCODE=I.ACCODE) AS ADDRESS1'	"
