        strSql += vbCrLf + "          SET @QUERY='IF EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME ='+''''+@TEMPTAB+''''+')'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+'DROP TABLE '+ @TEMPTABLE"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "          SELECT @QUERY='CREATE TABLE '+ @TEMPTABLE +'(PARTICULAR VARCHAR(100),ITEMID INT,SUBITEMID INT,DEALERNAME VARCHAR(100),TAGNO VARCHAR(20), PCS INT,AMOUNT NUMERIC(12,2)'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' , GRSWT NUMERIC(12,2), NETWT NUMERIC(12,2),ORDERSTATE_NAME VARCHAR(100),ORDNO INT)'"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "          SELECT @QUERY=' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,ORDERSTATE_NAME, ITEMID ,SUBITEMID ,DEALERNAME,TAGNO, PCS ,AMOUNT , GRSWT , NETWT ,ORDNO)'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SELECT ''       ''+ CASE WHEN ISNULL(IM.ITEMNAME,'''') <> '''' THEN IM.ITEMNAME ELSE C.CATNAME END AS PARTICULAR, O.ORDSTATE_NAME, I.ITEMID,I.SUBITEMID,'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' CASE WHEN ISNULL(I.ACCODE,'''')<>'''' THEN AC.ACNAME ELSE P.PNAME END,I.TAGNO,'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SUM(I.PCS) AS PIECES,SUM(I.AMOUNT) AS AMOUNT ,SUM(I.GRSWT) AS GRSWT, SUM(I.NETWT) AS NETWT ,1 ORDNO'"
