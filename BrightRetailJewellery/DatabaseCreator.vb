        strSql += vbCrLf + "   SELECT @QUERY=@QUERY+'SELECT ACCODE,CATCODE,SUM(ISNULL(GRSWT,0))*(-1),SUM(ISNULL(NETWT,0))*(-1), SUM(ISNULL(PUREWT,0)) *(-1)FROM '+@DBNAME+'..ISSUE'"
