        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''CC'') AS CARD'    "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''CH'') AS CHEQUE'    "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''AA'') AS ADVADJ'    "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''DU'') AS CREDIT'    "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'  ,IDENTITY(INT,1,1)SNO INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'  FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS I '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,VOUCHERTYPE DESC'    "
        strSql += vbCrLf + "	PRINT (@QRY)     "
        strSql += vbCrLf + "	EXEC (@QRY)     "
        strSql += vbCrLf + "	SELECT @QRY=CHAR(13)+' DECLARE @BATCHNO VARCHAR(15)'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' DECLARE @SNO INT'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' DECLARE @PBATCHNO VARCHAR(15)'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' DECLARE @QRY1 VARCHAR(500)'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' SET @PBATCHNO='''''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' DECLARE CUR CURSOR FOR'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' SELECT BATCHNO,SNO FROM  TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL ORDER BY BATCHNO,SNO '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' OPEN CUR'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' FETCH NEXT FROM CUR INTO @BATCHNO,@SNO'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' WHILE @@FETCH_STATUS<>-1'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' BEGIN'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'		IF @PBATCHNO<>@BATCHNO '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SET @PBATCHNO=@BATCHNO   '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'		ELSE'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'		BEGIN'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SELECT @QRY1=CHAR(13)+'' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL'''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SELECT @QRY1=@QRY1+CHAR(13)+'' SET CASH=NULL'''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SELECT @QRY1=@QRY1+CHAR(13)+'' ,CARD=NULL,CREDIT=NULL'''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SELECT @QRY1=@QRY1+CHAR(13)+'' ,CHEQUE=NULL,ADVADJ=NULL'''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			SELECT @QRY1=@QRY1+CHAR(13)+'' WHERE SNO=''+CAST(@SNO AS VARCHAR)+'''''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			PRINT (@QRY1)  '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'			EXEC (@QRY1)  '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'		END'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+'		FETCH NEXT FROM CUR INTO @BATCHNO,@SNO'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' END'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' CLOSE CUR'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' DEALLOCATE CUR'    "
        strSql += vbCrLf + "	EXEC (@QRY)    "
        strSql += vbCrLf + "	SELECT @QRY=CHAR(13)+' UPDATE TT SET METALTYPE=''DIAMOND'''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL TT,ISSSTONE ISS WHERE ISS.BATCHNO=TT.BATCHNO'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' AND ISS.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' AND ISS.STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'')'  "
        strSql += vbCrLf + "	EXEC (@QRY)    "
        strSql += vbCrLf + "	IF @BILLSUM = 'N'  "
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QRY=' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL SET PRODUCTNAME=''ORDER ITEM'' WHERE ISNULL(PRODUCTNAME,'''')='''' '  "
        strSql += vbCrLf + "		EXEC (@QRY)    "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	SELECT @QRY='SELECT * '  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL(CASH,0)+ISNULL(CARD,0)+ISNULL(CHEQUE,0)+ISNULL(ADVADJ,0)+ISNULL(CREDIT,0) AS BAL_AMT'  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL WHERE 1=1'  "
        strSql += vbCrLf + "	IF @METALNAME<>'ALL'  "
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' AND METALTYPE='''+@METALNAME+''''  "
        strSql += vbCrLf + "	IF @TYPE<>'ALL'  "
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+' AND VOUCHERTYPE='''+@TYPE+''''  "
        strSql += vbCrLf + "	SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,VOUCHERTYPE DESC'    "
        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY) "
        strSql += vbCrLf + "END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSp_SalesAbstract()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ABSTRACT_NEW')>0"
