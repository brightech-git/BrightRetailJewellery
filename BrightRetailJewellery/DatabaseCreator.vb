    End Sub
    Private Sub Sp_RPT_TRIALBALANCE_NEW()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TRIALBALANCE_NEW')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TRIALBALANCE_NEW"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_TRIALBALANCE_NEW   "
        strSql += vbCrLf + "      (    "
        strSql += vbCrLf + "      @FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + "      ,@TODATE SMALLDATETIME    "
        strSql += vbCrLf + "      ,@COSTNAME VARCHAR(8000)    "
        strSql += vbCrLf + "      ,@GROUPBY VARCHAR(1) /** (G)GROUP/(N)AME **/    "
        strSql += vbCrLf + "      ,@RPT_TYPE VARCHAR(1) /**(D)ETAILD/(S)UMMARY**/    "
        strSql += vbCrLf + "      ,@WITHOPENING VARCHAR(1) /** (Y)ES/(N)O **/    "
        strSql += vbCrLf + "      ,@COMPANYID VARCHAR(3)    "
        strSql += vbCrLf + "      ,@DISPCOL VARCHAR(3) /** (O)PENING(T)RANS**/"
        strSql += vbCrLf + "      )    "
        strSql += vbCrLf + "      AS    "
        strSql += vbCrLf + "      SET NOCOUNT ON    "
        strSql += vbCrLf + "      DECLARE @MAXLEN INT    "
        strSql += vbCrLf + "      DECLARE @QRY VARCHAR(4000)    "
        strSql += vbCrLf + "      IF @GROUPBY = 'N' SET @RPT_TYPE = 'D'    "
        strSql += vbCrLf + "      SET @MAXLEN = 0    "
        strSql += vbCrLf + "      EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME    "
        strSql += vbCrLf + "      SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '    "
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'     "
        strSql += vbCrLf + "      EXEC (@QRY)    "
        strSql += vbCrLf + "      /** GETTING TRANSACTION **/    "
        strSql += vbCrLf + "      IF OBJECT_ID('TEMPTABLEDB..TRAILBAL_A') IS NOT NULL DROP TABLE TEMPTABLEDB..TRAILBAL_A    "
        strSql += vbCrLf + "      SELECT     "
        strSql += vbCrLf + "      X.SEP,X.ACCODE,X.AMOUNT    "
        strSql += vbCrLf + "      ,H.ACNAME,CONVERT(VARCHAR(100),G.ACGRPNAME)ACGRPNAME,CONVERT(VARCHAR(30),G.ACMAINSUB)MAINGRPNAME,G.DISPORDER,CONVERT(VARCHAR(100),CASE WHEN G.SCHEDULECODE = '0' THEN '' ELSE ISNULL(G.SCHEDULECODE,'') END) AS SCHEDULECODE    "
        strSql += vbCrLf + "      ,CONVERT(VARCHAR(100),G.ACGRPNAME) TEMPACGRPNAME    "
        strSql += vbCrLf + "      INTO TEMPTABLEDB..TRAILBAL_A    "
        strSql += vbCrLf + "      FROM    "
        strSql += vbCrLf + "      (    "
        strSql += vbCrLf + "      SELECT T.TRANMODE AS SEP,T.ACCODE,T.AMOUNT    "
        strSql += vbCrLf + "      FROM " & tranDbName & "..ACCTRAN AS T    "
        strSql += vbCrLf + "      WHERE T.TRANDATE BETWEEN @FROMDATE AND @TODATE AND COMPANYID = @COMPANYID    "
        strSql += vbCrLf + "      AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + "      AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        strSql += vbCrLf + "      )X    "
        strSql += vbCrLf + "      INNER JOIN " & compId & "ADMINDB..ACHEAD AS H ON H.ACCODE = X.ACCODE    "
        strSql += vbCrLf + "      INNER JOIN " & compId & "ADMINDB..ACGROUP AS G ON G.ACGRPCODE = H.ACGRPCODE  "
        strSql += vbCrLf + "      IF @WITHOPENING = 'Y'    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "      /** GETTING OPENING **/    "
        strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..TRAILBAL_A    "
        strSql += vbCrLf + "      SELECT     "
        strSql += vbCrLf + "      X.SEP,X.ACCODE,X.AMOUNT    "
        strSql += vbCrLf + "      ,H.ACNAME,G.ACGRPNAME,CONVERT(VARCHAR(40),G.ACMAINSUB) ,G.DISPORDER,CONVERT(VARCHAR,CASE WHEN G.SCHEDULECODE = '0' THEN '' ELSE ISNULL(G.SCHEDULECODE,'') END) AS SCHEDULECODE,G.ACGRPNAME TEMPACGRPNAME    "
        strSql += vbCrLf + "      FROM    "
        strSql += vbCrLf + "      (    "
        strSql += vbCrLf + "      SELECT 'O'SEP,ACCODE,CONVERT(NUMERIC(15,2),DEBIT-CREDIT) AS AMOUNT    "
        strSql += vbCrLf + "      FROM " & tranDbName & "..OPENTRAILBALANCE    "
        strSql += vbCrLf + "      WHERE COMPANYID = @COMPANYID   "
        strSql += vbCrLf + "      AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        strSql += vbCrLf + "      UNION ALL    "
        strSql += vbCrLf + "      SELECT 'O'SEP,ACCODE,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT    "
        strSql += vbCrLf + "      FROM " & tranDbName & "..ACCTRAN AS T    "
        strSql += vbCrLf + "      WHERE T.TRANDATE < @FROMDATE AND COMPANYID = @COMPANYID    "
        strSql += vbCrLf + "      AND ISNULL(CANCEL,'') = ''   "
        strSql += vbCrLf + "      AND ISNULL(COSTID,'') IN (select costid from tempcostcentre)  "
        strSql += vbCrLf + "      )X    "
        strSql += vbCrLf + "      INNER JOIN " & compId & "ADMINDB..ACHEAD AS H ON H.ACCODE = X.ACCODE    "
        strSql += vbCrLf + "      INNER JOIN " & compId & "ADMINDB..ACGROUP AS G ON G.ACGRPCODE = H.ACGRPCODE "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      IF (SELECT MAX(LEN(SCHEDULECODE)) FROM TEMPTABLEDB..TRAILBAL_A )>0    "
        strSql += vbCrLf + "      BEGIN    "
        strSql += vbCrLf + "      SET @MAXLEN = 4    "
        strSql += vbCrLf + "      UPDATE TEMPTABLEDB..TRAILBAL_A SET SCHEDULECODE = '...' WHERE SCHEDULECODE = ''    "
        strSql += vbCrLf + "      UPDATE TEMPTABLEDB..TRAILBAL_A SET ACGRPNAME = SCHEDULECODE + REPLICATE(' ',@MAXLEN-LEN(SCHEDULECODE)) + ACGRPNAME    "
        strSql += vbCrLf + "      UPDATE TEMPTABLEDB..TRAILBAL_A SET MAINGRPNAME = SCHEDULECODE + REPLICATE(' ',@MAXLEN-LEN(SCHEDULECODE)) + MAINGRPNAME "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "      IF @RPT_TYPE = 'S'    "
        strSql += vbCrLf + "      UPDATE TEMPTABLEDB..TRAILBAL_A SET ACNAME = NULL    "
        strSql += vbCrLf + "      IF OBJECT_ID('TEMPTABLEDB..TRAILBAL_B') IS NOT NULL DROP TABLE TEMPTABLEDB..TRAILBAL_B    "
        strSql += vbCrLf + "      SELECT     "
        strSql += vbCrLf + "      PARTICULAR    "
        strSql += vbCrLf + "      ,CASE WHEN OPENING > 0 THEN OPENING ELSE 0 END AS ODEBIT    "
        strSql += vbCrLf + "      ,CASE WHEN OPENING < 0 THEN -1*OPENING ELSE 0 END AS OCREDIT    "
        strSql += vbCrLf + "      ,DEBIT AS TDEBIT    "
        strSql += vbCrLf + "      ,CREDIT AS TCREDIT    "
        strSql += vbCrLf + "      ,CASE WHEN CLOSING > 0 THEN CLOSING ELSE 0 END AS CDEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN CLOSING < 0 THEN -1*CLOSING ELSE 0 END AS CCREDIT    "
        strSql += vbCrLf + "      ,RESULT,COLHEAD,ACNAME,ACGRPNAME,MAINGRPNAME,DISPORDER,SCHEDULECODE,TEMPACGRPNAME    "
        strSql += vbCrLf + "      INTO TEMPTABLEDB..TRAILBAL_B    "
        strSql += vbCrLf + "      FROM    "
        strSql += vbCrLf + "      (    "
        strSql += vbCrLf + "      SELECT    "
        strSql += vbCrLf + "      CONVERT(VARCHAR(500),CASE WHEN @RPT_TYPE = 'D' THEN REPLICATE(' ',@MAXLEN) + '    '+ ACNAME ELSE ACGRPNAME END)AS PARTICULAR    "
        strSql += vbCrLf + "      ,SUM(CASE WHEN SEP = 'O' THEN AMOUNT ELSE 0 END) AS OPENING    "
        strSql += vbCrLf + "      ,SUM(CASE WHEN SEP = 'D' THEN AMOUNT ELSE 0 END) AS DEBIT    "
        strSql += vbCrLf + "      ,SUM(CASE WHEN SEP = 'C' THEN AMOUNT ELSE 0 END) AS CREDIT    "
        strSql += vbCrLf + "      ,SUM(CASE WHEN SEP = 'C' THEN -1*AMOUNT ELSE AMOUNT END) AS CLOSING    "
        strSql += vbCrLf + "      ,CONVERT(INT,2)RESULT    "
        strSql += vbCrLf + "      ,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + "      ,ACNAME,ACGRPNAME,MAINGRPNAME,DISPORDER,SCHEDULECODE,TEMPACGRPNAME    "
        strSql += vbCrLf + "      FROM TEMPTABLEDB..TRAILBAL_A    "
        strSql += vbCrLf + "      GROUP BY ACNAME,ACGRPNAME,MAINGRPNAME,DISPORDER,SCHEDULECODE,TEMPACGRPNAME    "
        strSql += vbCrLf + "      )X    "
        strSql += vbCrLf + "      IF @DISPCOL <> 'Z' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "       DELETE FROM TEMPTABLEDB..TRAILBAL_B WHERE ODEBIT = 0 AND OCREDIT = 0 AND TDEBIT = 0 AND TCREDIT = 0 AND CDEBIT = 0 AND CCREDIT = 0    "
        strSql += vbCrLf + "      END    "
        strSql += vbCrLf + "         IF (SELECT COUNT(*) FROM TEMPTABLEDB..TRAILBAL_B)>0    "
        strSql += vbCrLf + "        BEGIN    "
        strSql += vbCrLf + "        IF @RPT_TYPE = 'D' AND @GROUPBY = 'G'    "
        strSql += vbCrLf + "        BEGIN    "
        strSql += vbCrLf + "        /** INSERT INTO TITLE **/    "
        strSql += vbCrLf + "        INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,RESULT,DISPORDER,COLHEAD)    "
        strSql += vbCrLf + "        SELECT DISTINCT '   ' + ACGRPNAME,ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,1 RESULT,DISPORDER,'G' COLHEAD FROM TEMPTABLEDB..TRAILBAL_B  WHERE RESULT = 2    "
        strSql += vbCrLf + "          /** INSERT INTO MAIN TITLE **/    "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,MAINGRPNAME,RESULT,DISPORDER,COLHEAD)    "
        strSql += vbCrLf + "       SELECT DISTINCT ACGRPNAME,ACMAINCODE ,0 RESULT,DISPORDER,'T' COLHEAD FROM " & compId & "ADMINDB..ACGROUP WHERE ACMAINSUB=1"
        strSql += vbCrLf + "       /** INSERT INTO SUBTOTAL_1 **/    "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    "
        strSql += vbCrLf + "       SELECT '    SUB TOTAL',ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,3 RESULT,DISPORDER,'S1' COLHEAD,SUM(ODEBIT),SUM(OCREDIT),SUM(TDEBIT),SUM(TCREDIT),SUM(CDEBIT),SUM(CCREDIT) FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT = 1 GROUP BY ACGRPNAME,MAINGRPNAME,DISPORDER,TEMPACGRPNAME    "
        strSql += vbCrLf + "       /** INSERT INTO SUBTOTAL_2 **/    "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    "
        strSql += vbCrLf + "       SELECT '    TOTAL',ACGRPNAME,MAINGRPNAME,TEMPACGRPNAME,4 RESULT,DISPORDER,'S' COLHEAD    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) > 0 THEN SUM(ODEBIT)-SUM(OCREDIT) ELSE 0 END AS ODEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) < 0 THEN SUM(OCREDIT)-SUM(ODEBIT) ELSE 0 END AS OCREDIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) > 0 THEN SUM(TDEBIT)-SUM(TCREDIT) ELSE 0 END AS TDEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) < 0 THEN SUM(TCREDIT)-SUM(TDEBIT) ELSE 0 END AS TCREDIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) > 0 THEN SUM(CDEBIT)-SUM(CCREDIT) ELSE 0 END AS CDEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) < 0 THEN SUM(CCREDIT)-SUM(CDEBIT) ELSE 0 END AS CCREDIT    "
        strSql += vbCrLf + "       FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT = 1 GROUP BY ACGRPNAME,MAINGRPNAME,DISPORDER,TEMPACGRPNAME    "
        strSql += vbCrLf + "       END    "
        strSql += vbCrLf + "       /** INSERT INTO GRANDTOTTAL_1 **/    "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,ACGRPNAME,MAINGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    "
        strSql += vbCrLf + "       SELECT 'GRAND TOTAL','ZZZZZ',1,5 RESULT,9999 DISPORDER,'G' COLHEAD,SUM(ODEBIT),SUM(OCREDIT),SUM(TDEBIT),SUM(TCREDIT),SUM(CDEBIT),SUM(CCREDIT) FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT = 2    "
        strSql += vbCrLf + "       /** INSERT INTO GRANDTOTAL_2 **/    "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TRAILBAL_B(PARTICULAR,ACGRPNAME,MAINGRPNAME,RESULT,DISPORDER,COLHEAD,ODEBIT,OCREDIT,TDEBIT,TCREDIT,CDEBIT,CCREDIT)    "
        strSql += vbCrLf + "       SELECT 'GRAND DIFF','ZZZZZZZ',1,6 RESULT,99999 DISPORDER,'G' COLHEAD    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) > 0 THEN SUM(ODEBIT)-SUM(OCREDIT) ELSE 0 END AS ODEBIT    "
        strSql += vbCrLf + "        ,CASE WHEN SUM(ODEBIT)-SUM(OCREDIT) < 0 THEN SUM(OCREDIT)-SUM(ODEBIT) ELSE 0 END AS OCREDIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) > 0 THEN SUM(TDEBIT)-SUM(TCREDIT) ELSE 0 END AS TDEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(TDEBIT)-SUM(TCREDIT) < 0 THEN SUM(TCREDIT)-SUM(TDEBIT) ELSE 0 END AS TCREDIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) > 0 THEN SUM(CDEBIT)-SUM(CCREDIT) ELSE 0 END AS CDEBIT    "
        strSql += vbCrLf + "       ,CASE WHEN SUM(CDEBIT)-SUM(CCREDIT) < 0 THEN SUM(CCREDIT)-SUM(CDEBIT) ELSE 0 END AS CCREDIT    "
        strSql += vbCrLf + "       FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT = 2     "
        strSql += vbCrLf + "       END    "
        strSql += vbCrLf + "       UPDATE TEMPTABLEDB..TRAILBAL_B SET    "
        strSql += vbCrLf + "       ODEBIT = CASE WHEN ODEBIT = 0 THEN NULL ELSE ODEBIT END    "
        strSql += vbCrLf + "       ,OCREDIT = CASE WHEN OCREDIT = 0 THEN NULL ELSE OCREDIT END    "
        strSql += vbCrLf + "       ,TDEBIT = CASE WHEN TDEBIT = 0 THEN NULL ELSE TDEBIT END    "
        strSql += vbCrLf + "       ,TCREDIT = CASE WHEN TCREDIT = 0 THEN NULL ELSE TCREDIT END    "
        strSql += vbCrLf + "       ,CDEBIT = CASE WHEN CDEBIT = 0 THEN NULL ELSE CDEBIT END    "
        strSql += vbCrLf + "       ,CCREDIT = CASE WHEN CCREDIT = 0 THEN NULL ELSE CCREDIT END    "
        strSql += vbCrLf + "      SET @QRY = ' SELECT * FROM TEMPTABLEDB..TRAILBAL_B WHERE 1=1  '"
        strSql += vbCrLf + "      IF @DISPCOL <> 'Z' "
        strSql += vbCrLf + "      BEGIN"
        strSql += vbCrLf + "      SET @QRY = @QRY + '  AND NOT('"
        strSql += vbCrLf + "      IF CHARINDEX('O',@DISPCOL) <> 0"
        strSql += vbCrLf + "      BEGIN"
