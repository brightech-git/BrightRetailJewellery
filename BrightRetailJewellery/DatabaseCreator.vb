        strSql += vbCrLf + "       SELECT @QRY = @QRY +'WHERE RUNNO IN (SELECT RUNNO FROM  OUTSTANDING O WHERE EXISTS (SELECT 1 FROM ITEMDETAIL WHERE BATCHNO = O.BATCHNO AND RUNNO=O.RUNNO))'  "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +'UPDATE A SET TRANTYPE = ''O'',REMARK=(SELECT ITEMNAME FROM  ITEMMAST WHERE ITEMID IN (SELECT TOP 1 ITEMID FROM  ORMAST WHERE BATCHNO=A.BATCHNO)) FROM TEMPTABLEDB..TEMP_OUTSTANDING A WHERE SUBSTRING(RUNNO,6,1) = ''O'''     "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +'UPDATE A SET REMARK=(SELECT ITEMNAME FROM  ITEMMAST WHERE ITEMID IN (SELECT TOP 1 ITEMID FROM '+@DBNAME+'..ISSUE WHERE BATCHNO=A.BATCHNO)) FROM TEMPTABLEDB..TEMP_OUTSTANDING A WHERE SUBSTRING(RUNNO,6,1) = ''D'''       "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +'DELETE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE TRANTYPE NOT IN (SELECT TYPEID FROM TEMPTABLEDB..TEMP_OUT_TYPE)'       "
