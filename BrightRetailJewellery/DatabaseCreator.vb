    Private Sub funcTransferTrandb_Admindb_CustomerInfo()
        funcProgressStep(0)
        STATUS = "Transfering Table CustomerInfo"
        strSql = "IF OBJECT_ID('" & compId & "ADMINDB..CUSTOMERINFO','U') IS NOT NULL DROP TABLE " & compId & "ADMINDB..CUSTOMERINFO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "IF OBJECT_ID('" & tranDbName & "..CUSTOMERINFO','U') IS NOT NULL SELECT * INTO " & compId & "ADMINDB..CUSTOMERINFO FROM " & tranDbName & "..CUSTOMERINFO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        funcProgressStep(1)

        STATUS = "Dropping Table CustomerInfo"
        strSql = "IF OBJECT_ID('" & tranDbName & "..CUSTOMERINFO','U') IS NOT NULL DROP TABLE  " & tranDbName & "..CUSTOMERINFO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        funcProgressStep(1)

        Dim dtCus As New DataTable
        Dim LastDbName As String
        strSql = "SELECT DBNAME FROM " & compId & "ADMINDB..DBMASTER WHERE DBNAME <>'" & tranDbName & "'ORDER BY ENDDATE DESC"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dtCus)
        If dtCus.Rows.Count > 0 Then
            For J As Integer = 0 To dtCus.Rows.Count - 1
                LastDbName = dtCus.Rows(J).Item("DBNAME").ToString
                strSql = "SELECT NAME FROM MASTER..SYSDATABASES WHERE NAME='" & LastDbName & "'"
                If GetSqlValue(strSql, "", tran) <> "" Then
                    strSql = "DECLARE @QRY VARCHAR(8000)"
                    strSql += vbCrLf + "DECLARE @CNAMES VARCHAR(8000)"
                    strSql += vbCrLf + "DECLARE @CNAME VARCHAR(50)"
                    strSql += vbCrLf + "SELECT @CNAMES = ''"
                    strSql += vbCrLf + "DECLARE CUR CURSOR"
                    strSql += vbCrLf + "FOR SELECT NAME FROM " & LastDbName & "..SYSCOLUMNS WHERE ID = (SELECT ID FROM " & LastDbName & "..SYSOBJECTS WHERE NAME = 'CUSTOMERINFO')"
                    strSql += vbCrLf + "OPEN CUR"
                    strSql += vbCrLf + "WHILE 1 = 1"
                    strSql += vbCrLf + "BEGIN"
                    strSql += vbCrLf + "FETCH NEXT FROM CUR INTO @CNAME"
                    strSql += vbCrLf + "IF @@FETCH_STATUS = -1 BREAK"
                    strSql += vbCrLf + "SELECT @CNAMES = @CNAMES + @CNAME + ','"
                    strSql += vbCrLf + "END"
                    strSql += vbCrLf + "SELECT @CNAMES =  SUBSTRING(@CNAMES,1,LEN(@CNAMES)-1)"
                    strSql += vbCrLf + "CLOSE CUR"
                    strSql += vbCrLf + "DEALLOCATE CUR"
                    strSql += vbCrLf + "SELECT @QRY = 'INSERT INTO " & compId & "ADMINDB..CUSTOMERINFO (' + @CNAMES + ') SELECT ' + @CNAMES + ' FROM " & LastDbName & "..CUSTOMERINFO "
                    strSql += vbCrLf + "WHERE BATCHNO NOT IN(SELECT BATCHNO FROM " & compId & "ADMINDB..CUSTOMERINFO) ' "
                    strSql += vbCrLf + "EXEC (@QRY)"
                    cmd = New OleDbCommand(strSql, cn, tran)
                    cmd.ExecuteNonQuery()
                End If
            Next
        End If

        strSql = "UPDATE " & compId & "ADMINDB..SOFTCONTROL SET CTLTEXT='Y' WHERE CTLID='TRANDB_ADMINDB_CUSINFO'"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SoftControlLoad()
        strSql = " SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'COSTID'"
        cnCostId = GetSqlValue(strSql, "", tran)

        strSql = " SELECT COSTID FROM " & compId & "ADMINDB..SYNCCOSTCENTRE WHERE MAIN = 'Y'"
        cnHOCostId = GetSqlValue(strSql, "", tran)

        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'PRETYPE'"
        PRETYPE = IIf(GetSqlValue(strSql, "Y", tran) = "Y", True, False)

        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'AREA_RESTRICT'"
