        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,SNO VARCHAR(20),STONE VARCHAR(20),STNRATE DECIMAL(15,2),DIAPCS INT,DIAWT DECIMAL(15,3),RECISS VARCHAR(20))'  "
