        strSql += vbCrLf + "          END "
        strSql += vbCrLf + "          IF @ACNAME  <> 'ALL' "
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		  SET @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMPACHEAD'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD'+@SYSID+''    "
        strSql += vbCrLf + "  		  PRINT @QRY"
        strSql += vbCrLf + "  		  EXEC (@QRY)"
        strSql += vbCrLf + "  		  SET @QRY = 'SELECT ACCODE INTO TEMPTABLEDB..TEMPACHEAD'+@SYSID+' FROM ACHEAD WHERE ACNAME = ''' +@ACNAME +''''"
        strSql += vbCrLf + "  		  PRINT @QRY"
        strSql += vbCrLf + "  		  EXEC (@QRY)"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE IF @ACNAME  = 'ALL' OR @ACNAME = ''"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		  SET @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMPACHEAD'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD'+@SYSID+''  "
        strSql += vbCrLf + "  		  PRINT @QRY "
        strSql += vbCrLf + "  		  EXEC (@QRY)"
        strSql += vbCrLf + "  		  SET @QRY = 'SELECT ACCODE INTO TEMPTABLEDB..TEMPACHEAD'+@SYSID+' FROM ACHEAD '"
        strSql += vbCrLf + "  		  IF (@ACGROUP<>'ALL' AND @ACGROUP <>'')  "
        strSql += vbCrLf + "  			BEGIN  "
        strSql += vbCrLf + "  				SELECT @QRY= @QRY + CHAR(13) + ' WHERE ACCODE IN '"
        strSql += vbCrLf + "  				SELECT @QRY= @QRY +  CHAR(13) + '  (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM ACGROUP '"
        strSql += vbCrLf + "  				SELECT @QRY= @QRY + CHAR(13) + '  WHERE ACGRPNAME IN( SELECT COMPANYID FROM TEMPACGROUP)))'"
        strSql += vbCrLf + "  			END				"
        strSql += vbCrLf + "  		  PRINT @QRY"
        strSql += vbCrLf + "  		  EXEC (@QRY)"
        strSql += vbCrLf + "  		END "
        strSql += vbCrLf + "          SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..TEMP_CROUTSTANDING'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_CROUTSTANDING'+@SYSID+''  "
        strSql += vbCrLf + "          PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..TEMP_OUT_COSTCENTRE'+@SYSID+''', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE'+@SYSID+''  "
        strSql += vbCrLf + "          PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SET @QRY='CREATE TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE'+@SYSID+'(COSTID VARCHAR(3))'  "
