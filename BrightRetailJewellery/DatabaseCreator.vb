        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' LEFT OUTER JOIN '+@CNADMINDB+'..SUBITEMMAST SM ON SM.ITEMID=O.ITEMID AND SM.SUBITEMID=O.SUBITEMID'"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' LEFT OUTER JOIN '+@CNADMINDB+'..STKREORDER SR ON SR.ITEMID=O.ITEMID AND SR.SUBITEMID=O.SUBITEMID AND SR.FROMDAY IS NULL'"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' LEFT OUTER JOIN '+@CNADMINDB+'..SUBITEMGROUP SG ON SG.SGROUPID=SM.SGROUPID'"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' WHERE ORDATE <= '''+@ASONDATE+''' '"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(ORDCANCEL,'''')<> ''Y'' AND ORMODE=''O'''"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(O.COMPANYID,'''') = '''+@COMPANYID+''' '     "
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' AND O.ITEMID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPITEMMAST) '"
        strSql += vbCrLf + "      	SELECT @QRY = @QRY +CHAR(13)+' AND O.SUBITEMID IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPSUBITEMMAST) '"
        strSql += vbCrLf + "      	IF @ISSUBGROUPWISE='Y'"
        strSql += vbCrLf + "      	BEGIN"
        strSql += vbCrLf + "      		SELECT @QRY = @QRY +CHAR(13)+' AND O.SUBITEMID IN (SELECT SUBITEMID FROM '+@CNADMINDB+'..SUBITEMMAST '"
        strSql += vbCrLf + "      		SELECT @QRY = @QRY +CHAR(13)+' WHERE SGROUPID=(SELECT SGROUPID FROM '+@CNADMINDB+'..SUBITEMGROUP WHERE SGROUPNAME='''+@SUBITEMGROUP+'''))'"
        strSql += vbCrLf + "      	END"
        strSql += vbCrLf + "      	IF @ISLESSMINPCSSTK='Y'"
        strSql += vbCrLf + "      	BEGIN "
        strSql += vbCrLf + "      		SELECT @QRY = @QRY +CHAR(13)+' AND SR.MINPIECE>0'"
        strSql += vbCrLf + "      	END"
        strSql += vbCrLf + "         END  "
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' )X  GROUP BY ITEMNAME,SUBITEMNAME,SGROUPNAME,ITEM,SUBITEM'"
        strSql += vbCrLf + "         IF @ISLESSMINPCSSTK='Y'"
        strSql += vbCrLf + "             BEGIN"
        strSql += vbCrLf + "             SELECT @QRY = @QRY +CHAR(13)+' HAVING SUM(STKPCS)<SUM(MINPCS)'"
        strSql += vbCrLf + "         END"
        strSql += vbCrLf + "         PRINT @QRY    "
        strSql += vbCrLf + "         EXEC (@QRY)  "
        strSql += vbCrLf + "         SELECT @QRY =' UPDATE TEMPTABLEDB..TEMPSTK SET DIFFPCS =(MAXPCS-ISNULL(STKPCS,0))'"
        strSql += vbCrLf + "  	   SELECT @QRY = @QRY +CHAR(13)+' ,DIFFPCS1 = MAXPCS-(ISNULL(STKPCS,0)+ISNULL(ORDPCS,0)+ISNULL(LOTPCS,0))'"
        strSql += vbCrLf + "  	   SELECT @QRY = @QRY +CHAR(13)+' , DIFFPCS2 =(ISNULL(STKPCS,0)- MINPCS)'"
        strSql += vbCrLf + "         PRINT @QRY    "
        strSql += vbCrLf + "         EXEC (@QRY)"
        strSql += vbCrLf + "         SELECT @QRY =' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPSTK)>0'  "
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' BEGIN'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPSTK(ITEM,SUBITEMNAME,RESULT,COLHEAD)'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' SELECT DISTINCT ITEM,ITEM,0 RESULT,''T''COLHEAD FROM TEMPTABLEDB..TEMPSTK'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPSTK (ITEM,SUBITEMNAME,RESULT,COLHEAD,STKPCS,ORDPCS,MINPCS,MAXPCS,DIFFPCS,DIFFPCS1,NDAYSTOCK,SUBITEM)'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' SELECT DISTINCT ITEM,''SUB TOTAL'',2 RESULT,''S''COLHEAD,'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' SUM(STKPCS),SUM(ORDPCS),SUM(MINPCS),SUM(MAXPCS),SUM(DIFFPCS),SUM(DIFFPCS1),SUM(NDAYSTOCK),''ZZ.SUB TOTAL'''"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' FROM TEMPTABLEDB..TEMPSTK GROUP BY ITEM'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPSTK(ITEM,SUBITEMNAME,RESULT,COLHEAD,STKPCS,ORDPCS,MINPCS,MAXPCS,DIFFPCS,DIFFPCS1,NDAYSTOCK,SUBITEM)  '"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' Select DISTINCT ''ZZZZ'',''GRAND TOTAL'',3 RESULT,''G'' COLHEAD'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' ,SUM(STKPCS),SUM(ORDPCS),SUM(MINPCS),SUM(MAXPCS),SUM(DIFFPCS),SUM(DIFFPCS1),SUM(NDAYSTOCK),''GRAND TOTAL''	 '"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' FROM TEMPTABLEDB..TEMPSTK WHERE RESULT IN (1)'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' END'"
        strSql += vbCrLf + "         PRINT @QRY "
        strSql += vbCrLf + "         EXEC (@QRY)"
        strSql += vbCrLf + "         SELECT @QRY =' DELETE FROM TEMPTABLEDB..TEMPSTK WHERE ISNULL(STKPCS,0)=0 AND ISNULL(ORDPCS,0)=0 AND ISNULL(LOTPCS,0)=0'"
        strSql += vbCrLf + "         SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(MINPCS,0)=0 AND ISNULL(MAXPCS,0)=0 AND ISNULL(DIFFPCS,0)=0 AND ISNULL(NDAYSTOCK,0)=0 AND RESULT=1 '"
        strSql += vbCrLf + "         PRINT @QRY "
        strSql += vbCrLf + "         EXEC (@QRY)"
        strSql += vbCrLf + "         SELECT @QRY =' SELECT * FROM TEMPTABLEDB..TEMPSTK ORDER BY ITEM,SUBITEM,RESULT,COLHEAD'"
        strSql += vbCrLf + "         PRINT @QRY "
        strSql += vbCrLf + "         EXEC (@QRY)"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
