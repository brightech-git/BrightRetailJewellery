        strSql += vbCrLf + "   SELECT @QRY= @QRY+' INNER JOIN ACHEAD AS H ON H.ACCODE = X.ACCODE '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' INNER JOIN ACGROUP AS G ON G.ACGRPCODE = H.ACGRPCODE '  "
        strSql += vbCrLf + "   PRINT @QRY  "
        strSql += vbCrLf + "   EXEC (@QRY)"
        strSql += vbCrLf + "   SELECT @QRY=''    "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "   IF (SELECT MAX(LEN(SCHEDULECODE)) FROM TEMPTABLEDB..TRAILBAL_A )>0  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     SET @MAXLEN = 4  "
