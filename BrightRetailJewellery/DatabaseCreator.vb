        strSql += vbCrLf + "  ,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD''THEN 0 ELSE I.PCS END)AS PCS,I.GRSWT GRSWT,I.NETWT AS NETWT,CASE WHEN I.AMOUNT <> 0 THEN I.TAX-ISNULL((SELECT SUM(TAX) FROM ..ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END TAX,CATCODE  "
