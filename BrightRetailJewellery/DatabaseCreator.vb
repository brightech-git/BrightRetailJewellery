        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD)    "
        strSql += vbCrLf + "  SELECT ITEMNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET  WHERE COLHEAD=''S'' AND RESULT=0 ORDER BY METALNAME,RESULT    "
        strSql += vbCrLf + "  END'+ CHAR(13)+ CHAR(13)"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  /*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ PURCHASE ADJUSTED ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/"
        strSql += vbCrLf + "  SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'PURCHASE'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE      "
        strSql += vbCrLf + "  SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO    "
        strSql += vbCrLf + "  ,''   '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (sELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO     "
        strSql += vbCrLf + "  WHERE BATCHNO = R.BATCHNO)) AS CUSNAME    "
        strSql += vbCrLf + "  ,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = R.ITEMID) AS ITEMNAME    "
        strSql += vbCrLf + "  ,MCHARGE, RATE, AMOUNT,PCS, GRSWT,NETWT,TAX, 0 AS  RECEIPT, AMOUNT + TAX AS PAYMENT    "
        strSql += vbCrLf + "  ,(SELECT CATNAME FROM " & cnAdminDb & "..CATEGORY AS M WHERE M.CATCODE = R.CATCODE) AS METALNAME ,TAGNO,BATCHNO    "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE  FROM RECEIPT AS R"
        strSql += vbCrLf + "  WHERE TRANTYPE  = ''PU'' AND TRANDATE BETWEEN '''+ @FRMDATE +''' AND '''+ @TODATE +'''  AND ISNULL(CANCEL,'''') <> ''Y''   "
        strSql += vbCrLf + "  AND ISNULL(R.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "  IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE)>0    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE   "
        strSql += vbCrLf + "  (ITEMNAME,METALNAME,COLHEAD,RESULT,GRSWT,NETWT,AMOUNT,TAX,RECEIPT,PAYMENT) "
        strSql += vbCrLf + "  SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(AMOUNT)AMOUNT,SUM(TAX)TAX,SUM(RECEIPT) RECEIPT,SUM(PAYMENT) PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE WHERE RESULT = 1 GROUP BY METALNAME "
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD)    "
        strSql += vbCrLf + "  SELECT METALNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE  WHERE COLHEAD=''S'' AND RESULT=0 ORDER BY METALNAME,RESULT    "
        strSql += vbCrLf + "  END'+ CHAR(13)+ CHAR(13)"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  /*SELECT @QRY=' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES)>0  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL9,COL11,COLHEAD)    "
        strSql += vbCrLf + "  SELECT ''G TOTAL'' AS GTOTAL, SUM(ISNULL(TAX,0))AS TAX ,ROUND(SUM(ISNULL(RECEIPT,0)) - SUM(ISNULL(PAYMENT,0)),0) AS TOTAL,''G''    "
        strSql += vbCrLf + "  FROM    "
