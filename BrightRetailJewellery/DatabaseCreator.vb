        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'WHERE I.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' AND '"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'ISNULL(I.CANCEL, '''') = '''' AND  I.TRANTYPE IN (''SA'')'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'AND ISNULL(I.COMPANYID,'''') =  '''+@COMPANYID+''' AND I.AMOUNT > 0'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'GROUP BY I.REMARK1, I.TRANDATE, I.TRANNO, C.SALESTAX, PNAME'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ ',I.METALID,  I.BATCHNO'"
        strSql += vbCrLf + "		PRINT (@QRY)"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'UNION ALL'"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'SELECT DISTINCT R.TRANDATE AS INVOICEDATE, R.TRANNO AS INVOICENO, ''PURCHASE'' AS VOUCHERTYPE, '"
        strSql += vbCrLf + "		SELECT @QRY=@QRY+CHAR(13)+ 'PNAME,'"
