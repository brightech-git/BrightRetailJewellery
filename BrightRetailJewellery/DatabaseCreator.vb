        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QRY"
        strSql += vbCrLf + " 	/** UPDATING WEIGHT INFORMATION **/ "
        strSql += vbCrLf + " 	SELECT @QRY=' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMPWEIGHTINFO'')>0 DROP TABLE TEMPTABLEDB..TEMPWEIGHTINFO' "
        strSql += vbCrLf + " 	SELECT @QRY=@QRY+ char(13)+ ' SELECT ''PCS='' + CONVERT(VARCHAR,PCS)+'' GRSWT='' + CONVERT(VARCHAR,GRSWT)+'' NETWT='' + CONVERT(VARCHAR,NETWT)AS WEIGHTINFO' "
