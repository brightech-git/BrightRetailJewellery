        strSql += vbCrLf + "   ,@STOCKTYPE VARCHAR(1)"
        strSql += vbCrLf + "   ,@WITHSUBITEM VARCHAR(1)"
        strSql += vbCrLf + "   ,@COSTIDS VARCHAR(2000)"
        strSql += vbCrLf + "   ,@ITEMTYPEIDS VARCHAR(5000)"
        strSql += vbCrLf + "   ,@COUNTERID VARCHAR(5000)"
