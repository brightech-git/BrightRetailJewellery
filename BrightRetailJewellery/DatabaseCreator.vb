    Private Function funcDropTableView() As Integer
        Dim strSql As String = Nothing
        Try
            strSql = " DECLARE @QRY NVARCHAR(4000)"
            strSql += " DECLARE @TNAME VARCHAR(50)"
            strSql += " DECLARE @TXTYPE VARCHAR(50)"
            strSql += " DECLARE CUR CURSOR"
            strSql += " FOR SELECT NAME,XTYPE FROM SYSOBJECTS WHERE XTYPE IN ('U','V') AND NAME LIKE 'TEMP%'"
            strSql += " OPEN CUR"
            strSql += " WHILE 1=1"
            strSql += " BEGIN"
            strSql += " FETCH NEXT FROM CUR INTO @TNAME,@TXTYPE"
            strSql += " SET NOCOUNT ON"
            strSql += " 	IF @@FETCH_STATUS = -1 BREAK"
            strSql += " IF @TXTYPE = 'U' "
            strSql += " BEGIN"
            strSql += " SELECT @QRY = 'DROP TABLE ' + @TNAME"
            strSql += " END"
            strSql += " ELSE IF @TXTYPE = 'V' "
            strSql += " BEGIN"
            strSql += " SELECT @QRY = 'DROP VIEW ' + @TNAME"
            strSql += " END"
            strSql += " EXEC SP_EXECUTESQL @QRY"
            strSql += " END"
            strSql += " CLOSE CUR"
            strSql += " DEALLOCATE CUR"
            Dim cmd As OleDbCommand
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
            cmd.ExecuteNonQuery()
        Catch ex As Exception
        End Try

    End Function
    Private Sub CreateIndex(ByVal indexName As String, ByVal tableName As String,
    ByVal param1 As String, Optional ByVal param2 As String = Nothing, Optional ByVal param3 As String = Nothing, Optional ByVal param4 As String = Nothing, Optional ByVal param5 As String = Nothing)
        strSql = " IF NOT(SELECT COUNT(*) FROM SYSINDEXES WHERE NAME = '" & indexName & "')>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  CREATE INDEX " & indexName & " ON " & tableName
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  " & param1 & ""
        If param2 <> Nothing Then strSql += vbCrLf + "  ," & param2 & ""
        If param3 <> Nothing Then strSql += vbCrLf + "  ," & param3 & ""
        If param4 <> Nothing Then strSql += vbCrLf + "  ," & param4 & ""
        If param5 <> Nothing Then strSql += vbCrLf + "  ," & param5 & ""
        strSql += vbCrLf + "  )"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

