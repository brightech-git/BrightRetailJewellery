        strSql += vbCrLf + "      IF @SUMMARY = 'Y'       "
        strSql += vbCrLf + "      BEGIN       "
        strSql += vbCrLf + "       SELECT @QRY = ' UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET TRANTYPE = ''J'''  "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +' WHERE RUNNO IN (SELECT RUNNO FROM  OUTSTANDING O WHERE EXISTS (SELECT 1 FROM ITEMDETAIL WHERE BATCHNO = O.BATCHNO AND RUNNO=O.RUNNO))'  "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +' UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET TRANTYPE = ''O'' WHERE SUBSTRING(RUNNO,6,1) = ''O'''  "
        strSql += vbCrLf + "       SELECT @QRY = @QRY +' DELETE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE TRANTYPE NOT IN (SELECT TYPEID FROM TEMPTABLEDB..TEMP_OUT_TYPE)'  "
