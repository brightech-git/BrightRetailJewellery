        strSql += vbCrLf + "   EXEC(@QRY)      "
        strSql += vbCrLf + "   IF @GROUPBY='N' SELECT @QRY= 'SELECT DISTINCT TEMPACGRPNAME ACGRPNAME,ACNAME PARTICULAR,ACNAME,ACCODE,1 RESULT,''DD'' COLHEAD,DISPORDER,MAINGRPNAME INTO '+@TEMPTABLE +'_ACCODE FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT=1 AND ISNULL(ACCODE,'''')<>''''AND ISNULL(TEMPACGRPNAME,'''')<>'''''      "
        strSql += vbCrLf + "   IF @GROUPBY='G' SELECT @QRY= 'SELECT DISTINCT ACGRPNAME,ACGRPNAME PARTICULAR,TEMPACGRPNAME,1 RESULT,''DD'' COLHEAD,DISPORDER,MAINGRPNAME INTO '+@TEMPTABLE +'_ACCODE FROM TEMPTABLEDB..TRAILBAL_B WHERE RESULT=1 AND ISNULL(TEMPACGRPNAME,'''')<>''''' "
        strSql += vbCrLf + "   PRINT @QRY      "
        strSql += vbCrLf + "   EXEC(@QRY)      "
