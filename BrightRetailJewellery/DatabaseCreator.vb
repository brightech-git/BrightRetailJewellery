        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "          SELECT @QUERY='INSERT INTO '+ @TEMPTABLE +'(ORDERSTATE_NAME,PARTICULAR,ORDNO)'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SELECT DISTINCT O.ORDSTATE_NAME,O.ORDSTATE_NAME AS PARTICULAR,0 ORDNO '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' FROM '+@DBNAME+'..ISSUE AS I INNER JOIN ORDERSTATUS AS O ON I.ORDSTATE_ID=O.ORDSTATE_ID '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+@COMPANYFILTER+@COSTFILTER"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SELECT PARTICULAR,DEALERNAME,TAGNO,PCS,GRSWT,NETWT,AMOUNT FROM  '+ @TEMPTABLE +' ORDER BY ORDERSTATE_NAME,ORDNO'"
        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "          /*EXECUTE SP_RPT_SMITHSTATUSRPT 'JB1T1314','TEMPORDSTATUS','2013-04-01','2013-05-31','ALL','ALL'*/"
        strSql += vbCrLf + "          END"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_RPT_TAGTYPEREPORT()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGTYPEREPORT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGTYPEREPORT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_TAGTYPEREPORT"
        strSql += vbCrLf + "          ( @DBNAME VARCHAR(50)"
        strSql += vbCrLf + "          ,@TEMPTAB VARCHAR(50)"
        strSql += vbCrLf + "          ,@FROMDATE VARCHAR(13)"
        strSql += vbCrLf + "          ,@TODATE VARCHAR(13) "
        strSql += vbCrLf + "          ,@COMPANYID VARCHAR(50)"
        strSql += vbCrLf + "          ,@COSTID VARCHAR(50)"
        strSql += vbCrLf + "          )"
        strSql += vbCrLf + "          AS "
        strSql += vbCrLf + "          BEGIN"
        strSql += vbCrLf + "          DECLARE @TEMPTABLE VARCHAR(1000)"
        strSql += vbCrLf + "          SET @TEMPTABLE='TEMPTABLEDB..'+@TEMPTAB"
        strSql += vbCrLf + "          DECLARE @QUERY NVARCHAR(4000)"
        strSql += vbCrLf + "          DECLARE @COMPANYFILTER VARCHAR(1000)"
        strSql += vbCrLf + "          DECLARE @COSTFILTER VARCHAR(1000)"
        strSql += vbCrLf + "          SET @COMPANYFILTER=''"
        strSql += vbCrLf + "          SET @COSTFILTER=''"
        strSql += vbCrLf + "          SET @COMPANYID = REPLACE(@COMPANYID,',',''',''')"
        strSql += vbCrLf + "          IF @COMPANYID <>'ALL' SET @COMPANYFILTER=' AND I.COMPANYID IN ('''+@COMPANYID +''') '"
        strSql += vbCrLf + "          SET @COSTID = REPLACE(@COSTID,',',''',''')"
        strSql += vbCrLf + "          IF @COSTID<> 'ALL' SET @COSTFILTER=' AND I.COSTID IN ('''+@COSTID +''') '"
        strSql += vbCrLf + "          SET @QUERY='IF EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME ='+''''+@TEMPTAB+''''+')'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+'DROP TABLE '+ @TEMPTABLE"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "          SELECT @QUERY='CREATE TABLE '+ @TEMPTABLE +'(PARTICULAR VARCHAR(100),ENTRYTYPE VARCHAR(20),TAGNO VARCHAR(20), SNO INT,FROMITEMNAME VARCHAR(50), ITEMID INT,FROMITEMID INT,PCS INT, GRSWT NUMERIC(12,2), NETWT NUMERIC(12,2))'"
        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "          SELECT @QUERY='INSERT INTO '+ @TEMPTABLE +'(PARTICULAR ,ENTRYTYPE ,TAGNO, SNO ,FROMITEMNAME, ITEMID, FROMITEMID, PCS , GRSWT , NETWT)'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SELECT ''   ''+CASE WHEN ISNULL(I.FROMITEMID,0) <> 0 THEN CASE WHEN ISNULL(I.FROMITEMID,0) <> 0 THEN IM.ITEMNAME END ELSE IM.ITEMNAME END, IL.ENTRYTYPE ' --     IMM.ITEMNAME"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' ,I.TAGNO, 1 SNO,CASE WHEN ISNULL(I.FROMITEMID,0) <> 0 THEN IM.ITEMNAME END, I.ITEMID,IMM.ITEMID, I.PCS, I.GRSWT, I.NETWT FROM ITEMTAG AS I LEFT JOIN ITEMLOT AS IL ON I.LOTSNO=IL.SNO  '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' LEFT JOIN ITEMMAST AS IM ON I.ITEMID=IM.ITEMID'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' LEFT JOIN ITEMMAST AS IMM ON I.FROMITEMID=IMM.ITEMID'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' WHERE I.RECDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND ENTRYTYPE=''NT'' '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+@COMPANYFILTER+@COSTFILTER"
        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"

        strSql += vbCrLf + "     	  SELECT @QUERY=' INSERT INTO '+ @TEMPTABLE +'(PARTICULAR,SNO,FROMITEMID)'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' SELECT DISTINCT ISNULL(IMM.ITEMNAME,'''') AS PARTICULAR'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' , 0 SNO, IMM.ITEMID FROM ITEMTAG AS I LEFT JOIN ITEMLOT AS IL ON I.LOTSNO=IL.SNO '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' LEFT JOIN ITEMMAST AS IMM ON I.FROMITEMID=IMM.ITEMID'"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+' WHERE I.RECDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "          SELECT @QUERY=@QUERY+@COMPANYFILTER+@COSTFILTER"
        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"

        strSql += vbCrLf + "     	  SELECT @QUERY='SELECT PARTICULAR,TAGNO,PCS,GRSWT,NETWT FROM '+ @TEMPTABLE +' ORDER BY FROMITEMID, SNO' "
        strSql += vbCrLf + "          PRINT @QUERY"
        strSql += vbCrLf + "          EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "          /*EXECUTE SP_RPT_TAGTYPEREPORT 'JCOT1314','TEMP','2013-05-01','2013-05-31','ALL','ALL'*/"
        strSql += vbCrLf + "          END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_RPT_BUDGETANLYSIS()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_BUDGETANLYSIS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_BUDGETANLYSIS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_BUDGETANLYSIS"
        strSql += vbCrLf + "  (      "
        strSql += vbCrLf + "  @DBNAME VARCHAR(20) ,@TEMPTBL VARCHAR(20),@MONTH VARCHAR(15),@FROMDATE VARCHAR(15)      "
        strSql += vbCrLf + "  ,@TODATE VARCHAR(15)  ,@COSTID VARCHAR(200)  ,@ACGRPID VARCHAR(1000)  ,@ACCCODE VARCHAR(1000)    "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(10) "
        strSql += vbCrLf + "  )      "
        strSql += vbCrLf + "  AS      "
        strSql += vbCrLf + "  SET NOCOUNT ON      "
        strSql += vbCrLf + "  DECLARE @SQRY NVARCHAR(4000)"
        strSql += vbCrLf + "  set @ACCCODE = REPLACE(@ACCCODE,',',''',''')"
        strSql += vbCrLf + "  BEGIN     "
        strSql += vbCrLf + "  	SELECT @SQRY =' IF OBJECT_ID(''TEMPTABLEDB..'+@TEMPTBL+''') IS NOT NULL'"
        strSql += vbCrLf + "  	SELECT @SQRY =@SQRY +' DROP TABLE TEMPTABLEDB..'+@TEMPTBL"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY "
        strSql += vbCrLf + "  	SELECT @SQRY = ' SELECT AG.ACGRPNAME,AC.ACNAME,ACMGROUPID,ACGROUPID,T.ACCODE'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,0 AS MONTHACTUAL '"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,CASE WHEN BUDMODE = ''M'' THEN SUM(ISNULL(BUDVALUE,0)) ELSE SUM(ISNULL(BUDVALUE,0)/12) END AS MONTHBUDGET'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,0 MONTHVARIANCE,0 MONTHBUDGET_PER,0 YTDACTUAL,0 YTDBUDGET,0 YTDVARIANCE,0 YTDBUDGET_PER' "
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' INTO TEMPTABLEDB..'+@TEMPTBL +' FROM '+@DBNAME+'..BUDGETCONTROL  AS T '"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' LEFT JOIN ACGROUP AG ON AG.ACGRPCODE=T.ACGROUPID'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' LEFT JOIN ACHEAD AC ON AC.ACCODE=T.ACCODE'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' WHERE (T.BUDMONTH ='''+ @MONTH+''' AND BUDMODE = ''M'') OR (T.BUDYEAR = YEAR('''+@FROMDATE+''') AND BUDMODE = ''Y'')'"
        strSql += vbCrLf + "  	IF @COMPANYID <> '' SELECT @SQRY = @SQRY + ' AND COMPANYID = '''+@COMPANYID  +''''"
        strSql += vbCrLf + "  	IF @ACCCODE <> '' SELECT @SQRY = @SQRY + ' AND T.ACCODE IN ('''+@ACCCODE+''')'"
        strSql += vbCrLf + "  	IF @ACGRPID <>'' SELECT @SQRY = @SQRY + ' AND T.ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN ('''+@ACGRPID+'''))'"
        strSql += vbCrLf + "  	IF @COSTID <> '' SELECT @SQRY = @SQRY + ' AND ISNULL(T.COSTID,'''') IN ('''+@COSTID+''')'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' GROUP BY  ACMGROUPID,ACGROUPID,T.ACCODE,BUDMODE,AG.ACGRPNAME,AC.ACNAME'"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"

        strSql += vbCrLf + "  	SELECT @SQRY = ' ALTER TABLE TEMPTABLEDB..'+@TEMPTBL +' ADD SNO INT IDENTITY(1,1) '"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"
        strSql += vbCrLf + "  	SELECT @SQRY =' UPDATE T SET MONTHACTUAL=ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM '+@DBNAME+'..ACCTRAN WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND ACCODE=T.ACCODE AND ISNULL(CANCEL,'''') <> ''Y'''     "
        strSql += vbCrLf + "  	IF @COMPANYID <> '' SELECT @SQRY = @SQRY +  ' AND COMPANYID = '''+@COMPANYID  +''''"
        strSql += vbCrLf + "  	IF @ACCCODE <> '' SELECT @SQRY = @SQRY +  ' AND ACCODE IN ('''+@ACCCODE+''')'"
        strSql += vbCrLf + "  	IF @ACGRPID <>'' SELECT @SQRY = @SQRY +  ' AND ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN ('''+@ACGRPID+'''))'"
        strSql += vbCrLf + "  	IF @COSTID <> '' SELECT @SQRY = @SQRY +  ' AND ISNULL(COSTID,'''') IN ('''+@COSTID+''')'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + '),0) FROM TEMPTABLEDB..'+@TEMPTBL +' T'"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"
        strSql += vbCrLf + "  	SELECT @SQRY =   ' UPDATE T SET YTDBUDGET=ISNULL((SELECT SUM(ISNULL(BUDVALUE,0)) FROM '+@DBNAME+'..BUDGETCONTROL WHERE BUDMONTH <= MONTH('''+@TODATE+''') AND BUDYEAR=YEAR('''+@TODATE+''') AND ACCODE= T.ACCODE '     "
        strSql += vbCrLf + "  	IF @COMPANYID <> '' SELECT @SQRY = @SQRY +  ' AND COMPANYID = '''+@COMPANYID  +''''"
        strSql += vbCrLf + "  	IF @ACCCODE <> '' SELECT @SQRY = @SQRY +  ' AND ACCODE IN ('''+@ACCCODE+''')'"
        strSql += vbCrLf + "  	IF @ACGRPID <>'' SELECT @SQRY = @SQRY +  ' AND ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN ('''+@ACGRPID+'''))'"
        strSql += vbCrLf + "  	IF @COSTID <> '' SELECT @SQRY = @SQRY +  ' AND ISNULL(COSTID,'''') IN ('''+@COSTID+''')'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ),0) FROM TEMPTABLEDB..'+@TEMPTBL +' T '"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"

        strSql += vbCrLf + "  	SELECT @SQRY =   ' UPDATE T SET YTDACTUAL=ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''D'' THEN ISNULL(AMOUNT,0) ELSE -1*ISNULL(AMOUNT,0) END) FROM '+@DBNAME+'..ACCTRAN WHERE TRANDATE <= '''+@TODATE+''' AND ACCODE= T.ACCODE AND ISNULL(CANCEL,'''') <> ''Y'''     "
        strSql += vbCrLf + "  	IF @COMPANYID <> '' SELECT @SQRY = @SQRY +  ' AND COMPANYID = '''+@COMPANYID  +''''"
        strSql += vbCrLf + "  	IF @ACCCODE <> '' SELECT @SQRY = @SQRY +  ' AND ACCODE IN ('''+@ACCCODE+''')'"
        strSql += vbCrLf + "  	IF @ACGRPID <>'' SELECT @SQRY = @SQRY +  ' AND ACCODE IN (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN ('''+@ACGRPID+'''))'"
        strSql += vbCrLf + "  	IF @COSTID <> '' SELECT @SQRY = @SQRY +  ' AND ISNULL(COSTID,'''') IN ('''+@COSTID+''')'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ),0) FROM TEMPTABLEDB..'+@TEMPTBL +' T '"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"
        strSql += vbCrLf + "  	SELECT @SQRY = ' UPDATE T SET MONTHVARIANCE= (MONTHBUDGET-MONTHACTUAL),YTDVARIANCE= (YTDBUDGET-YTDACTUAL)'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' FROM TEMPTABLEDB..'+@TEMPTBL +' T '"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"

        strSql += vbCrLf + "  	SELECT @SQRY = ' SELECT * FROM TEMPTABLEDB..'+@TEMPTBL +' T '"
        strSql += vbCrLf + "  	SELECT @SQRY = ' SELECT DISTINCT ACGRPNAME AS PARTICULAR,NULL ACMGROUPID,ACGROUPID,NULL ACCODE,NULL MONTHACTUAL,NULL MONTHBUDGET'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,NULL MONTHVARIANCE,NULL AS MONTHBUDGET_PER,NULL YTDACTUAL,NULL YTDBUDGET,NULL YTDVARIANCE,NULL YTDBUDGET_PER,''0'' RESULT,'''' COLHEAD  FROM TEMPTABLEDB..'+@TEMPTBL +'' "
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' UNION ALL'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' SELECT ''    ''+ACNAME AS PARTICULAR,ACMGROUPID,ACGROUPID,ACCODE,MONTHACTUAL,MONTHBUDGET'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,MONTHVARIANCE,MONTHBUDGET_PER,YTDACTUAL,YTDBUDGET,YTDVARIANCE,YTDBUDGET_PER,''1'' RESULT,'''' COLHEAD  FROM TEMPTABLEDB..'+@TEMPTBL +''"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' UNION ALL'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' SELECT ''TOTAL'' AS PARTICULAR,NULL ACMGROUPID,9999 ACGROUPID,NULL ACCODE,SUM(MONTHACTUAL),SUM(MONTHBUDGET) MONTHBUDGET'"
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ,SUM(MONTHVARIANCE),NULL AS MONTHBUDGET_PER,SUM(YTDACTUAL) YTDACTUAL,SUM(YTDBUDGET) YTDBUDGET,SUM(YTDVARIANCE) YTDVARIANCE,NULL YTDBUDGET_PER,''3'' RESULT,''G'' COLHEAD  FROM TEMPTABLEDB..'+@TEMPTBL +'' "
        strSql += vbCrLf + "  	SELECT @SQRY = @SQRY + ' ORDER BY ACGROUPID,RESULT'"
        strSql += vbCrLf + "  	PRINT @SQRY"
        strSql += vbCrLf + "  	EXECUTE sp_executesql @SQRY"
        strSql += vbCrLf + "  	/* EXECUTE SP_RPT_BUDGETANLYSIS 'NMLT1314','TEMPBUDGET','6','01-JUN-2013','30-JUN-2013','','','','' */"
        strSql += vbCrLf + "  END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_RECEIPTLOTVIEW()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_RECEIPTTAG')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_RECEIPTTAG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf
        strSql += vbCrLf + " CREATE PROCEDURE SP_RPT_RECEIPTTAG"
        strSql += vbCrLf + "   ( "
        strSql += vbCrLf + "   @FROMDATE VARCHAR(20) "
        strSql += vbCrLf + "   ,@TODATE VARCHAR(20) "
        strSql += vbCrLf + "   ,@DBNAME VARCHAR(20) "
        strSql += vbCrLf + "   ,@SYSTEMID VARCHAR(10) "
        strSql += vbCrLf + "   ,@GROUPBY VARCHAR(10) "
        strSql += vbCrLf + "   ,@FILTER VARCHAR(3)     "
        strSql += vbCrLf + "   ,@VIEWTYPE VARCHAR(3)  "
        strSql += vbCrLf + "   )  "
        strSql += vbCrLf + "   AS "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   	DECLARE @QRY VARCHAR(8000)   "
        strSql += vbCrLf + "   	DECLARE @TAGALLOCATION NUMERIC(17,3)  "
        strSql += vbCrLf + "   	SELECT @QRY = ' IF (SELECT COUNT(*) FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'LOTVIEW'') > 0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'LOTVIEW' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' IF (SELECT COUNT(*) FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'LOTVIEW1'') > 0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'LOTVIEW1'     "
        strSql += vbCrLf + "   	PRINT @QRY"
        strSql += vbCrLf + "   	EXEC (@QRY)  "
        strSql += vbCrLf + "   	SELECT @QRY = ' SELECT CONVERT(VARCHAR(100),NULL) PARTICULAR,IM.ITEMNAME AS ITEM,A.ACNAME,CONVERT(VARCHAR(20),R.TRANDATE,103) AS RDATE'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,R.SNO,R.TRANNO RTRANNO,R.PCS AS RPCS,R.GRSWT AS RGRSWT,R.NETWT AS RNETWT'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(STNPCS) FROM '+@DBNAME+'..RECEIPTSTONE WHERE ISSSNO=R.SNO AND STNITEMID IN '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' (SELECT ITEMID FROM ITEMMAST WHERE METALID=''D''))RDIAPCS'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(STNWT) FROM '+@DBNAME+'..RECEIPTSTONE WHERE ISSSNO=R.SNO AND STNITEMID IN '"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' (SELECT ITEMID FROM ITEMMAST WHERE METALID=''D''))RDIAWT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,LOTNO,L.PCS AS LPCS,L.GRSWT LGRSWT,L.NETWT LNETWT,L.DIAPCS AS LDIAPCS,L.DIAWT LDIAWT,COUNT(I.TAGNO) NOOFTAG,SUM(ISNULL(I.PCS,0)) SPCS'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,SUM(ISNULL(I.GRSWT,0)) SGRSWT,SUM(ISNULL(I.NETWT,0)) SNETWT,CONVERT(NUMERIC(15,3),0) SDIAPCS,CONVERT(NUMERIC(15,3),0) SDIAWT ' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,(L.PCS-SUM(ISNULL(I.PCS,0))) AS DIFFPCS'    "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,(L.GRSWT-SUM(ISNULL(I.GRSWT,0))) AS DIFFGWT,(L.NETWT-SUM(ISNULL(I.NETWT,0)))AS DIFFNWT'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(NUMERIC(15,3),0) DIFFDIAPCS'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(NUMERIC(15,3),0) DIFFDIAWT,1 RESULT,''  ''COLHEAD'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'LOTVIEW1'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' FROM '+@DBNAME+'..RECEIPT R ' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN '+@DBNAME+'..LOTISSUE LI ON R.SNO =LI.RECSNO' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN ITEMLOT L ON L.SNO =LI.LOTSNO' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN ITEMTAG I ON L.SNO=I.LOTSNO'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.SNO NOT IN(SELECT SNO FROM ITEMTAG WHERE NARRATION=''SPLITTED'')'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND I.SNO NOT IN(SELECT SNO FROM ITEMTAG WHERE NARRATION=''MERGED'')'"
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' LEFT JOIN ITEMMAST IM ON L.ITEMID = IM.ITEMID'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' LEFT JOIN ACHEAD A ON R.ACCODE=A.ACCODE'  "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' WHERE R.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''  "
        strSql += vbCrLf + "  	IF (SELECT ISNULL(CTLTEXT,'N') FROM SOFTCONTROL WHERE CTLID = 'RIN_AND_TAG_SPLIT_RESTRICT') = 'Y'"
        strSql += vbCrLf + "   		SELECT @QRY = @QRY + CHAR(13) +' AND R.TRANTYPE <> ''RIN'' AND I.NARRATION <> ''TAG SPLITTED''' "
        strSql += vbCrLf + "   	SELECT @QRY = @QRY + CHAR(13) +' AND LEN(R.TRANTYPE)>2 AND ISNULL(R.TRANNO,0)<>0 GROUP BY A.ACNAME,R.TRANDATE,R.SNO,R.TRANNO,L.LOTNO,IM.ITEMNAME,L.PCS,L.GRSWT,L.NETWT,L.DIAPCS,L.DIAWT,R.PCS,R.GRSWT,R.NETWT'  "
