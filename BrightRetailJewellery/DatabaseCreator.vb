        strSql += vbCrLf + "   SELECT @QRY= @QRY+' SELECT'        "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' X.SEP,X.ACCODE,X.AMOUNT'       "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' ,H.ACNAME,G.ACGRPNAME,G.ACMAINSUB,G.DISPORDER,CONVERT(VARCHAR,CASE WHEN G.SCHEDULECODE = ''0'' THEN '''' ELSE ISNULL(G.SCHEDULECODE,'''') END) AS SCHEDULECODE,G.ACGRPNAME TEMPACGRPNAME,X.COSTID'       "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' FROM            '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' ('       "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' SELECT ''O''SEP,ACCODE,CONVERT(NUMERIC(15,2),DEBIT-CREDIT) AS AMOUNT,T.COSTID' "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' FROM '+ @DBNAME +'..OPENTRAILBALANCE T'       "
