    Private Sub RPT_ORDERSTATUS()
        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='RPT_ORDERSTATUS')>0"
        strSql += vbCrLf + " DROP PROCEDURE RPT_ORDERSTATUS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "  CREATE PROCEDURE RPT_ORDERSTATUS"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "  @FROMDATE VARCHAR(12)"
        strSql += vbCrLf + "  ,@TODATE VARCHAR(12)"
