    Private Sub DropTempTable()
        Dim dt As New DataTable
        Dim QRY As String = ""
        strSql = "SELECT 'DROP TABLE " & tempdbname & "..' + NAME AS TABLENAME FROM " & tempdbname & ".SYS.TABLES "
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
        QRY = ""
        strSql = ""
        For i As Integer = 0 To dt.Rows.Count - 1
            QRY = dt.Rows(i).Item("TABLENAME").ToString
            strSql += vbCrLf + QRY
        Next
        If strSql <> "" Then
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
        End If
        strSql = ""
    End Sub
