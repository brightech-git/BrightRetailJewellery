                        strSql += " ,TAXID='GT'"
                        strSql += " WHERE CATCODE = '" & CatCode & "'"
                        ExecQuery_DbCreator(SyncMode.Master, strSql, cn, tran)

                        strSql = " UPDATE " & cnAdminDb & "..CATEGORY SET CATNAME=REPLACE(CATNAME,'VAT','GST')"
                        strSql += " ,TAXID='GT'"
                        strSql += " WHERE CATCODE = '" & CatCode & "'"
                        ExecQuery_DbCreator(SyncMode.Master, strSql, cn, tran)
                    Next
                End If
            End If

            strSql = vbCrLf + "DECLARE @PREBATCHNO VARCHAR(15)"
            strSql += vbCrLf + "DECLARE @BATCHNO VARCHAR(15)"
            strSql += vbCrLf + "DECLARE @SNO VARCHAR(15)"
            strSql += vbCrLf + "DECLARE @I INT"
            strSql += vbCrLf + "SET @PREBATCHNO=''"
            strSql += vbCrLf + "DECLARE CUR CURSOR FOR"
            strSql += vbCrLf + "SELECT BATCHNO,SNO FROM " & tranDbName & "..ISSUE WHERE TRANTYPE IN('SA','OD','RD') "
            strSql += vbCrLf + "AND WT_ENTORDER IS NULL"
            strSql += vbCrLf + "ORDER BY CAST(SUBSTRING(BATCHNO,6,20) AS INT),CAST(SUBSTRING(SNO,6,20) AS INT)"
            strSql += vbCrLf + "OPEN CUR"
            strSql += vbCrLf + "FETCH NEXT FROM CUR INTO @BATCHNO,@SNO"
            strSql += vbCrLf + "WHILE @@FETCH_STATUS<>-1"
            strSql += vbCrLf + "BEGIN"
            strSql += vbCrLf + "	IF @PREBATCHNO<>@BATCHNO"
            strSql += vbCrLf + "	BEGIN"
            strSql += vbCrLf + "		SET @I=1"
            strSql += vbCrLf + "		UPDATE " & tranDbName & "..ISSUE SET WT_ENTORDER=@I WHERE SNO=@SNO"
            strSql += vbCrLf + "		SET @PREBATCHNO=@BATCHNO"
            strSql += vbCrLf + "	END"
            strSql += vbCrLf + "	ELSE"
            strSql += vbCrLf + "	BEGIN"
            strSql += vbCrLf + "		SELECT @I=@I+1"
            strSql += vbCrLf + "		UPDATE " & tranDbName & "..ISSUE SET WT_ENTORDER=@I WHERE SNO=@SNO"
            strSql += vbCrLf + "	END"
            strSql += vbCrLf + "	FETCH NEXT FROM CUR INTO @BATCHNO,@SNO"
            strSql += vbCrLf + "END"
            strSql += vbCrLf + "CLOSE CUR"
            strSql += vbCrLf + "DEALLOCATE CUR"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + "IF OBJECT_ID('TEMPTABLEDB..TEMP1','U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP1"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            strSql = vbCrLf + "SELECT * "
            strSql += vbCrLf + ",IDENTITY(INT,1,1)AS SNO"
            strSql += vbCrLf + "INTO TEMPTABLEDB..TEMP1"
            strSql += vbCrLf + "FROM ("
            strSql += vbCrLf + "SELECT TRANNO,TRANDATE,PAYMODE,BATCHNO,'SG'TAXID"
            strSql += vbCrLf + ",AMOUNT,1.5 TAXPER,CONVERT(NUMERIC(15,2),GSTVAL/2)AS TAX,1 AS TSNO "
            strSql += vbCrLf + "FROM " & cnAdminDb & "..OUTSTANDING O"
            strSql += vbCrLf + "WHERE TRANDATE>='2017-07-01'"
            strSql += vbCrLf + "AND PAYMODE IN('AR','AP','AA','AD','OR') "
            strSql += vbCrLf + "AND NOT EXISTS(SELECT 1 FROM " & tranDbName & "..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE IN('AR','AP','AA','AD','OR'))"
            strSql += vbCrLf + "AND ISNULL(CANCEL,'')=''"
            strSql += vbCrLf + "AND ISNULL(GSTVAL,0)>0"
            strSql += vbCrLf + "UNION ALL"
            strSql += vbCrLf + "SELECT TRANNO,TRANDATE,PAYMODE,BATCHNO,'CG'TAXID"
            strSql += vbCrLf + ",AMOUNT,1.5 TAXPER,CONVERT(NUMERIC(15,2),GSTVAL/2)AS TAX,2 AS TSNO "
            strSql += vbCrLf + "FROM " & cnAdminDb & "..OUTSTANDING O"
            strSql += vbCrLf + "WHERE TRANDATE>='2017-07-01'"
            strSql += vbCrLf + "AND PAYMODE IN('AR','AP','AA','AD','OR') "
            strSql += vbCrLf + "AND NOT EXISTS(SELECT 1 FROM " & tranDbName & "..TAXTRAN WHERE BATCHNO=O.BATCHNO AND TRANTYPE IN('AR','AP','AA','AD','OR'))"
            strSql += vbCrLf + "AND ISNULL(CANCEL,'')=''"
            strSql += vbCrLf + "AND ISNULL(GSTVAL,0)>0"
            strSql += vbCrLf + ")X"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + "INSERT INTO " & tranDbName & "..TAXTRAN(SNO,TRANNO,TRANDATE,TRANTYPE,BATCHNO,TAXID,AMOUNT,TAXPER,TAXAMOUNT,TSNO)"
            strSql += vbCrLf + "SELECT CAST(SNO AS VARCHAR)+PAYMODE+TAXID+CAST(TRANNO AS VARCHAR),TRANNO,TRANDATE,PAYMODE,BATCHNO,TAXID"
            strSql += vbCrLf + ",AMOUNT,TAXPER,TAX,TSNO"
            strSql += vbCrLf + "FROM TEMPTABLEDB..TEMP1"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + "UPDATE " & tranDbName & "..TAXTRAN SET TRANTYPE='AR' WHERE TRANTYPE='AD'"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + "UPDATE TT SET ISSSNO=O.SNO FROM " & cnAdminDb & "..OUTSTANDING O," & tranDbName & "..TAXTRAN TT "
            strSql += vbCrLf + " WHERE O.BATCHNO=TT.BATCHNO AND O.AMOUNT=TT.AMOUNT "
            strSql += vbCrLf + " AND O.PAYMODE=TT.TRANTYPE AND TT.TRANTYPE IN('AA','AP','AR','OR') "
            strSql += vbCrLf + " AND ISNULL(TT.ISSSNO,'')=''"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = vbCrLf + " UPDATE " & cnAdminDb & "..CATEGORY SET SRETURNID=SALESID WHERE ISNULL(SRETURNID,'')='' "
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = "UPDATE P SET STATEID=(SELECT TOP 1 STATEID FROM " & cnAdminDb & "..STATEMAST WHERE STATENAME=P.STATE) "
            strSql += vbCrLf + " FROM " & cnAdminDb & "..PERSONALINFO P"
            strSql += vbCrLf + " WHERE ISNULL(STATEID,0)=0 "
            strSql += vbCrLf + " AND SNO IN(SELECT PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO IN(SELECT BATCHNO FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE>='2017-07-01'))"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            strSql = "UPDATE " & tranDbName & "..TAXTRAN SET COMPANYID=SUBSTRING(BATCHNO,3,3) WHERE ISNULL(COMPANYID,'')=''"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()
            If cnCostId <> "" Then
                strSql = "UPDATE " & tranDbName & "..TAXTRAN SET COSTID=SUBSTRING(BATCHNO,1,2) WHERE ISNULL(COSTID,'')='' AND SUBSTRING(BATCHNO,1,2)<>'00'"
                cmd = New OleDbCommand(strSql, cn, tran)
                cmd.ExecuteNonQuery()
            End If

            strSql = vbCrLf + " UPDATE " & tranDbName & "..BOOKEDITEM_HISTORY SET TRANDATE=UPDATED WHERE TRANDATE IS NULL"
            cmd = New OleDbCommand(strSql, cn, tran)
            cmd.ExecuteNonQuery()

            STATUS = "CREATING TRIGGER FOR ALERT SMS - SAVINGS"
            ''Savings Alert Sms Trigger
            SavingsTriggerforAlertSms()
            cn.Close()

            lblStatus.Text = CompName + "'s Database Creation Completed"


YEnd_Process:
            If YEnd Then
                If dbType = "W" Then
                    cn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & tranDbName & ";Data Source=" & serverName & "")
                Else
                    cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & tranDbName & ";Data Source=" & serverName & ";password=" & pwd)
                End If
                cn.Open()
                tran = cn.BeginTransaction
                STATUS = "Executing Year End Process"
                funcProgressStep(40)
                'YearEndProcess()
                If GetSqlValue("SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'YEAREND_BY_SEIVESTNGRP'", "N", tran) = "Y" Then
                    strSql = " EXEC " & tranDbName & "..PROC_YEAREND_SEIVESTNGRP"
                    strSql += vbCrLf + "  @POTAG = 'N'" 'IIf(chkTag.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@PONONTAG = 'N'" 'IIf(chkNonTag.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POORDERREPAIR = 'N'" 'IIf(chkOrderRepair.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POADVANCEDUE = 'N'" 'IIf(chkAdvanceDue.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POTRAILBAL = '" & IIf(chkTrailBalance.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POSTOCK = '" & IIf(chkWeightBalance.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POAPPROVAL = '" & IIf(chkApproval.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POTOBE = '" & IIf(chkTobe.Checked, "Y", "N") & "'"
                    cmd = New OleDbCommand(strSql, cn, tran)
                    cmd.CommandTimeout = 2000
                    cmd.ExecuteNonQuery()
                Else
                    strSql = " EXEC " & tranDbName & "..PROC_YEAREND"
                    strSql += vbCrLf + "  @POTAG = 'N'" 'IIf(chkTag.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@PONONTAG = 'N'" 'IIf(chkNonTag.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POORDERREPAIR = 'N'" 'IIf(chkOrderRepair.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POADVANCEDUE = 'N'" 'IIf(chkAdvanceDue.Checked, "Y", "N")
                    strSql += vbCrLf + "  ,@POTRAILBAL = '" & IIf(chkTrailBalance.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POSTOCK = '" & IIf(chkWeightBalance.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POAPPROVAL = '" & IIf(chkApproval.Checked, "Y", "N") & "'"
                    strSql += vbCrLf + "  ,@POTOBE = '" & IIf(chkTobe.Checked, "Y", "N") & "'"
                    cmd = New OleDbCommand(strSql, cn, tran)
                    cmd.CommandTimeout = 2000
                    cmd.ExecuteNonQuery()
                End If

                strSql = " DELETE FROM " & tranDbName & "..OPENTRAILBALANCE "
                strSql += vbCrLf + "  WHERE ISNULL(DEBIT,0)=0 AND ISNULL(CREDIT,0)=0 "
                strSql += vbCrLf + "  AND ISNULL(DEBITWT,0)=0 AND ISNULL(CREDITWT,0)=0"
                strSql += vbCrLf + "  AND ISNULL(TRANSFERED,'') <> ''"
                cmd = New OleDbCommand(strSql, cn, tran)
                cmd.ExecuteNonQuery()

                Dim DbCloseUpdate As Boolean = IIf(GetSqlValue("SELECT CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'DB_FIN_CLOSE'", , tran) = "Y", True, False)
                If DbCloseUpdate = True Then
                    Dim oldStockDb As String = compId + "T" + Mid(YEnd_frmDate.Year - 1, 3, 2) + Mid(YEnd_toDate.Year - 1, 3, 2)
                    strSql = " UPDATE " & cnAdminDb & "..DBMASTER SET CLOSED='Y' WHERE DBNAME='" & oldStockDb & "'"
                    cmd = New OleDbCommand(strSql, cn, tran) : cmd.CommandTimeout = 2000
                    cmd.ExecuteNonQuery()
                End If

                tran.Commit()
                tran.Dispose()
                cn.Close()
            End If

            tran = Nothing
            If chkPkCustInfo.Checked Then
                Try
                    Dim tCn As OleDbConnection = Nothing
                    If dbType = "W" Then
                        tCn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & tranDbName & ";Data Source=" & serverName & "")
                    Else
                        tCn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & tranDbName & ";Data Source=" & serverName & ";password=" & pwd)
                    End If
                    tCn.Open()
                    ''creating customerinfo primary key
                    strSql = vbCrLf + " IF NOT(SELECT COUNT(*) FROM SYSOBJECTS WHERE XTYPE = 'PK'"
                    strSql += vbCrLf + " AND ID IN (SELECT CONSTID FROM SYSCONSTRAINTS WHERE ID = OBJECT_ID('CUSTOMERINFO'))"
                    strSql += vbCrLf + " )<> 0"
                    strSql += vbCrLf + " BEGIN"
                    strSql += vbCrLf + " ALTER TABLE CUSTOMERINFO ALTER COLUMN BATCHNO VARCHAR(15) NOT NULL"
                    strSql += vbCrLf + " END"
                    cmd = New OleDbCommand(strSql, tCn) : cmd.ExecuteNonQuery()
                    strSql = vbCrLf + " IF NOT(SELECT COUNT(*) FROM SYSOBJECTS WHERE XTYPE = 'PK'"
                    strSql += vbCrLf + " AND ID IN (SELECT CONSTID FROM SYSCONSTRAINTS WHERE ID = OBJECT_ID('CUSTOMERINFO'))"
                    strSql += vbCrLf + " )<> 0"
                    strSql += vbCrLf + " BEGIN"
                    strSql += vbCrLf + " ALTER TABLE CUSTOMERINFO ADD PRIMARY KEY (BATCHNO)"
                    strSql += vbCrLf + " END"
                    cmd = New OleDbCommand(strSql, tCn) : cmd.ExecuteNonQuery()
                    tCn.Close()
                Catch ex As Exception
                    Throw New Exception("Error occured when create primary key in customerinfo" + vbCrLf + "Please constact Administrator" + vbCrLf + ex.Message)
                End Try
            End If



            For cnt As Integer = pBar.Value To pBar.Maximum
                If (pBar.Value + 1) < pBar.Maximum Then pBar.Value += 1
            Next

            btnInstall.Visible = False
            btnExit.Select()

            Dim myBuildInfo As FileVersionInfo = FileVersionInfo.GetVersionInfo(Application.ExecutablePath)
            Dim APPVERSION As String = myBuildInfo.FileVersion
            Dim InsHostName As String = System.Net.Dns.GetHostName()
            Dim InsSysIp As String = System.Net.Dns.GetHostByName(InsHostName).AddressList(0).ToString()
            Dim Emailmsg As String = "FYI - " & lblStatus.Text
            Emailmsg += vbCrLf & " Host Name : " & InsHostName
            Emailmsg += vbCrLf & " System IP No. : " & InsSysIp
            Emailmsg += vbCrLf & " Installation Date : " & Today.Date.ToString("dd-MM-yyyy") & " @ " & Now.Hour.ToString & ":" & Now.Minute.ToString & " Hrs."
            Emailmsg += vbCrLf & " Application Version: " & APPVERSION

            NEWMAILSEND("sample@GMAIL.COM", Emailmsg)
            If YEnd Then
                Me.DialogResult = Windows.Forms.DialogResult.OK
                Me.Close()
                Exit Sub
            Else
                MsgBox(lblStatus.Text)
                btnMenuModifier.Visible = True
                If AlertMsg <> Nothing Then
                    MsgBox(AlertMsg, MsgBoxStyle.Exclamation)
                End If
                'Application.Exit()
            End If

        Catch ex As Exception
            If Not tran Is Nothing Then
                tran.Rollback()
            End If
            If cn.State = ConnectionState.Open Then
                cn.Close()
            End If
            If admincn.State = ConnectionState.Open Then admincn.Close()
            Dim errorMsg As String = "Error in " + STATUS
            errorMsg += vbCrLf + vbCrLf
            errorMsg += vbCrLf + "Message   : " + ex.Message
            errorMsg += vbCrLf + "Trace     :" + vbCrLf + ex.StackTrace
            MsgBox(errorMsg, MsgBoxStyle.Critical)
        Finally
            If cn.State = ConnectionState.Open Then
                cn.Close()
            End If
            btnInstall.Enabled = True
        End Try
    End Sub

