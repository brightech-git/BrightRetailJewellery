    Private Sub funcDump_SP_GEN_INSERT_QUERY()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_GEN_INSERT_QUERY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_GEN_INSERT_QUERY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If TagCostId = "" Or TagDumpCostId = "" Then Exit Sub
        strSql = vbCrLf + "CREATE PROCEDURE SP_GEN_INSERT_QUERY"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @TABLENAME NVARCHAR(100),"
        strSql += vbCrLf + " @WHERECLAUSE NVARCHAR(MAX) = '',"
        strSql += vbCrLf + " @ORDERBYCLAUSE NVARCHAR(MAX) = '',"
        strSql += vbCrLf + " @MASKNAME NVARCHAR(MAX) = '',"
        strSql += vbCrLf + " @MASKDBNAME NVARCHAR(MAX) = ''"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "    --DECLARE VARIABLES"
        strSql += vbCrLf + "    DECLARE @TABLEHASIDENTITY BIT"
        strSql += vbCrLf + "    DECLARE @SQL NVARCHAR(MAX)"
        strSql += vbCrLf + "    DECLARE @COLUMNLIST NVARCHAR(MAX)"
        strSql += vbCrLf + "    DECLARE @VALUELIST NVARCHAR(MAX)"
        strSql += vbCrLf + "    DECLARE @COLUMN_ID INT"
        strSql += vbCrLf + "    DECLARE @COLUMN_NAME VARCHAR(128) "
        strSql += vbCrLf + "    DECLARE @DATA_TYPE VARCHAR(128)"
        strSql += vbCrLf + "    --INITIALIZE VARIABLES"
        strSql += vbCrLf + "    SET @COLUMNLIST = ''"
        strSql += vbCrLf + "    SET @VALUELIST = ''"
        strSql += vbCrLf + "    SET @COLUMN_ID = 0"
        strSql += vbCrLf + "    SET @COLUMN_NAME = ''"
        strSql += vbCrLf + "    --CHECK IF THE TABLE HAS AN IDENTITY COLUMN"
        strSql += vbCrLf + "    SELECT @TABLEHASIDENTITY = OBJECTPROPERTY(OBJECT_ID(TABLE_NAME), 'TABLEHASIDENTITY')"
        strSql += vbCrLf + "    FROM INFORMATION_SCHEMA.TABLES"
        strSql += vbCrLf + "    WHERE TABLE_NAME = @TABLENAME"
        strSql += vbCrLf + "    --CHECK IF WE NEED 'SET IDENTITY_INSERT TABLENAME ON' STATEMENT."
        strSql += vbCrLf + "    --IF THE TABLE HAS IDENTITY COLUMN, THE IDENTITY_INSERT WILL BE SET TO ON"
        strSql += vbCrLf + "    IF @TABLEHASIDENTITY = 1"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        SET @SQL = 'SELECT TOP 1 ''SET IDENTITY_INSERT ' + @TABLENAME + ' ON '' FROM ' + @TABLENAME"
        strSql += vbCrLf + "        EXEC SP_EXECUTESQL @SQL"
        strSql += vbCrLf + "    End"
        strSql += vbCrLf + "    --PREPARE LIST OF COLUMNS AND VALUES"
        strSql += vbCrLf + "    --TO GET THE FIRST COLUMN'S ID"
        strSql += vbCrLf + "    SELECT	@COLUMN_ID = MIN(ORDINAL_POSITION) 	"
        strSql += vbCrLf + "    FROM INFORMATION_SCHEMA.COLUMNS(NOLOCK)"
        strSql += vbCrLf + "    WHERE 	TABLE_NAME = @TABLENAME"
        strSql += vbCrLf + "    --LOOP THROUGH ALL THE COLUMNS OF THE TABLE, TO GET THE COLUMN NAMES AND THEIR DATA TYPES"
        strSql += vbCrLf + "    WHILE @COLUMN_ID IS NOT NULL"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        SELECT 	@COLUMN_NAME = QUOTENAME(COLUMN_NAME), "
        strSql += vbCrLf + "        @DATA_TYPE = DATA_TYPE "
        strSql += vbCrLf + "        FROM INFORMATION_SCHEMA.COLUMNS(NOLOCK)"
        strSql += vbCrLf + "        WHERE 	ORDINAL_POSITION = @COLUMN_ID AND "
        strSql += vbCrLf + "        TABLE_NAME = @TABLENAME "
        strSql += vbCrLf + "        --DETERMINING THE DATA TYPE OF THE COLUMN AND DEPENDING ON THE DATA TYPE, "
        strSql += vbCrLf + "        --THE VALUES PART OF THE INSERT STATEMENT IS GENERATED."
        strSql += vbCrLf + "        SET @VALUELIST = @VALUELIST  +"
        strSql += vbCrLf + "        CASE "
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('CHAR','VARCHAR','NCHAR','NVARCHAR') "
        strSql += vbCrLf + "        THEN "
        strSql += vbCrLf + "        'COALESCE('''''''' + REPLACE(RTRIM(' + @COLUMN_NAME + '),'''''''','''''''''''')+'''''''',''NULL'')'"
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('DATETIME','SMALLDATETIME') "
        strSql += vbCrLf + "        THEN "
        strSql += vbCrLf + "        'COALESCE('''''''' + RTRIM(CONVERT(CHAR,' + @COLUMN_NAME + ',106))+'''''''',''NULL'')'"
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('UNIQUEIDENTIFIER') "
        strSql += vbCrLf + "        THEN  "
        strSql += vbCrLf + "        'COALESCE('''''''' + REPLACE(CONVERT(CHAR(255),RTRIM(' + @COLUMN_NAME + ')),'''''''','''''''''''')+'''''''',''NULL'')'"
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('TEXT','NTEXT') "
        strSql += vbCrLf + "        THEN  "
        strSql += vbCrLf + "        'COALESCE('''''''' + REPLACE(CONVERT(CHAR(8000),' + @COLUMN_NAME + '),'''''''','''''''''''')+'''''''',''NULL'')'					"
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('BINARY','VARBINARY') "
        strSql += vbCrLf + "        THEN  "
        strSql += vbCrLf + "        'COALESCE(RTRIM(CONVERT(CHAR,' + 'CONVERT(INT,' + @COLUMN_NAME + '))),''NULL'')'  "
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('TIMESTAMP','ROWVERSION') "
        strSql += vbCrLf + "        THEN  "
        strSql += vbCrLf + "        'COALESCE(RTRIM(CONVERT(CHAR,' + 'CONVERT(INT,' + @COLUMN_NAME + '))),''NULL'')' "
        strSql += vbCrLf + "        WHEN @DATA_TYPE IN ('FLOAT','REAL','MONEY','SMALLMONEY')"
        strSql += vbCrLf + "        THEN"
        strSql += vbCrLf + "        'COALESCE(LTRIM(RTRIM(' + 'CONVERT(CHAR, ' +  @COLUMN_NAME  + ',2)' + ')),''NULL'')' "
        strSql += vbCrLf + "        ELSE "
        strSql += vbCrLf + "        'COALESCE(LTRIM(RTRIM(' + 'CONVERT(CHAR, ' +  @COLUMN_NAME  + ')' + ')),''NULL'')' "
        strSql += vbCrLf + "        END   + '+' +  ''',''' + ' + '"
        strSql += vbCrLf + "        --GENERATING THE COLUMN LIST FOR THE INSERT STATEMENT"
        strSql += vbCrLf + "        SET @COLUMNLIST = @COLUMNLIST +  @COLUMN_NAME + ','	"
        strSql += vbCrLf + "        SELECT 	@COLUMN_ID = MIN(ORDINAL_POSITION) "
        strSql += vbCrLf + "        FROM INFORMATION_SCHEMA.COLUMNS(NOLOCK)"
        strSql += vbCrLf + "        WHERE 	TABLE_NAME = @TABLENAME AND "
        strSql += vbCrLf + "        ORDINAL_POSITION > @COLUMN_ID"
        strSql += vbCrLf + "    End"
        strSql += vbCrLf + "    --END OF LOOP"
        strSql += vbCrLf + "    --REMOVE EXTRA CHARACTERS THAT GOT CONCATENATED DURING THE LAST RUN THROUGH THE LOOP"
        strSql += vbCrLf + "    SET @COLUMNLIST = LEFT(@COLUMNLIST,LEN(@COLUMNLIST) - 1)"
        strSql += vbCrLf + "    SET @VALUELIST = LEFT(@VALUELIST,LEN(@VALUELIST) - 6)"
        strSql += vbCrLf + "    --BUILD THE SQL STATEMENT"
        strSql += vbCrLf + "    IF LEN(@MASKNAME) > 0 AND  LEN(@MASKDBNAME) > 0"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "		SET @SQL = 'SELECT ''INSERT INTO ' + @MASKDBNAME + '..' + @MASKNAME + ' (' + @COLUMNLIST + ') ' + "
        strSql += vbCrLf + "		'VALUES (''+' + @VALUELIST + '+'')'' FROM ' + @TABLENAME"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SET @SQL = 'SELECT ''INSERT INTO [' + @TABLENAME + '] (' + @COLUMNLIST + ') ' + "
        strSql += vbCrLf + "		'VALUES (''+' + @VALUELIST + '+'')'' FROM ' + @TABLENAME"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "    --APPLY FILTER (WHERE CLAUSE) AND SORTING (ORDER BY CLAUSE) IF REQUIRED"
        strSql += vbCrLf + "    IF LEN(@WHERECLAUSE) > 0"
        strSql += vbCrLf + "    SET @SQL = @SQL + ' WHERE ' + @WHERECLAUSE"
        strSql += vbCrLf + "    IF LEN(@ORDERBYCLAUSE) > 0"
        strSql += vbCrLf + "    SET @SQL= @SQL + ' ORDER BY ' + @ORDERBYCLAUSE"
        strSql += vbCrLf + "    --EXECUTE SQL STATEMENT TO PRINT INSERT STATEMENTS"
        strSql += vbCrLf + "    --PRINT @SQL"
        strSql += vbCrLf + "    EXEC SP_EXECUTESQL @SQL"
        strSql += vbCrLf + "    --SET IDENTITY_INSERT OFF IF IT IS SET ON ABOVE"
        strSql += vbCrLf + "    IF @TABLEHASIDENTITY = 1"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        SET @SQL = 'SELECT TOP 1 ''SET IDENTITY_INSERT ' + @TABLENAME + ' OFF '' FROM ' + @TABLENAME"
        strSql += vbCrLf + "        EXEC SP_EXECUTESQL @SQL"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
