        strSql += vbCrLf + "   RESULT, COLHEAD"
        strSql += vbCrLf + "   UPDATE #DESIGNSTKORDER SET DIFFPCS =STKPCS-REORDPCS,DIFFRT = STKRT-REORDRT"
