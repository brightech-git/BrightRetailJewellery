        strSql += vbCrLf + "   DECLARE @QUERY NVARCHAR(4000)"
        strSql += vbCrLf + "   DECLARE @DISCARRAYLENGTH AS INT,@COLNAME AS VARCHAR(50),@STRLEN AS INT,@COLLEN AS INT,@DISCARRAY VARCHAR(1000) "
        strSql += vbCrLf + "   DECLARE @DEFFINDISC VARCHAR(20)"
