    Private Sub Sp_RPT_AGEWISE_OUTSTANDING_22_JULY_2022()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_AGEWISE_OUTSTANDING')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_AGEWISE_OUTSTANDING"
