#Region "Admindb Alert Trigerrs for Sms"
    Function funcCheckTriggerStatus(ByVal TrigName As String) As Boolean
        Dim TrigDisable As Integer = 1
        strSql = "SELECT ISNULL(OBJECTPROPERTY(OBJECT_ID('" & TrigName & "'),'EXECISTRIGGERDISABLED'),1)"
        TrigDisable = GetSqlValue(strSql, 1, tran)
        Return IIf(TrigDisable = 1, True, False)
    End Function
    Private Sub funcTriggerDisable(ByVal TableName As String, ByVal TrigName As String)
        strSql = "ALTER TABLE " & TableName & " DISABLE TRIGGER " & TrigName
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub funcTriggerEnable(ByVal TableName As String, ByVal TrigName As String)
        strSql = "ALTER TABLE " & TableName & " ENABLE TRIGGER " & TrigName
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub AdmindbTriggerforAlertSms()
        Dim TrigDisable As Boolean = True

        TrigDisable = funcCheckTriggerStatus("CUSTOMERSALES_REGD_SMS_TRG")
        CUSTOMERSALES_REGD_SMS_TRG()
        If TrigDisable Then funcTriggerDisable("CUSTOMERINFO", "CUSTOMERSALES_REGD_SMS_TRG")

        TrigDisable = funcCheckTriggerStatus("ITEMMAST_CHANGE_SMS_TRG")
        ITEMMAST_SMS_TRG()
