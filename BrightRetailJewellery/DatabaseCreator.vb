        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'TAGCOSTID'"
        TagCostId = GetSqlValue(strSql, "", tran)

        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'TAGDUMPCOSTID'"
        TagDumpCostId = GetSqlValue(strSql, "", tran)

        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'TAGISSCOSTID'"
        TagIssCostId = GetSqlValue(strSql, "", tran)

        strSql = "SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'MIAUTOPOST'"
        MIAUTOPOST = GetSqlValue(strSql, "", tran)
    End Sub

