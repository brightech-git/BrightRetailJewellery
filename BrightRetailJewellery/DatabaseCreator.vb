        strSql += vbCrLf + "  		/******************* ORDER ADJUSTED ****************/      "
        strSql += vbCrLf + "  		SELECT @QRY= '"
        strSql += vbCrLf + "  		IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ORDADJUSTED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDADJUSTED "
