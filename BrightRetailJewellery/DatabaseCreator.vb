        strSql += vbCrLf + "  				EXEC(@QRY)"
        strSql += vbCrLf + "  			END	"
        strSql += vbCrLf + "  			ELSE IF @TYPE ='C'"
        strSql += vbCrLf + "              BEGIN"
        strSql += vbCrLf + "  				CREATE TABLE TEMPTABLEDB..SA_COMM_CATEGORY(CATGROUP VARCHAR(50),COMM_BASTYPE  VARCHAR(50),COMM_BAS NUMERIC(15,2),COMM_AMTTYPE  VARCHAR(50),COMM_AMT NUMERIC(15,2))    "
        strSql += vbCrLf + "  				SELECT @QRY = ' INSERT INTO TEMPTABLEDB..SA_COMM_CATEGORY(CATGROUP,COMM_BASTYPE,COMM_BAS,COMM_AMTTYPE,COMM_AMT) SELECT CATGROUP,COMM_BASTYPE,COMM_BAS,COMM_AMTTYPE,COMM_AMT FROM ' + @COMM_TBLNAME    "
        strSql += vbCrLf + "  				EXEC(@QRY)    "
        strSql += vbCrLf + "  				SELECT @QRY = ' SELECT ''SA'' SEP,E.EMPID,E.EMPNAME,CG.CGROUPNAME AS METALNAME,I.PCS,I.NETWT,I.AMOUNT,I.TRANDATE'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' ,CO.COMM_BASTYPE,CO.COMM_BAS,CO.COMM_AMTTYPE,CO.COMM_AMT,C.COSTNAME INTO TEMPTABLEDB..SA_COMMISION'"
        strSql += vbCrLf + "  				SELECT @QRY = @QRY + ' FROM ISSUE AS I INNER JOIN '+@DBNAME+'..ITEMMAST AS IM ON IM.ITEMID = I.ITEMID'"
