        strSql += vbCrLf + " 		IF @NEEDBILLPREFIX='Y' "
        strSql += vbCrLf + "  		BEGIN "
        strSql += vbCrLf + " 			SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,2),RATE) RATE '"
