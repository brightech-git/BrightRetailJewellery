        strSql += vbCrLf + "    ELSE "
        strSql += vbCrLf + "    	BEGIN  "
        strSql += vbCrLf + "    	IF CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "    	BEGIN    "
        strSql += vbCrLf + "    		INSERT INTO TEMPTABLEDB..METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME)    "
        strSql += vbCrLf + "    	END    "
        strSql += vbCrLf + "    	WHILE CHARINDEX(',',@METALNAME)>0    "
        strSql += vbCrLf + "    	BEGIN    "
        strSql += vbCrLf + "    		SET @TMETAL=LEFT(@METALNAME,CHARINDEX(',',@METALNAME)-1)    "
        strSql += vbCrLf + "    		SET @METALNAME=RIGHT(@METALNAME,LEN(@METALNAME)-CHARINDEX(',',@METALNAME))    "
        strSql += vbCrLf + "    		IF @METALNAME <>'' AND CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "    		BEGIN    "
        strSql += vbCrLf + "    			SET @METALNAME= @METALNAME + ','    "
        strSql += vbCrLf + "    		END    "
        strSql += vbCrLf + "    		INSERT INTO TEMPTABLEDB..METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @TMETAL)    "
        strSql += vbCrLf + "    	END  "
        strSql += vbCrLf + "    END  "
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPTABLEDB..COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..COSTCENTRE"
        strSql += vbCrLf + "    CREATE TABLE TEMPTABLEDB..COSTCENTRE (COSTID VARCHAR(3))    "

        strSql += vbCrLf + "    IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE) > 0    "
        strSql += vbCrLf + "    BEGIN    "
        strSql += vbCrLf + "    	DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + "    	IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "    	BEGIN"
        strSql += vbCrLf + "    		INSERT INTO TEMPTABLEDB..COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME)    "
        strSql += vbCrLf + "    	END"
        strSql += vbCrLf + "    	WHILE CHARINDEX(',',@COSTNAME)>0"
