        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "  	SELECT @QRY=' IF OBJECT_ID(''TEMPTABLEDB..TEMPORIRDET'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPORIRDET'"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)"
        strSql += vbCrLf + "  	SELECT @QRY=' SELECT'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' O.ORNO,O.ORDATE,O.DUEDATE,I.ITEMNAME'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT ORDSTATE_NAME FROM ORDERSTATUS WHERE ORDSTATE_ID IN'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 ORDSTATE_ID FROM ORIRDETAIL WHERE ORNO=O.ORNO AND ISNULL(CANCEL,'''')='''' ORDER BY ENTRYORDER DESC))ORDSTATE_NAME'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' INTO TEMPTABLEDB..TEMPORIRDET'"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' FROM ORMAST AS O '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' INNER JOIN ITEMMAST AS I ON O.ITEMID=I.ITEMID'"
