        strSql += vbCrLf + "	SET @CATNAME= @CATNAME + ','"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TEMPCATEGORY (CATCODE) SELECT CATCODE FROM " & cnAdminDb & "..CATEGORY WHERE CATNAME = @TEMP"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	/** GETTTING VALUES FROM ORIGINAL TABLE **/"
        strSql += vbCrLf + "	SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPPURVATRPT'',''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPURVATRPT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' SELECT TRANNO,TRANDATE,REFNO,REFDATE,DESCRIPT,PCS,GRSWT,NETWT,AMOUNT,TAX,CTAX,AMOUNT+TAX+CTAX AS TOTAL,MMONTHNAME,MMONTHID,CATNAME,ACNAME,TIN,CENTRALTAXNO,CONVERT(VARCHAR(15),SNO)SNO,COSTID,GROUP1,GROUP2,ACCODE,CANCEL,ADDRESS,TYPE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' INTO TEMPTABLEDB..TEMPPURVATRPT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' FROM(SELECT DISTINCT R.TRANNO,R.TRANDATE,R.REFNO,R.REFDATE,R.REMARK1 DESCRIPT,R.PCS,R.GRSWT,R.NETWT,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' /** Includes Amount + Tax as Amount for outstation Customers**/'"
