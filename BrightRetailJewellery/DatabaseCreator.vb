        strSql = " CREATE PROCEDURE SP_RPT_AGEWISE_OUTSTANDING"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + "   @ASONDATE SMALLDATETIME"
        strSql += vbCrLf + "   ,@ORDERBY VARCHAR(1)"
