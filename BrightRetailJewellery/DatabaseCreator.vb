        strSql += vbCrLf + "          ELSE  "
        strSql += vbCrLf + "           SET @QRY='INSERT INTO TEMPTABLEDB..TEMP_OUT_COSTCENTRE'+@SYSID+' SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = '''+@COSTNAME+''''  "
        strSql += vbCrLf + "          PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..OUT_COMPANY'+@SYSID+''', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..OUT_COMPANY'+@SYSID+''  "
        strSql += vbCrLf + "          SET @QRY = @QRY +' CREATE TABLE TEMPTABLEDB..OUT_COMPANY'+@SYSID+' (COMPANYID VARCHAR(3))'  "
        strSql += vbCrLf + "          PRINT @QRY   "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          DECLARE @TCOMPANY VARCHAR(50)  "
        strSql += vbCrLf + "          IF CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + "          SET @QRY='INSERT INTO TEMPTABLEDB..OUT_COMPANY'+@SYSID+'(COMPANYID) SELECT '''+@COMPANYID+''''  "
        strSql += vbCrLf + "          PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          WHILE CHARINDEX(',',@COMPANYID)>0  "
