        strSql = " INSERT INTO " & compId + suffix & "..COMPANY"
        strSql += vbCrLf + "  (COMPANYID,COMPANYNAME,ADDRESS1,ADDRESS2,ADDRESS3,ADDRESS4,PHONE,"
        strSql += vbCrLf + "  EMAIL,LOCALTAXNO,CSTNO,TINNO,PANNO,TDSNO,DISPLAYORDER,AUTOGENERATOR)"
        strSql += vbCrLf + "  VALUES"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  '" & compId & "','" & CompName & "','" & Address1 & "'"
        strSql += vbCrLf + "  ,'" & Address2 & "','" & Address3 & "','" & Address4 & "','" & Phone & "'"
        strSql += vbCrLf + "  ,'" & Email & "','" & LocalTaxNo & "','" & CSTNo & "','" & TINNo & "'"
        strSql += vbCrLf + "  ,'" & PANNo & "','" & TDSNo & "',1,'A'"
        strSql += vbCrLf + "  )"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub AuditTableCreation(ByVal DbName As String, ByVal xDbType As String)
        Dim AuditDbName As String = UCase(compId) & "AUDITLOG"
        If DbChecker(AuditDbName) = 0 Then
            ''Create db
            STATUS = "Create Database " & AuditDbName
            funcProgressStep()
            CreateDb(AuditDbName)
            funcProgressStep(1)
        End If
        strSql = vbCrLf + " SELECT NAME FROM " & DbName & "..SYSOBJECTS "
        strSql += vbCrLf + " WHERE XTYPE = 'U' AND NAME IN (SELECT TABLENAME FROM " & compId & "ADMINDB..AV_TABLES)"
        Dim DtTables As New DataTable
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(DtTables)
        Dim TblName As String
        Dim OrgTblName As String
        For Each Ro As DataRow In DtTables.Rows
            OrgTblName = Ro.Item("NAME").ToString
            TblName = "AUDIT_" & xDbType & "_" & Ro.Item("NAME").ToString
            If xDbType = "A" Then
                If ListAdminTables.Contains(Ro.Item("NAME").ToString) = False Then
                    Continue For
                End If
                If AuditAdminRestTbl.Contains(Ro.Item("NAME").ToString) Then
                    Continue For
                End If
            End If
            If xDbType = "T" Then
                If ListTranTables.Contains(Ro.Item("NAME").ToString) = False Then
                    Continue For
                End If
                If AuditTranRestTbl.Contains(Ro.Item("NAME").ToString) Then
                    Continue For
                End If
            End If
            STATUS = "Create Table " & AuditDbName & "\" & TblName
            funcProgressStep()
            strSql = " IF NOT(SELECT COUNT(*) FROM " & AuditDbName & "..SYSOBJECTS WHERE XTYPE = 'U' AND NAME = '" & TblName & "')>0"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + " SELECT * INTO " & AuditDbName & ".." & TblName & " FROM " & DbName & ".." & Ro.Item("NAME").ToString & " WHERE 1<>1"
            strSql += vbCrLf + " END"
            cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
            strSql = " IF NOT(SELECT COUNT(*) FROM " & AuditDbName & "..SYSCOLUMNS WHERE NAME = 'AUDIT_MODE' AND ID = OBJECT_ID('" & AuditDbName & ".." & TblName & "'))>0"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + " ALTER TABLE " & AuditDbName & ".." & TblName & " ADD AUDIT_MODE VARCHAR(1)"
            strSql += vbCrLf + " END"
            cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
            strSql = " IF NOT(SELECT COUNT(*) FROM " & AuditDbName & "..SYSCOLUMNS WHERE NAME = 'AUDIT_ORD' AND ID = OBJECT_ID('" & AuditDbName & ".." & TblName & "'))>0"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + " ALTER TABLE " & AuditDbName & ".." & TblName & " ADD AUDIT_ORD INT"
            strSql += vbCrLf + " END"
            cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
            strSql = " IF NOT(SELECT COUNT(*) FROM " & AuditDbName & "..SYSCOLUMNS WHERE NAME = 'UPDATED' AND ID = OBJECT_ID('" & AuditDbName & ".." & TblName & "'))>0"
            strSql += vbCrLf + " BEGIN"
            strSql += vbCrLf + " ALTER TABLE " & AuditDbName & ".." & TblName & " ADD UPDATED SMALLDATETIME"
            strSql += vbCrLf + " END"
            cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()

            ''CHECKING EXTRA COLUMNS IN ORIGINAL TABLE AND ADDING IN AUDITLOG TABLE
            strSql = vbCrLf + "  DECLARE @QRY VARCHAR(8000)"
            strSql += vbCrLf + "  DECLARE @DBNAME VARCHAR(20)"
            strSql += vbCrLf + "  SET @DBNAME = '" & AuditDbName & "'"
            strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#DUPDB_COLINFO') IS NOT NULL DROP TABLE #DUPDB_COLINFO"
            strSql += vbCrLf + "  SELECT "
            strSql += vbCrLf + "  OB.NAME AS TBLNAME,CO.NAME AS COLNAME,ST.NAME AS DATATYPE,CO.LENGTH,CO.XPREC,CO.XSCALE,CO.ISNULLABLE"
            strSql += vbCrLf + "  ,CO.NAME + ' ' + ST.NAME + "
            strSql += vbCrLf + "  CASE WHEN ST.NAME = 'VARCHAR' THEN '(' + CONVERT(VARCHAR,CO.LENGTH) + ') '"
            strSql += vbCrLf + "  WHEN ST.NAME = 'NUMERIC' THEN '(' + CONVERT(VARCHAR,CO.XPREC) + ',' + CONVERT(VARCHAR,CO.XSCALE) + ') '"
            strSql += vbCrLf + "  ELSE '' END "
            strSql += vbCrLf + "  AS COLTYPE"
            strSql += vbCrLf + "  --,CO.* "
            strSql += vbCrLf + "  INTO #DUPDB_COLINFO"
            strSql += vbCrLf + "  FROM " & DbName & " ..SYSCOLUMNS CO"
            strSql += vbCrLf + "  INNER JOIN " & DbName & " ..SYSOBJECTS AS OB ON OB.ID = CO.ID AND OB.XTYPE = 'U' AND OB.NAME = '" & OrgTblName & "'"
            strSql += vbCrLf + "  INNER JOIN " & DbName & " ..SYSTYPES AS ST ON ST.XUSERTYPE = CO.XUSERTYPE"
            strSql += vbCrLf + "  "
            strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#DB_COLINFO') IS NOT NULL DROP TABLE #DB_COLINFO"
            strSql += vbCrLf + "  SELECT "
            strSql += vbCrLf + "  OB.NAME AS TBLNAME,CO.NAME AS COLNAME,ST.NAME AS DATATYPE,CO.LENGTH,CO.XPREC,CO.XSCALE,CO.ISNULLABLE"
            strSql += vbCrLf + "  ,CO.NAME + ' ' + ST.NAME + "
            strSql += vbCrLf + "  CASE WHEN ST.NAME = 'VARCHAR' THEN '(' + CONVERT(VARCHAR,CO.LENGTH) + ') '"
            strSql += vbCrLf + "  WHEN ST.NAME = 'NUMERIC' THEN '(' + CONVERT(VARCHAR,CO.XPREC) + ',' + CONVERT(VARCHAR,CO.XSCALE) + ') '"
            strSql += vbCrLf + "  ELSE '' END "
            strSql += vbCrLf + "  AS COLTYPE"
            strSql += vbCrLf + "  --,CO.* "
            strSql += vbCrLf + "  INTO #DB_COLINFO"
            strSql += vbCrLf + "  FROM " & AuditDbName & "..SYSCOLUMNS CO"
            strSql += vbCrLf + "  INNER JOIN " & AuditDbName & "..SYSOBJECTS AS OB ON OB.ID = CO.ID AND OB.XTYPE = 'U' AND OB.NAME = '" & TblName & "'"
            strSql += vbCrLf + "  INNER JOIN " & AuditDbName & "..SYSTYPES AS ST ON ST.XUSERTYPE = CO.XUSERTYPE"
            strSql += vbCrLf + "  "
            strSql += vbCrLf + "  /** ADDING NEW COLUMNS **/"
            strSql += vbCrLf + "  DECLARE CUR CURSOR"
            strSql += vbCrLf + "  FOR SELECT 'ALTER TABLE '+@DBNAME +'.." & TblName & " ADD '+COLTYPE+'' FROM #DUPDB_COLINFO AS X"
            strSql += vbCrLf + "  WHERE NOT EXISTS (SELECT 1 FROM #DB_COLINFO WHERE REPLACE(TBLNAME,'" & Mid(TblName, 1, 8) & "','') = X.TBLNAME AND COLNAME = X.COLNAME)"
            strSql += vbCrLf + "  OPEN CUR"
            strSql += vbCrLf + "  WHILE 1=1"
            strSql += vbCrLf + "  	BEGIN"
            strSql += vbCrLf + "  	FETCH NEXT FROM CUR INTO @QRY"
            strSql += vbCrLf + "  	IF @@FETCH_STATUS = -1 BREAK"
            strSql += vbCrLf + "  	EXEC (@QRY)"
            strSql += vbCrLf + "  	END"
            strSql += vbCrLf + "  CLOSE CUR"
            strSql += vbCrLf + "  DEALLOCATE CUR"
            strSql += vbCrLf + "  "
            strSql += vbCrLf + "  /** ALTER COLUMN **/"
            strSql += vbCrLf + "  DECLARE CUR CURSOR"
            strSql += vbCrLf + "  FOR SELECT 'ALTER TABLE '+@DBNAME +'.." & TblName & " ALTER COLUMN '+COLTYPE+'' FROM #DUPDB_COLINFO AS X"
            strSql += vbCrLf + "  WHERE NOT EXISTS (SELECT 1 FROM #DB_COLINFO WHERE COLTYPE = X.COLTYPE)"
            strSql += vbCrLf + "  OPEN CUR"
            strSql += vbCrLf + "  WHILE 1=1"
            strSql += vbCrLf + "  	BEGIN"
            strSql += vbCrLf + "  	FETCH NEXT FROM CUR INTO @QRY"
            strSql += vbCrLf + "  	IF @@FETCH_STATUS = -1 BREAK"
            strSql += vbCrLf + "  	EXEC (@QRY)"
            strSql += vbCrLf + "  	END"
            strSql += vbCrLf + "  CLOSE CUR"
            strSql += vbCrLf + "  DEALLOCATE CUR"
            cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
        Next

    End Sub

    Private Sub AuditTriggerDrop()
        strSql = " SELECT 'DROP TRIGGER ' + NAME AS QRY FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME LIKE 'TRIG_%' AND (NAME LIKE '%AUDIT_4UPD' OR NAME LIKE '%AUDIT_4DEL')"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        Dim DtTriggers As New DataTable
        da.Fill(DtTriggers)
        For Each Ro As DataRow In DtTriggers.Rows
            cmd = New OleDbCommand(Ro.Item("QRY").ToString, cn, tran) : cmd.ExecuteNonQuery()
        Next
    End Sub

    Private Sub SyncTriggerCreation(ByVal Dbname As String)
        If dbType = "W" Then
            cn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & Dbname & ";Data Source=" & serverName & "")
        Else
            cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & Dbname & ";Data Source=" & serverName & ";password=" & pwd)
        End If
        cn.Open()

        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'RECEIVESYNC_DATEUPD_TRG')>0"
        strSql += vbCrLf + "  DROP TRIGGER RECEIVESYNC_DATEUPD_TRG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "   CREATE TRIGGER [DBO].[RECEIVESYNC_DATEUPD_TRG] ON [RECEIVESYNC] "
        strSql += vbCrLf + "   AFTER INSERT AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "       IF EXISTS ( SELECT * FROM INSERTED WHERE UPDATED IS NULL)"
        strSql += vbCrLf + "       BEGIN"
        strSql += vbCrLf + "         UPDATE B SET B.UPDATED = GETDATE() FROM INSERTED INS, RECEIVESYNC  B WHERE B.UID = INS.UID"
        strSql += vbCrLf + "       END"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        funcProgressStep(1)


        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'SENDSYNC_DATEUPD_TRG')>0"
        strSql += vbCrLf + "  DROP TRIGGER SENDSYNC_DATEUPD_TRG"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "   CREATE TRIGGER [DBO].[SENDSYNC_DATEUPD_TRG] ON [SENDSYNC] "
        strSql += vbCrLf + "   AFTER INSERT AS"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "       IF EXISTS ( SELECT * FROM INSERTED WHERE UPDATED IS NULL)"
        strSql += vbCrLf + "       BEGIN"
        strSql += vbCrLf + "         UPDATE B SET B.UPDATED = GETDATE() FROM INSERTED INS, SENDSYNC  B WHERE B.UID = INS.UID"
        strSql += vbCrLf + "       END"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        funcProgressStep(1)

        CreateIndex(Dbname)
        cn.Close()
    End Sub
    Private Sub AuditTriggerCreation(ByVal DbName As String, ByVal xdbType As String)
        Dim auditcn As New OleDbConnection
        Dim AuditDbName As String = UCase(compId) & "AUDITLOG"
        If dbType = "W" Then
            cn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & DbName & ";Data Source=" & serverName & "")
            auditcn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & AuditDbName & ";Data Source=" & serverName & "")
        Else
            cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & DbName & ";Data Source=" & serverName & ";password=" & pwd)
            auditcn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & AuditDbName & ";Data Source=" & serverName & ";password=" & pwd)
        End If
        cn.Open()
        auditcn.Open()
        strSql = " SELECT NAME FROM SYSOBJECTS WHERE XTYPE = 'U'"
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        da = New OleDbDataAdapter(cmd)
        Dim DtTables As New DataTable
        da.Fill(DtTables)
        Dim TblName As String = Nothing
        Dim ColNames As String = Nothing
        For Each Ro As DataRow In DtTables.Rows
            TblName = Ro.Item("NAME").ToString.ToUpper()
            If xdbType = "A" Then
                If ListAdminTables.Contains(Ro.Item("NAME").ToString) = False Then
                    Continue For
                End If
                If AuditAdminRestTbl.Contains(Ro.Item("NAME").ToString) Then
                    Continue For
                End If
            End If
            If xdbType = "T" Then
                If ListTranTables.Contains(Ro.Item("NAME").ToString) = False Then
                    Continue For
                End If
                If AuditTranRestTbl.Contains(Ro.Item("NAME").ToString) Then
                    Continue For
                End If
            End If
            strSql = " SELECT NAME FROM " & DbName & "..SYSCOLUMNS WHERE ID = OBJECT_ID('" & DbName & ".." & TblName & "') "
            strSql += vbCrLf + " AND XUSERTYPE <> 34 AND COLSTAT<>1/** PREVENT IMAGE DATATYPE **/"
            strSql += " ORDER BY COLID"
            Dim DtColNames As New DataTable
            da = New OleDbDataAdapter(strSql, cn)
            da.Fill(DtColNames)
            ColNames = ""
            For Each RoCol As DataRow In DtColNames.Rows
                ColNames += "[" + RoCol.Item("NAME").ToString + "]" & ","
            Next
            ColNames = Mid(ColNames, 1, ColNames.Length - 1)
            strSql = " IF OBJECT_ID('TRIG_" & TblName & "_INSINTOAUDIT_4UPD','TR') IS NOT NULL DROP TRIGGER TRIG_" & TblName & "_INSINTOAUDIT_4UPD"
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()
            strSql = " CREATE TRIGGER TRIG_" & TblName & "_INSINTOAUDIT_4UPD ON " & TblName & " FOR UPDATE"
            strSql += " AS"
            strSql += " IF @@ROWCOUNT = 0 GOTO END_TRIG"
            strSql += " IF APP_NAME() =  'AkshayaNetDbCreator' GOTO END_TRIG"
            strSql += " IF APP_NAME() =  'AkshayaRetailJewellery' GOTO END_TRIG"
            strSql += " SET NOCOUNT ON"
            strSql += " SET XACT_ABORT ON"
            strSql += " DECLARE @AUDIT_ORD INT"
            strSql += " SELECT @AUDIT_ORD = ISNULL(COUNT(*),0)+1 FROM " & compId & "AUDITLOG..AUDIT_" & xdbType & "_" & TblName & ""
            strSql += " INSERT INTO " & compId & "AUDITLOG..AUDIT_" & xdbType & "_" & TblName
            strSql += " ("
            strSql += ColNames & ",AUDIT_MODE,AUDIT_ORD"
            strSql += " )"
            strSql += " SELECT "
            strSql += ColNames & ",'U' AS AUDIT_MODE,@AUDIT_ORD AS AUDIT_ORD"
            strSql += " FROM DELETED"
            strSql += " END_TRIG:"
            strSql += " "
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()
            strSql = " IF OBJECT_ID('TRIG_" & TblName & "_INSINTOAUDIT_4DEL','TR') IS NOT NULL DROP TRIGGER TRIG_" & TblName & "_INSINTOAUDIT_4DEL"
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()
            strSql = " CREATE TRIGGER TRIG_" & TblName & "_INSINTOAUDIT_4DEL ON " & TblName & " FOR DELETE"
            strSql += " AS"
            strSql += " IF @@ROWCOUNT = 0 GOTO END_TRIG"
            strSql += " IF APP_NAME() =  'AkshayaNetDbCreator' GOTO END_TRIG"
            strSql += " IF APP_NAME() =  'AkshayaRetailJewellery' GOTO END_TRIG"
            strSql += " SET NOCOUNT ON"
            strSql += " SET XACT_ABORT ON"
            strSql += " DECLARE @AUDIT_ORD INT"
            strSql += " SELECT @AUDIT_ORD = ISNULL(COUNT(*),0)+1 FROM " & compId & "AUDITLOG..AUDIT_" & xdbType & "_" & TblName & ""
            strSql += " INSERT INTO " & compId & "AUDITLOG..AUDIT_" & xdbType & "_" & TblName
            strSql += " ("
            strSql += ColNames & ",AUDIT_MODE,AUDIT_ORD"
            strSql += " )"
            strSql += " SELECT "
            strSql += ColNames & ",'D' AS AUDIT_MODE,@AUDIT_ORD AS AUDIT_ORD"
            strSql += " FROM DELETED"
            strSql += " END_TRIG:"
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()

            strSql = " IF OBJECT_ID('TRIG_AUDIT_" & xdbType & "_" & TblName & "_DATEUPD','TR') IS NOT NULL DROP TRIGGER TRIG_AUDIT_" & xdbType & "_" & TblName & "_DATEUPD"
            cmd = New OleDbCommand(strSql, auditcn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()

            strSql = " CREATE TRIGGER [TRIG_AUDIT_" & xdbType & "_" & TblName & "_DATEUPD] ON [AUDIT_" & xdbType & "_" & TblName & "] "
            strSql += " AFTER INSERT AS"
            strSql += " BEGIN "
            'strSql += " IF EXISTS ( SELECT * FROM INSERTED WHERE UPDATED IS NULL)"
            'strSql += " BEGIN "
            strSql += " UPDATE B SET B.UPDATED = CONVERT(VARCHAR(14),GETDATE(),111) FROM INSERTED INS,AUDIT_" & xdbType & "_" & TblName & "  B WHERE B.AUDIT_ORD = INS.AUDIT_ORD"
            'strSql += " End"
            strSql += " End"
            cmd = New OleDbCommand(strSql, auditcn) : cmd.CommandTimeout = 1000 : cmd.ExecuteNonQuery()
        Next
        auditcn.Close()
        cn.Close()
    End Sub

#Region "WholeSale Reports"
    Private Sub Sp_RPT_WALL_LEDGER_DETAILS()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'Sp_RPT_WALL_LEDGER_DETAILS')>0"
        strSql += vbCrLf + "  DROP PROCEDURE Sp_RPT_WALL_LEDGER_DETAILS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE procedure Sp_RPT_WALL_LEDGER_DETAILS "
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@CUMULATIVE VARCHAR(1),      "
        strSql += vbCrLf + " @CUSTNAME VARCHAR(8000)      "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " as      "
        strSql += vbCrLf + " set nocount on"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @TEMP_ACNAME VARCHAR(250)      "
        strSql += vbCrLf + " -- -- DECLARE @CUSTNAME VARCHAR(8000)      "
        strSql += vbCrLf + " -- -- DECLARE @FROMDATE SMALLDATETIME      "
        strSql += vbCrLf + " -- -- DECLARE @TODATE SMALLDATETIME      "
        strSql += vbCrLf + " -- --"
        strSql += vbCrLf + " -- -- SELECT @FROMDATE  = '2010-12-02'      "
        strSql += vbCrLf + " -- -- SELECT @TODATE  = '2010-12-02'      "
        strSql += vbCrLf + " -- -- SELECT @CUSTNAME = 'JAYA PRAKASH,RAJA RATHNAM'      "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMP..TEMP_ACHEAD', 'U') IS NOT NULL DROP TABLE #TEMP_ACHEAD        "
        strSql += vbCrLf + " CREATE TABLE #TEMP_ACHEAD (ACNAME VARCHAR(250))     "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF CHARINDEX(',',@CUSTNAME)=0     "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @CUSTNAME     "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@CUSTNAME)>0     "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SET @TEMP_ACNAME=LEFT(@CUSTNAME,CHARINDEX(',',@CUSTNAME)-1)  "
        strSql += vbCrLf + " SET @CUSTNAME=RIGHT(@CUSTNAME,LEN(@CUSTNAME)-CHARINDEX(',',@CUSTNAME))"
        strSql += vbCrLf + " IF @CUSTNAME <>'' AND CHARINDEX(',',@CUSTNAME)=0     "
        strSql += vbCrLf + " SET @CUSTNAME= @CUSTNAME + ','   "
        strSql += vbCrLf + " INSERT INTO #TEMP_ACHEAD (ACNAME) SELECT @TEMP_ACNAME"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('MASTER..CUSTLEDGER') IS NOT NULL DROP TABLE MASTER..CUSTLEDGER      "
        strSql += vbCrLf + " SELECT"
        strSql += vbCrLf + " I.TRANDATE,I.TRANNO      "
        strSql += vbCrLf + " ,CASE WHEN I.TRANTYPE = 'SR' THEN 'RETURN' WHEN I.TRANTYPE = 'RRE' THEN 'RECEIPT' ELSE 'PURCHASE' END AS TRANTYPE      "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(200),CASE WHEN I.ITEMID <> 0 THEN (SELECT ITEMNAME FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = I.ITEMID)      "
        strSql += vbCrLf + " ELSE '' END) AS PARTICULAR      "
        strSql += vbCrLf + " ,I.GRSWT,I.NETWT,I.TOUCH,I.PUREWT      "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),NULL)RECWT      "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,3),NULL)ISSWT      "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)RECAMT      "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,2),NULL)ISSAMT      "
        strSql += vbCrLf + " ,BATCHNO,I.ACCODE,CONVERT(INT,1)RESULT      "
        strSql += vbCrLf + " ,CONVERT(INT,2)TRESULT      "
        strSql += vbCrLf + " ,CONVERT(VARCHAR(3),NULL) COLHEAD      "
        strSql += vbCrLf + " INTO MASTER..CUSTLEDGER      "
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS I      "
        strSql += vbCrLf + " WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANFLAG IN ('W','A') AND I.TRANTYPE NOT IN ('RAP','AR')      "
        strSql += vbCrLf + " AND I.ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACNAME IN (SELECT ACNAME FROM #TEMP_ACHEAD ))      "
        strSql += vbCrLf + " AND ISNULL(I.CANCEL,'')=''      "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT"
        strSql += vbCrLf + " I.TRANDATE,I.TRANNO      "
