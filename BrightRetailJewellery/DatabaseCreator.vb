        'strSql += vbCrLf + " SET NOCOUNT ON "
        'strSql += vbCrLf + " IF @@FETCH_STATUS = -1 BREAK "
        'strSql += vbCrLf + " SET @RAMT = ISNULL(@RAMT,0) + ISNULL(@BALAMOUNT,0) + ISNULL(@AMOUNT,0) + ISNULL(@AMOUNT1,0) "
        'strSql += vbCrLf + " SET @RWT = ISNULL(@RWT,0) + ISNULL(@BALWEIGHT,0) + ISNULL(@PUREWT,0)  + ISNULL(@PUREWT1,0)      "
        'strSql += vbCrLf + " UPDATE MASTER..TEMPTOTLEDGER SET BALWEIGHT =@RWT,BALAMOUNT = @RAMT WHERE CURRENT OF CUR "
        'strSql += vbCrLf + " END "
        'strSql += vbCrLf + " CLOSE CUR "
        'strSql += vbCrLf + " DEALLOCATE CUR    "
        'strSql += vbCrLf + " "
        'strSql += vbCrLf + " UPDATE MASTER..TEMPTOTLEDGER SET BALAMOUNT = NULL,BALWEIGHT=NULL WHERE RESULT =1    "
        'strSql += vbCrLf + " UPDATE MASTER..TEMPTOTLEDGER SET BALAMOUNT = NULL,BALWEIGHT=NULL WHERE RESULT =0  "


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_WMETALSTOCK_SUMMARY()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WMETALSTOCK_SUMMARY')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WMETALSTOCK_SUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_WMETALSTOCK_SUMMARY "
        strSql += vbCrLf + " /* THE METAL BALANCE SUMMARY CHANGED TO SP_RPT_WMETALSTOCK_SUMMARY */    "
        strSql += vbCrLf + "  @FROMDATE SMALLDATETIME"
        strSql += vbCrLf + "  ,@TODATE SMALLDATETIME "
        strSql += vbCrLf + "  ,@CATNAME AS VARCHAR(8000)   "
        strSql += vbCrLf + "  ,@WT VARCHAR(1)  "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  SET NOCOUNT ON    "
        strSql += vbCrLf + "   DECLARE @TEMP_CATNAME VARCHAR(250)      "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMP..TEMP_CATNAME', 'U') IS NOT NULL DROP TABLE #TEMP_CATNAME     "
        strSql += vbCrLf + "   CREATE TABLE #TEMP_CATNAME  (CATNAME VARCHAR(250))  "
        strSql += vbCrLf + "   IF CHARINDEX(',',@CATNAME)=0  "
        strSql += vbCrLf + "   INSERT INTO #TEMP_CATNAME (CATNAME) SELECT @CATNAME  "
        strSql += vbCrLf + "   WHILE CHARINDEX(',',@CATNAME)>0  "
        strSql += vbCrLf + "   BEGIN      "
        strSql += vbCrLf + "   SET @TEMP_CATNAME=LEFT(@CATNAME,CHARINDEX(',',@CATNAME)-1) "
        strSql += vbCrLf + "   SET @CATNAME=RIGHT(@CATNAME,LEN(@CATNAME)-CHARINDEX(',',@CATNAME))      "
        strSql += vbCrLf + "   IF @CATNAME <>'' AND CHARINDEX(',',@CATNAME)=0  "
        strSql += vbCrLf + "   SET @CATNAME= @CATNAME + ','"
        strSql += vbCrLf + "   INSERT INTO #TEMP_CATNAME (CATNAME) SELECT @TEMP_CATNAME   "
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "  --GETING  WEIGHT--  "
        strSql += vbCrLf + "  IF (SELECT COUNT(NAME) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME='TEMP_METALBALANCE') > 0 DROP TABLE MASTER..TEMP_METALBALANCE   "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  SELECT     "
        strSql += vbCrLf + "   CONVERT(VARCHAR(300),NULL) AS PARTICULAR,    "
        strSql += vbCrLf + "  (SELECT CASE WHEN ISNULL(GS11,'')='Y' THEN 'GS11' WHEN ISNULL(GS12,'')='Y' THEN 'GS12' ELSE 'OTHERS' END FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=X.CATCODE) AS TYPE,    "
        strSql += vbCrLf + "  CATCODE,CATNAME,  "
        strSql += vbCrLf + "  SUM(OPWT) AS OPWT,SUM(ISSWT)AS ISSWT,SUM(RECWT) as RECWT,             "
        strSql += vbCrLf + "  ((ISNULL(SUM(OPWT),0)+ISNULL(SUM(RECWT),0))-ISNULL(SUM(ISSWT),0)) AS CLWT,         "
        strSql += vbCrLf + "  convert(VARCHAR(2),null) as COLHEAD, convert(INT,1) as RESULT            "
        strSql += vbCrLf + "  INTO MASTER..TEMP_METALBALANCE FROM    "
        strSql += vbCrLf + "  (   "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,  "
        strSql += vbCrLf + "  CASE WHEN TRANTYPE='R' THEN    "
        strSql += vbCrLf + "  (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END)   "
        strSql += vbCrLf + "  ELSE -1 *    "
        strSql += vbCrLf + "  (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END)    "
        strSql += vbCrLf + "  END AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT     "
        strSql += vbCrLf + "  FROM " & tranDbName & "..OPENWEIGHT AS T WHERE ISNULL(STOCKTYPE,'')='C' AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME)) "
        strSql += vbCrLf + "  UNION ALL      "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,  "
        strSql += vbCrLf + "  (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END) AS OPWT,   "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT     "
        strSql += vbCrLf + "  FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')=''  AND  TRANFLAG IN ('A','W') AND               "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME)) "
        strSql += vbCrLf + "  UNION ALL   "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,  "
        strSql += vbCrLf + "  -1 * (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END) AS OPWT,   "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS ISSWT,CONVERT(NUMERIC(12,3),NULL) AS RECWT  "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'')='' AND   TRANFLAG IN ('A','W') AND  "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME)) "
        strSql += vbCrLf + "  UNION ALL   "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,  "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS OPWT,  "
        strSql += vbCrLf + "  (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END) AS ISSWT,   "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS RECWT "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ISSUE  AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND   TRANFLAG IN ('A','W') AND "
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME)) "
        strSql += vbCrLf + "  UNION ALL   "
        strSql += vbCrLf + "  SELECT CATCODE,(SELECT CATNAME FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE=T.CATCODE)AS CATNAME,  "
        strSql += vbCrLf + "  CONVERT(NUMERIC(12,3),NULL) AS OPWT,CONVERT(NUMERIC(12,3),NULL) AS ISSWT,   "
        strSql += vbCrLf + "  (CASE @WT WHEN 'P' THEN PUREWT  WHEN 'N' THEN NETWT WHEN 'G' THEN GRSWT END) AS RECWT   "
        strSql += vbCrLf + "  FROM " & tranDbName & "..RECEIPT  AS T WHERE TRANDATE BETWEEN  @FROMDATE  AND @TODATE AND ISNULL(CANCEL,'')=''  AND  TRANFLAG IN ('A','W') AND"
        strSql += vbCrLf + "  CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE CATNAME IN (SELECT CATNAME FROM #TEMP_CATNAME)) "
        strSql += vbCrLf + "  )AS X GROUP BY CATCODE,CATNAME    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "       "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_METALBALANCE(TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "  SELECT TYPE,NULL,NULL,NULL,NULL,'T',0 FROM MASTER..TEMP_METALBALANCE GROUP BY TYPE    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_METALBALANCE(PARTICULAR,TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)    "
        strSql += vbCrLf + "  SELECT 'Total',TYPE,sum(OPWT),sum(RECWT),sum(ISSWT),sum(CLWT),'S',2  FROM MASTER..TEMP_METALBALANCE GROUP BY TYPE    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "  UPDATE  MASTER..TEMP_METALBALANCE SET PARTICULAR=TYPE WHERE RESULT<>2     "
        strSql += vbCrLf + "  UPDATE  MASTER..TEMP_METALBALANCE SET PARTICULAR= CATNAME WHERE ISNULL(CATNAME,'')<>''    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "             "
        strSql += vbCrLf + "  INSERT INTO MASTER..TEMP_METALBALANCE (PARTICULAR,TYPE,OPWT,RECWT,ISSWT,CLWT,COLHEAD,RESULT)           "
        strSql += vbCrLf + "  SELECT 'Grand Total','ZZ',sum(OPWT),SUM(RECWT),SUM(ISSWT),SUM(CLWT),'G',3 FROM MASTER..TEMP_METALBALANCE  WHERE RESULT=1               "
        strSql += vbCrLf + "             "
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METALBALANCE SET OPWT=CASE WHEN OPWT=0 THEN NULL ELSE OPWT END ,           "
        strSql += vbCrLf + "  RECWT=CASE WHEN RECWT=0 THEN NULL ELSE RECWT END,           "
        strSql += vbCrLf + "  ISSWT=CASE WHEN ISSWT=0 THEN NULL ELSE ISSWT END ,           "
        strSql += vbCrLf + "  CLWT=CASE WHEN CLWT=0 THEN NULL ELSE CLWT END           "
        strSql += vbCrLf + "             "
        strSql += vbCrLf + "  SELECT PARTICULAR,OPWT,RECWT,ISSWT,CLWT,COLHEAD,'SUMMARY' AS TABLENAME FROM  MASTER..TEMP_METALBALANCE    "
        strSql += vbCrLf + "       "
        strSql += vbCrLf + "  ORDER BY  TYPE,RESULT    "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_WTRIALSUMMARY()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME = 'SP_RPT_WTRIALSUMMARY')>0"
        strSql += vbCrLf + "  DROP PROCEDURE SP_RPT_WTRIALSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE  PROCEDURE SP_RPT_WTRIALSUMMARY  @ASONDATE SMALLDATETIME,  @CURRATE NUMERIC(12,2)  ,@SUMMARY VARCHAR(1)   "
        strSql += vbCrLf + " AS     "
        strSql += vbCrLf + " SET NOCOUNT ON  "
        strSql += vbCrLf + "   DECLARE @L_SUM NUMERIC(13,3) "
        strSql += vbCrLf + "   DECLARE @R_SUM NUMERIC(13,3)    "
        strSql += vbCrLf + "   DECLARE @BALANCE NUMERIC(13,3)    "
        strSql += vbCrLf + " --DECLARE @ASONDATE SMALLDATETIME       "
        strSql += vbCrLf + " --DECLARE @CURRATE  NUMERIC(12,2)     "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + " --SELECT @ASONDATE='2010-12-31'       "
        strSql += vbCrLf + " --SELECT @CURRATE='2000'       "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + " ---TAKING CLOSING METAL BALNCE & CLOSING TOCK "
        strSql += vbCrLf + ""
        strSql += vbCrLf + ""
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_METAL_LIABILITIES_L')>0  DROP TABLE MASTER..TEMP_METAL_LIABILITIES_L      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " SELECT  CONVERT(VARCHAR(300),NULL) AS PARTICULAR,CASE TYPE WHEN 'G' THEN 'SMITH' WHEN 'D' THEN 'DEALER'"
        strSql += vbCrLf + " WHEN 'C' THEN 'CUSTOMER' ELSE 'OTHERS'  END  AS TYPE, ACNAME,SUM(CLSWT) AS CLSWT     "
        strSql += vbCrLf + " ,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD     "
        strSql += vbCrLf + " INTO MASTER..TEMP_METAL_LIABILITIES_L      "
        strSql += vbCrLf + " FROM"
        strSql += vbCrLf + " (      "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME ,      "
        strSql += vbCrLf + " CASE WHEN TRANTYPE='I' THEN -1*PUREWT  ELSE PUREWT END  AS CLSWT       "
        strSql += vbCrLf + " FROM " & tranDbName & "..OPENWEIGHT AS T    WHERE  ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='L'))     "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME ,  PUREWT  AS CLSWT"
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE <= @ASONDATE AND ISNULL(CANCEL,'')=''  AND   "
        strSql += vbCrLf + " ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='L')) "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND TRANTYPE NOT IN ('AR','RAP')      "
        strSql += vbCrLf + " UNION ALL   "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME ,-1*PUREWT   AS CLSWT"
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE <= @ASONDATE AND ISNULL(CANCEL,'')='' AND   "
        strSql += vbCrLf + " ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='L'))       "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND TRANTYPE NOT IN ('AI','IAP')      "
        strSql += vbCrLf + " ) AS X GROUP BY TYPE,ACNAME      "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF @SUMMARY='Y'    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METAL_LIABILITIES_L SET ACNAME=NULL    "
        strSql += vbCrLf + " END      "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_METAL_LIABILITIES_L(TYPE,ACNAME,CLSWT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT  TYPE,NULL,NULL,0,'T' FROM  MASTER..TEMP_METAL_LIABILITIES_L GROUP BY TYPE    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_METAL_LIABILITIES_L(PARTICULAR,TYPE,ACNAME,CLSWT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT 'Total',Type,'zz',sum(clswt),2,'S' FROM  MASTER..TEMP_METAL_LIABILITIES_L  Group  by Type    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " UPDATE  MASTER..TEMP_METAL_LIABILITIES_L set PARTICULAR=TYPE  WHERE ISNULL(COLHEAD,'')='T'    "
        strSql += vbCrLf + " UPDATE  MASTER..TEMP_METAL_LIABILITIES_L set PARTICULAR='  ' + ACNAME  WHERE ISNULL(COLHEAD,'') <>'T'  AND ISNULL(COLHEAD,'')<>'S'     "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_METAL_ASSETS_R')>0  DROP TABLE MASTER..TEMP_METAL_ASSETS_R      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " SELECT  CONVERT(VARCHAR(300),NULL) AS PARTICULAR,CASE TYPE WHEN 'G' THEN 'SMITH' WHEN 'D' THEN 'DEALER'"
        strSql += vbCrLf + " WHEN 'C' THEN 'CUSTOMER' ELSE 'OTHERS'  END  AS TYPE, ACNAME,SUM(CLSWT) AS CLSWT      "
        strSql += vbCrLf + " ,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD     "
        strSql += vbCrLf + " INTO MASTER..TEMP_METAL_ASSETS_R      "
        strSql += vbCrLf + " FROM"
        strSql += vbCrLf + " (      "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME ,      "
        strSql += vbCrLf + " CASE WHEN TRANTYPE='I' THEN PUREWT  ELSE -1*PUREWT END  AS CLSWT       "
        strSql += vbCrLf + " FROM " & tranDbName & "..OPENWEIGHT AS T    WHERE  ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='A'))     "
        strSql += vbCrLf + " UNION ALL      "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME , -1*PUREWT  AS CLSWT"
        strSql += vbCrLf + " FROM " & tranDbName & "..RECEIPT AS T WHERE TRANDATE <= @ASONDATE AND ISNULL(CANCEL,'')=''  AND   "
        strSql += vbCrLf + " ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='A')) "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND TRANTYPE NOT IN ('AR','RAP')      "
        strSql += vbCrLf + " UNION ALL   "
        strSql += vbCrLf + " SELECT (SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,      "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE) AS ACNAME ,PUREWT   AS CLSWT"
        strSql += vbCrLf + " FROM " & tranDbName & "..ISSUE AS T WHERE TRANDATE <= @ASONDATE AND ISNULL(CANCEL,'')='' AND   "
        strSql += vbCrLf + " ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='A'))       "
        strSql += vbCrLf + " AND ISNULL(CANCEL,'') = '' AND TRANTYPE NOT IN ('AI','IAP')      "
        strSql += vbCrLf + " ) AS X GROUP BY TYPE,ACNAME      "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF @SUMMARY='Y'    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  UPDATE MASTER..TEMP_METAL_ASSETS_R SET ACNAME=NULL    "
        strSql += vbCrLf + " END      "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_METAL_ASSETS_R(TYPE,ACNAME,CLSWT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT  TYPE,NULL,NULL,0,'T' FROM  MASTER..TEMP_METAL_ASSETS_R GROUP BY TYPE    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " INSERT INTO MASTER..TEMP_METAL_ASSETS_R(PARTICULAR,TYPE,ACNAME,CLSWT,RESULT,COLHEAD)    "
        strSql += vbCrLf + " SELECT  'Total',Type,'zz',sum(clswt),2,'S' FROM  MASTER..TEMP_METAL_ASSETS_R GROUP BY TYPE      "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " UPDATE  MASTER..TEMP_METAL_ASSETS_R set PARTICULAR=TYPE  WHERE ISNULL(COLHEAD,'')='T'    "
        strSql += vbCrLf + " UPDATE  MASTER..TEMP_METAL_ASSETS_R set PARTICULAR='  ' + ACNAME  WHERE ISNULL(COLHEAD,'') <>'T'  AND ISNULL(COLHEAD,'')<>'S'    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + "      "
        strSql += vbCrLf + ""
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_CASH_LIABILITIES_L')>0  DROP TABLE MASTER..TEMP_CASH_LIABILITIES_L       "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SELECT CONVERT(VARCHAR(300),NULL) AS PARTICULAR, "
        strSql += vbCrLf + " CASE TYPE      "
        strSql += vbCrLf + " WHEN 'C' THEN 'CUSTOMER'  WHEN 'G' THEN 'SMITH' WHEN 'D' THEN 'DEALER' ELSE 'OTHERS' END AS Type ,    "
        strSql += vbCrLf + " (SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=X.ACCODE) AS ACNAME,SUM(CLSWT) AS CLSWT       "
        strSql += vbCrLf + " ,CONVERT(INT,1) AS RESULT,CONVERT(VARCHAR(2),NULL) AS COLHEAD     "
        strSql += vbCrLf + " INTO MASTER..TEMP_CASH_LIABILITIES_L FROM (       "
        strSql += vbCrLf + " SELECT ACCODE,(SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,Credit AS CLSWT  FROM OPENTRAILBALANCE AS T     "
        strSql += vbCrLf + " WHERE ACCODE IN (SELECT ACCODE FROM " & compId & "ADMINDB..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId & "ADMINDB..ACGROUP WHERE GRPTYPE='L'))   "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT ACCODE,(SELECT ACTYPE FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE=T.ACCODE)AS TYPE,     "
        strSql += vbCrLf + " Case when TranMode='C' Then Amount Else -1*Amount End as CLSWT  FROM ACCTRAN AS T     "
