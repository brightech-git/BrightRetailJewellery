        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' ,ISNULL((SELECT SUM(CREDIT) FROM '+@DBNAME+'..OPENTRAILBALANCE WHERE ACCODE IN (SELECT ACCODE FROM #CASHACC) AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY) AND COSTID IN (SELECT COSTID FROM #COSTCENTRE)),0)'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' +ISNULL((SELECT SUM(CASE WHEN TRANMODE = ''C'' THEN ISNULL(AMOUNT,0) ELSE 0 END)'"
