        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PUREMCTRAN     "
        strSql += vbCrLf + "  		(ITEMNAME,METALNAME,COLHEAD,RESULT,PAYMENT)     "
        strSql += vbCrLf + "  		SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT,0 PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PUREMCTRAN WHERE RESULT = 1"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT ITEMNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PUREMCTRAN ORDER BY METALNAME,RESULT,CONVERT(INT,TRANNO)      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14 ,COLHEAD)  "
        strSql += vbCrLf + "  		SELECT '' SUBTOTAL'' ITEMNAME,''''TRANNO,''''ITEMNAME,''''PCS,SUM(GRSWT),SUM(NETWT),''''MCHARGE,''''RATE,SUM(AMOUNT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),''''TAGNO,''''BATCHNO,''T''COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PUREMCTRAN End'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
