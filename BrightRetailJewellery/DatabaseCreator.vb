                    End If
                    If (Val(curVer(1)) < Val(preVer(1))) And Val(curVer(0)) <= Val(preVer(0)) Then
                        MsgBox("Conflict Application Version" + vbCrLf + "New Version : " + preVersion + vbCrLf + "Current Version : " + VERSION + vbCrLf + "Please Copy New Version", MsgBoxStyle.Information)
                        Me.Close()
                        Exit Sub
                    End If
                    If (Val(curVer(2)) < Val(preVer(2))) And Val(curVer(1)) <= Val(preVer(1)) And Val(curVer(0)) <= Val(preVer(0)) Then
                        MsgBox("Conflict Application Version" + vbCrLf + "New Version : " + preVersion + vbCrLf + "Current Version : " + VERSION + vbCrLf + "Please Copy New Version", MsgBoxStyle.Information)
                        Me.Close()
                        Exit Sub
                    End If
                    If (Val(curVer(3)) < Val(preVer(3))) And Val(curVer(2)) <= Val(preVer(2)) And Val(curVer(1)) <= Val(preVer(1)) And Val(curVer(0)) <= Val(preVer(0)) Then
                        MsgBox("Conflict Application Version" + vbCrLf + "New Version : " + preVersion + vbCrLf + "Current Version : " + VERSION + vbCrLf + "Please Copy New Version", MsgBoxStyle.Information)
                        Me.Close()
                        Exit Sub
                    End If
                End If
                If BrighttechPack.GlobalMethods.GetSqlValue(cn, "SELECT NAME FROM " & compId & "ADMINDB..SYSOBJECTS WHERE NAME = 'SNOCREATOR' AND XTYPE = 'U'", , "-1") = "-1" Then
                    Select Case MessageBox.Show("New version found" + vbCrLf + " If you have any exported data, you must import and click Yes otherwise click No", "Import Alert", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2)
                        Case Windows.Forms.DialogResult.Yes
                            Exit Sub
                        Case Else
                            Me.Close()
                            Exit Sub
                    End Select
                End If
            End If
            lblStatus.Text = ""
            pBar.Value = 0
            btnInstall.Select()
        End If


        strSql = " SELECT NAME FROM MASTER..SYSDATABASES WHERE NAME = '" & compId & "ADMINDB'"
        If GetSqlValue(strSql) <> "" Then
            strSql = " SELECT NAME FROM " & compId & "ADMINDB..SYSOBJECTS WHERE ID = OBJECT_ID('" & compId & "ADMINDB..PRJMENUS','U')"
            If GetSqlValue(strSql) <> "" Then
                btnMenuModifier.Visible = True
            End If
        End If
    End Sub

    Private Function GetSqlValue(ByVal qry As String, Optional ByVal defValue As String = Nothing, Optional ByVal ttran As OleDbTransaction = Nothing) As String
        cmd = New OleDbCommand(qry, cn)
        If Not ttran Is Nothing Then cmd.Transaction = ttran
        da = New OleDbDataAdapter(cmd)
        Dim dt As New DataTable
        da.Fill(dt)
        If dt.Rows.Count > 0 Then Return dt.Rows(0).Item(0).ToString()
        Return defValue
    End Function

