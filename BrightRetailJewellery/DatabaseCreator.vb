        strSql += vbCrLf + "  ('','','',0,4,'G','Difference','','',@BALANCE,4,'G')     "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM MASTER..SYSOBJECTS WHERE XTYPE='U' AND NAME ='TEMP_RESULT_SHOW')>0  DROP TABLE MASTER..TEMP_RESULT_SHOW     "
