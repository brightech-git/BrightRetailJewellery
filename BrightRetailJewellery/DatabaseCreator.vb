        strSql += vbCrLf + "	PRINT @QRY"
        strSql += vbCrLf + "	EXEC (@QRY)"
        strSql += vbCrLf + "	/** ACTYPE SEPERATION **/"
        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TEMPACHEAD', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD"
