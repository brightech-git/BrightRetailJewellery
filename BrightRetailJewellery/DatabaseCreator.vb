        strSql += vbCrLf + "          SELECT @STRQRY=@STRQRY + CHAR(13) + ',GRSWT RGRSWT,LESSWT RLESSWT,NETWT RNETWT,NETWT RSTNWT,NETWT RDIAWT,NULL RPURITY,WASTAGE RWASTAGE,MCHARGE RMCHARGE,RATE IRATE,PURITY AS IPURITY'"
