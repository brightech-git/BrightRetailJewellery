        strSql += vbCrLf + "              SELECT @QRY = @QRY + ' ,NETWT = CASE WHEN NETWT = 0 THEN NULL ELSE NETWT END,AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END'"
