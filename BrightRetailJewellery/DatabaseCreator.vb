        strSql += vbCrLf + "   AS"
        strSql += vbCrLf + "   SET NOCOUNT ON"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPACTYPE') IS NOT NULL DROP TABLE MASTER..TEMPACTYPE"
        strSql += vbCrLf + "   IF @ACGRPCODE = 'C' "
        strSql += vbCrLf + "   begin"
        strSql += vbCrLf + "   SELECT * INTO MASTER..TEMPACTYPE FROM ( SELECT 'C' ACTYPE)X"
        strSql += vbCrLf + "   end"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   	SELECT * INTO MASTER..TEMPACTYPE FROM (SELECT 'G' ACTYPE UNION ALL SELECT 'D')X"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   DECLARE @MAXLEN AS INT"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPRECEIPTAMT') IS NOT NULL DROP TABLE MASTER..TEMPRECEIPTAMT"
        strSql += vbCrLf + "   SELECT O.TRANDATE,O.TRANNO,RUNNO"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(400),NULL)PARTICULAR"
        strSql += vbCrLf + "   ,SUM(AMOUNT)AMOUNT"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(200),ISNULL((SELECT PNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = (SELECT TOP 1 BATCHNO FROM " & compId & "ADMINDB..OUTSTANDING WHERE RUNNO = O.RUNNO ORDER BY TRANDATE DESC))),'')) AS PNAME"
        strSql += vbCrLf + "   ,(SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = (SELECT TOP 1 BATCHNO FROM " & compId & "ADMINDB..OUTSTANDING WHERE RUNNO = O.RUNNO ORDER BY TRANDATE DESC))PSNO"
        strSql += vbCrLf + "   ,CONVERT(NUMERIC(15,2),NULL)ISSAMT"
        strSql += vbCrLf + "   INTO MASTER..TEMPRECEIPTAMT"
        strSql += vbCrLf + "   FROM " & compId & "ADMINDB..OUTSTANDING AS O"
        strSql += vbCrLf + "   INNER JOIN " & compId & "ADMINDB..ACHEAD AS H ON H.ACCODE = O.ACCODE AND H.ACTYPE IN (SELECT ACTYPE FROM MASTER..TEMPACTYPE)"
        strSql += vbCrLf + "   WHERE O.TRANDATE <= @ASONDATE AND O.TRANTYPE = 'D' AND O.RECPAY = 'P' AND ISNULL(O.CANCEL,'') = '' AND RUNNO <> ''"
        strSql += vbCrLf + "   AND SUBSTRING(RUNNO,6,1)='D'"
        strSql += vbCrLf + "   GROUP BY O.TRANDATE,O.RUNNO,O.TRANNO"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPISSUEAMT') IS NOT NULL DROP TABLE MASTER..TEMPISSUEAMT"
        strSql += vbCrLf + "   SELECT O.TRANDATE"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(400),NULL)PARTICULAR"
        strSql += vbCrLf + "   ,SUM(O.AMOUNT)AMOUNT,RUNNO"
        strSql += vbCrLf + "   ,CONVERT(NUMERIC(15,2),NULL)ISSAMT"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(200),ISNULL((SELECT PNAME FROM " & compId & "ADMINDB..PERSONALINFO WHERE SNO = (SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = (SELECT TOP 1 BATCHNO FROM " & compId & "ADMINDB..OUTSTANDING WHERE RUNNO = O.RUNNO ORDER BY TRANDATE DESC))),'')) AS PNAME"
        strSql += vbCrLf + "   ,(SELECT TOP 1 PSNO FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO = (SELECT TOP 1 BATCHNO FROM " & compId & "ADMINDB..OUTSTANDING WHERE RUNNO = O.RUNNO ORDER BY TRANDATE DESC))PSNO "
        strSql += vbCrLf + "   INTO MASTER..TEMPISSUEAMT"
        strSql += vbCrLf + "   FROM " & compId & "ADMINDB..OUTSTANDING AS O"
        strSql += vbCrLf + "   INNER JOIN " & compId & "ADMINDB..ACHEAD AS H ON H.ACCODE = O.ACCODE AND H.ACTYPE IN (SELECT ACTYPE FROM MASTER..TEMPACTYPE)"
        strSql += vbCrLf + "   WHERE O.TRANDATE <= @ASONDATE AND O.TRANTYPE = 'D' AND O.RECPAY = 'R' AND ISNULL(O.CANCEL,'') = '' AND RUNNO <> ''"
        strSql += vbCrLf + "   AND SUBSTRING(RUNNO,6,1)='D'"
        strSql += vbCrLf + "   GROUP BY O.TRANDATE,O.RUNNO"
        strSql += vbCrLf + "   DECLARE @I_AMT NUMERIC(15,2) "
        strSql += vbCrLf + "   DECLARE @I_TRANDATE SMALLDATETIME "
        strSql += vbCrLf + "   DECLARE @I_PNAME VARCHAR(100)"
        strSql += vbCrLf + "   DECLARE @I_RUNNO VARCHAR(15)"
        strSql += vbCrLf + "   DECLARE @R_AMT NUMERIC(15,2) "
        strSql += vbCrLf + "   DECLARE @R_TRANDATE SMALLDATETIME "
        strSql += vbCrLf + "   DECLARE @TEMPAMT NUMERIC(15,2) "
        strSql += vbCrLf + "   DECLARE @I_PSNO VARCHAR(100)"
        strSql += vbCrLf + "   DECLARE I_CURAMT CURSOR FOR SELECT TRANDATE,AMOUNT,PNAME,RUNNO,PSNO FROM MASTER..TEMPISSUEAMT ORDER BY TRANDATE,RUNNO,PNAME,PSNO "
        strSql += vbCrLf + "   OPEN I_CURAMT "
        strSql += vbCrLf + "   WHILE 1=1 "
        strSql += vbCrLf + "   BEGIN "
        strSql += vbCrLf + "   FETCH NEXT FROM I_CURAMT INTO @I_TRANDATE,@I_AMT,@I_PNAME,@I_RUNNO,@I_PSNO"
        strSql += vbCrLf + "   IF @@FETCH_STATUS = -1 BREAK "
        strSql += vbCrLf + "   DECLARE R_CURAMT CURSOR FOR SELECT (AMOUNT - ISNULL(ISSAMT,0)) AS AMOUNT FROM MASTER..TEMPRECEIPTAMT "
        strSql += vbCrLf + "                    WHERE (AMOUNT - ISNULL(ISSAMT,0)) > 0  AND RUNNO = @I_RUNNO /*AND PSNO=@I_PSNO AND PNAME = @I_PNAME*/"
        strSql += vbCrLf + "   OPEN R_CURAMT "
        strSql += vbCrLf + "   WHILE 1 = 1 "
        strSql += vbCrLf + "   	BEGIN "
        strSql += vbCrLf + "   	FETCH NEXT FROM R_CURAMT INTO @R_AMT "
        strSql += vbCrLf + "   	IF @@FETCH_STATUS = -1 BREAK "
        strSql += vbCrLf + "   	SELECT @TEMPAMT = 0 "
        strSql += vbCrLf + "   	IF @I_AMT <> 0 "
        strSql += vbCrLf + "   		BEGIN "
        strSql += vbCrLf + "   		IF @R_AMT > @I_AMT "
        strSql += vbCrLf + "   			BEGIN "
        strSql += vbCrLf + "   			SELECT @TEMPAMT = @I_AMT "
        strSql += vbCrLf + "   			SELECT @I_AMT = 0 "
        strSql += vbCrLf + "   			END "
        strSql += vbCrLf + "   		ELSE "
        strSql += vbCrLf + "   			BEGIN "
        strSql += vbCrLf + "   			SELECT @TEMPAMT = @R_AMT "
        strSql += vbCrLf + "   			SELECT @I_AMT = @I_AMT - @R_AMT "
        strSql += vbCrLf + "   			END "
        strSql += vbCrLf + "   		UPDATE MASTER..TEMPRECEIPTAMT SET ISSAMT = ISNULL(ISSAMT,0) + @TEMPAMT WHERE CURRENT OF R_CURAMT "
        strSql += vbCrLf + "   			IF @I_AMT = 0 BREAK "
        strSql += vbCrLf + "   		END "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   IF @I_AMT <> 0 "
        strSql += vbCrLf + "   	INSERT INTO MASTER..TEMPRECEIPTAMT(TRANDATE,AMOUNT,ISSAMT,PNAME,PSNO,RUNNO)VALUES(@I_TRANDATE,0,@I_AMT,@I_PNAME,@I_PSNO,@I_RUNNO) "
        strSql += vbCrLf + "   CLOSE R_CURAMT "
        strSql += vbCrLf + "   DEALLOCATE R_CURAMT "
        strSql += vbCrLf + "   END "
        strSql += vbCrLf + "   CLOSE I_CURAMT "
        strSql += vbCrLf + "   DEALLOCATE I_CURAMT "
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMP_DUEAGING') IS NOT NULL DROP TABLE MASTER..TEMP_DUEAGING"
        strSql += vbCrLf + "   SELECT DATEDIFF(DD,TRANDATE,@ASONDATE) AS DIFF"
        strSql += vbCrLf + "   ,TRANDATE,TRANNO,PARTICULAR,AMOUNT,ISSAMT,AMOUNT - ISNULL(ISSAMT,0) BALAMT,RUNNO,PNAME,PSNO"
        strSql += vbCrLf + "   INTO MASTER..TEMP_DUEAGING"
        strSql += vbCrLf + "   FROM MASTER..TEMPRECEIPTAMT"
        strSql += vbCrLf + "   WHERE (AMOUNT - ISNULL(ISSAMT,0)) > 0"
        strSql += vbCrLf + "   IF @ONLYGIVENRANGE = 'Y'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   	    DELETE FROM MASTER..TEMP_DUEAGING WHERE DIFF > (SELECT MAX(TODAYS) FROM MASTER..TEMP_DUE_AGEANALYSIS_DAYS)"
        strSql += vbCrLf + "   	    DELETE FROM MASTER..TEMP_DUEAGING WHERE DIFF < (SELECT MIN(FROMDAYS) FROM MASTER..TEMP_DUE_AGEANALYSIS_DAYS)"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   IF @ORDERBY = 'N'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SET @MAXLEN = (SELECT MAX(LEN(PNAME))+1 FROM MASTER..TEMP_DUEAGING)"
        strSql += vbCrLf + "   	/*UPDATE MASTER..TEMP_DUEAGING SET PARTICULAR = PNAME + REPLICATE(' ',@MAXLEN-LEN(PNAME)) + '[' + RUNNO + ']'*/"
        strSql += vbCrLf + "   	UPDATE MASTER..TEMP_DUEAGING SET PARTICULAR = RUNNO "
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   ELSE"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   	SET @MAXLEN = (SELECT MAX(LEN(RUNNO))+1 FROM MASTER..TEMP_DUEAGING)"
        strSql += vbCrLf + "   	UPDATE MASTER..TEMP_DUEAGING SET PARTICULAR = RUNNO + REPLICATE(' ',@MAXLEN-LEN(RUNNO)) + '[' + PNAME + ']'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   IF OBJECT_ID('MASTER..TEMPAGINGRESULTAMT') IS NOT NULL DROP TABLE MASTER..TEMPAGINGRESULTAMT"
        strSql += vbCrLf + "   CREATE TABLE MASTER..TEMPAGINGRESULTAMT(PNAME VARCHAR(400),PSNO VARCHAR(12),RUNNO VARCHAR(15),PARTICULAR VARCHAR(400),TRANDATE VARCHAR(12),TRANNO VARCHAR(15),TOTDAYS INT,BALAMT NUMERIC(15,2),RESULT INT,COLHEAD VARCHAR(3),TTRANDATE SMALLDATETIME)"
        strSql += vbCrLf + "   INSERT INTO MASTER..TEMPAGINGRESULTAMT(PNAME,PSNO,RUNNO,PARTICULAR,TRANDATE,TRANNO,TOTDAYS,BALAMT,RESULT,COLHEAD,TTRANDATE)"
        strSql += vbCrLf + "   SELECT DISTINCT PNAME,PSNO,'' RUNNO,PNAME PARTICULAR,NULL AS TRANDATE,NULL AS TRANNO,NULL AS TOTDAYS,NULL AS BALAMT,0 RESULT,'T' COLHEAD,NULL AS TTRANDATE"
        strSql += vbCrLf + "   FROM MASTER..TEMP_DUEAGING"
        strSql += vbCrLf + "   UNION ALL"
        strSql += vbCrLf + "   SELECT PNAME,PSNO,RUNNO,PARTICULAR,CONVERT(VARCHAR(12),TRANDATE,105)TRANDATE,TRANNO,SUM(DIFF) AS TOTDAYS,SUM(BALAMT)AS BALAMT,1 RESULT,NULL COLHEAD,TRANDATE AS TTRANDATE"
        strSql += vbCrLf + "   FROM MASTER..TEMP_DUEAGING GROUP BY PNAME,PSNO,RUNNO,PARTICULAR,TRANDATE,TRANNO"
        strSql += vbCrLf + "   UNION ALL"
        strSql += vbCrLf + "   SELECT PNAME,PSNO,'' RUNNO,'SUB TOTAL',NULL AS TRANDATE,NULL AS TRANNO,NULL AS TOTDAYS,SUM(BALAMT)AS BALAMT,2 RESULT,'G' COLHEAD,NULL AS TTRANDATE"
        strSql += vbCrLf + "   FROM MASTER..TEMP_DUEAGING GROUP BY PNAME,PSNO"
        strSql += vbCrLf + "   UNION ALL"
        strSql += vbCrLf + "   SELECT 'GRAND TOTAL' PNAME,'ZZZZZZZ' PSNO,'' RUNNO,'GRAND TOTAL',NULL AS TRANDATE,NULL AS TRANNO,NULL AS TOTDAYS,SUM(BALAMT)AS BALAMT,3 RESULT,'G' COLHEAD,NULL AS TTRANDATE"
        strSql += vbCrLf + "   FROM MASTER..TEMP_DUEAGING"
        strSql += vbCrLf + "   IF @ONLYGIVENRANGE <> 'Y'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "    DECLARE @STR VARCHAR(8000)"
        strSql += vbCrLf + "    DECLARE @FROMDAYS VARCHAR(10)"
        strSql += vbCrLf + "    DECLARE @TODAYS VARCHAR(10)"
        strSql += vbCrLf + "    DECLARE @MAXDAYS VARCHAR(10)"
        strSql += vbCrLf + "    SELECT @MAXDAYS = MAX(TODAYS) FROM MASTER..TEMP_DUE_AGEANALYSIS_DAYS"
        strSql += vbCrLf + "    DECLARE CUR CURSOR FOR SELECT FROMDAYS,TODAYS FROM MASTER..TEMP_DUE_AGEANALYSIS_DAYS"
        strSql += vbCrLf + "    OPEN CUR"
        strSql += vbCrLf + "    WHILE 1=1"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "    FETCH NEXT FROM CUR INTO @FROMDAYS,@TODAYS"
        strSql += vbCrLf + "    IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "    SET @STR = ' ALTER TABLE MASTER..TEMPAGINGRESULTAMT ADD ['+@FROMDAYS+' TO '+@TODAYS+'] NUMERIC(15,2)'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "    SET @STR = ' UPDATE MASTER..TEMPAGINGRESULTAMT SET ['+@FROMDAYS+' TO '+@TODAYS+'] = (SELECT SUM(BALAMT) FROM MASTER..TEMP_DUEAGING WHERE PARTICULAR = T.PARTICULAR AND DIFF BETWEEN '+@FROMDAYS+' AND '+@TODAYS+') FROM MASTER..TEMPAGINGRESULTAMT AS T WHERE RESULT = 1'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "    SET @STR = ' UPDATE MASTER..TEMPAGINGRESULTAMT SET ['+@FROMDAYS+' TO '+@TODAYS+'] = (SELECT SUM(BALAMT) FROM MASTER..TEMP_DUEAGING WHERE DIFF BETWEEN '+@FROMDAYS+' AND '+@TODAYS+') FROM MASTER..TEMPAGINGRESULTAMT AS T WHERE RESULT = 3'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "    CLOSE CUR"
        strSql += vbCrLf + "    DEALLOCATE CUR"
        strSql += vbCrLf + "    SET @STR = ' ALTER TABLE MASTER..TEMPAGINGRESULTAMT ADD [ > '+@MAXDAYS+'] NUMERIC(15,2)'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "    SET @STR = ' UPDATE MASTER..TEMPAGINGRESULTAMT SET [ > '+@MAXDAYS+'] = (SELECT SUM(BALAMT) FROM MASTER..TEMP_DUEAGING WHERE PARTICULAR = T.PARTICULAR AND DIFF > '+@MAXDAYS+' ) FROM MASTER..TEMPAGINGRESULTAMT AS T WHERE RESULT = 1'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "    SET @STR = ' UPDATE MASTER..TEMPAGINGRESULTAMT SET [ > '+@MAXDAYS+'] = (SELECT SUM(BALAMT) FROM MASTER..TEMP_DUEAGING WHERE DIFF > '+@MAXDAYS+' ) FROM MASTER..TEMPAGINGRESULTAMT AS T WHERE RESULT = 3'"
        strSql += vbCrLf + "    PRINT(@STR)"
        strSql += vbCrLf + "    EXEC(@STR)"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   DROP TABLE MASTER..TEMP_DUE_AGEANALYSIS_DAYS"
        strSql += vbCrLf + "   SELECT * FROM MASTER..TEMPAGINGRESULTAMT ORDER BY PSNO,PNAME,RESULT,PARTICULAR"
        strSql += vbCrLf + "   /*SELECT PARTICULAR,TOTDAYS AS [TOTAL DAYS],BALAMT AS [BALANCE AMOUNT],RESULT,COLHEAD FROM MASTER..TEMPAGINGRESULTAMT ORDER BY PSNO,PNAME,RESULT,PARTICULAR*/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SpSalesPurchaseVat()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SALESVAT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SALESVAT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_SALESVAT"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DATEFROM VARCHAR(20)"
        strSql += vbCrLf + ",@DATETO VARCHAR(20)"
        strSql += vbCrLf + ",@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@LOCALOUT VARCHAR(5)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	SET NOCOUNT ON"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "	SELECT @QRY = ' IF OBJECT_ID(''TEMPDB..#TEMPSALESVATREPORT'') IS NOT NULL DROP TABLE #TEMPSALESVATREPORT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SELECT IDENTITY (INT,1,1) SERIAL_NO ,PE.PNAME AS NAME_OF_BUYER,AC.TIN AS BUYER_TIN,CA.CATNAME AS COMMODITY_CODE,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' I.TRANNO AS INVOICE_NO,CONVERT(VARCHAR,I.TRANDATE,103) AS INVOICE_DATE ,SUM(I.AMOUNT) AS SALES_VALUE,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' CA.SALESTAX AS TAX_RATE,SUM(I.TAX) AS VAT_CST_PAID,CA.SHORTNAME AS CATEGORY'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' INTO #TEMPSALESVATREPORT FROM ISSUE AS I'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..CUSTOMERINFO AS CU ON CU.BATCHNO = I.BATCHNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..PERSONALINFO AS PE ON CU.PSNO = PE.SNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..CATEGORY AS CA ON CA.CATCODE = I.CATCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..ACHEAD AS AC ON PE.ACCODE = AC.ACCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' WHERE I.TRANDATE BETWEEN  '''+@DATEFROM+''' AND  '''+@DATETO+''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' AND ISNULL(I.CANCEL,'''') <> ''Y''' "
        strSql += vbCrLf + "	IF @LOCALOUT<>'' SELECT @QRY = @QRY + ' AND ISNULL(AC.LOCALOUTST,'''') = '''+ @LOCALOUT +'''' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' AND ISNULL(I.TAX,0)<>0'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' GROUP BY I.TRANNO,I.TRANDATE,PE.PNAME,CA.CATNAME,CA.SALESTAX,CA.SHORTNAME,AC.TIN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ORDER BY I.TRANDATE,I.TRANNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SELECT * FROM  #TEMPSALESVATREPORT ORDER BY SERIAL_NO'"
        strSql += vbCrLf + "	EXEC (@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PURCHASEVAT_CU')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PURCHASEVAT_CU"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_PURCHASEVAT_CU"
        strSql += vbCrLf + "("
        strSql += vbCrLf + "@DATEFROM VARCHAR(20)"
        strSql += vbCrLf + ",@DATETO VARCHAR(20)"
        strSql += vbCrLf + ",@DBNAME VARCHAR(20)"
        strSql += vbCrLf + ",@LOCALOUT VARCHAR(5)"
        strSql += vbCrLf + ")"
        strSql += vbCrLf + "AS "
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	SET NOCOUNT ON"
        strSql += vbCrLf + "	DECLARE @QRY VARCHAR(4000)"
        strSql += vbCrLf + "	SELECT @QRY = ' IF OBJECT_ID(''TEMPDB..#TEMPPURCHASEVATREPORT'') IS NOT NULL DROP TABLE #TEMPPURCHASEVATREPORT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SELECT IDENTITY (INT,1,1) SERIAL_NO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(R.ACCODE,'''')='''' THEN PE.PNAME ELSE AA.ACNAME END AS NAME_OF_BUYER'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,CASE WHEN ISNULL(AC.TIN,'''')<>'''' THEN AC.TIN ELSE AA.TIN END AS BUYER_TIN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ,CA.CATNAME AS COMMODITY_CODE,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' R.TRANNO AS INVOICE_NO,CONVERT(VARCHAR,R.TRANDATE,103) AS INVOICE_DATE ,SUM(R.AMOUNT) AS SALES_VALUE,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' CA.SALESTAX AS TAX_RATE,SUM(R.TAX) AS VAT_CST_PAID,CA.SHORTNAME AS CATEGORY'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' INTO #TEMPPURCHASEVATREPORT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' FROM RECEIPT AS R'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..CUSTOMERINFO AS CU ON CU.BATCHNO = R.BATCHNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..PERSONALINFO AS PE ON CU.PSNO = PE.SNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..CATEGORY AS CA ON CA.CATCODE = R.CATCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..ACHEAD AS AC ON PE.ACCODE = AC.ACCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' LEFT OUTER JOIN '+@DBNAME+'..ACHEAD AS AA ON R.ACCODE = AA.ACCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' WHERE R.TRANDATE BETWEEN  '''+@DATEFROM+''' AND  '''+@DATETO+''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' AND ISNULL(R.CANCEL,'''') <> ''Y''' "
        strSql += vbCrLf + "	IF @LOCALOUT<>'' SELECT @QRY = @QRY + ' AND ISNULL(AC.LOCALOUTST,'''') = '''+ @LOCALOUT +'''' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' AND R.TRANTYPE IN(''PU'',''RPU'')'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' GROUP BY R.TRANNO,R.TRANDATE,PE.PNAME,CA.CATNAME,CA.SALESTAX,CA.SHORTNAME,AC.TIN, AA.ACNAME,R.ACCODE, AA.TIN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' ORDER BY R.TRANDATE,R.TRANNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SELECT * FROM  #TEMPPURCHASEVATREPORT ORDER BY SERIAL_NO'"
        strSql += vbCrLf + "	PRINT (@QRY)"
        strSql += vbCrLf + "	EXEC (@QRY)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_DAYBOOKWITHJOURNAL()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='RPT_DAYBOOKWITHJOURNAL')>0"
        strSql += vbCrLf + " DROP PROCEDURE RPT_DAYBOOKWITHJOURNAL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "CREATE PROCEDURE RPT_DAYBOOKWITHJOURNAL"
        strSql += vbCrLf + "(  "
        strSql += vbCrLf + "@DBNAME VARCHAR(20)  "
        strSql += vbCrLf + ",@TEMPTABLE VARCHAR(20)  "
        strSql += vbCrLf + ",@FROMDATE VARCHAR(12)  "
        strSql += vbCrLf + ",@TODATE VARCHAR(12)       "
        strSql += vbCrLf + ",@OPENING VARCHAR(1)  "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)      "
        strSql += vbCrLf + ",@COSTID VARCHAR(300)  "
        strSql += vbCrLf + ",@DETAILED VARCHAR(1)    "
        strSql += vbCrLf + ",@USERID VARCHAR(20)    "
        strSql += vbCrLf + ")   "
        strSql += vbCrLf + "AS                     "
        strSql += vbCrLf + "BEGIN      "
        strSql += vbCrLf + " DECLARE @QUERY NVARCHAR(4000)        "
        strSql += vbCrLf + " DECLARE @POSJFILTER VARCHAR(100)      "
        strSql += vbCrLf + " DECLARE @POSBFILTER VARCHAR(100)      "
        strSql += vbCrLf + " DECLARE @SALEFILTER VARCHAR(1000)      "
        strSql += vbCrLf + " DECLARE @PURFILTER VARCHAR(1000)      "
