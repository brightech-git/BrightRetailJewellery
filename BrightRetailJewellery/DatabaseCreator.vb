        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROC SP_ADVANCECLOSEDAGING    "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + "   @COMPANYID NVARCHAR(100)    "
        strSql += vbCrLf + "  ,@COSTNAME  NVARCHAR(1000)    "
        strSql += vbCrLf + "  ,@FROMDATE  SMALLDATETIME    "
        strSql += vbCrLf + "  ,@TODATE    SMALLDATETIME    "
        strSql += vbCrLf + " )    "
        strSql += vbCrLf + " AS    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " DECLARE @STRINP NVARCHAR(50)    "
        strSql += vbCrLf + " DECLARE @FROMVALUE NUMERIC    "
        strSql += vbCrLf + " DECLARE @TOVALUE NUMERIC    "
        strSql += vbCrLf + " DECLARE @STRQRYVAL NVARCHAR(200)    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " /* ADVANCE CLOSED - AGING  CREATED DATE 2011-03-03 */    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SET NOCOUNT ON "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = '_COMPANY',@INPUTVALUES = @COMPANYID    "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = '_COSTCENTRE',@INPUTVALUES = @COSTNAME    "
        strSql += vbCrLf + " IF OBJECT_ID('#_ADVANCEDETAILS', 'U') IS NOT NULL DROP TABLE #_ADVANCEDETAILS    "
        strSql += vbCrLf + " IF OBJECT_ID('#_REPRES', 'U') IS NOT NULL DROP TABLE #_REPRES    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SELECT O.TRANNO AS [ADV.BILLNO],    "
        strSql += vbCrLf + "  (SELECT TOP 1 ACNAME FROM  " & compId & "ADMINDB..ACHEAD WHERE ACCODE=O.ACCODE ) AS [CUSTOMER NAME],    "
        strSql += vbCrLf + "  O.TRANDATE AS [ADV.BILL DATE],O.RUNNO    "
        strSql += vbCrLf + " INTO  #_ADVANCEDETAILS FROM " & compId & "ADMINDB..OUTSTANDING O    "
        strSql += vbCrLf + " WHERE   O.TRANDATE BETWEEN @FROMDATE AND @TODATE    "
        strSql += vbCrLf + "  AND O.COMPANYID IN (SELECT COMPANYID FROM _COMPANY)      "
        strSql += vbCrLf + "  AND ISNULL(O.COSTID,'')  IN (SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME IN (SELECT COMPANYID FROM _COSTCENTRE) )     "
        strSql += vbCrLf + "  AND O.CANCEL<>'Y' AND O.TRANTYPE='A'  AND O.RECPAY='R'    "
        strSql += vbCrLf + " ORDER BY RUNNO    "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " SELECT  'D' AS COLHEAD ,[ADV.BILLNO],[CUSTOMER NAME],[ADV.BILL DATE],MAX(O.TRANDATE) AS [ADJ.BILL DATE],    "
        strSql += vbCrLf + "  DATEDIFF(DD,[ADV.BILL DATE],MAX(O.TRANDATE) ) AS NODAYS,SUM(AMOUNT) AS [TOAL AMOUNT]    "
        strSql += vbCrLf + " INTO  #_REPRES    "
        strSql += vbCrLf + " FROM  #_ADVANCEDETAILS D," & compId & "ADMINDB..OUTSTANDING O    "
        strSql += vbCrLf + " WHERE   D.RUNNO=O.RUNNO    "
        strSql += vbCrLf + "  AND O.COMPANYID IN (SELECT COMPANYID FROM _COMPANY)      "
        strSql += vbCrLf + "  AND ISNULL(O.COSTID,'')  IN (SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME IN (SELECT COMPANYID FROM _COSTCENTRE) )      "
        strSql += vbCrLf + "  AND O.CANCEL<>'Y'    "
        strSql += vbCrLf + " GROUP BY     "
        strSql += vbCrLf + "  [ADV.BILLNO],[CUSTOMER NAME],[ADV.BILL DATE]    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " UPDATE #_REPRES  SET  NODAYS =1 WHERE [ADV.BILL DATE]=[ADJ.BILL DATE]  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + " INSERT INTO #_REPRES (COLHEAD,[CUSTOMER NAME],[TOAL AMOUNT]) SELECT 'G','TOTAL -->',SUM([TOAL AMOUNT]) FROM #_REPRES  "
        strSql += vbCrLf + "     "
        strSql += vbCrLf + " DECLARE RESCUR CURSOR FOR SELECT FROMVALUE ,TOVALUE FROM MASTER..ADVANCECLOSEDAGINGINPUT  ORDER BY FROMVALUE  "
        strSql += vbCrLf + " OPEN RESCUR  "
        strSql += vbCrLf + "  FETCH NEXT FROM RESCUR INTO @FROMVALUE,@TOVALUE    "
        strSql += vbCrLf + "  WHILE @@FETCH_STATUS=0  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   IF @TOVALUE <>0    "
        strSql += vbCrLf + "   BEGIN    "
        strSql += vbCrLf + "   SET @STRINP=  CONVERT(NVARCHAR,@FROMVALUE) + ' TO ' + CONVERT(NVARCHAR,@TOVALUE)     "
        strSql += vbCrLf + "   SET @STRQRYVAL='ALTER TABLE #_REPRES ADD [' + @STRINP + '] NUMERIC (13,2)'    "
        strSql += vbCrLf + "   EXEC(@STRQRYVAL)  "
        strSql += vbCrLf + "   SELECT @STRQRYVAL='UPDATE #_REPRES  SET #_REPRES.[' + @STRINP + ']=[TOAL AMOUNT] WHERE NODAYS BETWEEN ' + CAST(@FROMVALUE AS NVARCHAR) + ' AND ' + CAST(@TOVALUE  AS NVARCHAR)  "
        strSql += vbCrLf + "   EXEC(@STRQRYVAL)      "
        strSql += vbCrLf + "   SELECT @STRQRYVAL='UPDATE #_REPRES  SET #_REPRES.[' + @STRINP + ']=(SELECT SUM([' + @STRINP + ']) FROM #_REPRES) WHERE COLHEAD=''G'''  "
        strSql += vbCrLf + "   EXEC(@STRQRYVAL)      "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "   FETCH NEXT FROM RESCUR INTO @FROMVALUE,@TOVALUE   "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + " CLOSE RESCUR  "
        strSql += vbCrLf + " DEALLOCATE RESCUR  "
        strSql += vbCrLf + " SELECT * FROM #_REPRES  ORDER BY COLHEAD,[ADV.BILL DATE],[CUSTOMER NAME]  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_NEWCUSTOMEROUTSTANDING_ACCODE_MONTH()
