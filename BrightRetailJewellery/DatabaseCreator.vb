        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' AND A.TRANDATE BETWEEN '''+ @FROMDATE+''' AND '''+ @TODATE +''' AND A.CASHPOINTID <> '''' AND ISNULL(A.CANCEL,'''')<>''Y'' '"
        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+@COMFILTER+@COSTFILTER1 + 'GROUP BY A.TRANNO,A.TRANDATE,A.USERID,A.TRANMODE,A.PAYMODE,A.BATCHNO,U.USERNAME' "
