        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP_OUT_COMPANY (COMPANYID) SELECT @COMPANYID       "
        strSql += vbCrLf + "  WHILE CHARINDEX(',',@COMPANYID)>0       "
        strSql += vbCrLf + "  BEGIN       "
        strSql += vbCrLf + "  SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)       "
        strSql += vbCrLf + "  SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))       "
        strSql += vbCrLf + "  IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + "  SET @COMPANYID= @COMPANYID + ','       "
        strSql += vbCrLf + "  INSERT INTO TEMPTABLEDB..TEMP_OUT_COMPANY (COMPANYID) SELECT @TCOMPANY       "
        strSql += vbCrLf + "  END	"
        strSql += vbCrLf + "  SELECT @QRY= ' IF OBJECT_ID(''TEMPTABLEDB..TEMP_OUTSTANDING'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING   '"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' IF OBJECT_ID(''TEMPTABLEDB..TEMP_CROUTSTANDING'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_CROUTSTANDING'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,O.RUNNO,CONVERT(VARCHAR(50),O.TRANTYPE)TRANTYPE,O.TRANNO,O.TRANDATE'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,AMOUNT,RECPAY'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,CONVERT(NUMERIC(15,2),NULL)BALANCE'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,(P.INITIAL+'' ''+P.PNAME) NAME,O.REMARK1 AS REMARK,P.MOBILE'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,CONVERT(NUMERIC,NULL) CTRANNO,CONVERT(SMALLDATETIME,NULL)CTRANDATE,P.AREA'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = O.COSTID)AS COSTNAME'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD,CONVERT(INT,1)AREAORD'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,O.COSTID,O.BATCHNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ,O.COMPANYID,CONVERT(VARCHAR(12),NULL)LASTTRANDATE,O.REMARK1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' INTO TEMPTABLEDB..TEMP_OUTSTANDING'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM  OUTSTANDING AS O'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' INNER JOIN CUSTOMERINFO AS CU ON CU.BATCHNO = O.BATCHNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' INNER JOIN PERSONALINFO AS P ON P.SNO = CU.PSNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' WHERE O.TRANDATE < ''' + @TODATE + ''' AND O.TRANTYPE=''A'''"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' AND ISNULL(O.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMP_OUT_COSTCENTRE)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' AND ISNULL(O.CANCEL,'''') = ''''  AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMP_OUT_COMPANY)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ORDER BY O.RUNNO'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET TRANTYPE = ''J'''"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' WHERE RUNNO IN (SELECT RUNNO FROM  OUTSTANDING O WHERE EXISTS (SELECT 1 FROM ITEMDETAIL WHERE BATCHNO = O.BATCHNO AND RUNNO=O.RUNNO))'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' UPDATE A SET TRANTYPE = ''O'',REMARK=(SELECT ITEMNAME FROM  ITEMMAST WHERE ITEMID IN (SELECT TOP 1 ITEMID FROM  ORMAST WHERE BATCHNO=A.BATCHNO)) '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_OUTSTANDING A WHERE SUBSTRING(RUNNO,6,1) = ''O'''"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' UPDATE A SET REMARK=(SELECT ITEMNAME FROM  ITEMMAST WHERE ITEMID IN (SELECT TOP 1 ITEMID FROM '+ @DBNAME +'..ISSUE WHERE BATCHNO=A.BATCHNO)) '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_OUTSTANDING A WHERE SUBSTRING(RUNNO,6,1) = ''D'''"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' DELETE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE TRANTYPE NOT IN (''A'')'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' SELECT 0 AS SNO,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' RUNNO,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' (SELECT TOP 1 NAME FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=T.RUNNO)NAME,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' (SELECT TOP 1 TRANDATE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=T.RUNNO AND RECPAY=''R'')TRANDATE,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DATEPART(YEAR,(SELECT TOP 1 TRANDATE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=T.RUNNO AND RECPAY=''R''))TRANYEAR,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DATEPART(MONTH,(SELECT TOP 1 TRANDATE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RUNNO=T.RUNNO AND RECPAY=''R''))TRANMONTH,'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SUM(CASE WHEN RECPAY=''R'' THEN AMOUNT ELSE -1*AMOUNT END)AMOUNT,1 AS RESULT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' INTO TEMPTABLEDB..TEMP_CROUTSTANDING'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_OUTSTANDING AS T'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' GROUP BY RUNNO HAVING SUM(CASE WHEN RECPAY=''R'' THEN AMOUNT ELSE -1*AMOUNT END) <> 0'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' ORDER BY RUNNO'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPTABLEDB..TEMP_MNOUTSTANDING', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_MNOUTSTANDING	"
        strSql += vbCrLf + "  SELECT @QRY= ' SELECT * INTO TEMPTABLEDB..TEMP_MNOUTSTANDING FROM TEMPTABLEDB..TEMP_CROUTSTANDING WHERE TRANDATE BETWEEN ''' + @FROMDATE + ''' AND ''' + @TODATE + ''''"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	  "
        strSql += vbCrLf + "  SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMP_MNOUTSTANDING (TRANYEAR,TRANMONTH,NAME,SNO,RESULT)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SELECT '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DISTINCT TRANYEAR,TRANMONTH,UPPER(DATENAME(MONTH,DATEADD(MONTH,TRANMONTH,0)-1))NAME,0 AS SNO,0 AS RESULT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_MNOUTSTANDING WHERE ISNULL(RESULT,0)=1 '"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMP_MNOUTSTANDING (TRANYEAR,TRANMONTH,NAME,AMOUNT,SNO,RESULT)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SELECT '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DISTINCT TRANYEAR,TRANMONTH,UPPER(DATENAME(MONTH,DATEADD(MONTH,TRANMONTH,0)-1))NAME,SUM(AMOUNT)AMOUNT,9999 AS SNO,2 AS RESULT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_MNOUTSTANDING WHERE ISNULL(RESULT,0)=1 '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' GROUP BY TRANYEAR,TRANMONTH'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "  SELECT @QRY= ' INSERT INTO TEMPTABLEDB..TEMP_MNOUTSTANDING (TRANYEAR,TRANMONTH,NAME,AMOUNT,SNO,RESULT)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SELECT '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' 9999,9999,''GRAND TOTAL'' NAME,SUM(AMOUNT)AMOUNT,9999 AS SNO,3 AS RESULT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_MNOUTSTANDING WHERE ISNULL(RESULT,0)=1 '"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  SELECT @QRY= ' DECLARE @TRANYEAR INT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DECLARE @TRANMONTH INT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DECLARE CUR CURSOR FOR  SELECT DISTINCT TRANYEAR,TRANMONTH FROM TEMPTABLEDB..TEMP_MNOUTSTANDING'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' OPEN CUR '"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FETCH NEXT FROM CUR INTO @TRANYEAR,@TRANMONTH'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' WHILE @@FETCH_STATUS=0'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' BEGIN'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' PRINT @TRANYEAR'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' PRINT @TRANMONTH'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DECLARE @SNO INT'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DECLARE @RUNNO VARCHAR(20)'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DECLARE CUR1 CURSOR FOR  SELECT DISTINCT RUNNO FROM TEMPTABLEDB..TEMP_MNOUTSTANDING WHERE TRANYEAR=@TRANYEAR AND TRANMONTH=@TRANMONTH AND RESULT=1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' OPEN CUR1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SET @SNO = 1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FETCH NEXT FROM CUR1 INTO @RUNNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' WHILE @@FETCH_STATUS=0'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' BEGIN'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' UPDATE TEMPTABLEDB..TEMP_MNOUTSTANDING SET SNO=@SNO WHERE RUNNO=@RUNNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' PRINT @RUNNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' PRINT @SNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' SET @SNO = @SNO + 1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FETCH NEXT FROM CUR1 INTO @RUNNO'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' END'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' CLOSE CUR1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DEALLOCATE CUR1'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' FETCH NEXT FROM CUR INTO @TRANYEAR,@TRANMONTH'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' END'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' CLOSE CUR'"
        strSql += vbCrLf + "  SELECT @QRY= @QRY + CHAR(13)+ ' DEALLOCATE CUR'"
        strSql += vbCrLf + "  PRINT @QRY"
        strSql += vbCrLf + "  EXEC(@QRY)	"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_NEWCUSTOMEROUTSTANDING()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_NEWCUSTOMEROUTSTANDING')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_NEWCUSTOMEROUTSTANDING"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_NEWCUSTOMEROUTSTANDING"
        strSql += vbCrLf + "     (  "
        strSql += vbCrLf + "     @DBNAME VARCHAR(13)  "
        strSql += vbCrLf + "     ,@FROMDATE VARCHAR(13)  "
        strSql += vbCrLf + "     ,@TODATE VARCHAR(13)  "
        strSql += vbCrLf + "     ,@DISPLAY VARCHAR(1)  "
        strSql += vbCrLf + "     ,@SUMMARY VARCHAR(1)  "
        strSql += vbCrLf + "     ,@ORDERBY VARCHAR(1)  "
        strSql += vbCrLf + "     ,@FILTERBY VARCHAR(50)  "
        strSql += vbCrLf + "     ,@FILTERCAPTION VARCHAR(50)  "
        strSql += vbCrLf + "     ,@SYSID VARCHAR(3)"
        strSql += vbCrLf + "     ,@COSTNAME VARCHAR(50)  "
        strSql += vbCrLf + "     ,@COMPANYID VARCHAR(5000)  "
        strSql += vbCrLf + "     ,@TYPEID VARCHAR(50)  "
        strSql += vbCrLf + "     ,@GRPAREA VARCHAR(1)  "
        strSql += vbCrLf + "     ,@ACFILTER VARCHAR(2)  "
        strSql += vbCrLf + "     ,@ACGROUP VARCHAR(500)  "
        strSql += vbCrLf + "     ,@ALLCODE VARCHAR(1) "
        strSql += vbCrLf + "     ,@ACNAME VARCHAR(500)  "
        strSql += vbCrLf + "     ,@ORDERSUMMARY VARCHAR(1)"
        strSql += vbCrLf + "     )  "
        strSql += vbCrLf + "     AS  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "      DECLARE @QRY VARCHAR(8000)  "
        strSql += vbCrLf + "      DECLARE @ACCFILTER AS VARCHAR(500)  "
        strSql += vbCrLf + "      DECLARE @ACCCFILTER AS VARCHAR(500)  "
        strSql += vbCrLf + "  	DECLARE @OPDATE AS VARCHAR(13)"
        strSql += vbCrLf + "  	IF @FROMDATE = '1900-01-01'"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  		SET @OPDATE=CONVERT(char(10),DATEADD(DAY,0,@TODATE),126)"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SET @OPDATE=@FROMDATE"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "      SET @QRY=''   "
        strSql += vbCrLf + "      SET @ACCFILTER=''  "
        strSql += vbCrLf + "      SET @ACCCFILTER=''  "
        strSql += vbCrLf + "      IF @ACFILTER='A' SELECT @ACCFILTER=' AND O.ACCODE=''ADVANCE'''  "
        strSql += vbCrLf + "      IF @ACFILTER='O' SELECT @ACCFILTER=' AND O.ACCODE=''ADVORD'''  "
        strSql += vbCrLf + "      IF @ACFILTER='D' AND @TYPEID='D,'   "
        strSql += vbCrLf + "      BEGIN  "
        strSql += vbCrLf + "       SELECT @ACCCFILTER='AND O.FROMFLAG=''P'' '  "
        strSql += vbCrLf + "       /*SELECT @ACCCFILTER='AND O.ACCODE IN(SELECT ACCODE FROM ACHEAD WHERE ACTYPE=''C'')'*/  "
        strSql += vbCrLf + "      END  "
        strSql += vbCrLf + "      ELSE  "
        strSql += vbCrLf + "       IF @ACFILTER='D' SELECT @ACCFILTER=' AND O.ACCODE=''DRS'''  "
        strSql += vbCrLf + "      IF @ACGROUP <> 'ALL'  "
        strSql += vbCrLf + "      BEGIN  "
        strSql += vbCrLf + "       EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ACGROUP',@CHK_FEILD = 'ACGRPCODE',@RESULT_TBL = 'TEMPACGROUP',@INPUTVALUES = @ACGROUP"
        strSql += vbCrLf + "      END  "
        strSql += vbCrLf + "      IF @ACNAME  <> 'ALL' "
        strSql += vbCrLf + "     	BEGIN"
        strSql += vbCrLf + "     	  SET @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMPACHEAD'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD'+@SYSID+''    "
        strSql += vbCrLf + "     	  PRINT @QRY"
        strSql += vbCrLf + "     	  EXEC (@QRY)"
        strSql += vbCrLf + "     	  SET @QRY = 'SELECT ACCODE INTO TEMPTABLEDB..TEMPACHEAD'+@SYSID+' FROM ACHEAD WHERE ACNAME = ''' +@ACNAME +''''"
        strSql += vbCrLf + "     	  PRINT @QRY"
        strSql += vbCrLf + "     	  EXEC (@QRY)"
        strSql += vbCrLf + "     	END"
        strSql += vbCrLf + "     	ELSE IF @ACNAME  = 'ALL' OR @ACNAME = ''"
        strSql += vbCrLf + "     	BEGIN"
        strSql += vbCrLf + "     	  SET @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMPACHEAD'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPACHEAD'+@SYSID+''  "
        strSql += vbCrLf + "     	  PRINT @QRY "
        strSql += vbCrLf + "     	  EXEC (@QRY)"
        strSql += vbCrLf + "     	  SET @QRY = 'SELECT ACCODE INTO TEMPTABLEDB..TEMPACHEAD'+@SYSID+' FROM ACHEAD '"
        strSql += vbCrLf + "     	  IF (@ACGROUP<>'ALL' AND @ACGROUP <>'')  "
        strSql += vbCrLf + "     		BEGIN  "
        strSql += vbCrLf + "     			SELECT @QRY= @QRY + ' WHERE ACCODE IN '"
        strSql += vbCrLf + "     			SELECT @QRY= @QRY + '  (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM ACGROUP '"
        strSql += vbCrLf + "     			SELECT @QRY= @QRY + '  WHERE ACGRPNAME IN( SELECT COMPANYID FROM TEMPACGROUP)))'"
        strSql += vbCrLf + "     		END				"
        strSql += vbCrLf + "     	  PRINT @QRY"
        strSql += vbCrLf + "     	  EXEC (@QRY)"
        strSql += vbCrLf + "     	END "
        strSql += vbCrLf + "      IF OBJECT_ID('TEMPTABLEDB..TEMP_OUT_COSTCENTRE', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE         "
        strSql += vbCrLf + "      CREATE TABLE TEMPTABLEDB..TEMP_OUT_COSTCENTRE(COSTID VARCHAR(3))       "
        strSql += vbCrLf + "      IF @COSTNAME = 'ALL' OR @COSTNAME = ''       "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TEMP_OUT_COSTCENTRE SELECT COSTID FROM COSTCENTRE UNION ALL SELECT ''       "
        strSql += vbCrLf + "      ELSE       "
        strSql += vbCrLf + "       INSERT INTO TEMPTABLEDB..TEMP_OUT_COSTCENTRE SELECT COSTID FROM COSTCENTRE WHERE COSTNAME = @COSTNAME       "
