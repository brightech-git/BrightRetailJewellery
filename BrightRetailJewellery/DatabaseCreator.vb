        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,SUM(AMOUNT) AS AMOUNT,SUM(DIAWT) AS DIAWT,'' ''FLAG,CASE WHEN RESULT=''6'' THEN ''7'' ELSE ''2'' END RESULT,'' ''TRANDATE,'' ''TRANNO,''S'' AS COLHEAD,'''' SEP'  "
        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COUNTERREPORT   WHERE RESULT IN(''1'',''6'') GROUP BY ITEMNAME,RESULT)'  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' (BILLNO,BILLDATE,ITEMNAME,SUBITEMNAME,PCS,GRSWT,LESSWT,NETWT,AMOUNT,DIAWT'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,FLAG,RESULT,TRANDATE,TRANNO,COLHEAD,SEP)'  "
