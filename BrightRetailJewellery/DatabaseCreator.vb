    Private Sub Sp_InsertTagsOrIdDetail()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='Sp_InsertTagsOrIdDetail')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE Sp_InsertTagsOrIdDetail"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE Sp_InsertTagsOrIdDetail"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @TAGSNO VARCHAR(15)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#ITEMTAG','U') IS NOT NULL DROP TABLE #ITEMTAG"
        strSql += vbCrLf + " SELECT * INTO #ITEMTAG FROM " & cnAdminDb & "..ITEMTAG WHERE SNO = @TAGSNO"
        strSql += vbCrLf + " IF NOT (SELECT COUNT(*) FROM #ITEMTAG WHERE ISNULL(ORDREPNO,'') <> '' AND ISNULL(ORSNO,'')<>'')>0 GOTO AFTERORIRINS"

        strSql += vbCrLf + " DECLARE @pCOSTID VARCHAR(2)"
        strSql += vbCrLf + " DECLARE @pBILLDATE SMALLDATETIME"
        strSql += vbCrLf + " DECLARE @pCOMPANYID VARCHAR(3)"
        strSql += vbCrLf + " SELECT @pCOSTID = COSTID,@pBILLDATE = RECDATE,@pCOMPANYID = COMPANYID FROM #ITEMTAG"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..ORIRDETAIL AS IR"
        strSql += vbCrLf + " 	INNER JOIN #ITEMTAG AS INS ON INS.ORSNO = IR.ORSNO "
        strSql += vbCrLf + " 	WHERE IR.ORSTATUS = 'R' AND IR.ORDSTATE_ID = 4	AND IR.COSTID = @pCOSTID "
        strSql += vbCrLf + " 	)>0 GOTO AFTERORIRINS"

        strSql += vbCrLf + " DECLARE @pBATCHNO VARCHAR(15)"
        strSql += vbCrLf + " EXEC " & tranDbName & "..GET_BATCHNO"
        strSql += vbCrLf + " @COSTID = @pCOSTID "
        strSql += vbCrLf + " ,@BILLDATE = @pBILLDATE "
        strSql += vbCrLf + " ,@COMPANYID = @pCOMPANYID "
        strSql += vbCrLf + " ,@RETVALUE = @pBATCHNO OUTPUT"

        strSql += vbCrLf + "  DECLARE @pSNO VARCHAR(15)"
        strSql += vbCrLf + "  EXEC " & tranDbName & "..GET_ADMINSNO_TRAN"
        strSql += vbCrLf + "  @COSTID = @pCOSTID"
        strSql += vbCrLf + "  ,@CTLID = 'ORIRDETAILCODE'"
        strSql += vbCrLf + "  ,@CHECKTABLENAME = 'ORIRDETAIL'"
        strSql += vbCrLf + "  ,@COMPANYID = @pCOMPANYID"
        strSql += vbCrLf + "  ,@RETVALUE = @pSNO OUTPUT"

        strSql += vbCrLf + " DECLARE @pENTRYORDER INT"
        strSql += vbCrLf + " SELECT @pENTRYORDER = ISNULL(MAX(ENTRYORDER),0)+1 FROM " & compId & "ADMINDB..ORIRDETAIL"
        strSql += vbCrLf + " DECLARE @pTRANNO INT "
        strSql += vbCrLf + " SELECT @pTRANNO = ISNULL(MAX(CTLTEXT),0)+1 FROM " & tranDbName & "..BILLCONTROL WHERE CTLID  = 'ORDIRBILLNO' AND COMPANYID = @pCOMPANYID"
        strSql += vbCrLf + " /** Inserting OrIrDetail **/"
        strSql += vbCrLf + " INSERT INTO " & compId & "ADMINDB..ORIRDETAIL"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " SNO,ORSNO,TRANNO,TRANDATE,DESIGNERID"
        strSql += vbCrLf + " ,PCS,GRSWT,NETWT,WASTAGE,MC"
        strSql += vbCrLf + " ,TAGNO,ORSTATUS,CANCEL,COSTID,DESCRIPT,ORNO,BATCHNO,USERID,UPDATED,UPTIME"
        strSql += vbCrLf + " ,APPVER,COMPANYID,TRANSFERED,ORDSTATE_ID,ENTRYORDER,CATCODE"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " SELECT "
        strSql += vbCrLf + " @pSNO AS SNO,ORSNO,@pTRANNO AS TRANNO,RECDATE AS TRANDATE,DESIGNERID"
        strSql += vbCrLf + " ,PCS,GRSWT,NETWT,MAXWAST AS WASTAGE,MAXMC AS MC"
        strSql += vbCrLf + " ,TAGNO,'R' AS ORSTATUS,''CANCEL,COSTID,NARRATION,ORDREPNO AS ORNO,@pBATCHNO AS BATCHNO,USERID,UPDATED,UPTIME"
        strSql += vbCrLf + " ,APPVER,COMPANYID,''TRANSFERED,4 AS ORDSTATE_ID,@pENTRYORDER ENTRYORDER,(SELECT CATCODE FROM " & compId & "ADMINDB..ITEMMAST WHERE ITEMID = T.ITEMID)AS CATCODE"
        strSql += vbCrLf + " FROM #ITEMTAG AS T"
        strSql += vbCrLf + " AFTERORIRINS:"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub funcSpCashPoint_BillInfo()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_CASHPOINT_BILLINFO')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_CASHPOINT_BILLINFO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_CASHPOINT_BILLINFO  "
        strSql += vbCrLf + " (  "
        strSql += vbCrLf + " @TRANDATE SMALLDATETIME  "
        strSql += vbCrLf + " ,@TRANNO INT  "
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " AS  "
        strSql += vbCrLf + " SET NOCOUNT ON  "
        strSql += vbCrLf + " -- -- DECLARE @TRANDATE SMALLDATETIME  "
        strSql += vbCrLf + " -- -- DECLARE @TRANNO INT  "
        strSql += vbCrLf + " -- -- SET @TRANDATE = '2010-12-20'  "
        strSql += vbCrLf + " -- -- SET @TRANNO = 1293  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#GETBILLINFO') IS NOT NULL DROP TABLE #GETBILLINFO  "
        strSql += vbCrLf + "  SELECT DISTINCT     "
        strSql += vbCrLf + "   CONVERT(VARCHAR(500),NULL)AS [DESCRIPTION]  "
        strSql += vbCrLf + "   ,PE.SNO,PE.PNAME,@TRANNO AS TRANNO  "
        strSql += vbCrLf + "   ,CASE WHEN T.PAYMODE IN ('SA','SV') THEN 'SALES'  "
        strSql += vbCrLf + "   WHEN T.PAYMODE IN ('SR','RV') THEN 'RETURN'    "
        strSql += vbCrLf + "   WHEN T.PAYMODE IN ('PU','PV')THEN 'PURCHASE'    "
        strSql += vbCrLf + "   WHEN T.PAYMODE IN ('DR','AR','MR','HR','OR') THEN 'RECEIPT'    "
        strSql += vbCrLf + "   WHEN T.PAYMODE IN ('DP','AP','MP','HP') THEN 'PAYMENT'    "
        strSql += vbCrLf + "   ELSE T.PAYMODE END AS TRANTYPE"
        strSql += vbCrLf + "   ,T.BATCHNO  "
        strSql += vbCrLf + "   INTO #GETBILLINFO    "
        strSql += vbCrLf + "  FROM " & tranDbName & "..ACCTRAN T   "
        strSql += vbCrLf + "  INNER JOIN " & tranDbName & "..ACCTRAN AS TE ON TE.TRANDATE = @TRANDATE AND TE.TRANNO = @TRANNO AND TE.TRANDATE = T.TRANDATE AND TE.BATCHNO = T.BATCHNO   "
        strSql += vbCrLf + "  LEFT OUTER JOIN " & compId & "ADMINDB..CustomerInfo AS CU ON CU.BATCHNO = T.BATCHNO  "
        strSql += vbCrLf + "  LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO AS PE ON PE.SNO = CU.PSNO  "
        strSql += vbCrLf + " -- WHERE EXISTS (SELECT 1 FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE = @TRANDATE AND TRANNO = @TRANNO AND TRANDATE = T.TRANDATE)  "
        strSql += vbCrLf + " WHERE T.PAYMODE IN ('SA','SV','SR','RV','PU','PV'    "
        strSql += vbCrLf + "  ,'DR','AR','MR','HR','OR'    "
        strSql += vbCrLf + "  ,'DP','AP','MP','HP','HG','HB','HZ','HD'    "
        strSql += vbCrLf + "  )    "
        strSql += vbCrLf + "  ORDER BY T.BATCHNO,TRANTYPE DESC  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @STRCONCAT VARCHAR(500)  "
        strSql += vbCrLf + " DECLARE @TRANTYPE VARCHAR(25)  "
        strSql += vbCrLf + " DECLARE @BATCHNO VARCHAR(15)  "
        strSql += vbCrLf + " DECLARE @TBATCHNO VARCHAR(15)  "
        strSql += vbCrLf + " DECLARE CUR CURSOR FOR SELECT TRANTYPE,BATCHNO FROM #GETBILLINFO  "
        strSql += vbCrLf + " OPEN CUR  "
        strSql += vbCrLf + " WHILE 1=1  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "  FETCH NEXT FROM CUR INTO @TRANTYPE,@BATCHNO  "
        strSql += vbCrLf + "  IF @@FETCH_STATUS = -1 BREAK  "
        strSql += vbCrLf + "  IF ISNULL(@TBATCHNO,'') <> @BATCHNO  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   SET @TBATCHNO = @BATCHNO  "
        strSql += vbCrLf + "   SET @STRCONCAT = @TRANTYPE + ','  "
        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "  ELSE  "
        strSql += vbCrLf + "   BEGIN  "
        strSql += vbCrLf + "   SET @STRCONCAT = @STRCONCAT + @TRANTYPE + ','  "
        strSql += vbCrLf + "   END  "
        strSql += vbCrLf + "  UPDATE #GETBILLINFO SET [DESCRIPTION] = SUBSTRING(@STRCONCAT,1,LEN(@STRCONCAT)-1) WHERE BATCHNO = @BATCHNO  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + " CLOSE CUR  "
        strSql += vbCrLf + " DEALLOCATE CUR  "
        strSql += vbCrLf + " SELECT DISTINCT [DESCRIPTION],PNAME,BATCHNO,SNO FROM #GETBILLINFO  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSp31ApprovalSummary()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_APPROVALSUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_APPROVALSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_APPROVALSUMMARY "
