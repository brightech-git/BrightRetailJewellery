        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,CASE WHEN ISNULL(H.LOCALOUTST,'''')=''O'' THEN CASE WHEN '''+@INVAT+'''=''I'' THEN 0'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ELSE R.TAX-ISNULL((SELECT SUM(TAX) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0) END'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ELSE 0 END CTAX'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,DATENAME(MONTH,R.TRANDATE)AS MMONTHNAME'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,CONVERT(INT,CONVERT(VARCHAR,DATEPART(YEAR,R.TRANDATE))+REPLICATE(''0'',2-LEN((DATEPART(MONTH,R.TRANDATE)))) + CONVERT(VARCHAR,DATEPART(MONTH,R.TRANDATE)))AS MMONTHID'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,C.CATNAME,CASE WHEN ISNULL(R.ACCODE,'''') <> '''' THEN H.ACNAME ELSE P.PNAME END AS ACNAME'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,H.TIN,H.CENTRALTAXNO,R.SNO,R.COSTID,R.ACCODE,R.CANCEL'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,CONVERT(VARCHAR(300),NULL)GROUP1'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,CONVERT(VARCHAR(300),NULL)GROUP2'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ,(CASE WHEN ISNULL(H.ADDRESS1,'''')<>'''' THEN H.ADDRESS1 +'','' ELSE '''' END'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' + CASE WHEN ISNULL(H.ADDRESS2,'''')<>'''' THEN CHAR(13)+ H.ADDRESS2 +'','' ELSE '''' END'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' + CASE WHEN ISNULL(H.ADDRESS3,'''')<>'''' THEN CHAR(13)+ H.ADDRESS3 +'','' ELSE '''' END'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' + CASE WHEN ISNULL(H.AREA,'''')<>'''' THEN CHAR(13)+ H.AREA +'','' ELSE '''' END' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' + CASE WHEN ISNULL(H.CITY,'''')<>'''' THEN CHAR(13)+ H.CITY ELSE '''' END'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' + CASE WHEN ISNULL(H.PINCODE,'''')<>'''' THEN ''-''+ H.PINCODE ELSE '''' END) ADDRESS,''''TYPE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' FROM RECEIPT R'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' INNER JOIN '+@DBNAME+'..CATEGORY AS C ON C.CATCODE = R.CATCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' LEFT OUTER JOIN '+@DBNAME+'..ACHEAD AS H ON H.ACCODE = R.ACCODE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' LEFT OUTER JOIN '+@DBNAME+'..CUSTOMERINFO AS CU ON CU.BATCHNO = R.BATCHNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' LEFT JOIN '+@DBNAME+'..PERSONALINFO AS P ON P.SNO = CU.PSNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' WHERE R.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' AND ISNULL(R.CANCEL,'''') = '''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' AND R.CATCODE IN (SELECT CATCODE FROM TEMPTABLEDB..TEMPCATEGORY)'"
