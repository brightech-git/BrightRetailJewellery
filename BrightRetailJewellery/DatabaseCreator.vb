        strSql += vbCrLf + "      			SELECT @QRY=@QRY + CHAR(13) +' ,0 PGRSWT,0 PNETWT,0 PSTNWT,0 PDIAWT,0 PAMOUNT,NULL SRBILLNO,NULL SRITEMID,0 SRGRSWT,0 SRNETWT,0 SRSTNWT,0 SRDIAWT,0 SRRATE, 0 SRMCHARGE,0 SRWASTVAL,0 SRWASTAGE,0 SRTAX'    "
        strSql += vbCrLf + "      			SELECT @QRY=@QRY + CHAR(13) +' ,0 SRTOTAL,0 SRBALANCE,0 CASH,0 CRCARD,0 CHEQUE,0 CHIT,0 ADVANCE,0 GV,0 HC,0 DISCOUNT, 0 CRBALANCE,0 ACTOTAL,I.CASHID,I.BATCHNO,''I'' COLHEAD'    "
        strSql += vbCrLf + "      			SELECT @QRY=@QRY + CHAR(13) +' ,METALID FROM ISSUE AS I '    "
        strSql += vbCrLf + "      			SELECT @QRY=@QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND ''' + @TODATE + ''' AND I.TRANTYPE IN(''SA'',''OD'') AND ISNULL(I.CANCEL,'''')='''' '    "
        strSql += vbCrLf + "      			IF @COSTID<>'ALL' SELECT  @QRY=@QRY+' AND I.COSTID IN('''+ @COSTID +''')'    "
