        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHERE A.PAYMODE IN (''CR'')'    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +'GROUP BY A.TRANDATE,A.PAYMODE,A.BILLTYPE,ACNAME,PARTICULARS,PAYHEAD,ORDERNO '  "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' UNION ALL '  "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' SELECT CONVERT(VARCHAR(11),A.TRANDATE,106) AS DATE,PAYHEAD,'    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' CASE  WHEN A.PAYMODE =''AP'' THEN ''ADV PAY'''    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''DU'' THEN ''DUE BILL '''     "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''CH'' THEN ''CHQ. REC'''    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''CP'' THEN ''CASH PAY'''    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''GV'' THEN ''GV REC'''    "
        'strSql += vbCrLf + "    SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''OP'' THEN '''''    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' WHEN A.PAYMODE =''ZZ'' THEN ''ZZ'''    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' ELSE ''OTHER'' END PAYMODE'    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' ,A.TRANNO,ISNULL(B.ACNAME,A.PARTICULARS) AS PARTICULARS,PNAME PARTYNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,CASE WHEN A.PAYMODE=''OP'' THEN ''S1'' ELSE '''' END COLHEAD,ORDERNO FROM '+@TEMPTABLE+' A '    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' LEFT JOIN ACHEAD B ON A.ACCODE = B.ACCODE '    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' LEFT JOIN CUSTOMERINFO AS CINF ON A.BATCHNO = CINF.BATCHNO'    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' LEFT JOIN PERSONALINFO AS PINF ON PINF.SNO = CINF.PSNO '    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' WHERE A.PAYMODE IN (''ZZ'',''DU'',''CH'',''CP'',''MP'',''GV'',''OP'',''CT'',''JE'',''CC'',''CA'')'    "
        'strSql += vbCrLf + "     SELECT @QUERY =@QUERY +' ORDER BY A.ORDERNO,A.TRANNO'    "
        'strSql += vbCrLf + "     End    "
        'strSql += vbCrLf + "     PRINT @QUERY    "
        'strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY     "
        'strSql += vbCrLf + "     SET @QUERY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''DAYBOOK2'')'    "
        'strSql += vbCrLf + "     +    "
        'strSql += vbCrLf + "     'DROP TABLE TEMPTABLEDB..DAYBOOK2'    "
        'strSql += vbCrLf + "     PRINT @QUERY    "
        'strSql += vbCrLf + "     EXECUTE SP_EXECUTESQL @QUERY    "
        'strSql += vbCrLf + "     DECLARE @PAYHEAD VARCHAR(50)     "
        'strSql += vbCrLf + "      DECLARE @ORDERNO VARCHAR(50)    "
        'strSql += vbCrLf + "      SELECT * INTO  TEMPTABLEDB..DAYBOOK2 FROM TEMPTABLEDB..DAYBOOK1    "
        'strSql += vbCrLf + "      DELETE FROM TEMPTABLEDB..DAYBOOK2    "
        'strSql += vbCrLf + "      INSERT INTO TEMPTABLEDB..DAYBOOK2(TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO)SELECT  CONVERT(VARCHAR(13),TRANDATE,103) AS TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO FROM TEMPTABLEDB..DAYBOOK1 WHERE PARTICULARS='CASH OPENING'    "
        'strSql += vbCrLf + "      DECLARE CUR CURSOR FOR SELECT PAYHEAD,ORDERNO FROM TEMPTABLEDB..DAYBOOK1 WHERE PAYHEAD<>''  GROUP BY PAYHEAD,ORDERNO ORDER BY ORDERNO     "
        'strSql += vbCrLf + "      OPEN CUR    "
        'strSql += vbCrLf + "      IF @@CURSOR_ROWS > 0"
        'strSql += vbCrLf + "      BEGIN     "
        'strSql += vbCrLf + "      WHILE 1 = 1     "
        'strSql += vbCrLf + "      BEGIN     "
        'strSql += vbCrLf + "             FETCH NEXT FROM CUR INTO @PAYHEAD,@ORDERNO    "
        'strSql += vbCrLf + "        IF @@FETCH_STATUS = -1 BREAK     "
        'strSql += vbCrLf + "                    INSERT INTO TEMPTABLEDB..DAYBOOK2(PAYHEAD,ORDERNO) SELECT @PAYHEAD,@ORDERNO    "
        'strSql += vbCrLf + "             INSERT INTO TEMPTABLEDB..DAYBOOK2(TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO)SELECT  CONVERT(VARCHAR(13),TRANDATE,103) AS TRANDATE,PAYMODE,TRANNO,PARTICULARS,PNAME,JDEBIT,JCREDIT,DEBIT,CREDIT,COLHEAD,ORDERNO FROM TEMPTABLEDB..DAYBOOK1 WHERE PAYHEAD=@PAYHEAD AND ORDERNO=@ORDERNO"
        'strSql += vbCrLf + "    END     "
        'strSql += vbCrLf + "    END     "
        'strSql += vbCrLf + "    CLOSE CUR    "
        'strSql += vbCrLf + "    DEALLOCATE CUR     "
        'strSql += vbCrLf + "    SELECT @QUERY= ' SELECT * FROM TEMPTABLEDB..DAYBOOK2 WHERE ORDERNO<>'''' ORDER BY ORDERNO,TRANNO  '    "
        'strSql += vbCrLf + "    PRINT @QUERY    "
        'strSql += vbCrLf + "    EXECUTE SP_EXECUTESQL @QUERY     "
        'strSql += vbCrLf + "     ---EXECUTE SP_RPT_DAYBOOKWITHJOURNAL_NEW  'SENT1213','TTEMP','01-APR-2012','01-APR-2012','Y','SEN','','N'"
        'strSql += vbCrLf + "   End"
        'strSql += vbCrLf + ""


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Function funcSP9_InspectionSummary() As Integer
        strSql = " /* -- ============================================== */"
        strSql += vbCrLf + "  /* -- Store procedure for INSPECTION SUMMARY Report */"
        strSql += vbCrLf + "  /* -- ============================================== */"
        strSql += vbCrLf + "  /* -- **************************************************************************************** */"
        strSql += vbCrLf + "  /*  Intitial Authors :       */"
        strSql += vbCrLf + "  /*  Create   Date    : 09/09/2008      */"
        strSql += vbCrLf + "  /*  Purpose          : For INSPECTION SUMMARY REPORT      */"
        strSql += vbCrLf + "  /*  Refred Tables    : " & tranDbName & "..ISSUE," & tranDbName & "..RECEIPT */"
        strSql += vbCrLf + "  /*		     " & compId + suffix & "..ITEMMAST */"
        strSql += vbCrLf + "  /*  Refred Forms/Dll : MDIREPORT=>FRMINSPECTIONSUMMARYRPT */"
        strSql += vbCrLf + "  /*    -------------------/* --       */"
        strSql += vbCrLf + "  /*   Created/Modified            Modified                 Description       */"
        strSql += vbCrLf + "  /*    -------------------/* --    */"
        strSql += vbCrLf + "  /* ***************************************************************************************** */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql += vbCrLf + "  /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_INSPECTIONSUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_INSPECTIONSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Create store procedure */"
        strSql += vbCrLf + "  /* -- ======================= */"

        strSql = " CREATE PROCEDURE SP_RPT_INSPECTIONSUMMARY"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Declare Variables */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  (				"
        strSql += vbCrLf + "  		 @Date  VARCHAR(12)/* -- On Date */"
        strSql += vbCrLf + "  		,@CNCOMPANYID NVARCHAR(3)/* -- GIVE THE COMPANYID*/"
        strSql += vbCrLf + "  )AS"
        strSql += vbCrLf + "  /* -- ========================================================= */"
        strSql += vbCrLf + "  /* -- Take the Datas from ISSUE & RECEIPT Table with conditions  */"
        strSql += vbCrLf + "  /* -- ========================================================= */"
        strSql += vbCrLf + "  SELECT ITEMID"
        strSql += vbCrLf + "  ,(SELECT ITEMNAME FROM " & compId + suffix & "..ITEMMAST WHERE ITEMID = X.ITEMID)AS ITEMNAME"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  /* -- Take the Opening Condition datas */"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'O' THEN PCS ELSE 0 END)AS OPCS"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'O' THEN GRSWT ELSE 0 END)AS OGRSWT"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'O' THEN NETWT ELSE 0 END)AS ONETWT"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  /* -- Take the Issue Condition datas */"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'I' THEN PCS ELSE 0 END)AS IPCS"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'I' THEN GRSWT ELSE 0 END)AS IGRSWT"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'I' THEN NETWT ELSE 0 END)AS INETWT"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  /* -- Take the Receipt Conditon datas */"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN PCS ELSE 0 END)AS RPCS"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN GRSWT ELSE 0 END)AS RGRSWT"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN NETWT ELSE 0 END)AS RNETWT"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  /* -- Take the Closing Conditon datas */"
        strSql += vbCrLf + "  /* -- =============================== */"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN -1* PCS ELSE PCS END)AS CPCS"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN -1* GRSWT ELSE GRSWT END) AS CGRSWT"
        strSql += vbCrLf + "  ,SUM(CASE WHEN SEP = 'R' THEN -1* NETWT ELSE NETWT END)AS CNETWT"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  /* -- ============================================================================================= */"
        strSql += vbCrLf + "  /* -- Query for Take the datas from Issue table before the Particular date for Outstanding Conditon */"
        strSql += vbCrLf + "  /* -- ============================================================================================= */"
        strSql += vbCrLf + "  select 'O' SEP,ITEMID,PCS,GRSWT,NETWT FROM " & tranDbName & "..ISSUE"
        strSql += vbCrLf + "  WHERE TRANTYPE ='AI' AND TRANDATE < @DATE"
        strSql += vbCrLf + "  AND COMPANYID = @CNCOMPANYID"
        strSql += vbCrLf + "  and CONVERT(VARCHAR,SNO) NOT IN (SELECT REFNO FROM " & tranDbName & "..RECEIPT WHERE TRANTYPE='AR' AND TRANDATE < @DATE AND COMPANYID = @CNCOMPANYID)"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  /* -- =============================================================================== */"
        strSql += vbCrLf + "  /* -- Query for Take the datas from Issue table on Particular date for Issue Conditon */"
        strSql += vbCrLf + "  /* -- =============================================================================== */"
        strSql += vbCrLf + "  select 'I' SEP,ITEMID,PCS,GRSWT,NETWT FROM " & tranDbName & "..ISSUE"
        strSql += vbCrLf + "  WHERE TRANTYPE ='AI' AND TRANDATE=@DATE"
        strSql += vbCrLf + "  AND COMPANYID = @CNCOMPANYID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  /* -- =================================================================================== */"
        strSql += vbCrLf + "  /* -- Query for Take the datas from Receipt table on Particular date for Receipt Conditon */"
        strSql += vbCrLf + "  /* -- =================================================================================== */"
        strSql += vbCrLf + "  select 'R' SEP,ITEMID,PCS,GRSWT,NETWT FROM " & tranDbName & "..RECEIPT"
        strSql += vbCrLf + "  WHERE TRANTYPE='AR' AND TRANDATE =@DATE"
        strSql += vbCrLf + "  AND COMPANYID = @CNCOMPANYID"
        strSql += vbCrLf + "  )AS X"
        strSql += vbCrLf + "  GROUP BY ITEMID"
        strSql += vbCrLf + "  ORDER BY ITEMNAME"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- Execute Query */"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  EXEC SP_RPT_INSPECTIONSUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function funcSP8_InspectionOutstanding() As Integer
        strSql = " /* -- ================================================= */"
        strSql += vbCrLf + "  /* -- Store procedure for InspectionOutStanding Report */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql += vbCrLf + "  /* *************************************************************************************** */"
        strSql += vbCrLf + "  /*   Intitial Authors :       */"
