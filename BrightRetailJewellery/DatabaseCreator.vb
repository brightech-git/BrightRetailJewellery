        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [TOTAL-OCREDIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [TOTAL-TDEBIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [TOTAL-TCREDIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [TOTAL-CDEBIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [TOTAL-CCREDIT] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)         "
