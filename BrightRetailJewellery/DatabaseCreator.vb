        strSql += vbCrLf + "   SELECT @QRY = 'ALTER TABLE '+ @TEMPTABLE +'_ACCODE ADD [CLOSING] NUMERIC(15,2)DEFAULT 0 'PRINT @QRY EXEC (@QRY)"
