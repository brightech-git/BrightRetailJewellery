        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPFLAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPFLAG"
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPFLAG (FLAG VARCHAR(1))       "
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPFLAG(FLAG)       "
        strSql += vbCrLf + " 	SELECT 'C' UNION ALL  SELECT '' UNION ALL  SELECT NULL       "
        strSql += vbCrLf + " 	DECLARE @HIDEBACKOFFICE VARCHAR(1)       "
        strSql += vbCrLf + " 	SELECT @HIDEBACKOFFICE = CTLTEXT  FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE'       "
        strSql += vbCrLf + " 	IF ISNULL(@HIDEBACKOFFICE,'N') = 'N' INSERT INTO TEMPTABLEDB..TEMPFLAG(FLAG)SELECT 'B'       "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPMETAL (METALID VARCHAR(1))             "
        strSql += vbCrLf + " 	IF @METAL = 'ALL' OR @METAL = ''             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPMETAL(METALID)SELECT METALID FROM " & compId & "ADMINDB..METALMAST             "
        strSql += vbCrLf + " 	ELSE             "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMPMETAL(METALID)SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METAL             "
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMPCATEGORY (CATCODE VARCHAR(10))             "
        strSql += vbCrLf + " 	IF @CATNAME = 'ALL' OR @CATNAME = ''             "
