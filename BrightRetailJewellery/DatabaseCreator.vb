        strSql += vbCrLf + "  ,@WITHAPPROVAL VARCHAR(1)/*WITH APPROVAL ISSUE AND RECEIPT*/"
        strSql += vbCrLf + "  )   "
        strSql += vbCrLf + "  AS     "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + "          DECLARE @STRQRY VARCHAR(MAX)    "
        strSql += vbCrLf + "          IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY     "
