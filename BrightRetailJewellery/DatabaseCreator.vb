        strSql += vbCrLf + " 		,CONVERT(NUMERIC(15,2),NULL)BALANCE ,H.ACNAME NAME,H.MOBILE    "
        strSql += vbCrLf + " 		,(SELECT EMPNAME FROM EMPMASTER WHERE EMPID = O.EMPID)AS SALESPERSON    "
