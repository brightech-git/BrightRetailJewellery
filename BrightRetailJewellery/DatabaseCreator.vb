        strSql += vbCrLf + "  		SELECT METALNAME,TRANNO,REFNO,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD ,RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE ORDER BY METALNAME, RESULT,CONVERT(INT,TRANNO)"
