        strSql += vbCrLf + "    UPDATE #CHTCOLL1 SET POINTS = ISNULL(PV.POINTS,0)               "
        strSql += vbCrLf + "    ,BPOINTVALUES = ISNULL(PV.VALUE,0)               "
        strSql += vbCrLf + "    FROM #CHTCOLL1 TR               "
        strSql += vbCrLf + "    LEFT JOIN " & compId & "ADMINDB..PRIVILIGE  PV      "
        strSql += vbCrLf + "    ON TR.SCHEMEID=PV.SCHEMEID          "
        strSql += vbCrLf + "    WHERE SAMOUNT BETWEEN PV.FROMRANGE   AND PV.TORANGE AND  CUSTOMERTYPE ='I'        "
        strSql += vbCrLf + "    -- EMP"
        strSql += vbCrLf + "    IF OBJECT_ID('TEMPDB..#CHTCOLL2') IS NOT NULL DROP TABLE #CHTCOLL2 "
        strSql += vbCrLf + "    SELECT JOINDATE,ID.PREVILEGEID,SM.SCHEMEID,JOINDATE AS TRANDATE,       "
        strSql += vbCrLf + "    (SELECT SCHEMENAME FROM " & cnChitCompanyid & "SAVINGS..SCHEME WHERE SCHEMEID = SM.SCHEMEID) AS SCHEME,       "
        strSql += vbCrLf + "    (SELECT AMOUNT FROM " & cnChitCompanyid & "SAVINGS..INSAMOUNT WHERE SCHEMEID = SM.SCHEMEID AND GROUPCODE =SM.GROUPCODE  ) AS SAMOUNT,        "
        strSql += vbCrLf + "    CONVERT(NUMERIC(15,4),0) AS POINTS  ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES         "
        strSql += vbCrLf + "    INTO #CHTCOLL2 FROM " & cnChitCompanyid & "SAVINGS..SCHEMEMAST  SM,       "
        strSql += vbCrLf + "    " & cnChitCompanyid & "SAVINGS..EMPMASTER ID "
        strSql += vbCrLf + "    WHERE SM.IEMP=ID.EMPID   "
        strSql += vbCrLf + "    AND JOINDATE <=@TODATE "
        strSql += vbCrLf + "    DELETE #CHTCOLL2  WHERE PREVILEGEID =''     "
        strSql += vbCrLf + "    UPDATE #CHTCOLL2 SET POINTS = ISNULL(PV.POINTS,0)               "
        strSql += vbCrLf + "    ,BPOINTVALUES = ISNULL(PV.VALUE,0)               "
        strSql += vbCrLf + "    FROM #CHTCOLL2 TR               "
        strSql += vbCrLf + "    LEFT JOIN " & compId & "ADMINDB..PRIVILIGE  PV      "
        strSql += vbCrLf + "    ON TR.SCHEMEID=PV.SCHEMEID          "
        strSql += vbCrLf + "    WHERE SAMOUNT BETWEEN PV.FROMRANGE   AND PV.TORANGE AND  CUSTOMERTYPE ='E'        "
        strSql += vbCrLf + "    INSERT INTO #PRIVREP2 (TRANDATE,PARTICULAR,POINTS,BPOINTVALUES,REDEEMPOINTS,REDEEMPOINTVALUES,RESULT,COLHEAD)  "
        strSql += vbCrLf + "    SELECT JOINDATE,PREVILEGEID,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,0,0, 1 AS  RESULT,'D' AS COLHEAD"
        strSql += vbCrLf + "    FROM  #CHTCOLL "
        strSql += vbCrLf + "    GROUP BY JOINDATE,PREVILEGEID "
        strSql += vbCrLf + "    INSERT INTO #PRIVREP2 (TRANDATE,PARTICULAR,POINTS,BPOINTVALUES,REDEEMPOINTS,REDEEMPOINTVALUES,RESULT,COLHEAD)     "
        strSql += vbCrLf + "    SELECT JOINDATE,PREVILEGEID,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,0,0, 1 AS  RESULT,'D' AS COLHEAD"
        strSql += vbCrLf + "    FROM  #CHTCOLL1 "
        strSql += vbCrLf + "    GROUP BY JOINDATE,PREVILEGEID   "
        strSql += vbCrLf + "    INSERT INTO #PRIVREP2 (TRANDATE,PARTICULAR,POINTS,BPOINTVALUES,REDEEMPOINTS,REDEEMPOINTVALUES,RESULT,COLHEAD)  "
        strSql += vbCrLf + "    SELECT JOINDATE,PREVILEGEID,SUM(POINTS) AS POINTS,SUM(BPOINTVALUES) AS BPOINTVALUES,0,0, 1 AS  RESULT,'D' AS COLHEAD"
        strSql += vbCrLf + "    FROM  #CHTCOLL2 "
        strSql += vbCrLf + "    GROUP BY JOINDATE,PREVILEGEID   "
        strSql += vbCrLf + " END              "
        strSql += vbCrLf + " /* SCHEME COLLECTION*/"
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#REPORTRESULT') IS NOT NULL DROP TABLE #REPORTRESULT "
        strSql += vbCrLf + " SELECT  RP.PARTICULAR,(SELECT TOP 1 ACNAME  FROM " & compId & "ADMINDB..ACHEAD WHERE PREVILEGEID =RP.PARTICULAR) AS CUSTOMER   "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),(SELECT TOP 1 PREVILEGEPOINTS FROM " & tranDbName & "..OPENPREVILEGE WHERE PREVILEGEID =RP.PARTICULAR)) AS OPPOINTS "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS CURPOINTS "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS REDEEMPOINTS "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS CLOSINGPOINTS "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),(SELECT TOP 1 PREVILEGEVALUE FROM " & tranDbName & "..OPENPREVILEGE WHERE PREVILEGEID =RP.PARTICULAR)) AS OPPOINTSVALUE "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS CURPOINTSVALUE "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS REDEEMPOINTSVALUE "
        strSql += vbCrLf + " ,CONVERT(NUMERIC(15,4),0) AS CLOSINGPOINTSVALUE "
        strSql += vbCrLf + " ,(SELECT TOP 1 MOBILE  FROM " & compId & "ADMINDB..ACHEAD WHERE PREVILEGEID =RP.PARTICULAR) AS MOBILE"
        strSql += vbCrLf + " , 1 AS  RESULT,'D' AS COLHEAD"
        strSql += vbCrLf + " INTO #REPORTRESULT "
        strSql += vbCrLf + " FROM #PRIVREP2 RP      "
        strSql += vbCrLf + " GROUP BY PARTICULAR    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#_SRES') IS NOT NULL DROP TABLE #_SRES "
        strSql += vbCrLf + " SELECT PARTICULAR,SUM(POINTS)-SUM(REDEEMPOINTS) AS OPPOINTS,SUM(BPOINTVALUES) - SUM(REDEEMPOINTVALUES)  AS OPPOINTVALUES  "
        strSql += vbCrLf + " INTO #_SRES "
        strSql += vbCrLf + " FROM #PRIVREP2  WHERE TRANDATE < @FRMDATE GROUP BY PARTICULAR "
        strSql += vbCrLf + " UPDATE #REPORTRESULT SET #REPORTRESULT.OPPOINTS=#_SRES.OPPOINTS+#REPORTRESULT.OPPOINTS, "
        strSql += vbCrLf + " #REPORTRESULT.OPPOINTSVALUE=#_SRES.OPPOINTVALUES+#REPORTRESULT.OPPOINTSVALUE "
        strSql += vbCrLf + " FROM #REPORTRESULT, #_SRES  "
        strSql += vbCrLf + " WHERE #REPORTRESULT.PARTICULAR = #_SRES.PARTICULAR "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#_SRES1') IS NOT NULL DROP TABLE #_SRES1 "
        strSql += vbCrLf + " SELECT PARTICULAR,SUM(POINTS) AS POINTS,SUM(REDEEMPOINTS) AS REDEEMPOINTS,SUM(BPOINTVALUES) AS BPOINTVALUES , SUM(REDEEMPOINTVALUES)  AS REDEEMPOINTVALUES "
        strSql += vbCrLf + " INTO #_SRES1 "
        strSql += vbCrLf + " FROM #PRIVREP2   "
        strSql += vbCrLf + " WHERE TRANDATE >=@FRMDATE "
        strSql += vbCrLf + " GROUP BY PARTICULAR "
        strSql += vbCrLf + " UPDATE #REPORTRESULT SET #REPORTRESULT.CURPOINTS=#_SRES1.POINTS, "
        strSql += vbCrLf + " #REPORTRESULT.CURPOINTSVALUE=#_SRES1.BPOINTVALUES, "
        strSql += vbCrLf + " #REPORTRESULT.REDEEMPOINTS=#_SRES1.REDEEMPOINTS, "
        strSql += vbCrLf + " #REPORTRESULT.REDEEMPOINTSVALUE=#_SRES1.REDEEMPOINTVALUES "
        strSql += vbCrLf + " FROM #REPORTRESULT, #_SRES1  "
        strSql += vbCrLf + " WHERE #REPORTRESULT.PARTICULAR = #_SRES1.PARTICULAR "
        strSql += vbCrLf + " UPDATE #REPORTRESULT SET CLOSINGPOINTS= (isnull(OPPOINTS,0) + isnull(CURPOINTS,0)) - isnull(REDEEMPOINTS,0) , "
        strSql += vbCrLf + " CLOSINGPOINTSVALUE =(isnull(OPPOINTSVALUE,0) + isnull(CURPOINTSVALUE,0))-isnull(REDEEMPOINTSVALUE,0) "
        strSql += vbCrLf + " INSERT INTO #REPORTRESULT (PARTICULAR,OPPOINTS,CURPOINTS,REDEEMPOINTS,CLOSINGPOINTS,OPPOINTSVALUE,CURPOINTSVALUE,REDEEMPOINTSVALUE,CLOSINGPOINTSVALUE,RESULT,COLHEAD)  "
        strSql += vbCrLf + " SELECT 'TOTAL'AS PARTICULAR , "
        strSql += vbCrLf + " SUM(ISNULL(OPPOINTS,0)),SUM(ISNULL(CURPOINTS,0)),SUM(ISNULL(REDEEMPOINTS,0)),SUM(ISNULL(CLOSINGPOINTS,0)),SUM(ISNULL(OPPOINTSVALUE,0)),SUM(ISNULL(CURPOINTSVALUE,0)), "
        strSql += vbCrLf + " SUM(ISNULL(REDEEMPOINTSVALUE,0)),SUM(ISNULL(CLOSINGPOINTSVALUE,0)) ,2 RESULT,'S'COLHEAD      "
        strSql += vbCrLf + " FROM #REPORTRESULT AS T  WHERE RESULT =1           "
        strSql += vbCrLf + " DELETE #REPORTRESULT WHERE PARTICULAR=''"
        strSql += vbCrLf + " SELECT @QRY = 'SELECT *,IDENTITY(INT,1,1) AS SNO INTO MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY' + ' FROM #REPORTRESULT ORDER BY RESULT,PARTICULAR'     "
        strSql += vbCrLf + " EXEC(@QRY) "

        strSql += vbCrLf + " IF @WITHFROMTO ='Y'"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "	SELECT @QRY = ' ALTER TABLE  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' ALTER COLUMN  CLOSINGPOINTSVALUE VARCHAR(100)'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' ALTER TABLE MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' ADD  CLPOINTS NUMERIC(15,4)'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' UPDATE  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' SET CLPOINTS=CONVERT(VARCHAR,SUBSTRING(CLOSINGPOINTSVALUE, 1,CHARINDEX(''.'', CLOSINGPOINTSVALUE)-1))' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY +'  WHERE COLHEAD=''D'''"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' DELETE FROM  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' WHERE  COLHEAD=''D'' AND CLPOINTS NOT BETWEEN '+@FROMPOINTS+'  AND '+@TOPOINTS+''"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' DELETE FROM  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' WHERE PARTICULAR=''TOTAL'' '"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' ALTER TABLE  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' DROP  COLUMN  CLPOINTS  '"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' ALTER TABLE  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' ALTER COLUMN  CLOSINGPOINTSVALUE  NUMERIC(15,4)'"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' INSERT INTO MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' (PARTICULAR,OPPOINTS,CURPOINTS,REDEEMPOINTS,CLOSINGPOINTS,OPPOINTSVALUE,CURPOINTSVALUE,REDEEMPOINTSVALUE,CLOSINGPOINTSVALUE,RESULT,COLHEAD) ' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SELECT ''TOTAL''AS PARTICULAR , '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SUM(ISNULL(OPPOINTS,0)),SUM(ISNULL(CURPOINTS,0)),SUM(ISNULL(REDEEMPOINTS,0)),SUM(ISNULL(CLOSINGPOINTS,0)),SUM(ISNULL(OPPOINTSVALUE,0)),SUM(ISNULL(CURPOINTSVALUE,0)), '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' SUM(ISNULL(REDEEMPOINTSVALUE,0)),SUM(ISNULL(CLOSINGPOINTSVALUE,0)) ,2 RESULT,''S''COLHEAD '     "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + ' FROM MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' AS T  WHERE RESULT =1 ' "
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "	SELECT @QRY = ' DELETE FROM  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' WHERE PARTICULAR=''TOTAL'' AND ISNULL(CLOSINGPOINTSVALUE,0)=0 '"
        strSql += vbCrLf + "	EXEC(@QRY)"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  SELECT @QRY = ' DELETE FROM  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' WHERE PARTICULAR=''TOTAL'' AND ISNULL(CLOSINGPOINTSVALUE,0)=0 '"
        strSql += vbCrLf + "  EXEC(@QRY)"
        strSql += vbCrLf + "  SELECT @QRY = ' DELETE FROM  MASTER..TEMP'+@SYSTEMID+'PREVILEGESUMMARY'+' WHERE  ISNULL(CLOSINGPOINTSVALUE,0)=0 '"
        strSql += vbCrLf + "  EXEC(@QRY)"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_RPT_PREVILEGETRAN()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PREVILEGETRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PREVILEGETRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        Dim dtDupCheck As New DataTable
        strSql = " SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'"
        cmd = New OleDbCommand(strSql, cn, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dtDupCheck)

        If dtDupCheck.Rows.Count > 0 Then
            cnChitCompanyid = dtDupCheck.Rows(0).Item(0).ToString()
        Else
            cnChitCompanyid = compId
        End If

        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_PREVILEGETRAN"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @SYSTEMID VARCHAR(10)"
        strSql += vbCrLf + " ,@FRMDATE VARCHAR(20)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(20)"
        strSql += vbCrLf + " ,@PREVILEGEID VARCHAR(200)"
        strSql += vbCrLf + " ,@METALNAME VARCHAR(200)"
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(200)"
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(3)"
        strSql += vbCrLf + " ,@WITHCHITPOINTS VARCHAR(1)"
        strSql += vbCrLf + " ,@ONLYPREVILEGE VARCHAR(1) "
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " SET NOCOUNT ON"
        strSql += vbCrLf + " BEGIN"
        If SqlVersion > 8 Then
            strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(MAX) "
        Else
            strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000) "
        End If
        strSql += vbCrLf + " 	DECLARE @DBARRAY VARCHAR(1000),@COLNAME AS VARCHAR(50)"
        strSql += vbCrLf + " 	DECLARE @DBARRAYLENGTH AS INT,@STRLEN AS INT,@COLLEN AS INT"
        strSql += vbCrLf + " 	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'PREVILEGETRAN'"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	EXEC ..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPMETALMAST') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPMETALMAST CREATE TABLE TEMPTABLEDB..TEMPMETALMAST(METALID VARCHAR(10))"
        strSql += vbCrLf + " 	SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2)'"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM " & compId & "ADMINDB..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	IF @METALNAME = '' OR @METALNAME = 'ALL'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPMETALMAST(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST"
        strSql += vbCrLf + " 	ELSE"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMPMETALMAST(METALID) SELECT METALID FROM " & compId & "ADMINDB..METALMAST WHERE METALNAME = @METALNAME"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMPPRIVREP') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPPRIVREP"
        strSql += vbCrLf + " 	SELECT @QRY = 'CREATE TABLE TEMPTABLEDB..TEMPPRIVREP'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' (CATCODE VARCHAR(10),PCS INT,GRSWT NUMERIC(15,3),NETWT NUMERIC(15,3),AMOUNT NUMERIC(15,2),TAX NUMERIC(15,2),SC  NUMERIC(15,2),TOTAL  NUMERIC(15,3)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,STNWT  NUMERIC(15,3),DIAWT  NUMERIC(15,3),CUSTOMER VARCHAR(55),ADDRESS VARCHAR(200),PHONENO VARCHAR(20)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,TRANDATE SMALLDATETIME,TRANNO INT,SNO VARCHAR(20),METALNAME VARCHAR(20),STUDDED VARCHAR(10),CATNAME VARCHAR(250)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,SEP VARCHAR(10),BILLNO VARCHAR(20),BILLDATE VARCHAR(20),COMPANYID VARCHAR(3),COSTID VARCHAR(2),METALID VARCHAR(2)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,ITEMID INT,SUBITEMID INT,PVGBASED VARCHAR(20),BPOINTS NUMERIC(15,2),POINTS NUMERIC(15,4),FIXEDRANGE VARCHAR(20),BPOINTVALUES NUMERIC(15,3),VALUEINWTRAMT VARCHAR(1))'"
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " 	/*ISSUE PART*/"
        strSql += vbCrLf + " 	SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMPPRIVREP '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' (CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,CUSTOMER,ADDRESS,PHONENO,TRANDATE,TRANNO,SNO,METALNAME'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + ' ,STUDDED,CATNAME,SEP,BILLNO,BILLDATE,COMPANYID,COSTID,METALID,ITEMID,SUBITEMID,PVGBASED,BPOINTS,POINTS,FIXEDRANGE,BPOINTVALUES)'"
        strSql += vbCrLf + " 	SET @DBARRAYLENGTH=0"
        strSql += vbCrLf + " 	SET @DBARRAY=''"
        strSql += vbCrLf + " 	SELECT @DBARRAY =  @DBARRAY  +',' + DBNAME FROM " & compId & "ADMINDB..DBMASTER  ORDER BY STARTDATE DESC"
        strSql += vbCrLf + " 	SELECT @DBARRAY = SUBSTRING(@DBARRAY,2,LEN(@DBARRAY))"
        strSql += vbCrLf + " 	SET @DBARRAYLENGTH = LEN(@DBARRAY)"
        strSql += vbCrLf + " 	SET @STRLEN = 0"
        strSql += vbCrLf + " 	WHILE @STRLEN < @DBARRAYLENGTH"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		IF CHARINDEX(',', @DBARRAY,1) > 0 SET @COLNAME = SUBSTRING(@DBARRAY,1,CHARINDEX(',', @DBARRAY,1)-1)"
        strSql += vbCrLf + " 		IF CHARINDEX(',', @DBARRAY,1) = 0 SET @COLNAME = SUBSTRING(@DBARRAY,1,@DBARRAYLENGTH)"
        strSql += vbCrLf + " 		SET @COLLEN = LEN(@COLNAME)+1"
        strSql += vbCrLf + " 		SET @STRLEN = @STRLEN+@COLLEN"
        strSql += vbCrLf + " 		IF (SELECT COUNT(*) FROM MASTER..SYSDATABASES WHERE  NAME=@COLNAME)>0 "
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			IF @STRLEN <> @COLLEN SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' SELECT CATCODE,PCS,GRSWT,NETWT,AMOUNT,TAX,SC,AMOUNT+TAX+SC AS TOTAL'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,3),(SELECT SUM(STNWT) FROM '+ @COLNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''S'')))STNWT'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,4),(SELECT SUM(STNWT) FROM '+ @COLNAME +'..ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = ''D'')))DIAWT'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,PNAME CUSTOMER,ISNULL(DOORNO,'''') + ISNULL(ADDRESS1,'''') + ISNULL(ADDRESS2,'''') ADDRESS,MOBILE PHONENO,I.TRANDATE'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,TRANNO,I.SNO,(SELECT METALNAME FROM " & compId & "ADMINDB..METALMAST WHERE METALID = (SELECT METALID FROM " & compId & "ADMINDB..CATEGORY WHERE CATCODE = I.CATCODE))AS METALNAME'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,''N''STUDDED,CONVERT(VARCHAR(250),NULL)CATNAME,''I'' SEP,CONVERT(VARCHAR(20),REFNO) BILLNO,CONVERT(VARCHAR(20),REFDATE,103) BILLDATE'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,I.COMPANYID,I.COSTID,METALID,ITEMID,ISNULL(SUBITEMID,0)SUBITEMID,'' '' AS PVGBASED,CONVERT(NUMERIC(15,2),0) AS BPOINTS ,CONVERT(NUMERIC(15,4),0) AS POINTS,'' ''FIXEDRANGE'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' ,CONVERT(NUMERIC(15,2),0) AS BPOINTVALUES'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' FROM '+ @COLNAME +'..ISSUE AS I LEFT OUTER JOIN " & compId & "ADMINDB..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' LEFT OUTER JOIN " & compId & "ADMINDB..PERSONALINFO AS P ON C.PSNO = P.SNO WHERE I.TRANDATE BETWEEN '''+@FRMDATE+''' AND '''+@TODATE+''' AND TRANTYPE IN (''SA'',''OD'')'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND CATCODE IN (SELECT CATCODE FROM " & compId & "ADMINDB..CATEGORY WHERE METALID IN (SELECT METALID FROM TEMPTABLEDB..TEMPMETALMAST))'"
        strSql += vbCrLf + " 			SELECT @QRY = @QRY + ' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE) AND ISNULL(I.COMPANYID,'''') = '''+@COMPANYID+''' AND ISNULL(I.CANCEL,'''') = '''''"
