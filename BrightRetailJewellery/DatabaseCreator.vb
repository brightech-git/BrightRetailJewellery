        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL9A,COL9B,COL9C,COL10,COL11,COL12,COL13,COL14 ,COLHEAD)   "
        strSql += vbCrLf + "  		SELECT ITEMNAME,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,SGST,CGST,IGST,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALES ORDER BY METALNAME,CONVERT(INT,TRANNO),RESULT   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL9A,COL9B,COL9C,COL10,COL11,COL12,COL13,COL14 ,COLHEAD)  "
        strSql += vbCrLf + "  		SELECT '' SUBTOTAL'' ITEMNAME,''''TRANNO,''''ITEMNAME,''''PCS,SUM(CONVERT(NUMERIC(15,2),COL5)),SUM(CONVERT(NUMERIC(15,2),COL6)),''''MCHARGE,''''RATE,SUM(CONVERT(NUMERIC(15,2),COL9))"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(15,2),COL9A)),SUM(CONVERT(NUMERIC(15,2),COL9B)),SUM(CONVERT(NUMERIC(15,2),COL9C)),SUM(CONVERT(NUMERIC(15,2),COL10)),SUM(CONVERT(NUMERIC(15,2),COL11))"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(15,2),COL12)),''''TAGNO,''''BATCHNO,''T''COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1   "
