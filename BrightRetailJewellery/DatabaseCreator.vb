        strSql += vbCrLf + "    		SELECT @QRY = @QRY +CHAR(13)+' -(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM '+@DBNAME+'..TAXTRAN WHERE TAXID=''IG'' AND ISNULL(STUDDED,'''')=''Y'' AND TRANTYPE IN(''SA'',''OD'',''RD'') AND ISSSNO IN(SELECT SNO FROM '+@DBNAME+'..ISSSTONE WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO '    "
        strSql += vbCrLf + "    		SELECT @QRY = @QRY +CHAR(13)+' AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE IN('+@STNFILTER+')))))IGST'  "
        strSql += vbCrLf + "    		SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(15,3),(SELECT SUM(TAXAMOUNT) FROM '+@DBNAME+'..TAXTRAN WHERE ISSSNO = I.SNO AND BATCHNO=I.BATCHNO AND TAXID=''CS'' AND ISNULL(STUDDED,'''')<>''Y'' AND TRANTYPE IN(''SA'',''OD'',''RD''))'    "
        strSql += vbCrLf + "    		SELECT @QRY = @QRY +CHAR(13)+' -(SELECT ISNULL(SUM(TAXAMOUNT),0) FROM '+@DBNAME+'..TAXTRAN WHERE TAXID=''IG'' AND ISNULL(STUDDED,'''')=''Y'' AND TRANTYPE IN(''SA'',''OD'',''RD'') AND ISSSNO IN(SELECT SNO FROM '+@DBNAME+'..ISSSTONE WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO '    "
