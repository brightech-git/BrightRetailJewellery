        strSql += vbCrLf + "  End"
        strSql += vbCrLf + "  IF (SELECT SUM(PAYMENT) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET)>0     "
        strSql += vbCrLf + "  BEGIN    "
