        strSql += vbCrLf + " 	 PRINT @QRY"
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "     IF @BILLSUM = 'N'    "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     SELECT @QRY=' UPDATE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL SET PRODUCTNAME=''ORDER ITEM'' WHERE ISNULL(PRODUCTNAME,'''')='''' '    "
        strSql += vbCrLf + "     EXEC (@QRY)"
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "     SELECT @QRY=' UPDATE A SET CREDIT=CONVERT(NUMERIC(15,2),ISNULL(CREDIT,0)+ISNULL((SELECT SUM(AMOUNT) FROM ACCTRAN WHERE BATCHNO=A.BATCHNO AND PAYMODE IN (''PU'')),0))'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL AS A WHERE VOUCHERTYPE=''PURCHASE'' AND BATCHNO IN ('"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT BATCHNO FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL AS I WHERE VOUCHERTYPE IN (''SALES'',''PURCHASE'') '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' GROUP BY BATCHNO HAVING COUNT(VOUCHERTYPE)>1)'"
        strSql += vbCrLf + "     IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY='SELECT INVOICEDATE,INVOICENO ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,VOUCHERTYPE,PNAME,ISNULL(P.GSTNO,'''')GSTNO'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(GRSWT,0))GRSWT,SUM(ISNULL(NETWT,0))NETWT,SUM(ISNULL(STNWT,0))STNWT,SUM(ISNULL(STNAMT,0))STNAMT ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(DIAWT,0))DIAWT,SUM(ISNULL(DIAAMT,0))DIAAMT,METALTYPE,SUM(ISNULL(VALUE,0))VALUE,SUM(ISNULL(GST,0))GST ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(IGSTRATE,0))IGSTRATE,SUM(ISNULL(IGSTTAX,0))IGSTTAX,SUM(ISNULL(CGSTRATE,0))CGSTRATE,SUM(ISNULL(CGSTTAX,0))CGSTTAX ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(SGSTRATE,0))SGSTRATE,SUM(ISNULL(SGSTTAX,0))SGSTTAX ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 REMARK1 FROM  TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL WHERE BATCHNO=T.BATCHNO AND METALTYPE=T.METALTYPE AND ISNULL(REMARK1,'''') <> '''') REMARKS' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(TOTAL,0))TOTAL,BATCHNO' "
        strSql += vbCrLf + "  	IF @BILLREFNO = 'Y'"
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' ,REFNO'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(CASH,0)) CASH,SUM(ISNULL(CARD,0)) CARD,SUM(ISNULL(CHEQUE,0)) CHEQUE,SUM(ISNULL(ADVADJ,0)) ADVADJ ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(SCHEME,0)) SCHEME,SUM(ISNULL(BONUS,0)) BONUS ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(DISCOUNT,0)) DISCOUNT,SUM(ISNULL(CREDIT,0)) CREDIT,ROW_NUMBER() OVER (ORDER BY INVOICEDATE,VOUCHERTYPE DESC) SNO ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,SUM(ISNULL(CASH,0)+ISNULL(CARD,0)+ISNULL(CHEQUE,0)+ISNULL(ADVADJ,0)+ISNULL(CREDIT,0)) AS BAL_AMT ' "
        strSql += vbCrLf + "     IF @CHITDB <>''    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' ,SCHEMENAME ' "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL T WHERE 1=1'    "
        strSql += vbCrLf + "     IF @METALNAME<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND METALTYPE='''+@METALNAME+''''    "
        strSql += vbCrLf + "     IF @TYPE<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND VOUCHERTYPE='''+@TYPE+''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' GROUP BY INVOICEDATE,INVOICENO,VOUCHERTYPE,PNAME,METALTYPE,BATCHNO,ISNULL(P.GSTNO,'''') ' "
        strSql += vbCrLf + "    	IF @BILLREFNO = 'Y'"
        strSql += vbCrLf + "    	SELECT @QRY=@QRY+CHAR(13)+' ,REFNO'"
        strSql += vbCrLf + "    	IF @BILLSUM1 = 'Y' AND @BILLSUM = 'Y' AND @CHITDB <>''"
        strSql += vbCrLf + "    	SELECT @QRY=@QRY+CHAR(13)+' ,SCHEMENAME'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,CASE WHEN VOUCHERTYPE=''SALES RETURN'' THEN ''RETURN'' ELSE VOUCHERTYPE END DESC,INVOICENO,REMARKS '"
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     ELSE "
        strSql += vbCrLf + "     BEGIN "
        strSql += vbCrLf + "     SELECT @QRY='SELECT * '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL(CASH,0)+ISNULL(CARD,0)+ISNULL(CHEQUE,0)+ISNULL(ADVADJ,0)+ISNULL(CREDIT,0) AS BAL_AMT'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABSFINAL WHERE 1=1'    "
        strSql += vbCrLf + "     IF @METALNAME<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND METALTYPE='''+@METALNAME+''''    "
        strSql += vbCrLf + "     IF @TYPE<>'ALL'    "
        strSql += vbCrLf + "         SELECT @QRY=@QRY+CHAR(13)+' AND VOUCHERTYPE='''+@TYPE+''''    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ORDER BY INVOICEDATE,CASE WHEN VOUCHERTYPE=''SALES RETURN'' THEN ''RETURN'' ELSE VOUCHERTYPE END DESC,INVOICENO,REMARKS'"
        strSql += vbCrLf + "     END "
        strSql += vbCrLf + "     PRINT @QRY  "
        strSql += vbCrLf + "     EXEC (@QRY)   "
        strSql += vbCrLf + " END     "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSp_SalesAbstractNewGST_14_MAR_2022()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_RPT_ABSTRACT_NEW_FORMAT_GST')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_RPT_ABSTRACT_NEW_FORMAT_GST"
