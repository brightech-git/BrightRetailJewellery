        'strSql += vbCrLf + "      		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,SUM(AMOUNT) AS AMOUNT,'' ''FLAG,CASE WHEN RESULT=''6'' THEN ''7'' ELSE ''2'' END RESULT,'' ''TRANDATE,'' ''TRANNO,''S'' AS COLHEAD,'''' SEP'  "
