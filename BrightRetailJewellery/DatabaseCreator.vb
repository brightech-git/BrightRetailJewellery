        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_RPT_NEWCUSTOMEROUTSTANDING_ACCODE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_NEWCUSTOMEROUTSTANDING_ACCODE')>0"
