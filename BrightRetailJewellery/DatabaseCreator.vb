        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_WS>',@CNG_WS)"
        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_MC>',@CNG_MC)		"
        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_PU>',@CNG_PU)		"
        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_CL>',@CNG_CL)		"
        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_ACC>',@ACC)"
        strSql += vbCrLf + " 		SET @TEMPDES = REPLACE(@TEMPDES,'<CNG_ITM>',@ITM)		"
