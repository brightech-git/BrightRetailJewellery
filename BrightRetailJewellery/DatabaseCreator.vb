        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+' ORDER BY A.TRANDATE,A.TRANNO'"
        strSql += vbCrLf + " 		PRINT @QUERY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + " 		IF @CANCEL ='Y'"
