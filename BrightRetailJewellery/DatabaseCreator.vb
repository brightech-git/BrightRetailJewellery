        strSql += vbCrLf + "   SELECT @QRY= @QRY+' CONVERT(VARCHAR(500),CASE WHEN '''+@RPT_TYPE+''' = ''D'' THEN REPLICATE('' '','+CONVERT(VARCHAR(10),@MAXLEN)+') + ACNAME ELSE ACGRPNAME END)AS PARTICULAR'"
