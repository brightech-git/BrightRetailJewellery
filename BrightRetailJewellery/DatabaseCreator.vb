        strSql += vbCrLf + "   LEFT OUTER JOIN ..ITEMTAG AS T ON T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE ) "
        strSql += vbCrLf + "   AND T.ITEMID = RE.ITEMID "
        strSql += vbCrLf + "   AND T.SUBITEMID = RE.SUBITEMID "
        strSql += vbCrLf + "   AND T.GRSWT BETWEEN FROMWEIGHT AND TOWEIGHT"
        strSql += vbCrLf + "   AND T.COMPANYID = @COMPANYID AND T.COSTID = RE.COSTID   "
        strSql += vbCrLf + "   WHERE RE.ITEMID IN (SELECT ITEMIDS FROM TEMPTABLEDB..TEMPITEMMAST)    "
        strSql += vbCrLf + "   AND RE.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)    "
        strSql += vbCrLf + "    AND ISNULL(RE.COSTID,0) IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE) "
        strSql += vbCrLf + "   AND RE.RANGEMODE='R'"
        strSql += vbCrLf + "   GROUP BY DESIGNERNAME,ITEMNAME,SM.SUBITEMNAME,RE.FROMWEIGHT,RE.TOWEIGHT,RE.PIECE,RE.WEIGHT"
        strSql += vbCrLf + "   UNION ALL"
        strSql += vbCrLf + "   SELECT DISTINCT SM.SUBITEMNAME,'OTHER RANGE' RANGE,SUM(T.PCS)STKPCS ,SUM(T.GRSWT)STKRT,0 PIECE,0 WEIGHT"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),IM.ITEMNAME) AS ITEM,CONVERT(VARCHAR(100),SM.SUBITEMNAME)AS SUBITEM "
        strSql += vbCrLf + "   ,0 FROMWEIGHT,0 TOWEIGHT    "
        strSql += vbCrLf + "   ,CONVERT(INT,2) AS RESULT    "
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(100),DE.DESIGNERNAME) AS DESIGNER"
        strSql += vbCrLf + "   ,CONVERT(VARCHAR(3),NULL)COLHEAD   "
        strSql += vbCrLf + "   FROM ..ITEMTAG AS T    "
        strSql += vbCrLf + "   LEFT OUTER JOIN DESIGNER DE ON DE.DESIGNERID=T.DESIGNERID"
        strSql += vbCrLf + "   LEFT outer jOIN SUBITEMMAST SM ON SM.ITEMID=T.ITEMID AND SM.SUBITEMID=T.SUBITEMID"
        strSql += vbCrLf + "   LEFT OUTER JOIN ITEMMAST IM ON IM.ITEMID=T.ITEMID "
        strSql += vbCrLf + "   WHERE NOT EXISTS (Select 1 from STKREORDER RE WHERE T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID  AND ISNULL(T.COSTID,'')=ISNULL(RE.COSTID,'') and  T.GRSWT between RE.FROMWEIGHT and RE.TOWEIGHT)"
        strSql += vbCrLf + "   AND T.RECDATE <= @ASONDATE  AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE )  "
        strSql += vbCrLf + "   AND T.ITEMID IN (SELECT ITEMIDS FROM TEMPTABLEDB..TEMPITEMMAST)    "
        strSql += vbCrLf + "   AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  "
        strSql += vbCrLf + "   AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)    "
        strSql += vbCrLf + "   AND ISNULL(T.COSTID,0) IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE) "
        strSql += vbCrLf + "   AND IM.CALTYPE='W'"
        strSql += vbCrLf + "   GROUP BY DESIGNERNAME,ITEMNAME,SM.SUBITEMNAME"
        strSql += vbCrLf + "   )X GROUP BY RANGE,SUBITEMNAME,FROMWEIGHT,TOWEIGHT,DESIGNER,ITEM,SUBITEM,RESULT,COLHEAD"
        strSql += vbCrLf + "   UPDATE #DESIGNSTKORDER1 SET DIFFPCS =isnull(STKPCS,0)-isnull(REORDPCS,0),DIFFRT = Isnull(STKRT,0)-isnull(REORDRT,0)  "
        strSql += vbCrLf + "   DECLARE @DESIGNLEN1 AS INT"
        strSql += vbCrLf + "   DECLARE @DESIGNLEN_FWT1 AS INT"
        strSql += vbCrLf + "   DECLARE @DESIGNLEN_TWT1 AS INT"
        strSql += vbCrLf + "   SELECT @DESIGNLEN1 = MAX(LEN(SUBITEMNAME))+1 FROM #DESIGNSTKORDER1 WHERE RESULT = 2"
        strSql += vbCrLf + "   SELECT @DESIGNLEN_FWT1 = MAX(LEN(FROMWEIGHT)) FROM #DESIGNSTKORDER1"
        strSql += vbCrLf + "   SELECT @DESIGNLEN_TWT1 = MAX(LEN(TOWEIGHT)) FROM #DESIGNSTKORDER1"
        strSql += vbCrLf + "   /* UPDATE #STKORDER SET RANGE =  RANGE + REPLICATE(' ',@LEN-LEN(RANGE)) + '[' + REPLICATE(' ',@LEN_FWT - LEN(FROMWEIGHT)) + CONVERT(VARCHAR,FROMWEIGHT) + ' TO ' + REPLICATE(' ',@LEN_TWT - LEN(TOWEIGHT)) + CONVERT(VARCHAR,TOWEIGHT) + ']' WHERE RESULT = 1 */"
        strSql += vbCrLf + "   IF @RTYPE = 'S'"
        strSql += vbCrLf + "   DELETE FROM #DESIGNSTKORDER1 WHERE NOT (DIFFPCS < 0 OR DIFFRT < 0)"
        strSql += vbCrLf + "   IF @RTYPE = 'E'"
        strSql += vbCrLf + "   DELETE FROM #DESIGNSTKORDER1 WHERE NOT (DIFFPCS > 0 OR DIFFRT > 0)"
        strSql += vbCrLf + "   IF (SELECT COUNT(*) FROM #DESIGNSTKORDER1)>0  "
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   INSERT INTO #DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD)"
        strSql += vbCrLf + "   SELECT DISTINCT DESIGNER,ITEM,DESIGNER,0 RESULT,'T'COLHEAD FROM #DESIGNSTKORDER1"
        strSql += vbCrLf + "   INSERT INTO #DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD)"
        strSql += vbCrLf + "   SELECT DISTINCT DESIGNER,ITEM,ITEM,1 RESULT,'N'COLHEAD FROM #DESIGNSTKORDER1"
        strSql += vbCrLf + "   /* INSERT INTO #DESIGNSTKORDER1 (DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD) */"
        strSql += vbCrLf + "   /* SELECT DISTINCT DESIGNER,ITEM,SUBITEMNAME,4 RESULT,'E'COLHEAD FROM #DESIGNSTKORDER1 */ "
        strSql += vbCrLf + "   INSERT INTO #DESIGNSTKORDER1 (DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,SUBITEM)"
        strSql += vbCrLf + "   SELECT DISTINCT DESIGNER,ITEM,'SUB TOTAL',3 RESULT,'S'COLHEAD,"
        strSql += vbCrLf + "   SUM(REORDPCS),SUM(REORDRT),SUM(STKPCS),SUM(STKRT),SUM(DIFFPCS),SUM(DIFFRT),'ZZ.SUB TOTAL'"
        strSql += vbCrLf + "   FROM #DESIGNSTKORDER1 GROUP BY DESIGNER,ITEM"
        strSql += vbCrLf + "    INSERT INTO #DESIGNSTKORDER1(DESIGNER,ITEM,SUBITEMNAME,RESULT,COLHEAD,REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,SUBITEM)  "
        strSql += vbCrLf + "   Select DISTINCT 'ZZZZZZZ','ZZZZZZZZZZZZ','GRAND TOTAL',5 RESULT,'G' COLHEAD"
        strSql += vbCrLf + "   ,SUM(REORDPCS),SUM(REORDRT),SUM(STKPCS),SUM(STKRT),SUM(DIFFPCS),SUM(DIFFRT),'GRAND TOTAL'	 "
        strSql += vbCrLf + "   FROM #DESIGNSTKORDER1 WHERE RESULT IN (2) "
        strSql += vbCrLf + "   /* UPDATE #DESIGNSTKORDER1 SET SUBITEM = SUBITEMNAME WHERE COLHEAD = 'E'*/"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   End"
        strSql += vbCrLf + "   IF @SIZE='Y'"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   /*SELECT CASE WHEN COLHEAD = 'E' THEN '' ELSE SUBITEMNAME END SUBITEMNAME,*/"
        strSql += vbCrLf + "   SELECT SUBITEMNAME,[RANGE],REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD,SIZENAME "
        strSql += vbCrLf + "   FROM #DESIGNSTKORDER T ORDER BY DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,[RANGE],RESULT,COLHEAD"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   IF @SIZE='N'"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "   /*SELECT CASE WHEN COLHEAD = 'E' THEN '' ELSE SUBITEMNAME END SUBITEMNAME,*/"
        strSql += vbCrLf + "   SELECT SUBITEMNAME,[RANGE],REORDPCS,REORDRT,STKPCS,STKRT,DIFFPCS,DIFFRT,DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD FROM #DESIGNSTKORDER1 T ORDER BY DESIGNER,ITEM,SUBITEM,FROMWEIGHT,TOWEIGHT,[RANGE],RESULT,COLHEAD"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function


    Private Function SP_RPT_STOCKREORDERNEW_R() As Integer
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_STOCKREORDERNEW_R')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_STOCKREORDERNEW_R"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE SP_RPT_STOCKREORDERNEW_R"
