        strSql += vbCrLf + " ,@BILLSUM VARCHAR(1)   "
        strSql += vbCrLf + " )       "
        strSql += vbCrLf + " AS       "
        strSql += vbCrLf + " BEGIN /** PROC STARTS **/       "
        strSql += vbCrLf + "     SET NOCOUNT ON       "
        strSql += vbCrLf + "     DECLARE @QRY VARCHAR(8000)      "
        strSql += vbCrLf + "     DECLARE @QRY1 VARCHAR(8000)      "
        strSql += vbCrLf + "     DECLARE @QRY2 VARCHAR(8000)  "
        strSql += vbCrLf + "     DECLARE @QRY4 VARCHAR(8000)     "
        strSql += vbCrLf + "     SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'       "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + "     EXEC (@QRY)     "
        strSql += vbCrLf + "     EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME       "
        strSql += vbCrLf + "     EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL = 'TEMPCATEGORY',@INPUTVALUES = @CATCODE   "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#METALMAST') IS NOT NULL DROP TABLE #METALMAST CREATE TABLE #METALMAST(METALID VARCHAR(10))         "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#CATEGORY') IS NOT NULL DROP TABLE #CATEGORY CREATE TABLE #CATEGORY(CATCODE VARCHAR(10))         "
        strSql += vbCrLf + "     SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '       "
        strSql += vbCrLf + "     EXEC (@QRY)       "
        strSql += vbCrLf + "     SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM ' + @DBNAME + '..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'        "
        strSql += vbCrLf + "     EXEC (@QRY)    "
        strSql += vbCrLf + "     DECLARE  @SUBITEMID VARCHAR(50)  "
        strSql += vbCrLf + "     SELECT @SUBITEMID=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='EXCLUDESUBITEM'  "
        strSql += vbCrLf + "     DECLARE  @BILLSUM1 VARCHAR(1)  "
        strSql += vbCrLf + "     DECLARE  @BILLREFNO VARCHAR(1)  "
        strSql += vbCrLf + "     DECLARE  @INCSR VARCHAR(1)  "
        strSql += vbCrLf + "     SELECT @BILLSUM1= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_BILLSUM'  "
        strSql += vbCrLf + "     SELECT @BILLREFNO= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_REFNO'  "
        strSql += vbCrLf + "     SELECT @INCSR= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_INCSR'  "
        strSql += vbCrLf + "     DECLARE  @CHITDB VARCHAR(30)  "
        strSql += vbCrLf + "     SELECT @CHITDB=ISNULL(CTLTEXT,'') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='CHITDBPREFIX'  "
        strSql += vbCrLf + " 	DECLARE  @SQLVERSION INT "
        strSql += vbCrLf + " 	SET @SQLVERSION=0"
        strSql += vbCrLf + " 	SELECT @SQLVERSION = CAST(SUBSTRING(CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')),1,CHARINDEX('.',CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')))-1) AS INT) "
        strSql += vbCrLf + "     IF @SUBITEMID='' SELECT @SUBITEMID='999999'  "
        strSql += vbCrLf + "     IF @BILLSUM = 'N'    "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     IF @SEPDIA = 'N'  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     SELECT @QRY='SELECT  * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS  FROM ('"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT I.TRANDATE INVOICEDATE,TRANNO AS INVOICENO,'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' (SELECT METALNAME FROM ' + @DBNAME + '..METALMAST WHERE METALID=I.METALID) AS METALTYPE,'  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ''SALES'' AS VOUCHERTYPE,PNAME PARTYNAME'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(CASE WHEN I.SUBITEMID=0 THEN IM.ITEMNAME ELSE SI.SUBITEMNAME END) AS PRODUCTNAME,CC.CATNAME '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT NAME FROM ' + @DBNAME + '..ITEMTYPE WHERE ITEMTYPEID=I.ITEMTYPEID) AS ITEMTYPE '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,I.GRSWT+CONVERT(NUMERIC(15,3) ,ISNULL((SELECT SUM(GRSWT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)) GRSWT '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,I.NETWT+CONVERT(NUMERIC(15,3) ,ISNULL((SELECT SUM(NETWT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)) NETWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,3),ISNULL((SELECT SUM(STNWT)  FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''T'') AND STNSUBITEMID NOT IN('+@SUBITEMID+') ),0))STNWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,2),ISNULL((SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''T'') ),0))STNAMT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,3),ISNULL((SELECT SUM(STNWT)  FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'') AND STNSUBITEMID NOT IN('+@SUBITEMID+') ),0))DIAWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,2),ISNULL((SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'') ),0))DIAAMT '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,ROUND(AMOUNT-ISNULL(I.STNAMT,0)+CONVERT(NUMERIC(15,2) ,ISNULL((SELECT SUM(AMOUNT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)),0) VALUE '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' )GST'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXPER FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'')IGSTRATE'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXAMOUNT FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'')IGSTTAX'    "
