        strSql += vbCrLf + "           IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0  "
        strSql += vbCrLf + "           SET @COMPANYID= @COMPANYID + ','  "
        strSql += vbCrLf + "           SET @QRY='INSERT INTO TEMPTABLEDB..OUT_COMPANY'+@SYSID+' (COMPANYID) SELECT '''+@TCOMPANY+''''  "
        strSql += vbCrLf + "           PRINT @QRY  "
        strSql += vbCrLf + "           EXEC (@QRY)  "
        strSql += vbCrLf + "          END  "
        strSql += vbCrLf + "          SET @QRY='IF OBJECT_ID(''TEMPTABLEDB..OUT_TYPE'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..OUT_TYPE'+@SYSID+''  "
        strSql += vbCrLf + "          PRINT(@QRY)  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SET @QRY='CREATE TABLE TEMPTABLEDB..OUT_TYPE'+@SYSID+'(TYPEID VARCHAR(30))'  "
        strSql += vbCrLf + "          PRINT(@QRY)  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          DECLARE @TEMPID VARCHAR(5)  "
        strSql += vbCrLf + "          IF CHARINDEX(',',@TYPEID)=0  "
        strSql += vbCrLf + "          SET @QRY=''  "
        strSql += vbCrLf + "          SET @QRY='INSERT INTO TEMPTABLEDB..OUT_TYPE'+@SYSID+'(TYPEID) SELECT '''+@TYPEID+''''  "
        strSql += vbCrLf + "          PRINT(@QRY)  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          WHILE CHARINDEX(',',@TYPEID)>0  "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "           SET @TEMPID=LEFT(@TYPEID,CHARINDEX(',',@TYPEID)-1)  "
        strSql += vbCrLf + "           SET @TYPEID=RIGHT(@TYPEID,LEN(@TYPEID)-CHARINDEX(',',@TYPEID))  "
        strSql += vbCrLf + "           IF @TYPEID <>'' AND CHARINDEX(',',@TYPEID)=0  "
        strSql += vbCrLf + "           SET @TYPEID= @TYPEID + ','  "
        strSql += vbCrLf + "           SET @QRY=''  "
        strSql += vbCrLf + "           SET @QRY='INSERT INTO TEMPTABLEDB..OUT_TYPE'+@SYSID+'(TYPEID) SELECT '''+@TEMPID+'''' "
        strSql += vbCrLf + "  		 PRINT @QRY "
        strSql += vbCrLf + "           EXEC (@QRY)  "
        strSql += vbCrLf + "          END  "
        strSql += vbCrLf + "          SELECT @QRY= 'IF OBJECT_ID(''TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+''"
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SELECT @QRY= 'SELECT * INTO TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' FROM  OUTSTANDING AS O'  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' WHERE O.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''''  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' AND ISNULL(O.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMP_OUT_COSTCENTRE'+@SYSID+')'  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' AND ISNULL(O.CANCEL,'''') = ''''  AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..OUT_COMPANY'+@SYSID+')'  "
        strSql += vbCrLf + "  	    SELECT @QRY= @QRY + CHAR(13) + ' AND ACCODE IN '"
        strSql += vbCrLf + "  		SELECT @QRY= @QRY + '(SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD'+@SYSID+')' "
        strSql += vbCrLf + "  		/*"
        strSql += vbCrLf + "           IF (@ACNAME<>'ALL' AND @ACNAME <>'')  /* ACNAME FILTERATION */"
        strSql += vbCrLf + "  	       BEGIN  "
        strSql += vbCrLf + "  			    SELECT @QRY= @QRY + ' AND ACCODE IN '"
        strSql += vbCrLf + "  				SELECT @QRY= @QRY + ' ''(SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD'+@SYSID+')'''  "
        strSql += vbCrLf + "             END "
        strSql += vbCrLf + "           ELSE IF  (@ACNAME = 'ALL' OR @ACNAME <>'')"
        strSql += vbCrLf + "  			BEGIN"
        strSql += vbCrLf + "  				IF (@ACGROUP<>'ALL' AND @ACGROUP <>'')  "
        strSql += vbCrLf + "  				BEGIN  "
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + ' AND ACCODE IN '"
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + '  (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM ACGROUP '"
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + '  WHERE ACGRPNAME IN( SELECT COMPANYID FROM TEMPACGROUP)))'"
        strSql += vbCrLf + "  				END				"
        strSql += vbCrLf + "  				ELSE	"
        strSql += vbCrLf + "  				BEGIN  "
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + ' AND ACCODE IN '"
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + '  (SELECT ACCODE FROM ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM ACGROUP '"
        strSql += vbCrLf + "  					SELECT @QRY= @QRY + '  WHERE ACGRPNAME IN( SELECT COMPANYID FROM TEMPACGROUP)))'"
        strSql += vbCrLf + "  				END"
        strSql += vbCrLf + "  			END"
        strSql += vbCrLf + "           /*SELECT @QRY= @QRY + ' SELECT ACGRPCODE FROM ACGROUP WHERE ACGRPNAME IN '''+ @ACGROUP +'''))'*/     "
        strSql += vbCrLf + "          */"
        strSql += vbCrLf + "          PRINT(@QRY)  "
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SELECT @QRY= 'UPDATE TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' SET TRANTYPE = ''J'''  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' WHERE RUNNO IN (SELECT RUNNO FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' O WHERE EXISTS (SELECT 1 FROM ITEMDETAIL WHERE BATCHNO = O.BATCHNO AND RUNNO=O.RUNNO))'  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' UPDATE TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' SET TRANTYPE = ''O'' WHERE SUBSTRING(RUNNO,6,1) = ''O'''  "
        strSql += vbCrLf + "          SELECT @QRY= @QRY + CHAR(13) + ' DELETE FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' WHERE TRANTYPE NOT IN (SELECT TYPEID FROM TEMPTABLEDB..OUT_TYPE'+@SYSID+')'  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          IF @ACFILTER<>'N'   "
        strSql += vbCrLf + "          SELECT @QRY= 'DELETE FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' WHERE ISNULL(AMOUNT,0)=0'  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SELECT @QRY= 'IF OBJECT_ID(''TEMPTABLEDB..TEMP_ACHEAD'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_ACHEAD'  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SELECT @QRY= 'CREATE TABLE TEMPTABLEDB..TEMP_ACHEAD (ACCODE VARCHAR(7),TRANTYPE VARCHAR(50))'  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          IF @DISPLAY = 'C'  "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "           SELECT @QRY= 'INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13) + ' SELECT ACCODE,TRANTYPE FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' AS O'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13) + ' WHERE ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD'+@SYSID+')'"
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13) + ' GROUP BY ACCODE,TRANTYPE'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13) + ' HAVING SUM(CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE -1*AMOUNT END) = 0'  "
        strSql += vbCrLf + "  		 PRINT (@QRY)"
        strSql += vbCrLf + "           EXEC (@QRY)  "
        strSql += vbCrLf + "          END  "
        strSql += vbCrLf + "          IF @DISPLAY = 'P'  "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "           SELECT @QRY= 'INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY +  CHAR(13) + ' SELECT ACCODE,TRANTYPE FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' AS O'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY +  CHAR(13) + ' WHERE ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD'+@SYSID+')'"
        strSql += vbCrLf + "           SELECT @QRY= @QRY +  CHAR(13) + ' GROUP BY ACCODE,TRANTYPE'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY +  CHAR(13) + ' HAVING SUM(CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE -1*AMOUNT END) > 0'  "
        strSql += vbCrLf + "  		 PRINT (@QRY)"
        strSql += vbCrLf + "           EXEC (@QRY)  "
        strSql += vbCrLf + "          END    "
        strSql += vbCrLf + "          IF @DISPLAY = 'A'    "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "           SELECT @QRY= 'INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + ' SELECT ACCODE,TRANTYPE FROM TEMPTABLEDB..TEMP_OUTSTDT'+@SYSID+' AS O'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + ' WHERE ACCODE IN (SELECT ACCODE FROM TEMPTABLEDB..TEMPACHEAD'+@SYSID+')'"
        strSql += vbCrLf + "           SELECT @QRY= @QRY + ' GROUP BY ACCODE,TRANTYPE'  "
        strSql += vbCrLf + "  		 PRINT (@QRY)"
        strSql += vbCrLf + "           EXEC (@QRY)  "
        strSql += vbCrLf + "          END  "
        strSql += vbCrLf + "          IF @ACFILTER='D' AND @DISPLAY<>'A' AND ((SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_ACHEAD WHERE ISNULL(ACCODE,'')='DRS')<=0) INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)SELECT 'DRS','D'  "
        strSql += vbCrLf + "          IF(@ACFILTER='A' OR @ACFILTER='O') AND @DISPLAY<>'A' AND ((SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_ACHEAD WHERE ISNULL(ACCODE,'')='ADVANCE')<=0) INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)SELECT 'ADVANCE','A'  "
        strSql += vbCrLf + "          IF @ACFILTER='O' AND @DISPLAY<>'A' AND ((SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_ACHEAD WHERE ISNULL(ACCODE,'')='ADVORD' AND TRANTYPE='O')<=0) INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)SELECT 'ADVORD','O'  "
        strSql += vbCrLf + "          SELECT @QRY= 'IF OBJECT_ID(''TEMPTABLEDB..TEMP_OUTSTANDING'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING'+@SYSID+''  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          SELECT @QRY= 'IF OBJECT_ID(''TEMPTABLEDB..TEMP_CROUTSTANDING'+@SYSID+''') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_CROUTSTANDING'+@SYSID+''  "
        strSql += vbCrLf + "  		PRINT (@QRY)"
        strSql += vbCrLf + "          EXEC (@QRY)  "
        strSql += vbCrLf + "          IF @SUMMARY = 'N'  "
        strSql += vbCrLf + "          BEGIN  "
        strSql += vbCrLf + "           SELECT @QRY='SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,CONVERT(VARCHAR(50),H.ACCODE) ACCODE,O.RUNNO,CONVERT(VARCHAR(50),O.TRANTYPE)TRANTYPE,O.TRANNO,O.TRANDATE,O.DUEDATE'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',CASE WHEN RECPAY = ''P'' THEN AMOUNT ELSE 0 END AS DEBIT'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',CASE WHEN RECPAY = ''R'' THEN AMOUNT ELSE 0 END AS CREDIT'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',CONVERT(NUMERIC(15,2),NULL)BALANCE'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',(H.INITIAL +'' ''+ H.ACNAME) NAME,H.CONTACTPERSON,H.MOBILE,CONVERT(NUMERIC,NULL) AMOUNT'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',CONVERT(NUMERIC,NULL) CTRANNO,CONVERT(SMALLDATETIME,NULL) CTRANDATE'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',(SELECT EMPNAME FROM EMPMASTER WHERE EMPID = O.EMPID)AS SALESPERSON'  "
        strSql += vbCrLf + "		   SELECT @QRY= @QRY + CHAR(13)+ ',(SELECT CASHNAME FROM CASHCOUNTER WHERE CASHID = O.CASHID)AS CASHCOUNTER'   "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',(SELECT EMPNAME FROM EMPMASTER WHERE EMPID = O.DISC_EMPID)AS DISCEMPNAME'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = O.COSTID)AS COSTNAME'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',O.COSTID'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ',O.COMPANYID,CONVERT(VARCHAR(12),NULL)LASTTRANDATE,O.REMARK1,IDENTITY(INT,1,1)KNO'  "
        strSql += vbCrLf + "           SELECT @QRY= @QRY + CHAR(13)+ ' INTO TEMPTABLEDB..TEMP_OUTSTANDING'+@SYSID+''  "
