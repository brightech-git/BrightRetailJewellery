        'strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN ISNULL('''+@OPENING+''','''') = ''Y'' THEN '''' ELSE '''' END              '"
        'strSql += vbCrLf + " 	SELECT @QRY=@QRY+CHAR(13)+' +(SELECT ACNAME FROM " & compId & "ADMINDB..ACHEAD WHERE ACCODE = T.ACCODE) '"
