        strSql += vbCrLf + "    		SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + "    		IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "    		BEGIN"
        strSql += vbCrLf + "    			SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + "    		END"
        strSql += vbCrLf + "    		INSERT INTO TEMPTABLEDB..COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME)    "
        strSql += vbCrLf + "    	END    "
        strSql += vbCrLf + "    END    "
        strSql += vbCrLf + "    ELSE    	"
        strSql += vbCrLf + "    INSERT INTO TEMPTABLEDB..COSTCENTRE(COSTID) SELECT '' COSTID "

        strSql += vbCrLf + "	IF OBJECT_ID('TEMPTABLEDB..TAGWISEPROFITLOSS', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TAGWISEPROFITLOSS "
        strSql += vbCrLf + "	SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TAGWISEPROFITLOSS'', ''U'') IS NOT NULL DROP TABLE TEMPTABLEDB..TAGWISEPROFITLOSS '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		SELECT CONVERT(VARCHAR(50),NULL)AS PARTICULAR    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID)AS SUBITEM'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.GRSWT PURGRSWT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.NETWT PURNETWT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,CONVERT(NUMERIC(15,2),(CASE WHEN '''+ @GP +'''=''Y'' THEN '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CASE  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHEN ISNULL((SELECT GPPER FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID),0)<>0 '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		THEN ISNULL((SELECT GPPER FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID),0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ISNULL((SELECT GPPER FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID=T.ITEMID),0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		PURWASTAGE*100/(CASE WHEN ISNULL(I.GRSWT,0)=0 THEN 1 ELSE (CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END) END) END))PURWASTPER '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(CASE WHEN '''+ @GP +'''=''Y'' THEN '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CONVERT(NUMERIC(15,3), '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CASE  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHEN ISNULL((SELECT GPPER FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID),0)<>0 '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		THEN ISNULL((SELECT GPPER FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID),0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ISNULL((SELECT GPPER FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID=T.ITEMID),0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END)*(CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END)/100))'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		((CONVERT (NUMERIC(15,3),(PURWASTAGE)/				 '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CASE  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHEN ISNULL(PURTOUCH,0) <> 0 AND ISNULL(PURNETWT,0) <> 0 THEN PURNETWT*PURTOUCH  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHEN  ISNULL(PURTOUCH,0) = 0 AND ISNULL(PURNETWT,0) = 0 THEN 1  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHEN  ISNULL(PURTOUCH,0) = 0 AND ISNULL(PURNETWT,0) <> 0 THEN PURNETWT  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE PURNETWT   '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		)*(CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END)))  '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END) PURWASTAGE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,P.PURMC'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT ISNULL(SUM(STNWT),0) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO ) AS PURSTNWT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT ISNULL(SUM(PURAMT),0) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO ) AS PURSTNAMT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,((CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END)'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		+((CONVERT (NUMERIC(15,3),(PURWASTAGE)/(CASE WHEN ISNULL(PURTOUCH,0) <> 0 AND ISNULL(PURNETWT,0) <> 0 THEN PURNETWT*PURTOUCH WHEN  ISNULL(PURTOUCH,0) = 0 AND ISNULL(PURNETWT,0) = 0 THEN 1 WHEN  ISNULL(PURTOUCH,0) = 0 AND ISNULL(PURNETWT,0) <> 0 THEN PURNETWT ELSE PURNETWT  END))))'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		*(CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END))* ISNULL(P.PURRATE,0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		+ ISNULL(P.PURMC,0) '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		+ (SELECT ISNULL(SUM(STNAMT),0) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO )  PURAMOUNT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.TRANDATE AS TRANDATE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.TRANNO AS TRANNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,T.TAGNO    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.GRSWT '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.NETWT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.WASTPER '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(CASE WHEN '''+ @GP +'''=''Y'' THEN '		"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CASE WHEN (SELECT COUNT(*) FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''SS'') > 0 THEN '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		I.WASTAGE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		(CASE WHEN ISNULL(I.METALID,'''')=''G'' THEN'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		 CONVERT(NUMERIC(15,2),((ISNULL(I.WASTAGE,0) * ISNULL(I.RATE,0)) + ISNULL(I.MCHARGE,0) - ISNULL(I.DISCOUNT,0) - ISNULL(I.FIN_DISCOUNT,0))*100'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		 /(ISNULL(I.AMOUNT,0)-((ISNULL(I.WASTAGE,0) * ISNULL(I.RATE,0)) + ISNULL(I.MCHARGE,0) + ISNULL(I.STNAMT,0) - ISNULL(I.DISCOUNT,0) - ISNULL(I.FIN_DISCOUNT,0))))'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		CONVERT(NUMERIC(15,2),I.MCHARGE)'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END)'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END)'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		ELSE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		I.WASTAGE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		END)WASTAGE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.MCHARGE '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT ISNULL(SUM(STNWT),0) FROM ISSSTONE WHERE ISSSNO = I.SNO ) AS STNWT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT ISNULL(SUM(STNAMT),0) FROM ISSSTONE WHERE ISSSNO = I.SNO ) AS STNAMT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(((CASE WHEN I.GRSNET = ''G'' THEN I.GRSWT ELSE I.NETWT END)+I.WASTAGE ) * I.BOARDRATE) + ISNULL(I.MCHARGE,0) + (SELECT ISNULL(SUM(STNAMT),0) FROM ISSSTONE WHERE ISSSNO = I.SNO ) AMOUNT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		, CONVERT(NUMERIC(15,2),NULL) PROFITPER'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		, CONVERT(NUMERIC(15,2),NULL) PROFITWEIGHT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		, CONVERT(NUMERIC(15,2),NULL) PROFITAMOUNT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,CONVERT(INT,1)AS RESULT'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,CONVERT(VARCHAR(1),'''')COLHEAD    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.ITEMID)AS ITEM'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,I.EMPID    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		,(SELECT EMPNAME FROM " & cnAdminDb & "..EMPMASTER WHERE EMPID = I.EMPID)AS EMPNAME'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		INTO TEMPTABLEDB..TAGWISEPROFITLOSS    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		FROM ISSUE I    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		INNER JOIN " & cnAdminDb & "..ITEMTAG T ON T.TAGNO=I.TAGNO AND T.ITEMID=I.ITEMID AND T.BATCHNO = I.BATCHNO    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		LEFT OUTER JOIN " & cnAdminDb & "..PURITEMTAG P ON P.TAGSNO = T.SNO    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		WHERE I.TRANDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''' '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		AND I.TRANTYPE=''SA'''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		AND ISNULL(I.CANCEL,'''') = '''''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		AND I.COMPANYID IN (SELECT COMPANYID FROM TEMPTABLEDB..COMPANY)    '"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13) +' 		AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..COSTCENTRE) AND ISNULL(I.METALID,'''') IN (SELECT METALID FROM TEMPTABLEDB..METAL)'"
        strSql += vbCrLf + "	PRINT(@QRY)"
        strSql += vbCrLf + "	EXEC(@QRY)"

        strSql += vbCrLf + "    	UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PROFITPER = CONVERT(NUMERIC(15,2),(CASE WHEN ISNULL(PURWASTAGE,0)<>0 THEN ISNULL(WASTAGE,0)*100/ISNULL(PURWASTAGE,0) END))"
        strSql += vbCrLf + "		,PROFITWEIGHT = ISNULL(WASTAGE,0) - ISNULL(PURWASTAGE,0), PROFITAMOUNT = ISNULL(AMOUNT,0) - ISNULL(PURAMOUNT ,0)  "

        strSql += vbCrLf + "		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "		BEGIN    "
        strSql += vbCrLf + "    		INSERT INTO TEMPTABLEDB..TAGWISEPROFITLOSS(PARTICULAR,ITEM,PURGRSWT,PURNETWT,PURWASTAGE,PURMC,PURSTNWT,PURSTNAMT,PURAMOUNT    "
        strSql += vbCrLf + "    		,GRSWT,NETWT,WASTAGE,MCHARGE,STNWT,STNAMT,AMOUNT,PROFITPER,PROFITWEIGHT,PROFITAMOUNT,RESULT,COLHEAD,EMPID,EMPNAME)    "
        strSql += vbCrLf + "    		SELECT 'GRAND TOTAL' AS PARTICULAR,'ZZZZZ'ITEM,SUM(PURGRSWT)PURGRSWT,SUM(PURNETWT)PURNETWT"
        strSql += vbCrLf + "    		,SUM(PURWASTAGE)PURWASTAGE,SUM(PURMC)PURMC,SUM(PURSTNWT)PURSTNWT,SUM(PURSTNAMT)PURSTNAMT"
        strSql += vbCrLf + "    		,SUM(PURAMOUNT)PURAMOUNT"
        strSql += vbCrLf + "    		,SUM(GRSWT)GRSWT,SUM(NETWT)NETWT,SUM(WASTAGE)WASTAGE,SUM(MCHARGE)MCHARGE"
        strSql += vbCrLf + "    		,SUM(STNWT)STNWT,SUM(STNAMT)STNAMT,SUM(AMOUNT)AMOUNT,ISNULL(AVG(PROFITPER),0)PROFITPER,ISNULL(SUM(PROFITWEIGHT),0)PROFITWEIGHT"
        strSql += vbCrLf + "    		,ISNULL(SUM(PROFITAMOUNT),0)PROFITAMOUNT"
        strSql += vbCrLf + "    		,3 RESULT,'G'COLHEAD    "
        strSql += vbCrLf + "    		,9999 EMPID,'ZZZZZ' EMPNAME"
        strSql += vbCrLf + "    		FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "		END    "
        strSql += vbCrLf + "		IF @GROUPBY = 'I' /** ITEM WISE GROUPING **/    "
        strSql += vbCrLf + "		BEGIN   "
        strSql += vbCrLf + "    		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "    		BEGIN    "
        strSql += vbCrLf + "    			/**INSERTING TITLE **/ "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB..TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD)    "
        strSql += vbCrLf + "    			SELECT DISTINCT ITEM,ITEM,0 RESULT,'T' COLHEAD FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "    			/**INSERTING ITEMWISE SUBTOTAL **/    "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB..TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD,PURGRSWT,PURNETWT,PURWASTAGE,PURMC,PURSTNWT,PURSTNAMT,PURAMOUNT"
        strSql += vbCrLf + "    			,GRSWT,NETWT,WASTAGE,MCHARGE,STNWT,STNAMT,AMOUNT,PROFITWEIGHT,PROFITAMOUNT)"
        strSql += vbCrLf + "    			SELECT '-> SUB TOTAL' AS PARTICULAR,ITEM,2 RESULT,'S'COLHEAD"
        strSql += vbCrLf + "    			,SUM(PURGRSWT),SUM(PURNETWT),SUM(PURWASTAGE),SUM(PURMC),SUM(PURSTNWT),SUM(PURSTNAMT),SUM(PURAMOUNT)"
        strSql += vbCrLf + "    			,SUM(GRSWT),SUM(NETWT),SUM(WASTAGE),SUM(MCHARGE),SUM(STNWT),SUM(STNAMT),SUM(AMOUNT),SUM(PROFITWEIGHT),SUM(PROFITAMOUNT)"
        strSql += vbCrLf + "    			FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1 GROUP BY ITEM "
        strSql += vbCrLf + "    			UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PARTICULAR = CASE WHEN ISNULL(SUBITEM,'') <> '' THEN '  ' + SUBITEM ELSE ITEM END WHERE RESULT = 1    "
        strSql += vbCrLf + "    		END    "
        strSql += vbCrLf + "		END    "
        strSql += vbCrLf + "		ELSE IF @GROUPBY = 'E' /** EMPLOYEE WISE GROUPING **/    "
        strSql += vbCrLf + "		BEGIN   "
        strSql += vbCrLf + "    		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "    		BEGIN    "
        strSql += vbCrLf + "    			/**INSERTING TITLE **/ "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB..TAGWISEPROFITLOSS(PARTICULAR,EMPNAME,RESULT,COLHEAD)    "
        strSql += vbCrLf + "    			SELECT DISTINCT EMPNAME,EMPNAME,0 RESULT,'T' COLHEAD FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "    			/**INSERTING ITEMWISE SUBTOTAL **/    "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB..TAGWISEPROFITLOSS(PARTICULAR,EMPNAME,RESULT,COLHEAD,PURGRSWT,PURNETWT,PURWASTAGE,PURMC,PURSTNWT,PURSTNAMT,PURAMOUNT"
        strSql += vbCrLf + "    			,GRSWT,NETWT,WASTAGE,MCHARGE,STNWT,STNAMT,AMOUNT,PROFITWEIGHT,PROFITAMOUNT)"
        strSql += vbCrLf + "    			SELECT EMPNAME + ' -> SUB TOTAL' AS PARTICULAR,EMPNAME,2 RESULT,'S'COLHEAD"
        strSql += vbCrLf + "    			,SUM(PURGRSWT),SUM(PURNETWT),SUM(PURWASTAGE),SUM(PURMC),SUM(PURSTNWT),SUM(PURSTNAMT),SUM(PURAMOUNT)"
        strSql += vbCrLf + "    			,SUM(GRSWT),SUM(NETWT),SUM(WASTAGE),SUM(MCHARGE),SUM(STNWT),SUM(STNAMT),SUM(AMOUNT),SUM(PROFITWEIGHT),SUM(PROFITAMOUNT)"
        strSql += vbCrLf + "    			FROM TEMPTABLEDB..TAGWISEPROFITLOSS WHERE RESULT = 1 GROUP BY EMPNAME "
        strSql += vbCrLf + "    			/*UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PARTICULAR = CASE WHEN ISNULL(EMPNAME,'') <> '' THEN '  ' + EMPNAME ELSE ITEM END WHERE RESULT = 1*/    "
        strSql += vbCrLf + "    			UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PARTICULAR = CASE WHEN ISNULL(SUBITEM,'') <> '' THEN '  ' + SUBITEM ELSE ITEM END WHERE RESULT = 1    "
        strSql += vbCrLf + "    		END    "
        strSql += vbCrLf + "		END "
        strSql += vbCrLf + "		ELSE IF @GROUPBY = 'N' /** GROUP BY NONE **/    "
        strSql += vbCrLf + "		BEGIN   "
        strSql += vbCrLf + "    		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PARTICULAR = ITEM WHERE RESULT = 1    "
        strSql += vbCrLf + "		END    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET STNWT=NULL WHERE STNWT=0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET STNAMT=NULL WHERE STNAMT=0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PURMC=NULL WHERE PURMC=0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PURSTNWT=NULL WHERE PURSTNWT=0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PURSTNAMT=NULL WHERE PURSTNAMT=0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PROFITWEIGHT=NULL WHERE PROFITWEIGHT =0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PROFITAMOUNT=NULL WHERE PROFITAMOUNT =0    "
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PURWASTPER=NULL WHERE PURWASTPER =0"
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET PURWASTAGE=NULL WHERE PURWASTAGE =0"
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET WASTPER=NULL WHERE WASTPER =0"
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET WASTAGE=NULL WHERE WASTAGE =0"
        strSql += vbCrLf + "		UPDATE TEMPTABLEDB..TAGWISEPROFITLOSS SET MCHARGE=NULL WHERE MCHARGE =0"
        strSql += vbCrLf + "		IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMP_TAGWISEPROFITLOSS')>0 DROP TABLE MASTER..TEMP_TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "		IF @GROUPBY = 'I'    "
        strSql += vbCrLf + "    		SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY ITEM,RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "		ELSE IF @GROUPBY = 'N'    "
        strSql += vbCrLf + "    		SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY RESULT,TRANDATE,TRANNO  "
        strSql += vbCrLf + "		ELSE IF @GROUPBY = 'E'    "
        strSql += vbCrLf + "    		SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM TEMPTABLEDB..TAGWISEPROFITLOSS ORDER BY EMPNAME,RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "		SELECT * FROM MASTER..TEMP_TAGWISEPROFITLOSS ORDER BY KEYNO    "
        strSql += vbCrLf + "    END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP24_TagWiseProfitLoss_Format2()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFITLOSS_FORMAT2')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGWISEPROFITLOSS_FORMAT2"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "CREATE PROCEDURE SP_RPT_TAGWISEPROFITLOSS_FORMAT2"
        strSql += vbCrLf + "(    "
        strSql += vbCrLf + "@FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + ",@TODATE SMALLDATETIME    "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(50)    "
        strSql += vbCrLf + ",@METALNAME VARCHAR(500)    "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(500)    "
        strSql += vbCrLf + ",@GROUPBY VARCHAR(1) /** (N)ONE,(I)ITEMWISE **/   "
        strSql += vbCrLf + ",@WASTBASED VARCHAR(1)"
        strSql += vbCrLf + ")    "
        strSql += vbCrLf + "AS    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY    "
        strSql += vbCrLf + "	CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))    "
        strSql += vbCrLf + "DECLARE @TCOMPANY VARCHAR(50)    "
        strSql += vbCrLf + "IF CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "	INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "WHILE CHARINDEX(',',@COMPANYID)>0    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)    "
        strSql += vbCrLf + "	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))    "
        strSql += vbCrLf + "	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "	BEGIN    "
        strSql += vbCrLf + "		SET @COMPANYID= @COMPANYID + ','    "
        strSql += vbCrLf + "	END    "
        strSql += vbCrLf + "	INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY    "
        strSql += vbCrLf + "END   "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#METAL', 'U') IS NOT NULL DROP TABLE #METAL    "
        strSql += vbCrLf + "	CREATE TABLE #METAL (METALID VARCHAR(1))    "
        strSql += vbCrLf + "DECLARE @TMETAL VARCHAR(50)  "

        strSql += vbCrLf + "IF @METALNAME = 'ALL' OR @METALNAME = ''  "
        strSql += vbCrLf + "BEGIN  "
        strSql += vbCrLf + "	INSERT INTO #METAL(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST  "
        strSql += vbCrLf + "END"
        strSql += vbCrLf + "ELSE "
        strSql += vbCrLf + "	BEGIN  "
        strSql += vbCrLf + "	IF CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "	BEGIN    "
        strSql += vbCrLf + "		INSERT INTO #METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME)    "
        strSql += vbCrLf + "	END    "
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@METALNAME)>0    "
        strSql += vbCrLf + "	BEGIN    "
        strSql += vbCrLf + "		SET @TMETAL=LEFT(@METALNAME,CHARINDEX(',',@METALNAME)-1)    "
        strSql += vbCrLf + "		SET @METALNAME=RIGHT(@METALNAME,LEN(@METALNAME)-CHARINDEX(',',@METALNAME))    "
        strSql += vbCrLf + "		IF @METALNAME <>'' AND CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "		BEGIN    "
        strSql += vbCrLf + "			SET @METALNAME= @METALNAME + ','    "
        strSql += vbCrLf + "		END    "
        strSql += vbCrLf + "		INSERT INTO #METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @TMETAL)    "
        strSql += vbCrLf + "	END  "
        strSql += vbCrLf + "END  "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE"
        strSql += vbCrLf + "	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))    "
        strSql += vbCrLf + "IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE) > 0    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "	DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + "	IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME)    "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + "		SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + "		IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME)    "
        strSql += vbCrLf + "	END    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "ELSE    "
        strSql += vbCrLf + "	INSERT INTO #COSTCENTRE(COSTID) SELECT '' COSTID "

        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#TAGWISEPROFITLOSS', 'U') IS NOT NULL DROP TABLE #TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "	SELECT CONVERT(VARCHAR(50),NULL)AS PARTICULAR    "
        strSql += vbCrLf + "	,(SELECT SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID)AS SUBITEM    "
        strSql += vbCrLf + "	,I.TRANDATE AS TRANDATE,I.TRANNO AS TRANNO,T.TAGNO    "
        strSql += vbCrLf + "	,CASE WHEN I.GRSNET='N' THEN I.NETWT ELSE I.GRSWT END SALEWT    "
        strSql += vbCrLf + "	,WASTAGE SALEWASTAGE,MCHARGE SALEMC    "
        strSql += vbCrLf + "	,(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO ) AS STNWT"
        strSql += vbCrLf + "	,(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO ) AS STNAMT"
        strSql += vbCrLf + "	,(CASE WHEN I.GRSNET='N' THEN I.NETWT ELSE I.GRSWT END +WASTAGE) TOTALSALEWT    "
        strSql += vbCrLf + "	,P.PURNETWT AS PURWT,P.PURTOUCH"
        strSql += vbCrLf + "	,CASE WHEN @WASTBASED <> 'T' THEN P.PURWASTAGE "
        strSql += vbCrLf + "	 ELSE CONVERT(NUMERIC(15,3),((CASE WHEN P.PURTOUCH = 0 THEN 0 ELSE P.PURTOUCH-I.PURITY END)*P.PURNETWT)/100)END AS PURWASTAGE"
        strSql += vbCrLf + "	,P.PURMC,(SELECT SUM(STNWT) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO ) AS PURSTNWT"
        strSql += vbCrLf + "	,(SELECT SUM(PURAMT) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO ) AS PURSTNAMT"
        strSql += vbCrLf + "	,CASE WHEN @WASTBASED <> 'T' THEN (P.PURNETWT +P.PURWASTAGE)   "
        strSql += vbCrLf + "	 ELSE(P.PURNETWT + ((CASE WHEN P.PURTOUCH < I.PURITY THEN 0 ELSE P.PURTOUCH-I.PURITY END)*P.PURNETWT)/100 ) END TOTALPURWT    "
        strSql += vbCrLf + "	,(CASE WHEN I.GRSNET='N' THEN I.NETWT ELSE I.GRSWT END +WASTAGE)-(P.PURNETWT + "
        strSql += vbCrLf + "	 CASE WHEN @WASTBASED <> 'T' THEN (P.PURNETWT +P.PURWASTAGE)   "
        strSql += vbCrLf + "	 ELSE(P.PURNETWT + ((CASE WHEN P.PURTOUCH < I.PURITY THEN 0 ELSE P.PURTOUCH-I.PURITY END)*P.PURNETWT)/100 ) END ) PROFITWT    "
        strSql += vbCrLf + "	,(MCHARGE+(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO ))-    "
        strSql += vbCrLf + "	(P.PURMC+(SELECT SUM(PURAMT) FROM " & cnAdminDb & "..PURITEMTAGSTONE WHERE TAGSNO = P.TAGSNO ))PROFITAMT    "
        strSql += vbCrLf + "	,CONVERT(INT,1)AS RESULT,CONVERT(VARCHAR(1),'')COLHEAD    "
        strSql += vbCrLf + "	,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.ITEMID)AS ITEM    "
        strSql += vbCrLf + "	INTO #TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "	FROM ISSUE I    "
        strSql += vbCrLf + "	INNER JOIN " & cnAdminDb & "..ITEMTAG T ON T.TAGNO=I.TAGNO AND T.ITEMID=I.ITEMID AND T.BATCHNO = I.BATCHNO    "
        strSql += vbCrLf + "	LEFT OUTER JOIN " & cnAdminDb & "..PURITEMTAG P ON P.TAGSNO = T.SNO    "
        strSql += vbCrLf + "	WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE='SA'    "
        strSql += vbCrLf + "	AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)    "
        strSql += vbCrLf + "	AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE) AND ISNULL(I.METALID,'') IN (SELECT METALID FROM #METAL)    "
        strSql += vbCrLf + "IF (SELECT COUNT(*) FROM #TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "	INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,SALEWT,SALEWASTAGE,SALEMC    "
        strSql += vbCrLf + "	,STNWT,STNAMT,TOTALSALEWT,PURWT,PURWASTAGE,PURMC,PURSTNWT,PURSTNAMT,TOTALPURWT,PROFITWT,PROFITAMT,RESULT,COLHEAD)    "
        strSql += vbCrLf + "	SELECT 'GRAND TOTAL' AS PARTICULAR,'ZZZZZ'ITEM,SUM(SALEWT),SUM(SALEWASTAGE)    "
        strSql += vbCrLf + "	,SUM(SALEMC),SUM(STNWT),SUM(STNAMT),SUM(TOTALSALEWT),SUM(PURWT),SUM(PURWASTAGE),SUM(PURMC)    "
        strSql += vbCrLf + "	,SUM(PURSTNWT),SUM(PURSTNAMT),SUM(TOTALPURWT),SUM(PROFITWT),SUM(PROFITAMT)    "
        strSql += vbCrLf + "	,3 RESULT,'G'COLHEAD    "
        strSql += vbCrLf + "	FROM #TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "IF @GROUPBY = 'I' /** ITEM WISE GROUPING **/    "
        strSql += vbCrLf + "BEGIN   "
        strSql += vbCrLf + "	IF (SELECT COUNT(*) FROM #TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "	BEGIN    "
        strSql += vbCrLf + "		/**INSERTING TITLE **/    "
        strSql += vbCrLf + "		INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD)    "
        strSql += vbCrLf + "		SELECT DISTINCT ITEM,ITEM,0 RESULT,'T' COLHEAD FROM #TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "		/**INSERTING ITEMWISE SUBTOTAL **/    "
        strSql += vbCrLf + "		INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD,SALEWT,SALEWASTAGE,SALEMC    "
        strSql += vbCrLf + "		,STNWT,STNAMT,TOTALSALEWT,PURWT,PURWASTAGE,PURMC,PURSTNWT,PURSTNAMT,TOTALPURWT,PROFITWT,PROFITAMT)    "
        strSql += vbCrLf + "		SELECT '-> SUB TOTAL' AS PARTICULAR,ITEM,2 RESULT,'S'COLHEAD,SUM(SALEWT),SUM(SALEWASTAGE),SUM(SALEMC)    "
        strSql += vbCrLf + "		,SUM(STNWT),SUM(STNAMT),SUM(TOTALSALEWT),SUM(PURWT),SUM(PURWASTAGE),SUM(PURMC)    "
        strSql += vbCrLf + "		,SUM(PURSTNWT),SUM(PURSTNAMT),SUM(TOTALPURWT),SUM(PROFITWT),SUM(PROFITAMT)    "
        strSql += vbCrLf + "		FROM #TAGWISEPROFITLOSS WHERE RESULT = 1 GROUP BY ITEM    "
        strSql += vbCrLf + "		UPDATE #TAGWISEPROFITLOSS SET PARTICULAR = CASE WHEN ISNULL(SUBITEM,'') <> '' THEN '  ' + SUBITEM ELSE ITEM END WHERE RESULT = 1    "
        strSql += vbCrLf + "	END    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "ELSE IF @GROUPBY = 'N' /** GROUP BY NONE **/    "
        strSql += vbCrLf + "BEGIN   "
        strSql += vbCrLf + "	UPDATE #TAGWISEPROFITLOSS SET PARTICULAR = ITEM WHERE RESULT = 1    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET SALEWT=NULL WHERE SALEWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET SALEWASTAGE=NULL WHERE SALEWASTAGE=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET SALEMC=NULL WHERE SALEMC=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET STNWT=NULL WHERE STNWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET STNAMT=NULL WHERE STNAMT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET TOTALSALEWT=NULL WHERE TOTALSALEWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PURWASTAGE=NULL WHERE PURWASTAGE=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PURMC=NULL WHERE PURMC=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PURSTNWT=NULL WHERE PURSTNWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PURSTNAMT=NULL WHERE PURSTNAMT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET TOTALPURWT=NULL WHERE TOTALPURWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PROFITWT=NULL WHERE PROFITWT=0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PROFITAMT=NULL WHERE PROFITAMT=0    "
        strSql += vbCrLf + "IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMP_TAGWISEPROFITLOSS')>0 DROP TABLE MASTER..TEMP_TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "IF @GROUPBY = 'I'    "
        strSql += vbCrLf + "	SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM #TAGWISEPROFITLOSS ORDER BY ITEM,RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "ELSE IF @GROUPBY = 'N'    "
        strSql += vbCrLf + "	SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM #TAGWISEPROFITLOSS ORDER BY RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "SELECT * FROM MASTER..TEMP_TAGWISEPROFITLOSS ORDER BY KEYNO    "
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP24_TagWiseProfitLoss()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_TAGWISEPROFITLOSS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_TAGWISEPROFITLOSS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "CREATE PROCEDURE SP_RPT_TAGWISEPROFITLOSS"
        strSql += vbCrLf + "(    "
        strSql += vbCrLf + "@FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + ",@TODATE SMALLDATETIME    "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(50)    "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(500)    "
        strSql += vbCrLf + ",@METALNAME VARCHAR(500)   "
        strSql += vbCrLf + ",@GROUPBY VARCHAR(1) /** (N)ONE,(I)ITEMWISE **/    "
        strSql += vbCrLf + ")    "
        strSql += vbCrLf + "AS    "
        strSql += vbCrLf + "BEGIN   "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY    "
        strSql += vbCrLf + "CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))    "
        strSql += vbCrLf + "DECLARE @TCOMPANY VARCHAR(50)  "
        strSql += vbCrLf + "IF CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "WHILE CHARINDEX(',',@COMPANYID)>0    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)    "
        strSql += vbCrLf + " SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))    "
        strSql += vbCrLf + " IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  SET @COMPANYID= @COMPANYID + ','    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + " INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#METAL', 'U') IS NOT NULL DROP TABLE #METAL    "
        strSql += vbCrLf + "CREATE TABLE #METAL (METALID VARCHAR(1))    "
        strSql += vbCrLf + "DECLARE @TMETAL VARCHAR(50)    "
        strSql += vbCrLf + "IF @METALNAME = 'ALL' OR @METALNAME = ''  "
        strSql += vbCrLf + "BEGIN  "
        strSql += vbCrLf + "INSERT INTO #METAL(METALID) SELECT METALID FROM " & cnAdminDb & "..METALMAST  "
        strSql += vbCrLf + "END  "
        strSql += vbCrLf + "ELSE  "
        strSql += vbCrLf + "  BEGIN  "
        strSql += vbCrLf + " IF CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  INSERT INTO #METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @METALNAME)    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + " WHILE CHARINDEX(',',@METALNAME)>0    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  SET @TMETAL=LEFT(@METALNAME,CHARINDEX(',',@METALNAME)-1)    "
        strSql += vbCrLf + "  SET @METALNAME=RIGHT(@METALNAME,LEN(@METALNAME)-CHARINDEX(',',@METALNAME))    "
        strSql += vbCrLf + "  IF @METALNAME <>'' AND CHARINDEX(',',@METALNAME)=0    "
        strSql += vbCrLf + "   BEGIN    "
        strSql += vbCrLf + "   SET @METALNAME= @METALNAME + ','    "
        strSql += vbCrLf + "   END    "
        strSql += vbCrLf + "  INSERT INTO #METAL (METALID) SELECT  (SELECT METALID FROM " & cnAdminDb & "..METALMAST WHERE METALNAME = @TMETAL)    "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "  END  "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#COSTCENTRE', 'U') IS NOT NULL DROP TABLE #COSTCENTRE"
        strSql += vbCrLf + "CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))    "
        strSql += vbCrLf + "IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE) > 0    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + " IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME)    "
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + "  SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + "  IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + "   END"
        strSql += vbCrLf + "  INSERT INTO #COSTCENTRE (COSTID) SELECT (SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME)    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "ELSE    "
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID) SELECT '' COSTID    "
        strSql += vbCrLf + "IF OBJECT_ID('TEMPDB..#TAGWISEPROFITLOSS', 'U') IS NOT NULL DROP TABLE #TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "SELECT     "
        strSql += vbCrLf + "CONVERT(VARCHAR(50),NULL)AS PARTICULAR    "
        strSql += vbCrLf + ",(SELECT SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID AND ITEMID=T.ITEMID)AS SUBITEM    "
        strSql += vbCrLf + ",I.TRANDATE AS TRANDATE,I.TRANNO AS TRANNO    "
        strSql += vbCrLf + ",T.TAGNO,I.PCS,I.GRSWT,I.NETWT    "
        strSql += vbCrLf + ",(SELECT SUM(STNPCS) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')) AS DIAPCS"
        strSql += vbCrLf + ",(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')) AS DIAWT"
        strSql += vbCrLf + ",(SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = 'D')) AS DIAAMT"
        strSql += vbCrLf + ",I.TAGSVALUE AS TAGVALUE,I.FIN_DISCOUNT AS DISCOUNT,CONVERT(DECIMAL(15,2),CASE WHEN ISNULL(I.TAGSVALUE,0)<>0 THEN (I.FIN_DISCOUNT/(I.TAGSVALUE/100)) ELSE 0 END)AS [DISC%]    "
        strSql += vbCrLf + ",I.TAX AS VAT,CONVERT(DECIMAL(15,2),CASE WHEN ISNULL(I.AMOUNT,0)<>0 THEN (I.TAX/(I.AMOUNT/100)) ELSE 0 END) AS [VAT%]    "
        strSql += vbCrLf + ",I.AMOUNT AS SALVALUE,CONVERT(VARCHAR(50),D.DESIGNERNAME) AS SUPPLIER  "
        strSql += vbCrLf + "/*,(P.PURVALUE-P.PURTAX ) AS PURVALUE    "
        strSql += vbCrLf + ",I.AMOUNT-(P.PURVALUE -P.PURTAX) AS DIFFVALUE*/    "
        strSql += vbCrLf + ",CASE WHEN I.TAGGRSWT>I.GRSWT THEN (CASE WHEN I.GRSNET='G' THEN ((I.GRSWT+P.PURWASTAGE)*P.PURRATE)+PURMC ELSE ((I.NETWT+P.PURWASTAGE)*P.PURRATE)+PURMC END)     "
        strSql += vbCrLf + "ELSE (P.PURVALUE-P.PURTAX ) END AS PURVALUE    "
        strSql += vbCrLf + ",I.AMOUNT-CASE WHEN I.TAGGRSWT>I.GRSWT THEN  (CASE WHEN I.GRSNET='G' THEN ((I.GRSWT+P.PURWASTAGE)*P.PURRATE)+PURMC ELSE ((I.NETWT+P.PURWASTAGE)*P.PURRATE)+PURMC END)     "
        strSql += vbCrLf + "ELSE (P.PURVALUE-P.PURTAX ) END AS DIFFVALUE    "
        strSql += vbCrLf + ",CONVERT(DECIMAL(15,2),CASE WHEN ISNULL(I.AMOUNT,0)<>0 THEN ((I.AMOUNT-(P.PURVALUE -P.PURTAX))/(I.AMOUNT/100)) ELSE 0 END) AS [DIFF%]    "
        strSql += vbCrLf + ",CONVERT(INT,1)AS RESULT    "
        strSql += vbCrLf + ",CONVERT(VARCHAR(1),'')COLHEAD    "
        strSql += vbCrLf + ",(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.ITEMID)AS ITEM    "
        strSql += vbCrLf + "INTO #TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "FROM ISSUE I    "
        strSql += vbCrLf + "INNER JOIN " & cnAdminDb & "..ITEMTAG T ON T.TAGNO=I.TAGNO AND T.ITEMID=I.ITEMID AND T.BATCHNO = I.BATCHNO    "
        strSql += vbCrLf + "LEFT OUTER JOIN " & cnAdminDb & "..PURITEMTAG P ON P.TAGSNO = T.SNO    "
        strSql += vbCrLf + "INNER JOIN " & cnAdminDb & "..DESIGNER D ON D.DESIGNERID=I.TAGDESIGNER    "
        strSql += vbCrLf + "WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE='SA'    "
        strSql += vbCrLf + "AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)    "
        strSql += vbCrLf + "AND ISNULL(I.COSTID,'') IN (SELECT COSTID FROM #COSTCENTRE)   "
        strSql += vbCrLf + "AND ISNULL(I.METALID,'') IN (SELECT METALID FROM #METAL)   "
        strSql += vbCrLf + "IF (SELECT COUNT(*) FROM #TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + "INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,PCS,GRSWT,NETWT,TAGVALUE,DISCOUNT,VAT,SALVALUE,PURVALUE,DIFFVALUE,RESULT,COLHEAD)    "
        strSql += vbCrLf + "SELECT 'GRAND TOTAL' AS PARTICULAR,'ZZZZZ'ITEM,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(TAGVALUE),SUM(DISCOUNT),SUM(VAT),SUM(SALVALUE),SUM(PURVALUE),SUM(DIFFVALUE)    "
        strSql += vbCrLf + ",3 RESULT,'G'COLHEAD    "
        strSql += vbCrLf + "FROM #TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "END    "
        strSql += vbCrLf + "IF @GROUPBY = 'I' /** ITEM WISE GROUPING **/    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM #TAGWISEPROFITLOSS WHERE RESULT = 1) > 0    "
        strSql += vbCrLf + "  BEGIN    "
        strSql += vbCrLf + "  /**INSERTING TITLE **/    "
        strSql += vbCrLf + "  INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD)    "
        strSql += vbCrLf + "  SELECT DISTINCT ITEM,ITEM,0 RESULT,'T' COLHEAD FROM #TAGWISEPROFITLOSS WHERE RESULT = 1    "
        strSql += vbCrLf + "  /**INSERTING ITEMWISE SUBTOTAL **/    "
        strSql += vbCrLf + "  INSERT INTO #TAGWISEPROFITLOSS(PARTICULAR,ITEM,RESULT,COLHEAD,PCS,GRSWT,NETWT,TAGVALUE,DISCOUNT,VAT,SALVALUE,PURVALUE,DIFFVALUE)    "
        strSql += vbCrLf + "  SELECT '-> SUB TOTAL' AS PARTICULAR,ITEM,2 RESULT,'S'COLHEAD,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(TAGVALUE),SUM(DISCOUNT),SUM(VAT),SUM(SALVALUE),SUM(PURVALUE),SUM(DIFFVALUE)    "
        strSql += vbCrLf + "  FROM #TAGWISEPROFITLOSS WHERE RESULT = 1 GROUP BY ITEM    "
        strSql += vbCrLf + "  UPDATE #TAGWISEPROFITLOSS SET PARTICULAR = CASE WHEN ISNULL(SUBITEM,'') <> '' THEN '  ' + SUBITEM ELSE ITEM END WHERE RESULT = 1    "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "ELSE IF @GROUPBY = 'N' /** GROUP BY NONE **/    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + " UPDATE #TAGWISEPROFITLOSS SET PARTICULAR = ITEM WHERE RESULT = 1    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET PURVALUE = NULL WHERE PURVALUE = 0    "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFITLOSS SET DIFFVALUE = NULL WHERE DIFFVALUE = 0    "
        strSql += vbCrLf + "IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMP_TAGWISEPROFITLOSS')>0 DROP TABLE MASTER..TEMP_TAGWISEPROFITLOSS    "
        strSql += vbCrLf + "IF @GROUPBY = 'I'    "
        strSql += vbCrLf + " SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM #TAGWISEPROFITLOSS ORDER BY ITEM,RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "ELSE IF @GROUPBY = 'N'    "
        strSql += vbCrLf + " SELECT *,IDENTITY(INT,0,1)AS KEYNO INTO MASTER..TEMP_TAGWISEPROFITLOSS FROM #TAGWISEPROFITLOSS ORDER BY RESULT,TRANDATE,TRANNO    "
        strSql += vbCrLf + "SELECT * FROM MASTER..TEMP_TAGWISEPROFITLOSS ORDER BY KEYNO    "
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_CHIT_ACC_POST()
        Dim ChitDbPrefix As String = ""
        ChitDbPrefix = GetSqlValue("SELECT CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'", "", tran)
        If ChitDbPrefix.ToString = "" Then Exit Sub
        strSql = " SELECT TOP 1 1 FROM MASTER..SYSDATABASES WHERE NAME = '" & ChitDbPrefix & "SAVINGS'"
        If GetSqlValue(strSql, "-1", tran) = "-1" Then
            Exit Sub
        End If

        strSql = " IF ISNULL((SELECT ID FROM " & ChitDbPrefix & "SH0708..SYSCOLUMNS WHERE ID =OBJECT_ID('" & ChitDbPrefix & "SH0708..SCHEMECOLLECT') AND NAME='FLAG'),'')='' "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "  	ALTER TABLE " & ChitDbPrefix & "SH0708..SCHEMECOLLECT ADD FLAG VARCHAR(3) "
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        Dim GCatCode As String = GetSqlValue("SELECT CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID = 'CATCODEGOLD'", , tran)
        Dim SCatCode As String = GetSqlValue("SELECT CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID = 'CATCODESILVER'", , tran)
        Dim CCCOMM_EXCLUDECOSTIDS As String = GetSqlValue("SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'CC_COMM_EXCLUDECOSTIDS'", "", tran)
        If GCatCode = "" Then GCatCode = "00015"
        If SCatCode = "" Then SCatCode = "00017"
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CHIT_ACC_POST')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CHIT_ACC_POST"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "  CREATE PROCEDURE SP_CHIT_ACC_POST"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FRMDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@TODATE SMALLDATETIME "
        strSql += vbCrLf + " )   "
        strSql += vbCrLf + " AS               "
        strSql += vbCrLf + " BEGIN "
        strSql += vbCrLf + " 	 DECLARE @BCC_CODE NVARCHAR(20)  "
        strSql += vbCrLf + " 	 DECLARE @QRY VARCHAR(4000)  "
        strSql += vbCrLf + " 	 DECLARE @CCOSTID VARCHAR(3)"
        strSql += vbCrLf + " 	 DECLARE @MCOSTID VARCHAR(3)"
        strSql += vbCrLf + " 	 DECLARE @GSTCALC VARCHAR(1)"
        strSql += vbCrLf + " 	 DECLARE @GST VARCHAR(1)"
        strSql += vbCrLf + " 	 DECLARE @TAX FLOAT"
        strSql += vbCrLf + " 	 DECLARE @PER FLOAT"
        strSql += vbCrLf + " 	 SET @TAX=0"
        strSql += vbCrLf + " 	 SELECT @CCOSTID=CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID='COSTID';  "
        strSql += vbCrLf + " 	 SELECT @GSTCALC=CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID='GSTCALC';  "
        strSql += vbCrLf + " 	 SELECT @GST    =CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID='GST';  "
        strSql += vbCrLf + " 	 SELECT @TAX    =SUM(CONVERT(NUMERIC(15,2),CTLTEXT)) FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID IN('SGST','CGST');"
        strSql += vbCrLf + " 	 SELECT @MCOSTID=CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='SYNC-TO';"
        strSql += vbCrLf + " 	 IF @MCOSTID = '' SET @CCOSTID = ''"
        strSql += vbCrLf + " 	 SET @PER=100+@TAX"
        strSql += vbCrLf + " 	 IF @GST='N' "
        strSql += vbCrLf + " 	 BEGIN"
        strSql += vbCrLf + " 		SET @GSTCALC='N'"
        strSql += vbCrLf + " 		SET @TAX=0"
        strSql += vbCrLf + " 	 END"
        strSql += vbCrLf + " 	 SELECT @BCC_CODE=CTLTEXT FROM " & ChitDbPrefix & "SAVINGS..SOFTCONTROL WHERE CTLID='COMACC';  "
        strSql += vbCrLf + " 	 IF EXISTS(SELECT NAME FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPCHITPOSTING')  DROP TABLE TEMPTABLEDB..TEMPCHITPOSTING               "
        strSql += vbCrLf + " 	 IF EXISTS(SELECT NAME FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPCHITWETPOSTING') DROP TABLE TEMPTABLEDB..TEMPCHITWETPOSTING   "
        strSql += vbCrLf + " 	 IF EXISTS(SELECT NAME FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = 'TEMPSCHEMECOLLECT') DROP TABLE TEMPTABLEDB..TEMPSCHEMECOLLECT"
        strSql += vbCrLf + " 	 SELECT *"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS TAX "
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS GSTPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS SGPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS CGPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS PER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS SGAMT"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS CGAMT"
        strSql += vbCrLf + " 	 INTO TEMPTABLEDB..TEMPSCHEMECOLLECT FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C "
        strSql += vbCrLf + " 	 WHERE RDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' "
        strSql += vbCrLf + " 	 INSERT INTO TEMPTABLEDB..TEMPSCHEMECOLLECT"
        strSql += vbCrLf + " 	 SELECT *"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS TAX "
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS GSTPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS SGPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS CGPER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS PER"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS SGAMT"
        strSql += vbCrLf + " 	 ,CONVERT(NUMERIC(15,2),0)AS CGAMT"
        strSql += vbCrLf + " 	 FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C "
        strSql += vbCrLf + " 	 WHERE CHEQUERETDATE BETWEEN @FRMDATE AND @TODATE  AND SNO NOT IN(SELECT SNO FROM TEMPTABLEDB..TEMPSCHEMECOLLECT)"
        strSql += vbCrLf + " 	 UPDATE TT SET TAX=T.TAX,GSTPER=@TAX,SGPER=@TAX/2,CGPER=@TAX/2,PER=@PER "
        strSql += vbCrLf + " 	 FROM " & ChitDbPrefix & "SH0708..SCHEMETRAN T ,TEMPTABLEDB..TEMPSCHEMECOLLECT TT "
        strSql += vbCrLf + " 	 WHERE TT.ENTREFNO=T.ENTREFNO"
        strSql += vbCrLf + " 	 UPDATE TEMPTABLEDB..TEMPSCHEMECOLLECT SET "
        strSql += vbCrLf + " 	 SGAMT=ROUND((AMOUNT*SGPER/PER),2)"
        strSql += vbCrLf + " 	 ,CGAMT=ROUND((AMOUNT*CGPER/PER),2) WHERE ISNULL(TAX,0)>0"
        strSql += vbCrLf + " 	 CREATE TABLE TEMPTABLEDB..TEMPCHITPOSTING (NSNO INT IDENTITY(1,1),SNO VARCHAR(15),TRANNO INT,TRANDATE SMALLDATETIME,ACCODE VARCHAR(15),TRANMODE VARCHAR(1)"
        strSql += vbCrLf + " 	 ,AMOUNT DECIMAL(15,2),PAYMODE VARCHAR(5),JCOMPANYID VARCHAR(5),COSTID VARCHAR(5),BATCHNO VARCHAR(15),ENTREFNO VARCHAR(30),FROMFLAG VARCHAR(1),CHQCARDNO VARCHAR(40)"
        strSql += vbCrLf + " 	 ,CARDID INT,CHQCARDREF VARCHAR(40),CHQDATE SMALLDATETIME,CONTRA VARCHAR(15),SYSTEMID VARCHAR(10),CASHID VARCHAR(10),REMARK1 VARCHAR(100),FLAG VARCHAR(3),RELIASEDATE SMALLDATETIME)"
        strSql += vbCrLf + " 	 INSERT INTO TEMPTABLEDB..TEMPCHITPOSTING (SNO,TRANNO,TRANDATE,ACCODE,TRANMODE,AMOUNT,PAYMODE,JCOMPANYID,COSTID,BATCHNO,ENTREFNO,FROMFLAG"
        strSql += vbCrLf + " 	 ,CHQCARDNO,CARDID,CHQCARDREF,CHQDATE,CONTRA,SYSTEMID,CASHID,REMARK1,FLAG)"
        strSql += vbCrLf + " 	 SELECT CONVERT(VARCHAR(15),NULL)SNO,CONVERT(INT,9999) AS TRANNO,RDATE AS TRANDATE,ACCODE  "
        strSql += vbCrLf + " 	 ,CASE WHEN TRANMODE = 'C' THEN 'C' ELSE 'D' END AS TRANMODE,SUM(AMOUNT) AMOUNT,PAYMODE  "
        strSql += vbCrLf + " 	 ,(SELECT JCOMPID FROM " & ChitDbPrefix & "SAVINGS..COMPANY WHERE COMPANYID = T.COMPANYID)AS JCOMPANYID  "
        strSql += vbCrLf + " 	 ,COSTID AS COSTID  "
        strSql += vbCrLf + " 	 ,ISNULL((SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'COSTID'),'')+ 'C' "
        strSql += vbCrLf + " 	 + SUBSTRING(CONVERT(VARCHAR,RDATE,112),3,6)AS BATCHNO,ENTREFNO,'C' FROMFLAG               "
        strSql += vbCrLf + " 	 ,CONVERT(VARCHAR(25),CHQCARDNO)CHQCARDNO,CONVERT(INT,CARDID)CARDID,CONVERT(VARCHAR(20),CHQCARDREF)AS CHQCARDREF,CONVERT(SMALLDATETIME,CHQDATE)CHQDATE             "
        strSql += vbCrLf + " 	 ,(SELECT TOP 1 CASE WHEN ISNULL(DEFAULTAC,'') <> '' THEN DEFAULTAC ELSE ACCODE END FROM " & compId & "ADMINDB..CREDITCARD WHERE COMPCODE = T.COMPANYID AND SCHEMECODE = T.SCHEMEID)AS CONTRA  "
        strSql += vbCrLf + " 	 ,SYSTEMID,CASHID,SUBSTRING(REMARK1,1,99)REMARK1,ISNULL(FLAG,'')FLAG/*,'' as REMARK1*/"
        strSql += vbCrLf + " 	 FROM               "
        strSql += vbCrLf + " 	 (               "
        strSql += vbCrLf + " 	 SELECT"
        strSql += vbCrLf + " 	 CASE MODEPAY WHEN 'C' THEN 'CA' WHEN 'D' THEN 'CH' WHEN 'R' THEN 'CC' WHEN 'E' THEN 'CH' ELSE MODEPAY END AS PAYMODE "
        strSql += vbCrLf + " 	 ,TRANMODE              "
        strSql += vbCrLf + " 	 ,(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID               "
        strSql += vbCrLf + " 	 ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID               "
        strSql += vbCrLf + " 	 ,AMOUNT               "
        strSql += vbCrLf + " 	 ,ISNULL(COSTID,'')COSTID,RDATE,CASE WHEN ISNULL(DEFAULT_ACC,'')<>''  THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE,ISNULL(CHQ_CARDNO,'')CHQCARDNO,ISNULL(CHQBANKCODE,0)CARDID               "
        strSql += vbCrLf + " 	 ,ISNULL(CHQBANK,'')CHQCARDREF,CONVERT(VARCHAR,CHQDATE,102)CHQDATE,NULL CONTRA  "
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY = 'C' THEN '' ELSE C.ENTREFNO END ENTREFNO  "
        strSql += vbCrLf + " 	 ,SYSTEMID,ISNULL(C.CASHCOUNTERID,'') AS CASHID/*,'' AS REMARK1*/"
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY NOT IN('C') THEN "
        strSql += vbCrLf + " 	 (SELECT PNAME FROM " & ChitDbPrefix & "SAVINGS..PERSONALINFO WHERE PERSONALID =("
        strSql += vbCrLf + " 	 SELECT SNO FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE =C.GROUPCODE And REGNO =C.REGNO )) + ' [ '+"
        strSql += vbCrLf + " 	 C.GROUPCODE+'-'+ CONVERT(VARCHAR,REGNO) + ' ]' ELSE '' END AS REMARK1,ISNULL(C.FLAG,'')FLAG "
        strSql += vbCrLf + " 	 FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C WHERE RDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = '' "
        strSql += vbCrLf + " 	 /*CREDIT CARD COMMISSION WITHIN BANK        */"
        strSql += vbCrLf + " 	 UNION ALL   "
        strSql += vbCrLf + " 	 SELECT"
        strSql += vbCrLf + " 	 CASE WHEN MODEPAY ='R' THEN 'BC' END AS PAYMODE "
        strSql += vbCrLf + " 	 ,TRANMODE              "
        strSql += vbCrLf + " 	 ,(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID               "
        strSql += vbCrLf + " 	 ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID               "
        strSql += vbCrLf + " 	 ,(AMOUNT*(SELECT TOP 1 COMMISSION FROM " & ChitDbPrefix & "SAVINGS..CREDITCARD WHERE ACCOUNT=C.ACCODE AND CARDCODE=C.CHQBANKCODE))/100"
        strSql += vbCrLf + " 	 ,ISNULL(COSTID,'')COSTID,RDATE"
        strSql += vbCrLf + " 	 ,'BANKC' ACCODE"
        strSql += vbCrLf + " 	 ,ISNULL(CHQ_CARDNO,'')CHQCARDNO,ISNULL(CHQBANKCODE,0)CARDID               "
        strSql += vbCrLf + " 	 ,ISNULL(CHQBANK,'')CHQCARDREF,CONVERT(VARCHAR,CHQDATE,102)CHQDATE,NULL CONTRA  "
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY = 'C' THEN '' ELSE C.ENTREFNO END ENTREFNO  "
        strSql += vbCrLf + " 	 ,SYSTEMID,ISNULL(C.CASHCOUNTERID,'') AS CASHID,'' AS REMARK1,ISNULL(C.FLAG,'')FLAG   "
        strSql += vbCrLf + " 	 FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C "
        strSql += vbCrLf + " 	 WHERE RDATE BETWEEN @FRMDATE AND @TODATE   AND ISNULL(CANCEL,'') = '' "
        strSql += vbCrLf + " 	 AND MODEPAY='R'"
        If CCCOMM_EXCLUDECOSTIDS.ToString <> "" Then strSql += vbCrLf + " AND COSTID NOT IN ('" & Replace(CCCOMM_EXCLUDECOSTIDS, ",", "','") & "')"
        strSql += vbCrLf + " 	 /*CREDIT CARD COMMISSION WITHIN BANK  "
        strSql += vbCrLf + " 	 Credit CARD CUSTOMER COLLECTION        */"
        strSql += vbCrLf + " 	 UNION ALL  "
        strSql += vbCrLf + " 	 SELECT"
        strSql += vbCrLf + " 	 CASE MODEPAY WHEN 'C' THEN 'CA' WHEN 'D' THEN 'CH' WHEN 'R' THEN 'CC' WHEN 'E' THEN 'CH' WHEN 'O' THEN 'OT' ELSE MODEPAY END AS PAYMODE               "
        strSql += vbCrLf + " 	 ,TRANMODE"
        strSql += vbCrLf + " 	 ,(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID               "
        strSql += vbCrLf + " 	 ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID               "
        strSql += vbCrLf + " 	 ,R.AMOUNT  "
        strSql += vbCrLf + " 	 ,ISNULL(C.COSTID,'')COSTID,RDATE,CASE WHEN ISNULL(DEFAULT_ACC,'')<>'' THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE,ISNULL(CHQ_CARDNO,'')CHQCARDNO,ISNULL(CHQBANKCODE,0)CARDID               "
        strSql += vbCrLf + " 	 ,ISNULL(CHQBANK,'')CHQCARDREF,CONVERT(VARCHAR,CHQDATE,102)CHQDATE,NULL CONTRA  "
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY = 'C' THEN '' ELSE C.ENTREFNO END ENTREFNO  "
        strSql += vbCrLf + " 	 ,C.SYSTEMID,ISNULL(C.CASHCOUNTERID,'') AS CASHID,'' AS REMARK1,ISNULL(C.FLAG,'')FLAG"
        strSql += vbCrLf + " 	 FROM " & ChitDbPrefix & "SH0708..SCHEMECOLLECT C INNER JOIN " & ChitDbPrefix & "SAVINGS..RECPAY R ON C.ENTREFNO = R.EntRefNo   "
        strSql += vbCrLf + " 	 WHERE C.RDATE BETWEEN @FRMDATE AND @TODATE AND "
        strSql += vbCrLf + " 	 ISNULL(C.CANCEL,'') = '' AND R.PAYMODE='CC'  AND (C.MODEPAY ='R' OR C.MODEPAY='D') "
        strSql += vbCrLf + " 	 AND R.FLAG='CO' "
        strSql += vbCrLf + " 	 /*Credit CARD CUSTOMER COLLECTION        */"
        strSql += vbCrLf + " 	 )T         "
        strSql += vbCrLf + " 	 GROUP BY PAYMODE,COSTID,RDATE,COMPANYID,ACCODE,CHQCARDNO,CARDID,CHQCARDREF,CHQDATE,SCHEMEID,SYSTEMID,ENTREFNO,CASHID,TRANMODE,REMARK1,FLAG "
        strSql += vbCrLf + " 	 UNION ALL               "
        strSql += vbCrLf + " 	 SELECT CONVERT(VARCHAR(15),NULL)SNO,CONVERT(INT,9999) AS TRANNO,RDATE AS TRANDATE  "
        strSql += vbCrLf + " 	 ,(SELECT TOP 1 CASE WHEN ISNULL(DEFAULTAC,'') <> '' THEN DEFAULTAC ELSE ACCODE END FROM " & compId & "ADMINDB..CREDITCARD WHERE COMPCODE = T.COMPANYID AND SCHEMECODE = T.SCHEMEID)AS CONTRA "
        strSql += vbCrLf + " 	 ,CASE WHEN TRANMODE = 'C' THEN 'D' ELSE 'C' END AS TRANMODE,SUM(AMOUNT) AMOUNT,'CT' PAYMODE               "
        strSql += vbCrLf + " 	 ,(SELECT JCOMPID FROM " & ChitDbPrefix & "SAVINGS..COMPANY WHERE COMPANYID = T.COMPANYID)AS JCOMPANYID               "
        strSql += vbCrLf + " 	 ,COSTID AS COSTID  "
        strSql += vbCrLf + " 	 ,ISNULL((SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'COSTID'),'')+ 'C' "
        strSql += vbCrLf + " 	 + SUBSTRING(CONVERT(VARCHAR,RDATE,112),3,6)AS BATCHNO,ENTREFNO,'C' AS FROMFLAG               "
        strSql += vbCrLf + " 	 ,CHQCARDNO,CARDID,CHQCARDREF,CHQDATE             "
        strSql += vbCrLf + " 	 ,ACCODE,SYSTEMID,CASHID,REMARK1,ISNULL(FLAG,'')FLAG /*'' AS REMARK1*/           "
        strSql += vbCrLf + " 	 FROM               "
        strSql += vbCrLf + " 	 (               "
        strSql += vbCrLf + " 	 SELECT"
        strSql += vbCrLf + " 	 CASE MODEPAY WHEN 'C' THEN 'CA' WHEN 'D' THEN 'CH' WHEN 'R' THEN 'CC' WHEN 'E' THEN 'CH' WHEN 'O' THEN 'OT' ELSE MODEPAY END AS PAYMODE  "
        strSql += vbCrLf + " 	 ,TRANMODE             "
        strSql += vbCrLf + " 	 ,(SELECT COMPANYID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO)COMPANYID               "
        strSql += vbCrLf + " 	 ,CONVERT(VARCHAR,(SELECT SCHEMEID FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE = C.GROUPCODE AND REGNO = C.REGNO))SCHEMEID               "
        strSql += vbCrLf + " 	 ,AMOUNT-(ISNULL(CGAMT,0)+ISNULL(SGAMT,0)) AS AMOUNT"
        strSql += vbCrLf + " 	 ,ISNULL(COSTID,'')COSTID,RDATE"
        strSql += vbCrLf + " 	 ,CASE WHEN ISNULL(DEFAULT_ACC,'')<>'' THEN DEFAULT_ACC ELSE ACCODE END AS ACCODE"
        strSql += vbCrLf + " 	 ,ISNULL(CHQ_CARDNO,'')CHQCARDNO,ISNULL(CHQBANKCODE,0)CARDID               "
        strSql += vbCrLf + " 	 ,ISNULL(CHQBANK,'')CHQCARDREF,CONVERT(VARCHAR,CHQDATE,102)CHQDATE,NULL CONTRA  "
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY = 'C' THEN '' ELSE C.ENTREFNO END ENTREFNO  "
        strSql += vbCrLf + " 	 ,SYSTEMID,ISNULL(C.CASHCOUNTERID,'') AS CASHID/*,'' AS REMARK1*/   "
        strSql += vbCrLf + " 	 ,CASE WHEN MODEPAY NOT IN('C') THEN "
        strSql += vbCrLf + " 	 (SELECT PNAME FROM " & ChitDbPrefix & "SAVINGS..PERSONALINFO WHERE PERSONALID =("
        strSql += vbCrLf + " 	 SELECT SNO FROM " & ChitDbPrefix & "SAVINGS..SCHEMEMAST WHERE GROUPCODE =C.GROUPCODE And REGNO =C.REGNO )) + ' [ '+"
        strSql += vbCrLf + " 	 C.GROUPCODE+'-'+ CONVERT(VARCHAR,REGNO) + ' ]' ELSE '' END AS REMARK1,ISNULL(C.FLAG,'')FLAG "
        strSql += vbCrLf + " 	 FROM TEMPTABLEDB..TEMPSCHEMECOLLECT C "
        strSql += vbCrLf + " 	 WHERE RDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''               "
        strSql += vbCrLf + " 	)T               "
        strSql += vbCrLf + " 	 GROUP BY PAYMODE,COSTID,RDATE,COMPANYID,ACCODE,CHQCARDNO,CARDID"
        strSql += vbCrLf + " 	 ,CHQCARDREF,CHQDATE,SCHEMEID,SYSTEMID,ENTREFNO,CASHID ,TRANMODE,REMARK1,FLAG "
        strSql += vbCrLf + " 	UNION ALL"
        strSql += vbCrLf + " 	SELECT CONVERT(VARCHAR(15),NULL)SNO,CONVERT(INT,9999) AS TRANNO,RDATE AS TRANDATE  "
        strSql += vbCrLf + " 	,CONTRA"
        strSql += vbCrLf + " 	,CASE WHEN TRANMODE = 'C' THEN 'D' ELSE 'C' END AS TRANMODE,SUM(AMOUNT) AMOUNT,'CT' PAYMODE               "
        strSql += vbCrLf + " 	,(SELECT JCOMPID FROM " & ChitDbPrefix & "SAVINGS..COMPANY WHERE COMPANYID = T.COMPANYID)AS JCOMPANYID               "
        strSql += vbCrLf + " 	,COSTID AS COSTID  "
        strSql += vbCrLf + " 	,ISNULL((SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'COSTID'),'')+ 'C' "
        strSql += vbCrLf + " 	+ SUBSTRING(CONVERT(VARCHAR,RDATE,112),3,6)AS BATCHNO,NULL ENTREFNO,'C' AS FROMFLAG               "
        strSql += vbCrLf + " 	,NULL CHQCARDNO,NULL CARDID,NULL CHQCARDREF,NULL CHQDATE             "
        strSql += vbCrLf + " 	,(SELECT TOP 1 CASE WHEN ISNULL(DEFAULTAC,'') <> '' THEN DEFAULTAC ELSE ACCODE END FROM " & compId & "ADMINDB..CREDITCARD WHERE COMPCODE = T.COMPANYID AND SCHEMECODE = T.SCHEMEID)AS ACCODE "
        strSql += vbCrLf + " 	,SYSTEMID,CASHID,'' AS REMARK1,'' AS FLAG           "
        strSql += vbCrLf + " 	FROM               "
        strSql += vbCrLf + " 	(  "
        strSql += vbCrLf + " 	 SELECT CONTRA,TRANMODE,COMPANYID,SCHEMEID,COSTID,RDATE,SYSTEMID,CASHID,REMARK1,SUM(AMOUNT)AMOUNT"
