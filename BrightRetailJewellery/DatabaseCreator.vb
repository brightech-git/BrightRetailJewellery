        strSql += vbCrLf + "		SELECT @QUERY=@QUERY+' FROM '+@TEMPTABLE +'1   ' 	"
        strSql += vbCrLf + "		PRINT @QUERY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY"

        strSql += vbCrLf + " 	SELECT @QUERY=' INSERT INTO '+@TEMPTABLE +'1'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' SELECT ''S'' AS COLHEAD'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',TYPENAME+ '' TOTAL'' '"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_GRSWT]) AS [OPENING_GRSWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_GRSWT]) AS [ISSUE_GRSWT],SUM([RECEIPT_GRSWT]) AS [RECEIPT_GRSWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_GRSWT])+SUM([ISSUE_GRSWT])-SUM([RECEIPT_GRSWT]) AS [CLOSING_GRSWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_NETWT]) AS [OPENING_NETWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_NETWT]) AS [ISSUE_NETWT],SUM([RECEIPT_NETWT]) AS [RECEIPT_NETWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_NETWT])+SUM([ISSUE_NETWT])-SUM([RECEIPT_NETWT]) AS [CLOSING_NETWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_PUREWT]) AS [OPENING_PUREWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_PUREWT]) AS [ISSUE_PUREWT],SUM([RECEIPT_PUREWT]) AS [RECEIPT_PUREWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_PUREWT])+SUM([ISSUE_PUREWT])-SUM([RECEIPT_PUREWT]) AS [CLOSING_PUREWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',NULL [LASTTRANDATE],TYPENAME [COLHEAD]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',''3'' [RESULT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' FROM '+@TEMPTABLE +'1  WHERE RESULT=2  GROUP BY TYPENAME  ' "
        strSql += vbCrLf + "		PRINT @QUERY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + " 	IF @NILBALANCE='N'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 		SELECT @QUERY=' DELETE FROM '+@TEMPTABLE +'1 '	"
        strSql += vbCrLf + " 		IF @WEIGHT='G'"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' WHERE ([OPENING_GRSWT]=0 AND [ISSUE_GRSWT]=0 AND [RECEIPT_GRSWT]=0 AND [CLOSING_GRSWT]=0) '"
        strSql += vbCrLf + " 		IF @WEIGHT='N' "
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' WHERE ([OPENING_NETWT]=0 AND [ISSUE_NETWT]=0 AND [RECEIPT_NETWT]=0 AND [CLOSING_NETWT]=0) '"
        strSql += vbCrLf + " 		IF @WEIGHT='P' "
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' WHERE ([OPENING_PUREWT]=0 AND [ISSUE_PUREWT]=0 AND [RECEIPT_PUREWT]=0 AND [CLOSING_PUREWT]=0) '"
        strSql += vbCrLf + " 		IF @WEIGHT='A' "
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' WHERE ([OPENING_GRSWT]=0 AND [ISSUE_GRSWT]=0 AND [RECEIPT_GRSWT]=0 AND [CLOSING_GRSWT]=0 '"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' AND [OPENING_NETWT]=0 AND [ISSUE_NETWT]=0 AND [RECEIPT_NETWT]=0 AND [CLOSING_NETWT]=0 '"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' AND [OPENING_PUREWT]=0 AND [ISSUE_PUREWT]=0 AND [RECEIPT_PUREWT]=0 AND [CLOSING_PUREWT]=0 '"
        strSql += vbCrLf + " 			SELECT @QUERY=@QUERY+' ) '"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 		PRINT @QUERY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + " 	END "
        strSql += vbCrLf + " 	SELECT @QUERY=' INSERT INTO '+@TEMPTABLE +'1'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' SELECT ''G'' AS COLHEAD'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',''GRAND TOTAL'''"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_GRSWT]) AS [OPENING_GRSWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_GRSWT]) AS [ISSUE_GRSWT],SUM([RECEIPT_GRSWT]) AS [RECEIPT_GRSWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_GRSWT])+SUM([ISSUE_GRSWT])-SUM([RECEIPT_GRSWT]) AS [CLOSING_GRSWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_NETWT]) AS [OPENING_NETWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_NETWT]) AS [ISSUE_NETWT],SUM([RECEIPT_NETWT]) AS [RECEIPT_NETWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_NETWT])+SUM([ISSUE_NETWT])-SUM([RECEIPT_NETWT]) AS [CLOSING_NETWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_PUREWT]) AS [OPENING_PUREWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',SUM([ISSUE_PUREWT]) AS [ISSUE_PUREWT],SUM([RECEIPT_PUREWT]) AS [RECEIPT_PUREWT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+',SUM([OPENING_PUREWT])+SUM([ISSUE_PUREWT])-SUM([RECEIPT_PUREWT]) AS [CLOSING_PUREWT]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',NULL [LASTTRANDATE],''ZZZ'' [COLHEAD]'"
        strSql += vbCrLf + "	SELECT @QUERY=@QUERY+',''999'' [RESULT]'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' FROM '+@TEMPTABLE +'1  WHERE RESULT=2  ' 	"
        strSql += vbCrLf + " 	PRINT @QUERY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + " 	SELECT @QUERY=' SELECT * FROM '+@TEMPTABLE +'1'"
        strSql += vbCrLf + " 	SELECT @QUERY=@QUERY+' ORDER BY TYPENAME,RESULT,ACNAME'"
        strSql += vbCrLf + " 	PRINT @QUERY"
        strSql += vbCrLf + " 	EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_SMITHITEMWISEABSTRACT()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SMITHITEMWISEABSTRACT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SMITHITEMWISEABSTRACT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "CREATE PROCEDURE SP_RPT_SMITHITEMWISEABSTRACT"
        strSql += vbCrLf + "(    "
        strSql += vbCrLf + "@DBNAME VARCHAR(50)    "
        strSql += vbCrLf + ",@TEMPTAB VARCHAR(30)     "
        strSql += vbCrLf + ",@FROMDATE VARCHAR(130)    "
        strSql += vbCrLf + ",@TODATE VARCHAR(130)    "
        strSql += vbCrLf + ",@WEIGHT VARCHAR(30)    "
        strSql += vbCrLf + ",@METALID VARCHAR(50)    "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(30)    "
        strSql += vbCrLf + ",@COSTID VARCHAR(1000)    "
        strSql += vbCrLf + ",@ACFILTER VARCHAR(100)    "
        strSql += vbCrLf + ",@TRANFILTER VARCHAR(100)    "
        strSql += vbCrLf + ",@CATFILTER VARCHAR(1000)    "
        strSql += vbCrLf + ",@NILBALANCE VARCHAR(10)    "
        strSql += vbCrLf + ",@APPTRANFILTER VARCHAR(100)    "
        strSql += vbCrLf + ",@PUREWTPER VARCHAR(100)    "
        strSql += vbCrLf + ",@ACCODE VARCHAR(1000)    "
        strSql += vbCrLf + ")AS    "
        strSql += vbCrLf + "BEGIN    "
        strSql += vbCrLf + " DECLARE @QUERY NVARCHAR(4000)"
        strSql += vbCrLf + " DECLARE @COMPANYFILTER VARCHAR(1000),@COMMFILTER VARCHAR(500)    "
        strSql += vbCrLf + " DECLARE @COMPANYFILTER1 VARCHAR(1000),@METALIDFILTER1 VARCHAR(1000)   "
        strSql += vbCrLf + " DECLARE @COSTFILTER VARCHAR(1000) ,@CATFILTER1 varchar(1000)    "
        strSql += vbCrLf + " DECLARE @TEMPTABLE VARCHAR(1000)    "
        strSql += vbCrLf + " DECLARE @METALIDFILTER VARCHAR(1000)    "
        strSql += vbCrLf + " DECLARE @APPROVALFILTER VARCHAR(1000)    "
        strSql += vbCrLf + " SET @TEMPTABLE='TEMPTABLEDB..'+@TEMPTAB    "
        strSql += vbCrLf + " SET @COMPANYFILTER=''    "
        strSql += vbCrLf + " SET @COSTFILTER=''    "
        strSql += vbCrLf + " SET @METALIDFILTER=''    "
        strSql += vbCrLf + " set @COMPANYID = REPLACE(@COMPANYID,',',''',''')    "
        strSql += vbCrLf + " SET @COMPANYFILTER=' AND COMPANYID IN ('''+@COMPANYID +''') '    "
        strSql += vbCrLf + "   SET @COMMFILTER = ' AND ISNULL(ACCODE,'''') <> '''' AND CANCEL <> ''Y'''    "
        strSql += vbCrLf + "   SET @COMPANYFILTER1=' AND R.COMPANYID IN ('''+@COMPANYID +''') '    "
        strSql += vbCrLf + " IF @TRANFILTER <> '' SET @TRANFILTER = ' AND TRANTYPE IN ('''+REPLACE(@TRANFILTER,',',''',''') +''')'    "
        strSql += vbCrLf + " IF @CATFILTER <> '' SET @CATFILTER = ' AND R.CATCODE IN ('''+REPLACE(@CATFILTER,',',''',''') +''')'    "
        strSql += vbCrLf + "  IF @CATFILTER <> '' SET @CATFILTER1 = ' AND R.CATCODE IN ('''+REPLACE(@CATFILTER,',',''',''') +''')'    "
        strSql += vbCrLf + " SET @APPROVALFILTER=''    "
        strSql += vbCrLf + " IF @APPTRANFILTER = 'N' SET @APPROVALFILTER = ' AND TRANTYPE NOT IN (''IAP'',''RAP'',''AI'',''AR'')'    "
        strSql += vbCrLf + " IF @METALID<>''    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SET @METALID=REPLACE(@METALID,',',''',''')    "
        strSql += vbCrLf + "  SET @METALIDFILTER=' AND METALID IN ('''+@METALID +''') '    "
        strSql += vbCrLf + "  SET @METALIDFILTER1=' AND R.METALID IN ('''+@METALID +''') '  "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + " IF @COSTID<> 'ALL' AND @COSTID<>''    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SET @COSTFILTER = REPLACE(@COSTID,',',''',''')    "
        strSql += vbCrLf + "  SET @COSTFILTER=' AND COSTID IN ('''+@COSTFILTER +''') '    "
        strSql += vbCrLf + "  PRINT @COSTFILTER    "
        strSql += vbCrLf + " End    "
        strSql += vbCrLf + " IF @ACCODE <>'' SET @ACCODE=' AND ISNULL(ACCODE,'''') IN('''+ @ACCODE +''')'    "
        strSql += vbCrLf + " SET @QUERY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '+''''+@TEMPTAB+''''+' )'     "
        strSql += vbCrLf + " SELECT @QUERY =@QUERY+'DROP TABLE ' + @TEMPTABLE"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY    "
        strSql += vbCrLf + " SET @QUERY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '+''''+@TEMPTAB+'FINAL'''+' )'     "
        strSql += vbCrLf + " SELECT @QUERY =@QUERY+'DROP TABLE ' + @TEMPTABLE+'FINAL'"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY     "
        strSql += vbCrLf + " SET @QUERY = ' IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = '+''''+@TEMPTAB+'FINAL1'''+' )'     "
        strSql += vbCrLf + " SELECT @QUERY =@QUERY+'DROP TABLE ' + @TEMPTABLE+'FINAL1'"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY     "
        strSql += vbCrLf + " SELECT @QUERY='CREATE TABLE '+ @TEMPTABLE +' ( PARTICUALRS VARCHAR(200),'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+'ACCODE VARCHAR(7),ITEM VARCHAR(50),SUBITEM VARCHAR(50),OPCS INTEGER DEFAULT 0, OPGRWT NUMERIC(15,3) DEFAULT 0,OPNETWT NUMERIC(15,3)  DEFAULT 0,OPPUREWT NUMERIC(15,3)  DEFAULT 0'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+',RPCS integer default 0, RGRWT NUMERIC(15,3)  DEFAULT 0,RNETWT NUMERIC(15,3)  DEFAULT 0,RPUREWT NUMERIC(15,3)  DEFAULT 0'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+',IPCS INTEGER DEFAULT 0,IGRWT NUMERIC(15,3)  DEFAULT 0,INETWT NUMERIC(15,3)  DEFAULT 0,IPUREWT NUMERIC(15,3)  DEFAULT 0'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+',COLHEAD NVARCHAR(2),SEP VARCHAR(4))'    "
        strSql += vbCrLf + " /*PRINT @QUERY  */"
        strSql += vbCrLf + "  EXECUTE SP_EXECUTESQL @QUERY    "
        strSql += vbCrLf + " SELECT @QUERY='INSERT INTO '+@TEMPTABLE +'(SEP,ACCODE,ITEM,SUBITEM,OPCS,OPGRWT,OPNETWT,OPPUREWT) '    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+'SELECT ''LOSE'',ACCODE,(SELECT ITEMNAME FROM ITEMMAST WHERE ITEMID IN (R.ITEMID))AS ITEM,(SELECT SUBITEMNAME FROM SUBITEMMAST WHERE SUBITEMID IN (R.SUBITEMID))AS SUBITEM,'  "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+'R.PCS AS OPCS,CASE WHEN TRANTYPE =''R'' THEN (R.GRSWT)*(-1) ELSE (R.GRSWT) END, CASE WHEN TRANTYPE = ''R'' THEN (R.NETWT)*(-1) ELSE (R.NETWT) END,'    "
        strSql += vbCrLf + " IF @PUREWTPER<>'0'"
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+CHAR(13)+' CASE WHEN TRANTYPE = ''R'' THEN ((R.PUREWT/'+ @PUREWTPER +')*100)*(-1) ELSE SUM((PUREWT/'+ @PUREWTPER +')*100) END FROM '+@DBNAME+'..OPENWEIGHT WHERE 1 =1'    "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+CHAR(13)+' CASE WHEN TRANTYPE = ''R'' THEN (R.PUREWT)*(-1) ELSE SUM(PUREWT) END FROM '+@DBNAME+'..OPENWEIGHT AS R WHERE 1 =1'    "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " IF @APPTRANFILTER = 'N' SELECT @QUERY=@QUERY+CHAR(13)+' AND ISNULL(APPROVAL,'''')<>''A'''    "
        strSql += vbCrLf + " if @METALIDFILTER <> '' SELECT @QUERY=@QUERY+CHAR(13)+' AND CATCODE IN (SELECT CATCODE FROM CATEGORY WHERE 1=1 '+ @METALIDFILTER +')'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+@COMPANYFILTER+@COSTFILTER+REPLACE(@COMMFILTER,'AND CANCEL <> ''Y''','')+@CATFILTER+@ACCODE    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' GROUP BY ACCODE,TRANTYPE,ITEMID,SUBITEMID,R.PCS,R.GRSWT,R.NETWT,R.PUREWT '    "
        strSql += vbCrLf + " /* PRINT @QUERY */"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY    "
        strSql += vbCrLf + " /*OPENING FROM RECEIPT*/    "
        strSql += vbCrLf + " SELECT @QUERY='INSERT INTO '+@TEMPTABLE +'(SEP,ACCODE,ITEM,SUBITEM,OPCS,OPGRWT,OPNETWT,OPPUREWT) '    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' SELECT '"
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' CASE WHEN R.METALID IN(''D'',''T'',''P'') THEN ''STUD'' ELSE ''LOSE'' END'"
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' ,ACCODE,CASE WHEN(ISNULL(R.ITEMID,'''')=''0'')THEN(SELECT CATNAME FROM CATEGORY WHERE CATCODE IN (R.CATCODE))' "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' ELSE(SELECT ITEMNAME FROM ITEMMAST WHERE ITEMID IN (R.ITEMID))END ITEM ,'"
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+'(SELECT SUBITEMNAME FROM SUBITEMMAST WHERE SUBITEMID IN (R.SUBITEMID)) AS SUBITEM,'"
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' R.PCS AS OPCS,(ISNULL(R.GRSWT,0)+CASE WHEN R.TRANTYPE NOT IN (''MI'',''AR'') THEN ISNULL(R.ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END)*(-1)'    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' ,(ISNULL(R.NETWT,0)+CASE WHEN R.TRANTYPE NOT IN (''MI'',''AR'') THEN ISNULL(R.ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END)*(-1)'    "
        strSql += vbCrLf + " IF @PUREWTPER<>'0'"
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+CHAR(13)+' ,((ISNULL(R.PUREWT,0)/'+ @PUREWTPER +')*100)*(-1)'     "
        strSql += vbCrLf + " END     "
        strSql += vbCrLf + " ELSE    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SELECT @QUERY=@QUERY+CHAR(13)+' ,(ISNULL(R.PUREWT,0))*(-1)'     "
        strSql += vbCrLf + " END    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' FROM '+@DBNAME+'..RECEIPT AS R LEFT JOIN ITEMMAST AS I ON R.ITEMID=I.ITEMID LEFT JOIN SUBITEMMAST AS S ON R.ITEMID=S.ITEMID'   "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' LEFT JOIN CATEGORY AS C ON R.CATCODE=C.CATCODE' "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' WHERE R.TRANTYPE NOT IN (''RPU'',''IPU'') AND TRANDATE < '''+@FROMDATE+''''    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+CHAR(13)+@COMPANYFILTER1+@COSTFILTER+@COMMFILTER+@METALIDFILTER1+@CATFILTER+@TRANFILTER+@APPROVALFILTER+@ACCODE    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' GROUP BY ACCODE,R.ITEMID,R.SUBITEMID,R.PCS,R.GRSWT,R.NETWT,R.PUREWT,R.TRANTYPE,R.ALLOY,R.WASTAGE ,R.METALID,R.CATCODE '    "
        strSql += vbCrLf + " /* PRINT @QUERY   */"
        strSql += vbCrLf + " EXECUTE SP_EXECUTESQL @QUERY    "
        strSql += vbCrLf + " /*OPENING FROM RECEIPTSTONE*/    "
        strSql += vbCrLf + " SELECT @QUERY='INSERT INTO '+@TEMPTABLE +'(SEP,ACCODE,ITEM,SUBITEM,OPCS,OPGRWT,OPNETWT,OPPUREWT) '    "
        strSql += vbCrLf + " SELECT @QUERY=@QUERY+CHAR(13)+' SELECT ''STUD'',I.ACCODE,(CASE WHEN ISNULL(IM.ITEMNAME,'''')=''0'' THEN (SELECT CATNAME FROM CATEGORY WHERE CATCODE IN (S.CATCODE))ELSE IM.ITEMNAME END) AS ITEM,SM.SUBITEMNAME AS SUBITEM,S.STNPCS AS RPCS'    "
