    Private Sub PROC_GETRATE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_GETRATE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_GETRATE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE PROC_GETRATE"
        strSql += vbCrLf + " (@DATE VARCHAR(12)"
        strSql += vbCrLf + " ,@CATCODE VARCHAR(12))"
        strSql += vbCrLf + " AS "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT TOP 1 SRATE FROM RATEMAST AS M"
        strSql += vbCrLf + " WHERE RDATE = @DATE"
        strSql += vbCrLf + " AND RATEGROUP = (SELECT MAX(RATEGROUP) FROM RATEMAST WHERE RDATE = M.RDATE)"
        strSql += vbCrLf + " AND METALID = (SELECT METALID FROM PURITYMAST WHERE PURITYID IN (SELECT PURITYID FROM CATEGORY WHERE CATCODE=@CATCODE))"
        strSql += vbCrLf + " AND PURITY = (SELECT PURITY FROM PURITYMAST WHERE PURITYID IN (SELECT PURITYID FROM CATEGORY WHERE CATCODE=@CATCODE))"
        strSql += vbCrLf + " ORDER BY SNO DESC"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub PROC_JSON()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_JSON')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_JSON"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        If SqlVersion > 8 Then
            strSql = vbCrLf + " CREATE PROCEDURE PROC_JSON(@URL AS VARCHAR(MAX))"
        Else
            strSql = vbCrLf + " CREATE PROCEDURE PROC_JSON(@URL AS VARCHAR(8000))"
        End If
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "	Declare @Object as Int;"
        strSql += vbCrLf + "	Declare @ResponseText as Varchar(8000);"
        strSql += vbCrLf + "	PRINT @URL"
        strSql += vbCrLf + "	Exec sp_OACreate 'MSXML2.XMLHTTP', @Object OUT;"
        strSql += vbCrLf + "	Exec sp_OAMethod @Object, 'open', NULL, 'get',@URL,'false'    "
        strSql += vbCrLf + "	Exec sp_OAMethod @Object, 'send'"
        strSql += vbCrLf + "	Exec sp_OAMethod @Object, 'responseText', @ResponseText OUTPUT"
        strSql += vbCrLf + "	Select @ResponseText"
        strSql += vbCrLf + "	Exec sp_OADestroy @Object"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


