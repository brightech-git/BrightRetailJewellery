    Private Sub SP_RPT_PREVILEGETRAN_06032021()

        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PREVILEGETRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PREVILEGETRAN"
