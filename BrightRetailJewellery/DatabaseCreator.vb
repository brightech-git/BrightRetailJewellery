        strSql += vbCrLf + " ,@NEWMC=45"
        strSql += vbCrLf + " ,@NEWWS=1.25"
        strSql += vbCrLf + " ,@NEWPU=93"
        strSql += vbCrLf + " ,@NEWCL='G'"
        strSql += vbCrLf + " ,@USERNAME = 'ADMIN'"
        strSql += vbCrLf + " ,@COSTID = 'PA'"
        strSql += vbCrLf + " ,@MOBILENO = '9840538818'"
