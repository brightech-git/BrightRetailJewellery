        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 ADDRESS3 FROM ACHEAD WHERE ACCODE=I.ACCODE) AS ADDRESS3'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 AREA FROM ACHEAD WHERE ACCODE=I.ACCODE) AS AREA'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 CITY FROM ACHEAD WHERE ACCODE=I.ACCODE) AS CITY'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 STATE FROM ACHEAD WHERE ACCODE=I.ACCODE) AS STATE'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 COUNTRY FROM ACHEAD WHERE ACCODE=I.ACCODE) AS COUNTRY'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 PINCODE FROM ACHEAD WHERE ACCODE=I.ACCODE) AS PINCODE'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 PHONENO FROM ACHEAD WHERE ACCODE=I.ACCODE) AS PHONE'	"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 MOBILE FROM ACHEAD WHERE ACCODE=I.ACCODE) AS MOBILE'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,(SELECT TOP 1 EMAILID FROM ACHEAD WHERE ACCODE=I.ACCODE) AS EMAIL'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' ,I.BATCHNO,2 AS RESULT,'' '' AS COLHEAD,I.SNO,I.COSTID'		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' FROM '+@DBNAME+'..RECEIPT I'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)'  "
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' AND ISNULL(I.COMPANYID,'''') = '''+@COMPANYID+''' AND ISNULL(I.CANCEL,'''') = '''' '  		"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY +CHAR(13)+' AND TRANTYPE IN(''RRE'') AND MCHARGE>0 '				"
