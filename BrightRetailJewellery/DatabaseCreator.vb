        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	IF @DISPLAY = 'A'"
        strSql += vbCrLf + " 	INSERT INTO TEMPTABLEDB..TEMP_ACHEAD(ACCODE,TRANTYPE)"
