        strSql += vbCrLf + "     	[PINCODE] [varchar](100) NULL DEFAULT (''),"
        strSql += vbCrLf + "     	[CITY] [varchar](100) NULL DEFAULT (''),"
        strSql += vbCrLf + "     	[STATE] [varchar](100) NULL DEFAULT (''),"
        strSql += vbCrLf + "     	[COUNTRY] [varchar](100) NULL DEFAULT (''),"
        strSql += vbCrLf + "     	[PHONE] [varchar](30) NULL DEFAULT (''),"
        strSql += vbCrLf + "     	[EMAIL] [varchar](50) NULL DEFAULT (''),"
        ''strSql += vbCrLf + "     	[ASIGN] IMAGE,"
        strSql += vbCrLf + "     	[VERSION] [varchar](30) NULL DEFAULT (NULL),"
        strSql += vbCrLf + "     PRIMARY KEY CLUSTERED "
        strSql += vbCrLf + "     ("
        strSql += vbCrLf + "     	[COMPANYID] ASC"
        strSql += vbCrLf + "     )WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON) ON [PRIMARY]"
        strSql += vbCrLf + "     ) ON [PRIMARY]"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        funcProgressStep(1)
    End Function


    Private Sub Install()
        Dim DbUpdator As Boolean = False
        Try
            If YEnd And chkDbFieldUpdation.Visible And chkDbFieldUpdation.Checked = False Then
                GoTo YEnd_Process
            End If
            If dbType = "W" Then
                cn = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=;Data Source=" & serverName & "")
            ElseIf dbType = "JEWELS_USER" Then
                cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=master;Data Source=" & serverName & ";password=" & pwd)
            Else
                cn = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=;Data Source=" & serverName & ";password=" & pwd)
            End If
            cn.Open()
            strSql = " DECLARE @QRY NVARCHAR(4000)"
            strSql += " DECLARE @TNAME VARCHAR(50)"
            strSql += " DECLARE CUR CURSOR"
            strSql += " FOR SELECT NAME FROM MASTER..SYSOBJECTS WHERE XTYPE = 'U' AND CATEGORY = 0"
            strSql += " AND NAME LIKE 'TEMP%'"
            'strSql += vbCrLf + " (SELECT TBL.NAME FROM SYSCONSTRAINTS AS SC"
            'strSql += vbCrLf + " INNER JOIN SYSOBJECTS AS OBJ ON OBJ.ID = SC.CONSTID AND OBJ.NAME LIKE 'FK_%'"
            'strSql += vbCrLf + " INNER JOIN SYSOBJECTS AS TBL ON TBL.ID = SC.ID )"
            strSql += " OPEN CUR"
            strSql += " WHILE 1=1"
            strSql += " BEGIN"
            strSql += " FETCH NEXT FROM CUR INTO @TNAME"
            strSql += " SET NOCOUNT ON"
            strSql += " IF @@FETCH_STATUS = -1 BREAK"
            strSql += " SELECT @QRY = 'DROP TABLE ' + @TNAME"
            strSql += " EXEC SP_EXECUTESQL @QRY"
            strSql += " END"
            strSql += " CLOSE CUR"
            strSql += " DEALLOCATE CUR"
            Dim cmd As OleDbCommand
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
            cmd.ExecuteNonQuery()

            strSql = "SELECT @@MICROSOFTVERSION/POWER(2,24)"
            SqlVersion = GetSqlValue(strSql, 8, tran)
            If DbChecker(compId + suffix) = 0 Then
                ''Create db
                STATUS = "Create Database """ & compId + suffix & ""
                funcProgressStep()
                CreateDb(compId + suffix)
                funcProgressStep(1)
            Else
                DbUpdator = True
                ''Create Dup db
                STATUS = "Create Database """ & compId + suffix & ""
                funcProgressStep(0)
                CreateDuplicateDb(compId + suffix)
                funcProgressStep(1)
            End If
            Dim usuffix As String = "UTILDB"

            If DbChecker(compId + usuffix) = 0 Then
                ''Create db
                STATUS = "Create Database """ & compId + usuffix & ""
                funcProgressStep()
                CreateUtilDb(compId + usuffix)
                CreateUtilDbTables(compId + usuffix)
                funcProgressStep(1)
            Else
                DbUpdator = True
                ''Create Dup db
                STATUS = "Create Database """ & compId + usuffix & ""
                funcProgressStep(0)
                CreateDuplicateDb(compId + usuffix)
                CreateUtilDbTables("Duplicate" + compId + usuffix)
                TraceDb(compId + usuffix, "Duplicate" + compId + usuffix)
                funcProgressStep(1)
            End If
            Dim cdmCompanyId As String = "AKS"
            Dim Cdmsuffix As String = "CDM"
            Try
                strSql = " SELECT NAME FROM " & compId & "ADMINDB..SYSOBJECTS WHERE ID = OBJECT_ID('" & compId & "ADMINDB..SOFTCONTROL','U')"
                If GetSqlValue(strSql, "", tran) <> "" Then
                    If GetSqlValue("SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='AKSCDM'", "N", tran) = "Y" Then
                        If DbChecker(cdmCompanyId + Cdmsuffix) = 0 Then
                            ''Create db
                            STATUS = "Create Database """ & cdmCompanyId + Cdmsuffix & ""
                            funcProgressStep()
                            CreateDb(cdmCompanyId + Cdmsuffix)
                            CreateCdmDbTables(cdmCompanyId + Cdmsuffix)
                            funcProgressStep(1)
                        Else
                            DbUpdator = True
                            ''Create Dup db
                            STATUS = "Create Database """ & cdmCompanyId + Cdmsuffix & ""
                            funcProgressStep(0)
                            CreateDuplicateDb(cdmCompanyId + Cdmsuffix)
                            CreateCdmDbTables("Duplicate" + cdmCompanyId + Cdmsuffix)
                            TraceDb(cdmCompanyId + Cdmsuffix, "Duplicate" + cdmCompanyId + Cdmsuffix)
                            funcProgressStep(1)
                        End If
                        If Val(GetSqlValue("SELECT COUNT(*) CNT FROM SYS.databases WHERE name = 'AKSCDM'", 0, tran)) > 0 Then
                            Dim cnAks As New OleDbConnection
                            cnAks = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=AKSCDM;Data Source=" & serverName & ";password=" & pwd)
                            cnAks.Open()
                            If cnAks.State = ConnectionState.Closed Then cnAks.Open()
                            'STORED PRODUCUDER
                            AKSCDM_SP_INSERT_CUSTOMERINFO(cdmCompanyId + Cdmsuffix, cnAks)
                            AKSCDM_SP_FEEDBACKMASTER(cdmCompanyId + Cdmsuffix, cnAks)
                            AKSCDM_SP_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks)
                            'TRIGGER
                            AKSCDM_TRIG_PERSONALINFO(cdmCompanyId + Cdmsuffix, cnAks)
                            'INSERT FEEDBACKMASTER
                            AKSCDM_INSERT_FEEDBACKMASTER(cdmCompanyId + Cdmsuffix, cnAks, 1, "SERVICE")
                            AKSCDM_INSERT_FEEDBACKMASTER(cdmCompanyId + Cdmsuffix, cnAks, 2, "HOSPITALITY")
                            AKSCDM_INSERT_FEEDBACKMASTER(cdmCompanyId + Cdmsuffix, cnAks, 3, "STAFF BEHAVIOUR")
                            AKSCDM_INSERT_FEEDBACKMASTER(cdmCompanyId + Cdmsuffix, cnAks, 4, "COLLECTIONS")
                            'INSERT INTO FEEDBACKRESULT
                            AKSCDM_INSERT_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks, 1, "EXCELLENT")
                            AKSCDM_INSERT_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks, 2, "GOOD")
                            AKSCDM_INSERT_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks, 3, "AVERAGE")
                            AKSCDM_INSERT_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks, 4, "BAD")
                            AKSCDM_INSERT_FEEDBACKRESULT(cdmCompanyId + Cdmsuffix, cnAks, 5, "POOR")
                            cnAks.Close()
                        End If
                    End If
                End If
            Catch ex As Exception
                MessageBox.Show(ex.ToString)
                Exit Sub
            End Try

            funcCreateTransactionDb()
            cn.Close()
            cn.Open()
            tran = cn.BeginTransaction
            ''Newly Added for transfering itemtag from trandb to Admindb
            strSql = " SELECT NAME FROM " & tranDbName & "..SYSOBJECTS WHERE ID = OBJECT_ID('" & tranDbName & "..ITEMTAG','U')"
