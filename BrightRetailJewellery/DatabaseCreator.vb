        strSql += vbCrLf + " 		PRINT(@QRY)"
        strSql += vbCrLf + " 		EXEC(@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY=CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPISSUE(PARTICULAR,TYPE,RESULT,COLHEAD)'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT TYPE,TYPE,0,''T'' FROM TEMPTABLEDB..TEMPISSUE'"
        strSql += vbCrLf + " 		EXEC(@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPISSUE(PARTICULAR,COUNTER,TYPE,RESULT,COLHEAD)'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT COUNTER,COUNTER,TYPE,1,''T1'' FROM TEMPTABLEDB..TEMPISSUE  WHERE COUNTER<>'''''"
        strSql += vbCrLf + " 		EXEC(@QRY)"
        strSql += vbCrLf + " 		SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPISSUE(PARTICULAR,ITEMNAME,COUNTER,TYPE,RESULT,COLHEAD)'"
        strSql += vbCrLf + " 		SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT ITEMNAME,ITEMNAME,COUNTER,TYPE,2,''T2'' FROM TEMPTABLEDB..TEMPISSUE  WHERE ITEMNAME<>'''''"
