        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT ITEMNAME COL1,TRANNO,METALNAME,PCS,GRSWT,NETWT,MCHARGE,RATE,AMOUNT,TAX,RECEIPT,PAYMENT,TAGNO,BATCHNO,COLHEAD ,RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET ORDER BY METALNAME,RESULT ,ITEMNAME,CONVERT(INT,TRANNO)   "
        strSql += vbCrLf + "		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT METALNAME+'' TOTAL '' COL1,NULL,METALNAME,SUM(CONVERT(NUMERIC(10,3),PCS))PCS,SUM(CONVERT(NUMERIC(10,3),GRSWT))GRSWT,SUM(CONVERT(NUMERIC(10,3),NETWT))NETWT"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),MCHARGE))MCHARGE,SUM(CONVERT(NUMERIC(10,3),RATE))RATE,SUM(CONVERT(NUMERIC(10,3),AMOUNT)),SUM(CONVERT(NUMERIC(10,3),TAX))TAX"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),RECEIPT)),SUM(CONVERT(NUMERIC(10,3),PAYMENT)),NULL,''''BATCHNO,''S1''COLHEAD,2 RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET WHERE RESULT = 1  GROUP BY METALNAME,RESULT"
        strSql += vbCrLf + "  		ORDER BY METALNAME,RESULT "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT2(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COL13,COL14,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT ''SALES RETUREN DETAIL TOTAL '' COL1,NULL,null,SUM(CONVERT(NUMERIC(10,3),PCS))PCS,SUM(CONVERT(NUMERIC(10,3),GRSWT))GRSWT,SUM(CONVERT(NUMERIC(10,3),NETWT))NETWT"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),MCHARGE))MCHARGE,SUM(CONVERT(NUMERIC(10,3),RATE))RATE,SUM(CONVERT(NUMERIC(10,3),AMOUNT)),SUM(CONVERT(NUMERIC(10,3),TAX))TAX"
        strSql += vbCrLf + "  		,SUM(CONVERT(NUMERIC(10,3),RECEIPT)),SUM(CONVERT(NUMERIC(10,3),PAYMENT)),NULL,''''BATCHNO,''T1''COLHEAD,3 RESULT"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'SALESRET WHERE RESULT = 1  "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT 1  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)      "
        strSql += vbCrLf + "  		PRINT'/******************** PURCHASE ADJUSTED ********************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'PURCHASE'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,''   '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (sELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO"
        strSql += vbCrLf + "  		WHERE BATCHNO = R.BATCHNO)) AS CUSNAME                 ,ISNULL((SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = R.ITEMID),'''') "
