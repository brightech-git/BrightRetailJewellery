        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		DECLARE @COLUMN AS VARCHAR(50)"
        strSql += vbCrLf + "		DECLARE CUR CURSOR FOR"
        strSql += vbCrLf + "		SELECT COLUMN_NAME FROM TEMPTABLEDB.INFORMATION_SCHEMA.COLUMNS "
        strSql += vbCrLf + "		WHERE TABLE_NAME = 'TEMP_MI_FINAL'"
        strSql += vbCrLf + "		AND DATA_TYPE IN ('INT','NUMERIC','DECIMAL')"
        strSql += vbCrLf + "		OPEN CUR"
        strSql += vbCrLf + "		FETCH NEXT FROM CUR INTO @COLUMN"
        strSql += vbCrLf + "		WHILE @@FETCH_STATUS <> -1"
        strSql += vbCrLf + "		BEGIN"
        strSql += vbCrLf + "			SELECT @QRY = 'UPDATE TEMPTABLEDB..TEMP_MI_FINAL SET ' + @COLUMN + ' = NULL WHERE ' + @COLUMN + ' = 0'"
        strSql += vbCrLf + "			PRINT (@QRY)"
        strSql += vbCrLf + "			EXEC  (@QRY)"
        strSql += vbCrLf + "			FETCH NEXT FROM CUR INTO @COLUMN"
        strSql += vbCrLf + "		END"
        strSql += vbCrLf + "		CLOSE CUR "
        strSql += vbCrLf + "		DEALLOCATE CUR"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	SELECT @QRY = ''"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(10) + 'SELECT KEYNO,PARTICULAR'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(10) + ',O_PCS,O_GRSWT,O_NETWT,O_PUREWT,O_AMOUNT,O_TAX,O_TOTAL'"
