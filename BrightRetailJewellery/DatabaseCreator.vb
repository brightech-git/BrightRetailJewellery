        strSql += vbCrLf + " 	ELSE IF @SUMMARY = 'Y'    "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 		UPDATE TEMPTABLEDB..OUTSTDT SET PAYMODE='DU' WHERE PAYMODE='DR'"
        strSql += vbCrLf + " 		SELECT *"
        strSql += vbCrLf + " 		,(SELECT TOP 1 REMARK1 FROM  OUTSTANDING WHERE RUNNO = X.RUNNO AND COSTID = X.COSTID AND COMPANYID = X.COMPANYID ORDER BY TRANDATE DESC) AS REMARK1"
        strSql += vbCrLf + " 		,(SELECT TOP 1 REMARK2 FROM  OUTSTANDING WHERE RUNNO = X.RUNNO AND COSTID = X.COSTID AND COMPANYID = X.COMPANYID ORDER BY TRANDATE DESC) AS REMARK2"
        strSql += vbCrLf + " 		,CONVERT(VARCHAR,(SELECT TOP 1 TRANDATE FROM  OUTSTANDING WHERE RUNNO = X.RUNNO AND COSTID = X.COSTID AND COMPANYID = X.COMPANYID ORDER BY TRANDATE DESC),103)AS LASTTRANDATE"
        strSql += vbCrLf + " 		,IDENTITY(INT,1,1)KNO  "
        strSql += vbCrLf + " 		INTO TEMPTABLEDB..TEMP_OUTSTANDING    "
        strSql += vbCrLf + " 		FROM     "
        strSql += vbCrLf + " 		(  "
        strSql += vbCrLf + " 		SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR"
        strSql += vbCrLf + " 		,CONVERT(VARCHAR(50),H.ACCODE) ACCODE,CONVERT(VARCHAR(10),NULL) RUNNO"
        strSql += vbCrLf + " 		,CONVERT(VARCHAR(50),O.TRANTYPE)TRANTYPE,NULL TRANNO,NULL TRANDATE    "
        strSql += vbCrLf + " 		,SUM(CASE WHEN RECPAY = 'P' THEN AMOUNT ELSE 0 END) AS DEBIT    "
        strSql += vbCrLf + " 		,SUM(CASE WHEN RECPAY = 'R' THEN AMOUNT ELSE 0 END) AS CREDIT    "
        strSql += vbCrLf + " 		,SUM(CASE WHEN RECPAY = 'P' THEN AMOUNT ELSE -1*AMOUNT END) AS BALANCE    "
        strSql += vbCrLf + " 		,H.ACNAME NAME,H.MOBILE    "
        strSql += vbCrLf + " 		,CONVERT(VARCHAR(40),NULL) SALESPERSON    "
        strSql += vbCrLf + " 		,(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = O.COSTID)AS COSTNAME    "
        strSql += vbCrLf + " 		,CONVERT(INT,1)RESULT,CONVERT(VARCHAR,NULL)COLHEAD,CONVERT(VARCHAR(10),O.PAYMODE)PAYMODE   "
        strSql += vbCrLf + " 		,O.COSTID,O.COMPANYID  "
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..OUTSTDT AS O    "
        strSql += vbCrLf + " 		LEFT JOIN ACHEAD AS H ON H.ACCODE = O.ACCODE"
        strSql += vbCrLf + " 		INNER JOIN TEMPTABLEDB..TEMP_ACHEAD AS TH ON TH.ACCODE = O.ACCODE AND TH.TRANTYPE = O.TRANTYPE"
        strSql += vbCrLf + " 		GROUP BY O.TRANTYPE,H.ACNAME,H.MOBILE,H.ACCODE,O.COSTID,O.COMPANYID,O.PAYMODE"
        strSql += vbCrLf + " 		)X  "
        strSql += vbCrLf + " 	END    "
        strSql += vbCrLf + " 	IF @FILTERBY <> 'NONE' AND @FILTERBY <> ''    "
        strSql += vbCrLf + " 	BEGIN    "
        strSql += vbCrLf + " 		SET @QRY = ' DELETE FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE '+@FILTERBY+' NOT LIKE '''+@FILTERCAPTION+'%'''  "
        strSql += vbCrLf + " 		EXEC(@QRY)"
        strSql += vbCrLf + " 	END    "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET TRANTYPE =     "
        strSql += vbCrLf + " 	CASE WHEN TRANTYPE = 'A' THEN 'ADVANCE'"
        strSql += vbCrLf + " 	WHEN TRANTYPE = 'D' AND ISNULL(PAYMODE,'')='DP' THEN 'CR PURCHASE'"
        strSql += vbCrLf + " 	WHEN TRANTYPE = 'D' AND ISNULL(PAYMODE,'')<>'DP' THEN 'CREDIT'"
        strSql += vbCrLf + " 	WHEN TRANTYPE = 'T' THEN 'OTHER'"
        strSql += vbCrLf + " 	WHEN TRANTYPE = 'O' THEN 'ORDER'"
        strSql += vbCrLf + " 	WHEN TRANTYPE = 'J' THEN 'JND'"
        strSql += vbCrLf + " 	ELSE TRANTYPE END    "
        strSql += vbCrLf + " 	FROM TEMPTABLEDB..TEMP_OUTSTANDING    "
        strSql += vbCrLf + " 	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_OUTSTANDING)>0    "
        strSql += vbCrLf + " 	BEGIN    "
        strSql += vbCrLf + " 		/** Inserting Title **/    "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,RESULT,COLHEAD)    "
        strSql += vbCrLf + " 		SELECT DISTINCT TRANTYPE,0 RESULT,'T' COLHEAD FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT = 1    "
        strSql += vbCrLf + " 		/** Inserting SubTotal **/    "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,RESULT,COLHEAD,DEBIT,CREDIT,BALANCE)    "
        strSql += vbCrLf + " 		SELECT TRANTYPE,2 RESULT,'S' COLHEAD,SUM(DEBIT),SUM(CREDIT),SUM(BALANCE)    "
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT = 1 GROUP BY TRANTYPE     "
        strSql += vbCrLf + " 		/** Inserting SubTotal Difference**/"
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,RESULT,COLHEAD,DEBIT,CREDIT)"
        strSql += vbCrLf + " 		SELECT TRANTYPE + '->DIFF',3 RESULT,'S2' COLHEAD,"
        strSql += vbCrLf + " 		SUM(CASE WHEN ISNULL(DEBIT,0)>ISNULL(CREDIT,0) THEN ISNULL(DEBIT,0)-ISNULL(CREDIT,0) END)DEBIT,"
        strSql += vbCrLf + " 		SUM(CASE WHEN ISNULL(DEBIT,0)<ISNULL(CREDIT,0) THEN ISNULL(CREDIT,0)-ISNULL(DEBIT,0) END)CREDIT"
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT = 2 GROUP BY TRANTYPE   "
        strSql += vbCrLf + " 		/** Inserting Grand Total **/    "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,RESULT,COLHEAD,DEBIT,CREDIT,BALANCE)    "
        strSql += vbCrLf + " 		SELECT 'ZZZZZ',4 RESULT,'G' COLHEAD,SUM(DEBIT),SUM(CREDIT),SUM(BALANCE)    "
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT = 1    "
        strSql += vbCrLf + " 		/** Inserting Grand Total Difference**/    "
        strSql += vbCrLf + " 		INSERT INTO TEMPTABLEDB..TEMP_OUTSTANDING(TRANTYPE,RESULT,COLHEAD,DEBIT,CREDIT)"
        strSql += vbCrLf + " 		SELECT 'ZZZZZZ',5 RESULT,'G1' COLHEAD,"
        strSql += vbCrLf + " 		SUM(CASE WHEN ISNULL(DEBIT,0)>ISNULL(CREDIT,0) THEN ISNULL(DEBIT,0)-ISNULL(CREDIT,0) END)DEBIT,  "
        strSql += vbCrLf + " 		SUM(CASE WHEN ISNULL(DEBIT,0)<ISNULL(CREDIT,0) THEN ISNULL(CREDIT,0)-ISNULL(DEBIT,0) END)CREDIT"
        strSql += vbCrLf + " 		FROM TEMPTABLEDB..TEMP_OUTSTANDING WHERE RESULT = 4   "
        strSql += vbCrLf + " 	END    "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET PARTICULAR = CASE WHEN RESULT = 0 THEN TRANTYPE WHEN RESULT = 1 THEN ' ' + NAME WHEN RESULT = 2 THEN 'SUB TOTAL' WHEN RESULT = 3 THEN 'DIFF' WHEN RESULT=5 THEN 'GRAND DIFF' ELSE 'GRAND TOTAL' END    "
        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..TEMP_OUTSTANDING SET DEBIT = CASE WHEN ISNULL(DEBIT,0) <> 0 THEN DEBIT ELSE NULL END    "
        strSql += vbCrLf + " 	,CREDIT = CASE WHEN ISNULL(cREDIT,0) <> 0 THEN CREDIT ELSE NULL END    "
        strSql += vbCrLf + " 	,BALANCE = CASE WHEN ISNULL(BALANCE,0) <> 0 THEN BALANCE ELSE NULL END    "
        strSql += vbCrLf + " 	IF @ORDERBY = 'N'    "
        strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMP_OUTSTANDING ORDER BY TRANTYPE,RESULT,NAME    "
        strSql += vbCrLf + " 	ELSE IF @ORDERBY = 'B'    "
        strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMP_OUTSTANDING ORDER BY TRANTYPE,RESULT,TRANDATE    "
        strSql += vbCrLf + " 	ELSE    "
        strSql += vbCrLf + " 	SELECT * FROM TEMPTABLEDB..TEMP_OUTSTANDING ORDER BY TRANTYPE,RESULT,NAME    "
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub RPT_CARDTRAN()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='RPT_CARDTRAN')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE RPT_CARDTRAN"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "  CREATE PROCEDURE RPT_CARDTRAN"
        strSql += vbCrLf + "      (    "
        strSql += vbCrLf + "        @DBNAME VARCHAR(15)"
        strSql += vbCrLf + "       ,@FROMDATE VARCHAR(15)"
        strSql += vbCrLf + "       ,@TODATE VARCHAR(15)"
        strSql += vbCrLf + "       ,@COMMISSION VARCHAR(30)"
        strSql += vbCrLf + "       ,@SERVICETAX VARCHAR(30)"
        strSql += vbCrLf + "       ,@CARDNAME VARCHAR(40)"
        strSql += vbCrLf + "       )"
        strSql += vbCrLf + "       AS"
        strSql += vbCrLf + "       BEGIN"
        strSql += vbCrLf + "   		DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "   		SELECT @CARDNAME=REPLACE(@CARDNAME,',',''',''')		"
        strSql += vbCrLf + "   		IF OBJECT_ID('TEMPTABLEDB..TESTCARDTRAN','U')IS NOT NULL DROP TABLE TEMPTABLEDB..TESTCARDTRAN"
        strSql += vbCrLf + "   		SELECT @QRY= CHAR(13) + 'SELECT *,1 AS RESULT INTO TEMPTABLEDB..TESTCARDTRAN '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ 'FROM ('"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+ 'SELECT   TRANDATE,'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'(SELECT PNAME  FROM PERSONALINFO  '"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+ 'WHERE SNO IN(SELECT PSNO FROM CUSTOMERINFO '"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+ 'WHERE BATCHNO= A.BATCHNO)) AS PNAME ,'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+'(SELECT MOBILE FROM PERSONALINFO ' "
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' WHERE SNO IN(SELECT PSNO FROM CUSTOMERINFO  WHERE BATCHNO=A.BATCHNO))MOBILE,PAYMODE, '"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+  '(SELECT NAME FROM CREDITCARD WHERE ACCODE=A.ACCODE '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ ' AND CARDTYPE=''R'' AND CARDCODE=A.CARDID '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ ')AS CARDNAME,'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+ 'TRANNO , AMOUNT'"
        strSql += vbCrLf + "  		IF @COMMISSION='0'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),(AMOUNT*ISNULL((SELECT TOP 1 COMMISSION FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100) AS COMMISSION'"
        strSql += vbCrLf + "   			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),((AMOUNT*ISNULL((SELECT TOP 1 COMMISSION FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100 *ISNULL((SELECT TOP 1 TAX FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100)AS SERVICETAX'"
        strSql += vbCrLf + "   			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),(AMOUNT-((AMOUNT*ISNULL((SELECT TOP 1 COMMISSION FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100)-((AMOUNT*ISNULL((SELECT TOP 1 COMMISSION FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100 *ISNULL((SELECT TOP 1 TAX FROM CREDITCARDSLAB WHERE CARDCODE=A.CARDID AND A.AMOUNT BETWEEN FROMAMOUNT AND TOAMOUNT),0))/100)) AS NETAMOUNT,'''' AS TOTALNETAMOUNT  '	    "
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),(AMOUNT*'+@COMMISSION+')/100) AS COMMISSION'"
        strSql += vbCrLf + "   			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),((AMOUNT*'+@COMMISSION+')/100 *'+@SERVICETAX+')/100)AS SERVICETAX'"
        strSql += vbCrLf + "   			SELECT @QRY= @QRY+CHAR(13)+ ',CONVERT(NUMERIC(15,2),(AMOUNT-((AMOUNT*'+@COMMISSION+')/100)-((AMOUNT*'+@COMMISSION+')/100 *'+@SERVICETAX+')/100)) AS NETAMOUNT,'''' AS TOTALNETAMOUNT  '	    "
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+'  FROM '+@DBNAME+'..ACCTRAN A  WHERE TRANDATE BETWEEN '''+@FROMDATE+'''   '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND '''+@TODATE+'''AND PAYMODE=''CC'' ' "
        strSql += vbCrLf + "   		IF @CARDNAME<>'ALL'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+ ' AND ACCODE in (SELECT ACCODE FROM CREDITCARD WHERE NAME IN ('''+@CARDNAME+'''))'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ '  )X'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ 'ORDER BY TRANDATE '"
        strSql += vbCrLf + "   		PRINT(@QRY)"
        strSql += vbCrLf + "   		EXEC(@QRY)"
        strSql += vbCrLf + "   		IF OBJECT_ID('TEMPTABLEDB..TESTCARDTRAN1','U')IS NOT NULL DROP TABLE TEMPTABLEDB..TESTCARDTRAN1"
        strSql += vbCrLf + "   		SELECT @QRY= CHAR(13) + 'SELECT * INTO TEMPTABLEDB..TESTCARDTRAN1 '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+ 'FROM ('"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'SELECT CONVERT(VARCHAR(15),TRANDATE,105)AS TRANDATE,PNAME,MOBILE,PAYMODE,CARDNAME,TRANNO,AMOUNT,COMMISSION,SERVICETAX,NETAMOUNT,1 AS RESULT FROM  TEMPTABLEDB..TESTCARDTRAN '"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'UNION ALL'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'SELECT CONVERT(VARCHAR(15),TRANDATE,105)AS TRANDATE ,''''AS PNAME,''''AS MOBILE,''''AS PAYMODE,''''AS CARDNAME,NULL AS TRANNO,NULL AS AMOUNT,NULL AS COMMISSION ,NULL  AS SERVICETAX,SUM(ISNULL(CAST(NETAMOUNT AS FLOAT),0) )AS NETAMOUNT,2 AS RESULT'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'FROM  TEMPTABLEDB..TESTCARDTRAN   GROUP BY TRANDATE '"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'UNION ALL'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+'SELECT ''TOTAL''AS TRANDATE,''''AS PNAME ,''''AS MOBILE,'''' AS PAYMODE,''''AS CARDNAME,NULL AS TRANNO ,SUM(ISNULL(CAST(AMOUNT AS FLOAT),0))AS AMOUNT,SUM(ISNULL(CAST(COMMISSION AS FLOAT),0))AS AMOUNT,'"
        strSql += vbCrLf + "   		SELECT @QRY= @QRY+CHAR(13)+' SUM(ISNULL(CAST(SERVICETAX AS FLOAT),0))AS SERVICETAX ,SUM(ISNULL(CAST(NETAMOUNT AS FLOAT),0)) AS NETAMOUNT, 3 AS RESULT  FROM TEMPTABLEDB..TESTCARDTRAN  )Y ORDER BY TRANDATE ,result '"
        strSql += vbCrLf + "   		PRINT (@QRY)"
        strSql += vbCrLf + "   		EXEC(@QRY)"
        strSql += vbCrLf + "   		SELECT @QRY= CHAR(13) + 'SELECT * FROM TEMPTABLEDB..TESTCARDTRAN1 '"
        strSql += vbCrLf + "   		EXEC(@QRY)"
        strSql += vbCrLf + "       END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

    End Sub

    Private Sub SP_RPT_COUNTERWISESTOCK()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_COUNTERWISESTOCK')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_COUNTERWISESTOCK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = Environment.NewLine + " CREATE PROCEDURE SP_RPT_COUNTERWISESTOCK"
        strSql += Environment.NewLine + "   (    "
        strSql += Environment.NewLine + "   @DBNAME VARCHAR(30)    "
        strSql += Environment.NewLine + "   ,@ASONDATE  VARCHAR(15)    "
        strSql += Environment.NewLine + "   ,@METAL VARCHAR(100)    "
        strSql += Environment.NewLine + "   ,@CATCODE VARCHAR(100)    "
        strSql += Environment.NewLine + "   ,@ITEMIDS VARCHAR(100)    "
        strSql += Environment.NewLine + "   ,@DESIGNERID VARCHAR(100)    "
        strSql += Environment.NewLine + "   ,@SUMMARY VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@STOCKTYPE VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@WITHSUBITEM VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@COSTIDS VARCHAR(2000)    "
        strSql += Environment.NewLine + "   ,@ITEMTYPEIDS VARCHAR(5000)    "
        strSql += Environment.NewLine + "   ,@COUNTERID VARCHAR(5000)    "
        strSql += Environment.NewLine + "   ,@COMPANYID VARCHAR(5000)    "
        strSql += Environment.NewLine + "   ,@ORDER VARCHAR(1) /** IF ORDER THEN 'O' ELSE '' END **/    "
        strSql += Environment.NewLine + "   ,@APPROVAL VARCHAR(10) /** IF APPROVAL THEN 'A' ELSE '' END **/    "
        strSql += Environment.NewLine + "   ,@TRANSFER_DETAIL VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@TRANSACTIONONLY VARCHAR(3)    "
        strSql += Environment.NewLine + "   ,@ORDERBYID VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@SYSTEMID VARCHAR(20)    "
        strSql += Environment.NewLine + "   ,@SEPMISC VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@SEPAPP VARCHAR(1)    "
        strSql += Environment.NewLine + "   ,@DIASTNBYROW VARCHAR(3)    "
        strSql += Environment.NewLine + "   ,@GROUPBY VARCHAR(20)    "
        strSql += Environment.NewLine + "   ,@SEPPARTSALE VARCHAR(1)   "
        strSql += Environment.NewLine + "   ,@SUBITEMGROUP VARCHAR(1000)  "
        strSql += Environment.NewLine + "   )    "
        strSql += Environment.NewLine + "   AS    "
        strSql += Environment.NewLine + "   SET NOCOUNT ON    "
        strSql += Environment.NewLine + "   DECLARE @QRY NVARCHAR(MAX)    "
        strSql += Environment.NewLine + "   /** GETTING WHEATHER BACK OFFICE ENTRY SHOULD AFFECT D REPORT OR NOT **/    "
        strSql += Environment.NewLine + "   SELECT @QRY=' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMPFLAG'') DROP TABLE TEMPTABLEDB.dbo.TEMPFLAG'    "
        strSql += Environment.NewLine + "   SELECT @QRY=@QRY+CHAR(13) +' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''APPROVAL'') DROP TABLE TEMPTABLEDB.dbo.APPROVAL'    "
        strSql += Environment.NewLine + "   SELECT @QRY=@QRY+CHAR(13) +' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMNONTAG'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'ITEMNONTAG'    "
        strSql += Environment.NewLine + "   SELECT @QRY=@QRY+CHAR(13) +' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'ITEMSTOCK1'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'ITEMSTOCK1'    "
        strSql += Environment.NewLine + "   SELECT @QRY=@QRY+CHAR(13) +' IF EXISTS(SELECT * FROM TEMPTABLEDB.dbo.SYSOBJECTS WHERE XTYPE=''U'' AND NAME=''TEMP'+@SYSTEMID+'STOCKREPORT'') DROP TABLE TEMPTABLEDB.dbo.TEMP'+@SYSTEMID+'STOCKREPORT'    "
        strSql += Environment.NewLine + "   PRINT @QRY    "
        strSql += Environment.NewLine + "   EXEC(@QRY)    "
        strSql += Environment.NewLine + "   SELECT @QRY=' CREATE TABLE TEMPTABLEDB.dbo.TEMPFLAG (FLAG VARCHAR(1))  '    "
        strSql += Environment.NewLine + "   PRINT @QRY    "
        strSql += Environment.NewLine + "   EXEC(@QRY)    "
        strSql += Environment.NewLine + "   SELECT @QRY=' INSERT INTO TEMPTABLEDB.dbo.TEMPFLAG(FLAG) '    "
        strSql += Environment.NewLine + "   SELECT @QRY= @QRY+' SELECT ''C'' UNION ALL  SELECT '''' UNION ALL  SELECT NULL'    "
        strSql += Environment.NewLine + "   PRINT @QRY      "
        strSql += Environment.NewLine + "   EXEC(@QRY)     "
        strSql += Environment.NewLine + "   DECLARE @HIDEBACKOFFICE VARCHAR(1)    "
        strSql += Environment.NewLine + "   SELECT @HIDEBACKOFFICE = CTLTEXT  FROM " & cnAdminDb & ".dbo.SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE'    "
        strSql += Environment.NewLine + "   IF ISNULL(@HIDEBACKOFFICE,'N') = 'N' INSERT INTO TEMPTABLEDB.dbo.TEMPFLAG(FLAG)SELECT 'B'    "
        strSql += Environment.NewLine + "   DECLARE @ITEMFILTER VARCHAR(4000)    "
        strSql += Environment.NewLine + "   DECLARE @COUNTERFILTER VARCHAR(4000)    "
        strSql += Environment.NewLine + "   DECLARE @COSTFILTER VARCHAR(4000)    "
        strSql += Environment.NewLine + "   DECLARE @SUBITEMFILTER VARCHAR(4000) "
        strSql += Environment.NewLine + "   IF @CATCODE <> 'ALL'  SET @CATCODE = REPLACE(@CATCODE,',',''',''')    "
        strSql += Environment.NewLine + "   SET @ITEMFILTER=' ' /** ITEM FILTER**/     "
        strSql += Environment.NewLine + "   SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE ISNULL(ACTIVE,'''') = ''Y'' AND ISNULL(STOCKREPORT,'''') = ''Y'')'    "
        strSql += Environment.NewLine + "   IF @METAL <> 'ALL' SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE METALID IN('''+@METAL+'''))'    "
        strSql += Environment.NewLine + "   IF @ITEMIDS <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND T.ITEMID IN('+@ITEMIDS+')'     "
        strSql += Environment.NewLine + "   IF @DESIGNERID <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER + ' AND ISNULL(T.DESIGNERID,0) IN('''+ @DESIGNERID +''')'    "
        strSql += Environment.NewLine + "   IF @CATCODE <> 'ALL'  SET @ITEMFILTER= @ITEMFILTER +' AND T.ITEMID IN( SELECT ITEMID FROM  dbo.ITEMMAST WHERE CATCODE IN('''+@CATCODE+'''))'    "
        strSql += Environment.NewLine + "   IF @ITEMTYPEIDS <> 'ALL'  SET @ITEMFILTER = @ITEMFILTER + ' AND ISNULL(T.ITEMTYPEID,0) IN('+ @ITEMTYPEIDS +',0)'    "
