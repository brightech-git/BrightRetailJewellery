        strSql += vbCrLf + "   PRINT (@QRY)"
        strSql += vbCrLf + "   EXEC (@QRY) "
        strSql += vbCrLf + "   SELECT @QRY = '  CREATE TABLE TEMPTABLEDB..TEMPCSTKVALUE2'+ @SYSTEMID+' (DTYPE VARCHAR(1),TRANNO INT,TRANDATE SMALLDATETIME,'"
