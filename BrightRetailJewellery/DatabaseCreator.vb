        strSql += vbCrLf + "   EXEC(@QRY)  "
        strSql += vbCrLf + "   /** GETTING TRANSACTION **/       "
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TRAILBAL_A') IS NOT NULL DROP TABLE TEMPTABLEDB..TRAILBAL_A       "
        strSql += vbCrLf + "   SELECT @QRY='SELECT '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' X.SEP,X.ACCODE,X.AMOUNT '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' ,H.ACNAME,CONVERT(VARCHAR(100),G.ACGRPNAME)ACGRPNAME,CONVERT(VARCHAR(20),G.ACMAINSUB) MAINGRPNAME,G.DISPORDER,CONVERT(VARCHAR(100),CASE WHEN G.SCHEDULECODE = ''0'' THEN '''' ELSE ISNULL(G.SCHEDULECODE,'''') END) AS SCHEDULECODE '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' ,CONVERT(VARCHAR(100),G.ACGRPNAME) TEMPACGRPNAME,X.COSTID    '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' INTO TEMPTABLEDB..TRAILBAL_A            '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' FROM          '    "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' (            '  "
        strSql += vbCrLf + "   SELECT @QRY= @QRY+' SELECT T.TRANMODE AS SEP,T.ACCODE,T.AMOUNT,T.COSTID            '  "
