        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''D'' THEN I.TAGGRSWT- I.GRSWT  END) PS_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 AS PU_GOLD_PCS,0 AS PU_GOLD_GRSWT,0 AS PU_SILVER_PCS,0 AS PU_SILVER_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 AS PU_PLATINUM_PCS,0 AS PU_PLATINUM_GRSWT,0 AS PU_DIAMOND_PCS,0 AS PU_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 AS SR_GOLD_PCS,0 AS SR_GOLD_GRSWT,0 AS SR_SILVER_PCS,0 AS SR_SILVER_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 AS SR_PLATINUM_PCS,0 AS SR_PLATINUM_GRSWT,0 AS SR_DIAMOND_PCS,0 AS SR_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' FROM '+@TRANDB+'..ISSUE I WHERE I.TRANTYPE IN(''SA'',''OD'') AND I.TRANDATE BETWEEN '''+@FROMDATE+'''  AND '''+@TODATE +''' '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' AND ISNULL(I.TAGNO,'''') <> '''' AND ISNULL(I.CANCEL,'''')= '''' AND I.COSTID <> ''CO''  GROUP BY I.COSTID'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' UNION ALL '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' SELECT(SELECT COSTNAME FROM COSTCENTRE WHERE COSTID = I.COSTID)COSTNAME '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 PS_GOLD_PCS,0 PS_GOLD_GRSWT,0 PS_SILVER_PCS,0 PS_SILVER_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,0 PS_PLATINUM_PCS,0 PS_PLATINUM_GRSWT,0 PS_DIAMOND_PCS,0 PS_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''G'' AND I.TRANTYPE = ''PU'' THEN I.PCS END) AS PU_GOLD_PCS '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''G'' AND I.TRANTYPE = ''PU'' THEN I.GRSWT END) AS PU_GOLD_GRSWT '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''S'' AND I.TRANTYPE = ''PU'' THEN I.PCS END) AS PU_SILVER_PCS' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''S'' AND I.TRANTYPE = ''PU'' THEN I.GRSWT END) AS PU_SILVER_GRSWT' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''P'' AND I.TRANTYPE = ''PU'' THEN I.PCS END) AS PU_PLATINUM_PCS' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''P'' AND I.TRANTYPE = ''PU'' THEN I.GRSWT END) AS PU_PLATINUM_GRSWT' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''D'' AND I.TRANTYPE = ''PU'' THEN I.PCS END) AS PU_DIAMOND_PCS' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''D'' AND I.TRANTYPE = ''PU'' THEN I.GRSWT END) AS PU_DIAMOND_GRSWT' "
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''G'' AND I.TRANTYPE = ''SR'' THEN I.PCS END) AS SR_GOLD_PCS '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''G'' AND I.TRANTYPE = ''SR'' THEN I.GRSWT END) AS SR_GOLD_GRSWT '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''S'' AND I.TRANTYPE = ''SR'' THEN I.PCS END) AS SR_SILVER_PCS'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''S'' AND I.TRANTYPE = ''SR'' THEN I.GRSWT END) AS SR_SILVER_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''P'' AND I.TRANTYPE = ''SR'' THEN I.PCS END) AS SR_PLATINUM_PCS'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''P'' AND I.TRANTYPE = ''SR'' THEN I.GRSWT END) AS SR_PLATINUM_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''D'' AND I.TRANTYPE = ''SR'' THEN I.PCS END) AS SR_DIAMOND_PCS'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SUM(CASE WHEN I.METALID = ''D'' AND I.TRANTYPE = ''SR'' THEN I.GRSWT END) AS SR_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' FROM '+@TRANDB+'..RECEIPT I WHERE I.TRANTYPE IN(''PU'',''SR'') AND I.TRANDATE BETWEEN '''+@FROMDATE+'''  AND '''+@TODATE +''' '"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' AND ISNULL(I.CANCEL,'''')= '''' AND I.COSTID <> ''CO''  GROUP BY I.COSTID )  AS Z GROUP BY Z.COSTNAME '"
        strSql += vbCrLf + " PRINT @STRSQL"
        strSql += vbCrLf + " EXEC (@STRSQL)"
        strSql += vbCrLf + " SELECT @STRSQL= 'SELECT COSTNAME'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,PS_GOLD_PCS,PS_GOLD_GRSWT,PS_SILVER_PCS,PS_SILVER_GRSWT,PS_PLATINUM_PCS,PS_PLATINUM_GRSWT,PS_DIAMOND_PCS,PS_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,PU_GOLD_PCS,PU_GOLD_GRSWT,PU_SILVER_PCS,PU_SILVER_GRSWT,PU_PLATINUM_PCS,PU_PLATINUM_GRSWT,PU_DIAMOND_PCS,PU_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' ,SR_GOLD_PCS,SR_GOLD_GRSWT,SR_SILVER_PCS,SR_SILVER_GRSWT,SR_PLATINUM_PCS,SR_PLATINUM_GRSWT,SR_DIAMOND_PCS,SR_DIAMOND_GRSWT'"
        strSql += vbCrLf + " SELECT @STRSQL= @STRSQL+CHAR(13)+ ' FROM TEMPTABLEDB..TEMP_PENDREP '"
        strSql += vbCrLf + " EXEC (@STRSQL)"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + ""
        strSql += vbCrLf + " --EXEC SP_RPT_BRANCHPENDINGSTK @TRANDB = 'CORT1920', @FROMDATE = '2019-04-01',@TODATE = '2019-04-10'"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_SALESABSTRACT_SALESWISEDETAIL()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SALESABSTRACT_SALESWISEDETAIL')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SALESABSTRACT_SALESWISEDETAIL"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_SALESABSTRACT_SALESWISEDETAIL"
        strSql += vbCrLf + "           (    "
        strSql += vbCrLf + "           @DBNAME VARCHAR(30)      "
        strSql += vbCrLf + "           ,@FRMDATE VARCHAR(12)      "
        strSql += vbCrLf + "           ,@TODATE VARCHAR(12)      "
        strSql += vbCrLf + "           ,@COSTID VARCHAR(200)      "
        strSql += vbCrLf + "           ,@COMPANYID VARCHAR(200)"
        strSql += vbCrLf + "           ,@CASHNAME VARCHAR(800)"
        strSql += vbCrLf + "           ,@EMPNAME VARCHAR(800)"
        strSql += vbCrLf + "           ,@UID VARCHAR(4)   "
        strSql += vbCrLf + "           ,@SUMDET VARCHAR(4)   "
        strSql += vbCrLf + "           )      "
        strSql += vbCrLf + "           AS      "
        strSql += vbCrLf + "           BEGIN /** PROC STARTS **/   "
        strSql += vbCrLf + "    			DECLARE @QRY VARCHAR(8000)    "
        strSql += vbCrLf + "    			DECLARE @TEMPISSUE VARCHAR(50)    "
        strSql += vbCrLf + "    			DECLARE @TEMPACCTRANN VARCHAR(50)    "
        strSql += vbCrLf + "    			DECLARE @TEMPADDRESS VARCHAR(50)    "
        strSql += vbCrLf + "    			DECLARE @TEMPSALEABSTRACT VARCHAR(50)    "
        strSql += vbCrLf + "    			DECLARE @TEMPSALEABSTRACT_RES VARCHAR(50)    			"
        strSql += vbCrLf + "    			DECLARE @TEMPCASH VARCHAR(50)    "
        strSql += vbCrLf + "    			DECLARE @TEMPEMP VARCHAR(50)    "
        strSql += vbCrLf + "    			SELECT @TEMPCASH='TEMPTABLEDB.DBO.TEMPCASH'    "
        strSql += vbCrLf + "    			SELECT @TEMPEMP='TEMPTABLEDB.DBO.TEMPEMP'    "
        strSql += vbCrLf + "    			SELECT @TEMPISSUE='TEMPTABLEDB.DBO.TEMP'+@UID+'ISSUE'    "
        strSql += vbCrLf + "    			SELECT @TEMPACCTRANN='TEMPTABLEDB.DBO.TEMP'+@UID+'ACCTRANN'    "
        strSql += vbCrLf + "    			SELECT @TEMPADDRESS='TEMPTABLEDB.DBO.TEMP'+@UID+'ADDRESS'    "
        strSql += vbCrLf + "    			SELECT @TEMPSALEABSTRACT='TEMPTABLEDB.DBO.TEMP'+@UID+'SALEABSTRACT'    "
        strSql += vbCrLf + "    			SELECT @TEMPSALEABSTRACT_RES='TEMPTABLEDB.DBO.TEMP'+@UID+'SALEABSTRACT_RES'    "
        strSql += vbCrLf + "    			IF OBJECT_ID('TEMPTABLEDB.DBO.TEMPCASH', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB.DBO.TEMPCASH "
        strSql += vbCrLf + "    			CREATE TABLE TEMPTABLEDB.DBO.TEMPCASH (CASHID VARCHAR(5)) "
        strSql += vbCrLf + "    			IF (SELECT COUNT(*) WHERE @CASHNAME LIKE '%ALL%')>0      "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPCASH (CASHID) SELECT ISNULL(CASHID,0) FROM " & cnAdminDb & "..CASHCOUNTER UNION ALL SELECT ''      "
        strSql += vbCrLf + "    			ELSE      "
        strSql += vbCrLf + "    			BEGIN      "
        strSql += vbCrLf + "    			DECLARE @TCASHNAME VARCHAR(20) "
        strSql += vbCrLf + "    			IF CHARINDEX(',',@CASHNAME)=0 "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPCASH (CASHID) SELECT ISNULL(CASHID,0) FROM " & cnAdminDb & "..CASHCOUNTER WHERE CASHNAME = @CASHNAME "
        strSql += vbCrLf + "    			WHILE CHARINDEX(',',@CASHNAME)>0 "
        strSql += vbCrLf + "    			BEGIN "
        strSql += vbCrLf + "    			SET @TCASHNAME=LEFT(@CASHNAME,CHARINDEX(',',@CASHNAME)-1) "
        strSql += vbCrLf + "    			SET @CASHNAME=RIGHT(@CASHNAME,LEN(@CASHNAME)-CHARINDEX(',',@CASHNAME)) "
        strSql += vbCrLf + "    			IF @CASHNAME <>'' AND CHARINDEX(',',@CASHNAME)=0 "
        strSql += vbCrLf + "    			SET @CASHNAME= @CASHNAME + ',' "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPCASH (CASHID) SELECT ISNULL(CASHID,0) FROM " & cnAdminDb & "..CASHCOUNTER WHERE CASHNAME = @TCASHNAME "
        strSql += vbCrLf + "    			END  "
        strSql += vbCrLf + "    			END "
        strSql += vbCrLf + "    			IF OBJECT_ID('TEMPTABLEDB.DBO.TEMPEMP', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB.DBO.TEMPEMP "
        strSql += vbCrLf + "    			CREATE TABLE TEMPTABLEDB.DBO.TEMPEMP (EMPID VARCHAR(5)) "
        strSql += vbCrLf + "    			IF (SELECT COUNT(*) WHERE @EMPNAME LIKE '%ALL%')>0      "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPEMP (EMPID) SELECT ISNULL(EMPID,0) FROM " & cnAdminDb & "..EMPMASTER UNION ALL SELECT ''      "
        strSql += vbCrLf + "    			ELSE      "
        strSql += vbCrLf + "    			BEGIN      "
        strSql += vbCrLf + "    			DECLARE @TEMPNAME VARCHAR(20) "
        strSql += vbCrLf + "    			IF CHARINDEX(',',@EMPNAME)=0 "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPEMP (EMPID) SELECT ISNULL(EMPID,0) FROM " & cnAdminDb & "..EMPMASTER WHERE EMPNAME = @EMPNAME "
        strSql += vbCrLf + "    			WHILE CHARINDEX(',',@EMPNAME)>0 "
        strSql += vbCrLf + "    			BEGIN "
        strSql += vbCrLf + "    			SET @TEMPNAME=LEFT(@EMPNAME,CHARINDEX(',',@EMPNAME)-1) "
        strSql += vbCrLf + "    			SET @EMPNAME=RIGHT(@EMPNAME,LEN(@EMPNAME)-CHARINDEX(',',@EMPNAME)) "
        strSql += vbCrLf + "    			IF @EMPNAME <>'' AND CHARINDEX(',',@EMPNAME)=0 "
        strSql += vbCrLf + "    			SET @EMPNAME= @EMPNAME + ',' "
        strSql += vbCrLf + "    			INSERT INTO TEMPTABLEDB.DBO.TEMPEMP (EMPID) SELECT ISNULL(EMPID,0) FROM " & cnAdminDb & "..EMPMASTER WHERE EMPNAME = @TEMPNAME "
        strSql += vbCrLf + "    			END  "
        strSql += vbCrLf + "    			END "
        strSql += vbCrLf + "    			SET NOCOUNT ON    "
        strSql += vbCrLf + "    			IF @COSTID<>'ALL'SET @COSTID= REPLACE(@COSTID,',',''',''')    "
        strSql += vbCrLf + "    			IF @COMPANYID<>'ALL'SET @COMPANYID= REPLACE(@COMPANYID,',',''',''')    "
        strSql += vbCrLf + "    			SELECT @QRY='IF OBJECT_ID('''+@TEMPISSUE+''') IS NOT NULL DROP TABLE '+ @TEMPISSUE +''     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' IF OBJECT_ID('''+@TEMPISSUE+''') IS NOT NULL DROP TABLE '+ @TEMPISSUE +''     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' IF OBJECT_ID('''+@TEMPACCTRANN+''') IS NOT NULL DROP TABLE '+ @TEMPACCTRANN +''     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' IF OBJECT_ID('''+@TEMPADDRESS+''') IS NOT NULL DROP TABLE '+ @TEMPADDRESS +''     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' IF OBJECT_ID('''+@TEMPSALEABSTRACT+''') IS NOT NULL DROP TABLE '+ @TEMPSALEABSTRACT +''     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' IF OBJECT_ID('''+@TEMPSALEABSTRACT_RES+''') IS NOT NULL DROP TABLE '+ @TEMPSALEABSTRACT_RES +''     "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)    "
        strSql += vbCrLf + "    			/** GET FROM ISSUE TABLE **/    "
        strSql += vbCrLf + "    			SELECT @QRY=' SELECT * INTO '+@TEMPISSUE+' FROM('    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' SELECT I.CATCODE,I.TRANNO IBILLNO,I.TRANDATE IBILLDATE,CONVERT(VARCHAR(13),NULL)DISPDATE,CONVERT(VARCHAR(75),NULL)CUSTOMER'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,I.ITEMID IITEMID,CONVERT(VARCHAR(100),NULL)ITEMNAME,I.GRSWT IWEIGHT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,(SELECT SUM(ISNULL(STNWT,0)) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM '+@DBNAME+'..ITEMMAST WHERE DIASTONE=''S'')) ISTNWT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,(SELECT SUM(ISNULL(STNWT,0)) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM '+@DBNAME+'..ITEMMAST WHERE DIASTONE=''D'')) IDIAWT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,I.RATE IRATE,I.MCHARGE IMCHARGE'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,I.WASTAGE IWASTVAL,(I.WASTAGE*I.RATE) IWASTAGE,I.TAX ITAX,SUM(ISNULL(I.AMOUNT,0)+ISNULL(I.TAX,0))ITOTAL,CONVERT(VARCHAR(15),ISNULL(I.TAGNO,'''')) ITAGNO'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,0 CASH,0 CRCARD,0 CHEQUE,0 CHIT,0 ADVANCE,0 GV,0 HC,0 DISCOUNT, 0 CRBALANCE,0 ACTOTAL,I.CASHID,I.BATCHNO,ISNULL(I.CANCEL,'''')CANCEL,''I'' COLHEAD'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' FROM ISSUE AS I '    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+ @FRMDATE +''' AND ''' + @TODATE + ''' AND I.TRANTYPE IN(''SA'',''OD'')  '    "
        strSql += vbCrLf + "    			IF @COSTID<>'ALL' SELECT  @QRY=@QRY+' AND I.COSTID IN('''+ @COSTID +''')'    "
        strSql += vbCrLf + "    			IF @COMPANYID<>'ALL' SELECT  @QRY=@QRY+' AND I.COMPANYID IN('''+ @COMPANYID +''')'    "
        strSql += vbCrLf + "    			IF @CASHNAME <>'ALL' SELECT  @QRY=@QRY+' AND ISNULL(I.CASHID,0) IN (SELECT CASHID FROM TEMPTABLEDB.DBO.TEMPCASH) '"
        strSql += vbCrLf + "    			IF @EMPNAME <>'ALL' SELECT  @QRY=@QRY+' AND ISNULL(I.EMPID,0) IN (SELECT EMPID FROM TEMPTABLEDB.DBO.TEMPEMP) '"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' GROUP BY I.CATCODE,I.TRANNO,I.TRANDATE,I.ITEMID,'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' I.GRSWT,I.RATE,I.MCHARGE,I.WASTAGE,I.TAX,I.CASHID,I.BATCHNO,I.RATE,I.SNO,I.TAGNO,I.CANCEL'     			"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' )X'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY) "
        strSql += vbCrLf + "    			/** GET FROM ACCTRAN TABLE **/    "
        strSql += vbCrLf + "    			SELECT @QRY=' SELECT IBILLNO,IBILLDATE,BATCHNO,SUM(CASH)CASH,SUM(CRCARD)CRCARD,SUM(CHEQUE)CHEQUE,SUM(CHIT)CHIT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,SUM(ADVANCE)ADVANCE,SUM(GV)GV,SUM(HC)HC,SUM(DISCOUNT)DISCOUNT,SUM(CRBALANCE)CRBALANCE ,SUM(ACTOTAL)ACTOTAL,0 SRBALANCE INTO '+@TEMPACCTRANN+' FROM ('    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' SELECT A.TRANNO IBILLNO,A.TRANDATE IBILLDATE,A.BATCHNO'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''CA'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END CASH'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''CC'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END CRCARD'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''CH'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END CHEQUE'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''CZ'',''CG'',''CD'',''CB'',''SS'')THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END CHIT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''AR'',''AA'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END ADVANCE'  "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''GV'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END GV'       			"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''HC'') THEN SUM(CASE WHEN TRANMODE IN(''C'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END HC'       			"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''DI'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END DISCOUNT'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''DU'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END CRBALANCE'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CASE WHEN A.PAYMODE IN(''CA'',''CC'',''CH'',''AA'',''AR'',''GV'',''DU'',''CZ'',''CG'',''CD'',''CB'',''SS'') THEN SUM(CASE WHEN TRANMODE IN(''D'') THEN ISNULL(A.AMOUNT,0)ELSE ISNULL(A.AMOUNT,0)*-1 END) ELSE 0 END ACTOTAL'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' FROM ACCTRAN A  WHERE A.BATCHNO IN (SELECT DISTINCT BATCHNO FROM '+@TEMPISSUE+')AND ISNULL(A.CANCEL,'''')='''' '    "
        strSql += vbCrLf + "    			IF @COSTID<>'ALL' SELECT  @QRY=@QRY+' AND A.COSTID IN('''+ @COSTID +''')'    "
        strSql += vbCrLf + "    			IF @COMPANYID<>'ALL' SELECT  @QRY=@QRY+' AND A.COMPANYID IN('''+ @COMPANYID +''')'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' GROUP BY A.TRANNO,A.TRANDATE,A.BATCHNO,A.PAYMODE,A.TRANMODE'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' )Y GROUP BY IBILLNO,IBILLDATE,BATCHNO HAVING SUM(ISNULL(ACTOTAL,0))<>0'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)    "
        strSql += vbCrLf + "    			SELECT @QRY=' ALTER TABLE '+@TEMPISSUE+' ADD  CATNAME VARCHAR(100),SRITEMNAME VARCHAR(100)'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)"
        strSql += vbCrLf + "    			SELECT @QRY=' UPDATE T SET ITEMNAME=(SELECT ''(''+ CONVERT(VARCHAR(10),ITEMID) +'') '' + ITEMNAME  FROM '+ @DBNAME +'..ITEMMAST WHERE ITEMID=T.IITEMID) FROM '+@TEMPISSUE+' T'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)    "
        strSql += vbCrLf + "    			SELECT @QRY=' UPDATE T SET CATNAME=(SELECT CATNAME  FROM '+ @DBNAME +'..CATEGORY WHERE CATCODE=T.CATCODE) FROM '+@TEMPISSUE+' T'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)    "
        strSql += vbCrLf + "    			SELECT @QRY='DECLARE @BILLNO NVARCHAR(20)'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' DECLARE CUR CURSOR FOR SELECT DISTINCT IBILLNO FROM '+@TEMPACCTRANN+' '     "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' OPEN CUR'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' FETCH NEXT FROM CUR INTO @BILLNO'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' WHILE @@FETCH_STATUS=0'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' BEGIN'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' SET ROWCOUNT 1'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' UPDATE '+@TEMPISSUE+' SET CASH=A.CASH,CRCARD=A.CRCARD,CHEQUE=A.CHEQUE,CHIT=A.CHIT,ADVANCE=A.ADVANCE,GV=A.GV,HC=A.HC,DISCOUNT=A.DISCOUNT,CRBALANCE=A.CRBALANCE,ACTOTAL=A.ACTOTAL FROM '+@TEMPISSUE+' T,'+@TEMPACCTRANN+' A'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' WHERE T.BATCHNO=A.BATCHNO AND T.IBILLNO=@BILLNO'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' SET ROWCOUNT 0'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' FETCH NEXT FROM CUR INTO @BILLNO'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' END'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' CLOSE CUR'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' DEALLOCATE CUR'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)"
        strSql += vbCrLf + "    			SELECT @QRY='SELECT *,CONVERT(VARCHAR(20),NULL)DBILLNO,CONVERT(VARCHAR(20),NULL)PDBILLNO,CONVERT(VARCHAR(20),NULL)SDBILLNO,IDENTITY(INT,1,1)SNO1,999999 NSNO INTO '+@TEMPSALEABSTRACT+' FROM ('    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY+'SELECT *,(SELECT CASHNAME FROM '+ @DBNAME +'..CASHCOUNTER WHERE CASHID=I.CASHID)COUNTERNAME'    "
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' FROM '+@TEMPISSUE+' I)X ORDER BY IBILLDATE,BATCHNO,COLHEAD'    "
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)   			"
        strSql += vbCrLf + "    			SELECT @QRY='CREATE TABLE '+@TEMPSALEABSTRACT_RES+' (BILLNO VARCHAR(200) DEFAULT NULL,CATNAME VARCHAR(200),BILLDATE VARCHAR(12),WEIGHT VARCHAR(15),AMOUNT NUMERIC(15,2),'"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' VAT NUMERIC(15,2),TOTAL NUMERIC(15,2),CHIT NUMERIC(15,2),ADVANCE NUMERIC(15,2),CREDIT NUMERIC(15,2)'"
        strSql += vbCrLf + "    			SELECT @QRY=@QRY + CHAR(13) +' ,CREDITCARD NUMERIC(15,2),COMM NUMERIC(15,2),COLHEAD VARCHAR(1),RESULT INT)'"
        strSql += vbCrLf + "    			PRINT @QRY    "
        strSql += vbCrLf + "    			EXEC(@QRY)  		"
        strSql += vbCrLf + "   			SELECT @QRY=' INSERT INTO '+@TEMPSALEABSTRACT_RES+' (CATNAME,COLHEAD,RESULT)'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SELECT DISTINCT CATNAME,''H'' COLHEAD,0 AS RESULT FROM '+ @TEMPSALEABSTRACT +''"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "   			SELECT @QRY=' INSERT INTO '+@TEMPSALEABSTRACT_RES+' (BILLNO,CATNAME,BILLDATE,WEIGHT,AMOUNT,VAT,TOTAL,CHIT,ADVANCE,CREDIT,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' CREDITCARD,COMM,COLHEAD,RESULT)'"
        strSql += vbCrLf + "             IF @SUMDET ='0'"
        strSql += vbCrLf + "             BEGIN"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' SELECT DISTINCT IBILLNO,CATNAME,'"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' CONVERT(VARCHAR(12),IBILLDATE,103)IBILLDATE,SUM(IWEIGHT)IWEIGHT,SUM(ITOTAL)-SUM(ITAX) AMOUNT,SUM(ITAX)ITAX,SUM(ITOTAL)ITOTAL,SUM(CHIT)CHIT,SUM(ADVANCE)ADVANCE,SUM(CRBALANCE)CRBALANCE,SUM(CRCARD)CRCARD,SUM(HC) AS COMM,'"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' '''' COLHEAD,1 AS RESULT FROM '+ @TEMPSALEABSTRACT +' WHERE ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' GROUP BY IBILLNO,CATNAME,IBILLDATE'"
        strSql += vbCrLf + "             End"
        strSql += vbCrLf + "             IF @SUMDET ='1'"
        strSql += vbCrLf + "             BEGIN"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' SELECT DISTINCT IBILLNO,CATNAME,'"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' CONVERT(VARCHAR(12),IBILLDATE,103)IBILLDATE,IWEIGHT,(ITOTAL-ITAX) AMOUNT,ITAX,ITOTAL,CHIT,ADVANCE,CRBALANCE,CRCARD,HC AS COMM,'"
        strSql += vbCrLf + "             SELECT @QRY=@QRY + CHAR(13) +' '''' COLHEAD,1 AS RESULT FROM '+ @TEMPSALEABSTRACT +' WHERE ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "             End"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "   			SELECT @QRY=' INSERT INTO '+@TEMPSALEABSTRACT_RES+' (BILLNO,CATNAME,WEIGHT,COLHEAD,RESULT)'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SELECT DISTINCT IBILLNO,CATNAME,''CANCEL'' WEIGHT,'''' COLHEAD,1 AS RESULT FROM '+ @TEMPSALEABSTRACT +' WHERE ISNULL(CANCEL,'''')<>'''''"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "   			SELECT @QRY=' INSERT INTO '+@TEMPSALEABSTRACT_RES+' (CATNAME,WEIGHT,AMOUNT,VAT,TOTAL,CHIT,ADVANCE,CREDIT,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' CREDITCARD,COMM,COLHEAD,RESULT)'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SELECT CATNAME,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SUM(IWEIGHT)IWEIGHT,SUM(ITOTAL-ITAX) AMOUNT,SUM(ITAX)ITAX,SUM(ITOTAL)ITOTAL,SUM(CHIT)CHIT,SUM(ADVANCE)ADVANCE,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SUM(CRBALANCE)CRBALANCE,SUM(CRCARD)CRCARD,SUM(HC) AS COMM,''S'' COLHEAD,2 AS RESULT FROM '+ @TEMPSALEABSTRACT +' WHERE ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' GROUP BY CATNAME '"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "   			SELECT @QRY=' INSERT INTO '+@TEMPSALEABSTRACT_RES+' (CATNAME,WEIGHT,AMOUNT,VAT,TOTAL,CHIT,ADVANCE,CREDIT,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' CREDITCARD,COMM,COLHEAD,RESULT)'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SELECT ''ZZZZZZ'' CATNAME,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SUM(IWEIGHT)IWEIGHT,SUM(ITOTAL-ITAX) AMOUNT,SUM(ITAX)ITAX,SUM(ITOTAL)ITOTAL,SUM(CHIT)CHIT,SUM(ADVANCE)ADVANCE,'"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' SUM(CRBALANCE)CRBALANCE,SUM(CRCARD)CRCARD,SUM(HC) AS COMM,''T'' COLHEAD,3 AS RESULT FROM '+ @TEMPSALEABSTRACT +' WHERE ISNULL(CANCEL,'''')='''''"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "   			SELECT @QRY=' UPDATE '+@TEMPSALEABSTRACT_RES+' SET AMOUNT=NULL WHERE AMOUNT=''0'''    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET VAT=NULL WHERE VAT=''0'''    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET TOTAL=NULL WHERE TOTAL=0'    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET CHIT=NULL WHERE CHIT=0'    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET ADVANCE=NULL WHERE ADVANCE=0'    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET CREDIT=NULL WHERE CREDIT=0'    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET CREDITCARD=NULL WHERE CREDITCARD=0'    "
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+ CHAR(13) +' UPDATE '+@TEMPSALEABSTRACT_RES+' SET COMM=NULL WHERE COMM=0'    			"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY) "
        strSql += vbCrLf + "   			SELECT @QRY=' SELECT * FROM '+@TEMPSALEABSTRACT_RES+''"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY + CHAR(13) +' ORDER BY CATNAME,RESULT,CONVERT(NUMERIC,BILLNO)'"
        strSql += vbCrLf + "   			PRINT @QRY    "
        strSql += vbCrLf + "   			EXEC(@QRY)"
        strSql += vbCrLf + "           END  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub SP_BILLPRINT()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_BILLPRINT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_BILLPRINT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE [SP_BILLPRINT]"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + "  @BATCHNO VARCHAR(20)"
        strSql += vbCrLf + " ,@TRANDATE VARCHAR(12)"
        strSql += vbCrLf + " ,@SYSTEMID VARCHAR(20)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " DECLARE @QRY AS VARCHAR(8000)"
        strSql += vbCrLf + " DECLARE @DBNAME AS VARCHAR(10)"
        strSql += vbCrLf + " DECLARE @CHITPREFIX AS VARCHAR(3)"
        strSql += vbCrLf + " DECLARE @ERROR VARCHAR(1000)"
        strSql += vbCrLf + " DECLARE @CHKTBLCNT AS INT"
        strSql += vbCrLf + " SELECT @DBNAME = DBNAME FROM DBMASTER WHERE ''+@TRANDATE+'' BETWEEN STARTDATE AND ENDDATE"
        strSql += vbCrLf + " SELECT @CHITPREFIX = CTLTEXT FROM SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'"
        strSql += vbCrLf + " PRINT @CHITPREFIX"
        strSql += vbCrLf + " PRINT @DBNAME"
        strSql += vbCrLf + " SELECT @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'HEADINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'HEADINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'BHEADINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'BHEADINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'CUSTINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CUSTINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'DATAINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'DATAINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'STONEINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'STONEINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'BFOOTINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'BFOOTINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'TOTALINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'TOTALINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'PAYMODEINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'PAYMODEINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'BDISCINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'BDISCINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'BILLINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'BILLINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ACCINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ACCINFO'  "
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDFOOTINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ORDFOOTINFO'"
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'RREFOOTINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'RREFOOTINFO'"
        strSql += vbCrLf + " SELECT @QRY= @QRY+CHAR(13)+'   IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'FOOTERINFO'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'FOOTERINFO'"
        strSql += vbCrLf + " BEGIN TRY  "
        strSql += vbCrLf + "		EXEC(@QRY)"
        strSql += vbCrLf + "	END TRY  "
        strSql += vbCrLf + "	BEGIN CATCH  		"
        strSql += vbCrLf + "		SELECT @ERROR = ERROR_MESSAGE()"
        strSql += vbCrLf + "		PRINT(@QRY)"
        strSql += vbCrLf + "		RAISERROR (15600,-1,-1, @ERROR); "
        strSql += vbCrLf + "	END CATCH"
        strSql += vbCrLf + "	/*HEADINFO*/"
        strSql += vbCrLf + "	SELECT @QRY = ''	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' SELECT COMPANYNAME AS CMP_NAME,ADDRESS1 AS CMP_ADD1,ADDRESS2 AS CMP_ADD2,ADDRESS3 CMP_ADD3,ADDRESS4 CMP_CITY'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' ,AREACODE AS CMP_PINCODE,PHONE AS CMP_PHONE,CSTNO AS CMP_CSTNO,GSTNO AS CMP_GSTNO,TINNO AS CMP_TINNO,PANNO AS CMP_PANNO'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'HEADINFO FROM COMPANY WHERE COMPANYID = SUBSTRING('''+@BATCHNO+''',3,3) '	"
        strSql += vbCrLf + "	BEGIN TRY  "
        strSql += vbCrLf + "		EXEC(@QRY)"
        strSql += vbCrLf + "	END TRY  "
        strSql += vbCrLf + "	BEGIN CATCH  		"
        strSql += vbCrLf + "		SELECT @ERROR = ERROR_MESSAGE()"
        strSql += vbCrLf + "		PRINT(@QRY)"
        strSql += vbCrLf + "		RAISERROR (15600,-1,-1, @ERROR); "
        strSql += vbCrLf + "	END CATCH"

        strSql += vbCrLf + "	/*CUSTINFO*/"
        strSql += vbCrLf + "	SELECT @QRY = ''	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' SELECT DISTINCT ' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' PNAME AS CU_NAME,DOORNO  CU_ADD1,ADDRESS1 + '' '' + ADDRESS2 AS CU_ADD2,ADDRESS3 CU_ADD3'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+',AREA + '' '' + CITY + '' ''+PINCODE AS CU_CITY,MOBILE AS CU_MOB'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+',PAN CU_PAN,GSTNO AS CU_GSTNO,IDTYPE AS CU_IDNAME,IDNO AS CU_IDNO'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CUSTINFO FROM PERSONALINFO WHERE SNO =(SELECT PSNO FROM CUSTOMERINFO WHERE BATCHNO  = '''+@BATCHNO+''')'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' UNION ALL' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' SELECT' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' ACNAME AS CU_NAME,DOORNO  CU_ADD1,ADDRESS1 + '' '' + ADDRESS2 AS CU_ADD2,ADDRESS3 CU_ADD3'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+',AREA + '' '' + CITY + '' ''+PINCODE AS CU_CITY,MOBILE AS CU_MOB'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+',PAN CU_PAN,GSTNO AS CU_GSTNO,NULL AS CU_IDNAME,NULL AS CU_IDNO'	"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' FROM ACHEAD WHERE ACCODE IN (SELECT ACCODE FROM '+@DBNAME+'..ISSUE WHERE BATCHNO = '''+@BATCHNO+''' AND LEN(TRANTYPE)>2 UNION ALL SELECT ACCODE FROM '+@DBNAME+'..RECEIPT WHERE BATCHNO = '''+@BATCHNO+''' AND LEN(TRANTYPE)>2)'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' UNION ALL' "
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+' SELECT' "
