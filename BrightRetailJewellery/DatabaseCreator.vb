        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,CASE WHEN I.FLAG =''C'' THEN ''COUNTERSALES'' WHEN FLAG =''B'' THEN ''BACKOFFICE'' ELSE '''' END AS FLAG'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,(SELECT TOP 1 EMPNAME FROM '+@CNADMINDB+'..EMPMASTER E WHERE E.EMPID = I.EMPID ) AS EMPLOYEENAME'"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,(SELECT PNAME FROM '+@CNADMINDB+'..PERSONALINFO AS PSI WHERE PSI.SNO IN (SELECT PSNO FROM '+@CNADMINDB+'..CUSTOMERINFO AS CI WHERE CI.BATCHNO = I.BATCHNO)) AS CUSTOMERNAME'"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,CASE WHEN ISNULL(O.ODSNO,'''')<>'''' THEN ''6'' ELSE ''1'' END RESULT,TRANDATE,TRANNO,CONVERT(VARCHAR(15),I.SNO)SNO,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(VARCHAR(50),'''')SEP'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COUNTERREPORT'  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' FROM  '+@CNSTOCKDB+'..ISSUE AS I'"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' INNER JOIN '+@CNADMINDB+'..ITEMMAST AS IT ON I.ITEMID = IT.ITEMID AND STOCKTYPE =''T'''"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' LEFT JOIN '+@CNADMINDB+'..SUBITEMMAST AS SIT ON I.SUBITEMID = SIT.SUBITEMID '"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' LEFT JOIN '+@CNADMINDB+'..ORMAST AS O ON I.SNO = O.ODSNO '"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' WHERE TRANDATE BETWEEN ''' +@DATEFROM+''' AND '''+@DATETO+''''  "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND I.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'   "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND ISNULL(I.TAGNO,'''') = '''' '"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' And I.TRANTYPE IN (''SA'',''MI'' '"
        strSql += vbCrLf + " 	IF @APPROVAL ='Y'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	    SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,''AI'' '"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' )'"
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' And ISNULL(I.CANCEL,'''') <> ''Y'''   "
        strSql += vbCrLf + " 	SELECT @STRQRY= @STRQRY+ CHAR(13) +' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE) '   "
        strSql += vbCrLf + " 	IF @SYSTEM <> 'ALL' AND @SYSTEM <> ''"
