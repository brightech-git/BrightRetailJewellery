        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO = (sELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO  "
        strSql += vbCrLf + "  		WHERE BATCHNO = R.BATCHNO)) AS CUSNAME  "
        strSql += vbCrLf + "  		,(SELECT ITEMNAME FROM " & cnAdminDb & "..ITEMMAST AS IT WHERE IT.ITEMID = R.ITEMID) AS ITEMNAME  "
        strSql += vbCrLf + "  		,MCHARGE, CONVERT(DECIMAL(15,2),WASTAGE*RATE) VALUEADD, RATE, AMOUNT, GRSWT,NETWT,TAX, 0 AS  RECEIPT, AMOUNT + TAX AS PAYMENT  "
        strSql += vbCrLf + "  		,(SELECT CATNAME FROM " & cnAdminDb & "..CATEGORY AS M WHERE M.CATCODE = R.CATCODE) AS METALNAME  "
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD ,CONVERT(INT,1) RESULT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE  FROM RECEIPT AS R  "
        strSql += vbCrLf + "  		WHERE TRANTYPE  = ''PU'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') <> ''Y''  "
        strSql += vbCrLf + "  		AND ISNULL(R.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE)>0  "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''PURCHASE ADJUSTED'',''T''  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE     "
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,COLHEAD,RESULT,RECEIPT)   "
        strSql += vbCrLf + "  		SELECT DISTINCT METALNAME,METALNAME,''S''COLHEAD,0 RESULT, 0 RECEIPT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE WHERE RESULT = 1"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE"
        strSql += vbCrLf + "  		(CUSNAME,METALNAME,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT METALNAME+'' SUBTOTAL'' CUSNAME,METALNAME,SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT)      "
        strSql += vbCrLf + "  		,''S'' COLHEAD,2 RESULT     "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE WHERE RESULT = 1 GROUP BY METALNAME "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL5,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,VALUEADD,RATE,AMOUNT,GRSWT,NETWT,TAX,NULL RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'PURCHASE ORDER BY METALNAME,RESULT,CONVERT(INT,TRANNO)      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		/**************** CARD AND CHEQ COLLECTION DETAILS *************************/     "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CARDCOLLECT'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT   "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(500),PARTICULAR)PARTICULAR,TRANDATE,TRANNO,AMOUNT,CHQCARDNO,SYSTEMID,PAYMODE,CONVERT(VARCHAR(3),COLHEAD)COLHEAD,RESULT,CARDNAME   "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT    "
        strSql += vbCrLf + "  		FROM ("
        strSql += vbCrLf + "  		SELECT '' '' + CHQCARDREF AS PARTICULAR,T.TRANDATE,T.TRANNO   "
        strSql += vbCrLf + "  		,CASE WHEN TRANMODE = ''D'' THEN T.AMOUNT ELSE -1*T.AMOUNT END AS AMOUNT,CASE WHEN PAYMODE IN (''SS'',''CB'',''CZ'',''CG'',''CD'')     "
        strSql += vbCrLf + "  		THEN CHQCARDREF + '':'' + CHQCARDNO ELSE CHQCARDNO END CHQCARDNO,T.SYSTEMID,CASE PAYMODE WHEN ''CC'' THEN ''CREDIT CARD'' WHEN ''CH'' THEN ''CHEQUE''  "
        strSql += vbCrLf + "  		ELSE ''SCHEME'' END AS PAYMODE,CONVERT(VARCHAR(1),NULL)COLHEAD,CONVERT(INT,2) RESULT   "
        strSql += vbCrLf + "  		,(SELECT TOP 1 NAME FROM " & cnAdminDb & "..CREDITCARD WHERE CARDCODE = T.CARDID)AS CARDNAME "
        strSql += vbCrLf + "  		FROM ACCTRAN T     "
        strSql += vbCrLf + "  		/*left outer join ..issue I on I.TranNo=T.TranNo and TRANTYPE=''SA''*/  "
        strSql += vbCrLf + "  		WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + ''' AND PAYMODE IN (''CC'',''CH'') AND ISNULL(T.CANCEL,'''') <> ''Y'' "
        strSql += vbCrLf + "  		AND ISNULL(T.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY) AND BATCHNO IN (SELECT BATCHNO FROM ISSUE)   "
        strSql += vbCrLf + "  		group by CHQCARDREF,T.TRANDATE,T.TRANNO,TRANMODE,T.AMOUNT,PAYMODE,CHQCARDNO,T.SYSTEMID,T.CARDID  "
        strSql += vbCrLf + "  		)X   "
        strSql += vbCrLf + "  		GROUP BY PARTICULAR,TRANDATE,TRANNO, AMOUNT,CHQCARDNO, SYSTEMID,PAYMODE,CARDNAME,RESULT,COLHEAD  "
        strSql += vbCrLf + "		ORDER BY TRANDATE, CONVERT(INT,TRANNO ) "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT(PAYMODE,PARTICULAR,RESULT,COLHEAD)   "
        strSql += vbCrLf + "  		SELECT DISTINCT PAYMODE,PAYMODE,0 RESULT,''T'' COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT WHERE RESULT = 2   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT(PAYMODE,PARTICULAR,AMOUNT,RESULT,COLHEAD,CARDNAME)   "
        strSql += vbCrLf + "  		SELECT DISTINCT PAYMODE,PAYMODE+'' SUB TOTAL'',SUM(AMOUNT),3 RESULT,''S'',''ZZZZ'' COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT WHERE RESULT = 2 GROUP BY PAYMODE   "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT(PAYMODE,RESULT,COLHEAD,CARDNAME,PARTICULAR)  "
        strSql += vbCrLf + "  		SELECT DISTINCT PAYMODE,1 RESULT,''T1'' COLHEAD,CARDNAME,CARDNAME + '' ['' + ISNULL(CONVERT(VARCHAR,SUM(AMOUNT)),'''') +'']'' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT WHERE RESULT = 2 AND PAYMODE = ''CREDIT CARD''  GROUP BY PAYMODE,CARDNAME"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT PARTICULAR,TRANNO,'''',AMOUNT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CARDCOLLECT ORDER BY PAYMODE,CARDNAME,RESULT,PARTICULAR,TRANDATE'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)   "
        strSql += vbCrLf + "  		/******************** credit sales********************/  "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CREDITSALES'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL)  FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME"
        strSql += vbCrLf + "  		, CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT, GRSWT ,NETWT,0 AS TAX,0 AS RECEIPT,AMOUNT AS PAYMENT"
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES FROM " & cnAdminDb & "..OUTSTANDING AS O  WHERE TRANTYPE  = ''D'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''      "
        strSql += vbCrLf + "  		AND PAYMODE = ''DU'' AND O.RECPAY = ''P''  AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'') AND ISNULL(CANCEL,'''') <>''Y''    "
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)     "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES)>0"
        strSql += vbCrLf + "  		BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''CREDIT SALE'',''S''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES"
        strSql += vbCrLf + "  		(CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT ''CREDIT SALE SUBTOTAL'' CUSNAME,'''',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT),SUM(TAX),SUM(RECEIPT),SUM(PAYMENT),''S'' COLHEAD,2 RESULT     "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES WHERE RESULT = 1"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL6,COL7,COL8,COL9,COL10,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,0 RATE,AMOUNT,GRSWT,NETWT,TAX,RECEIPT,PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'CREDITSALES ORDER BY RESULT "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
        strSql += vbCrLf + "  		END'   "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)"
        strSql += vbCrLf + "  		/*******************~ SCHEME ADJUSTED ****************/      "
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'COLSCA'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'COLSCA  "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(50),''SCHEME INFO'') AS CUSNAME,AMOUNT1 AS TAX,     "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)< 0 THEN  ABS(SUM(AMOUNT)) ELSE 0 END) AS RECEIPT ,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)> 0 THEN  SUM(AMOUNT) ELSE 0 END) AS PAYMENT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COLSCA     "
        strSql += vbCrLf + "  		FROM(  "
        strSql += vbCrLf + "  		SELECT (SELECT SUM(AMOUNT) FROM ACCTRAN A  "
        strSql += vbCrLf + "  		WHERE   "
        strSql += vbCrLf + "  		TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  "
        strSql += vbCrLf + "  		AND PAYMODE=''SS'' AND ISNULL(CANCEL,'''') <> ''Y'')AS AMOUNT,   "
        strSql += vbCrLf + "  		(SELECT SUM(AMOUNT) FROM ACCTRAN AC  "
        strSql += vbCrLf + "  		WHERE   "
        strSql += vbCrLf + "  		TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  "
        strSql += vbCrLf + "  		AND PAYMODE=''CB'' AND ISNULL(CANCEL,'''') <> ''Y'') AS AMOUNT1   "
        strSql += vbCrLf + "  		)X  "
        strSql += vbCrLf + "  		group by AMOUNT1  "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLSCA)>0   "
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''SCHEME ADJUSTED'',''S''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL7,COL10,COL11,COL12)   "
        strSql += vbCrLf + "  		SELECT PAYMENT,TAX,'''',(PAYMENT + ISNULL(TAX,0))AS PAYMENT FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLSCA   "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)   "
        strSql += vbCrLf + "  		/**************** CASH COLLECTION DETAILS *************************/      "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'COLDET'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET    "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR(50),(CASE"
        strSql += vbCrLf + "  		WHEN PAYMODE=''CA'' THEN ''CASH'' WHEN PAYMODE = ''CC'' THEN ''CREDIT CARD'' WHEN PAYMODE = ''CH'' THEN ''CHEQUE''"
        strSql += vbCrLf + "  		WHEN PAYMODE = ''SS'' THEN ''SCHEME'' WHEN PAYMODE = ''ET'' THEN ''ETRANSFER'' WHEN PAYMODE = ''OT'' THEN ''OTHERS''WHEN PAYMODE = ''RO'' THEN ''ROUND OFF''  END)) AS CUSNAME,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)< 0 THEN  ABS(SUM(AMOUNT)) ELSE 0 END) AS RECEIPT ,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)> 0 THEN  SUM(AMOUNT) ELSE 0 END) AS PAYMENT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET      "
        strSql += vbCrLf + "  		FROM (      "
        strSql += vbCrLf + "  		SELECT PAYMODE,SUM(CASE WHEN A.TRANMODE = ''C'' THEN A.AMOUNT ELSE -A.AMOUNT END) AS AMOUNT      "
        strSql += vbCrLf + "  		FROM ACCTRAN A    "
        strSql += vbCrLf + "  		/*left outer join issue I on A.TranNo=I.TranNo and I.TRANTYPE=''SA''*/  "
        strSql += vbCrLf + "  		WHERE TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(A.CANCEL,'''') <> ''Y''"
        strSql += vbCrLf + "  		AND ISNULL(A.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)    "
        strSql += vbCrLf + "  		AND PAYMODE IN (''CA'') AND FROMFLAG NOT IN ('''',''S'',''O'',''A'') AND BATCHNO IN (SELECT BATCHNO FROM ISSUE)  "
        strSql += vbCrLf + "  		group by PAYMODE  "
        strSql += vbCrLf + "  		)X"
        strSql += vbCrLf + "  		GROUP BY PAYMODE  HAVING(SUM(AMOUNT) <> 0)      "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET)>0   "
        strSql += vbCrLf + "  		BEGIN    "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''COLLECTION DETAILS'',''T''      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL11,COL12)      "
        strSql += vbCrLf + "  		SELECT * FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDET      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		/******************** ADVANCE ADJUSTED********************/  "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'ADVADJUSTED'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED"
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO      "
        strSql += vbCrLf + "  		,'' '' + (SELECT (PNAME+'' ''+INITIAL) CUSNAME FROM " & cnAdminDb & "..PERSONALINFO WHERE SNO ="
        strSql += vbCrLf + "  		(SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO = O.BATCHNO)) AS CUSNAME , CONVERT(VARCHAR(100),'''') AS ITEMNAME      "
        strSql += vbCrLf + "  		, 0 AS MCHARGE, RATE, AMOUNT+ISNULL(GSTVAL,0) AS AMOUNT, GRSWT,NETWT   "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''IG'' AND T.TRANTYPE IN(''AA'',''AP''))AS IGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''CG'' AND T.TRANTYPE IN(''AA'',''AP''))AS CGST  "
        strSql += vbCrLf + "  		,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN T WHERE T.BATCHNO=O.BATCHNO AND TAXID=''SG'' AND T.TRANTYPE IN(''AA'',''AP''))AS SGST  "
        strSql += vbCrLf + "  		,GSTVAL AS TAX,0 AS RECEIPT, AMOUNT+ISNULL(GSTVAL,0)  AS PAYMENT"
        strSql += vbCrLf + "  		,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1) RESULT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED FROM " & cnAdminDb & "..OUTSTANDING AS O  WHERE TRANTYPE  = ''A'' AND TRANDATE BETWEEN ''' + @FRMDATE + ''' AND ''' + @TODATE + '''  AND ISNULL(CANCEL,'''') <>''Y''   "
        strSql += vbCrLf + "  		AND  PAYMODE IN (''AA'',''AP'') AND O.RECPAY = ''P'' AND NOT (SUBSTRING(O.RUNNO,6,10) LIKE ''O%'' OR SUBSTRING(O.RUNNO,6,10) LIKE ''R%'')      "
        strSql += vbCrLf + "  		AND ISNULL(O.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)  ' "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		SELECT @QRY= '		 "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED)>0      "
        strSql += vbCrLf + "  		BEGIN      "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COLHEAD)SELECT ''ADVANCE ADJUSTED'',''S''   "
        strSql += vbCrLf + "  		END   "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED)>0      "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED"
        strSql += vbCrLf + "  		(CUSNAME,ITEMNAME,MCHARGE,AMOUNT,GRSWT,NETWT,TAX,IGST,CGST,SGST,RECEIPT,PAYMENT,COLHEAD,RESULT)      "
        strSql += vbCrLf + "  		SELECT ''ADVANCE ADJUSTED SUBTOTAL'' CUSNAME,'''',SUM(MCHARGE),SUM(AMOUNT),SUM(GRSWT),SUM(NETWT)  "
        strSql += vbCrLf + "  		,SUM(TAX),SUM(IGST),SUM(CGST),SUM(SGST),SUM(RECEIPT),SUM(PAYMENT),''S'' COLHEAD,2 RESULT     "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED WHERE RESULT = 1  "
        strSql += vbCrLf + "  		END   "
        strSql += vbCrLf + "  		IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED)>0      "
        strSql += vbCrLf + "  		BEGIN  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1,COL2,COL3,COL4,COL6,COL7,COL8,COL9,COL10,COL9A,COL9B,COL9C,COL11,COL12,COLHEAD)      "
        strSql += vbCrLf + "  		SELECT CUSNAME,TRANNO,ITEMNAME,MCHARGE,RATE,AMOUNT,GRSWT,NETWT  "
        strSql += vbCrLf + "  		,TAX,SGST,CGST,IGST  "
        strSql += vbCrLf + "  		,'''',PAYMENT,COLHEAD FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'ADVADJUSTED ORDER BY RESULT ,CONVERT(INT,TRANNO)     "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'DAYREPORT1(COL1)SELECT ''''      "
        strSql += vbCrLf + "  		END'  "
        strSql += vbCrLf + "  		PRINT @QRY  "
        strSql += vbCrLf + "  		EXEC (@QRY)     "
        strSql += vbCrLf + "  		SELECT @QRY= 'IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'COLDI'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDI    "
        strSql += vbCrLf + "  		SELECT CONVERT(VARCHAR,TRANNO) AS TRANNO,CONVERT(VARCHAR(50),(CASE  WHEN PAYMODE=''DI'' THEN ''DISCOUNT'' END)) AS CUSNAME,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)< 0 THEN  ABS(SUM(AMOUNT)) ELSE 0 END) AS RECEIPT ,      "
        strSql += vbCrLf + "  		(CASE WHEN SUM(AMOUNT)> 0 THEN  SUM(AMOUNT) ELSE 0 END) AS PAYMENT  "
        strSql += vbCrLf + "  		INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'COLDI      "
        strSql += vbCrLf + "  		FROM (      "
        strSql += vbCrLf + "  		SELECT TRANNO,''DI'' PAYMODE,SUM((CASE WHEN A.TRANMODE = ''D'' THEN A.AMOUNT ELSE -A.AMOUNT END)) AS AMOUNT      "
