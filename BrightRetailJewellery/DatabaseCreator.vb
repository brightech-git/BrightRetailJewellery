        strSql += vbCrLf + " 	SELECT @QRY = 'INSERT INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE1 (SEP,COSTID,TITEMID,ITEMID,SUBITEMID,VALUE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,SNO,STONE,STNRATE,DIAPCS,DIAWT,STNPCS,STNWT)'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+'  SELECT ''OPE''SEP,T.COSTID,T.STNITEMID TITEMID,T.STNITEMID,T.STNSUBITEMID'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,STNAMT AS VALUE'  "
