        strSql += vbCrLf + "  		SELECT I.TRANNO,I.BATCHNO,I.ITEMID,I.MCHARGE,CONVERT(DECIMAL(15,2),I.WASTAGE*I.RATE) VALUEADD,I.RATE ,I.AMOUNT-Isnull((Case When Isnull(I.Trantype,'''')=''SA''Then ISNULL(I.Stnamt,0)Else 0 End),0) AS AMOUNT    "
        strSql += vbCrLf + "  		,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD''THEN 0 ELSE I.GRSWT END)AS GRSWT,(CASE WHEN ISNULL(TRANTYPE,'''')=''OD''THEN 0 ELSE I.NETWT END)AS NETWT,CASE WHEN I.AMOUNT <> 0 THEN I.TAX-ISNULL((SELECT SUM(TAX) FROM ..ISSSTONE WHERE ISSSNO = I.SNO),0) ELSE 0 END TAX,CATCODE    "
        strSql += vbCrLf + "  		FROM ..ISSUE AS I  "
