        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMP_OUTSTANDING') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_OUTSTANDING"
        strSql += vbCrLf + " 	IF @SUMMARY = 'N'    "
        strSql += vbCrLf + " 	BEGIN    "
        strSql += vbCrLf + " 		SELECT CONVERT(VARCHAR(200),NULL)PARTICULAR,CONVERT(VARCHAR(50),H.ACCODE) ACCODE,O.RUNNO,CONVERT(VARCHAR(50),O.TRANTYPE)TRANTYPE,O.TRANNO,O.TRANDATE,O.DUEDATE"
