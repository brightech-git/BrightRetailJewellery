        strSql += vbCrLf + "		,SUM(SALEGRSWEIGHT),SUM(SALEPCS),SUM(RETURNPCS),SUM(PCS), SUM(OPENAMOUNT),SUM(OPENSTNWT)"
        strSql += vbCrLf + "		,SUM(OPENGRSWEIGHT),SUM(OPENPCS),SUM(INCAMOUNT),0,SUM(OPENNETWEIGHT)"
        strSql += vbCrLf + "		,SUM(SALENETWEIGHT),SUM(RETURNNETWEIGHT),SUM(NETWEIGHT)  FROM TEMPTABLEDB..TMP1 "
        strSql += vbCrLf + "		GROUP BY ISNULL(GROUPCOL,''),GROUPCOL,COUNTERID"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " /* STEEP6 */"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM TEMPTABLEDB..TMP1)>0 "
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TMP1"
        strSql += vbCrLf + "	(SALESPERSON,GROUPCOL,RESULT, COLHEAD,AMOUNT,STNWT,GRSWEIGHT,RETURNAMOUNT,RETURNSTNWT,RETURNGRSWEIGHT"
        strSql += vbCrLf + "	, SALEAMOUNT,SALESTNWT,SALEGRSWEIGHT,SALEPCS,RETURNPCS,PCS, OPENAMOUNT,OPENSTNWT,OPENGRSWEIGHT,OPENPCS,INCAMOUNT"
        strSql += vbCrLf + "	,OPENNETWEIGHT,SALENETWEIGHT,RETURNNETWEIGHT,NETWEIGHT)"
        strSql += vbCrLf + "	SELECT  'GRAND TOTAL','ZZZZZZZZ',3 RESULT, 'G' COLHEAD,SUM(AMOUNT),SUM(STNWT),SUM(GRSWEIGHT)"
        strSql += vbCrLf + "	,SUM(RETURNAMOUNT),SUM(RETURNSTNWT),SUM(RETURNGRSWEIGHT),SUM(SALEAMOUNT),SUM(SALESTNWT)"
        strSql += vbCrLf + "	,SUM(SALEGRSWEIGHT),SUM(SALEPCS),SUM(RETURNPCS),SUM(PCS), SUM(OPENAMOUNT),SUM(OPENSTNWT)"
        strSql += vbCrLf + "	,SUM(OPENGRSWEIGHT),SUM(OPENPCS),SUM(INCAMOUNT),SUM(OPENNETWEIGHT)"
        strSql += vbCrLf + "	,SUM(SALENETWEIGHT),SUM(RETURNNETWEIGHT),SUM(NETWEIGHT)  FROM TEMPTABLEDB..TMP1   WHERE RESULT = 1"

        strSql += vbCrLf + "	INSERT INTO TEMPTABLEDB..TMP2(SALESPERSON,SALEPCS,SALEGRSWEIGHT,SALESTNWT,SALEAMOUNT"
        strSql += vbCrLf + "	, RETURNPCS,RETURNGRSWEIGHT,RETURNSTNWT,RETURNAMOUNT,PCS,GRSWEIGHT,STNWT,AMOUNT"
        strSql += vbCrLf + "	,RESULT,COLHEAD,GROUPCOL, OPENAMOUNT,OPENSTNWT,OPENGRSWEIGHT,OPENPCS, COUNTERID, INCAMOUNT"
        strSql += vbCrLf + "	,OPENNETWEIGHT,SALENETWEIGHT,RETURNNETWEIGHT,NETWEIGHT)"
        strSql += vbCrLf + "	SELECT  SALESPERSON,SUM(SALEPCS),SUM(SALEGRSWEIGHT),SUM(SALESTNWT),SUM(SALEAMOUNT),SUM(RETURNPCS),SUM(RETURNGRSWEIGHT),"
        strSql += vbCrLf + "	SUM(RETURNSTNWT),SUM(RETURNAMOUNT),SUM(PCS),SUM(GRSWEIGHT),SUM(STNWT),SUM(AMOUNT),RESULT,COLHEAD,GROUPCOL"
        strSql += vbCrLf + "	,SUM(OPENAMOUNT),SUM(OPENSTNWT),SUM(OPENGRSWEIGHT),SUM(OPENPCS), COUNTERID ,SUM(INCAMOUNT)"
        strSql += vbCrLf + "	,SUM(OPENNETWEIGHT),SUM(SALENETWEIGHT),SUM(RETURNNETWEIGHT),SUM(NETWEIGHT)	"
        strSql += vbCrLf + "	FROM TEMPTABLEDB..TMP1 "
        strSql += vbCrLf + "	GROUP BY GROUPCOL,RESULT,SALESPERSON,COLHEAD,COUNTERID"
        strSql += vbCrLf + "	ORDER BY GROUPCOL,RESULT,SALESPERSON"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " /*STEEP7 */"
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM TEMPTABLEDB..TMP2)>0"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET OPENGRSWEIGHT = NULL WHERE OPENGRSWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET OPENNETWEIGHT = NULL WHERE OPENNETWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET OPENSTNWT = NULL WHERE OPENSTNWT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET OPENAMOUNT = NULL WHERE OPENAMOUNT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET OPENPCS = NULL WHERE OPENPCS = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET SALEGRSWEIGHT = NULL WHERE SALEGRSWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET SALENETWEIGHT = NULL WHERE SALENETWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET SALESTNWT = NULL WHERE SALESTNWT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET SALEAMOUNT = NULL WHERE SALEAMOUNT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET RETURNGRSWEIGHT = NULL WHERE RETURNGRSWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET RETURNNETWEIGHT = NULL WHERE RETURNNETWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET RETURNSTNWT = NULL WHERE RETURNSTNWT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET RETURNAMOUNT = NULL WHERE RETURNAMOUNT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET GRSWEIGHT = NULL WHERE GRSWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET NETWEIGHT = NULL WHERE NETWEIGHT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET STNWT = NULL WHERE STNWT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET AMOUNT = NULL WHERE AMOUNT = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET SALEPCS = NULL WHERE SALEPCS = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET RETURNPCS = NULL WHERE RETURNPCS = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET PCS = NULL WHERE PCS = 0"
        strSql += vbCrLf + "	UPDATE TEMPTABLEDB..TMP2 SET INCAMOUNT = NULL WHERE INCAMOUNT = 0"
        strSql += vbCrLf + "	IF @EMPNAME <> 'ALL'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "   		DELETE FROM  TEMPTABLEDB..TMP2 WHERE RESULT IN (2) 		"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	ELSE"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "   		UPDATE TEMPTABLEDB..TMP2 SET SALESPERSON = '-> SUB TOTAL' WHERE RESULT=2"
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + " END"
        strSql += vbCrLf + " DROP TABLE TEMPEMP"
        strSql += vbCrLf + " SELECT * FROM TEMPTABLEDB..TMP2 ORDER BY SNO "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Function

    Function funcSP13_PurchaseVatReport() As Integer
        strSql = " /* -- ======================================= */"
        strSql += vbCrLf + "  /* -- Store procedure for PurchaseVAT Report */"
        strSql += vbCrLf + "  /* -- ======================================= */"
        strSql += vbCrLf + "  /**************************************************************************************** */"
        strSql += vbCrLf + "  /*  Intitial Authors :       */"
        strSql += vbCrLf + "  /*  Create   Date    : 08/09/2008      */"
        strSql += vbCrLf + "  /*  Purpose          : For PURCHASEVAT REPORT      */"
        strSql += vbCrLf + "  /*  Refred Tables    : " & tranDbName & "..RECEIPT */"
        strSql += vbCrLf + "  /*		     " & compId + suffix & "..ACHEAD," & compId + suffix & "..CATEGORY," & compId + suffix & "..METALMAST */"
        strSql += vbCrLf + "  /*  Refred Forms/Dll : MDIREPORT=>FRMPURCHASEVATRPT */"
        strSql += vbCrLf + "  /*          */"
        strSql += vbCrLf + "  /*   Created/Modified            Modified                 Description       */"
        strSql += vbCrLf + "  /*       */"
        strSql += vbCrLf + "  /* ****************************************************************************************** */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql += vbCrLf + "  /* -- Already Exists this procedure drop this Procedure */"
        strSql += vbCrLf + "  /* -- ================================================= */"
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PURCHASEVAT')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PURCHASEVAT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Create store procedure */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql = "  CREATE PROCEDURE SP_RPT_PURCHASEVAT"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  /* -- Declare Variables */"
        strSql += vbCrLf + "  /* -- ======================= */"
        strSql += vbCrLf + "  (		 @DateFrom  VARCHAR(12)/* -- FromDate */"
        strSql += vbCrLf + "  		,@DateTo VARCHAR(12)/* -- EndDate */"
        strSql += vbCrLf + "  		,@locout CHAR/* -- Find Local,Outstanding or Both		 */"
        strSql += vbCrLf + "  		,@AcName nvarchar(100)/* -- Account Name from ACHEAD Table */"
        strSql += vbCrLf + "  		,@CatName nvarchar(100)/* -- Category Name from CATEGORY Table */"
        strSql += vbCrLf + "  		,@MetalName nvarchar(100)/* -- Metal Name from METALNAME Table */"
        strSql += vbCrLf + "  		,@ANAMENALL NVARCHAR(3)/* -- Check ALL or Datas condition in Account Name */"
        strSql += vbCrLf + "  		,@CNAMEALL NVARCHAR(3)/* -- Check ALL or Datas condition in Category Name */"
        strSql += vbCrLf + "          ,@METNAMEALL NVARCHAR(3)/* -- Check ALL or Datas condition in Metal Name */"
        strSql += vbCrLf + "  		,@chkCat char/* -- Check CategoryWise Checked Or Not */"
        strSql += vbCrLf + "  		,@GroupBy char/* -- SummaryWise-S; Monthwise-M; Datewise-D; Billnowise-B  */"
        strSql += vbCrLf + "  		,@SystemId nvarchar(20)/* -- Give the SystemId for Temporary Tables */"
        strSql += vbCrLf + "  		,@cnAdminDB nvarchar(50)/* -- Give the DataBase Name For AdminDb  */"
        strSql += vbCrLf + "  		,@cnStockDB nvarchar(50)/* -- Give the DataBase Name For StockDb */"
        strSql += vbCrLf + "  		,@COMPANYID NVARCHAR(500)/* -- GIVE THE COMPANYID*/"
        strSql += vbCrLf + "   ) AS"

        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY"
        strSql += vbCrLf + " CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))"
        strSql += vbCrLf + " DECLARE @TCOMPANY VARCHAR(50)"
        strSql += vbCrLf + " IF CHARINDEX(',',@COMPANYID)=0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " WHILE CHARINDEX(',',@COMPANYID)>0"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)"
        strSql += vbCrLf + " 	SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))"
        strSql += vbCrLf + " 	IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0"
        strSql += vbCrLf + " 		BEGIN"
        strSql += vbCrLf + " 		SET @COMPANYID= @COMPANYID + ','"
        strSql += vbCrLf + " 		END"
        strSql += vbCrLf + " 	INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY"
        strSql += vbCrLf + " 	END"

        strSql += vbCrLf + "  DECLARE @STRQRY NVARCHAR(4000)"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  /* -- Take the Datas from Receipt Table with conditions into Temporary Table */"
        strSql += vbCrLf + "  /* -- ====================================================================== */"
        strSql += vbCrLf + "  SELECT @STRQRY =''"
        strSql += vbCrLf + "  SELECT @strQry ='if(select 1 from MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'PURCHASEVAT'')>0'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  drop table MASTER..TEMP'+@SystemId+'PURCHASEVAT'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  select'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  TRANNO,TRANDATE,ITEMID,CATCODE,PCS,GRSWT,NETWT,LESSWT,AMOUNT,TAX,METALID,ACCODE,REMARK1'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  into MASTER..TEMP'+@SystemId+'PURCHASEVAT'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  from '+@cnStockDB+'..RECEIPT'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  WHERE TRANDATE BETWEEN '''+ @DateFrom +''' and ''' + @DateTo +''''"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+'  AND TRANTYPE=''PU'''"
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND COMPANYID IN (SELECT COMPANYID FROM #COMPANY)' "
        strSql += vbCrLf + "  SELECT @STRQRY =@STRQRY + ' AND ISNULL(CANCEL,'''') <> ''Y''' "
        strSql += vbCrLf + "  IF @LOCOUT='L'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @strQry =@strQry+'  AND ACCODE IN (SELECT ACCODE FROM '+@cnAdminDB+'..ACHEAD WHERE LOCALOUTST = ''L'')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @LOCOUT='O'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @strQry =@strQry+'  AND ACCODE IN (SELECT ACCODE FROM '+@cnAdminDB+'..ACHEAD WHERE LOCALOUTST = ''O'')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @ANAMENALL<>'ALL' AND @ANAMENALL<>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @strQry =@strQry+'  AND ACCODE=(SELECT ACCODE FROM  '+@cnAdminDB+'..ACHEAD WHERE ACNAME='''+ @AcName+''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @CNAMEALL<>'ALL' AND @CNAMEALL<>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @strQry =@strQry+'  AND CATCODE=(SELECT CATCODE FROM '+@cnAdminDB+'..CATEGORY  WHERE CATNAME='''+ @CatName +''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  IF @METNAMEALL<>'ALL' AND @METNAMEALL<>''"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	SELECT @strQry =@strQry+'  AND METALID=(SELECT METALID FROM '+@cnAdminDB+'..METALMAST  WHERE METALNAME='''+ @MetalName +''')'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- Execute Query */"
        strSql += vbCrLf + "  /* -- ============== */"
        strSql += vbCrLf + "  /* -- PRINT @STRQRY */"
        strSql += vbCrLf + "  EXEC SP_EXECUTESQL @strQry"
        strSql += vbCrLf + "  SELECT @strQry ='if(select 1 from MASTER..SYSOBJECTS WHERE NAME=''TEMP'+@SystemId+'PURCHASEVATRES1'')>0'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' drop table MASTER..TEMP'+@SystemId+'PURCHASEVATRES1'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' SELECT'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' SUM(PCS) PCS,SUM(GRSWT) GRSWT,SUM(NETWT) NETWT'"
        strSql += vbCrLf + "  IF @GroupBy='S'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SELECT @strQry =@strQry+',ISNULL((SELECT ACNAME FROM '+@cnAdminDB+'..ACHEAD WHERE ACCODE=X.ACCODE),'''') PARTYNAME'"
        strSql += vbCrLf + "  		SELECT @strQry =@strQry+',ISNULL((SELECT CASE WHEN LOCALTAXNO<>0 THEN LOCALTAXNO ELSE CENTRALTAXNO END FROM '+@cnAdminDB+'..ACHEAD WHERE ACCODE=X.ACCODE),0) VATNO'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  ELSE"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		SELECT @strQry =@strQry+','' ''PARTYNAME'"
        strSql += vbCrLf + "  		SELECT @strQry =@strQry+','' ''VATNO'"
        strSql += vbCrLf + "  	END "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',SUM(AMOUNT) AMOUNT,SUM(TAX) TAX,SUM(TOTAL) TOTAL,''1''RESULT'"
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  IF @ChkCat = 'Y'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		IF @GroupBy = 'S' "
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',CATEGORYNAME,CATCODE'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'M'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',TRANMONTH,CATEGORYNAME,TRANMONTHNO,CATCODE'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'D'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',CONVERT(VARCHAR,TRANDATE,103) BILLDATE,CATEGORYNAME,CATCODE,TRANDATE'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'B'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',CONVERT(VARCHAR,TRANNO) + CASE WHEN REMARK1 <> '''' THEN ''  [''+REMARK1+'']'' ELSE '''' END BILLNO,CATEGORYNAME,CATCODE,TRANNO'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  ELSE"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		IF @GroupBy = 'S' "
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',METALNAME,METALID'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'M'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',TRANMONTH,METALNAME,METALID,TRANMONTHNO'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'D'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',CONVERT(VARCHAR,TRANDATE,103) BILLDATE,METALNAME,METALID,TRANDATE'"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'B'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+',CONVERT(VARCHAR,TRANNO) + CASE WHEN REMARK1 <> '''' THEN ''  [''+REMARK1+'']'' ELSE '''' END BILLNO,METALNAME,METALID,TRANNO'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' INTO MASTER..TEMP'+@SystemId+'PURCHASEVATRES1'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' FROM'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' ('"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' SELECT'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' ACCODE,TRANNO,TRANDATE'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',LEFT(DATENAME(MONTH,TRANDATE),3)TRANMONTH'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',DATEPART(MONTH,TRANDATE)TRANMONTHNO'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',PCS,GRSWT,NETWT,AMOUNT,TAX,REMARK1'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',(AMOUNT+TAX) TOTAL'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',ISNULL((SELECT CATNAME FROM '+@cnAdminDB+'..CATEGORY WHERE CATCODE=P.CATCODE),'''') CATEGORYNAME'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',ISNULL((SELECT METALNAME FROM '+@cnAdminDB+'..METALMAST WHERE METALID=P.METALID),'''') METALNAME'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+',CATCODE,METALID'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' FROM MASTER..TEMP'+@SystemId+'PURCHASEVAT AS P'"
        strSql += vbCrLf + "  SELECT @strQry =@strQry+' )X'"
        strSql += vbCrLf + "  IF @ChkCat = 'Y'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		IF @GroupBy = 'S'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' GROUP BY ACCODE,CATEGORYNAME,CATCODE'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' ORDER BY CATEGORYNAME,CATCODE,PARTYNAME'"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'M'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' GROUP BY TRANMONTH,TRANMONTHNO,CATEGORYNAME,CATCODE'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' ORDER BY CATEGORYNAME,CATCODE,TRANMONTHNO,PARTYNAME'"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'D'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' GROUP BY TRANDATE,CATEGORYNAME,CATCODE'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' ORDER BY CATEGORYNAME,CATCODE,TRANDATE,PARTYNAME'"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE IF @GroupBy = 'B'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' GROUP BY TRANNO,CATEGORYNAME,CATCODE,REMARK1'"
        strSql += vbCrLf + "  			SELECT @strQry =@strQry+' ORDER BY CATEGORYNAME,CATCODE,TRANNO'"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	"
