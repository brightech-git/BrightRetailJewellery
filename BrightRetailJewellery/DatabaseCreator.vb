        strSql += vbCrLf + " 		SELECT @QRY=@QRY+ char(13)+ ' SELECT TRANDATE,''S''COLHEAD,22 RESULT,''CHR(12)'' FROM TEMPTABLEDB..TEMPCASHBOOK GROUP BY TRANDATE'"
        strSql += vbCrLf + "		PRINT @QRY"
        strSql += vbCrLf + " 		EXECUTE SP_EXECUTESQL @QRY"
