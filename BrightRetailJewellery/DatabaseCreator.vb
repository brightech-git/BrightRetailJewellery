    Public Function Decrypt_old(Pwd As String) As String
        Dim strDecryptPwd As String = Nothing
        Try
            For cnt As Integer = 1 To Len(Pwd)
                Dim IntAscii As Integer = 0
                IntAscii = (Asc(Strings.Mid(Pwd, cnt, 1)) - (cnt * 2) - 14)
                strDecryptPwd = strDecryptPwd & Chr(IntAscii)
            Next
        Catch ex As Exception
            MsgBox("ERROR :" & ex.Message & vbCrLf & vbCrLf & "POSITION :" & ex.StackTrace)
        End Try
        Return strDecryptPwd
    End Function

    Public Sub UpdatePwd_NewMethod(ByVal con As OleDbConnection, ByVal tran As OleDbTransaction, ByVal dbName As String, ByVal TableName As String, ByVal PwdColumn As String, ByVal RefColumn As String)
        Dim dt As New DataTable
        Dim Pwd_Old As String
        Dim Pwd_New_Encrypt As String
        cmd = New OleDbCommand("SELECT " + RefColumn + " REFCOLUMN,ISNULL(" + PwdColumn + ",'') PWD FROM " & dbName & ".." + TableName, con, tran)
        da = New OleDbDataAdapter(cmd)
        da.Fill(dt)
        If dt.Rows.Count > 0 Then
            For Each dr As DataRow In dt.Rows
                'Try
                Pwd_Old = Decrypt_old(dr.Item("PWD"))
                If Pwd_Old = Nothing Then
                    Pwd_Old = ""
                End If
                If Pwd_Old.Length() > 0 Then
                    Pwd_New_Encrypt = BrighttechPack.Methods.Encrypt(Pwd_Old)
                    Pwd_New_Encrypt = Pwd_New_Encrypt.Replace("'", "''")
                    'MsgBox(Pwd_Old + "   " + Pwd_New_Encrypt)
                    strSql = vbCrLf + " UPDATE " & dbName.ToString() & ".." & TableName.ToString() & " SET " + PwdColumn.ToString() + " = '" & Pwd_New_Encrypt.ToString() & "' WHERE " & RefColumn.ToString() & " =  '" + dr.Item("REFCOLUMN").ToString() + "' "
                    cmd = New OleDbCommand(strSql, con, tran)
                    cmd.ExecuteNonQuery()
                End If
            Next
        End If
    End Sub

    Public Function UserMaster_PwdUpdate()
        Try
            Dim dbc As DatabaseCreator = New DatabaseCreator()

            tran = cn.BeginTransaction()
            If GetAdmindbSoftValueNew("NEWPWD_UPDATE", cn, "N", tran).ToString = "N" Then
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "USERMASTER", "PWD", "USERID")
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "USERMASTER", "AUTHPWD", "USERID")
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "EMPMASTER", "PASSWORD", "EMPID")
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "DISCAUTHORIZE", "PASSWORD", "EMPID")
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "CASHCOUNTER", "PASSWORD", "CASHID")
                UpdatePwd_NewMethod(cn, tran, cnAdminDb, "SYNCCOSTCENTRE", "PASSWORD", "COSTID")
                'dbc.UpdatePwd_NewMethod(cn, tran, cnAdminDb, "PWDMASTER", "PASSWORD", "PWDID")
                strSql = "UPDATE " & cnAdminDb & "..SOFTCONTROL SET CTLTEXT='Y' WHERE CTLID='NEWPWD_UPDATE'"
                cmd = New OleDbCommand(strSql, cn, tran) : cmd.ExecuteNonQuery()
            End If
            tran.Commit()
            tran.Dispose()
        Catch ex As Exception
            tran.Rollback()
            tran.Dispose()
            MessageBox.Show(ex.Message.ToString())
        End Try
    End Function
    Private Sub AKSCDM_TRIG_PERSONALINFO(ByVal akscdmDbName As String, ByVal cnAks As OleDbConnection)
        strSql = " IF (SELECT 1 FROM " & akscdmDbName & "..SYSOBJECTS WHERE XTYPE = 'TR' AND NAME = 'AKSCDM_TRIG_PERSONALINFO')>0"
        strSql += vbCrLf + "  DROP TRIGGER AKSCDM_TRIG_PERSONALINFO"
        cmd = New OleDbCommand(strSql, cnAks)
        cmd.ExecuteNonQuery()
        strSql = ""
        strSql += vbCrLf + " CREATE TRIGGER [dbo].[AKSCDM_TRIG_PERSONALINFO] ON [dbo].[PERSONALINFO]"
        strSql += vbCrLf + " AFTER  INSERT,UPDATE"
        strSql += vbCrLf + " AS"
