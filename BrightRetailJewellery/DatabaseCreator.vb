        strSql += vbCrLf + "  		END "
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' CASE WHEN I.TRANTYPE=''RD'' THEN ''REPAIR DELIVERY''ELSE ''SALES'' END AS VOUCHERTYPE,P.ACCODE PARTYCODE,PNAME PARTYNAME,'' '' PARTYGROUP,ISNULL(P.GSTNO,'''')GSTNO,'  "
