        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' ELSE R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' END ELSE'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' R.AMOUNT-ISNULL((SELECT SUM(STNAMT) FROM RECEIPTSTONE WHERE ISSSNO = R.SNO),0)'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' END AMOUNT,'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY + CHAR(13)+ ' CASE WHEN ISNULL(H.LOCALOUTST,'''')=''O'' THEN 0 ELSE'"
