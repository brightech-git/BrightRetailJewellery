        strSql += vbCrLf + "  			SELECT @QRY = @QRY +CHAR(13)+'UPDATE TEMPTABLEDB..TEMPGSTRPT SET AMOUNT=CONVERT(NUMERIC(15,2),(GNETAMOUNT-(STAX+CTAX+ITAX)))WHERE AMOUNT=0'"
