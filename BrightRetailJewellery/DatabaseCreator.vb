        strSql += vbCrLf + "          		 ELSE  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY =' SELECT PARTICULAR, '  "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'  SUM(CONVERT(INT,OTAGS)) OTAGS,SUM(CONVERT(INT,OPCS)) OPCS,SUM(OGRSWT) OGRSWT,SUM(ONETWT) ONETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(OEXTRAWT) OEXTRAWT,SUM(OTAGWT) OTAGWT,SUM(OCOVERWT) OCOVERWT'"
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   ,(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)OBOXWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(OGRSWT)+ISNULL(SUM(OTAGWT),0)+ISNULL(SUM(OCOVERWT),0) '"
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   +(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   AS OTOTWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,ODIAPCS)) ODIAPCS,SUM(ODIAWT) ODIAWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,OSTNPCS)) OSTNPCS,SUM(OSTNCRWT) OSTNCRWT,SUM(OSTNGRWT) OSTNGRWT,SUM(OVALUE) OVALUE,SUM(CONVERT(DECIMAL(15,2),OSALVALUE)) OSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPOTAGS)) APPOTAGS,SUM(CONVERT(INT,APPOPCS)) APPOPCS,SUM(APPOGRSWT) APPOGRSWT,SUM(APPONETWT) APPONETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(APPOEXTRAWT) APPOEXTRAWT,SUM(APPOTAGWT) APPOTAGWT,SUM(APPOCOVERWT) APPOCOVERWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPODIAPCS)) APPODIAPCS,SUM(APPODIAWT) APPODIAWT,SUM(CONVERT(INT,APPOSTNPCS)) APPOSTNPCS,SUM(APPOSTNCRWT) APPOSTNCRWT,SUM(APPOSTNGRWT) APPOSTNGRWT,SUM(APPOVALUE) APPOVALUE,SUM(CONVERT(DECIMAL(15,2),APPOSALVALUE)) APPOSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,RTAGS)) RTAGS,SUM(CONVERT(INT,RPCS)) RPCS,SUM(RGRSWT) RGRSWT,SUM(RNETWT) RNETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(REXTRAWT) REXTRAWT,SUM(RTAGWT) RTAGWT,SUM(RCOVERWT) RCOVERWT'  "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   ,(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)IBOXWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(RGRSWT)+ISNULL(SUM(RTAGWT),0)+ISNULL(SUM(RCOVERWT),0) '"
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   +(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   AS RTOTWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,RDIAPCS)) RDIAPCS,SUM(RDIAWT) RDIAWT,SUM(CONVERT(INT,RSTNPCS)) RSTNPCS,SUM(RSTNCRWT) RSTNCRWT,SUM(RSTNGRWT) RSTNGRWT,SUM(RVALUE) RVALUE,SUM(CONVERT(DECIMAL(15,2),RSALVALUE)) RSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,ARRTAGS)) ARRTAGS,SUM(CONVERT(INT,ARRPCS)) ARRPCS,SUM(ARRGRSWT) ARRGRSWT,SUM(ARRNETWT) ARRNETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(ARREXTRAWT) ARREXTRAWT,SUM(ARRTAGWT) ARRTAGWT,SUM(ARRCOVERWT) ARRCOVERWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,ARRDIAPCS)) ARRDIAPCS,SUM(ARRDIAWT)ARRDIAWT,SUM(CONVERT(INT,ARRSTNPCS)) ARRSTNPCS,SUM(ARRSTNCRWT) ARRSTNCRWT,SUM(ARRSTNGRWT) ARRSTNGRWT,SUM(ARRVALUE) ARRVALUE,SUM(CONVERT(DECIMAL(15,2),ARRSALVALUE))ARRSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,ITAGS)) ITAGS,SUM(CONVERT(INT,IPCS)) IPCS,SUM(IGRSWT)IGRSWT,SUM(INETWT) INETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(IEXTRAWT) IEXTRAWT,SUM(ITAGWT) ITAGWT,SUM(ICOVERWT) ICOVERWT'  "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   ,(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)RBOXWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(IGRSWT)+ISNULL(SUM(ITAGWT),0)+ISNULL(SUM(ICOVERWT),0) '"
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   +(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   AS ITOTWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,IDIAPCS)) IDIAPCS,SUM(IDIAWT) IDIAWT,SUM(CONVERT(INT,ISTNPCS)) ISTNPCS,SUM(ISTNCRWT) ISTNCRWT,SUM(ISTNGRWT) ISTNGRWT,SUM(IVALUE) IVALUE,SUM(CONVERT(DECIMAL(15,2),ISALVALUE)) ISALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,AIITAGS)) AIITAGS,SUM(CONVERT(INT,AIIPCS)) AIIPCS,SUM(AIIGRSWT) AIIGRSWT,SUM(AIINETWT) AIINETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(AIIEXTRAWT) AIIEXTRAWT,SUM(AIITAGWT) AIITAGWT,SUM(AIICOVERWT) AIICOVERWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,AIIDIAPCS)) AIIDIAPCS,SUM(AIIDIAWT) AIIDIAWT,SUM(CONVERT(INT,AIISTNPCS)) AIISTNPCS,SUM(AIISTNCRWT) AIISTNCRWT,SUM(AIISTNGRWT) AIISTNGRWT,SUM(AIIVALUE) AIIVALUE,SUM(CONVERT(DECIMAL(15,2),AIISALVALUE)) AIISALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,CTAGS)) CTAGS,SUM(CONVERT(INT,CPCS)) CPCS,SUM(CGRSWT) CGRSWT,SUM(CNETWT) CNETWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CEXTRAWT) CEXTRAWT,SUM(CTAGWT) CTAGWT,SUM(CCOVERWT) CCOVERWT'  "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   ,(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)CBOXWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CGRSWT)+ISNULL(SUM(CTAGWT),0)+ISNULL(SUM(CCOVERWT),0) '"
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'"
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'   +(SELECT ISNULL(SUM(WEIGHT),0) FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   AS CTOTWT'"
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,CDIAPCS)) CDIAPCS,SUM(CDIAWT) CDIAWT,SUM(CONVERT(INT,CSTNPCS)) CSTNPCS,SUM(CSTNCRWT) CSTNCRWT,SUM(CSTNGRWT) CSTNGRWT,SUM(CVALUE) CVALUE,SUM(CONVERT(DECIMAL(15,2),CSALVALUE)) CSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPCTAGS)) APPCTAGS,SUM(CONVERT(INT,APPCPCS)) APPCPCS,SUM(APPCGRSWT) APPCGRSWT,SUM(APPCNETWT) APPCNETWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(APPCEXTRAWT) APPCEXTRAWT,SUM(APPCTAGWT) APPCTAGWT,SUM(APPCCOVERWT) APPCCOVERWT '  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,APPCDIAPCS)) APPCDIAPCS,SUM(APPCDIAWT) APPCDIAWT,SUM(CONVERT(INT,APPCSTNPCS)) APPCSTNPCS,SUM(APPCSTNCRWT) APPCSTNCRWT,SUM(APPCSTNGRWT) APPCSTNGRWT,SUM(APPCVALUE) APPCVALUE,SUM(CONVERT(DECIMAL(15,2),APPCSALVALUE))APPCSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,PTAGS)) PTAGS,SUM(CONVERT(INT,PPCS)) PPCS,SUM(PGRSWT) PGRSWT,SUM(PNETWT) PNETWT '  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(PEXTRAWT) PEXTRAWT'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   ,SUM(CONVERT(INT,PDIAPCS)) PDIAPCS,SUM(PDIAWT) PDIAWT,SUM(CONVERT(INT,PSTNPCS)) PSTNPCS,SUM(PSTNCRWT) PSTNCRWT,SUM(PSTNGRWT) PSTNGRWT,SUM(PVALUE) PVALUE,SUM(CONVERT(DECIMAL(15,2),PSALVALUE))PSALVALUE'  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'   '  "
        strSql += vbCrLf + "          		 SELECT @QRY= @QRY+CHAR(13)+'    FROM TEMPTABLEDB..TEMP' + @SYSTEMID + 'ITEMSTK AS T'  "
        strSql += vbCrLf + "      			 IF @SPECIFICFORMAT='1'"
        strSql += vbCrLf + "          		 BEGIN "
        strSql += vbCrLf + "          		    SELECT @QRY= @QRY+CHAR(13)+'    WHERE ISNULL(STONE,0)=0 ' "
        strSql += vbCrLf + "          		 END "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CO'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY COSTCENTRE'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "              	SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY COUNTER'  "
        strSql += vbCrLf + "                      IF @WITHDIA='Y' AND @WITHSTONE='Y'"
        strSql += vbCrLf + "                      BEGIN"
        strSql += vbCrLf + "             	        SELECT @QRY= @QRY+CHAR(13)+',DIASTONE'"
        strSql += vbCrLf + "                      END"
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'IT'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY ITEMTYPE'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "        			 ELSE IF @GROUPBY = 'ME'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY METALNAME'  "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "      		 ELSE IF @GROUPBY ='HM'  /*HALLMARKWISE*/"
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY WITHHUID'   "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'DE'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY DESIGNER'  "
        strSql += vbCrLf + "          		 END"
        strSql += vbCrLf + "          		 ELSE IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY CGROUP,TCGROUP'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + " 				  ELSE IF @GROUPBY = 'SG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY SGROUP'  "
        strSql += vbCrLf + "          		 END    "
        strSql += vbCrLf + "          		 ELSE  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  GROUP BY PARTICULAR'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CU'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "                     SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY COUNTER,(SELECT DISPLAYORDER FROM ITEMCOUNTER WHERE ITEMCTRNAME=T.COUNTER)'  "
        strSql += vbCrLf + "                     IF @WITHDIA='Y' AND @WITHSTONE='Y'"
        strSql += vbCrLf + "                      BEGIN"
        strSql += vbCrLf + "             	        SELECT @QRY= @QRY+CHAR(13)+',DIASTONE'"
        strSql += vbCrLf + "                      END"
        strSql += vbCrLf + "          		 END "
        strSql += vbCrLf + "          		 IF @GROUPBY = 'CG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT DISPORDER FROM ITEMGROUPMAST WHERE GROUPNAME=T.CGROUP),COUNTERGROUP'  "
        strSql += vbCrLf + "          		 END  "
        strSql += vbCrLf + " 				  IF @GROUPBY = 'SG'  "
        strSql += vbCrLf + "          		 BEGIN  "
        strSql += vbCrLf + "          			SELECT @QRY= @QRY+CHAR(13)+'  ORDER BY (SELECT SGROUPNAME FROM SUBITEMGROUP WHERE SGROUPNAME=T.SGROUP),SUBITEMGROUP'  "
        strSql += vbCrLf + "          		 END  "

        strSql += vbCrLf + "          		 PRINT @QRY  "
        strSql += vbCrLf + "          		 EXEC (@QRY)  "
        strSql += vbCrLf + "          	END  "
        strSql += vbCrLf + "          END "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP_SP_SYNC_GENERATE()
        Dim SyncCompId As String
        strSql = "SELECT COMPANYID FROM COMPANY"
        SyncCompId = GetSqlValue(strSql, compId, tran)

        strSql = vbCrLf + " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_SYNC_GENERATE')>0"
        strSql += vbCrLf + " DROP PROCEDURE SP_SYNC_GENERATE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + "CREATE PROCEDURE SP_SYNC_GENERATE ("
        strSql += vbCrLf + "@FROMID VARCHAR(5), @QRY VARCHAR(3000),@MODE VARCHAR(1))"
        strSql += vbCrLf + "AS"
        strSql += vbCrLf + "BEGIN"
        strSql += vbCrLf + "    DECLARE @TOID NVARCHAR(5)"
        strSql += vbCrLf + "    DECLARE @SQLQRY NVARCHAR(4000)"
        strSql += vbCrLf + "    DECLARE @SYNC_ACTIVE VARCHAR(1)"
        strSql += vbCrLf + "    DECLARE @SYNC_DBYN VARCHAR(1)"
        strSql += vbCrLf + "    DECLARE @SYNC_DB VARCHAR(20)"
        strSql += vbCrLf + "    SET @SYNC_DB = '" & compId & "ADMINDB'"
        strSql += vbCrLf + "    SELECT @SYNC_ACTIVE= ISNULL(CTLTEXT,'') FROM SOFTCONTROL WHERE CTLID ='" & SyncCompId & "_SYNC' "
        strSql += vbCrLf + "    IF @SYNC_ACTIVE='' "
        strSql += vbCrLf + "        SET @SYNC_ACTIVE='Y'"
        strSql += vbCrLf + "    SELECT @SYNC_DBYN= CTLTEXT FROM SOFTCONTROL WHERE CTLID ='SYNC-SEPDATADB' "
        strSql += vbCrLf + "    IF @SYNC_ACTIVE='Y' "
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        SET @TOID = ''"
        strSql += vbCrLf + "        IF @SYNC_DBYN = 'Y' SET @SYNC_DB = '" & compId & "UTILDB'"
        strSql += vbCrLf + "        IF @MODE='T' SELECT @TOID= CTLTEXT FROM SOFTCONTROL WHERE CTLID ='SYNC-TO' "
        strSql += vbCrLf + "        IF @QRY <> '''' SET @QRY = REPLACE(@QRY,'''','''''')"
        strSql += vbCrLf + "        IF @MODE='T'"
        strSql += vbCrLf + "        BEGIN"
        strSql += vbCrLf + "            IF @TOID <> ''"
        strSql += vbCrLf + "            BEGIN"
        strSql += vbCrLf + "                SELECT @SQLQRY = 'INSERT INTO '+@SYNC_DB+'..SENDSYNC (FROMID,TOID,SQLTEXT,STATUS) SELECT '''+@FROMID+''',COSTID,'''+@QRY+''',''N'' FROM SYNCCOSTCENTRE WHERE ISNULL(ACTIVE,''Y'')<>''N'' AND COSTID <> '''+@FROMID +''' '"
        strSql += vbCrLf + "                SELECT @SQLQRY = @SQLQRY+ ' AND COSTID='''+@TOID+''''"
        strSql += vbCrLf + "                PRINT @SQLQRY"
        strSql += vbCrLf + "                EXECUTE SP_EXECUTESQL @SQLQRY"
        strSql += vbCrLf + "            END"
        strSql += vbCrLf + "        END"
        strSql += vbCrLf + "        IF @MODE='M'"
        strSql += vbCrLf + "        BEGIN"
        strSql += vbCrLf + "            SELECT @SQLQRY = 'INSERT INTO '+@SYNC_DB+'..SENDSYNC (FROMID,TOID,SQLTEXT,STATUS) SELECT '''+@FROMID+''',COSTID,'''+@QRY+''',''N'' FROM SYNCCOSTCENTRE WHERE ISNULL(ACTIVE,''Y'')<>''N'' AND COSTID <> '''+@FROMID +''''"
        strSql += vbCrLf + "            PRINT @SQLQRY"
        strSql += vbCrLf + "            EXECUTE SP_EXECUTESQL @SQLQRY"
        strSql += vbCrLf + "        END"
        strSql += vbCrLf + "    END"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSP_InsertAcctran()
