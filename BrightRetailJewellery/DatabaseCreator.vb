        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ALLOYDETAILS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE procedure Sp_RPT_ALLOYDETAILS"
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@BMETAL VARCHAR(50), @AMETAL VARCHAR(50), @COSTCENTRE VARCHAR(300),@TRANTYPE varchar(1)"
        strSql += vbCrLf + " as"
        strSql += vbCrLf + " SET NOCOUNT ON    "
        strSql += vbCrLf + " CREATE TABLE #COSTCENTRE(COSTID VARCHAR(5))"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '" & tranDbName & "..TEMPCST',@INPUTVALUES=@COSTCENTRE,@DEF_VAL=',0'"
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM " & tranDbName & "..TEMPCST"
        strSql += vbCrLf + " DROP TABLE " & tranDbName & "..TEMPCST"
        strSql += vbCrLf + " create table #temp"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " tranno int,"
        strSql += vbCrLf + " TRANDATE SMALLDATETIME,"
        strSql += vbCrLf + " METAL  varchar (20),"
        strSql += vbCrLf + " party varchar(100),"
        strSql += vbCrLf + " GRSWT numeric(18,3),"
        strSql += vbCrLf + " WEIGHT numeric(18,3),"
        strSql += vbCrLf + " CATNAME varchar(100),"
        strSql += vbCrLf + " RESULT int,"
        strSql += vbCrLf + " COLHEAD VARCHAR(3)"
        strSql += vbCrLf + " )"

        strSql += vbCrLf + " declare @QRY varchar(8000)  "
        strSql += vbCrLf + " set @QRY =  ' insert into #temp (TRANNO ,TRANDATE ,METAL ,PARTY,GRSWT,WEIGHT,CATNAME )  "
        strSql += vbCrLf + " select TRANNO,TRANDATE,METAL,PARTY,GRSWT,WEIGHT,CATNAME FROM   "
        strSql += vbCrLf + " (select TRANNO,TRANDATE,METAL,PARTY,SUM(GRSWT) GRSWT,SUM(WEIGHT) WEIGHT,CATNAME FROM '  "
        strSql += vbCrLf + " set @QRY = @QRY +  ' (select R.TRANNO  "
        strSql += vbCrLf + " ,R.TRANDATE  "
        strSql += vbCrLf + " ,case when isnull(M.METALNAME,'''') <> '''' then M.METALNAME else M2.METALNAME END METAL  "
        strSql += vbCrLf + " ,isnull(case when isnull(A.ACname ,'''')<>'''' then A.ACNAME else P.PNAME END,'''') PARTY  "
        strSql += vbCrLf + " ,R.GRSWT"
        strSql += vbCrLf + " ,AD.WEIGHT   "
        strSql += vbCrLf + " ,isnull(C.CATNAME,'''') CATNAME  "
        strSql += vbCrLf + " from " & tranDbName & "..RECEIPT R  "
        strSql += vbCrLf + " inner join " & tranDbName & "..ALLOYDETAILS AD ON AD.ISSSNO =R.SNO   "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..ITEMMAST I ON R.ITEMID =I.ITEMID   "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..METALMAST M ON M.METALID =I.METALID    "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..CATEGORY C on R.CATCODE =C.CATCODE   "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..PURITYMAST PU ON C.PURITYID  =PU.PURITYID    "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..METALMAST M2 ON M2.METALID=PU.METALID  "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..ACHEAD A ON R.ACCODE =A.ACCODE   "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..CUSTOMERINFO CI ON R.BATCHNO =CI.BATCHNO   "
        strSql += vbCrLf + " left join " & compId & "ADMINDB..PERSONALINFO P ON P.SNO =CI.PSNO   "
        strSql += vbCrLf + " where R.TRANDATE between '''+ convert(varchar(20),@FROMDATE,20)  + ''' and ''' + convert(varchar(20),@TODATE,20) +''' and isnull(R.cancel,'''')='''' and R.costID in (select costid from #COSTCENTRE)'  "
        strSql += vbCrLf + " if @AMETAL <>'ALL' and @AMETAL<>''  "
        strSql += vbCrLf + " set @QRY = @QRY +  ' and AD.ALLOYID in (select METALID from " & compId & "ADMINDB..METALMAST where metalname in ('''+ REPLACE(@AMETAL,',',''',''') +'''))'  "
        strSql += vbCrLf + " set @QRY = @QRY +  ' and AD.TRANTYPE like '''+@TRANTYPE +'%'' '  "
        strSql += vbCrLf + " set @QRY = @QRY +  ' ) Y where 1=1'  "
        strSql += vbCrLf + " if @BMETAL<>'ALL' and @BMETAL<>''  "
        strSql += vbCrLf + " set @QRY = @QRY +  ' and y.METAL in ('''+ REPLACE(@BMETAL,',',''',''') +''')'   "
        strSql += vbCrLf + " set @QRY = @QRY +  ' group by TRANNO ,TRANDATE ,METAL ,PARTY ,CATNAME ) Z'   "
        strSql += vbCrLf + " if @TRANTYPE ='I'   "
        strSql += vbCrLf + " set @qry = REPLACE(@qry,'..RECEIPT','..ISSUE')  "
        strSql += vbCrLf + " print (@qry)  "
        strSql += vbCrLf + " Exec (@QRY)  "
        strSql += vbCrLf + " --  insert into  #temp  select NULL TRANNO ,null TRANDATE ,'TOTAL' METAL ,null PARTY , sum(weight) weight,NULL CATNAME,1,'G'  from  #temp   "
        strSql += vbCrLf + " if OBJECT_ID('" & tranDbName & "..TEMPALLOYDETAILS') IS NOT NULL DROP TABLE " & tranDbName & "..TEMPALLOYDETAILS  "
        strSql += vbCrLf + " select * into " & tranDbName & "..TEMPALLOYDETAILS from #temp  order by RESULT,trandate,tranno"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_WASTAGEDETAILS()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_WASTAGEDETAILS')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_WASTAGEDETAILS"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE procedure Sp_RPT_WASTAGEDETAILS"
        strSql += vbCrLf + " @FROMDATE SMALLDATETIME,@TODATE SMALLDATETIME,@METAL VARCHAR(30), @TRANTYPE VARCHAR(1),@MTYPE VARCHAR(1),@COSTCENTRE VARCHAR(300),@DPUR VARCHAR(1)"
        strSql += vbCrLf + " as"
        strSql += vbCrLf + " SET NOCOUNT ON    "
        strSql += vbCrLf + " /* "
        strSql += vbCrLf + " EXEC Sp_RPT_WASTAGEDETAILS @FROMDATE ='2011-04-01',@TODATE ='2011-10-20',@METAL ='GOLD', @TRANTYPE ='R',@MTYPE ='B',@COSTCENTRE ='ALL',@DPUR ='N'"
        strSql += vbCrLf + " */"
        strSql += vbCrLf + " CREATE TABLE #COSTCENTRE(COSTID VARCHAR(5))"
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '" & tranDbName & "..TEMPCST',@INPUTVALUES =@COSTCENTRE,@DEF_VAL=',0'"
        strSql += vbCrLf + " INSERT INTO #COSTCENTRE(COSTID) SELECT COSTID FROM " & tranDbName & "..TEMPCST"
        strSql += vbCrLf + " DROP TABLE " & tranDbName & "..TEMPCST"

        strSql += vbCrLf + " create table #temp"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " tranno int,"
        strSql += vbCrLf + " TRANDATE SMALLDATETIME,"
        strSql += vbCrLf + " METAL  varchar (20),"
        strSql += vbCrLf + " party varchar(100),"
        strSql += vbCrLf + " Wastage numeric(18,3),"
        strSql += vbCrLf + " WEIGHT numeric(18,3),"
        strSql += vbCrLf + " RESULT int,"
        strSql += vbCrLf + " COLHEAD VARCHAR(3)"
        strSql += vbCrLf + " )"

        strSql += vbCrLf + " declare @QRY varchar(8000)"
        strSql += vbCrLf + " 	set @QRY =  ' insert into #temp (TRANNO ,TRANDATE ,METAL ,PARTY ,WASTAGE ,weight )"
        strSql += vbCrLf + " 				  select TRANNO ,TRANDATE ,METAL ,PARTY ,WASTAGE ,weight  from '"
        strSql += vbCrLf + " 	set @QRY = @QRY + ' ('"
        strSql += vbCrLf + " 	set @QRY = @QRY +  ' select R.TRANNO"
        strSql += vbCrLf + " 				,R.TRANDATE"
        strSql += vbCrLf + " 				,case when isnull(M.METALNAME,'''') <> '''' then M.METALNAME else M2.METALNAME END METAL"
        strSql += vbCrLf + " 				,case when isnull(A.ACname ,'''')<>'''' then A.ACNAME else P.PNAME END PARTY"
        strSql += vbCrLf + " 				,R.WASTAGE"
        strSql += vbCrLf + " 				,case when R.NETWT = 0 then R.GRSWT else NETWT end weight "
        strSql += vbCrLf + " 				,case when ISNULL(FLAG,'''') <>'''' then FLAG ELSE PU.METALTYPE END METALTYPE"
        strSql += vbCrLf + " 				from " & tranDbName & "..RECEIPT R"
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..ITEMMAST I ON R.ITEMID =I.ITEMID "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..METALMAST M ON M.METALID =I.METALID  "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..CATEGORY C on R.CATCODE =C.CATCODE "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..PURITYMAST PU ON C.PURITYID  =PU.PURITYID  "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..METALMAST M2 ON M2.METALID=PU.METALID"
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..ACHEAD A ON R.ACCODE =A.ACCODE "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..CUSTOMERINFO CI ON R.BATCHNO =CI.BATCHNO "
        strSql += vbCrLf + " 				left join " & compId & "ADMINDB..PERSONALINFO P ON P.SNO =CI.PSNO "
        strSql += vbCrLf + " 				where R.trandate between '''+ convert(varchar(20),@FROMDATE,20)  + ''' and ''' + convert(varchar(20),@TODATE,20) +''' and isnull(R.cancel,'''')='''' and R.WASTAGE >0 and LEN(R.TRANTYPE)>2 and R.costID in (select costid from #COSTCENTRE)'"
        strSql += vbCrLf + " 	if @DPUR ='N' "
        strSql += vbCrLf + " 			set @QRY = @QRY +  ' and R.trantype<>'''+ @TRANTYPE +'PU''' "
        strSql += vbCrLf + " 	set @QRY = @QRY +  ' ) Y where 1=1'"
        strSql += vbCrLf + " 	if @METAL<>'ALL' and  @METAL<>''"
        strSql += vbCrLf + " 		set @QRY = @QRY +  ' and y.METAL in ('''+ REPLACE(@METAL,',',''',''') +''')'	"
        strSql += vbCrLf + " 	if @MTYPE ='B'"
        strSql += vbCrLf + " 		set @QRY = @QRY +  ' and METALTYPE in(''O'',''M'')'	"
        strSql += vbCrLf + " 	else "
        strSql += vbCrLf + " 		set @QRY = @QRY +  ' and METALTYPE ='''+ @MTYPE +''''	"
        strSql += vbCrLf + " 	if @TRANTYPE='I' "
        strSql += vbCrLf + " 		set @QRY = REPLACE(@QRY ,'..RECEIPT', '..ISSUE')"
        strSql += vbCrLf + " 	print (@qry)"
        strSql += vbCrLf + " 	Exec (@QRY)"
        strSql += vbCrLf + " 	insert into  #temp  select NULL TRANNO ,null TRANDATE ,'TOTAL' METAL ,null PARTY ,sum(WASTAGE) WASTAGE , sum(weight) weight,1,'G'  from  #temp "
        strSql += vbCrLf + " 	if object_id('" & tranDbName & "..TEMPWASTAGEDETS') IS NOT NULL DROP TABLE " & tranDbName & "..TEMPWASTAGEDETS"
        strSql += vbCrLf + " 	select * INTO " & tranDbName & "..TEMPWASTAGEDETS from #temp order by RESULT,trandate,tranno"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_SAL_DIFFERENCE()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_SAL_DIFFERENCE')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_SAL_DIFFERENCE"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = "    CREATE PROCEDURE [dbo].[SP_RPT_SAL_DIFFERENCE]"
        strSql += vbCrLf + "           @FROMDATE VARCHAR(20),@TODATE VARCHAR(20),@METAL VARCHAR(300),@COSTCENTRE VARCHAR(300),@BILLNO VARCHAR(20),@BILLTOTAL VARCHAR(1),@BILLGRP VARCHAR(1),@CATGRP VARCHAR(1),@SUMMARY VARCHAR(1)"
        strSql += vbCrLf + "           AS"
        strSql += vbCrLf + "           SET NOCOUNT ON"
        strSql += vbCrLf + "           IF OBJECT_ID('TEMPTABLEDB..TEMPSALDIFF') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPSALDIFF"
        strSql += vbCrLf + "           IF OBJECT_ID('TEMPTABLEDB..COSTCENTRE') IS NOT NULL DROP TABLE TEMPTABLEDB..COSTCENTRE"
        strSql += vbCrLf + "           CREATE TABLE TEMPTABLEDB..COSTCENTRE(COSTID VARCHAR(5))"
        strSql += vbCrLf + "           EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FIELD = 'COSTNAME',@OUTPUT_FIELD='COSTID',@RESULT_TBL = '" & tranDbName & "..TEMPCST',@INPUTVALUES =@COSTCENTRE,@DEF_VAL=',0'"
        strSql += vbCrLf + "           INSERT INTO TEMPTABLEDB..COSTCENTRE(COSTID) SELECT COSTID FROM " & tranDbName & "..TEMPCST"
        strSql += vbCrLf + "           DROP TABLE " & tranDbName & "..TEMPCST"
        strSql += vbCrLf + "           IF OBJECT_ID('TEMPTABLEDB..METAL') IS NOT NULL DROP TABLE TEMPTABLEDB..METAL"
        strSql += vbCrLf + "           CREATE TABLE TEMPTABLEDB..METAL(METAL VARCHAR(25))"
        strSql += vbCrLf + "           EXEC " & tranDbName & "..SP_SPLITVALUES_NEW @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'METALMAST',@CHK_FIELD = 'METALNAME',@OUTPUT_FIELD='METALNAME',@RESULT_TBL = '" & tranDbName & "..TEMPMTL',@INPUTVALUES =@METAL "
        strSql += vbCrLf + "           INSERT INTO TEMPTABLEDB..METAL SELECT METALNAME FROM " & tranDbName & "..TEMPMTL"
        strSql += vbCrLf + "           DROP TABLE " & tranDbName & "..TEMPMTL"
        strSql += vbCrLf + "           DECLARE @QRY NVARCHAR(4000)"
        strSql += vbCrLf + "           IF OBJECT_ID('TEMPTABLEDB..TMP_DIFFERRENCE') IS NOT NULL DROP TABLE TEMPTABLEDB..TMP_DIFFERRENCE"
        strSql += vbCrLf + "           CREATE TABLE TEMPTABLEDB..TMP_DIFFERRENCE( SNO VARCHAR(15),TRANNO INT,BILLNO1 VARCHAR(20),"
        strSql += vbCrLf + "           TRANDATE SMALLDATETIME,ITEMID INT,SUBITEMID INT,PRODUCTNAME VARCHAR(50),"
        strSql += vbCrLf + "           SALWT NUMERIC(12,3),PCS INT,TAGNO VARCHAR(12),RATE NUMERIC(15,2),DISCOUNT NUMERIC(15,2),METALID VARCHAR(100),CATCODE VARCHAR(12),TRANTYPE VARCHAR(3),"
        strSql += vbCrLf + "           COSTID VARCHAR(2),VALADDTYPE VARCHAR(2),SALVALUE NUMERIC(15,2),TABLECODE VARCHAR(4),"
        strSql += vbCrLf + "           TAGDESIGNER VARCHAR(7),ITEMTYPEID INT,STOCKTYPE VARCHAR(1),ITEMCTRID INT,"
        strSql += vbCrLf + "           MAXWASTPER NUMERIC(15,2),MAXMCGRM NUMERIC(15,2),MAXWAST NUMERIC(12,3),"
        strSql += vbCrLf + "           MAXMC NUMERIC(15,2),WASTAGE NUMERIC(12,3),TAGWT NUMERIC(12,3),TAGTOT NUMERIC(12,3),SALWASTAGE NUMERIC(12,3),MC NUMERIC(15,2),TAGMC NUMERIC(15,2),STNAMT NUMERIC(15,2),"
        strSql += vbCrLf + "           TAGVALUE NUMERIC(15,2),RESULT int,COLHEAD VARCHAR(3),NARRATION VARCHAR(250),CHIT VARCHAR(250))"
        strSql += vbCrLf + "           DECLARE @MCWITHWASTAGE VARCHAR(1); "
        strSql += vbCrLf + "           SELECT @MCWITHWASTAGE=CASE WHEN ISNULL(CTLTEXT,'N') <>'' THEN ISNULL(CTLTEXT,'N')  ELSE 'N' END  FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'MCWITHWASTAGE'"
        strSql += vbCrLf + "           DECLARE @CHITDB VARCHAR(30); "
        strSql += vbCrLf + "           SELECT @CHITDB = ISNULL(CTLTEXT,'')  FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'CHITDBPREFIX'"
        strSql += vbCrLf + "           SELECT @QRY='INSERT INTO TEMPTABLEDB..TMP_DIFFERRENCE (SNO,TRANNO,BILLNO1,TRANDATE,ITEMID,SUBITEMID'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,PRODUCTNAME,SALWT,SALWASTAGE,PCS,TAGNO,RATE,COSTID,VALADDTYPE,SALVALUE'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,TABLECODE,TAGDESIGNER,ITEMTYPEID,STOCKTYPE,ITEMCTRID,DISCOUNT,METALID,CATCODE,TRANTYPE,NARRATION,CHIT, TAGWT)'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' SELECT I.SNO,I.TRANNO BILLNO,I.TRANNO AS BILLNO1,I.TRANDATE '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,I.ITEMID,I.SUBITEMID '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN ISNULL(S.SUBITEMNAME,'''')='''' THEN M.ITEMNAME ELSE S.SUBITEMNAME END PRODUCTNAME '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN I.GRSNET =''G'' THEN I.GRSWT ELSE I.NETWT END SALWT,WASTAGE'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,I.PCS ,I.TAGNO,I.RATE,I.COSTID '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN ISNULL(T.VALUEADDEDTYPE ,'''')='''' THEN M.VALUEADDEDTYPE ELSE T.VALUEADDEDTYPE END VALUEADDEDTYPE'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN I.TRANTYPE = ''RD'' THEN I.MCHARGE  ELSE ISNULL(I.AMOUNT,0)+ISNULL(I.FIN_DISCOUNT,0)END AS SALVALUE '"
        strSql += vbCrLf + "           /*SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL(I.AMOUNT,0)+ISNULL(I.FIN_DISCOUNT,0) SALVALUE, I.TABLECODE,I.TAGDESIGNER,I.ITEMTYPEID'*/"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,I.TABLECODE,I.TAGDESIGNER,I.ITEMTYPEID'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,M.STOCKTYPE ,I.ITEMCTRID '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,ISNULL(I.DISCOUNT,0)+ISNULL(I.FIN_DISCOUNT,0)DISCOUNT,I.METALID,I.CATCODE,I.TRANTYPE'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 REMARK1 FROM " & compId & "ADMINDB..CUSTOMERINFO WHERE BATCHNO=I.BATCHNO) AS NARRATION '"
        strSql += vbCrLf + "           IF @CHITDB<>'' "
        strSql += vbCrLf + "           BEGIN "
        strSql += vbCrLf + "                SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 SCHEMEID FROM ' + @CHITDB + 'SAVINGS..SCHEMEMAST WHERE CONVERT(VARCHAR,GROUPCODE)+CONVERT(VARCHAR,REGNO) IN (SELECT TOP 1 ISNULL(CHQCARDREF,'''')+ISNULL(CHQCARDNO,'''') FROM ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''SS'')) AS CHIT '"
        strSql += vbCrLf + "           END "
        strSql += vbCrLf + "           /*SELECT @QRY=@QRY+CHAR(13)+' ,CASE WHEN I.GRSWT < I.TAGGRSWT THEN I.GRSWT ELSE I.TAGGRSWT END AS TAGWT '*/"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ,I.TAGGRSWT'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' FROM " & tranDbName & "..ISSUE I'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' INNER JOIN " & compId & "ADMINDB..ITEMMAST M ON  I.ITEMID = M.ITEMID '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' LEFT JOIN " & compId & "ADMINDB..SUBITEMMAST S ON S.SUBITEMID =I.SUBITEMID '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' LEFT JOIN " & compId & "ADMINDB..ITEMTAG T ON I.TAGNO = T.TAGNO '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' left join " & compId & "ADMINDB..METALMAST MM ON M.METALID =MM.METALID  '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' left join " & compId & "ADMINDB..CATEGORY C on I.CATCODE =C.CATCODE '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' left join " & compId & "ADMINDB..PURITYMAST PU ON C.PURITYID  =PU.PURITYID  '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' left join " & compId & "ADMINDB..METALMAST M2 ON M2.METALID=PU.METALID'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' WHERE LEN(I.TRANTYPE)=2 AND I.TRANDATE BETWEEN ''' + @FROMDATE + ''' AND ''' + @TODATE + ''' and I.costID in (select costid from TEMPTABLEDB..COSTCENTRE)'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(I.CANCEL,'''')<>''Y'' '"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' AND I.TRANTYPE IN (''SA'',''OD'',''RD'')'"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' AND ((isnull(MM.METALNAME,'''') <> '''' and MM.METALNAME in (select METAL from TEMPTABLEDB..METAL )) or (isnull(MM.METALNAME,'''') = '''' and M2.METALNAME in (select METAL from TEMPTABLEDB..METAL )))'"
        strSql += vbCrLf + "           IF @BILLNO<>'0'"
        strSql += vbCrLf + "           BEGIN"
        strSql += vbCrLf + "           	SELECT @QRY=@QRY+CHAR(13)+' AND I.TRANNO='''+ @BILLNO +''''"
        strSql += vbCrLf + "           END"
        strSql += vbCrLf + "           SELECT @QRY=@QRY+CHAR(13)+' ORDER BY TRANNO  '"
