        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,CONVERT(NUMERIC(15,3),(SELECT SUM(ISNULL(STNPCS,0)) FROM ITEMTAGSTONE WHERE SNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE IN (''D'')))) AS DIAPCS'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,CONVERT(NUMERIC(15,3),(SELECT SUM(ISNULL(STNWT,0)) FROM ITEMTAGSTONE WHERE SNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE IN (''D'')))) AS DIAWT'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,CONVERT(NUMERIC(15,3),(SELECT SUM(ISNULL(STNPCS,0)) FROM ITEMTAGSTONE WHERE SNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE IN (''P'',''S'')))) AS STNPCS'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' ,CONVERT(NUMERIC(15,3),(SELECT SUM(ISNULL(STNWT,0)) FROM ITEMTAGSTONE WHERE SNO = T.SNO AND STNITEMID IN (SELECT ITEMID FROM ITEMMAST WHERE DIASTONE IN (''P'',''S'')))) AS STNWT'  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' FROM ITEMTAGSTONE AS T' "
        strSql += vbCrLf + " 	/*SELECT @QRY = @QRY + CHAR(13)+' LEFT JOIN ITEMTAG AS ITM ON ITM.SNO=T.TAGSNO' */"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' LEFT JOIN ITEMMAST AS IT ON T.ITEMID=IT.ITEMID '  "
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' WHERE 1=1' /*+ @RECDATE + ' < '''+@FRMDATE + '''' */"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13)+' AND TAGSNO IN (SELECT SNO FROM ITEMTAG AS T  WHERE RECDATE < '''+@FRMDATE + '''  AND (ISSDATE IS NULL OR ISSDATE >= '''+@FRMDATE + ''') '"
