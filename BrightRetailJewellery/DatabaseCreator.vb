        strSql += vbCrLf + "  		SELECT @STRQRY=@STRQRY + CHAR(13) + ',(SELECT SUM(STNWT) FROM ISSSTONE WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND STNITEMID IN '"
