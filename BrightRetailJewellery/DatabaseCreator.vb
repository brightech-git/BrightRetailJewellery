        strSql += vbCrLf + "  			,SUM(IPCS),SUM(IGRSWT),SUM(IPCS_MI),SUM(IGRSWT_MI),SUM(IPCS_NT),SUM(IGRSWT_NT),SUM(IPCS_PA),SUM(IGRSWT_PA),SUM(IPCS_AP),SUM(IGRSWT_AP),SUM(IPCS_TR),SUM(IGRSWT_TR),SUM(IPCS_NTTT),SUM(IGRSWT_NTTT)"
        strSql += vbCrLf + "  			,SUM(CPCS),SUM(CGRSWT)       "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 2       "
        strSql += vbCrLf + "  			GROUP BY ITEM,METAL       "
        strSql += vbCrLf + "  		END  "
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,METAL,ITEM,ICOUNTERNAME,COLHEAD,RESULT       "
        strSql += vbCrLf + "  		,OPCS,OGRSWT       "
        strSql += vbCrLf + "  		,RPCS,RGRSWT,RPCS_PA,RGRSWT_PA,RPCS_AP,RGRSWT_AP,RPCS_TR,RGRSWT_TR,RPCS_RE,RGRSWT_RE,RPCS_PU,RGRSWT_PU       "
        strSql += vbCrLf + "  		,IPCS,IGRSWT,IPCS_MI,IGRSWT_MI,IPCS_NT,IGRSWT_NT,IPCS_PA,IGRSWT_PA,IPCS_AP,IGRSWT_AP,IPCS_TR,IGRSWT_TR,IPCS_NTTT,IGRSWT_NTTT     "
        strSql += vbCrLf + "  		,CPCS,CGRSWT       "
        strSql += vbCrLf + "  		)       "
        strSql += vbCrLf + "  		/** INSERTING GRAND TOT **/       "
        strSql += vbCrLf + "  		SELECT 'GRAND TOT','ZZZZZ','ZZZZ','ZZZZ','G',5        "
        strSql += vbCrLf + "  		,SUM(OPCS),SUM(OGRSWT)       "
        strSql += vbCrLf + "  		,SUM(RPCS),SUM(RGRSWT),SUM(RPCS_PA),SUM(RGRSWT_PA),SUM(RPCS_AP),SUM(RGRSWT_AP),SUM(RPCS_TR),SUM(RGRSWT_TR),SUM(RPCS_RE),SUM(RGRSWT_RE),SUM(RPCS_PU),SUM(RGRSWT_PU)       "
        strSql += vbCrLf + "  		,SUM(IPCS),SUM(IGRSWT),SUM(IPCS_MI),SUM(IGRSWT_MI),SUM(IPCS_NT),SUM(IGRSWT_NT),SUM(IPCS_PA),SUM(IGRSWT_PA),SUM(IPCS_AP),SUM(IGRSWT_AP),SUM(IPCS_TR),SUM(IGRSWT_TR),SUM(IPCS_NTTT),SUM(IGRSWT_NTTT)"
        strSql += vbCrLf + "  		,SUM(CPCS),SUM(CGRSWT)       "
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 2       "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + "    DROP TABLE TEMPMETALMAST     "
        strSql += vbCrLf + "    DROP TABLE TEMPITEMMAST     "
        strSql += vbCrLf + "    DROP TABLE TEMPCOMPANY     "
        strSql += vbCrLf + "    DROP TABLE TEMPCOSTCENTRE     "
        strSql += vbCrLf + "    UPDATE TEMPTABLEDB..TEMP_STOCKFLOW_RES  SET IGRSWT=NULL WHERE IGRSWT=0 "
        strSql += vbCrLf + "    SELECT * FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES       "
        strSql += vbCrLf + "    ORDER BY ICOUNTERNAME,RESULT,PARTICULAR     "
        strSql += vbCrLf + "  END    "
        strSql += vbCrLf + "  IF @COUNTER  <>'Y'"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMP_FLAG') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_FLAG"
        strSql += vbCrLf + "  	SELECT DISTINCT ISNULL(FLAG,'') FLAG INTO TEMPTABLEDB..TEMP_FLAG FROM " & compId & "ADMINDB..ITEMNONTAG"
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'HIDEBACKOFFICE' AND CTLTEXT = 'Y') > 0"
        strSql += vbCrLf + "  	DELETE FROM TEMPTABLEDB..TEMP_FLAG WHERE FLAG = 'B'"
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMTAG1') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMTAG1"
        strSql += vbCrLf + "  	SELECT *,CONVERT(VARCHAR(5),'TAG')FROMTABLE INTO TEMPTABLEDB..TEMPITEMTAG1 FROM " & compId & "ADMINDB..ITEMTAG AS T"
        strSql += vbCrLf + "  	WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  	AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  	AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND ISNULL(T.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	IF @WITHCUMSTK ='Y'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMPITEMTAG1"
        strSql += vbCrLf + "  		SELECT *,CONVERT(VARCHAR(5),'TAG')FROMTABLE FROM " & compId & "ADMINDB..CITEMTAG AS T"
        strSql += vbCrLf + "  		WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  		AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  		AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  		AND ISNULL(T.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	IF @BEADS<>'Y' "
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		UPDATE IT SET GRSWT=GRSWT - REDUCTION FROM (SELECT ISNULL(SUM(CASE WHEN STONEUNIT='C' THEN STNWT/5 ELSE STNWT END),0) REDUCTION,TAGSNO FROM " & compId & "ADMINDB..ITEMTAGSTONE"
        strSql += vbCrLf + "  		WHERE (STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(BEEDS,'')='Y') OR"
        strSql += vbCrLf + "  		STNSUBITEMID IN (SELECT SUBITEMID FROM " & compId & "ADMINDB..SUBITEMMAST WHERE ISNULL(BEEDS,'')='Y'))  GROUP BY TAGSNO ) ITS , TEMPTABLEDB..TEMPITEMTAG1 IT WHERE IT.SNO=ITS.TAGSNO"
        strSql += vbCrLf + "  	END  "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMPITEMNONTAG1') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPITEMNONTAG1"
        strSql += vbCrLf + "  	SELECT * INTO TEMPTABLEDB..TEMPITEMNONTAG1 FROM " & compId & "ADMINDB..ITEMNONTAG T"
        strSql += vbCrLf + "  	WHERE T.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  	AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  	AND T.COMPANYID IN (SELECT COMPANYID FROM TEMPCOMPANY)"
        strSql += vbCrLf + "  	AND ISNULL(T.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  	AND ISNULL(T.FLAG,'') IN (SELECT FLAG FROM TEMPTABLEDB..TEMP_FLAG)"
        strSql += vbCrLf + "  	AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  	IF @WITHSUBITEM = 'N'  "
        strSql += vbCrLf + "  	BEGIN  "
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPITEMTAG1 SET SUBITEMID = 0"
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMPITEMNONTAG1 SET SUBITEMID = 0 		"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	/** GETTING TAG INFO **/       "
        strSql += vbCrLf + "  	IF OBJECT_ID('TEMPTABLEDB..TEMP_STOCKFLOW') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	CREATE TABLE TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	(SEP VARCHAR(10),PCS INT,GRSWT NUMERIC(15,3),ITEMID INT,METAL VARCHAR(20),ITEM VARCHAR(50),SUBITEMID INT,SUBITEM VARCHAR(50))     "
        strSql += vbCrLf + "  	IF @STOCKTYPE = 'T' OR @STOCKTYPE = 'B'     "
        strSql += vbCrLf + "  	BEGIN   "
        strSql += vbCrLf + "  		IF @BEADS<>'Y'  "
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW(SEP,PCS,GRSWT,ITEMID,SUBITEMID)"
        strSql += vbCrLf + "  			SELECT CONVERT(VARCHAR(10),'OPE')SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 WHERE RECDATE < @FROMDATE  AND (ISSDATE >= @FROMDATE OR ISSDATE IS NULL)  "
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT CONVERT(VARCHAR(10),'OPE_AP')SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE < @FROMDATE AND (ISSDATE >= @FROMDATE OR ISSDATE IS NULL)"
        strSql += vbCrLf + "  			AND (TAGNO IN (SELECT TAGNO FROM ISSUE WHERE TRANDATE < @FROMDATE AND TRANTYPE = 'AI' AND (REFDATE IS NULL OR REFDATE >=@FROMDATE ) AND ISNULL(CANCEL,'') = '' AND ISNULL(COSTID,'')=ISNULL(T.COSTID,'') AND ISNULL(ITEMID,'')=ISNULL(T.ITEMID,''))"
        strSql += vbCrLf + "         	OR TAGNO IN (SELECT TAGNO FROM APPISSUE WHERE TRANDATE < @FROMDATE AND TRANTYPE = 'AI' AND (REFDATE IS NULL OR REFDATE >=@FROMDATE ) AND ISNULL(CANCEL,'') = '' AND ISNULL(COSTID,'')=ISNULL(T.COSTID,'') AND ISNULL(ITEMID,'')=ISNULL(T.ITEMID,'')))"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT 'REC'SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID"
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE BETWEEN @FROMDATE AND @TODATE  "
        strSql += vbCrLf + "  			AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CITEMTAG C WHERE C.SNO = T.SNO AND C.RECDATE BETWEEN @FROMDATE AND @TODATE )"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID"
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'REC_AP'SEP,SUM(T.PCS)PCS,SUM(T.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T INNER JOIN RECEIPT R ON R.TAGNO=T.TAGNO AND R.ITEMID=T.ITEMID"
        strSql += vbCrLf + "  			WHERE R.TRANDATE BETWEEN @FROMDATE AND @TODATE AND R.TRANTYPE='AR' AND ISNULL(R.CANCEL,'')=''"
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'REC_TR'SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE BETWEEN @FROMDATE AND @TODATE  "
        strSql += vbCrLf + "  			AND EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CITEMTAG C WHERE C.SNO = T.SNO AND C.RECDATE BETWEEN @FROMDATE AND @TODATE )"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID"
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT CASE WHEN I.TRANTYPE = 'MI' THEN 'ISS_MI' ELSE 'ISS' END SEP,SUM(I.PCS)PCS,SUM(I.GRSWT-ISNULL(REDUCTION,0))GRSWT,T.ITEMID,T.SUBITEMID"
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T  "
        strSql += vbCrLf + "  			LEFT JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO AND I.BATCHNO = T.BATCHNO AND ISNULL(I.CANCEL,'')=''"
        strSql += vbCrLf + "  			LEFT JOIN (SELECT ISNULL(SUM(CASE WHEN STONEUNIT='C' THEN STNWT/5 ELSE STNWT END),0) REDUCTION,ISSSNO FROM ISSSTONE"
        strSql += vbCrLf + "  			WHERE (STNITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE ISNULL(BEEDS,'')='Y') OR"
        strSql += vbCrLf + "  			STNSUBITEMID IN (SELECT SUBITEMID FROM " & compId & "ADMINDB..SUBITEMMAST WHERE ISNULL(BEEDS,'')='Y')) GROUP BY ISSSNO)ITS ON ITS.ISSSNO =I.SNO"
        strSql += vbCrLf + "  			WHERE T.ISSDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_PA' SEP,SUM(T.PCS-I.PCS)PCS,SUM(T.GRSWT-I.NETWT)GRSWT,T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T       "
        strSql += vbCrLf + "  			INNER JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO AND I.BATCHNO = T.BATCHNO AND ISNULL(I.CANCEL,'')='' AND (I.PCS <> T.PCS OR I.GRSWT <> T.GRSWT )     "
        strSql += vbCrLf + "  			WHERE T.ISSDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_AP' SEP,SUM(T.PCS)PCS,SUM(T.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T "
        strSql += vbCrLf + "  			INNER JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO "
        strSql += vbCrLf + "  			WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE='AI' AND ISNULL(I.CANCEL,'')='' "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_TR' SEP,SUM(C.PCS)PCS,SUM(C.GRSWT)GRSWT,C.ITEMID,C.SUBITEMID"
        strSql += vbCrLf + "  			FROM " & compId & "ADMINDB..CITEMTAG AS C "
        strSql += vbCrLf + "  			WHERE C.ISSDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + "  			AND TAGNO NOT IN (SELECT TAGNO FROM " & compId & "ADMINDB..ITEMTAG WHERE ISSDATE =C.ISSDATE AND TOFLAG<>'')"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  			AND ISNULL(C.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  			AND ISNULL(C.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  			GROUP BY C.ITEMID,C.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_TR' SEP,SUM(C.PCS)PCS,SUM(C.GRSWT)GRSWT,C.ITEMID,C.SUBITEMID"
        strSql += vbCrLf + "  			FROM " & compId & "ADMINDB..ITEMTAG AS C "
        strSql += vbCrLf + "  			WHERE C.ISSDATE BETWEEN @FROMDATE AND @TODATE AND C.TOFLAG='TR'"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  			AND ISNULL(C.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  			AND ISNULL(C.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  			GROUP BY C.ITEMID,C.SUBITEMID  "
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		ELSE"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW(SEP,PCS,GRSWT,ITEMID,SUBITEMID)     "
        strSql += vbCrLf + "  			SELECT CONVERT(VARCHAR(10),'OPE')SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 WHERE RECDATE < @FROMDATE  AND (ISSDATE >= @FROMDATE OR ISSDATE IS NULL)"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT CONVERT(VARCHAR(10),'OPE_AP')SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE < @FROMDATE AND (ISSDATE >= @FROMDATE OR ISSDATE IS NULL)"
        strSql += vbCrLf + "  			AND (TAGNO IN (SELECT TAGNO FROM ISSUE WHERE TRANDATE < @FROMDATE AND TRANTYPE = 'AI' AND (REFDATE IS NULL OR REFDATE >=@FROMDATE ) AND ISNULL(CANCEL,'') = '' AND ISNULL(COSTID,'')=ISNULL(T.COSTID,'') AND ISNULL(ITEMID,'')=ISNULL(T.ITEMID,''))"
        strSql += vbCrLf + "         	OR TAGNO IN (SELECT TAGNO FROM APPISSUE WHERE TRANDATE < @FROMDATE AND TRANTYPE = 'AI' AND (REFDATE IS NULL OR REFDATE >=@FROMDATE ) AND ISNULL(CANCEL,'') = '' AND ISNULL(COSTID,'')=ISNULL(T.COSTID,'') AND ISNULL(ITEMID,'')=ISNULL(T.ITEMID,'')))"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT 'REC'SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  			AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CITEMTAG C WHERE C.SNO = T.SNO AND C.RECDATE BETWEEN @FROMDATE AND @TODATE )"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'REC_AP'SEP,SUM(T.PCS)PCS,SUM(T.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T INNER JOIN RECEIPT R ON R.TAGNO=T.TAGNO AND R.ITEMID=T.ITEMID"
        strSql += vbCrLf + "  			WHERE R.TRANDATE BETWEEN @FROMDATE AND @TODATE AND R.TRANTYPE='AR' AND ISNULL(R.CANCEL,'')=''"
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL "
        strSql += vbCrLf + "  			SELECT 'REC_TR'SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T WHERE RECDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  			AND EXISTS (SELECT 1 FROM " & compId & "ADMINDB..CITEMTAG C WHERE C.SNO = T.SNO AND C.RECDATE BETWEEN @FROMDATE AND @TODATE )"
        strSql += vbCrLf + "  			GROUP BY ITEMID,SUBITEMID "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT CASE WHEN I.TRANTYPE = 'MI' THEN 'ISS_MI' ELSE 'ISS' END SEP,SUM(I.PCS)PCS,SUM(I.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID     "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T  "
        strSql += vbCrLf + "  			LEFT JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO AND I.BATCHNO = T.BATCHNO AND ISNULL(I.CANCEL,'')=''"
        strSql += vbCrLf + "  			WHERE T.ISSDATE BETWEEN @FROMDATE AND @TODATE     "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID  "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_PA' SEP,SUM(T.PCS-I.PCS)PCS,SUM(T.GRSWT-I.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID  "
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T       "
        strSql += vbCrLf + "  			INNER JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO AND I.BATCHNO = T.BATCHNO AND ISNULL(I.CANCEL,'')='' AND (I.PCS <> T.PCS OR I.GRSWT <> T.GRSWT )     "
        strSql += vbCrLf + "  			WHERE T.ISSDATE BETWEEN @FROMDATE AND @TODATE "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID   "
        strSql += vbCrLf + "  			UNION ALL  "
        strSql += vbCrLf + "  			SELECT 'ISS_AP' SEP,SUM(T.PCS)PCS,SUM(T.GRSWT)GRSWT,T.ITEMID,T.SUBITEMID"
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMPITEMTAG1 T  "
        strSql += vbCrLf + "  			INNER JOIN ISSUE AS I ON I.ITEMID = T.ITEMID AND I.TAGNO = T.TAGNO"
        strSql += vbCrLf + "  			WHERE I.TRANDATE BETWEEN @FROMDATE AND @TODATE AND I.TRANTYPE='AI' AND ISNULL(I.CANCEL,'')='' "
        strSql += vbCrLf + "  			GROUP BY T.ITEMID,I.TRANTYPE,T.SUBITEMID   "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT 'ISS_TR' SEP,SUM(C.PCS)PCS,SUM(C.GRSWT)GRSWT,C.ITEMID,C.SUBITEMID"
        strSql += vbCrLf + "  			FROM " & compId & "ADMINDB..CITEMTAG AS C "
        strSql += vbCrLf + "  			WHERE C.RECDATE <= @TODATE AND  C.ISSDATE BETWEEN @FROMDATE AND @TODATE"
        strSql += vbCrLf + "  			AND TAGNO NOT IN (SELECT TAGNO FROM " & compId & "ADMINDB..ITEMTAG WHERE ISSDATE =C.ISSDATE AND TOFLAG<>'')"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  			AND ISNULL(C.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  			AND ISNULL(C.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  			GROUP BY C.ITEMID,C.SUBITEMID "
        strSql += vbCrLf + "  			UNION ALL"
        strSql += vbCrLf + "  			SELECT 'ISS_TR' SEP,SUM(C.PCS)PCS,SUM(C.GRSWT)GRSWT,C.ITEMID,C.SUBITEMID"
        strSql += vbCrLf + "  			FROM " & compId & "ADMINDB..ITEMTAG AS C "
        strSql += vbCrLf + "  			WHERE C.RECDATE <= @TODATE AND  C.ISSDATE BETWEEN @FROMDATE AND @TODATE AND TOFLAG='TR'"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE METALID IN (SELECT COMPANYID FROM TEMPMETALMAST))"
        strSql += vbCrLf + "  			AND C.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)"
        strSql += vbCrLf + "  			AND ISNULL(C.COSTID,'') IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + "  			AND ISNULL(C.ITEMCTRID,'') IN (SELECT COMPANYID FROM TEMPITEMCOUNTER)"
        strSql += vbCrLf + "  			GROUP BY C.ITEMID,C.SUBITEMID "
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	/** GETTING NONTAG INFO **/"
        strSql += vbCrLf + "  	IF @STOCKTYPE = 'N' OR @STOCKTYPE = 'B'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW(SEP,PCS,GRSWT,ITEMID,SUBITEMID)"
        strSql += vbCrLf + "  		SELECT 'OPE'SEP,SUM(CASE WHEN RECISS = 'R' THEN PCS ELSE -1*PCS END)PCS,SUM(CASE WHEN RECISS = 'R' THEN GRSWT ELSE -1*GRSWT END)GRSWT,ITEMID,SUBITEMID"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMPITEMNONTAG1 WHERE RECDATE < @FROMDATE"
        strSql += vbCrLf + "  		GROUP BY ITEMID,SUBITEMID"
        strSql += vbCrLf + "  		UNION ALL"
        strSql += vbCrLf + "  		SELECT CASE WHEN ISNULL(POSTED,'')='P' THEN 'REC_PA'"
        strSql += vbCrLf + "  		WHEN ISNULL(POSTED,'')='R' THEN 'REC_RE'"
        strSql += vbCrLf + "  		WHEN ISNULL(POSTED,'')='U' THEN 'REC_PU'"
        strSql += vbCrLf + "  		WHEN ISNULL(POSTED,'')='' AND ISNULL(APPROVAL,'')='A' THEN 'REC_AP'"
        strSql += vbCrLf + "  		ELSE 'REC' END SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMPITEMNONTAG1 WHERE RECDATE BETWEEN @FROMDATE AND @TODATE AND RECISS = 'R'"
        strSql += vbCrLf + "  		GROUP BY ITEMID,POSTED,SUBITEMID,APPROVAL"
        strSql += vbCrLf + "  		UNION ALL"
        strSql += vbCrLf + "  		SELECT CASE ISNULL(ISSTYPE,'') WHEN 'SA' THEN 'ISS'"
        strSql += vbCrLf + "  		WHEN '' THEN 'ISS_NT'"
        strSql += vbCrLf + "  		WHEN 'NT' THEN 'ISS_NTTT'"
        strSql += vbCrLf + "  		WHEN 'AP' THEN 'ISS_AP'"
        strSql += vbCrLf + "  		ELSE 'ISS_MI' END SEP,SUM(PCS)PCS,SUM(GRSWT)GRSWT,ITEMID,SUBITEMID"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMPITEMNONTAG1 WHERE RECDATE BETWEEN @FROMDATE AND @TODATE AND RECISS = 'I'"
        strSql += vbCrLf + "  		GROUP BY ITEMID,ISSTYPE,SUBITEMID"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	IF @WITHSUBITEM = 'N'"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		UPDATE TEMPTABLEDB..TEMP_STOCKFLOW SET SUBITEMID = 0"
        strSql += vbCrLf + "  	END "
        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMP_STOCKFLOW SET METAL = ME.METALNAME,ITEM = IM.ITEMNAME,SUBITEM = SM.SUBITEMNAME       "
        strSql += vbCrLf + "  	FROM TEMPTABLEDB..TEMP_STOCKFLOW  AS T       "
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..ITEMMAST AS IM ON IM.ITEMID = T.ITEMID       "
        strSql += vbCrLf + "  	LEFT JOIN " & compId & "ADMINDB..SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID  "
        strSql += vbCrLf + "  	INNER JOIN " & compId & "ADMINDB..METALMAST AS ME ON ME.METALID = IM.METALID       "
        strSql += vbCrLf + "  	SELECT @LEN_ITEMNAME = MAX(LEN(ITEM)) FROM TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	SELECT @LEN_ITEMID = MAX(LEN(ITEMID)) FROM TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	SELECT @LEN_SUBITEMNAME = MAX(LEN(SUBITEM)) FROM TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	SELECT @LEN_SUBITEMID = MAX(LEN(SUBITEMID)) FROM TEMPTABLEDB..TEMP_STOCKFLOW       "
        strSql += vbCrLf + "  	UPDATE TEMPTABLEDB..TEMP_STOCKFLOW SET   "
        strSql += vbCrLf + "  	ITEM =        "
        strSql += vbCrLf + "  	CASE WHEN @ITEMID_ORDER = 'Y' THEN '['+ REPLICATE(' ',@LEN_ITEMID-LEN(ITEMID)) + CONVERT(VARCHAR,ITEMID) + '] ' + ITEM       "
        strSql += vbCrLf + "  	ELSE ITEM + REPLICATE(' ',@LEN_ITEMNAME-LEN(ITEM))+ ' ['+ REPLICATE(' ',@LEN_ITEMID-LEN(ITEMID)) + CONVERT(VARCHAR,ITEMID) + ']' END       "
        strSql += vbCrLf + "  	,SUBITEM =        "
        strSql += vbCrLf + "  	CASE WHEN @ITEMID_ORDER = 'Y' THEN '['+ REPLICATE(' ',@LEN_SUBITEMID-LEN(SUBITEMID)) + CONVERT(VARCHAR,SUBITEMID) + '] ' + SUBITEM       "
        strSql += vbCrLf + "  	ELSE SUBITEM + REPLICATE(' ',@LEN_SUBITEMNAME-LEN(SUBITEM))+ ' ['+ REPLICATE(' ',@LEN_SUBITEMID-LEN(SUBITEMID)) + CONVERT(VARCHAR,SUBITEMID) + ']' END       "
        strSql += vbCrLf + "  	SELECT @QRY= ' IF OBJECT_ID(''TEMPTABLEDB..TEMP_STOCKFLOW_RES'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_STOCKFLOW_RES'"
        strSql += vbCrLf + "  	EXEC (@QRY)   "
        strSql += vbCrLf + "  	SELECT @QRY= ' SELECT CONVERT(VARCHAR(200),CASE WHEN ISNULL(SUBITEM,'''') = '''' THEN ITEM ELSE SUBITEM END)AS PARTICULAR'"
        strSql += vbCrLf + "  	IF @WITHAPP='Y'"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''OPE'') THEN PCS WHEN SEP IN(''OPE_AP'')THEN -1*PCS ELSE NULL END) AS OPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''OPE'') THEN GRSWT WHEN SEP IN(''OPE_AP'')THEN -1*GRSWT ELSE NULL END) AS OGRSWT'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN PCS ELSE NULL END) AS OPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''OPE'' THEN GRSWT ELSE NULL END) AS OGRSWT'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN PCS ELSE NULL END) AS RPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC'' THEN GRSWT ELSE NULL END) AS RGRSWT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_PA'' THEN PCS ELSE NULL END) AS RPCS_PA'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_PA'' THEN GRSWT ELSE NULL END) AS RGRSWT_PA'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_AP'' THEN PCS ELSE NULL END) AS RPCS_AP'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_AP'' THEN GRSWT ELSE NULL END) AS RGRSWT_AP'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_TR'' THEN PCS ELSE NULL END) AS RPCS_TR'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_TR'' THEN GRSWT ELSE NULL END) AS RGRSWT_TR'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_RE'' THEN PCS ELSE NULL END) AS RPCS_RE'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_RE'' THEN GRSWT ELSE NULL END) AS RGRSWT_RE'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_PU'' THEN PCS ELSE NULL END) AS RPCS_PU'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''REC_PU'' THEN GRSWT ELSE NULL END) AS RGRSWT_PU'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS'' THEN PCS ELSE NULL END) AS IPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS'' THEN GRSWT ELSE NULL END) AS IGRSWT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_MI'' THEN PCS ELSE NULL END) AS IPCS_MI'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_MI'' THEN GRSWT ELSE NULL END) AS IGRSWT_MI'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_PA'' THEN PCS ELSE NULL END) AS IPCS_PA'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_PA'' THEN GRSWT ELSE NULL END) AS IGRSWT_PA'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_AP'' THEN PCS ELSE NULL END) AS IPCS_AP'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_AP'' THEN GRSWT ELSE NULL END) AS IGRSWT_AP'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_TR'' THEN PCS ELSE NULL END) AS IPCS_TR'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_TR'' THEN GRSWT ELSE NULL END) AS IGRSWT_TR'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_NT'' THEN PCS ELSE NULL END) AS IPCS_NT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_NT'' THEN GRSWT ELSE NULL END) AS IGRSWT_NT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_NTTT'' THEN PCS ELSE NULL END) AS IPCS_NTTT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP = ''ISS_NTTT'' THEN GRSWT ELSE NULL END) AS IGRSWT_NTTT'"
        strSql += vbCrLf + "  	IF @WITHAPP='Y'"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''ISS'',''ISS_MI'',''ISS_NT'',''ISS_NTTT'',''ISS_AP'',''OPE_AP'',''ISS_PA'',''ISS_TR'') THEN -1*PCS ELSE PCS END) AS CPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''ISS'',''ISS_MI'',''ISS_NT'',''ISS_NTTT'',''ISS_AP'',''OPE_AP'',''ISS_PA'',''ISS_TR'') THEN -1*GRSWT ELSE GRSWT END) AS CGRSWT'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''ISS'',''ISS_MI'',''ISS_NT'',''ISS_NTTT'',''ISS_PA'',''ISS_TR'') THEN -1*PCS WHEN SEP IN(''ISS_AP'',''REC_AP'') THEN 0 ELSE PCS END) AS CPCS'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,SUM(CASE WHEN SEP IN (''ISS'',''ISS_MI'',''ISS_NT'',''ISS_NTTT'',''ISS_PA'',''ISS_TR'') THEN -1*GRSWT WHEN SEP IN(''ISS_AP'',''REC_AP'') THEN 0 ELSE GRSWT END) AS CGRSWT'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' ,T.METAL,T.ITEM,'' '' AS ICOUNTERNAME,CONVERT(VARCHAR(3),NULL)COLHEAD,CONVERT(INT,1)RESULT'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES FROM TEMPTABLEDB..TEMP_STOCKFLOW AS T'"
        strSql += vbCrLf + "  	SELECT @QRY= @QRY + ' GROUP BY T.METAL,T.ITEM,T.SUBITEM'"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC (@QRY)   "
        strSql += vbCrLf + "  	/*SELECT @QRY='UPDATE  ST SET IGRSWT=ISNULL(IGRSWT,0)-ISNULL(IGRSWT_PA,0)  FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES ST WHERE RESULT=1'"
        strSql += vbCrLf + "  	PRINT @QRY"
        strSql += vbCrLf + "  	EXEC(@QRY)*/"
        strSql += vbCrLf + "  	IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES )>0       "
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  		/** INSERTING TITLE **/"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,METAL,COLHEAD,RESULT,ICOUNTERNAME)"
        strSql += vbCrLf + "  		SELECT DISTINCT METAL,METAL,'T',0,'' FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 1"
        strSql += vbCrLf + "  		/** INSERTING SUBTOT **/"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,METAL,ITEM,COLHEAD,RESULT"
        strSql += vbCrLf + "  		,OPCS,OGRSWT"
        strSql += vbCrLf + "  		,RPCS,RGRSWT,RPCS_PA,RGRSWT_PA,RPCS_AP,RGRSWT_AP,RPCS_TR,RGRSWT_TR,RPCS_RE,RGRSWT_RE,RPCS_PU,RGRSWT_PU"
        strSql += vbCrLf + "  		,IPCS,IGRSWT,IPCS_MI,IGRSWT_MI,IPCS_NT,IGRSWT_NT,IPCS_PA,IGRSWT_PA,IPCS_AP,IGRSWT_AP,IPCS_TR,IGRSWT_TR,IPCS_NTTT,IGRSWT_NTTT"
        strSql += vbCrLf + "  		,CPCS,CGRSWT,ICOUNTERNAME"
        strSql += vbCrLf + "  		)"
        strSql += vbCrLf + "  		SELECT METAL + ' TOT',METAL,'ZZZZ','S',2"
        strSql += vbCrLf + "  		,SUM(OPCS),SUM(OGRSWT)"
        strSql += vbCrLf + "  		,SUM(RPCS),SUM(RGRSWT),SUM(RPCS_PA),SUM(RGRSWT_PA),SUM(RPCS_AP),SUM(RGRSWT_AP),SUM(RPCS_TR),SUM(RGRSWT_TR),SUM(RPCS_RE),SUM(RGRSWT_RE),SUM(RPCS_PU),SUM(RGRSWT_PU)"
        strSql += vbCrLf + "  		,SUM(IPCS),SUM(IGRSWT),SUM(IPCS_MI),SUM(IGRSWT_MI),SUM(IPCS_NT),SUM(IGRSWT_NT),SUM(IPCS_PA),SUM(IGRSWT_PA),SUM(IPCS_AP),SUM(IGRSWT_AP),SUM(IPCS_TR),SUM(IGRSWT_TR),SUM(IPCS_NTTT),SUM(IGRSWT_NTTT)"
        strSql += vbCrLf + "  		,SUM(CPCS),SUM(CGRSWT),''"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 1"
        strSql += vbCrLf + "  		GROUP BY METAL"
        strSql += vbCrLf + "  		IF @WITHSUBITEM = 'Y'"
        strSql += vbCrLf + "  		BEGIN"
        strSql += vbCrLf + "  			/** INSERTING TITLE **/"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,ITEM,METAL,COLHEAD,RESULT,ICOUNTERNAME)"
        strSql += vbCrLf + "  			SELECT DISTINCT ITEM,ITEM,METAL,'T1',0,'' FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 1"
        strSql += vbCrLf + "  			/** INSERTING SUBTOT **/"
        strSql += vbCrLf + "  			INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,ITEM,METAL,COLHEAD,RESULT"
        strSql += vbCrLf + "  			,OPCS,OGRSWT"
        strSql += vbCrLf + "  			,RPCS,RGRSWT,RPCS_PA,RGRSWT_PA,RPCS_AP,RGRSWT_AP,RPCS_TR,RGRSWT_TR,RPCS_RE,RGRSWT_RE,RPCS_PU,RGRSWT_PU"
        strSql += vbCrLf + "  			,IPCS,IGRSWT,IPCS_MI,IGRSWT_MI,IPCS_NT,IGRSWT_NT,IPCS_PA,IGRSWT_PA,IPCS_AP,IGRSWT_AP,IPCS_TR,IGRSWT_TR,IPCS_NTTT,IGRSWT_NTTT"
        strSql += vbCrLf + "  			,CPCS,CGRSWT,ICOUNTERNAME"
        strSql += vbCrLf + "  			)"
        strSql += vbCrLf + "  			SELECT ITEM + ' TOT',ITEM,METAL,'S1',2"
        strSql += vbCrLf + "  			,SUM(OPCS),SUM(OGRSWT)"
        strSql += vbCrLf + "  			,SUM(RPCS),SUM(RGRSWT),SUM(RPCS_PA),SUM(RGRSWT_PA),SUM(RPCS_AP),SUM(RGRSWT_AP),SUM(RPCS_TR),SUM(RGRSWT_TR),SUM(RPCS_RE),SUM(RGRSWT_RE),SUM(RPCS_PU),SUM(RGRSWT_PU)"
        strSql += vbCrLf + "  			,SUM(IPCS),SUM(IGRSWT),SUM(IPCS_MI),SUM(IGRSWT_MI),SUM(IPCS_NT),SUM(IGRSWT_NT),SUM(IPCS_PA),SUM(IGRSWT_PA),SUM(IPCS_AP),SUM(IGRSWT_AP),SUM(IPCS_TR),SUM(IGRSWT_TR),SUM(IPCS_NTTT),SUM(IGRSWT_NTTT)"
        strSql += vbCrLf + "  			,SUM(CPCS),SUM(CGRSWT) ,''"
        strSql += vbCrLf + "  			FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 1"
        strSql += vbCrLf + "  			GROUP BY ITEM,METAL"
        strSql += vbCrLf + "  		END"
        strSql += vbCrLf + "  		INSERT INTO TEMPTABLEDB..TEMP_STOCKFLOW_RES(PARTICULAR,METAL,ITEM,COLHEAD,RESULT"
        strSql += vbCrLf + "  		,OPCS,OGRSWT"
        strSql += vbCrLf + "  		,RPCS,RGRSWT,RPCS_PA,RGRSWT_PA,RPCS_AP,RGRSWT_AP,RPCS_TR,RGRSWT_TR,RPCS_RE,RGRSWT_RE,RPCS_PU,RGRSWT_PU"
        strSql += vbCrLf + "  		,IPCS,IGRSWT,IPCS_MI,IGRSWT_MI,IPCS_NT,IGRSWT_NT,IPCS_PA,IGRSWT_PA,IPCS_AP,IGRSWT_AP,IPCS_TR,IGRSWT_TR,IPCS_NTTT,IGRSWT_NTTT"
        strSql += vbCrLf + "  		,CPCS,CGRSWT,ICOUNTERNAME"
        strSql += vbCrLf + "  		)"
        strSql += vbCrLf + "  		/** INSERTING GRAND TOT **/"
        strSql += vbCrLf + "  		SELECT 'GRAND TOT','ZZZZZ','ZZZZ','G',3"
        strSql += vbCrLf + "  		,SUM(OPCS),SUM(OGRSWT)"
        strSql += vbCrLf + "  		,SUM(RPCS),SUM(RGRSWT),SUM(RPCS_PA),SUM(RGRSWT_PA),SUM(RPCS_AP),SUM(RGRSWT_AP),SUM(RPCS_TR),SUM(RGRSWT_TR),SUM(RPCS_RE),SUM(RGRSWT_RE),SUM(RPCS_PU),SUM(RGRSWT_PU)"
        strSql += vbCrLf + "  		,SUM(IPCS),SUM(IGRSWT),SUM(IPCS_MI),SUM(IGRSWT_MI),SUM(IPCS_NT),SUM(IGRSWT_NT),SUM(IPCS_PA),SUM(IGRSWT_PA),SUM(IPCS_AP),SUM(IGRSWT_AP),SUM(IPCS_TR),SUM(IGRSWT_TR),SUM(IPCS_NTTT),SUM(IGRSWT_NTTT)"
        strSql += vbCrLf + "  		,SUM(CPCS),SUM(CGRSWT),''"
        strSql += vbCrLf + "  		FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES WHERE RESULT = 1"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "  	DROP TABLE TEMPMETALMAST"
        strSql += vbCrLf + "    DROP TABLE TEMPITEMMAST"
        strSql += vbCrLf + "    DROP TABLE TEMPCOMPANY"
        strSql += vbCrLf + "    DROP TABLE TEMPCOSTCENTRE"
        strSql += vbCrLf + "    UPDATE TEMPTABLEDB..TEMP_STOCKFLOW_RES  SET IGRSWT=NULL WHERE IGRSWT=0"
        strSql += vbCrLf + "    SELECT * FROM TEMPTABLEDB..TEMP_STOCKFLOW_RES       "
        strSql += vbCrLf + "    ORDER BY METAL,ICOUNTERNAME,RESULT,PARTICULAR"
        strSql += vbCrLf + "  END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
