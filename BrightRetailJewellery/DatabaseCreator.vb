        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  SELECT SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,''A'' AS APPROVAL,STNGRPID,CONVERT(VARCHAR,ISNULL(SEIVE,''''))SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & oldStockDb & "..OPENWEIGHT T WHERE TRANTYPE=''I'' AND STOCKTYPE=''S'' '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  AND ISNULL(APPROVAL,'''')=''A''   GROUP BY ACCODE,COMPANYID ,COSTID,STNGRPID,SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UNION ALL'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  SELECT -1*SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,''A'' AS APPROVAL,STNGRPID,CONVERT(VARCHAR,ISNULL(SEIVE,''''))SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & oldStockDb & "..RECEIPT T'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE ISNULL(CANCEL,'''') = ''''  AND TRANTYPE=''RAP'' '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  AND T.BATCHNO NOT IN (SELECT BATCHNO FROM " & oldStockDb & "..ACCTRAN)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  GROUP BY ACCODE,COMPANYID ,COSTID,STNGRPID,SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UNION ALL'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  SELECT SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,''A'' AS APPROVAL,STNGRPID,CONVERT(VARCHAR,ISNULL(SEIVE,''''))SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & oldStockDb & "..ISSUE T'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE  ISNULL(CANCEL,'''') = ''''  AND TRANTYPE=''IAP'' '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  AND T.BATCHNO NOT IN (SELECT BATCHNO FROM " & oldStockDb & "..ACCTRAN)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  GROUP BY ACCODE,COMPANYID ,COSTID,STNGRPID,SEIVE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  )X GROUP BY ACCODE,COMPANYID ,COSTID,APPROVAL,STNGRPID,SEIVE  HAVING SUM(AMOUNT)<>0 '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  INSERT INTO CBOOKSTOCK(CATCODE,ITEMID,SUBITEMID,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL,STNGRPID,SEIVE)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  SELECT CATCODE,ITEMID,SUBITEMID,''S'',0 PCS,GRSWT,NETWT,PUREWT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  ,COSTID,COMPANYID,TRANTYPE,ACCODE,''A'',STNGRPID,CONVERT(VARCHAR,ISNULL(SEIVE,''''))'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & oldStockDb & "..OPENWEIGHT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE STOCKTYPE = ''S'' AND APPROVAL=''A'''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UPDATE CBOOKSTOCK SET COSTID =  NULL WHERE COSTID='''''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UPDATE CBOOKSTOCK SET SNO =  ISNULL(COSTID,''00'') + ''FGM19'' + CONVERT(VARCHAR,TSNO) + ''0'''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  DELETE FROM " & newStockdb & "..OPENWEIGHT  WHERE ISNULL(TRANSFERED,'''') <> '''''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  INSERT INTO " & newStockdb & "..OPENWEIGHT(SNO,CATCODE,ITEMID,SUBITEMID,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,AMOUNT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL,TRANSFERED,STNGRPID,SEIVE)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  SELECT SNO,CATCODE,ITEMID,SUBITEMID,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,AMOUNT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL,''T''TRANSFERED'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  ,STNGRPID,CONVERT(VARCHAR,ISNULL(SEIVE,''''))SEIVE FROM CBOOKSTOCK C'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE NOT EXISTS(SELECT 1 FROM " & newStockdb & "..OPENWEIGHT WHERE ACCODE=C.ACCODE AND COMPANYID =C.COMPANYID AND COSTID=C.COSTID AND CATCODE=C.CATCODE AND STOCKTYPE=C.STOCKTYPE AND TRANTYPE=C.TRANTYPE)'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UPDATE " & newStockdb & "..SOFTCONTROLTRAN SET CTLTEXT = (sELECT MAX(TSNO) FROM CBOOKSTOCK) WHERE CTLID = ''OUTSTANDINGCODE'''"
        strSql += vbCrLf + " 	PRINT (@QRY)"
        strSql += vbCrLf + " 	EXEC (@QRY)"

        strSql += vbCrLf + " 	SELECT @QRY =  ''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  IF NOT(SELECT MAX(CONVERT(INT,CTLTEXT)) '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & newStockdb & "..BILLCONTROL'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE CTLTYPE = ''N'' ) > 0'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  BEGIN '"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UPDATE " & newStockdb & "..BILLCONTROL SET CTLMODE = O.CTLMODE'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & newStockdb & "..BILLCONTROL AS N'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  INNER JOIN " & oldStockDb & "..BILLCONTROL AS O'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  ON O.CTLID = N.CTLID AND O.COMPANYID = N.COMPANYID'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  UPDATE " & newStockdb & "..BILLCONTROL SET CTLTEXT = O.CTLTEXT'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  FROM " & newStockdb & "..BILLCONTROL AS N'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  INNER JOIN " & oldStockDb & "..BILLCONTROL AS O'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  ON O.CTLID = N.CTLID AND O.COMPANYID = N.COMPANYID'"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  WHERE N.CTLTYPE = ''B'''"
        strSql += vbCrLf + " 	SELECT @QRY = @QRY + CHAR(13) +'  END '"
        strSql += vbCrLf + "  	PRINT (@QRY)"
        strSql += vbCrLf + " 	EXEC (@QRY)"
        strSql += vbCrLf + "     END"
        strSql += vbCrLf + "  END /*Proc End"
        strSql += vbCrLf + " 	EXEC " & newStockdb & "..PROC_YEAREND_SEIVESTNGRP"
        strSql += vbCrLf + " 	@POTAG = 'Y',"
        strSql += vbCrLf + " 	@PONONTAG = 'Y',"
        strSql += vbCrLf + " 	@POORDERREPAIR = 'Y',"
        strSql += vbCrLf + " 	@POADVANCEDUE = 'Y',"
        strSql += vbCrLf + " 	@POTRAILBAL = 'Y',"
        strSql += vbCrLf + " 	@POSTOCK = 'Y',"
        strSql += vbCrLf + " 	@POAPPROVAL = 'Y',"
        strSql += vbCrLf + " 	@POTOBE = 'Y'"
        strSql += vbCrLf + "  */"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub YearEndProcess()
        STATUS = "Year End Posting.."
        funcProgressStep()
        Dim nonTagSno As Integer = Val(GetSqlValue("SELECT CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'NONTAGSNO'", , tran)) + 1
        Dim nonTagStoneSno As Integer = Val(GetSqlValue("SELECT CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'NONTAGSSTONENO'", , tran)) + 1

        Dim YEMISCFLAG As Boolean = IIf(GetSqlValue("SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID = 'YEMISCFLAG'", "N", tran) = "Y", True, False)

        Dim oldStockDb As String = compId + "T" + Mid(YEnd_frmDate.Year - 1, 3, 2) + Mid(YEnd_toDate.Year - 1, 3, 2)
        Dim newStockdb As String = compId + "T" + Mid(YEnd_frmDate.Year, 3, 2) + Mid(YEnd_toDate.Year, 3, 2)
        Dim newYear As Integer = Val(Mid(YEnd_toDate.Year, 3, 2))
        Dim oldYear As Integer = Val(Mid(YEnd_frmDate.Year, 3, 2))
        strSql = " IF OBJECT_ID('" & tranDbName & "..PROC_YEAREND') IS NOT NULL DROP PROCEDURE PROC_YEAREND"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = " CREATE PROCEDURE PROC_YEAREND"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "   @POTAG VARCHAR(1)"
        strSql += vbCrLf + "   ,@PONONTAG VARCHAR(1)"
        strSql += vbCrLf + "   ,@POORDERREPAIR VARCHAR(1)"
        strSql += vbCrLf + "   ,@POADVANCEDUE VARCHAR(1)"
        strSql += vbCrLf + "   ,@POTRAILBAL VARCHAR(1)"
        strSql += vbCrLf + "   ,@POSTOCK VARCHAR(1)"
        strSql += vbCrLf + "   ,@POAPPROVAL VARCHAR(1)"
        strSql += vbCrLf + "   ,@POTOBE VARCHAR(1)"
        strSql += vbCrLf + "   )"
        strSql += vbCrLf + "  AS"
        strSql += vbCrLf + "  BEGIN"
        strSql += vbCrLf + "  SET NOCOUNT ON"
        strSql += vbCrLf + "  DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + "  IF @POTRAILBAL = 'Y'"
        strSql += vbCrLf + "  BEGIN /* TRAIL BALANCE START */"
        strSql += vbCrLf + "  /** Opening TrailBal **/"
        strSql += vbCrLf + "   DECLARE @TPLCODE VARCHAR(7)"
        strSql += vbCrLf + "   DECLARE @OPNCODE VARCHAR(7)"
        strSql += vbCrLf + "  SELECT @TPLCODE = CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'TPLACODE'"
        strSql += vbCrLf + "  SELECT @OPNCODE = CTLTEXT FROM " & compId + suffix & "..SOFTCONTROL WHERE CTLID = 'TPLACODE'"
        strSql += vbCrLf + "  DELETE FROM " & newStockdb & "..OPENTRAILBALANCE  WHERE ISNULL(TRANSFERED,'') <> ''"
        strSql += vbCrLf + "  INSERT INTO " & newStockdb & "..OPENTRAILBALANCE"
        strSql += vbCrLf + "  (ACCODE,DEBIT,CREDIT,COSTID,COMPANYID,TRANSFERED)"
        strSql += vbCrLf + "  SELECT ACCODE,CASE WHEN AMOUNT > 0 THEN AMOUNT ELSE 0 END AS DEBIT"
        strSql += vbCrLf + "  ,CASE WHEN AMOUNT < 0 THEN -1*AMOUNT ELSE 0 END AS CREDIT"
        strSql += vbCrLf + "  ,COSTID,COMPANYID,'T'TRANSFERED"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT ACCODE,SUM(AMOUNT)AMOUNT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT ACCODE,DEBIT-CREDIT AMOUNT,COMPANYID,COSTID FROM " & oldStockDb & "..OPENTRAILBALANCE"
        strSql += vbCrLf + "  WHERE ACCODE NOT IN (SELECT ACCODE FROM " & compId + suffix & "..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId + suffix & "..ACGROUP WHERE GRPLEDGER IN('P','T')))"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT @OPNCODE,DEBIT-CREDIT AMOUNT,COMPANYID,COSTID FROM " & oldStockDb & "..OPENTRAILBALANCE"
        strSql += vbCrLf + "  WHERE ACCODE IN (SELECT ACCODE FROM " & compId + suffix & "..ACHEAD WHERE ACGRPCODE IN (SELECT ACGRPCODE FROM " & compId + suffix & "..ACGROUP WHERE GRPLEDGER IN('P','T')))"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT ACCODE,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ACCTRAN"
        strSql += vbCrLf + "  WHERE ACCODE NOT IN (SELECT ACCODE FROM " & compId + suffix & "..ACHEAD WHERE ACGRPCODE IN"
        strSql += vbCrLf + "  (SELECT ACGRPCODE FROM " & compId + suffix & "..ACGROUP WHERE GRPLEDGER IN('T','P')))"
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  GROUP BY ACCODE,COMPANYID,COSTID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT @OPNCODE,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ACCTRAN"
        strSql += vbCrLf + "  WHERE ACCODE IN (SELECT ACCODE FROM " & compId + suffix & "..ACHEAD WHERE ACGRPCODE IN"
        strSql += vbCrLf + "  (SELECT ACGRPCODE FROM " & compId + suffix & "..ACGROUP WHERE GRPLEDGER IN('T','P')))"
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  GROUP BY ACCODE,COMPANYID,COSTID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT ACCODE,SUM(CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_ACCTRAN"
        strSql += vbCrLf + "  WHERE ACCODE NOT IN (SELECT ACCODE FROM " & compId + suffix & "..ACHEAD WHERE ACGRPCODE IN"
        strSql += vbCrLf + "  (SELECT ACGRPCODE FROM " & compId + suffix & "..ACGROUP WHERE GRPLEDGER IN('P','T')))"
        strSql += vbCrLf + "  AND ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  GROUP BY ACCODE,COMPANYID,COSTID"
        strSql += vbCrLf + "  )Y GROUP BY ACCODE,COMPANYID,COSTID"
        strSql += vbCrLf + "  )X WHERE NOT EXISTS(SELECT 1 FROM " & newStockdb & "..OPENTRAILBALANCE WHERE COMPANYID=X.COMPANYID AND COSTID=X.COSTID AND ACCODE=X.ACCODE)"
        strSql += vbCrLf + "  END /* TRAIL BALANCE END */"
        strSql += vbCrLf + "  IF @POAPPROVAL = 'Y'"
        strSql += vbCrLf + "  BEGIN /* APPROVAL START */"
        strSql += vbCrLf + "   /** PENDING APPROVAL POSTING **/ "
        strSql += vbCrLf + "   DELETE FROM " & newStockdb & "..APPISSUE "
        strSql += vbCrLf + "   SELECT @QRY = 'INSERT INTO " & newStockdb & "..APPISSUE ('+" & newStockdb & ".DBO.GETCOLUMNS('APPISSUE')+',TRANSFERED)'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSUE')+',''Y'' TRANSFERED FROM " & oldStockDb & "..ISSUE '"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' WHERE TRANTYPE = ''AI'' AND ISNULL(CANCEL,'''') = '''' AND REFDATE IS NULL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSUE')+',''Y'' TRANSFERED FROM " & oldStockDb & "..APPISSUE '"
        strSql += vbCrLf + "   SELECT @QRY = @QRY + ' WHERE TRANTYPE = ''AI'' AND ISNULL(CANCEL,'''') = '''' AND REFDATE IS NULL'"
        strSql += vbCrLf + "   EXEC (@QRY)"
        strSql += vbCrLf + "  /** Inserting AppStone **/"
        strSql += vbCrLf + "  DELETE FROM " & newStockdb & "..APPISSSTONE"
        strSql += vbCrLf + "  SELECT @QRY = 'INSERT INTO " & newStockdb & "..APPISSSTONE ('+" & newStockdb & ".DBO.GETCOLUMNS('APPISSSTONE')+')'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSSTONE')+' FROM " & oldStockDb & "..ISSSTONE '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE ISSSNO IN (SELECT SNO FROM " & newStockdb & "..APPISSUE WHERE TRANTYPE = ''AI'' AND ISNULL(CANCEL,'''') = '''' AND REFDATE IS NULL)'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSSTONE')+' FROM " & oldStockDb & "..APPISSSTONE '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE ISSSNO IN (SELECT SNO FROM " & newStockdb & "..APPISSUE WHERE TRANTYPE = ''AI'' AND ISNULL(CANCEL,'''') = '''' AND REFDATE IS NULL)'"
        strSql += vbCrLf + "  EXEC (@QRY)"
        strSql += vbCrLf + "  /** Inserting Appmisc **/"
        strSql += vbCrLf + "  DELETE FROM " & newStockdb & "..APPISSMISC"
        strSql += vbCrLf + "  SELECT @QRY = 'INSERT INTO " & newStockdb & "..APPISSMISC ('+" & newStockdb & ".DBO.GETCOLUMNS('APPISSMISC')+')'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSMISC')+' FROM " & oldStockDb & "..ISSMISC '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE ISSSNO IN (SELECT SNO FROM " & newStockdb & "..APPISSUE)'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' UNION ALL'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' SELECT'+" & newStockdb & ".DBO.GETCOLUMNS('APPISSMISC')+' FROM " & oldStockDb & "..APPISSMISC '"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + ' WHERE ISSSNO IN (SELECT SNO FROM " & newStockdb & "..APPISSUE)'"
        strSql += vbCrLf + "  EXEC (@QRY)"
        strSql += vbCrLf + "  END /* APPROVAL END */"

        strSql += vbCrLf + "  IF @POSTOCK = 'Y'"
        strSql += vbCrLf + "  BEGIN /* STOCK CHECKING START */"
        strSql += vbCrLf + "  /** Inserting BookStock **/"
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#CBOOKSTOCK') IS NOT NULL DROP TABLE #CBOOKSTOCK"
        strSql += vbCrLf + "  SELECT CONVERT(VARCHAR(15),NULL)SNO,CATCODE,'C'STOCKTYPE"
        strSql += vbCrLf + "  ,CASE WHEN SUM(PCS) > 0 THEN SUM(PCS) ELSE -1*SUM(PCS) END PCS"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT) > 0 THEN SUM(GRSWT) ELSE -1*SUM(GRSWT) END GRSWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(NETWT) > 0 THEN SUM(NETWT) ELSE -1*SUM(NETWT) END NETWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(PUREWT) > 0 THEN SUM(PUREWT) ELSE -1*SUM(PUREWT) END PUREWT"
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),NULL)AMOUNT"
        strSql += vbCrLf + "  ,COSTID,COMPANYID"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT)>0 THEN 'R' ELSE 'I' END AS TRANTYPE"
        strSql += vbCrLf + "  ,IDENTITY (INT,1,1)TSNO,CONVERT(VARCHAR(7),NULL)ACCODE"
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(1),NULL)APPROVAL"
        strSql += vbCrLf + "  INTO #CBOOKSTOCK"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT CATCODE"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN PCS ELSE -1*PCS END AS PCS"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN GRSWT ELSE -1*GRSWT END AS GRSWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN NETWT ELSE -1*NETWT END AS NETWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN PUREWT ELSE -1*PUREWT END AS PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..OPENWEIGHT"
        strSql += vbCrLf + "  WHERE STOCKTYPE = 'C'"
        strSql += vbCrLf + "  UNION ALL "
        strSql += vbCrLf + "  SELECT CATCODE,-1*PCS,-1*GRSWT,-1*NETWT,-1*PUREWT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSUE WHERE ISNULL(CANCEL,'') = '' AND BATCHNO NOT IN(SELECT BATCHNO FROM " & oldStockDb & "..ISSUE WHERE TRANTYPE IN('OD','RD'))"
        strSql += vbCrLf + "  AND TRANTYPE<>'IRC'"
        strSql += vbCrLf + "  AND SNO NOT IN (SELECT DISTINCT ISSSNO FROM " & oldStockDb & "..ISSMETAL) "
        strSql += vbCrLf + "  UNION ALL "
        strSql += vbCrLf + "  SELECT I.CATCODE,-1*ISS.PCS,-1*I.GRSWT,-1*I.GRSWT,-1*I.GRSWT,I.COMPANYID,I.COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSMETAL AS I"
        strSql += vbCrLf + "  INNER JOIN " & oldStockDb & "..ISSUE ISS ON I.ISSSNO=ISS.SNO "
        strSql += vbCrLf + "  WHERE ISNULL(CANCEL,'') = '' AND ISS.BATCHNO NOT IN(SELECT BATCHNO FROM " & oldStockDb & "..ISSUE WHERE TRANTYPE IN('OD','RD'))"
        strSql += vbCrLf + "  AND ISS.TRANTYPE<>'IRC'   "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,-1*PCS,-1*GRSWT,-1*NETWT,-1*PUREWT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSUE WHERE ISNULL(CANCEL,'') = '' AND TRANTYPE='OD'"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,-1*PCS,-1*GRSWT,-1*NETWT,-1*PUREWT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_ISSUE WHERE ISNULL(CANCEL,'') = '' AND ISNULL(TRANTYPE,'') NOT IN('OD') "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,PCS,GRSWT,NETWT,PUREWT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPT WHERE ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  AND TRANTYPE<>'RRC'"
        strSql += vbCrLf + "  AND SNO NOT IN (SELECT DISTINCT ISSSNO FROM " & oldStockDb & "..RECEIPTMETAL) "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT I.CATCODE,ISS.PCS,I.GRSWT,I.GRSWT,I.GRSWT,I.COMPANYID,I.COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPTMETAL AS I"
        strSql += vbCrLf + "  INNER JOIN " & oldStockDb & "..RECEIPT AS ISS ON I.ISSSNO=ISS.SNO"
        strSql += vbCrLf + "  WHERE ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  AND ISS.TRANTYPE<>'RRC' "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,PCS,GRSWT,NETWT,PUREWT,COMPANYID,COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_RECEIPT WHERE ISNULL(CANCEL,'') = ''"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT I.CATCODE,-1*STNPCS AS PCS,-1*STNWT AS GRSWT,-1*STNWT AS NETWT,-1*STNWT AS PUREWT,I.COMPANYID,I.COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSSTONE I INNER JOIN " & oldStockDb & "..ISSUE ISS ON ISS.SNO=I.ISSSNO  AND ISS.BATCHNO=I.BATCHNO "
        strSql += vbCrLf + "  WHERE ISNULL(ISS.CANCEL,'') = '' /*AND ISNULL(ISS.TRANTYPE,'') NOT IN('OD') */"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT R.CATCODE,R.STNPCS AS PCS,R.STNWT AS GRSWT,R.STNWT AS NETWT,R.STNWT AS PUREWT,R.COMPANYID,R.COSTID"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPTSTONE R INNER JOIN " & oldStockDb & "..RECEIPT RE ON RE.SNO=R.ISSSNO  AND RE.BATCHNO=R.BATCHNO  "
        strSql += vbCrLf + "  WHERE ISNULL(RE.CANCEL,'') = ''"
        strSql += vbCrLf + "  )X"
        strSql += vbCrLf + "  GROUP BY CATCODE,COSTID,COMPANYID"
        strSql += vbCrLf + "  /** Inserting Smith Balance Weight**/"
        strSql += vbCrLf + "  INSERT INTO #CBOOKSTOCK(CATCODE,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,COSTID,COMPANYID,TRANTYPE,ACCODE)"
        strSql += vbCrLf + "  SELECT CATCODE,'S'STOCKTYPE,0 PCS"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT) > 0 THEN SUM(GRSWT) ELSE -1*SUM(GRSWT) END GRSWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(NETWT) > 0 THEN SUM(NETWT) ELSE -1*SUM(NETWT) END NETWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(PUREWT)> 0 THEN SUM(PUREWT) ELSE -1*SUM(PUREWT) END PUREWT"
        strSql += vbCrLf + "  ,COSTID,COMPANYID"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT)>0 THEN 'R' ELSE 'I' END AS TRANTYPE"
        strSql += vbCrLf + "  ,ACCODE"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT CATCODE"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN GRSWT ELSE -1*GRSWT END AS GRSWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN NETWT ELSE -1*NETWT END AS NETWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE = 'R' THEN PUREWT ELSE -1*PUREWT END AS PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..OPENWEIGHT "
        strSql += vbCrLf + "  WHERE STOCKTYPE = 'S' AND ISNULL(APPROVAL,'')=''"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,-1*(GRSWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)-ISNULL(WASTAGE,0) ELSE 0 END)GRSWT"
        strSql += vbCrLf + "  ,-1*(NETWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)-ISNULL(WASTAGE,0) ELSE 0 END)NETWT"
        strSql += vbCrLf + "  ,-1*PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSUE WHERE ISNULL(CANCEL,'') = '' AND (LEN(TRANTYPE)>2  OR TRANTYPE='MI') "
        strSql += vbCrLf + "  AND TRANTYPE NOT IN ('IPU','RPU','RAP','IAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,GRSWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END AS GRSWT"
        strSql += vbCrLf + "  ,NETWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END AS NETWT,PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPT WHERE ISNULL(CANCEL,'') = '' AND LEN(TRANTYPE)>2 AND TRANTYPE NOT IN ('IPU','RPU','RAP','IAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT S.CATCODE,-1*(STNWT)GRSWT,-1*(STNWT) AS NETWT,-1*(STNWT) AS PUREWT"
        strSql += vbCrLf + "  ,I.COMPANYID,I.COSTID,I.ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSSTONE S "
        strSql += vbCrLf + "  LEFT JOIN " & oldStockDb & "..ISSUE I ON I.SNO=S.ISSSNO "
        strSql += vbCrLf + "  WHERE ISNULL(I.CANCEL,'') = '' AND (LEN(I.TRANTYPE)>2  OR I.TRANTYPE='MI') AND I.TRANTYPE NOT IN ('IPU','RPU','RAP','IAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT S.CATCODE,STNWT AS GRSWT,STNWT AS NETWT,STNWT AS PUREWT"
        strSql += vbCrLf + "  ,R.COMPANYID,R.COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPTSTONE S  "
        strSql += vbCrLf + "  LEFT JOIN " & oldStockDb & "..RECEIPT R ON R.SNO=S.ISSSNO WHERE ISNULL(R.CANCEL,'') = '' AND LEN(R.TRANTYPE)>2 AND R.TRANTYPE NOT IN ('IPU','RPU','RAP','IAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,-1*PUREWT AS GRSWT,-1*PUREWT AS NETWT,-1*PUREWT AS PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_ISSUE WHERE ISNULL(CANCEL,'') = '' "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,PUREWT AS GRSWT,PUREWT AS NETWT,PUREWT AS PUREWT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_RECEIPT WHERE ISNULL(CANCEL,'') = '' "
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT T.CATCODE,T.STNWT AS GRSWT,T.STNWT AS NETWT,T.STNWT AS PUREWT"
        strSql += vbCrLf + "  ,R.COMPANYID,R.COSTID,R.ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..W_RECEIPTSTONE AS T"
        strSql += vbCrLf + "  INNER JOIN " & oldStockDb & "..W_RECEIPT AS R ON R.SNO = T.ISSSNO AND ISNULL(R.CANCEL,'') = '' "
        strSql += vbCrLf + "  )X"
        strSql += vbCrLf + "  GROUP BY CATCODE,COSTID,COMPANYID,ACCODE"
        strSql += vbCrLf + "  /** Inserting Smith Approval Balance **/"
        strSql += vbCrLf + "  INSERT INTO #CBOOKSTOCK(CATCODE,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL)"
        strSql += vbCrLf + "  SELECT CATCODE,'S'STOCKTYPE,0 PCS"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT) > 0 THEN SUM(GRSWT) ELSE -1*SUM(GRSWT) END GRSWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(NETWT) > 0 THEN SUM(NETWT) ELSE -1*SUM(NETWT) END NETWT"
        strSql += vbCrLf + "  ,CASE WHEN SUM(PUREWT)> 0 THEN SUM(PUREWT) ELSE -1*SUM(PUREWT) END PUREWT"
        strSql += vbCrLf + "  ,COSTID,COMPANYID"
        strSql += vbCrLf + "  ,CASE WHEN SUM(GRSWT)>0 THEN 'R' ELSE 'I' END AS TRANTYPE"
        strSql += vbCrLf + "  ,ACCODE"
        strSql += vbCrLf + "  ,'A' AS APPROVAL"
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT CATCODE,-1*(GRSWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)-ISNULL(WASTAGE,0) ELSE 0 END)GRSWT"
        strSql += vbCrLf + "  ,-1*(NETWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)-ISNULL(WASTAGE,0) ELSE 0 END)NETWT"
        strSql += vbCrLf + "  ,-1*PUREWT AS PUREWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE='IAP' THEN -1*AMOUNT ELSE 0 END AMOUNT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSUE WHERE ISNULL(CANCEL,'') = '' AND LEN(TRANTYPE)>2  "
        strSql += vbCrLf + "  AND TRANTYPE IN ('IAP','RAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT CATCODE,GRSWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END AS GRSWT"
        strSql += vbCrLf + "  ,NETWT+CASE WHEN TRANTYPE<>'MI' THEN ISNULL(ALLOY,0)+ISNULL(WASTAGE,0) ELSE 0 END AS NETWT,PUREWT"
        strSql += vbCrLf + "  ,CASE WHEN TRANTYPE='RAP' THEN AMOUNT ELSE 0 END AMOUNT"
        strSql += vbCrLf + "  ,COMPANYID,COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPT WHERE ISNULL(CANCEL,'') = '' AND LEN(TRANTYPE)>2 AND TRANTYPE IN ('IAP','RAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT S.CATCODE,-1*(STNWT)GRSWT,-1*(STNWT) AS NETWT,-1*(STNWT) AS PUREWT"
        strSql += vbCrLf + "  ,0 AMOUNT"
        strSql += vbCrLf + "  ,I.COMPANYID,I.COSTID,I.ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSSTONE S "
        strSql += vbCrLf + "  LEFT JOIN " & oldStockDb & "..ISSUE I ON I.SNO=S.ISSSNO "
        strSql += vbCrLf + "  WHERE ISNULL(I.CANCEL,'') = '' AND LEN(I.TRANTYPE)>2   AND I.TRANTYPE IN ('IAP','RAP')"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT S.CATCODE,STNWT AS GRSWT,STNWT AS NETWT,STNWT AS PUREWT"
        strSql += vbCrLf + "  ,0 AMOUNT"
        strSql += vbCrLf + "  ,R.COMPANYID,R.COSTID,ACCODE"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPTSTONE S  "
        strSql += vbCrLf + "  LEFT JOIN " & oldStockDb & "..RECEIPT R ON R.SNO=S.ISSSNO WHERE ISNULL(R.CANCEL,'') = '' AND LEN(R.TRANTYPE)>2 AND R.TRANTYPE IN ('IAP','RAP')"
        strSql += vbCrLf + "  )X"
        strSql += vbCrLf + "  GROUP BY CATCODE,COSTID,COMPANYID,ACCODE"
        strSql += vbCrLf + "  /** Inserting Smith Balance Amount **/"
        strSql += vbCrLf + "  INSERT INTO #CBOOKSTOCK(AMOUNT,ACCODE,STOCKTYPE,COSTID,COMPANYID,APPROVAL,TRANTYPE)"
        strSql += vbCrLf + "  SELECT ABS(SUM(AMOUNT))AMOUNT,ACCODE,'S',COSTID,COMPANYID,APPROVAL"
        strSql += vbCrLf + "  ,CASE WHEN SUM(AMOUNT)>0 THEN 'I' ELSE 'R' END AS TRANTYPE FROM("
        strSql += vbCrLf + "  SELECT -1*SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,'A' AS APPROVAL"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..OPENWEIGHT T WHERE TRANTYPE='R' AND STOCKTYPE='S' "
        strSql += vbCrLf + "  AND ISNULL(APPROVAL,'')='A'   GROUP BY ACCODE,COMPANYID ,COSTID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,'A' AS APPROVAL"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..OPENWEIGHT T WHERE TRANTYPE='I' AND STOCKTYPE='S' "
        strSql += vbCrLf + "  AND ISNULL(APPROVAL,'')='A'   GROUP BY ACCODE,COMPANYID ,COSTID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT -1*SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,'A' AS APPROVAL"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..RECEIPT T"
        strSql += vbCrLf + "  WHERE ISNULL(CANCEL,'') = ''  AND TRANTYPE='RAP' "
        strSql += vbCrLf + "  AND T.BATCHNO NOT IN (SELECT BATCHNO FROM " & oldStockDb & "..ACCTRAN)"
        strSql += vbCrLf + "  GROUP BY ACCODE,COMPANYID ,COSTID"
        strSql += vbCrLf + "  UNION ALL"
        strSql += vbCrLf + "  SELECT SUM(AMOUNT) AMOUNT  ,T.ACCODE ,COMPANYID,COSTID,'A' AS APPROVAL"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..ISSUE T"
        strSql += vbCrLf + "  WHERE  ISNULL(CANCEL,'') = ''  AND TRANTYPE='IAP' "
        strSql += vbCrLf + "  AND T.BATCHNO NOT IN (SELECT BATCHNO FROM " & oldStockDb & "..ACCTRAN)"
        strSql += vbCrLf + "  GROUP BY ACCODE,COMPANYID ,COSTID"
        strSql += vbCrLf + "  )X GROUP BY ACCODE,COMPANYID ,COSTID,APPROVAL  HAVING SUM(AMOUNT)<>0 "
        strSql += vbCrLf + "  INSERT INTO #CBOOKSTOCK(CATCODE,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL)"
        strSql += vbCrLf + "  SELECT CATCODE,'S',0 PCS,GRSWT,NETWT,PUREWT"
        strSql += vbCrLf + "  ,COSTID,COMPANYID,TRANTYPE,ACCODE,'A'"
        strSql += vbCrLf + "  FROM " & oldStockDb & "..OPENWEIGHT"
        strSql += vbCrLf + "  WHERE STOCKTYPE = 'S' AND APPROVAL='A'"
        strSql += vbCrLf + "  UPDATE #CBOOKSTOCK SET COSTID =  NULL WHERE COSTID=''"
        strSql += vbCrLf + "  UPDATE #CBOOKSTOCK SET SNO =  ISNULL(COSTID,'00') + '" & compId & "" & oldYear & "' + CONVERT(VARCHAR,TSNO) + '0'"
        strSql += vbCrLf + "  DELETE FROM " & newStockdb & "..OPENWEIGHT  WHERE ISNULL(TRANSFERED,'') <> ''"
        strSql += vbCrLf + "  INSERT INTO " & newStockdb & "..OPENWEIGHT(SNO,CATCODE,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,AMOUNT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL,TRANSFERED)"
        strSql += vbCrLf + "  SELECT SNO,CATCODE,STOCKTYPE,PCS,GRSWT,NETWT,PUREWT,AMOUNT,COSTID,COMPANYID,TRANTYPE,ACCODE,APPROVAL,'T'TRANSFERED FROM #CBOOKSTOCK C"
        strSql += vbCrLf + "  WHERE NOT EXISTS(SELECT 1 FROM " & newStockdb & "..OPENWEIGHT WHERE ACCODE=C.ACCODE AND COMPANYID =C.COMPANYID AND COSTID=C.COSTID AND CATCODE=C.CATCODE AND STOCKTYPE=C.STOCKTYPE AND TRANTYPE=C.TRANTYPE)"
        strSql += vbCrLf + "  UPDATE " & newStockdb & "..SOFTCONTROLTRAN SET CTLTEXT = (sELECT MAX(TSNO) FROM #CBOOKSTOCK) WHERE CTLID = 'OUTSTANDINGCODE'"
        strSql += vbCrLf + "  END /* BOOK STOCK END */"
        strSql += vbCrLf + "  IF NOT(SELECT MAX(CONVERT(INT,CTLTEXT)) "
        strSql += vbCrLf + "  FROM " & newStockdb & "..BILLCONTROL"
        strSql += vbCrLf + "  WHERE CTLTYPE = 'N' ) > 0"
        strSql += vbCrLf + "  BEGIN "
        strSql += vbCrLf + "  UPDATE " & newStockdb & "..BILLCONTROL SET CTLMODE = O.CTLMODE"
        strSql += vbCrLf + "  FROM " & newStockdb & "..BILLCONTROL AS N"
        strSql += vbCrLf + "  INNER JOIN " & oldStockDb & "..BILLCONTROL AS O"
        strSql += vbCrLf + "  ON O.CTLID = N.CTLID AND O.COMPANYID = N.COMPANYID"
        strSql += vbCrLf + "  UPDATE " & newStockdb & "..BILLCONTROL SET CTLTEXT = O.CTLTEXT"
        strSql += vbCrLf + "  FROM " & newStockdb & "..BILLCONTROL AS N"
        strSql += vbCrLf + "  INNER JOIN " & oldStockDb & "..BILLCONTROL AS O"
        strSql += vbCrLf + "  ON O.CTLID = N.CTLID AND O.COMPANYID = N.COMPANYID"
        strSql += vbCrLf + "  WHERE N.CTLTYPE = 'B'"
        strSql += vbCrLf + "  END"
        strSql += vbCrLf + "  END /*Proc End*/"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_UPDATE_SNO()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_UPDATE_SNO')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_UPDATE_SNO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_UPDATE_SNO"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @PROCNAME VARCHAR(100)"
        strSql += vbCrLf + " ,@PROCDBNAME VARCHAR(100)"
        strSql += vbCrLf + " ,@CTLID VARCHAR(100)"
        strSql += vbCrLf + " ,@CHECK_TABLENAME VARCHAR(100)"
        strSql += vbCrLf + " ,@UPD_DBNAME VARCHAR(20)"
        strSql += vbCrLf + " ,@UPD_TABLENAME VARCHAR(100)"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " DECLARE @STR VARCHAR(8000)"
        strSql += vbCrLf + " SET @STR = '"
        strSql += vbCrLf + " DECLARE @CUR_SNO VARCHAR(15)"
        strSql += vbCrLf + " DECLARE CUR CURSOR"
        strSql += vbCrLf + " FOR SELECT ISNULL(SNO,'''') FROM '+@UPD_DBNAME+'..'+@UPD_TABLENAME+'"
        strSql += vbCrLf + " OPEN CUR"
        strSql += vbCrLf + " WHILE 1=1"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	FETCH NEXT FROM CUR INTO @CUR_SNO"
        strSql += vbCrLf + " 	IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + " 	DECLARE @NEW_SNO VARCHAR(15) "
        strSql += vbCrLf + " 	DECLARE @COSTID VARCHAR(2)"
        strSql += vbCrLf + " 	DECLARE @COMPANYID VARCHAR(3)"
        strSql += vbCrLf + " 	SELECT @COSTID = COSTID,@COMPANYID = COMPANYID FROM '+@UPD_DBNAME+'..'+@UPD_TABLENAME+' WHERE SNO = @CUR_SNO"
        strSql += vbCrLf + " 	EXEC '+@PROCDBNAME+'..'+@PROCNAME+'"
        strSql += vbCrLf + " 	@COSTID = @COSTID"
        strSql += vbCrLf + " 	,@CTLID = '''+@CTLID+'''"
        strSql += vbCrLf + " 	,@CHECKTABLENAME = '''+@CHECK_TABLENAME+'''"
        strSql += vbCrLf + " 	,@COMPANYID = @COMPANYID"
        strSql += vbCrLf + " 	,@RETVALUE = @NEW_SNO OUTPUT"
        strSql += vbCrLf + " 	UPDATE '+@UPD_DBNAME+'..'+@UPD_TABLENAME+' SET SNO = @NEW_SNO WHERE CURRENT OF CUR"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " CLOSE CUR"
        strSql += vbCrLf + " DEALLOCATE CUR'"
        strSql += vbCrLf + " EXEC (@STR)"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SP_RPT_CLOSINGSTOCK_LIFO()
        strSql = " IF(SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CLOSINGSTOCK_LIFO')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CLOSINGSTOCK_LIFO"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE SP_CLOSINGSTOCK_LIFO"
        strSql += vbCrLf + "(    "
        strSql += vbCrLf + "@DBNAME VARCHAR(15)    "
        strSql += vbCrLf + ",@ADMINDB VARCHAR(15)    "
        strSql += vbCrLf + ",@FRMDATE VARCHAR(25)"
        strSql += vbCrLf + ",@TODATE VARCHAR(25)"
        strSql += vbCrLf + ",@METALNAME VARCHAR(200)       "
        strSql += vbCrLf + ",@CATCODE VARCHAR(200)       "
        strSql += vbCrLf + ",@CATNAME VARCHAR(200)       "
        strSql += vbCrLf + ",@COSTNAME VARCHAR(200)       "
        strSql += vbCrLf + ",@COMPANYID VARCHAR(3)    "
        strSql += vbCrLf + ",@RPTTYPE VARCHAR(1)      "
        strSql += vbCrLf + ",@SYSTEMID VARCHAR(20)     "
        strSql += vbCrLf + ")    "
        strSql += vbCrLf + "AS    "
        strSql += vbCrLf + "BEGIN     "
        strSql += vbCrLf + "    DECLARE @QRY VARCHAR(8000)    "
        strSql += vbCrLf + "    DECLARE @TB1 VARCHAR(50) "
        strSql += vbCrLf + "    DECLARE @TB2 VARCHAR(50) "
        strSql += vbCrLf + "    SET @TB1 ='TEMPTABLEDB..TEMPCOSTCENTRE'+@SYSTEMID"
        strSql += vbCrLf + "    SET @TB2 ='TEMPTABLEDB..TEMPCATEGORY'+@SYSTEMID"
        strSql += vbCrLf + "    PRINT @TB2"
        strSql += vbCrLf + "    SET @QRY = ' IF OBJECT_ID(''TEMPTABLEDB..TEMPCOSTCENTRE'+ @SYSTEMID+''',''U'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPCOSTCENTRE'+ @SYSTEMID"
        strSql += vbCrLf + "    PRINT @QRY"
        strSql += vbCrLf + "    EXEC (@QRY)"
