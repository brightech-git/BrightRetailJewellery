        strSql += vbCrLf + "  SELECT @STRQRY =' IF OBJECT_ID(''TEMPTABLEDB..TESTEXCEL'+@SYSTEMID+''')IS NOT NULL DROP TABLE TEMPTABLEDB..TESTEXCEL'+@SYSTEMID+''  "
