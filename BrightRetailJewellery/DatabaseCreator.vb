        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' STATE,COUNTRY,PINCODE,PHONENO PHONERES,MOBILE,EMAILID EMAIL,FAX,PREVILEGEID,'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' CASE RELIGION WHEN ''H'' THEN ''Hindu'' WHEN ''C'' THEN ''Christian'''"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' WHEN ''M'' THEN ''Muslim'' WHEN ''S'' THEN ''Sikh'' ELSE ''Others'' END RELIGION'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' ,DOBIRTH ,ANNIVERSARY'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' FROM '+@ADMINDB+'..ACHEAD A'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' LEFT JOIN '+@ADMINDB+'..CITYMAST C ON A.CITY=C.CITYNAME'"
        strSql += vbCrLf + "  SELECT @QRY = @QRY + CHAR(13) + ' WHERE ACTYPE IN (SELECT COMPANYID FROM TEMPACTYPE)'"
        strSql += vbCrLf + "  IF @AREA <> 'ALL' AND @AREA <> ''"
