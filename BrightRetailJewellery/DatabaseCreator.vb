        strSql += vbCrLf + " SELECT @QRY = @QRY + CHAR(13) +' ,ISNULL((SELECT SUM(STNWT) FROM RECEIPTSTONE WHERE ISSSNO = I.SNO AND STNITEMID IN (SELECT ITEMID FROM " & cnAdminDb & "..ITEMMAST WHERE DIASTONE = ''D'')),0) DIAWT'               "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(NUMERIC(15,2),NULL) ED'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')<>''Y'' AND TRANTYPE=''PU'')AS CGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')<>''Y'' AND TRANTYPE=''PU'')AS SGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=I.BATCHNO AND ISSSNO=I.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,''N'')<>''Y'' AND TRANTYPE=''PU'')AS IGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(I.TAX)TAX'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(I.AMOUNT)AS AMOUNT ,SUM(I.AMOUNT - ISNULL(I.TAX,0)) AS TOTAL,P.ACCODE AS ACCODE'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,P.PNAME AS CUSTOMER,P.DOORNO,P.ADDRESS1,P.ADDRESS2,P.ADDRESS3,P.AREA,P.CITY,P.STATE,P.COUNTRY,P.MOBILE,P.GSTNO,P.PAN'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,I.BATCHNO,CONVERT(INT,10)RESULT,CONVERT(VARCHAR(2),NULL)COLHEAD'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(100),NULL) AS PARTICULAR,CONVERT(INT,1)AS CRESULT,CONVERT(VARCHAR(300),NULL)GROUP0'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(300),NULL)GROUP1,I.TRANDATE'        "
        strSql += vbCrLf + "    IF @WITHADDR='Y'        "
        strSql += vbCrLf + "        SELECT @QRY = @QRY + CHAR(13) +' ,CT.SHORTNAME ,I.BILLPREFIX'        "
        strSql += vbCrLf + "    ELSE        "
        strSql += vbCrLf + "        SELECT @QRY = @QRY + CHAR(13) +' ,NULL AS SHORTNAME,I.BILLPREFIX '        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INTO TEMPTABLEDB..TEMPTRANDET_PURCHASE '          "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM ..RECEIPT AS I LEFT OUTER JOIN " & cnAdminDb & "..CATEGORY AS CT ON CT.CATCODE = I.CATCODE'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO '        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = C.PSNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' WHERE I.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND I.TRANTYPE = ''PU'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.COMPANYID,'''') IN (SELECT COMPANYID FROM TEMPTABLEDB..TEMPCOMPANY)'        "
        strSql += vbCrLf + "    IF @CASH<>'ALL' SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.CASHID,'''') IN (SELECT CASHID FROM TEMPTABLEDB..TEMPCASHCOUNTER)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.SYSTEMID,'''') IN (SELECT SYSTEMID FROM TEMPTABLEDB..TEMPSYSTEM)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPTABLEDB..TEMPCOSTCENTRE) '        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(I.CANCEL,'''') = '''''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' GROUP BY I.SNO,I.TRANNO,I.BILLPREFIX,P.PNAME,I.BATCHNO,P.ACCODE,I.TRANDATE,CT.SHORTNAME'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,P.DOORNO,P.ADDRESS1,P.ADDRESS2,P.ADDRESS3,P.AREA,P.CITY,P.STATE,P.COUNTRY,P.MOBILE,P.GSTNO,P.PAN'        "
        strSql += vbCrLf + "    IF @WITHADDR='Y'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,I.ITEMID'        "
        strSql += vbCrLf + "    IF @GST='Y'        "
        strSql += vbCrLf + "        SELECT @QRY = @QRY + CHAR(13) +' ,CT.CATNAME'        "
        strSql += vbCrLf + "    ELSE        "
        strSql += vbCrLf + "        SELECT @QRY = @QRY + CHAR(13) +' ,CT.VATNAME'        "
        strSql += vbCrLf + "    PRINT @QRY        "
        strSql += vbCrLf + "    EXEC (@QRY)        "
        strSql += vbCrLf + "    SELECT @QRY = ' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPTRANDET_PURCHASE)>0'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' BEGIN'        "
        strSql += vbCrLf + "    /** INSERTING TITLE **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET_PURCHASE(CATNAME,PARTICULAR,RESULT,COLHEAD,GROUP0,GROUP1,CRESULT,DIAWT)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT CATNAME,CATNAME + '' ['' + CONVERT(VARCHAR,CONVERT(NUMERIC(15,2),SUM(TOTAL)))+'']'' PARTICULAR'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,0 RESULT,''T1''COLHEAD,''PURCHASE DETAILS'',CATNAME AS GROUP1,0 CRESULT,0 DIAWT'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPTRANDET_PURCHASE WHERE RESULT = 10 GROUP BY CATNAME'        "
        strSql += vbCrLf + "    /** INSERTING CATNAME TOTAL **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET_PURCHASE(CATNAME,PARTICULAR,RESULT,COLHEAD'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TOTAL,CRESULT,GROUP1,GROUP0)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT CATNAME,CATNAME + '' TOTAL'' AS PARTICULAR,0 RESULT,''S1''COLHEAD'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT),SUM(CGST)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(SGST),SUM(IGST),SUM(ED),SUM(TAX),SUM(TOTAL),2 CRESULT,CATNAME,''PURCHASE DETAILS'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPTRANDET_PURCHASE WHERE RESULT = 10 GROUP BY CATNAME'        "
        strSql += vbCrLf + "    /** UPDATE INFO TO PARTICULAR **/  "
        strSql += vbCrLf + "    IF @CATPREFIX='Y'  "
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "        IF @WITHBILLPREFIX ='Y'"
        strSql += vbCrLf + " 		   BEGIN       "
        strSql += vbCrLf + " 		   SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_PURCHASE SET PARTICULAR = ISNULL(BILLPREFIX,'''') + '' - ''+ISNULL(SHORTNAME,'''')+''-''+CONVERT(VARCHAR,TRANNO) WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'        "
        strSql += vbCrLf + " 		   END "
        strSql += vbCrLf + " 		   ELSE"
        strSql += vbCrLf + " 		   BEGIN"
        strSql += vbCrLf + " 		   SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_PURCHASE SET PARTICULAR = ISNULL(SHORTNAME,'''')+''-''+CONVERT(VARCHAR,TRANNO) WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'        "
        strSql += vbCrLf + " 		   END"
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    ELSE"
        strSql += vbCrLf + "    BEGIN     "
        strSql += vbCrLf + "        IF @WITHBILLPREFIX ='Y'          "
        strSql += vbCrLf + " 		   BEGIN    "
        strSql += vbCrLf + " 		   SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_PURCHASE SET PARTICULAR = ISNULL(BILLPREFIX,'''') + '' - ''+CONVERT(VARCHAR,TRANNO) WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'        "
        strSql += vbCrLf + " 		   END "
        strSql += vbCrLf + " 		   ELSE"
        strSql += vbCrLf + " 		   BEGIN"
        strSql += vbCrLf + " 		   SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_PURCHASE SET PARTICULAR = ''  ''+CONVERT(VARCHAR,TRANNO) WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'        "
        strSql += vbCrLf + " 	   END  "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    /** INSERT SALES RECORDS INTO TEMPTRANDETAIL **/        "
        strSql += vbCrLf + "    /** TITLE **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET(PARTICULAR,COLHEAD,TYPE,GROUP0,DIAWT)VALUES(''PURCHASE DETAILS'',''T'',''-'',''PURCHASE DETAILS'',0)'        "
        strSql += vbCrLf + "    /** TRAN **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,ACCODE,CUSTOMER'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,STATE,CITY,COUNTRY,MOBILE,GSTNO,PAN,HSN,TRANDATE'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,TRANNO,BATCHNO,COLHEAD,TYPE,GROUP0,GROUP1)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,TAX,TOTAL,ACCODE,CUSTOMER'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,DOORNO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,STATE,CITY,COUNTRY,MOBILE,GSTNO,PAN,HSN,TRANDATE'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,TRANNO,BATCHNO,COLHEAD,''-''TYPE,''PURCHASE DETAILS'',CATNAME FROM TEMPTABLEDB..TEMPTRANDET_PURCHASE AS S'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ORDER BY (SELECT METALID FROM " & cnAdminDb & "..CATEGORY WHERE CATNAME=S.CATNAME),CATNAME,CRESULT,RESULT,TRANNO'        "
        strSql += vbCrLf + "    /** SALES TOTAL **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET(PARTICULAR,PCS,GRSWT,NETWT,DIAWT,AMOUNT,CGST,SGST,IGST,ED,TAX,TOTAL,COLHEAD,TYPE,GROUP0)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT ''PURCHASE [PU]'',SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(DIAWT),SUM(AMOUNT),SUM(CGST),SUM(SGST),SUM(IGST),SUM(ED),SUM(TAX),SUM(TOTAL),''S''COLHEAD,''-''TYPE,''PURCHASE DETAILS'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPTRANDET_PURCHASE WHERE RESULT = 10'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' END'        "
        strSql += vbCrLf + "    PRINT @QRY        "
        strSql += vbCrLf + "    EXEC (@QRY)            "
        strSql += vbCrLf + "    SELECT @QRY = ' SELECT PAYMODE ,SUM(CASE WHEN TRANMODE = ''D'' THEN AMOUNT ELSE -1*AMOUNT END) AS AMOUNT'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INTO TEMPTABLEDB..TEMPTRANDET_OTHER'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPACCTRAN AS T WHERE T.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND T.PAYMODE IN (''DI'',''RO'',''HC'')'         "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(T.CANCEL,'''') = '''''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' GROUP BY PAYMODE'        "
        strSql += vbCrLf + "    /** GETTING RECEIPT PART **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT SUM(AMOUNT)AMOUNT,SUM(AMOUNT+ISNULL(GSTVAL,0)) AS TOTAL,P.ACCODE AS ACCODE,P.PNAME AS CUSTOMER'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,P.DOORNO,P.ADDRESS1,P.ADDRESS2,P.ADDRESS3,P.AREA,P.CITY,P.STATE,P.COUNTRY,P.MOBILE,P.GSTNO,P.PAN,O.TRANDATE,CASE WHEN O.PAYMODE=''OR'' AND O.FLAG=''F'' THEN SUBSTRING(O.RUNNO,6,20)+''''+''FURTHER ADVANCE'' ELSE SUBSTRING(O.RUNNO,6,20) END RUNNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CASE WHEN O.PAYMODE IN (''DR'',''DU'') THEN ''CREDIT RECEIPT'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' WHEN O.PAYMODE = ''MR'' THEN ''MISCELLANEOUS RECEIPT'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' WHEN O.PAYMODE = ''OR'' AND SUBSTRING(O.RUNNO,6,1) <> ''R'' THEN ''ORDER RECEIPT'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' WHEN O.PAYMODE = ''OR'' AND SUBSTRING(O.RUNNO,6,1) = ''R'' THEN ''REPAIR RECEIPT'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ELSE ''ADVANCE RECEIPT'' END AS TRANTYPE /**O.PAYMODE = ''AR'' **/'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,O.TRANNO TRANNO,O.BATCHNO ,CONVERT(INT,10)RESULT,CONVERT(VARCHAR(2),NULL)COLHEAD'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(100),NULL) AS PARTICULAR ,CONVERT(VARCHAR(300),NULL)GROUP0'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(300),NULL)GROUP1,CONVERT(VARCHAR(300),NULL)GROUP2,CONVERT(INT,1)CRESULT'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,CONVERT(VARCHAR(200),LTRIM(ISNULL(O.REMARK1,'''') + '' '' + ISNULL(O.REMARK2,'''') + '' '' + ISNULL(C.REMARK1,'''')))AS REMARK'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,NULL RMKS'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT TOP 1'' (NO : '' + CONVERT(VARCHAR,TRANNO) + '' DATE:'' + CONVERT(VARCHAR,TRANDATE,103) + '')'''        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM " & cnAdminDb & "..OUTSTANDING WHERE RUNNO=O.RUNNO AND PAYMODE=''DU'' AND RECPAY=''P'') AS ORNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(GSTVAL) AS TAX'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=O.BATCHNO AND ISSSNO=O.SNO AND TAXID=''IG'' AND ISNULL(STUDDED,''N'')<>''Y'') AS IGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=O.BATCHNO AND ISSSNO=O.SNO AND TAXID=''CG'' AND ISNULL(STUDDED,''N'')<>''Y'') AS CGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,(SELECT SUM(TAXAMOUNT)TAXAMOUNT FROM TAXTRAN WHERE BATCHNO=O.BATCHNO AND ISSSNO=O.SNO AND TAXID=''SG'' AND ISNULL(STUDDED,''N'')<>''Y'') AS SGST'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INTO TEMPTABLEDB..TEMPTRANDET_RECEIPT'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPOUTSTANDING AS O '        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN " & cnAdminDb & "..CUSTOMERINFO AS C ON C.BATCHNO = O.BATCHNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' LEFT OUTER JOIN " & cnAdminDb & "..PERSONALINFO AS P ON P.SNO = C.PSNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' WHERE O.TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' AND O.RECPAY = ''R'' AND AMOUNT <> 0'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' AND ISNULL(CTRANCODE,0) != ISNULL('''+@BANKPAYPROID+''','''')'           "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +'GROUP BY P.ACCODE,P.PNAME,O.TRANNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +',P.DOORNO,P.ADDRESS1,P.ADDRESS2,P.ADDRESS3,P.AREA,P.CITY,P.STATE,P.COUNTRY,P.MOBILE,P.GSTNO,P.PAN,O.TRANDATE,RUNNO'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +',O.PAYMODE,O.BATCHNO,O.REMARK1,O.REMARK2,C.REMARK1,O.FLAG,O.SNO'        "
        strSql += vbCrLf + "    PRINT @QRY        "
        strSql += vbCrLf + "    EXEC (@QRY)        "
        strSql += vbCrLf + "    SELECT @QRY = CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_RECEIPT SET ORNO = ''(''+RUNNO+'')'' WHERE ISNULL(ORNO,'''')='''' AND ISNULL(RUNNO,'''')<>'''' '        "
        strSql += vbCrLf + "    EXEC (@QRY)        "
        strSql += vbCrLf + "    SELECT @QRY = ' IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPTRANDET_RECEIPT)>0'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' BEGIN'        "
        strSql += vbCrLf + "    /** INSERTING TITLE **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET_RECEIPT(TRANTYPE,PARTICULAR,RESULT,COLHEAD,GROUP0,GROUP1,CRESULT)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT TRANTYPE,TRANTYPE + '' ['' + CONVERT(VARCHAR,CONVERT(NUMERIC(15,2),SUM(TOTAL)))+'']'' PARTICULAR'      "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,0 RESULT,''T1''COLHEAD,''RECEIPT DETAILS'',TRANTYPE AS GROUP1,0 CRESULT'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPTRANDET_RECEIPT WHERE RESULT = 10 GROUP BY TRANTYPE,GROUP1'        "
        strSql += vbCrLf + "    /** INSERTING TRANTYPE TOTAL **/        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPTRANDET_RECEIPT(TRANTYPE,PARTICULAR,RESULT,COLHEAD,GROUP0,GROUP1'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,AMOUNT,TOTAL,IGST,CGST,SGST,TAX,CRESULT)'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' SELECT TRANTYPE,TRANTYPE + '' TOTAL'' AS PARTICULAR,0 RESULT,''S1''COLHEAD,''RECEIPT DETAILS'',TRANTYPE'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' ,SUM(AMOUNT),SUM(TOTAL),SUM(IGST),SUM(CGST),SUM(SGST),SUM(TAX),2'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' FROM TEMPTABLEDB..TEMPTRANDET_RECEIPT WHERE RESULT = 10 GROUP BY TRANTYPE'        "
        strSql += vbCrLf + "    /** UPDATE INFO TO PARTICULAR **/        "
        strSql += vbCrLf + "    IF @LINKORD='Y'        "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_RECEIPT SET PARTICULAR = ''  ''+CONVERT(VARCHAR,TRANNO) + '' ['' +SUBSTRING(CONVERT(VARCHAR,RUNNO),4,20) + '']  '' + ISNULL(CONVERT(VARCHAR(10),RMKS),'''') WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'        "
        strSql += vbCrLf + "    ELSE    "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_RECEIPT SET PARTICULAR = ''  ''+CONVERT(VARCHAR,TRANNO) + '' ['' +SUBSTRING(CONVERT(VARCHAR,RUNNO),4,20) + '']  '' + ISNULL(CONVERT(VARCHAR(10),RMKS),'''') WHERE ISNULL(PARTICULAR,'''') = '''' AND RESULT = 10'  "
        strSql += vbCrLf + "    SELECT @QRY = @QRY + CHAR(13) +' UPDATE TEMPTABLEDB..TEMPTRANDET_RECEIPT SET PARTICULAR = ''  ''+CONVERT(VARCHAR,TRANNO) + ''  '' + ISNULL(ORNO,'''') WHERE  RESULT = 10 AND ISNULL(ORNO,'''')LIKE ''%FURTHER ADVANCE%'''            "
