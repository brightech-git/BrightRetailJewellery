        strSql += vbCrLf + " 	SET @TAGFILTER= @TAGFILTER + ' AND T.COMPANYID IN('''+ @COMPANYID +''')'  "
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " 	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE'  "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)   "
        strSql += vbCrLf + " 	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE1'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTOCKSTONE1'  "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)   "
        strSql += vbCrLf + " 	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTKSTONE'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMSTKSTONE'  "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + " 	EXEC (@QRY)   "
        strSql += vbCrLf + " 	SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTONE'')IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'ITEMNONTAGSTONE'  "
        strSql += vbCrLf + " 	PRINT @QRY"
