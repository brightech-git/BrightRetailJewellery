        strSql += vbCrLf + "  	SELECT @QRY =' INSERT INTO #ABSSUMMARY_SA(PARTICULAR,PCS,GRSWT,NETWT,DISCOUNT,AMOUNT,TAX,SC,TOTAL,STNWT,DIAWT,RESULT,CATNAME,TRANDATE,TRANNO,CUSTOMER,ADDRESS,PHONENO,ADDRESS1,ADDRESS2,ADDRESS3,AREA,CITY,BATCHNO,TRANTYPE,MCHARGE,EMPNAME,BILLDATE)'"
