        strSql += vbCrLf + ",CONVERT(NUMERIC,NULL) PURVALUE,BATCHNO,CONVERT(NUMERIC,NULL) DIFF_ISSRATE,CONVERT(NUMERIC,NULL) DIFF_STKRATE   "
        strSql += vbCrLf + ",SEP "
        strSql += vbCrLf + "FROM MASTER..TEMPVIEWPROFIT"
        strSql += vbCrLf + ")X "
        strSql += vbCrLf + "UPDATE #TAGWISEPROFIT SET "
        strSql += vbCrLf + "PCS = CASE WHEN PCS = 0 THEN NULL ELSE PCS END "
        strSql += vbCrLf + ",GRSWT = CASE WHEN GRSWT = 0 THEN NULL ELSE GRSWT END "
        strSql += vbCrLf + ",NETWT = CASE WHEN NETWT = 0 THEN NULL ELSE NETWT END "
        strSql += vbCrLf + ",DIAPCS = CASE WHEN DIAPCS = 0 THEN NULL ELSE DIAPCS END "
        strSql += vbCrLf + ",DIAWT = CASE WHEN DIAWT = 0 THEN NULL ELSE DIAWT END "
        strSql += vbCrLf + ",TOUCH = CASE WHEN TOUCH = 0 THEN NULL ELSE TOUCH END "
        strSql += vbCrLf + ",WASTAGE = CASE WHEN WASTAGE = 0 THEN NULL ELSE WASTAGE END "
        strSql += vbCrLf + ",MCHARGE = CASE WHEN MCHARGE = 0 THEN NULL ELSE MCHARGE END "
        strSql += vbCrLf + ",AMOUNT = CASE WHEN AMOUNT = 0 THEN NULL ELSE AMOUNT END "
        strSql += vbCrLf + ",PURVALUE_CALC = CASE WHEN PURVALUE_CALC = 0 THEN NULL ELSE PURVALUE_CALC END "
        strSql += vbCrLf + ",PURVALUE = CASE WHEN PURVALUE = 0 THEN NULL ELSE PURVALUE END "
        strSql += vbCrLf + ",DIFF_ISSRATE= CASE WHEN DIFF_ISSRATE= 0 THEN NULL ELSE DIFF_ISSRATE END "
        strSql += vbCrLf + ",DIFF_STKRATE= CASE WHEN DIFF_STKRATE= 0 THEN NULL ELSE DIFF_STKRATE END "
        strSql += vbCrLf + "SELECT * FROM #TAGWISEPROFIT  '"
        strSql += vbCrLf + "EXEC (@QRY + @QRY1)"
        strSql += vbCrLf + "END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSpCashPoint_RECPAY()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_CASHPOINT_RECPAY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_CASHPOINT_RECPAY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_CASHPOINT_RECPAY    "
        strSql += vbCrLf + "  (    "
        strSql += vbCrLf + "  @BATCHNO VARCHAR(15)    "
        strSql += vbCrLf + "  )    "
        strSql += vbCrLf + "  AS    "
        strSql += vbCrLf + "  -- DECLARE @BATCHNO VARCHAR(15)    "
        strSql += vbCrLf + "  -- DECLARE @RTYPE VARCHAR(1)    "
        strSql += vbCrLf + "  -- SET @BATCHNO = 'AVRAS1086'    "
        strSql += vbCrLf + "  -- SET @RTYPE = 'A'    "
        strSql += vbCrLf + " BEGIN    "
        strSql += vbCrLf + "  SET NOCOUNT ON    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#CASHPOINT') IS NOT NULL DROP TABLE #CASHPOINT    "
        strSql += vbCrLf + " CREATE TABLE #CASHPOINT    "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " PARTICULAR VARCHAR(250),REM VARCHAR(50),AMOUNT NUMERIC(15,2),TRANTYPE VARCHAR(5),TAMOUNT NUMERIC(15,2),KNO INT IDENTITY(0,1)    "
        strSql += vbCrLf + " )    "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#CAPOINT') IS NOT NULL DROP TABLE #CAPOINT    "
        strSql += vbCrLf + " SELECT     "
        strSql += vbCrLf + " CASE WHEN PAYMODE IN ('SA','SV') THEN 'SA'    "
        strSql += vbCrLf + " WHEN PAYMODE IN ('SR','RV') THEN 'SR'    "
        strSql += vbCrLf + " WHEN PAYMODE IN ('PU','PV')THEN 'PU'    "
        strSql += vbCrLf + " WHEN PAYMODE IN ('HG','HB','HZ','HD') THEN 'HP'    "
        strSql += vbCrLf + " ELSE PAYMODE END AS TRANTYPE    "
        strSql += vbCrLf + " ,CASE WHEN TRANMODE = 'D' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT    "
        strSql += vbCrLf + " INTO #CAPOINT    "
        strSql += vbCrLf + " FROM " & tranDbName & "..ACCTRAN    "
        strSql += vbCrLf + " WHERE BATCHNO = @BATCHNO    "
        strSql += vbCrLf + " AND PAYMODE IN ('SA','SV','SR','RV','PU','PV'    "
        strSql += vbCrLf + " ,'DR','AR','MR','HR','OR'    "
        strSql += vbCrLf + " ,'DP','AP','MP','HP','HG','HB','HZ','HD'    "
        strSql += vbCrLf + " )  "
        strSql += vbCrLf + " INSERT INTO #CASHPOINT    "
        strSql += vbCrLf + " (PARTICULAR,TRANTYPE)    "
        strSql += vbCrLf + " SELECT 'SALES','SA'    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT 'RETURN','SR'    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT 'PURCHASE','PU'    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT 'RECEIPT','REC'    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT 'PAYMENT','PAY'    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET AMOUNT = (SELECT SUM(AMOUNT) FROM #CAPOINT WHERE TRANTYPE = T.TRANTYPE)    "
        strSql += vbCrLf + " FROM #CASHPOINT AS T,#CAPOINT P WHERE T.TRANTYPE IN ('SA','SR','PU')    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET REM = P.REM,AMOUNT = P.AMOUNT    "
        strSql += vbCrLf + " FROM #CASHPOINT AS T,    "
        strSql += vbCrLf + " (    "
        strSql += vbCrLf + " SELECT 'RECEIPT' AS RE    "
        strSql += vbCrLf + " ,CASE TRANTYPE WHEN 'DR' THEN 'CREDIT SALES'    "
        strSql += vbCrLf + " WHEN 'AR' THEN 'CUSTOMER ADVANCE'    "
        strSql += vbCrLf + " WHEN 'MR' THEN 'OTHER RECEIPT'    "
        strSql += vbCrLf + " WHEN 'HR' THEN 'CHIT RECEIPT'    "
        strSql += vbCrLf + " WHEN 'OR' THEN 'FURTHER ADVANCE'    "
        strSql += vbCrLf + " ELSE ''    "
        strSql += vbCrLf + " END AS REM    "
        strSql += vbCrLf + " ,SUM(AMOUNT)AMOUNT,'REC' AS TRANTYPE    "
        strSql += vbCrLf + " FROM #CAPOINT WHERE TRANTYPE IN ('DR','AR','MR','HR','OR') GROUP BY TRANTYPE    "
        strSql += vbCrLf + " UNION ALL    "
        strSql += vbCrLf + " SELECT 'PAYMENT' AS RE    "
        strSql += vbCrLf + " ,CASE TRANTYPE WHEN 'DP' THEN 'PURCHASE/SALES RETURN'    "
        strSql += vbCrLf + " WHEN 'AP' THEN 'ADVANCE REPAY'    "
        strSql += vbCrLf + " WHEN 'MP' THEN 'OTHER PAYMENT'    "
        strSql += vbCrLf + " WHEN 'HP' THEN 'CHIT PAYMENT'    "
        strSql += vbCrLf + " ELSE ''    "
        strSql += vbCrLf + " END AS REM    "
        strSql += vbCrLf + " ,SUM(AMOUNT)AMOUNT,'PAY'TRANTYPE    "
        strSql += vbCrLf + " FROM #CAPOINT WHERE TRANTYPE IN ('DP','AP','MP','HP') GROUP BY TRANTYPE    "
        strSql += vbCrLf + " )P WHERE T.TRANTYPE = P.TRANTYPE AND T.TRANTYPE IN ('REC','PAY')"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET REM = CASE WHEN O.RECPAY = 'P' AND O.FROMFLAG = 'P' THEN 'ORDER REPAY'     "
        strSql += vbCrLf + " ELSE C.REM END    "
        strSql += vbCrLf + " FROM #CASHPOINT AS C," & compId & "ADMINDB..OUTSTANDING AS O     "
        strSql += vbCrLf + " WHERE O.BATCHNO = @BATCHNO AND SUBSTRING(RUNNO,6,1) = 'O' AND O.RECPAY = 'P' AND C.TRANTYPE = 'PAY'    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET REM = CASE WHEN O.RECPAY = 'R' AND O.FROMFLAG = 'D' THEN 'ORDER ADVANCE'    "
        strSql += vbCrLf + " ELSE C.REM END    "
        strSql += vbCrLf + " FROM #CASHPOINT AS C," & compId & "ADMINDB..OUTSTANDING AS O     "
        strSql += vbCrLf + " WHERE O.BATCHNO = @BATCHNO AND SUBSTRING(RUNNO,6,1) = 'O' AND O.RECPAY = 'R' AND C.TRANTYPE = 'REC'    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET TAMOUNT = AMOUNT    "
        strSql += vbCrLf + " UPDATE #CASHPOINT SET AMOUNT = ABS(AMOUNT),PARTICULAR = ISNULL(PARTICULAR,'') + CASE WHEN ISNULL(REM,'') <> '' THEN ' - ' + REM ELSE '' END    "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " SELECT * FROM #CASHPOINT    "
        strSql += vbCrLf + " END    "

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSp_SalesAbstractNewGST()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='PROC_RPT_ABSTRACT_NEW_FORMAT_GST')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE PROC_RPT_ABSTRACT_NEW_FORMAT_GST"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "CREATE PROCEDURE [dbo].[PROC_RPT_ABSTRACT_NEW_FORMAT_GST]"
        strSql += vbCrLf + " (   "
        strSql += vbCrLf + " @DBNAME VARCHAR(15)  "
        strSql += vbCrLf + " ,@SYSTEMID VARCHAR(10)  "
        strSql += vbCrLf + " ,@FRMDATE VARCHAR(12)  "
        strSql += vbCrLf + " ,@TODATE VARCHAR(12)  "
        strSql += vbCrLf + " ,@METALNAME VARCHAR(200)  "
        strSql += vbCrLf + " ,@CATCODE VARCHAR(200)       "
        strSql += vbCrLf + " ,@CATNAME VARCHAR(200)   "
        strSql += vbCrLf + " ,@COSTNAME VARCHAR(200)       "
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(3)       "
        strSql += vbCrLf + " ,@TYPE VARCHAR(30)  "
        strSql += vbCrLf + " ,@SEPDIA VARCHAR(1)  "
        strSql += vbCrLf + " ,@BILLSUM VARCHAR(1)   "
        strSql += vbCrLf + " )       "
        strSql += vbCrLf + " AS       "
        strSql += vbCrLf + " BEGIN /** PROC STARTS **/       "
        strSql += vbCrLf + "     SET NOCOUNT ON       "
        strSql += vbCrLf + "     DECLARE @QRY VARCHAR(8000)      "
        strSql += vbCrLf + "     DECLARE @QRY1 VARCHAR(8000)      "
        strSql += vbCrLf + "     DECLARE @QRY2 VARCHAR(8000)  "
        strSql += vbCrLf + "     DECLARE @QRY4 VARCHAR(8000)     "
        strSql += vbCrLf + "     SELECT @QRY = 'IF OBJECT_ID(''TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS'       "
        strSql += vbCrLf + " 	PRINT @QRY"
        strSql += vbCrLf + "     EXEC (@QRY)     "
        strSql += vbCrLf + "     EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTNAME',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTNAME       "
        strSql += vbCrLf + "     EXEC  SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'CATEGORY',@CHK_FEILD = 'CATCODE',@RESULT_TBL = 'TEMPCATEGORY',@INPUTVALUES = @CATCODE   "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#METALMAST') IS NOT NULL DROP TABLE #METALMAST CREATE TABLE #METALMAST(METALID VARCHAR(10))         "
        strSql += vbCrLf + "     IF OBJECT_ID('TEMPDB..#CATEGORY') IS NOT NULL DROP TABLE #CATEGORY CREATE TABLE #CATEGORY(CATCODE VARCHAR(10))         "
        strSql += vbCrLf + "     SET @QRY = ' ALTER TABLE TEMPCOSTCENTRE ADD COSTID VARCHAR(2) '       "
        strSql += vbCrLf + "     EXEC (@QRY)       "
        strSql += vbCrLf + "     SET @QRY = ' UPDATE TEMPCOSTCENTRE SET COSTID = ISNULL((SELECT COSTID FROM ' + @DBNAME + '..COSTCENTRE WHERE COSTNAME = T.COMPANYID),'''') FROM TEMPCOSTCENTRE AS T'        "
        strSql += vbCrLf + "     EXEC (@QRY)    "
        strSql += vbCrLf + "     DECLARE  @SUBITEMID VARCHAR(50)  "
        strSql += vbCrLf + "     SELECT @SUBITEMID=CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='EXCLUDESUBITEM'  "
        strSql += vbCrLf + "     DECLARE  @BILLSUM1 VARCHAR(1)  "
        strSql += vbCrLf + "     DECLARE  @BILLREFNO VARCHAR(1)  "
        strSql += vbCrLf + "     DECLARE  @INCSR VARCHAR(1)  "
        strSql += vbCrLf + "     SELECT @BILLSUM1= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_BILLSUM'  "
        strSql += vbCrLf + "     SELECT @BILLREFNO= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_REFNO'  "
        strSql += vbCrLf + "     SELECT @INCSR= ISNULL(CTLTEXT,'N') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='RPT_SALPUR_TALLY_INCSR'  "
        strSql += vbCrLf + "     DECLARE  @CHITDB VARCHAR(30)  "
        strSql += vbCrLf + "     SELECT @CHITDB=ISNULL(CTLTEXT,'') FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID='CHITDBPREFIX'  "
        strSql += vbCrLf + " 	DECLARE  @SQLVERSION INT "
        strSql += vbCrLf + " 	SET @SQLVERSION=0"
        strSql += vbCrLf + " 	SELECT @SQLVERSION = CAST(SUBSTRING(CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')),1,CHARINDEX('.',CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')))-1) AS INT) "
        strSql += vbCrLf + "     IF @SUBITEMID='' SELECT @SUBITEMID='999999'  "
        strSql += vbCrLf + "     IF @BILLSUM = 'N'    "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     IF @SEPDIA = 'N'  "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     SELECT @QRY='SELECT  * INTO TEMPTABLEDB..TEMP'+@SYSTEMID+'TEMPSALESABS  FROM ('"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT I.TRANDATE INVOICEDATE,TRANNO AS INVOICENO,'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' (SELECT METALNAME FROM ' + @DBNAME + '..METALMAST WHERE METALID=I.METALID) AS METALTYPE,'  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ''SALES'' AS VOUCHERTYPE,PNAME PARTYNAME,ISNULL(P.GSTNO,'''')GSTNO'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(CASE WHEN I.SUBITEMID=0 THEN IM.ITEMNAME ELSE SI.SUBITEMNAME END) AS PRODUCTNAME,CC.CATNAME '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT NAME FROM ' + @DBNAME + '..ITEMTYPE WHERE ITEMTYPEID=I.ITEMTYPEID) AS ITEMTYPE '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,I.GRSWT+CONVERT(NUMERIC(15,3) ,ISNULL((SELECT SUM(GRSWT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)) GRSWT '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,I.NETWT+CONVERT(NUMERIC(15,3) ,ISNULL((SELECT SUM(NETWT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)) NETWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,3),ISNULL((SELECT SUM(STNWT)  FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''T'') AND STNSUBITEMID NOT IN('+@SUBITEMID+') ),0))STNWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,2),ISNULL((SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''T'') ),0))STNAMT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,3),ISNULL((SELECT SUM(STNWT)  FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'') AND STNSUBITEMID NOT IN('+@SUBITEMID+') ),0))DIAWT '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(NUMERIC(15,2),ISNULL((SELECT SUM(STNAMT) FROM ISSSTONE WHERE ISSSNO=I.SNO AND STNITEMID IN(SELECT ITEMID FROM ' + @DBNAME + '..ITEMMAST WHERE METALID=''D'') ),0))DIAAMT '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,ROUND(AMOUNT-ISNULL(I.STNAMT,0)+CONVERT(NUMERIC(15,2) ,ISNULL((SELECT SUM(AMOUNT) FROM  ISSUE WHERE TRANNO = I.TRANNO AND TRANTYPE = ''OD''),0)),0) VALUE '    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT SUM(TAXAMOUNT) FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' )GST'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXPER FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'')IGSTRATE'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXAMOUNT FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''IG'')IGSTTAX'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXPER FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'')CGSTRATE'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXAMOUNT FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''CG'')CGSTTAX'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXPER FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'')SGSTRATE'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TAXAMOUNT FROM TAXTRAN WHERE ISSSNO=I.SNO AND BATCHNO=I.BATCHNO AND TRANTYPE=I.TRANTYPE AND ISNULL(STUDDED,''N'')<>''Y'' AND TAXID=''SG'')SGSTTAX'    "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,ROUND((AMOUNT+SC+TAX),0) AS TOTAL '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' ,I.BATCHNO,I.TRANTYPE,I.REMARK1  REMARKS,I.COSTID,I.SNO TSNO '"
        strSql += vbCrLf + "  	IF @BILLREFNO = 'Y' AND @SQLVERSION > 8"
        strSql += vbCrLf + "  	BEGIN "
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' ,(STUFF((SELECT CAST('','' + REFNO AS VARCHAR(MAX)) FROM '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' (SELECT DISTINCT (TRANTYPE+LTRIM(TRANNO)) REFNO FROM RECEIPT R WHERE (R.BATCHNO=I.BATCHNO) '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' UNION ALL '"
        strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT  (SUBSTRING(RUNNO,6,15)) REFNO FROM '+ @DBNAME +'..OUTSTANDING O WHERE (O.BATCHNO=I.BATCHNO))X FOR XML PATH ('''')), 1, 1, '''')) REFNO'"
        strSql += vbCrLf + "  	END	"
        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  	BEGIN"
        strSql += vbCrLf + "  	IF @BILLREFNO = 'Y'"
        strSql += vbCrLf + "     	SELECT @QRY=@QRY+CHAR(13)+' ,NULL REFNO'"
        strSql += vbCrLf + "  	END"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' FROM  ISSUE AS I '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN  '+ @DBNAME +'..ITEMMAST  AS IM ON IM.ITEMID  = I.ITEMID'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN  '+ @DBNAME +'..SUBITEMMAST  AS SI ON SI.SUBITEMID  = I.SUBITEMID'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN  '+ @DBNAME +'..CATEGORY  AS CC ON CC.CATCODE  = I.CATCODE'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN  '+ @DBNAME +'..CUSTOMERINFO AS C ON C.BATCHNO = I.BATCHNO '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN  '+ @DBNAME +'..PERSONALINFO AS P ON C.PSNO = P.SNO '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' WHERE I.TRANDATE BETWEEN '''+ @FRMDATE  +''' AND '''+ @TODATE +''' AND I.TRANTYPE IN (''SA'')'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(I.COSTID,'''') IN (SELECT COSTID FROM TEMPCOSTCENTRE)            '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(I.COMPANYID,'''') =  '''+@COMPANYID+''' AND I.AMOUNT > 0 AND ISNULL(I.CANCEL,'''') = ''''            '  "
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' UNION ALL'"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT DISTINCT I.TRANDATE INVOICEDATE,TRANNO AS INVOICENO,'"
