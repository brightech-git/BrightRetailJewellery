        strSql += vbCrLf + "  	DECLARE @QUERY VARCHAR(MAX) "
        strSql += vbCrLf + "  	DECLARE @DATEFILTER VARCHAR(4000)"
        strSql += vbCrLf + "  	DECLARE @ODATEFILTER VARCHAR(4000)"
