        strSql += vbCrLf + "   /** GETTING TRANSACTION **/"
        strSql += vbCrLf + "   IF OBJECT_ID('TEMPTABLEDB..TRAILBAL_A') IS NOT NULL DROP TABLE TEMPTABLEDB..TRAILBAL_A"
        strSql += vbCrLf + "   SELECT @QRY='SELECT '"
