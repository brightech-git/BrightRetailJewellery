        strSql += vbCrLf + "   SELECT @QUERY = @QUERY + ' ,(TAX+AMOUNT+DISCOUNT) AS QUATAMOUNT,(((TAX+AMOUNT+DISCOUNT)/100)*(CONVERT(DECIMAL(15,2),'+@DEFFINDISC+'))) DISCOUNT,(AMOUNT+TAX) AMOUNT '"
        strSql += vbCrLf + "   SELECT @QUERY = @QUERY + ' ,(TAX+AMOUNT+DISCOUNT)-(((TAX+AMOUNT+DISCOUNT)/100)*(CONVERT(DECIMAL(15,2),'+@DEFFINDISC+'))) AS [CATEGORY-'+@DEFFINDISC+'%]'"
