#Region "Savings Db Alert Trigerrs for Sms"
    Function funcCheckTriggerStatusSavings(ByVal CnCon As OleDbConnection, ByVal CnTran As OleDbTransaction, ByVal TrigName As String) As Boolean
        strSql = "SELECT ISNULL(OBJECTPROPERTY(OBJECT_ID('" & TrigName & "'),'EXECISTRIGGERDISABLED'),1)"
        cmd = New OleDbCommand(strSql, CnCon, CnTran)
        da = New OleDbDataAdapter(cmd)
        Dim dt As New DataTable
        da.Fill(dt)
        If dt.Rows.Count > 0 Then
            If dt.Rows(0).Item(0).ToString() = 1 Then
                Return True
            Else
                Return False
            End If
        End If
        Return False
    End Function
    Private Sub funcTriggerDisableSavings(ByVal CnCon As OleDbConnection, ByVal CnTran As OleDbTransaction, ByVal TableName As String, ByVal TrigName As String)
        strSql = "ALTER TABLE " & TableName & " DISABLE TRIGGER " & TrigName
        cmd = New OleDbCommand(strSql, CnCon, CnTran)
        cmd.ExecuteNonQuery()
    End Sub
    Private Sub SavingsTriggerforAlertSms()
        Dim CnCon As New OleDbConnection
        Dim CnTran As OleDbTransaction
        Dim Ischit As String = GetSqlValue("SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='CHITDB'", "N", tran)
        If Ischit <> "Y" Then Exit Sub
        Dim chitdbprefix As String = GetSqlValue("SELECT CTLTEXT FROM " & compId & "ADMINDB..SOFTCONTROL WHERE CTLID='CHITDBPREFIX'", "", tran)
        If chitdbprefix = "" Then Exit Sub
        Dim ChitDbName As String = Mid(chitdbprefix, 1, 3) & "SAVINGS"
        Dim ChitDbName1 As String = Mid(chitdbprefix, 1, 3) & "SH0708"
        If GetSqlValue("SELECT COUNT(*) FROM MASTER..SYSDATABASES WHERE NAME='" & ChitDbName1 & "'", 0, tran) = 0 Then Exit Sub
        If dbType = "W" Then
            CnCon = New OleDbConnection("Provider=SQLOLEDB.1;Integrated Security=SSPI;Persist Security Info=False;Initial Catalog=" & ChitDbName1 & ";Data Source=" & serverName & "")
        Else
            CnCon = New OleDbConnection("Provider=SQLOLEDB.1;Persist Security Info=False;User ID=" & IIf(dbType.ToUpper = "S", "SA", dbType.ToUpper) & ";Initial Catalog=" & ChitDbName1 & ";Data Source=" & serverName & ";password=" & pwd)
        End If
        CnCon.Open()
        CnTran = CnCon.BeginTransaction
        Dim TrigDisable As Boolean = True
        TrigDisable = funcCheckTriggerStatusSavings(CnCon, CnTran, "MONTHENTRY_SMS_TRG")
        MONTHENTRY_SMS_TRG(ChitDbName, CnCon, CnTran)
        If TrigDisable Then funcTriggerDisableSavings(CnCon, CnTran, "SCHEMETRAN", "MONTHENTRY_SMS_TRG")
        CnTran.Commit()
        CnTran = Nothing
        CnCon.Close()
    End Sub
