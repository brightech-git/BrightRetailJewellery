        strSql += vbCrLf + "  		EXEC (@QRY)  "
        strSql += vbCrLf + "  		PRINT'/******************** Cash Payment ******************/'"
        strSql += vbCrLf + "  		SELECT @QRY= ' IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = ''TEMP'+@SYSTEMID+'CASPAYMENT'')>0 DROP TABLE TEMPTABLEDB..TEMP'+@SYSTEMID+'CASPAYMENT "
