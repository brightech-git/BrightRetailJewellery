        strSql += vbCrLf + " 	UPDATE TEMPTABLEDB..OUTSTDT SET TRANTYPE = 'O' WHERE SUBSTRING(RUNNO,6,1) = 'O'"
        strSql += vbCrLf + " 	DELETE FROM TEMPTABLEDB..OUTSTDT WHERE TRANTYPE NOT IN (SELECT TYPEID FROM #TYPE)"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPTABLEDB..TEMP_ACHEAD') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMP_ACHEAD"
        strSql += vbCrLf + " 	CREATE TABLE TEMPTABLEDB..TEMP_ACHEAD (ACCODE VARCHAR(7),TRANTYPE VARCHAR(50))"
        strSql += vbCrLf + " 	IF @DISPLAY = 'C'"
        strSql += vbCrLf + " 	BEGIN"
