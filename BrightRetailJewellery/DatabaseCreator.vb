        strSql += vbCrLf + "       SELECT @QRY= @QRY + CHAR(13)+ ' INNER JOIN CUSTOMERINFO AS CU ON CU.BATCHNO = O.BATCHNO /*(SELECT TOP 1 BATCHNO FROM  OUTSTANDING WHERE RUNNO = O.RUNNO AND COSTID = O.COSTID AND COMPANYID = O.COMPANYID ORDER BY TRANDATE)*/'  "
