        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' FROM '+@TEMPTABLE+ ''"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "		SELECT @QUERY =' UPDATE TEMPTABLEDB..'+@TEMPTABLE+'CRADV SET DEBIT =(SELECT ISNULL(DEBIT,0)-ISNULL(CREDIT,0)FROM '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +'TEMPTABLEDB..'+@TEMPTABLE+'CRADV   WHERE COLHEAD = ''S1'' AND ISNULL(DEBIT,0) > ISNULL(CREDIT,0)),CREDIT=0 WHERE COLHEAD=''S2'' '"
        strSql += vbCrLf + "		PRINT @QUERY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "		SELECT @QUERY =' UPDATE TEMPTABLEDB..'+@TEMPTABLE+'CRADV SET CREDIT =(SELECT ISNULL(CREDIT,0)-ISNULL(DEBIT,0)FROM '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +'TEMPTABLEDB..'+@TEMPTABLE+'CRADV   WHERE COLHEAD = ''S1'' AND ISNULL(DEBIT,0) < ISNULL(CREDIT,0)),DEBIT=0 WHERE COLHEAD=''S2'' AND ISNULL(DEBIT,0) = 0'"
        strSql += vbCrLf + "		PRINT @QUERY"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @DETAILED = 'N'"
        strSql += vbCrLf + "	BEGIN"
        strSql += vbCrLf + "		SELECT @QUERY ='IF (SELECT TOP 1 1 FROM TEMPTABLEDB..SYSOBJECTS WHERE NAME = '''+@TEMPTABLE+'CRADV'')>0  DROP TABLE TEMPTABLEDB..'+@TEMPTABLE+'CRADV' "
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "		SELECT @QUERY =' CREATE TABLE TEMPTABLEDB ..'+@TEMPTABLE+'CRADV ([ACCODE] VARCHAR(20)NULL,MOBILE VARCHAR(20),PARTICULARS VARCHAR(500)NULL,[OPENING] DECIMAL(15,2)DEFAULT 0,[DEBIT] DECIMAL(15,2)DEFAULT 0,[CREDIT] DECIMAL(15,2)DEFAULT 0,[BALANCE] DECIMAL(15,2)DEFAULT 0,COLHEAD VARCHAR(2)NULL,LASTTRANDATE VARCHAR(12))'"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY "
        strSql += vbCrLf + "		SELECT @QUERY ='INSERT INTO TEMPTABLEDB..'+@TEMPTABLE+'CRADV(ACCODE,MOBILE,PARTICULARS,OPENING ,DEBIT,CREDIT,BALANCE,COLHEAD,LASTTRANDATE)  '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' SELECT A.ACCODE,B.MOBILE,ISNULL(B.ACNAME,'''') AS PARTICULARS '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' ,OPENING,SUM(DEBIT)DEBIT,SUM(CREDIT)CREDIT,ISNULL(OPENING,0)+SUM(ISNULL(DEBIT,0))-SUM(ISNULL(CREDIT,0)) BALANCE,'''',CONVERT(VARCHAR(13),MAX(A.TRANDATE),103) FROM '+@TEMPTABLE+' A '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' LEFT JOIN CUSTOMERINFO AS CINF ON A.BATCHNO = CINF.BATCHNO  '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' LEFT JOIN PERSONALINFO AS PINF ON PINF.SNO = CINF.PSNO LEFT JOIN ACHEAD B ON '"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' A.ACCODE = B.ACCODE WHERE A.ACCODE <>''''AND A.PARTICULARS<>''OPENING'''"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' AND ISNULL(CANCEL,'''') <> ''Y'''    "
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +  @ACFILTER"
        strSql += vbCrLf + "		SELECT @QUERY =@QUERY +' GROUP BY A.ACCODE,B.ACNAME,A.OPENING,B.MOBILE ORDER BY B.ACNAME '"
        strSql += vbCrLf + "		EXECUTE SP_EXECUTESQL @QUERY  "
        strSql += vbCrLf + "	END"
        strSql += vbCrLf + "	IF @DETAILED = 'Y'"
        strSql += vbCrLf + "	BEGIN"
