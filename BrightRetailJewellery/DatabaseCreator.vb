        strSql += vbCrLf + " 	  SELECT @QRY='INSERT INTO TEMPTEST11_ACCODE(PARTICULAR,ACGRPNAME,RESULT,COLHEAD,DISPORDER,MAINGRPNAME,[OPENING],[CLOSING])'"
