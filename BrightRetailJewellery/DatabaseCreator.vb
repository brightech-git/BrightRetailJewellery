        strSql += vbCrLf + "   		    SELECT @QRY = @QRY +CHAR(13)+' ,CONVERT(NUMERIC(15,2),ISNULL((SELECT SUM(AMOUNT) FROM '+@DBNAME+'..ACCTRAN WHERE BATCHNO=I.BATCHNO AND PAYMODE=''AC'' '"
