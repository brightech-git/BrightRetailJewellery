        strSql += vbCrLf + "  	ELSE"
        strSql += vbCrLf + "  		SELECT @QRY=@QRY+CHAR(13)+' AND ORDATE BETWEEN '''+ @FROMDATE +''' AND '''+ @TODATE +''' '"
