        strSql += vbCrLf + "          SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPRANGEWISE_RES(PARTICULAR,METALNAME,'+@BASENAME+',SUBITEMNAME,REORDER,PCS,DIFF,REORDERWT,GRSWT,DIFFWT,SALVALUE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "          SELECT @QRY = @QRY + CHAR(13) + '  SELECT '+@BASENAME+'+''-SUBTOTAL'',METALNAME,'+@BASENAME+',''ZZZZZ'',SUM(ISNULL(REORDER,0)),SUM(ISNULL(PCS,0)),SUM(ISNULL(REORDER,0)-ISNULL(PCS,0)),SUM(ISNULL(REORDERWT,0)),SUM(ISNULL(GRSWT,0)),SUM(ISNULL(REORDERWT,0)-ISNULL(GRSWT,0)),SUM(SALVALUE)'"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + CHAR(13) + ' ,5,''S1'' FROM TEMPTABLEDB..TEMPRANGEWISE_RES WHERE RESULT=3 GROUP BY METALNAME,'+@BASENAME+''"
        strSql += vbCrLf + "          PRINT @QRY "
        strSql += vbCrLf + "          EXEC(@QRY)   "
        strSql += vbCrLf + "          SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPRANGEWISE_RES(PARTICULAR,METALNAME,'+@BASENAME+',SUBITEMNAME,REORDER,PCS,DIFF,REORDERWT,GRSWT,DIFFWT,SALVALUE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "          SELECT @QRY = @QRY + CHAR(13) + '  SELECT METALNAME+''-SUBTOTAL'',METALNAME,''ZZZZ'',''ZZZZZ'',SUM(ISNULL(REORDER,0)),SUM(ISNULL(PCS,0)),SUM(ISNULL(REORDER,0)-ISNULL(PCS,0)),SUM(ISNULL(REORDERWT,0)),SUM(ISNULL(GRSWT,0)),SUM(ISNULL(REORDERWT,0)-ISNULL(GRSWT,0)),SUM(SALVALUE),6,''S'' '"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + CHAR(13) + ' FROM TEMPTABLEDB..TEMPRANGEWISE_RES WHERE RESULT=3 GROUP BY METALNAME'"
        strSql += vbCrLf + "          PRINT @QRY "
        strSql += vbCrLf + "          EXEC(@QRY)   "
        strSql += vbCrLf + "          SELECT @QRY=' INSERT INTO TEMPTABLEDB..TEMPRANGEWISE_RES(PARTICULAR,METALNAME,'+@BASENAME+',SUBITEMNAME,REORDER,PCS,DIFF,REORDERWT,GRSWT,DIFFWT,SALVALUE,RESULT,COLHEAD)'"
        strSql += vbCrLf + "          SELECT @QRY = @QRY + CHAR(13) + '  SELECT ''GRANDTOTAL'',''ZZZ'',''ZZZZ'',''ZZZZZ'',SUM(ISNULL(REORDER,0)),SUM(ISNULL(PCS,0)),SUM(ISNULL(REORDER,0)-ISNULL(PCS,0)),SUM(ISNULL(REORDERWT,0)),SUM(ISNULL(GRSWT,0)),SUM(ISNULL(REORDERWT,0)-ISNULL(GRSWT,0)),SUM(SALVALUE),7,''G'' '"
        strSql += vbCrLf + "  		SELECT @QRY = @QRY + CHAR(13) + ' FROM TEMPTABLEDB..TEMPRANGEWISE_RES WHERE RESULT=3 '"
