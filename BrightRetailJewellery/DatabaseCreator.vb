    Function DbChecker(ByVal dbname As String, Optional ByVal withTran As Boolean = False) As Integer
        STATUS = "Checking " & dbname & ""
        funcProgressStep()
        Dim ds As New Data.DataSet
        ds.Clear()
        strSql = " select name from master..sysdatabases where name = '" & dbname & "'"
        If withTran Then
            cmd = New OleDbCommand(strSql, cn, tran)
        Else
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        End If
        da = New OleDbDataAdapter(cmd)
        da.Fill(ds, "sysDatabases")
        If ds.Tables("sysDatabases").Rows.Count > 0 Then
            Return 1
        End If
        funcProgressStep(1)
        Return 0
    End Function

    Function Createtempdb()
        Dim tds As New DataSet
        Dim tdbname As String = "TEMPTABLEDB"
        strSql = " select name from master..sysdatabases where name = '" & tdbname & "'"
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        da = New OleDbDataAdapter(cmd)
        da.Fill(tds, "sysDatabases")

        If tds.Tables("sysDatabases").Rows.Count = 0 Then
            strSql = " CREATE database " & tdbname & ""
            If dbPath <> "" Then
                strSql += vbCrLf + "  On (Name = " & tdbname & "_dat,FILENAME = '" & dbPath & "\" & tdbname & ".mdf')"
                strSql += vbCrLf + "  Log On (Name = '" & tdbname & "_log',FILENAME = '" & dbPath & "\" & tdbname & "_log.ldf')"
            End If
            cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
            cmd.ExecuteNonQuery()
        Else
            Try
                strSql = " DROP database " & tdbname & ""
                cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
                cmd.ExecuteNonQuery()

                strSql = " CREATE database " & tdbname & ""
                If dbPath <> "" Then
                    strSql += vbCrLf + "  On (Name = " & tdbname & "_dat,FILENAME = '" & dbPath & "\" & tdbname & ".mdf')"
                    strSql += vbCrLf + "  Log On (Name = '" & tdbname & "_log',FILENAME = '" & dbPath & "\" & tdbname & "_log.ldf')"
                End If
                cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
                cmd.ExecuteNonQuery()
            Catch ex As Exception

            End Try
        End If
    End Function
    Function CreateDb(ByVal dbName As String) As Integer
        Createtempdb()
        strSql = " CREATE database " & dbName & ""
        If dbPath <> "" Then
            strSql += vbCrLf + "  On (Name = " & dbName & "_dat,FILENAME = '" & dbPath & "\" & dbName & ".mdf')"
            strSql += vbCrLf + "  Log On (Name = '" & dbName & "_log',FILENAME = '" & dbPath & "\" & dbName & "_log.ldf')"
        End If
        If cn.State = ConnectionState.Closed Then cn.Open()
        cmd = New OleDbCommand(strSql, cn) : cmd.CommandTimeout = 1000
        cmd.ExecuteNonQuery()
    End Function

