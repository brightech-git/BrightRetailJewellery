        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' ,0 AS AMOUNT,0 AS DIAWT,'' ''FLAG,CASE WHEN RESULT=''6'' THEN ''5'' ELSE ''0'' END RESULT,'' ''TRANDATE,'' ''TRANNO,''T'' AS COLHEAD,'''' SEP'  "
        strSql += vbCrLf + " 		SELECT @STRQRY= @STRQRY+ CHAR(13) +' FROM TEMPTABLEDB..TEMP'+@SYSTEMID+'COUNTERREPORT WHERE RESULT IN(''1'',''6''))'  "
