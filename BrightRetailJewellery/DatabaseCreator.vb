        strSql += vbCrLf + " 		SELECT @QUERY=@QUERY+'FROM  '+@DBNAME+'..ACCTRAN A WHERE TRANDATE BETWEEN '''+ @FROMDATE+'''AND '''+ @TODATE +''' AND CASHPOINTID <> '''''"
