        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' ) AS X'   "
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' ) AS Y' /*ORDER BY BILLTYPE DESC,TRANDATE,TRANNO */     "
        strSql += vbCrLf + "	PRINT @QRY    "
        strSql += vbCrLf + "	EXEC (@QRY)    "
        strSql += vbCrLf + "	SELECT @QRY = 'IF (SELECT COUNT(*) FROM TEMPTABLEDB..TEMPITEMPL)>0'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' BEGIN'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' INSERT INTO TEMPTABLEDB..TEMPITEMPL(PCS,GRSWT,NETWT,TAGVALUE,AMOUNT,DIFF,RESULT,COLHEAD,DISCOUNT,DISCEMPNAME)'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' SELECT SUM(PCS),SUM(GRSWT),SUM(NETWT),SUM(TAGVALUE),SUM(AMOUNT),SUM(DIFF),3 RESULT,''G'' COLHEAD'    "
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' ,SUM(DISCOUNT),MAX(DISCEMPNAME) FROM TEMPTABLEDB..TEMPITEMPL WHERE RESULT = 1'"
        strSql += vbCrLf + "	SELECT @QRY = @QRY+ CHAR(13) +' END'"
        strSql += vbCrLf + "	PRINT @QRY    "
        strSql += vbCrLf + "	EXEC (@QRY)    "
        strSql += vbCrLf + "	SELECT @QRY = 'SELECT * FROM TEMPTABLEDB..TEMPITEMPL ORDER BY RESULT,BILLTYPE DESC,TRANDATE,TRANNO'    "
        strSql += vbCrLf + "	PRINT @QRY    "
        strSql += vbCrLf + "	EXEC (@QRY)    "
        strSql += vbCrLf + "END  "
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub


    Private Sub funcSp40StockReorder()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_STOCKREORDER')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_STOCKREORDER"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + " CREATE PROCEDURE SP_RPT_STOCKREORDER  "
        strSql += vbCrLf + "  (  "
        strSql += vbCrLf + "  @ITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@SUBITEMID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@COSTID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@SIZEID VARCHAR(8000)  "
        strSql += vbCrLf + "  ,@ASONDATE SMALLDATETIME  "
        strSql += vbCrLf + "  ,@COMPANYID VARCHAR(3)  "
        strSql += vbCrLf + "  ,@RTYPE VARCHAR(1) /** (B)OTH/(S)HORT/(E)XCESS **/  "
        strSql += vbCrLf + "  ,@RMODE VARCHAR(1)"
        strSql += vbCrLf + "  )  "
        strSql += vbCrLf + "  AS  "
        strSql += vbCrLf + "  SET NOCOUNT ON  "
        strSql += vbCrLf + " -- -- DECLARE @ITEMID VARCHAR(8000)  "
        strSql += vbCrLf + " -- -- DECLARE @SUBITEMID VARCHAR(8000)  "
        strSql += vbCrLf + " -- -- DECLARE @COSTID VARCHAR(8000)  "
        strSql += vbCrLf + " -- -- DECLARE @SIZEID VARCHAR(8000)  "
        strSql += vbCrLf + " -- -- DECLARE @ASONDATE SMALLDATETIME  "
        strSql += vbCrLf + " -- -- DECLARE @COMPANYID VARCHAR(3)  "
        strSql += vbCrLf + " -- -- DECLARE @RTYPE VARCHAR(1) /** (B)OTH/(S)HORT/(E)XCESS **/  "
        strSql += vbCrLf + " -- -- DECLARE @RMODE VARCHAR(1) /** (A)LL/(O)THERS **/"
        strSql += vbCrLf + " -- -- SET @COMPANYID = 'RAS'  "
        strSql += vbCrLf + " -- -- SET @ASONDATE = '2010-12-15'  "
        strSql += vbCrLf + " -- -- SET @ITEMID = '507'  "
        strSql += vbCrLf + " -- -- SET @SUBITEMID = 'ALL'  "
        strSql += vbCrLf + " -- -- SET @SIZEID = 'ALL'  "
        strSql += vbCrLf + " -- -- SET @RTYPE = 'S'  "
        strSql += vbCrLf + " -- -- SET @RMODE = 'A'"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEMMAST',@INPUTVALUES = @ITEMID  "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'SUBITEMMAST',@CHK_FEILD = 'SUBITEMID',@RESULT_TBL = 'TEMPSUBITEMMAST',@INPUTVALUES = @SUBITEMID  "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMSIZE',@CHK_FEILD = 'SIZEID',@RESULT_TBL = 'TEMPITEMSIZE',@INPUTVALUES = @SIZEID  "
        strSql += vbCrLf + " EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID"

        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPDB..#NONSTKORDER') IS NOT NULL DROP TABLE #NONSTKORDER"
        strSql += vbCrLf + " SELECT IM.ITEMNAME + CASE WHEN SM.SUBITEMNAME IS NULL THEN '' ELSE '-' + SUBITEMNAME END + ' [' + T.TAGNO +']' AS PARTICULAR"
        strSql += vbCrLf + " ,T.PCS,T.GRSWT,SI.SIZENAME,IM.ITEMNAME,SM.SUBITEMNAME,2 RESULT,T.TAGVAL"
        strSql += vbCrLf + " INTO #NONSTKORDER"
        strSql += vbCrLf + " FROM " & cnAdminDb & "..ITEMTAG AS T"
        strSql += vbCrLf + " INNER JOIN " & compId & "ADMINDB..ITEMMAST AS IM ON IM.ITEMID = T.ITEMID"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS SM ON SM.ITEMID = T.ITEMID AND SM.SUBITEMID = T.SUBITEMID"
        strSql += vbCrLf + " LEFT OUTER JOIN " & compId & "ADMINDB..ITEMSIZE AS SI ON SI.SIZEID = T.SIZEID"
        strSql += vbCrLf + " WHERE T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE)  "
        strSql += vbCrLf + " AND NOT EXISTS (SELECT 1 FROM " & compId & "ADMINDB..STKREORDER RE WHERE T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID AND T.GRSWT BETWEEN RE.FROMWEIGHT AND RE.TOWEIGHT AND T.SIZEID = RE.SIZEID)"
        strSql += vbCrLf + " AND ISNULL(T.COMPANYID,'') = @COMPANYID  "
        strSql += vbCrLf + " AND T.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)  "
        strSql += vbCrLf + " AND T.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)  "
        strSql += vbCrLf + " AND ISNULL(T.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)  "
        strSql += vbCrLf + " AND ISNULL(T.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)"
        strSql += vbCrLf + " ORDER BY PARTICULAR"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF @RMODE = 'A'"
        strSql += vbCrLf + " 	BEGIN"
        strSql += vbCrLf + " 	UPDATE #NONSTKORDER SET PARTICULAR = 'OTHERS',ITEMNAME = NULL,SUBITEMNAME = NULL"
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + "  IF OBJECT_ID('TEMPDB..#STKORDER') IS NOT NULL DROP TABLE #STKORDER  "
        strSql += vbCrLf + "  SELECT PARTICULAR,RANGE,SUM(STKPCS)STKPCS,SUM(STKWT)STKWT,SUM(REPCS)REPCS,SUM(REWT)REWT"
        strSql += vbCrLf + "  ,SUM(DIFFPCS)DIFFPCS,SUM(DIFFWT)DIFFWT,SIZENAME,ITEMNAME,SUBITEMNAME,FROMWEIGHT,TOWEIGHT,RESULT,COLHEAD"
        strSql += vbCrLf + "  INTO #STKORDER  "
        strSql += vbCrLf + "  FROM"
        strSql += vbCrLf + "  ("
        strSql += vbCrLf + "  SELECT  "
        strSql += vbCrLf + "  CONVERT(VARCHAR(600),IM.ITEMNAME + CASE WHEN ISNULL(SM.SUBITEMNAME,'') = '' THEN '' ELSE '-' + SM.SUBITEMNAME END)AS  PARTICULAR    "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,2),(RE.FROMWEIGHT+RE.TOWEIGHT)/2)AS RANGE,CONVERT(INT,SUM(T.PCS))STKPCS,CONVERT(NUMERIC(15,3),SUM(T.GRSWT))STKWT,RE.PIECE REPCS,RE.WEIGHT AS REWT  "
        strSql += vbCrLf + "  ,CONVERT(INT,ISNULL(SUM(T.PCS),0)- ISNULL(RE.PIECE,0)) AS DIFFPCS    "
        strSql += vbCrLf + "  ,CONVERT(NUMERIC(15,3),ISNULL(SUM(T.GRSWT),0) - ISNULL(RE.WEIGHT,0)) AS DIFFWT    "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(100),SI.SIZENAME)SIZENAME  "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(100),IM.ITEMNAME)ITEMNAME,CONVERT(VARCHAR(100),SM.SUBITEMNAME)SUBITEMNAME  "
        strSql += vbCrLf + "  ,RE.FROMWEIGHT,RE.TOWEIGHT    "
        strSql += vbCrLf + "  ,CONVERT(INT,1) AS RESULT    "
        strSql += vbCrLf + "  ,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + "  FROM " & compId & "ADMINDB..STKREORDER AS RE  "
        strSql += vbCrLf + "  INNER JOIN " & compId & "ADMINDB..ITEMMAST IM ON IM.ITEMID = RE.ITEMID  "
        strSql += vbCrLf + "  LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST SM ON SM.ITEMID = RE.ITEMID AND SM.SUBITEMID = RE.SUBITEMID  "
        strSql += vbCrLf + "  LEFT OUTER JOIN " & cnAdminDb & "..ITEMTAG AS T ON T.RECDATE <= @ASONDATE AND (T.ISSDATE IS NULL OR T.ISSDATE > @ASONDATE)  AND T.ITEMID = RE.ITEMID AND T.SUBITEMID = RE.SUBITEMID AND T.GRSWT BETWEEN RE.FROMWEIGHT AND RE.TOWEIGHT AND T.SIZEID = RE.SIZEID AND T.COMPANYID = @COMPANYID AND T.COSTID = RE.COSTID   "
        strSql += vbCrLf + "  LEFT OUTER JOIN " & compId & "ADMINDB..ITEMSIZE AS SI ON SI.SIZEID = RE.SIZEID  "
        strSql += vbCrLf + "  WHERE RE.ITEMID IN (SELECT COMPANYID FROM TEMPITEMMAST)    "
        strSql += vbCrLf + "  AND RE.SUBITEMID IN (SELECT COMPANYID FROM TEMPSUBITEMMAST)    "
        strSql += vbCrLf + "  AND ISNULL(RE.SIZEID,0) IN (SELECT COMPANYID FROM TEMPITEMSIZE)    "
        strSql += vbCrLf + "  AND ISNULL(RE.COSTID,0) IN (SELECT COMPANYID FROM TEMPCOSTCENTRE) "
        strSql += vbCrLf + "  GROUP BY IM.ITEMNAME,SM.SUBITEMNAME,RE.FROMWEIGHT,RE.TOWEIGHT,SI.SIZENAME,RE.PIECE,RE.WEIGHT  "
        strSql += vbCrLf + "  )X GROUP BY PARTICULAR,RANGE,ITEMNAME,SUBITEMNAME,FROMWEIGHT,TOWEIGHT,SIZENAME,RESULT,COLHEAD"

        strSql += vbCrLf + " INSERT INTO #STKORDER"
        strSql += vbCrLf + " (PARTICULAR,STKPCS,STKWT,DIFFPCS,DIFFWT,SIZENAME,ITEMNAME,SUBITEMNAME,RESULT)"
        strSql += vbCrLf + " SELECT PARTICULAR"
        strSql += vbCrLf + " ,SUM(T.PCS),SUM(T.GRSWT),SUM(T.PCS),SUM(T.GRSWT),SIZENAME,ITEMNAME,SUBITEMNAME,RESULT"
        strSql += vbCrLf + " FROM #NONSTKORDER AS T"
        strSql += vbCrLf + " GROUP BY SIZENAME,ITEMNAME,SUBITEMNAME,RESULT,PARTICULAR"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " DECLARE @LEN AS INT"
        strSql += vbCrLf + " DECLARE @LEN_FWT AS INT"
        strSql += vbCrLf + " DECLARE @LEN_TWT AS INT"
        strSql += vbCrLf + " SELECT @LEN = MAX(LEN(PARTICULAR))+1 FROM #STKORDER WHERE RESULT = 1"
        strSql += vbCrLf + " SELECT @LEN_FWT = MAX(LEN(FROMWEIGHT)) FROM #STKORDER"
        strSql += vbCrLf + " SELECT @LEN_TWT = MAX(LEN(TOWEIGHT)) FROM #STKORDER"
        strSql += vbCrLf + " UPDATE #STKORDER SET PARTICULAR =  PARTICULAR + REPLICATE(' ',@LEN-LEN(PARTICULAR)) + '[' + REPLICATE(' ',@LEN_FWT - LEN(FROMWEIGHT)) + CONVERT(VARCHAR,FROMWEIGHT) + ' TO ' + REPLICATE(' ',@LEN_TWT - LEN(TOWEIGHT)) + CONVERT(VARCHAR,TOWEIGHT) + ']' WHERE RESULT = 1"
        strSql += vbCrLf + " IF @RTYPE = 'S'"
        strSql += vbCrLf + " 	DELETE FROM #STKORDER WHERE NOT (DIFFPCS < 0 OR DIFFWT < 0)"
        strSql += vbCrLf + " IF @RTYPE = 'E'"
        strSql += vbCrLf + " 	DELETE FROM #STKORDER WHERE NOT (DIFFPCS > 0 OR DIFFWT > 0)"
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF (SELECT COUNT(*) FROM #STKORDER)>0  "
        strSql += vbCrLf + " 	BEGIN  "
        strSql += vbCrLf + " 	INSERT INTO #STKORDER(PARTICULAR,RESULT,COLHEAD,STKPCS,STKWT,REPCS,REWT,DIFFPCS,DIFFWT)  "
        strSql += vbCrLf + " 	SELECT 'GRAND TOTAL',3 RESULT,'G'COLHEAD,SUM(STKPCS),SUM(STKWT),SUM(REPCS),SUM(REWT),SUM(DIFFPCS),SUM(DIFFWT)  "
        strSql += vbCrLf + " 	FROM #STKORDER WHERE RESULT IN (1,2)"
        strSql += vbCrLf + " 	END  "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPITEMMAST') IS NOT NULL DROP TABLE TEMPITEMMAST  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPSUBITEMMAST') IS NOT NULL DROP TABLE TEMPSUBITEMMAST  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPITEMSIZE') IS NOT NULL DROP TABLE TEMPITEMSIZE  "
        strSql += vbCrLf + " IF OBJECT_ID('TEMPCOSTCENTRE') IS NOT NULL DROP TABLE TEMPCOSTCENTRE"

        strSql += vbCrLf + " SELECT * FROM #STKORDER ORDER BY RESULT,ITEMNAME,SUBITEMNAME"

        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_ITEMWISESALES()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_ITEMWISESALES')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_ITEMWISESALES"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " CREATE PROCEDURE SP_RPT_ITEMWISESALES"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @FROMDATE VARCHAR(20)"
        strSql += vbCrLf + " ,@TODATE VARCHAR(20)"
        strSql += vbCrLf + " ,@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + " ,@COSTID VARCHAR(5000)"
        strSql += vbCrLf + " ,@METALID VARCHAR(5000)"
        strSql += vbCrLf + " ,@ITEMID VARCHAR(8000)"
        strSql += vbCrLf + " ,@SUBITEMID VARCHAR(8000)"
        strSql += vbCrLf + " ,@COUNTERID VARCHAR(8000)"
        strSql += vbCrLf + " ,@GROUPBY VARCHAR(5)"
        strSql += vbCrLf + " ,@ORDERBYNAME VARCHAR(1) /** Y OR N **/"
        strSql += vbCrLf + " ,@RPTTYPE VARCHAR(1) /** (D)etailed/(S)ummary **/"
        strSql += vbCrLf + " ,@WITHSUBITEMGROUP VARCHAR(1) /** Y **/"
        strSql += vbCrLf + " ,@TRANTYPE VARCHAR(50) /** SA,MI **/"
        strSql += vbCrLf + " ,@DESIGNER VARCHAR(1000) /** DESIGNERNAME **/"
        strSql += vbCrLf + " ,@ISTAG VARCHAR(1) /** NO OF TAGS **/"
        strSql += vbCrLf + " ,@SYSTEMID VARCHAR(1000)"
        strSql += vbCrLf + " ,@DBNAME VARCHAR(20)"
        strSql += vbCrLf + " ,@WITHTALLY VARCHAR(1)"
        strSql += vbCrLf + " ,@SYSID VARCHAR(3)"
        strSql += vbCrLf + " ,@GRAND VARCHAR(1)"
        strSql += vbCrLf + " ,@BILLFROM VARCHAR(10)"
        strSql += vbCrLf + " ,@BILLTO VARCHAR(10)"
        strSql += vbCrLf + " ,@WITHSR VARCHAR(1)"
        strSql += vbCrLf + " ,@WITHTAX VARCHAR(1)"
        strSql += vbCrLf + " ,@SPECIFIC VARCHAR(1)"
        strSql += vbCrLf + " ,@STNWTCOL VARCHAR(1)"
        strSql += vbCrLf + " ,@EMPLOYEEID VARCHAR(1000) /** @EMPLOYEEID **/"
        strSql += vbCrLf + " ,@WITHHALLMARK VARCHAR(3) "
        strSql += vbCrLf + " ,@WITHOUTRDADJ VARCHAR(1)"
        strSql += vbCrLf + " ,@TAGTYPE VARCHAR(1)"
        strSql += vbCrLf + " ,@CHITCOMPANYID VARCHAR(10) = ''"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " 	SET NOCOUNT ON"
        strSql += vbCrLf + " 	DECLARE @QRY VARCHAR(8000)"
        strSql += vbCrLf + " 	DECLARE @QRY2 VARCHAR(8000)"
        strSql += vbCrLf + " 	DECLARE @COSTFILTER VARCHAR(4000)"
        strSql += vbCrLf + " 	DECLARE @SQLVERSION AS INTEGER"
        strSql += vbCrLf + " 	SET @SQLVERSION =0"
        strSql += vbCrLf + " 	SELECT @SQLVERSION = ISNULL(SUBSTRING(CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')),1,CHARINDEX('.',CONVERT(VARCHAR,SERVERPROPERTY('PRODUCTVERSION')))-1) ,0)"
        strSql += vbCrLf + "	DECLARE @SPECIFICFORMAT AS INTEGER"
        strSql += vbCrLf + " 	SET @SPECIFICFORMAT =0"
        strSql += vbCrLf + " 	SELECT @SPECIFICFORMAT = ISNULL(CTLTEXT,0) FROM SOFTCONTROL WHERE CTLID='SPECIFICFORMAT'"
        strSql += vbCrLf + "	DECLARE @HIDEREPAIRDET AS VARCHAR(1) "
        strSql += vbCrLf + "	SET @HIDEREPAIRDET ='N' "
        strSql += vbCrLf + "	SELECT @HIDEREPAIRDET = ISNULL(CTLTEXT,'N') FROM SOFTCONTROL WHERE CTLID='RPT_ITEMWISESALES_HIDE_REPDET' "
        strSql += vbCrLf + " 	SET @COSTFILTER=''"
        strSql += vbCrLf + " 	IF @COSTID<>'ALL' SELECT @COSTFILTER=' AND I.COSTID IN('+ @COSTID +')'"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPCOMPANY',@INPUTVALUES = @COMPANYID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'METALMAST',@CHK_FEILD = 'METALID',@RESULT_TBL = 'TEMPMETAL',@INPUTVALUES = @METALID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEM',@INPUTVALUES = @ITEMID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'SUBITEMMAST',@CHK_FEILD = 'SUBITEMID',@RESULT_TBL = 'TEMPSUBITEM',@INPUTVALUES = @SUBITEMID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'ITEMCOUNTER',@CHK_FEILD = 'ITEMCTRID',@RESULT_TBL = 'TEMPCOUNTER',@INPUTVALUES = @COUNTERID"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES @CHK_DB = '" & cnAdminDb & "',@CHK_TBL = 'COMPANY',@CHK_FEILD = 'COMPANYID',@RESULT_TBL = 'TEMPTRANTYPE',@INPUTVALUES = @TRANTYPE"
        strSql += vbCrLf + " 	EXEC SP_SPLITVALUES  @CHK_DB = '" & cnAdminDb & "', @CHK_TBL = 'DESIGNER', @CHK_FEILD = 'DESIGNERID',@RESULT_TBL = 'TEMPDESIGNER',@INPUTVALUES = @DESIGNER"
        strSql += vbCrLf + " 	IF OBJECT_ID('TEMPDB..#SYSTEM', 'U') IS NOT NULL DROP TABLE #SYSTEM   	"
        strSql += vbCrLf + " 	CREATE TABLE #SYSTEM (SYSTEMID VARCHAR(5))"
        strSql += vbCrLf + " 	DECLARE @TSYSTEMID VARCHAR(5)"
        strSql += vbCrLf + " 	IF CHARINDEX(',',@SYSTEMID)=0"
        strSql += vbCrLf + " 	BEGIN    "
        strSql += vbCrLf + " 		IF @SYSTEMID = 'EMPTY'    "
        strSql += vbCrLf + " 		SET @SYSTEMID = ''      "
        strSql += vbCrLf + " 		INSERT INTO #SYSTEM (SYSTEMID) SELECT @SYSTEMID     "
        strSql += vbCrLf + " 	END"
        strSql += vbCrLf + " 	WHILE CHARINDEX(',',@SYSTEMID)>0 "
        strSql += vbCrLf + " 	BEGIN "
        strSql += vbCrLf + " 		SET @TSYSTEMID=LEFT(@SYSTEMID,CHARINDEX(',',@SYSTEMID)-1)     "
        strSql += vbCrLf + " 		SET @SYSTEMID=RIGHT(@SYSTEMID,LEN(@SYSTEMID)-CHARINDEX(',',@SYSTEMID)) "
        strSql += vbCrLf + " 		IF @SYSTEMID <>'' AND CHARINDEX(',',@SYSTEMID)=0 "
        strSql += vbCrLf + " 		SET @SYSTEMID= @SYSTEMID + ',' "
        strSql += vbCrLf + " 		IF @TSYSTEMID = 'EMPTY'    "
        strSql += vbCrLf + " 		SET @TSYSTEMID = ''    "
        strSql += vbCrLf + " 		INSERT INTO #SYSTEM (SYSTEMID) SELECT @TSYSTEMID "
        strSql += vbCrLf + " 	END   "
        strSql += vbCrLf + " 	SELECT @QRY= '  IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPTALLY'+@SYSID+''') DROP TABLE TEMPTABLEDB..TEMPTALLY'+@SYSID+''  "
        strSql += vbCrLf + " 	EXEC(@QRY)  "
        strSql += vbCrLf + " 	PRINT 'HELLLOOO'"
        strSql += vbCrLf + " 	SELECT @QRY= '  IF  EXISTS (SELECT * FROM TEMPTABLEDB..SYSOBJECTS WHERE XTYPE = ''U'' AND NAME = ''TEMPITEMSALES1'') DROP TABLE TEMPTABLEDB..TEMPITEMSALES1'  "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  SELECT * INTO TEMPTABLEDB..TEMPITEMSALES1 FROM ( '    "
        strSql += vbCrLf + " 	SELECT @QRY= @QRY+CHAR(13)+'  SELECT '        "
        strSql += vbCrLf + " 	IF @GROUPBY='IGRP' "
        strSql += vbCrLf + " 		SELECT @QRY= @QRY+CHAR(13)+'  CONVERT(VARCHAR(400),IM.ITEMNAME) AS PARTICULAR '  "
        strSql += vbCrLf + " 	ELSE IF @GROUPBY='IGRE' "
