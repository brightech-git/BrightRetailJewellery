        strSql += vbCrLf + " dt.<DATETIME> SSL <COSTID>&template_id=1207164337426910234')"

        strSql += vbCrLf + " EXEC " & cnAdminDb & "..[SP_INSERTSMS_WMCTABLE]"
        strSql += vbCrLf + " @ITEMID = 110"
        strSql += vbCrLf + " ,@SUBITEMID = 509"
