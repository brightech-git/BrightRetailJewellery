        'strSql += vbCrLf + "  		WHERE PAYMODE IN ('SA','SR','PU','SV','RV','PV')    "
        'strSql += vbCrLf + "  	END    "
        'strSql += vbCrLf + "  	SELECT @QRY=CHAR(13)+' INSERT INTO TEMPTABLEDB..TEMPDAYBOOK(TRANDATE,TRANNO,PARTICULAR'"
        'strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' ,DEBIT,CREDIT,GRSWT,ACCODE,PAYMODE,RESULT,BATCHNO,ENTRYORDER,REFNO,REFDATE,CHQCARDNO,CHQDATE)              '"
        'strSql += vbCrLf + "  	SELECT @QRY=@QRY+CHAR(13)+' /** POS TRANS **/              '"
