    End Sub

    Private Sub funcSP26_W_SmithLedgerSummary()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_PROC_W_SMITHLEDGER_SUMMARY')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_PROC_W_SMITHLEDGER_SUMMARY"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = " SELECT CTLTEXT FROM " & cnAdminDb & "..SOFTCONTROL WHERE CTLID = 'WJEWELADMINDB'"
        Dim WAdmindb As String = GetSqlValue(strSql, , tran)
        If WAdmindb = "" Then WAdmindb = cnAdminDb Else WAdmindb += "ADMINDB"

        strSql = vbCrLf + "  CREATE PROCEDURE SP_PROC_W_SMITHLEDGER_SUMMARY    "
        strSql += vbCrLf + "    (    "
        strSql += vbCrLf + "    @FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + "    ,@TODATE SMALLDATETIME    "
        strSql += vbCrLf + "    ,@BwtZero varchar(1)"
        strSql += vbCrLf + "    )    "
        strSql += vbCrLf + "    AS    "
        strSql += vbCrLf + "    /**DECLARE @FROMDATE SMALLDATETIME    "
        strSql += vbCrLf + "    DECLARE @TODATE SMALLDATETIME    "
        strSql += vbCrLf + "    SELECT @FROMDATE = '2010-11-01'    "
        strSql += vbCrLf + "    SELECT @TODATE = '2010-11-05' **/  "
        strSql += vbCrLf + "    IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPSMITHLEDGER_SUMMARY')>0 DROP TABLE MASTER..TEMPSMITHLEDGER_SUMMARY    "
        strSql += vbCrLf + "    SELECT     "
        strSql += vbCrLf + "    H.ACNAME,(SELECT METALNAME FROM " & WAdmindb & "..METALMAST WHERE METALID = Y.METAL)AS METALNAME  "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'OPE' THEN PUREWT ELSE 0 END) AS WT_OPENING    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'REC' THEN GRSWT ELSE 0 END) AS WT_RGRSWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'REC' THEN NETWT ELSE 0 END) AS WT_RNETWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'REC' THEN PUREWT ELSE 0 END) AS WT_RPUREWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN GRSWT ELSE 0 END) AS WT_IGRSWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN NETWT ELSE 0 END) AS WT_INETWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN PUREWT ELSE 0 END) AS WT_IPUREWT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN -1*PUREWT ELSE PUREWT END) AS WT_CLOSING    "
        strSql += vbCrLf + "    ,(SELECT CONVERT(VARCHAR,MAX(TRANDATE),103) FROM " & tranDbName & "..W_RECEIPT WHERE ACCODE=Y.ACCODE ) AS LASTTRANDATE"
        strSql += vbCrLf + "    ,(SELECT CONVERT(VARCHAR,DATEDIFF(DAY,MAX(TRANDATE),GETDATE()))+' days' FROM " & tranDbName & "..W_RECEIPT WHERE ACCODE=Y.ACCODE ) AS NODAYS  "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'OPE' THEN AMOUNT ELSE 0 END) AS AMT_OPENING    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'REC' THEN AMOUNT ELSE 0 END) AS AMT_RECEIPT    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN AMOUNT ELSE 0 END) AS AMT_ISSUE    "
        strSql += vbCrLf + "    ,SUM(CASE WHEN SEP = 'ISS' THEN -1*AMOUNT ELSE AMOUNT END) AS AMT_CLOSING    "
        strSql += vbCrLf + "    ,CONVERT(INT,1) RESULT     "
        strSql += vbCrLf + "    ,CONVERT(INT,1)GRESULT  "
        strSql += vbCrLf + "    ,CONVERT(vARCHAR(1),NULL)COLHEAD    "
        strSql += vbCrLf + "    INTO MASTER..TEMPSMITHLEDGER_SUMMARY    "
        strSql += vbCrLf + "    FROM    "
        strSql += vbCrLf + "    (    "
        strSql += vbCrLf + "     SELECT CONVERT(VARCHAR(3),METAL)METAL,'OPE'SEP,ACCODE,PUREWT,AMOUNT,CONVERT(NUMERIC(15,3),GRSWT)GRSWT,CONVERT(NUMERIC(15,3),NETWT)NETWT    "
        strSql += vbCrLf + "     FROM      "
        strSql += vbCrLf + "     (      "
        strSql += vbCrLf + "     SELECT 'G' METAL,ACCODE,CREDITWT-DEBITWT PUREWT,CREDIT-DEBIT AMOUNT,CREDITWT-DEBITWT GRSWT,CREDITWT-DEBITWT NETWT FROM " & tranDbName & "..OPENTRAILBALANCE WHERE ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,ACCODE,CASE WHEN TRANTYPE = 'R' THEN PUREWT ELSE -1*PUREWT END AS PUREWT    "
        strSql += vbCrLf + "       ,CONVERT(NUMERIC(15,2),0)AMOUNT      "
        strSql += vbCrLf + "       ,CASE WHEN TRANTYPE = 'R' THEN GRSWT ELSE -1*GRSWT END AS GRSWT    "
        strSql += vbCrLf + "       ,CASE WHEN TRANTYPE = 'R' THEN NETWT ELSE -1*NETWT END AS NETWT    "
        strSql += vbCrLf + "     FROM " & tranDbName & "..OPENWEIGHT I WHERE ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I') )    "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,ACCODE,-1*PUREWT,0 AMOUNT,-1*GRSWT GRSWT,-1*NETWT AS NETWT FROM " & tranDbName & "..W_ISSUE I WHERE TRANDATE < @FROMDATE AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD   "
        strSql += vbCrLf + "     WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     AND ISNULL(CANCEL,'') = ''      "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,ACCODE,PUREWT,0 AMOUNT,GRSWT,NETWT      "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_RECEIPT I WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'') = ''  AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,R.ACCODE,I.STNWT,0 AMOUNT,I.STNWT,I.STNWT  "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_RECEIPTSTONE I   "
        strSql += vbCrLf + "     INNER JOIN " & tranDbName & "..W_RECEIPT AS R ON R.SNO = I.ISSSNO AND R.TRANDATE < @FROMDATE AND ISNULL(R.CANCEL,'') = ''  AND R.ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))  "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT 'G' METAL,ACCODE,0 PUREWT,CASE WHEN TRANMODE = 'C' THEN AMOUNT ELSE -1*AMOUNT END AS AMOUNT, 0 GRSWT, 0 NETWT    "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_ACCTRAN WHERE TRANDATE < @FROMDATE AND ISNULL(CANCEL,'') = ''  AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     )X     "
        strSql += vbCrLf + "     UNION ALL    "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,'ISS'SEP,ACCODE,PUREWT,0 AMOUNT,GRSWT,NETWT FROM " & tranDbName & "..W_ISSUE I WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD"


        strSql += vbCrLf + "     WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     AND ISNULL(CANCEL,'') = ''      "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,'REC'SEP,ACCODE,PUREWT,0 AMOUNT,GRSWT,NETWT    "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_RECEIPT I WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''  AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT (SELECT METALID FROM " & WAdmindb & "..CATEGORY WHERE CATCODE = I.CATCODE)AS METAL,'REC'SEP,R.ACCODE,I.STNWT,0 AMOUNT,I.STNWT,I.STNWT  "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_RECEIPTSTONE I   "
        strSql += vbCrLf + "     INNER JOIN " & tranDbName & "..W_RECEIPT AS R ON R.SNO = I.ISSSNO AND R.TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(R.CANCEL,'') = ''  AND R.ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))  "
        strSql += vbCrLf + "     UNION ALL      "
        strSql += vbCrLf + "     SELECT 'G' AS METAL,CASE WHEN TRANMODE = 'D' THEN 'ISS' ELSE 'REC' END AS SEP,ACCODE,0 PUREWT,AMOUNT,0 GRSWT,0 NETWT    "
        strSql += vbCrLf + "     FROM " & tranDbName & "..W_ACCTRAN I WHERE TRANDATE BETWEEN @FROMDATE AND @TODATE AND ISNULL(CANCEL,'') = ''  AND ACCODE IN (SELECT ACCODE FROM " & WAdmindb & "..ACHEAD WHERE ACTYPE IN ('G','D','I'))    "
        strSql += vbCrLf + "    )Y , " & WAdmindb & "..ACHEAD AS H WHERE Y.ACCODE = H.ACCODE GROUP BY H.ACNAME,Y.METAL,Y.ACCODE"
        strSql += vbCrLf + "    IF @BwtZero='Y'"
        strSql += vbCrLf + "    BEGIN"
        strSql += vbCrLf + "  DELETE FROM MASTER..TEMPSMITHLEDGER_SUMMARY WHERE ISNULL(WT_CLOSING,0) BETWEEN 0 AND 1 "
        strSql += vbCrLf + "  --NOT IN (SELECT WT_CLOSING FROM MASTER..TEMPSMITHLEDGER_SUMMARY WHERE ISNULL(WT_CLOSING,0) >=1 OR ISNULL(WT_CLOSING,0) <=-0 AND WT_CLOSING IS NOT NULL) "
        strSql += vbCrLf + "    END "
        strSql += vbCrLf + "    IF (SELECT COUNT(*) FROM MASTER..TEMPSMITHLEDGER_SUMMARY)>0        --  "
        strSql += vbCrLf + "    BEGIN    "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMPSMITHLEDGER_SUMMARY(ACNAME,METALNAME,RESULT,GRESULT,COLHEAD)  "
        strSql += vbCrLf + "    SELECT DISTINCT METALNAME,METALNAME,0 RESULT,0 GRESULT,'T'COLHEAD FROM MASTER..TEMPSMITHLEDGER_SUMMARY WHERE RESULT = 1  "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMPSMITHLEDGER_SUMMARY(ACNAME,METALNAME,WT_OPENING,WT_RGRSWT    "
        strSql += vbCrLf + "    ,WT_RNETWT,WT_INETWT,WT_RPUREWT,WT_IGRSWT,WT_IPUREWT,WT_CLOSING,AMT_OPENING,AMT_RECEIPT,AMT_ISSUE,AMT_CLOSING,RESULT,COLHEAD,GRESULT)    "
        strSql += vbCrLf + "    SELECT 'SUB TOTAL' AS ACNAME,METALNAME,SUM(ISNULL(WT_OPENING,0)),SUM(ISNULL(WT_RGRSWT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(WT_RNETWT,0)),SUM(ISNULL(WT_INETWT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(WT_RPUREWT,0)),SUM(ISNULL(WT_IGRSWT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(WT_IPUREWT,0)),SUM(ISNULL(WT_CLOSING,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(AMT_OPENING,0)),SUM(ISNULL(AMT_RECEIPT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(AMT_ISSUE,0)),SUM(ISNULL(AMT_CLOSING,0))    "
        strSql += vbCrLf + "    ,2 RESULT,'S'COLHEAD,1 GRESULT  "
        strSql += vbCrLf + "    FROM MASTER..TEMPSMITHLEDGER_SUMMARY WHERE RESULT = 1  GROUP BY METALNAME  "
        strSql += vbCrLf + "    INSERT INTO MASTER..TEMPSMITHLEDGER_SUMMARY(ACNAME,METALNAME,WT_OPENING,WT_RGRSWT    "
        strSql += vbCrLf + "    ,WT_RNETWT,WT_INETWT,WT_RPUREWT,WT_IGRSWT,WT_IPUREWT,WT_CLOSING,AMT_OPENING,AMT_RECEIPT,AMT_ISSUE,AMT_CLOSING,RESULT,COLHEAD,GRESULT)    "
        strSql += vbCrLf + "    SELECT 'GRAND TOTAL' AS ACNAME,'ZZZZZZZZZ'METALNAME,SUM(ISNULL(WT_OPENING,0)),SUM(ISNULL(WT_RGRSWT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(WT_RNETWT,0)),SUM(ISNULL(WT_INETWT,0))              ,SUM(ISNULL(WT_RPUREWT,0)),SUM(ISNULL(WT_IGRSWT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(WT_IPUREWT,0)),SUM(ISNULL(WT_CLOSING,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(AMT_OPENING,0)),SUM(ISNULL(AMT_RECEIPT,0))    "
        strSql += vbCrLf + "    ,SUM(ISNULL(AMT_ISSUE,0)),SUM(ISNULL(AMT_CLOSING,0))    "
        strSql += vbCrLf + "    ,2 RESULT,'G'COLHEAD,2 GRESULT  "
        strSql += vbCrLf + "    FROM MASTER..TEMPSMITHLEDGER_SUMMARY WHERE RESULT = 1    "
        strSql += vbCrLf + "    END    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_OPENING = NULL WHERE WT_OPENING = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_RGRSWT = NULL WHERE WT_RGRSWT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_RNETWT = NULL WHERE WT_RNETWT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_RPUREWT = NULL WHERE WT_RPUREWT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_IGRSWT = NULL WHERE WT_IGRSWT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_IPUREWT = NULL WHERE WT_IPUREWT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET WT_CLOSING = NULL WHERE WT_CLOSING = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET AMT_OPENING = NULL WHERE AMT_OPENING = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET AMT_RECEIPT = NULL WHERE AMT_RECEIPT = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET AMT_ISSUE = NULL WHERE AMT_ISSUE = 0    "
        strSql += vbCrLf + "    UPDATE MASTER..TEMPSMITHLEDGER_SUMMARY SET AMT_CLOSING = NULL WHERE AMT_CLOSING = 0    "
        strSql += vbCrLf + "    DELETE FROM MASTER..TEMPSMITHLEDGER_SUMMARY    "
        strSql += vbCrLf + "    WHERE     "
        strSql += vbCrLf + "    WT_OPENING IS NULL    "
        strSql += vbCrLf + "    AND WT_RGRSWT IS NULL      "
        strSql += vbCrLf + "    AND WT_RNETWT IS NULL    "
        strSql += vbCrLf + "    AND WT_RPUREWT IS NULL    "
        strSql += vbCrLf + "    AND WT_IGRSWT IS NULL    "
        strSql += vbCrLf + "    AND WT_IPUREWT IS NULL    "
        strSql += vbCrLf + "    AND WT_CLOSING IS NULL    "
        strSql += vbCrLf + "    AND AMT_OPENING IS NULL    "
        strSql += vbCrLf + "    AND AMT_RECEIPT IS NULL    "
        strSql += vbCrLf + "    AND AMT_ISSUE IS NULL    "
        strSql += vbCrLf + "    AND AMT_CLOSING IS NULL    "
        strSql += vbCrLf + "    AND GRESULT <> 0  "
        strSql += vbCrLf + "    SELECT * FROM MASTER..TEMPSMITHLEDGER_SUMMARY ORDER BY METALNAME,GRESULT,RESULT,ACNAME   "


        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_TAGRESERVED()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='RPT_TAGRESERVED')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE RPT_TAGRESERVED"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = "  CREATE PROCEDURE RPT_TAGRESERVED"
        strSql += vbCrLf + "   ("
        strSql += vbCrLf + "    @ASD VARCHAR(1)  "
        strSql += vbCrLf + "   ,@FROMDATE VARCHAR(20)  "
        strSql += vbCrLf + "   ,@TODATE VARCHAR(20)  "
        strSql += vbCrLf + "   ,@COMPANYID VARCHAR(5000)"
        strSql += vbCrLf + "   ,@COSTNAME VARCHAR(2000)  "
        strSql += vbCrLf + "   ,@WITHCOUNTER VARCHAR(1)"
        strSql += vbCrLf + "   ,@WITHDIRECT VARCHAR(1)"
        strSql += vbCrLf + "   ,@STATUS VARCHAR(1)"
        strSql += vbCrLf + "   ,@ITEMWISE varchar(1)"
        strSql += vbCrLf + "   )  "
        strSql += vbCrLf + "   AS  "
        strSql += vbCrLf + "   BEGIN"
        strSql += vbCrLf + "   	SET NOCOUNT ON  "
        strSql += vbCrLf + "   	DECLARE @QRY VARCHAR(8000)     "
        strSql += vbCrLf + "   	/**SPLIT COMPANY **/               "
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPDB..#COMPANY', 'U') IS NOT NULL DROP TABLE #COMPANY "
        strSql += vbCrLf + "   	IF OBJECT_ID('TEMPTABLEDB..TEMPTMP', 'U') IS NOT NULL DROP TABLE TEMPTABLEDB..TEMPTMP "
        strSql += vbCrLf + "   	CREATE TABLE #COMPANY (COMPANYID VARCHAR(3))       "
        strSql += vbCrLf + "   	DECLARE @TCOMPANY VARCHAR(50)       "
        strSql += vbCrLf + "   	IF CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + "   	BEGIN       "
        strSql += vbCrLf + "   		INSERT INTO #COMPANY (COMPANYID) SELECT @COMPANYID       "
        strSql += vbCrLf + "   	END       "
        strSql += vbCrLf + "   	WHILE CHARINDEX(',',@COMPANYID)>0       "
        strSql += vbCrLf + "   	BEGIN       "
        strSql += vbCrLf + "   		SET @TCOMPANY=LEFT(@COMPANYID,CHARINDEX(',',@COMPANYID)-1)       "
        strSql += vbCrLf + "   		SET @COMPANYID=RIGHT(@COMPANYID,LEN(@COMPANYID)-CHARINDEX(',',@COMPANYID))       "
        strSql += vbCrLf + "   		IF @COMPANYID <>'' AND CHARINDEX(',',@COMPANYID)=0       "
        strSql += vbCrLf + "   		BEGIN       "
        strSql += vbCrLf + "   			SET @COMPANYID= @COMPANYID + ','       "
        strSql += vbCrLf + "   		END       "
        strSql += vbCrLf + "   		INSERT INTO #COMPANY (COMPANYID) SELECT @TCOMPANY       "
        strSql += vbCrLf + "   	END "
        strSql += vbCrLf + "   	/**SPLIT COSTNAME **/             "
        strSql += vbCrLf + "   	CREATE TABLE #COSTCENTRE (COSTID VARCHAR(3))             "
        strSql += vbCrLf + "   	IF @COSTNAME = 'ALL' OR @COSTNAME = ''             "
        strSql += vbCrLf + "   		INSERT INTO #COSTCENTRE(COSTID)SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE UNION ALL SELECT ''             "
        strSql += vbCrLf + "   	ELSE IF (SELECT COUNT(*) FROM " & cnAdminDb & "..COSTCENTRE)>0"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		DECLARE @TEMPNAME VARCHAR(20)"
        strSql += vbCrLf + "   		IF CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "   		INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @COSTNAME              "
        strSql += vbCrLf + "   		WHILE CHARINDEX(',',@COSTNAME)>0"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			SET @TEMPNAME=LEFT(@COSTNAME,CHARINDEX(',',@COSTNAME)-1)"
        strSql += vbCrLf + "   			SET @COSTNAME=RIGHT(@COSTNAME,LEN(@COSTNAME)-CHARINDEX(',',@COSTNAME))"
        strSql += vbCrLf + "   			IF @COSTNAME <>'' AND CHARINDEX(',',@COSTNAME)=0"
        strSql += vbCrLf + "   			SET @COSTNAME= @COSTNAME + ','"
        strSql += vbCrLf + "   			INSERT INTO #COSTCENTRE (COSTID) SELECT COSTID FROM " & cnAdminDb & "..COSTCENTRE WHERE COSTNAME = @TEMPNAME"
        strSql += vbCrLf + "   		END"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	ELSE"
        strSql += vbCrLf + "   		INSERT INTO #COSTCENTRE(COSTID)SELECT ''      "
        strSql += vbCrLf + "   	SELECT @QRY='SELECT (SELECT TOP 1 ITEMCTRNAME FROM " & cnAdminDb & "..ITEMCOUNTER WHERE ITEMCTRID = T.ITEMCTRID ) AS COUNTERNAME,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' O.TRANDATE ,O.TRANNO,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 PNAME FROM " & cnAdminDb & "..PERSONALINFO  WHERE SNO = '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO= O.BATCHNO)) AS CUSTOMER,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 MOBILE FROM " & cnAdminDb & "..PERSONALINFO  WHERE SNO = '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 PSNO FROM " & cnAdminDb & "..CUSTOMERINFO WHERE BATCHNO= O.BATCHNO)) AS MOBILE,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' O.AMOUNT, '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.ITEMID  ) AS ITEMNAME,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' (SELECT TOP 1 SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID  ) AS SUBITEMNAME,'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' T.TAGNO ,T.PCS ,T.GRSWT ,T.NETWT ,  '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' CONVERT(VARCHAR(3),''D'')COLHEAD,CONVERT(INT,2)RESULT, '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' CONVERT(VARCHAR(1),CASE WHEN ISSDATE IS NULL THEN ''P''WHEN ISSDATE IS NOT NULL THEN ''D'' END)[STATUS] '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' INTO TEMPTABLEDB..TEMPTMP'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' FROM  " & cnAdminDb & "..ITEMTAG T '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' LEFT OUTER JOIN " & cnAdminDb & "..OUTSTANDING AS O  ON O.BATCHNO=T.BATCHNO AND  O.TRANTYPE IN(''A'',''C'')  '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.CANCEL,'''')<>''Y''  AND  O.COMPANYID IN (SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY) '"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' WHERE 1=1 '"
        strSql += vbCrLf + "   	IF @ASD = 'Y'		"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.TRANDATE,''2000-01-01'') < '''+@FROMDATE+''' '		"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND T.APPROVAL =''R'' AND ISNULL(T.ISSDATE,'''') = '''' AND  T.COMPANYID IN (SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY)'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	ELSE		"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.TRANDATE,''2000-01-01'')  BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND T.APPROVAL =''R'' AND ISNULL(T.ISSDATE,'''') = '''' AND  T.COMPANYID IN (SELECT COMPANYID FROM " & cnAdminDb & "..COMPANY)'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND T.BATCHNO IN (SELECT BATCHNO FROM " & cnAdminDb & "..OUTSTANDING WHERE TRANDATE BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''')'"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	IF @STATUS ='P'"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.ISSDATE,'''') = '''' '"
        strSql += vbCrLf + "   		END"
        strSql += vbCrLf + "   	ELSE IF @STATUS = 'D'"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.ISSDATE,'''') <> '''' '"
        strSql += vbCrLf + "   		END"
        strSql += vbCrLf + "   	/*SELECT @QRY=@QRY+CHAR(13)+' AND  O.TRANTYPE IN(''A'',''C'') AND ISNULL(O.CANCEL,'''')<>''Y'''"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' AND  O.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'"
        strSql += vbCrLf + "   	SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'*/"
        strSql += vbCrLf + "   	IF @WITHDIRECT='Y'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' UNION ALL'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' SELECT NULL AS COUNTERNAME'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,O.TRANDATE ,NULL TRANNO'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS CUSTOMER'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS MOBILE'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,NULL AS AMOUNT '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 ITEMNAME FROM " & cnAdminDb & "..ITEMMAST WHERE ITEMID = T.ITEMID  ) AS ITEMNAME'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,(SELECT TOP 1 SUBITEMNAME FROM " & cnAdminDb & "..SUBITEMMAST WHERE SUBITEMID = T.SUBITEMID  ) AS SUBITEMNAME'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,T.TAGNO '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,T.PCS '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,T.GRSWT '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,T.NETWT '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' ,CONVERT(VARCHAR(3),''D'')COLHEAD,CONVERT(INT,2)RESULT,'' '' [STATUS] '"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' FROM  BOOKEDITEM_HISTORY O'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' INNER JOIN " & cnAdminDb & "..ITEMTAG T ON O.TAGNO = T.TAGNO '"
        strSql += vbCrLf + "   		IF @ASD = 'Y'"
        strSql += vbCrLf + "   			BEGIN"
        strSql += vbCrLf + "   				SELECT @QRY=@QRY+CHAR(13)+' WHERE ISNULL(O.TRANDATE,''2000-01-01'') < '''+@FROMDATE+''' '"
        strSql += vbCrLf + "   			END"
        strSql += vbCrLf + "   		ELSE"
        strSql += vbCrLf + "   			BEGIN"
        strSql += vbCrLf + "   				SELECT @QRY=@QRY+CHAR(13)+' WHERE ISNULL(O.TRANDATE,''2000-01-01'')  BETWEEN '''+@FROMDATE+''' AND '''+@TODATE+''' '"
        strSql += vbCrLf + "   			END"
        strSql += vbCrLf + "   		IF @STATUS ='P'"
        strSql += vbCrLf + "   			BEGIN"
        strSql += vbCrLf + "   				SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.ISSDATE,'''') = '''' '"
        strSql += vbCrLf + "   			END"
        strSql += vbCrLf + "   		ELSE IF @STATUS = 'D'"
        strSql += vbCrLf + "   			BEGIN"
        strSql += vbCrLf + "   				SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.ISSDATE,'''') <> '''' '"
        strSql += vbCrLf + "   			END"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND  O.COMPANYID IN (SELECT COMPANYID FROM #COMPANY)'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.COSTID,'''') IN (SELECT COSTID FROM #COSTCENTRE)'"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(O.BATCHNO,'''')='''''"
        strSql += vbCrLf + "   		SELECT @QRY=@QRY+CHAR(13)+' AND ISNULL(T.APPROVAL,'''')=''R'' '"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	EXEC(@QRY)"
        strSql += vbCrLf + "   	PRINT @QRY"

        strSql += vbCrLf + "   	SELECT @QRY=CHAR(13)+' DELETE FROM TEMPTABLEDB..TEMPTMP WHERE TAGNO IN ( '"
        strSql += vbCrLf + "     SELECT @QRY=@QRY+CHAR(13)+' SELECT TAGNO FROM TEMPTABLEDB..TEMPTMP  GROUP BY TAGNO HAVING COUNT(*) > 1) AND STATUS = '''' '"
        strSql += vbCrLf + "     EXEC(@QRY)"
        strSql += vbCrLf + "   	PRINT @QRY"

        strSql += vbCrLf + "   	IF @ITEMWISE <> 'Y'"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		IF @WITHCOUNTER = 'Y'"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			INSERT INTO TEMPTABLEDB..TEMPTMP (COUNTERNAME,COLHEAD,RESULT ) SELECT 	DISTINCT COUNTERNAME,'T',0  FROM TEMPTABLEDB..TEMPTMP  "
        strSql += vbCrLf + "   			INSERT INTO TEMPTABLEDB..TEMPTMP (COUNTERNAME,TRANNO,TRANDATE,AMOUNT,CUSTOMER,MOBILE,COLHEAD,RESULT )     "
        strSql += vbCrLf + "   			SELECT 	DISTINCT COUNTERNAME,TRANNO,TRANDATE,AMOUNT,CUSTOMER,MOBILE, "
        strSql += vbCrLf + "   			CONVERT(VARCHAR(3),'T')COLHEAD,  CONVERT(INT,1)RESULT    "
        strSql += vbCrLf + "   			FROM TEMPTABLEDB..TEMPTMP WHERE RESULT =2"
        strSql += vbCrLf + "   			INSERT INTO TEMPTABLEDB..TEMPTMP (COUNTERNAME,TRANNO,CUSTOMER,PCS,GRSWT,NETWT,TRANDATE,COLHEAD,RESULT ) "
        strSql += vbCrLf + "   			SELECT 	COUNTERNAME,'999999' TRANNO,CUSTOMER, SUM(ISNULL(PCS,0)),"
        strSql += vbCrLf + "   			SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),'2050-01-01',"
        strSql += vbCrLf + "   			CONVERT(VARCHAR(3),'S')COLHEAD,	CONVERT(INT,3)RESULT    "
        strSql += vbCrLf + "   			FROM TEMPTABLEDB..TEMPTMP WHERE RESULT = 2"
        strSql += vbCrLf + "   			GROUP BY COUNTERNAME,CUSTOMER"
        strSql += vbCrLf + "   		END"
        strSql += vbCrLf + "   		IF @WITHCOUNTER = 'N'"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			INSERT INTO TEMPTABLEDB..TEMPTMP (TRANNO,TRANDATE,AMOUNT,CUSTOMER,MOBILE,COLHEAD,RESULT )     "
        strSql += vbCrLf + "   			SELECT 	DISTINCT TRANNO,TRANDATE,AMOUNT,CUSTOMER,MOBILE,"
        strSql += vbCrLf + "   			CONVERT(VARCHAR(3),'T')COLHEAD, CONVERT(INT,1)RESULT    "
        strSql += vbCrLf + "   			FROM TEMPTABLEDB..TEMPTMP WHERE RESULT =2"
        strSql += vbCrLf + "   			INSERT INTO TEMPTABLEDB..TEMPTMP (TRANNO,CUSTOMER,PCS,GRSWT,NETWT,TRANDATE,COLHEAD,RESULT ) "
        strSql += vbCrLf + "   			SELECT 	'999999' TRANNO,CUSTOMER, SUM(ISNULL(PCS,0)),"
        strSql += vbCrLf + "   			SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),'2050-01-01',"
        strSql += vbCrLf + "   			CONVERT(VARCHAR(3),'S')COLHEAD,	CONVERT(INT,3)RESULT    "
        strSql += vbCrLf + "   			FROM TEMPTABLEDB..TEMPTMP WHERE RESULT = 2"
        strSql += vbCrLf + "   			GROUP BY CUSTOMER"
        strSql += vbCrLf + "   		END"

        strSql += vbCrLf + "   		ALTER TABLE TEMPTABLEDB..TEMPTMP ADD SNO INT IDENTITY (1,1)"
        strSql += vbCrLf + "   		IF @WITHCOUNTER = 'N'  UPDATE TEMPTABLEDB..TEMPTMP SET COUNTERNAME=''"
        strSql += vbCrLf + "   		SELECT *, COUNTERNAME AS COUNTERNAME1,CUSTOMER AS CUSTOMER1"
        strSql += vbCrLf + "   		,TRANNO AS TRANNO1,TRANDATE AS TRANDATE1 INTO #_TMP1 FROM TEMPTABLEDB..TEMPTMP"
        strSql += vbCrLf + "   		UPDATE #_TMP1 SET CUSTOMER=  COUNTERNAME WHERE RESULT=0"
        strSql += vbCrLf + "   		UPDATE #_TMP1 SET COUNTERNAME =  NULL   WHERE RESULT IN(0,1)"
        strSql += vbCrLf + "   		UPDATE #_TMP1 SET TRANDATE=NULL ,CUSTOMER =NULL,MOBILE = NULL, AMOUNT=NULL,TRANNO=NULL ,COUNTERNAME =  NULL   WHERE RESULT=2"
        strSql += vbCrLf + "   		UPDATE #_TMP1 SET TRANDATE=NULL ,TRANNO =NULL, CUSTOMER =NULL ,MOBILE = NULL, ITEMNAME='SUB TOTAL' ,COUNTERNAME = NULL   WHERE RESULT=3"
        strSql += vbCrLf + "   		DECLARE @COUNTER VARCHAR(30)"
        strSql += vbCrLf + "   		DECLARE @SNO INT"
        strSql += vbCrLf + "   		DECLARE @DUPREC VARCHAR(100)"
        strSql += vbCrLf + "   		DECLARE @FIRSTCOUNTER VARCHAR(30)"
        strSql += vbCrLf + "   		SET @FIRSTCOUNTER =''"
        strSql += vbCrLf + "   		DECLARE RUNCUR SCROLL CURSOR FOR "
        strSql += vbCrLf + "   		SELECT DISTINCT COUNTERNAME,CUSTOMER+CONVERT(VARCHAR(10),TRANNO),SNO FROM #_TMP1  WHERE TRANNO IS NOT NULL"
        strSql += vbCrLf + "   		OPEN RUNCUR"
        strSql += vbCrLf + "   		WHILE 1=1"
        strSql += vbCrLf + "   		BEGIN"
        strSql += vbCrLf + "   			FETCH NEXT FROM RUNCUR INTO @COUNTER,@DUPREC,@SNO"
        strSql += vbCrLf + "   			IF @@FETCH_STATUS = -1 BREAK"
        strSql += vbCrLf + "   			IF @FIRSTCOUNTER <> @DUPREC   "
        strSql += vbCrLf + "   				SET @FIRSTCOUNTER = @DUPREC	"
        strSql += vbCrLf + "   			ELSE"
        strSql += vbCrLf + "   				UPDATE #_TMP1 SET AMOUNT=NULL WHERE   SNO=@SNO"
        strSql += vbCrLf + "   		END"
        strSql += vbCrLf + "   		CLOSE RUNCUR"
        strSql += vbCrLf + "   		DEALLOCATE RUNCUR"
        strSql += vbCrLf + "   		INSERT INTO #_TMP1 (COUNTERNAME1,TRANNO,ITEMNAME,PCS,GRSWT,NETWT,TRANDATE,COLHEAD,RESULT ) "
        strSql += vbCrLf + "   		SELECT 'ZZZZZZZZZ' COUNTERNAME1,NULL,'GRAND TOTAL', SUM(ISNULL(PCS,0)),"
        strSql += vbCrLf + "   		SUM(ISNULL(GRSWT,0)),SUM(ISNULL(NETWT,0)),NULL,"
        strSql += vbCrLf + "   		CONVERT(VARCHAR(3),'T')COLHEAD,	CONVERT(INT,4)RESULT"
        strSql += vbCrLf + "   		FROM #_TMP1 WHERE RESULT = 2"
        strSql += vbCrLf + "   		ALTER TABLE TEMPTABLEDB..TEMPTMP DROP COLUMN SNO "
        strSql += vbCrLf + "   		ALTER TABLE #_TMP1 DROP COLUMN SNO "
        strSql += vbCrLf + "   		SELECT *  FROM #_TMP1  ORDER BY COUNTERNAME1,CUSTOMER1,TRANNO1,TRANDATE1,RESULT	"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   	ELSE"
        strSql += vbCrLf + "   	BEGIN"
        strSql += vbCrLf + "   		SELECT CASE WHEN COLHEAD IN('T','S','G')THEN ITEMNAME END ITEMNAME,CASE WHEN COLHEAD NOT IN('T','S','G')THEN ITEMNAME END SUBITEMNAME"
        strSql += vbCrLf + "   		,TAGNO,AMOUNT,PCS,GRSWT,NETWT,RESULT,COLHEAD FROM("
        strSql += vbCrLf + "   		SELECT DISTINCT ITEMNAME AS ITEM,ITEMNAME,NULL TAGNO,NULL AMOUNT,NULL PCS,NULL GRSWT,NULL NETWT,0 RESULT,'T' AS COLHEAD"
        strSql += vbCrLf + "   		FROM  TEMPTABLEDB..TEMPTMP"
        strSql += vbCrLf + "   		UNION ALL"
        strSql += vbCrLf + "   		SELECT ITEMNAME AS ITEM,SUBITEMNAME,TAGNO,AMOUNT,PCS,GRSWT,NETWT,1 RESULT,'D' AS COLHEAD"
        strSql += vbCrLf + "   		FROM  TEMPTABLEDB..TEMPTMP"
        strSql += vbCrLf + "   		UNION ALL"
        strSql += vbCrLf + "   		SELECT ITEMNAME AS ITEM,'SUB TOTAL  '+ITEMNAME,NULL,SUM(AMOUNT),SUM(PCS),SUM(GRSWT),SUM(NETWT),2 RESULT,'S' AS COLHEAD"
        strSql += vbCrLf + "   		FROM  TEMPTABLEDB..TEMPTMP"
        strSql += vbCrLf + "   		GROUP BY ITEMNAME"
        strSql += vbCrLf + "   		UNION ALL"
        strSql += vbCrLf + "   		SELECT 'ZZZZZZZZZ' AS ITEM,'	 TOTAL  ',CONVERT(VARCHAR(15),COUNT(TAGNO)),SUM(AMOUNT),SUM(PCS),SUM(GRSWT),SUM(NETWT),3 RESULT,'G' AS COLHEAD"
        strSql += vbCrLf + "   		FROM  TEMPTABLEDB..TEMPTMP)X"
        strSql += vbCrLf + "   		ORDER BY ITEM,RESULT"
        strSql += vbCrLf + "   	END"
        strSql += vbCrLf + "   END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub SP_RPT_PACKETSTOCK()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='SP_RPT_PACKETSTOCK')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE SP_RPT_PACKETSTOCK"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
        strSql = vbCrLf + "  CREATE PROCEDURE SP_RPT_PACKETSTOCK    "
        strSql += vbCrLf + "     (    "
        strSql += vbCrLf + "     @FRMDATE SMALLDATETIME    "
        strSql += vbCrLf + "     ,@TODATE SMALLDATETIME    "
        strSql += vbCrLf + "     ,@WITHSUBITEM VARCHAR(1)    "
        strSql += vbCrLf + "     ,@GROUPBYITEM VARCHAR(1)"
        strSql += vbCrLf + "     ,@GROUPBYDESIGNER VARCHAR(1)    "
        strSql += vbCrLf + "     ,@ITEMID VARCHAR(8000)    "
        strSql += vbCrLf + "     ,@COSTID VARCHAR(8000)    "
        strSql += vbCrLf + "     ,@DESIGNERID VARCHAR(8000)    "
        strSql += vbCrLf + "     ,@COMPANYID VARCHAR(3)    "
        strSql += vbCrLf + "     ,@WITHVALUE VARCHAR(1)  "
        strSql += vbCrLf + "     )    "
        strSql += vbCrLf + "     AS    "
        strSql += vbCrLf + "     SET NOCOUNT ON    "
        strSql += vbCrLf + "     EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'DESIGNER',@CHK_FEILD = 'DESIGNERID',@RESULT_TBL = 'TEMPDESIGNER',@INPUTVALUES = @DESIGNERID"
        strSql += vbCrLf + "     EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'COSTCENTRE',@CHK_FEILD = 'COSTID',@RESULT_TBL = 'TEMPCOSTCENTRE',@INPUTVALUES = @COSTID"
        strSql += vbCrLf + "     EXEC " & tranDbName & "..SP_SPLITVALUES @CHK_DB = '" & compId & "ADMINDB',@CHK_TBL = 'ITEMMAST',@CHK_FEILD = 'ITEMID',@RESULT_TBL = 'TEMPITEMMAST',@INPUTVALUES = @ITEMID"
        strSql += vbCrLf + "     DELETE FROM TEMPITEMMAST WHERE COMPANYID IN (SELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE STOCKTYPE <> 'P')"
        strSql += vbCrLf + "     /** Getting PacketNo Based Item **/    "
        strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPPKTSTOCKVIEW1')>0 DROP TABLE MASTER..TEMPPKTSTOCKVIEW1    "
        strSql += vbCrLf + "     SELECT 'O' SEP,I.ITEMNAME,S.SUBITEMNAME,CASE WHEN RECISS = 'R' THEN N.PCS ELSE -1*N.PCS END AS PCS    "
        strSql += vbCrLf + "     ,CASE WHEN RECISS = 'R' THEN N.GRSWT ELSE -1*N.GRSWT END AS GRSWT,N.PACKETNO,CONVERT(NUMERIC(15,2),NULL)RATE,CONVERT(NUMERIC(15,2),NULL)PURRATE  "
        strSql += vbCrLf + "     ,(SELECT DESIGNERNAME FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERID = N.DESIGNERID)AS DESIGNER"
        strSql += vbCrLf + "     ,(SELECT CASE WHEN N.RECISS = 'R' THEN SUM(STNPCS) ELSE -1*SUM(STNPCS) END FROM " & cnAdminDb & "..ITEMNONTAGSTONE WHERE TAGSNO = N.SNO AND STNITEMID IN (sELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')) AS DIAPCS"
        strSql += vbCrLf + "     ,(SELECT CASE WHEN N.RECISS = 'R' THEN SUM(STNWT) ELSE -1*SUM(STNWT) END FROM " & cnAdminDb & "..ITEMNONTAGSTONE WHERE TAGSNO = N.SNO AND STNITEMID IN (sELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')) AS DIAWT"
        strSql += vbCrLf + "     INTO MASTER..TEMPPKTSTOCKVIEW1    "
        strSql += vbCrLf + "     FROM " & cnAdminDb & "..ITEMNONTAG AS N  INNER JOIN  " & compId & "ADMINDB..ITEMMAST AS I ON I.ITEMID = N.ITEMID    "
        strSql += vbCrLf + "     INNER JOIN TEMPITEMMAST AS TI ON TI.COMPANYID = N.ITEMID"
        strSql += vbCrLf + "     LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS S ON S.ITEMID = N.ITEMID AND S.SUBITEMID = N.SUBITEMID    "
        strSql += vbCrLf + "     WHERE N.RECDATE < @FRMDATE AND ISNULL(N.PACKETNO,'') <> ''    "
        strSql += vbCrLf + "     AND N.COMPANYID = @COMPANYID AND N.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)    "
        strSql += vbCrLf + "     AND ISNULL(N.DESIGNERID,0) IN (SELECT COMPANYID FROM TEMPDESIGNER) AND ISNULL(N.CANCEL,'') = ''"
        strSql += vbCrLf + "     UNION ALL    "
        strSql += vbCrLf + "     SELECT CASE WHEN RECISS = 'R' THEN 'R' ELSE 'I' END AS SEP    "
        strSql += vbCrLf + "     ,I.ITEMNAME,S.SUBITEMNAME,N.PCS PCS,N.GRSWT GRSWT,N.PACKETNO,CONVERT(NUMERIC(15,2),NULL)RATE,CONVERT(NUMERIC(15,2),NULL)PURRATE  "
        strSql += vbCrLf + "     ,(SELECT DESIGNERNAME FROM " & compId & "ADMINDB..DESIGNER WHERE DESIGNERID = N.DESIGNERID)AS DESIGNER"
        strSql += vbCrLf + "     ,(SELECT SUM(STNPCS) FROM " & cnAdminDb & "..ITEMNONTAGSTONE WHERE TAGSNO = N.SNO AND STNITEMID IN (sELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')) AS DIAPCS"
        strSql += vbCrLf + "     ,(SELECT SUM(STNWT) FROM " & cnAdminDb & "..ITEMNONTAGSTONE WHERE TAGSNO = N.SNO AND STNITEMID IN (sELECT ITEMID FROM " & compId & "ADMINDB..ITEMMAST WHERE DIASTONE = 'D')) AS DIAWT"
        strSql += vbCrLf + "     FROM " & cnAdminDb & "..ITEMNONTAG AS N  INNER JOIN " & compId & "ADMINDB..ITEMMAST AS I ON I.ITEMID = N.ITEMID    "
        strSql += vbCrLf + "     INNER JOIN TEMPITEMMAST AS TI ON TI.COMPANYID = N.ITEMID"
        strSql += vbCrLf + "     LEFT OUTER JOIN " & compId & "ADMINDB..SUBITEMMAST AS S ON S.ITEMID = N.ITEMID AND S.SUBITEMID = N.SUBITEMID    "
        strSql += vbCrLf + "     WHERE RECDATE BETWEEN @FRMDATE AND @TODATE AND ISNULL(N.PACKETNO,'') <> ''    "
        strSql += vbCrLf + "     AND N.COMPANYID = @COMPANYID AND N.COSTID IN (SELECT COMPANYID FROM TEMPCOSTCENTRE)    "
        strSql += vbCrLf + "     AND ISNULL(N.DESIGNERID,0) IN (SELECT COMPANYID FROM TEMPDESIGNER) AND ISNULL(N.CANCEL,'') = ''"
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "     /** Getting PacketNo Based Item **/    "
        strSql += vbCrLf + ""
        strSql += vbCrLf + "     IF @WITHVALUE = 'Y'   "
        strSql += vbCrLf + "     BEGIN  "
        strSql += vbCrLf + "     UPDATE MASTER..TEMPPKTSTOCKVIEW1 SET RATE = (SELECT TOP 1 RATE FROM " & cnAdminDb & "..ITEMNONTAG WHERE ITEMID = I.ITEMID AND PACKETNO = T.PACKETNO AND RECISS = 'R')  "
        strSql += vbCrLf + "     ,purRATE = (SELECT TOP 1 PURRATE FROM " & cnAdminDb & "..ITEMNONTAG WHERE ITEMID = I.ITEMID AND PACKETNO = T.PACKETNO AND RECISS = 'R')  "
        strSql += vbCrLf + "     FROM MASTER..TEMPPKTSTOCKVIEW1 T INNER JOIN " & compId & "ADMINDB..ITEMMAST I ON I.ITEMNAME = T.ITEMNAME  "
        strSql += vbCrLf + "     END  "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     IF @GROUPBYITEM = 'N' UPDATE MASTER..TEMPPKTSTOCKVIEW1 SET ITEMNAME = NULL    "
        strSql += vbCrLf + "     IF @GROUPBYDESIGNER = 'N' UPDATE MASTER..TEMPPKTSTOCKVIEW1 SET DESIGNER = NULL"
        strSql += vbCrLf + "     IF @WITHSUBITEM = 'N' UPDATE MASTER..TEMPPKTSTOCKVIEW1 SET SUBITEMNAME = NULL    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     IF (SELECT TOP 1 1 FROM MASTER..SYSOBJECTS WHERE NAME = 'TEMPPKTSTOCK')>0 DROP TABLE MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "     SELECT     "
        strSql += vbCrLf + "     CONVERT(VARCHAR(500),NULL)PARTICULAR    "
        strSql += vbCrLf + "     ,SUBITEMNAME    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'O' THEN X.PCS ELSE NULL END) AS OPCS    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'O' THEN X.GRSWT ELSE NULL END) AS OGRSWT    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'O' THEN X.DIAPCS ELSE NULL END) AS ODIAPCS"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'O' THEN X.DIAWT ELSE NULL END) AS ODIAWT"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'R' THEN X.PCS ELSE NULL END) AS RPCS    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'R' THEN X.GRSWT ELSE NULL END) AS RGRSWT    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'R' THEN X.DIAPCS ELSE NULL END) AS RDIAPCS"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'R' THEN X.DIAWT ELSE NULL END) AS RDIAWT"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN X.PCS ELSE NULL END) AS IPCS    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN X.GRSWT ELSE NULL END) AS IGRSWT    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN X.DIAPCS ELSE NULL END) AS IDIAPCS"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN X.DIAWT ELSE NULL END) AS IDIAWT"
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN -1*X.PCS ELSE X.PCS END) AS CPCS    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN -1*X.GRSWT ELSE X.GRSWT END) AS CGRSWT    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN -1*X.DIAPCS ELSE X.DIAPCS END) AS CDIAPCS    "
        strSql += vbCrLf + "     ,SUM(CASE WHEN SEP = 'I' THEN -1*X.DIAWT ELSE X.DIAWT END) AS CDIAWT    "
        strSql += vbCrLf + "     ,RATE   "
        strSql += vbCrLf + "     ,PURRATE"
        strSql += vbCrLf + "     ,DESIGNER"
        strSql += vbCrLf + "     ,CONVERT(VARCHAR(3),NULL)COLHEAD    "
        strSql += vbCrLf + "     ,CONVERT(INT,1) RESULT    "
        strSql += vbCrLf + "     ,CONVERT(INT,NULL) GRESULT    "
        strSql += vbCrLf + "     ,ITEMNAME    "
        strSql += vbCrLf + "     ,PACKETNO    "
        strSql += vbCrLf + "     INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "     FROM    "
        strSql += vbCrLf + "     (    "
        strSql += vbCrLf + "     SELECT * FROM MASTER..TEMPPKTSTOCKVIEW1    "
        strSql += vbCrLf + "     )X     "
        strSql += vbCrLf + "     GROUP BY X.PACKETNO,X.ITEMNAME,X.SUBITEMNAME,X.RATE,X.PURRATE,X.DESIGNER"
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     DELETE FROM MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "     WHERE ISNULL(OPCS,0) = 0 AND ISNULL(OGRSWT,0) = 0    "
        strSql += vbCrLf + "     AND ISNULL(RPCS,0) = 0 AND ISNULL(RGRSWT,0) = 0    "
        strSql += vbCrLf + "     AND ISNULL(IPCS,0) = 0 AND ISNULL(IGRSWT,0) = 0    "
        strSql += vbCrLf + "     AND ISNULL(CPCS,0) = 0 AND ISNULL(CGRSWT,0) = 0    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM MASTER..TEMPPKTSTOCK)>0    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "      IF @GROUPBYDESIGNER = 'Y'     "
        strSql += vbCrLf + "       BEGIN /** Insert Itemwise Title and Subtotal Itemwise **/    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "       (PARTICULAR,DESIGNER,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT DISTINCT DESIGNER,DESIGNER,'T'COLHEAD,0 RESULT FROM MASTER..TEMPPKTSTOCK WHERE RESULT = 1    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "       (PARTICULAR,DESIGNER,PACKETNO"
        strSql += vbCrLf + "       ,ITEMNAME,OPCS,OGRSWT,ODIAPCS,ODIAWT,RPCS,RGRSWT,RDIAPCS,RDIAWT,IPCS,IGRSWT,IDIAPCS,IDIAWT,CPCS,CGRSWT,CDIAPCS,CDIAWT,COLHEAD,RESULT    "
        strSql += vbCrLf + "       )    "
        strSql += vbCrLf + "       SELECT DESIGNER,DESIGNER,'ZZZ','ZZZZ'"
        strSql += vbCrLf + "       ,SUM(ISNULL(OPCS,0))OPCS,SUM(ISNULL(OGRSWT,0))OGRSWT,SUM(ISNULL(ODIAPCS,0))ODIAPCS,SUM(ISNULL(ODIAWT,0))ODIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(RPCS,0))RPCS,SUM(ISNULL(RGRSWT,0))RGRSWT,SUM(ISNULL(RDIAPCS,0))RDIAPCS,SUM(ISNULL(RDIAWT,0))RDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(IPCS,0))IPCS,SUM(ISNULL(IGRSWT,0))IGRSWT,SUM(ISNULL(IDIAPCS,0))IDIAPCS,SUM(ISNULL(IDIAWT,0))IDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(CPCS,0))CPCS,SUM(ISNULL(CGRSWT,0))CGRSWT,SUM(ISNULL(CDIAPCS,0))CDIAPCS,SUM(ISNULL(CDIAWT,0))CDIAWT"
        strSql += vbCrLf + "       ,'S' COLHEAD,2 RESULT    "
        strSql += vbCrLf + "       FROM MASTER..TEMPPKTSTOCK WHERE RESULT = 1 GROUP BY DESIGNER"
        strSql += vbCrLf + "       END /** Insert Itemwise Title and Subtotal Itemwise **/    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "      IF @GROUPBYITEM = 'Y'     "
        strSql += vbCrLf + "       BEGIN /** Insert Itemwise Title and Subtotal Itemwise **/    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "       (PARTICULAR,ITEMNAME,DESIGNER,COLHEAD,RESULT)    "
        strSql += vbCrLf + "       SELECT DISTINCT ITEMNAME,ITEMNAME,DESIGNER,'T1'COLHEAD,0 RESULT FROM MASTER..TEMPPKTSTOCK WHERE RESULT = 1    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "       (PARTICULAR,ITEMNAME,DESIGNER,PACKETNO    "
        strSql += vbCrLf + "       ,OPCS,OGRSWT,ODIAPCS,ODIAWT,RPCS,RGRSWT,RDIAPCS,RDIAWT,IPCS,IGRSWT,IDIAPCS,IDIAWT,CPCS,CGRSWT,CDIAPCS,CDIAWT,COLHEAD,RESULT    "
        strSql += vbCrLf + "       )    "
        strSql += vbCrLf + "       SELECT ITEMNAME,ITEMNAME,DESIGNER,'ZZZ'    "
        strSql += vbCrLf + "       ,SUM(ISNULL(OPCS,0))OPCS,SUM(ISNULL(OGRSWT,0))OGRSWT,SUM(ISNULL(ODIAPCS,0))ODIAPCS,SUM(ISNULL(ODIAWT,0))ODIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(RPCS,0))RPCS,SUM(ISNULL(RGRSWT,0))RGRSWT,SUM(ISNULL(RDIAPCS,0))RDIAPCS,SUM(ISNULL(RDIAWT,0))RDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(IPCS,0))IPCS,SUM(ISNULL(IGRSWT,0))IGRSWT,SUM(ISNULL(IDIAPCS,0))IDIAPCS,SUM(ISNULL(IDIAWT,0))IDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(CPCS,0))CPCS,SUM(ISNULL(CGRSWT,0))CGRSWT,SUM(ISNULL(CDIAPCS,0))CDIAPCS,SUM(ISNULL(CDIAWT,0))CDIAWT"
        strSql += vbCrLf + "       ,'S1' COLHEAD,2 RESULT    "
        strSql += vbCrLf + "       FROM MASTER..TEMPPKTSTOCK WHERE RESULT = 1 GROUP BY ITEMNAME,DESIGNER"
        strSql += vbCrLf + "       END /** Insert Itemwise Title and Subtotal Itemwise **/    "
        strSql += vbCrLf + "   "
        strSql += vbCrLf + "     IF (SELECT COUNT(*) FROM MASTER..TEMPPKTSTOCK)>0    "
        strSql += vbCrLf + "      BEGIN/**Inserting Grand Total**/    "
        strSql += vbCrLf + "       INSERT INTO MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "       (PARTICULAR    "
        strSql += vbCrLf + "       ,OPCS,OGRSWT,ODIAPCS,ODIAWT,RPCS,RGRSWT,RDIAPCS,RDIAWT,IPCS,IGRSWT,IDIAPCS,IDIAWT,CPCS,CGRSWT,CDIAPCS,CDIAWT,COLHEAD,GRESULT    "
        strSql += vbCrLf + "       )    "
        strSql += vbCrLf + "       SELECT 'GRAND TOT'    "
        strSql += vbCrLf + "       ,SUM(ISNULL(OPCS,0))OPCS,SUM(ISNULL(OGRSWT,0))OGRSWT,SUM(ISNULL(ODIAPCS,0))ODIAPCS,SUM(ISNULL(ODIAWT,0))ODIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(RPCS,0))RPCS,SUM(ISNULL(RGRSWT,0))RGRSWT,SUM(ISNULL(RDIAPCS,0))RDIAPCS,SUM(ISNULL(RDIAWT,0))RDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(IPCS,0))IPCS,SUM(ISNULL(IGRSWT,0))IGRSWT,SUM(ISNULL(IDIAPCS,0))IDIAPCS,SUM(ISNULL(IDIAWT,0))IDIAWT"
        strSql += vbCrLf + "       ,SUM(ISNULL(CPCS,0))CPCS,SUM(ISNULL(CGRSWT,0))CGRSWT,SUM(ISNULL(CDIAPCS,0))CDIAPCS,SUM(ISNULL(CDIAWT,0))CDIAWT"
        strSql += vbCrLf + "       ,'G' COLHEAD,1 GRESULT    "
        strSql += vbCrLf + "       FROM MASTER..TEMPPKTSTOCK WHERE RESULT = 1    "
        strSql += vbCrLf + "      END/**Inserting Grand Total**/    "
        strSql += vbCrLf + "     UPDATE MASTER..TEMPPKTSTOCK SET PARTICULAR = CASE WHEN RESULT = 2 THEN ISNULL(PARTICULAR,'') + ' TOT' WHEN RESULT = 1 THEN PACKETNO ELSE PARTICULAR END"
        strSql += vbCrLf + "     IF @GROUPBYITEM = 'Y'"
        strSql += vbCrLf + "  	UPDATE MASTER..TEMPPKTSTOCK SET PARTICULAR = ' ' + PARTICULAR WHERE ISNULL(COLHEAD,'') NOT IN ('T1','S1','G')"
        strSql += vbCrLf + "     IF @GROUPBYDESIGNER = 'Y'"
        strSql += vbCrLf + "  	UPDATE MASTER..TEMPPKTSTOCK SET PARTICULAR = ' ' + PARTICULAR WHERE ISNULL(COLHEAD,'') NOT IN ('T','S','G')"
        strSql += vbCrLf + "     IF @GROUPBYITEM = 'Y' AND @GROUPBYDESIGNER = 'N'"
        strSql += vbCrLf + "  	UPDATE MASTER..TEMPPKTSTOCK SET COLHEAD = CASE WHEN COLHEAD = 'T1'THEN 'T' WHEN COLHEAD = 'S1' THEN 'S' ELSE COLHEAD END"
        strSql += vbCrLf + "     UPDATE MASTER..TEMPPKTSTOCK SET     "
        strSql += vbCrLf + "     OPCS = CASE WHEN OPCS <> 0 THEN OPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,OGRSWT = CASE WHEN OGRSWT <> 0 THEN OGRSWT ELSE NULL END    "
        strSql += vbCrLf + "     ,ODIAPCS = CASE WHEN ODIAPCS <> 0 THEN ODIAPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,ODIAWT = CASE WHEN ODIAWT <> 0 THEN ODIAWT ELSE NULL END    "
        strSql += vbCrLf + "     ,RPCS = CASE WHEN RPCS <> 0 THEN RPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,RGRSWT = CASE WHEN RGRSWT <> 0 THEN RGRSWT ELSE NULL END    "
        strSql += vbCrLf + "     ,RDIAPCS = CASE WHEN RDIAPCS <> 0 THEN RDIAPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,RDIAWT = CASE WHEN RDIAWT <> 0 THEN RDIAWT ELSE NULL END    "
        strSql += vbCrLf + "     ,IPCS = CASE WHEN IPCS <> 0 THEN IPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,IGRSWT = CASE WHEN IGRSWT <> 0 THEN IGRSWT ELSE NULL END    "
        strSql += vbCrLf + "     ,IDIAPCS = CASE WHEN IDIAPCS <> 0 THEN IDIAPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,IDIAWT = CASE WHEN IDIAWT <> 0 THEN IDIAWT ELSE NULL END    "
        strSql += vbCrLf + "     ,CPCS = CASE WHEN CPCS <> 0 THEN CPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,CGRSWT = CASE WHEN CGRSWT <> 0 THEN CGRSWT ELSE NULL END    "
        strSql += vbCrLf + "     ,CDIAPCS = CASE WHEN CDIAPCS <> 0 THEN CDIAPCS ELSE NULL END    "
        strSql += vbCrLf + "     ,CDIAWT = CASE WHEN CDIAWT <> 0 THEN CDIAWT ELSE NULL END    "
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  DROP TABLE TEMPITEMMAST"
        strSql += vbCrLf + "  DROP TABLE TEMPCOSTCENTRE"
        strSql += vbCrLf + "  DROP TABLE TEMPDESIGNER"
        strSql += vbCrLf + "  "
        strSql += vbCrLf + "  SELECT * FROM MASTER..TEMPPKTSTOCK    "
        strSql += vbCrLf + "  ORDER BY GRESULT,DESIGNER,ITEMNAME,PACKETNO,RESULT"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

    Private Sub funcSp33GetMaxSno()
        strSql = " IF (SELECT 1 FROM SYSOBJECTS WHERE NAME='GET_TRANNO_MAX')>0"
        strSql += vbCrLf + "  	DROP PROCEDURE GET_TRANNO_MAX"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()

        strSql = vbCrLf + " CREATE PROCEDURE GET_TRANNO_MAX"
        strSql += vbCrLf + " ("
        strSql += vbCrLf + " @BILLDATE SMALLDATETIME"
        strSql += vbCrLf + " ,@RETVALUE VARCHAR(50) OUTPUT"
        strSql += vbCrLf + " )"
        strSql += vbCrLf + " AS"
        strSql += vbCrLf + " BEGIN"
        strSql += vbCrLf + " SELECT @RETVALUE = CONVERT(VARCHAR,MAX(ISNULL(TRANNO,0))+1)"
        strSql += vbCrLf + " 	FROM"
        strSql += vbCrLf + " 	("
        strSql += vbCrLf + " 	SELECT MAX(TRANNO) AS TRANNO FROM " & tranDbName & "..ISSUE WHERE TRANDATE = @BILLDATE"
        strSql += vbCrLf + " 	UNION ALL"
        strSql += vbCrLf + " 	SELECT MAX(TRANNO) FROM " & tranDbName & "..RECEIPT WHERE TRANDATE = @BILLDATE"
        strSql += vbCrLf + " 	UNION ALL"
        strSql += vbCrLf + " 	SELECT MAX(TRANNO) FROM " & tranDbName & "..ACCTRAN WHERE TRANDATE = @BILLDATE"
        strSql += vbCrLf + " 	UNION ALL"
        strSql += vbCrLf + " 	SELECT MAX(TRANNO) FROM " & compId & "ADMINDB..OUTSTANDING WHERE TRANDATE = @BILLDATE"
        strSql += vbCrLf + " 	)X"
        strSql += vbCrLf + " END"
        cmd = New OleDbCommand(strSql, cn, tran)
        cmd.ExecuteNonQuery()
    End Sub

