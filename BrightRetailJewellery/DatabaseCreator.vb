        strSql += vbCrLf + "  AND DATEADD(D,-1,DATEADD(D,1,@GETMAXDATE))) AS TEMP  "
        strSql += vbCrLf + "  SET @DynamicPivotQuery =   "
        strSql += vbCrLf + "  N''SELECT SALESPERSON,GROUPCOL,RESULT,'' + @ColPerDaySalePerWeight + '',(''+@ColTotWeight+'') AS TOTALWEIGHT,  "
