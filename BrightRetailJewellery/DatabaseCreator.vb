        strSql += vbCrLf + "      SELECT @QRY= @QRY + ' ,I.GRSWT,I.LESSWT,I. NETWT,I.TOUCH,I.PUREWT,0 AS AMOUNT,BATCHNO,I.ACCODE,CONVERT(INT,1)RESULT'"
